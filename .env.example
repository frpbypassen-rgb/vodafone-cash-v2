# =========================================================
# نموذج متغيرات البيئة — لا تضع هذا الملف في Git!
# انسخ هذا الملف إلى .env وعدّل القيم بحسب بيئتك
# =========================================================

TZ=Africa/Tripoli

# ── قاعدة البيانات ──────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/vodafone_cash_system

# ── توكنات بوتات تيليجرام ──────────────────────────────
# احصل على التوكن من @BotFather في تيليجرام
CLIENT_BOT_TOKEN=YOUR_CLIENT_BOT_TOKEN_HERE
ADMIN_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN_HERE

# ── معرف المدير في تيليجرام ─────────────────────────────
# احصل على الـ ID من @userinfobot في تيليجرام
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_ID_HERE

# كود سري لإضافة مديرين جدد عبر البوت
ADMIN_SECRET_CODE=YOUR_SECRET_CODE_HERE

# ── مفاتيح الحماية ──────────────────────────────────────
# استخدم: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_strong_secret_key_here
JWT_REFRESH_SECRET=generate_a_strong_refresh_key_here
SESSION_SECRET=generate_a_strong_session_key_here
OTP_SECRET=generate_a_strong_otp_hmac_secret_here
BYPASS_OTP=false
BYPASS_CLIENT_OTP=false
DISABLE_OTP=false
FORCE_CLIENT_OTP=true
# Set to false only when the system owner intentionally wants direct password login.
CLIENT_OTP_ENABLED=true
CLIENT_OTP_DISABLED_REASON=
# Minimum wait before a client can request a fresh WhatsApp OTP for the same login.
OTP_RESEND_COOLDOWN_SECONDS=60

# ── WhatsApp عبر WhatChimp (اختياري) ─────────────────────────
# لا تضع رمز API الحقيقي في Git. لا يوجد رمز OTP عام أو مسار تجاوز في الإنتاج.
WHATCHIMP_ENABLED=false
WHATCHIMP_API_BASE_URL=https://app.whatchimp.com/api/v1/whatsapp
WHATCHIMP_API_TOKEN=
WHATCHIMP_PHONE_NUMBER_ID=
WHATCHIMP_OTP_TEMPLATE=power_pay_otp
WHATCHIMP_OTP_TEMPLATE_LANGUAGE=ar
WHATCHIMP_OTP_VARIABLE_ORDER=otp,expiresMinutes
WHATCHIMP_RECEIPT_MEDIA_TEMPLATE_ID=
WHATCHIMP_RECEIPT_TEMPLATE=
WHATCHIMP_RECEIPT_TEMPLATE_LANGUAGE=ar
WHATCHIMP_RECEIPT_VARIABLE_ORDER=accountName,reference,amount,currency,completedAt,receiptUrl
# قالب إشعار تغيير الأسعار: اسم الحساب، العد التنازلي، الأسعار القديمة والجديدة، وقت التفعيل.
WHATCHIMP_RATE_CHANGE_TEMPLATE=power_pay_rate_change
WHATCHIMP_RATE_CHANGE_TEMPLATE_LANGUAGE=ar
WHATCHIMP_RATE_CHANGE_VARIABLE_ORDER=accountName,countdown,rateChanges,effectiveAt
WHATCHIMP_RECEIPT_URL_TTL_HOURS=720
WHATCHIMP_REQUEST_TIMEOUT_MS=15000
# Secret used by the inbound/outbound WhatsApp webhook. Keep it out of Git.
WHATCHIMP_WEBHOOK_SECRET=generate_a_long_random_webhook_secret_here
RECEIPT_SHARE_SECRET=generate_a_strong_receipt_share_secret_here

# ── بيانات تسجيل الدخول للوحة التحكم ──────────────────
# مدير رئيسي — غيّر هذه القيم فوراً!
PANEL_USER=YOUR_ADMIN_USERNAME
PANEL_PASS=YOUR_STRONG_PASSWORD

# ── API خارجي (اختياري) ─────────────────────────────────
ZAYN_USERNAME=YOUR_ZAYN_API_USERNAME
ZAYN_PASSWORD=YOUR_ZAYN_API_PASSWORD
ZAYN_AGGREGATOR_URL=https://zaynpay.com
ZAYN_AGGREGATOR_SERVICE_ID=85
ZAYN_AGGREGATOR_PROVIDER_ID=16
ZAYN_AGGREGATOR_FIELD_ID=5488
ZAYN_AGGREGATOR_MACHINE_SERIAL=XP1
API_BALANCE_TOLERANCE=0.01
API_RETURN_MONITOR_ENABLED=true
API_RETURN_MONITOR_INTERVAL_MS=300000

# مفتاح API الداخلي بين الخدمات
INTERNAL_API_KEY=generate_a_strong_api_key_here

# ── بيئة التشغيل ────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=https://your-production-domain.example
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@ahrampay.com

# ── إشعارات تطبيق الهاتف عبر Firebase Cloud Messaging ─────────
# أنشئ Service Account من Firebase واحفظ JSON كاملاً كقيمة Base64 في الخادم فقط.
FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_BASE64=
# بديل عن السطر السابق: يمكن ضبط القيم الثلاث التالية كل واحدة على حدة.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_WORKER_INTERVAL_MS=3000
EXECUTOR_PUSH_REMINDER_INTERVAL_MS=60000
EXECUTOR_PUSH_MAX_REMINDERS=60
FCM_DEVICE_ACTIVE_DAYS=90
EXECUTOR_LOW_BALANCE_THRESHOLD=1000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Flutter web preview at http://127.0.0.1:3001 is allowed only for /api/mobile.
SECURE_COOKIE=false
COOKIE_SAMESITE=lax
SESSION_STORE=mongo
MONGO_TRANSACTIONS_REQUIRED=true
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_MAX_AGE_MS=7200000
# ── عزل بيانات المنظمات ─────────────────────────────────
# استخدم single لنطاق ahrampay.com الحالي، وحدد مستأجراً ثابتاً ولا تعتمد على أول سجل في القاعدة.
TENANT_ISOLATION_REQUIRED=true
TENANT_MODE=single
DEFAULT_TENANT_SLUG=ahram
# DEFAULT_TENANT_ID=
# مطلوب فقط عند TENANT_MODE=multi، مثال: ahram.example.com
TENANT_ROOT_DOMAIN=ahrampay.com
# مفتاح داخلي فقط لخدمات التوجيه الموثوقة التي تحتاج X-Tenant-ID.
TENANT_ROUTING_SECRET=generate_a_strong_tenant_routing_secret_here
ALLOW_LEGACY_TENANTLESS_RECORDS=false
ALLOW_LEGACY_TENANT_TOKENS=false
# Optional tokens for remote operational access. Localhost access remains available.
METRICS_AUTH_TOKEN=
SYSTEM_MONITOR_AUTH_TOKEN=
# Use Redis only after provisioning a reachable Redis service. A single-process
# deployment can safely use the in-memory cache and locks while this is false.
REDIS_ENABLED=false
REDIS_REQUIRED=false
# REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=generate_a_strong_redis_password_here
GLOBAL_RATE_LIMIT_MAX=5000
ALLOW_LEGACY_SAME_ORIGIN_CSRF=false
