<%
const company = kind === 'company' ? account : null; const user = kind === 'agent' ? account : null; const isAgentAccount = kind === 'agent';
const label = kind === 'company' ? 'الشركة' : 'الوكيل'; const accountPath = (kind === 'company' ? '/company/' : '/user/') + account._id;
const balance = Number(account.balance || 0); const reversibleIds = new Set(reversibleSettlements.map(String));
const tabs = [['ledger','السجل المالي'],['finance','الإيداع والتسعير'],['staff','الموظفون'],['settings','إعدادات البوابة'],['profile','البيانات والأمان'],...(isMaster ? [['audit','سجل التعديلات']] : [])];
const pageHref = page => { const params = new URLSearchParams({tab,page:String(page)}); if(filters.q) params.set('q',filters.q); if(tab === 'ledger') { for(const key of ['from','to','status']) if(filters[key]) params.set(key,filters[key]); } return accountPath + '?' + params.toString(); };
const sectionLabels = { integrations:'التكاملات',email:'بريد الكشف اليومي',telegram:'Telegram',push:'إشعارات الويب',business_profile:'بيانات المنشأة' };
const fieldLabels = { name:'الاسم',phone:'الهاتف',status:'الحالة',webUsername:'اسم الدخول',tier:'المستوى',creditLimit:'الحد الائتماني',businessProfile:'بيانات المنشأة',otpDeliveryChannel:'بريد رمز الدخول',ownerEmail:'بريد المالك',ownerOtpDeliveryChannel:'رمز دخول المالك',webPassword:'كلمة المرور',password:'كلمة المرور' };
const stateLabels = {completed:'مكتمل',deposit:'إيداع',deduction:'خصم',pending:'معلق',processing:'قيد التنفيذ',rejected:'مرفوض',cancelled_by_admin:'ملغي',active:'نشط',banned:'متوقف',inactive:'متوقف'};
const feedbackError = query.balanceError || query.codeError || query.ownerOtpError || query.rateError || query.apiTokenError || query.voidError;
const feedbackSaved = query.balanceSaved || query.profileUpdated || query.codeSaved || query.ownerOtpSaved || query.rateUpdated || query.integrationsSaved || query.voidSuccess;
%>
<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= account.name %> · ملف <%= label %></title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<%- include('partials/admin_modern_head') %><link rel="stylesheet" href="/css/admin-merchants.css?v=20261027-mobile"></head><body class="am-merchant-body">
<%- include('partials/sidebar', {activePage:'clients'}) %>
<main class="main-content am-merchant-page" data-merchant-detail data-account-path="<%= accountPath %>" data-tab="<%= tab %>"><div class="am-merchant-wrap">
    <header class="am-merchant-heading"><div><a href="/clients?section=<%= kind === 'company' ? 'companies' : 'agents' %>">← <%= kind === 'company' ? 'الشركات' : 'الوكلاء' %></a><h1 title="<%= account.name %>"><%= account.name %></h1><span class="am-status <%= account.status === 'active' ? 'is-active' : '' %>"><%= stateLabels[account.status] || 'متوقف' %></span></div><div class="am-heading-actions"><% if(isMaster) { %><a class="am-button" href="/admin/accounts/<%= kind %>/<%= account._id %>/edit">تعديل البيانات</a><% } %><a class="am-button primary" href="<%= accountPath %>?tab=finance#balance">إيداع / خصم</a></div></header>
    <section class="am-merchant-summary" aria-label="ملخص الحساب"><div><small>الرصيد الحالي · د.ل</small><strong class="<%= balance > 0 ? 'am-positive' : balance < 0 ? 'am-negative' : '' %>"><bdi><%= balance.toFixed(2) %></bdi></strong></div><div><small>رقم الحساب</small><strong><bdi><%= account.accountCode || account.agentCode || '—' %></bdi></strong></div><div><small>الهاتف</small><strong><bdi><%= account.phone || '—' %></bdi></strong></div><div><small>الحد الائتماني · د.ل</small><strong><bdi><%= Number(account.creditLimit || 0).toFixed(2) %></bdi></strong></div></section>
    <% if(feedbackError || feedbackSaved) { %><p class="am-feedback" role="status"><%= feedbackError ? 'تعذر حفظ التعديل. راجع البيانات والصلاحيات ثم حاول مجددًا.' : 'تم حفظ التعديل وتحديث الحساب.' %></p><% } %>
    <nav class="am-tabs" aria-label="أقسام ملف الحساب"><% tabs.forEach(([key,title]) => { %><a href="<%= accountPath %>?tab=<%= key %>" <%= tab === key ? 'aria-current=page' : '' %>><%= title %></a><% }) %></nav>
    <label class="am-mobile-tabs">عرض القسم<select data-merchant-tab aria-label="عرض قسم الحساب"><% tabs.forEach(([key,title]) => { %><option value="<%= accountPath %>?tab=<%= key %>" <%= tab === key ? 'selected' : '' %>><%= title %></option><% }) %></select></label>
    <section class="am-section" data-account-section="<%= tab %>"><h2><%= tabs.find(item => item[0] === tab)?.[1] || 'ملف الحساب' %></h2>
    <% if(tab === 'ledger') { %>
        <form method="GET" class="am-ledger-filters"><input type="hidden" name="tab" value="ledger"><label class="am-filter-search">بحث برقم العملية أو الملاحظة<input name="q" type="search" maxlength="80" value="<%= filters.q %>" placeholder="ابحث في حركات هذا الحساب"></label><label>من<input type="date" name="from" value="<%= filters.from %>"></label><label>إلى<input type="date" name="to" value="<%= filters.to %>"></label><label>نوع الحركة<select name="status"><option value="">الكل</option><% ['deposit','deduction','completed','pending','processing','rejected','cancelled_by_admin'].forEach(state => { %><option value="<%= state %>" <%= filters.status === state ? 'selected' : '' %>><%= stateLabels[state] %></option><% }) %></select></label><button class="am-button primary" type="submit">بحث</button><a class="am-button" href="<%= accountPath %>?tab=ledger">مسح</a></form>
        <% if(filters.error) { %><p class="am-negative" role="alert"><%= filters.error %></p><% } %>
        <div class="am-table-wrap am-keep-table"><table class="am-data-table am-table-ledger"><caption class="am-sr-only">الحركات المالية للحساب</caption><thead><tr><th>العملية / البيان</th><th>المبلغ والتكلفة</th><th>الوقت</th><th>الحالة</th><th>تفاصيل</th></tr></thead><tbody>
        <% if(!rows.length) { %><tr><td colspan="5" class="am-empty">لا توجد حركات مطابقة للفترة والبحث.</td></tr><% } %>
        <% rows.forEach(tx => { const original = tx.balanceAdjustment?.originalStatus || tx.status; const settlement = ['deposit','deduction'].includes(original); const voided = Boolean(tx.balanceAdjustment?.voidedAt); const canVoid = ['deposit','deduction'].includes(tx.status) && reversibleIds.has(String(tx.customId)); %>
        <tr><td class="am-cell-record"><strong><bdi>#<%= tx.customId || String(tx._id).slice(-6) %></bdi></strong><div class="am-row-details"><%= settlement ? stateLabels[original] : tx.vodafoneNumber || tx.accountName || 'تحويل' %><%= voided ? ' · تم عكس الأثر' : '' %></div></td><td class="am-cell-amount <%= voided ? '' : original === 'deposit' ? 'am-positive' : original === 'deduction' ? 'am-negative' : '' %>"><strong><bdi><%= Number(tx.amount || 0).toFixed(2) %> <%= settlement ? 'LYD' : 'EGP' %></bdi></strong><% if(!settlement && tx.costLYD) { %><div class="am-row-details">التكلفة: <bdi><%= Number(tx.costLYD).toFixed(2) %> LYD</bdi></div><% } %></td><td class="am-cell-time"><bdi><%= formatDate(tx.createdAt || tx.updatedAt) %></bdi></td><td class="am-cell-record-state"><span class="am-status <%= ['completed','deposit'].includes(tx.status) ? 'is-active' : '' %>"><%= stateLabels[tx.status] || tx.status %></span></td><td class="am-cell-extra"><details class="am-history-extra"><summary>التفاصيل</summary><p><%= tx.notes || 'لا توجد ملاحظة.' %></p><% if(canVoid) { %><form action="/transaction/<%= tx._id %>/void-balance-adjustment" method="POST" onsubmit="return confirm('عكس أثر التسوية مع الاحتفاظ بسجلها؟');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reason" value="عكس التسوية من ملف الحساب"><button class="am-button danger" type="submit">عكس التسوية</button></form><% } %></details></td></tr>
        <% }) %></tbody></table></div>
    <% } else if(tab === 'finance') { %><div class="am-controls"><%- include('partials/admin_merchant_' + kind + '_finance', {company,user,isAgentAccount}) %></div>
    <% } else if(tab === 'staff') { %>
        <form method="GET" class="am-ledger-filters"><input type="hidden" name="tab" value="staff"><label>بحث بالاسم أو الهاتف<input name="q" type="search" maxlength="80" value="<%= filters.q %>"></label><button class="am-button primary" type="submit">بحث</button></form>
        <div class="am-table-wrap"><table class="am-data-table am-table-staff"><thead><tr><th>الموظف</th><th>الهاتف</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody><% if(!rows.length) { %><tr><td colspan="4" class="am-empty">لا يوجد موظفون مطابقون.</td></tr><% } %><% rows.forEach(person => { %><tr><td class="am-cell-person"><strong><%= person.name %></strong><small class="am-subtext"><%= person.role === 'owner' ? 'مالك الحساب' : person.role === 'accountant' ? 'محاسب' : 'موظف' %></small></td><td><bdi><%= person.phone || '—' %></bdi></td><td><span class="am-status <%= person.status === 'active' ? 'is-active' : '' %>"><%= person.status === 'active' ? 'نشط' : 'متوقف' %></span></td><td class="am-cell-person-action"><% if(isMaster) { %><a class="am-button" href="/admin/accounts/<%= kind === 'company' ? 'client-employee' : 'agent-employee' %>/<%= person._id %>/edit">عرض وتعديل</a><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div>
    <% } else if(tab === 'settings') { %>
        <% if(isMaster) { %><%- include('partials/merchant_integration_access', { integrationAccount: account, integrationAccountType: kind }) %><details class="am-control-card"><summary>وثائق ومفتاح الربط</summary><p><a class="am-button" href="<%= accountPath %>/integration-guide.pdf">وثيقة API</a> <a class="am-button" href="<%= accountPath %>/sandbox-api-guide.pdf">ملف اختبار API</a></p><% if(kind === 'company') { %><%- include('partials/admin_merchant_company_key', {company}) %><% } %></details><% } else { %><p>إدارة إعدادات البوابة متاحة للإدارة الرئيسية.</p><% } %>
    <% } else if(tab === 'profile') { %>
        <dl class="am-profile"><% [['الاسم',account.name],['اسم مسؤول التواصل',account.businessProfile?.contactName],['بريد التواصل',account.businessProfile?.email],['المدينة',account.businessProfile?.city],['العنوان',account.businessProfile?.address],['السجل أو الترخيص',account.businessProfile?.registrationNumber],...(isMaster ? [['Authenticator',(kind === 'company' ? companyOwner?.mfaEnabled : account.mfaEnabled) ? 'مفعّل' : 'غير مفعّل']] : [])].forEach(([title,value]) => { %><div><dt><%= title %></dt><dd><%= value || '—' %></dd></div><% }) %></dl>
        <% if(isMaster) { %><%- include('partials/owner_email_otp_card', {ownerOtp:{type:kind,id:account._id,email:kind === 'company' ? companyOwner?.email || '' : (account.emailOtpVerifiedAt && account.emailOtpVerifiedEmail) || account.businessProfile?.email || '', emailOtpEnabled:kind === 'company' ? companyOwner?.otpDeliveryChannel === 'email' : account.otpDeliveryChannel === 'email',verified:Boolean(kind === 'company' ? companyOwner?.emailOtpVerifiedAt : account.emailOtpVerifiedAt),loginOtpChannel:kind === 'company' ? companyOwner?.otpDeliveryChannel : account.otpDeliveryChannel,telegramVerified:Boolean(kind === 'company' ? companyOwner?.telegramLoginVerifiedAt : account.telegramLoginVerifiedAt),telegramAccount:kind === 'company' ? companyOwner?.telegramLoginUsername : account.telegramLoginUsername,ownerName:kind === 'company' ? companyOwner?.name || '' : account.name, ownerUsername:kind === 'company' ? companyOwner?.webUsername || '' : account.webUsername,showLoginAccount:true,missingOwner:kind === 'company' && !companyOwner}}) %><% } %>
        <div class="am-controls"><%- include('partials/admin_merchant_' + kind + '_actions', {company,user,isAgentAccount}) %></div>
    <% } else if(tab === 'audit' && isMaster) { %>
        <div class="am-table-wrap"><table class="am-data-table am-table-audit"><thead><tr><th>الشخص</th><th>الوقت</th><th>التغيير</th></tr></thead><tbody><% if(!rows.length) { %><tr><td colspan="3" class="am-empty">لا توجد تعديلات مسجلة لهذا الحساب.</td></tr><% } %><% rows.forEach(entry => { %><tr><td class="am-cell-person"><strong><%= entry.performedByName || 'النظام' %></strong></td><td><bdi><%= formatDate(entry.createdAt) %></bdi></td><td class="am-cell-change"><%= auditLabel(entry.action) %><small class="am-subtext"><%= entry.metadata?.section ? 'القسم: ' + (sectionLabels[entry.metadata.section] || 'إعدادات الحساب') : '' %><%= entry.result ? ' · ' + entry.result : '' %></small><% if(Array.isArray(entry.metadata?.changedFields) && entry.metadata.changedFields.length) { %><small class="am-subtext">الحقول: <%= entry.metadata.changedFields.filter(field => typeof field === 'string').slice(0,10).map(field => fieldLabels[field] || 'بيانات الحساب').join('، ') %></small><% } %></td></tr><% }) %></tbody></table></div>
    <% } %>
    <% if(['ledger','staff','audit'].includes(tab)) { %><nav class="am-pagination" aria-label="صفحات النتائج"><% if(pagination.page > 1) { %><a class="am-button" href="<%= pageHref(pagination.page - 1) %>">السابق</a><% } %><span><%= pagination.totalItems %> نتيجة · صفحة <%= pagination.page %> من <%= pagination.totalPages %></span><% if(pagination.page < pagination.totalPages) { %><a class="am-button" href="<%= pageHref(pagination.page + 1) %>">التالي</a><% } %></nav><% } %>
    </section>
</div></main>
<script src="/js/admin-merchant-details.js?v=20261027-mobile" defer></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script></body></html>
