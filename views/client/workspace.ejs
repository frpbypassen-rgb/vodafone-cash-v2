<!DOCTYPE html>
<html lang="ar" dir="rtl">
<%- include('partials/workspace_head') %>
<body class="bw-body<%= workspace.isCompany ? ' bw-company-os' : '' %>" data-page="<%= page %>" data-persona="<%= workspace.persona %>" data-portal="<%= workspace.type %>">
    <%- include('partials/workspace_sidebar') %>
    <button class="bw-sidebar-overlay" type="button" data-sidebar-close aria-label="إغلاق القائمة"></button>

    <div class="bw-frame">
        <%- include('partials/workspace_topbar') %>
        <main class="bw-main" id="mainContent">
            <% if (!workspace.isCompany) { %>
            <header class="bw-page-header">
                <div>
                    <span class="bw-eyebrow"><i class="fa-solid <%= pageMeta.icon || 'fa-grid-2' %>"></i><%= pageMeta.eyebrow %></span>
                    <h1><%= pageMeta.title %></h1>
                    <p><%= workspace.entity.name %> <span aria-hidden="true">/</span> <%= workspace.roleLabel %></p>
                </div>
                <div class="bw-page-actions">
                    <button class="bw-assistant-launcher" type="button" id="businessAssistantOpen" aria-haspopup="dialog" aria-label="فتح المساعد الذكي" title="المساعد الذكي">
                        <span class="bw-assistant-launcher-core"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                        <i class="fa-solid fa-sparkles bw-assistant-launcher-spark spark-one" aria-hidden="true"></i>
                        <i class="fa-solid fa-star bw-assistant-launcher-spark spark-two" aria-hidden="true"></i>
                    </button>
                    <div class="bw-page-status" aria-label="حالة النظام">
                        <span class="bw-live-dot <%= systemOpen ? '' : 'is-closed' %>"></span>
                        <span><%= systemOpen ? 'الخدمة متاحة' : 'الخدمة متوقفة مؤقتاً' %></span>
                    </div>
                </div>
            </header>
            <% } %>

            <div class="bw-rate-countdown" id="rateChangeCountdown" hidden role="status" aria-live="polite">
                <span class="bw-rate-countdown-icon"><i class="fa-solid fa-clock"></i></span>
                <span><strong>تحديث أسعار الصرف قريباً</strong><small>سيتم تطبيق الأسعار الجديدة تلقائياً عند انتهاء العداد.</small><small id="rateChangeDetails" style="white-space: pre-line;"></small></span>
                <b dir="ltr" data-rate-countdown-value>00:00</b>
            </div>
            <div class="bw-rate-countdown" id="rateChangeActivated" hidden role="status" aria-live="polite">
                <span class="bw-rate-countdown-icon"><i class="fa-solid fa-circle-check"></i></span>
                <span><strong>تم تفعيل السعر الجديد</strong><small id="rateChangeActivatedDetails" style="white-space: pre-line;"></small></span>
            </div>

            <%- include('partials/workspace_feedback') %>

            <% if (page === 'overview') { %>
                <%- include('pages/workspace_overview') %>
            <% } else if (page === 'services' && workspace.isCompany) { %>
                <%- include('pages/workspace_service_gallery') %>
            <% } else if (page === 'services') { %>
                <%- include('pages/workspace_services') %>
            <% } else if (page === 'service_workbench') { %>
                <%- include('pages/workspace_service_workbench') %>
            <% } else if (page === 'smart_transfer') { %>
                <%- include('pages/workspace_smart_transfer') %>
            <% } else if (page === 'internal_transfer') { %>
                <%- include('pages/workspace_internal_transfer') %>
            <% } else if (page === 'deposits') { %>
                <%- include('pages/workspace_deposits') %>
            <% } else if (page === 'transactions') { %>
                <%- include('pages/workspace_transactions') %>
            <% } else if (page === 'finance') { %>
                <%- include('pages/workspace_finance') %>
            <% } else if (['agency_balances', 'agency_debts', 'agency_account', 'agency_position', 'agency_profits'].includes(page)) { %>
                <%- include('pages/workspace_agency_finance') %>
            <% } else if (page === 'customers') { %>
                <%- include('pages/workspace_customers') %>
            <% } else if (page === 'customer_profile') { %>
                <%- include('pages/workspace_customer_profile') %>
            <% } else if (page === 'staff') { %>
                <%- include('pages/workspace_staff') %>
            <% } else if (page === 'reports') { %>
                <%- include('pages/workspace_reports') %>
            <% } else if (page === 'settings') { %>
                <%- include('pages/workspace_settings') %>
            <% } else if (page === 'security') { %>
                <%- include('pages/workspace_security') %>
            <% } else if (page === 'support') { %>
                <%- include('pages/workspace_support') %>
            <% } %>
        </main>

        <% const mobileKeys = workspace.isCompany
            ? (workspace.persona === 'manager'
                ? ['overview', 'services', 'transactions', 'reports']
                : workspace.persona === 'accountant'
                    ? ['finance', 'reports', 'transactions', 'deposits']
                    : ['services', 'transactions', 'smart_transfer', 'support'])
            : ['overview', 'services', 'transactions', 'reports'];
           const mobileNavigation = mobileKeys.map(key => navigation.find(item => item.key === key)).filter(Boolean); %>
        <nav class="bw-mobile-dock" aria-label="التنقل السريع">
            <% mobileNavigation.forEach(item => { %>
                <a href="<%= item.href %>" class="<%= item.active ? 'active' : '' %>">
                    <i class="fa-solid <%= item.icon %>"></i>
                    <span><%= item.label
                        .replace('الخدمات والتحويل', 'تحويل')
                        .replace('إنشاء تحويل', 'تحويل')
                        .replace('المعاملات', 'العمليات')
                        .replace('سجل العمليات', 'العمليات')
                        .replace('الموظفون والصلاحيات', 'الفريق')
                        .replace('فريق الشركة', 'الفريق')
                        .replace('الحركات المالية', 'المالية')
                        .replace('كشف الحركات', 'المالية')
                        .replace('كشوف الحساب', 'الكشوف')
                        .replace('إدارة الحساب', 'الحساب')
                        .replace('أمان حسابي', 'أماني')
                        .replace('أمان الحساب', 'أماني')
                        .replace('بيانات المنشأة', 'البيانات')
                        .replace('التحويل الذكي', 'ذكي')
                        .replace('طلب إيداع', 'إيداع')
                        .replace('متابعة الإيداع', 'متابعة')
                        .replace('كشف الحساب', 'الكشف')
                        .replace('دفتر الحركات', 'المالية')
                        .replace('مكتب المحاسبة', 'المالية') %></span>
                </a>
            <% }) %>
        </nav>
    </div>

    <dialog class="bw-dialog bw-transaction-dialog" id="transactionDetailsDialog" aria-labelledby="transactionDetailsTitle">
        <div class="bw-dialog-head">
            <div>
                <span class="bw-section-kicker">غرفة العمليات</span>
                <h2 id="transactionDetailsTitle">تفاصيل العملية</h2>
            </div>
            <button type="button" class="bw-icon-button" data-dialog-close aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="bw-dialog-body" id="transactionDetailsBody">
            <div class="bw-loading"><i class="fa-solid fa-circle-notch fa-spin"></i><span>جارٍ تحميل التفاصيل...</span></div>
        </div>
    </dialog>

    <dialog class="bw-dialog bw-assistant-dialog" id="businessAssistantDialog" aria-label="المساعد الذكي">
        <div class="bw-dialog-head">
            <span class="bw-assistant-mark" aria-hidden="true"><i class="fa-solid fa-wand-magic-sparkles"></i><i class="fa-solid fa-star bw-assistant-mark-star"></i></span>
            <div class="bw-assistant-head-actions"><button type="button" class="bw-icon-button" data-assistant-clear aria-label="مسح المحادثة"><i class="fa-solid fa-eraser"></i></button><button type="button" class="bw-icon-button" data-assistant-close aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button></div>
        </div>
        <div class="bw-assistant-messages" id="businessAssistantMessages" aria-live="polite">
            <div class="bw-assistant-empty" data-assistant-empty aria-hidden="true">
                <span class="bw-assistant-orbit orbit-one"><i class="fa-solid fa-sparkles"></i></span>
                <span class="bw-assistant-orbit orbit-two"><i class="fa-solid fa-star"></i></span>
                <span class="bw-assistant-orbit orbit-three"><i class="fa-solid fa-circle"></i></span>
                <span class="bw-assistant-empty-core"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
            </div>
        </div>
        <form class="bw-assistant-form" id="businessAssistantForm">
            <input id="businessAssistantQuestion" maxlength="800" autocomplete="off" aria-label="اكتب رسالة" required>
            <button class="bw-button primary" type="submit" id="businessAssistantSubmit" aria-label="إرسال"><i class="fa-solid fa-paper-plane"></i></button>
        </form>
    </dialog>

    <dialog class="bw-dialog cos-seal-dialog" id="companyWelcomeDialog" aria-label="ترحيب الشركة">
        <div class="cos-seal-modal">
            <div class="cos-logo-3d"><span class="cos-rings"></span><img src="/images/logo.jpeg" alt="شعار الأهرام" onerror="this.onerror=null;this.src='/images/logo.jpg'"></div>
            <h2 id="companyWelcomeTitle"><%= workspace.entity.name %></h2>
            <p id="companyWelcomeCopy">مرحباً <%= workspace.actor.name %>. أنت تدخل ك<%= workspace.roleLabel %>. <%= systemOpen ? 'الخدمة متاحة الآن.' : 'الخدمة متوقفة مؤقتاً.' %></p>
            <button type="button" class="bw-button primary wide" data-dialog-close>دخول الغرفة</button>
        </div>
    </dialog>

    <dialog class="bw-dialog cos-seal-dialog" id="companyMessageDialog" aria-labelledby="companyMessageTitle">
        <div class="cos-seal-modal">
            <div class="cos-logo-3d"><span class="cos-rings"></span><img src="/images/logo.jpeg" alt="" onerror="this.onerror=null;this.src='/images/logo.jpg'"></div>
            <h2 id="companyMessageTitle">رسالة من الإدارة</h2>
            <p id="companyMessageCopy"></p>
            <div class="bw-dialog-actions">
                <button type="button" class="bw-button secondary" data-dialog-close>لاحقاً</button>
                <button type="button" class="bw-button primary" id="companyMessageAck">حسناً</button>
            </div>
        </div>
    </dialog>

    <dialog class="bw-dialog cos-seal-dialog" id="companyLowBalanceDialog" aria-labelledby="companyLowBalanceTitle">
        <div class="cos-seal-modal">
            <div class="cos-logo-3d"><span class="cos-rings"></span><img src="/images/logo.jpeg" alt="" onerror="this.onerror=null;this.src='/images/logo.jpg'"></div>
            <h2 id="companyLowBalanceTitle">تنبيه الرصيد</h2>
            <p id="companyLowBalanceCopy"></p>
            <div class="bw-dialog-actions">
                <button type="button" class="bw-button secondary" data-dialog-close>لاحقاً</button>
                <% if (workspace.permissions.canRequestDeposit) { %>
                    <a href="/client/company/deposits" class="bw-button primary" id="companyLowBalanceDeposit"><%= workspace.permissions.manager ? 'طلب إيداع' : 'متابعة الإيداع' %></a>
                <% } %>
            </div>
        </div>
    </dialog>

    <dialog class="bw-dialog<%= workspace.isCompany ? ' cos-seal-dialog' : '' %>" id="transferConfirmDialog" aria-labelledby="transferConfirmTitle">
        <% if (workspace.isCompany) { %>
        <div class="cos-seal-modal">
            <span class="bw-section-kicker">مراجعة قبل الإرسال</span>
            <h2 id="transferConfirmTitle">تأكيد العملية</h2>
            <div class="bw-dialog-body" id="transferConfirmBody"></div>
            <div class="bw-dialog-actions">
                <button type="button" class="bw-button secondary" data-dialog-close>تعديل</button>
                <button type="button" class="bw-button primary" id="transferConfirmSubmit"><i class="fa-solid fa-check"></i>تأكيد وختم</button>
            </div>
        </div>
        <% } else { %>
        <div class="bw-dialog-head">
            <div>
                <span class="bw-section-kicker">مراجعة قبل الإرسال</span>
                <h2 id="transferConfirmTitle">تأكيد العملية</h2>
            </div>
            <button type="button" class="bw-icon-button" data-dialog-close aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="bw-dialog-body" id="transferConfirmBody"></div>
        <div class="bw-dialog-actions">
            <button type="button" class="bw-button secondary" data-dialog-close>تعديل</button>
            <button type="button" class="bw-button primary" id="transferConfirmSubmit"><i class="fa-solid fa-check"></i>تأكيد وختم</button>
        </div>
        <% } %>
    </dialog>

    <dialog class="bw-dialog cos-seal-dialog" id="transferSuccessDialog" aria-labelledby="transferSuccessTitle">
        <div class="cos-seal-modal">
            <div class="cos-logo-3d"><span class="cos-rings"></span><img src="/images/logo.jpeg" alt="" onerror="this.onerror=null;this.src='/images/logo.jpg'"></div>
            <h2 id="transferSuccessTitle">تم استلام العملية</h2>
            <p id="transferSuccessCopy">يمكنك متابعة الحالة من غرفة العمليات.</p>
            <p class="bw-mono" id="transferSuccessRef" hidden></p>
            <div class="bw-dialog-actions">
                <a href="/client/transactions" class="bw-button secondary" id="transferSuccessOps">غرفة العمليات</a>
                <a href="#" class="bw-button <%= workspace.isCompany ? 'primary' : 'ghost' %>" id="transferSuccessWhatsapp" hidden target="_blank" rel="noopener">واتساب العميل</a>
            </div>
            <button type="button" class="bw-button primary wide" data-dialog-close>متابعة يوم العمل</button>
        </div>
    </dialog>

    <dialog class="bw-dialog cos-seal-dialog" id="companyPinDialog" aria-labelledby="companyPinTitle">
        <form class="cos-seal-modal" id="companyPinForm">
            <div class="cos-logo-3d"><span class="cos-rings"></span><img src="/images/logo.jpeg" alt="" onerror="this.onerror=null;this.src='/images/logo.jpg'"></div>
            <h2 id="companyPinTitle">رمز العمليات</h2>
            <p>أدخل الرمز من 4 إلى 6 أرقام لتأكيد التحويل. لا يُحفظ الرمز في المتصفح.</p>
            <label class="bw-field">
                <span class="sr-only">رمز العمليات</span>
                <input id="companyPinInput" type="password" inputmode="numeric" pattern="[0-9]{4,6}" maxlength="6" autocomplete="one-time-code" dir="ltr" required>
            </label>
            <p class="bw-form-result danger" id="companyPinError" hidden></p>
            <div class="bw-dialog-actions">
                <button type="button" class="bw-button secondary" data-dialog-close>إلغاء</button>
                <button type="submit" class="bw-button primary" id="companyPinSubmit">تأكيد الرمز</button>
            </div>
        </form>
    </dialog>

    <dialog class="bw-dialog cos-seal-dialog" id="companyActionDialog" aria-labelledby="companyActionTitle">
        <div class="cos-seal-modal">
            <div class="cos-logo-3d"><span class="cos-rings"></span><img src="/images/logo.jpeg" alt="" onerror="this.onerror=null;this.src='/images/logo.jpg'"></div>
            <h2 id="companyActionTitle">تأكيد الإجراء</h2>
            <p id="companyActionCopy">هل تريد المتابعة؟</p>
            <div class="bw-dialog-actions">
                <button type="button" class="bw-button secondary" data-dialog-close>إلغاء</button>
                <button type="button" class="bw-button primary" id="companyActionSubmit">تأكيد</button>
            </div>
        </div>
    </dialog>

    <dialog class="bw-dialog cos-seal-dialog" id="companyLogoutDialog" aria-labelledby="companyLogoutTitle">
        <div class="cos-seal-modal">
            <div class="cos-logo-3d"><span class="cos-rings"></span><img src="/images/logo.jpeg" alt="" onerror="this.onerror=null;this.src='/images/logo.jpg'"></div>
            <h2 id="companyLogoutTitle">إغلاق يوم العمل</h2>
            <p>سيتم تسجيل خروجك بأمان من غرفة الشركات. يمكنك العودة لاحقاً بنفس حسابك.</p>
            <div class="bw-dialog-actions">
                <button type="button" class="bw-button secondary" data-dialog-close>البقاء</button>
                <a href="/client/logout" class="bw-button primary" data-logout-confirm>تأكيد الخروج</a>
            </div>
        </div>
    </dialog>

    <script>
        window.businessPortal = <%- JSON.stringify({
            page,
            csrfToken,
            workspaceType: workspace.type,
            persona: workspace.persona,
            canViewBalance: workspace.permissions.canViewBalance,
            canRequestDeposit: workspace.permissions.canRequestDeposit,
            lowBalanceAlert,
            ratesUpdatedAt,
            services: serviceCatalog,
            pendingRateUpdate,
            entityName: workspace.entity.name,
            roleLabel: workspace.roleLabel,
            selectedService: typeof servicePage !== 'undefined' ? servicePage.selectedService : 'vodafone'
        }).replace(/</g, '\\u003c') %>;
        window.rateAlertInitial = <%- JSON.stringify(pendingRateUpdate || null).replace(/</g, '\\u003c') %>;
        window.rateAlertPushPublicKey = <%- JSON.stringify(process.env.WEB_PUSH_PUBLIC_KEY || '').replace(/</g, '\\u003c') %>;
        window.rateAlertCsrfToken = <%- JSON.stringify(csrfToken || '').replace(/</g, '\\u003c') %>;
    </script>
    <script>
        (() => {
            const banner = document.getElementById('rateChangeCountdown');
            const value = banner?.querySelector('[data-rate-countdown-value]');
            const details = document.getElementById('rateChangeDetails');
            const activatedBanner = document.getElementById('rateChangeActivated');
            const activatedDetails = document.getElementById('rateChangeActivatedDetails');
            let effectiveAt = window.businessPortal?.pendingRateUpdate?.effectiveAt || null;
            let rateChangesText = window.businessPortal?.pendingRateUpdate?.rateChangesText || '';
            let timer = null;

            const render = () => {
                if (!banner || !value || !effectiveAt) return;
                const seconds = Math.max(0, Math.ceil((new Date(effectiveAt).getTime() - Date.now()) / 1000));
                if (!Number.isFinite(seconds) || seconds <= 0) {
                    banner.hidden = true;
                    if (timer) window.clearInterval(timer);
                    return;
                }
                banner.hidden = false;
                if (details) details.textContent = rateChangesText;
                value.textContent = `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
            };
            const arm = (payload) => {
                effectiveAt = payload?.effectiveAt || null;
                rateChangesText = payload?.rateChangesText || '';
                if (timer) window.clearInterval(timer);
                render();
                if (effectiveAt) timer = window.setInterval(render, 1000);
            };

            arm({ effectiveAt });
            if (typeof window.io === 'function') {
                const socket = window.io();
                socket.on('rate_change_scheduled', arm);
                socket.on('rate_change_activated', (payload) => {
                    effectiveAt = null;
                    if (timer) window.clearInterval(timer);
                    if (banner) banner.hidden = true;
                    if (activatedDetails) activatedDetails.textContent = payload?.currentRatesText || 'تم اعتماد السعر الجديد في حسابك.';
                    if (activatedBanner) {
                        activatedBanner.hidden = false;
                        window.setTimeout(() => { activatedBanner.hidden = true; }, 12000);
                    }
                });
            }
        })();
    </script>
    <script src="/js/client-workspace.js?v=20260902-rate2" defer></script>
</body>
</html>
