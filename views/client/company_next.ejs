<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <title>واجهة الشركات الجديدة | الأهرام Pay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/company-next.css?v=20260918-dashboard-1">
</head>
<body>
<div class="cn-layout cn-desktop-app">
    <aside class="cn-sidebar" id="companyNextSidebar">
        <a class="cn-brand" href="/client/company-next"><img src="/images/logo.jpeg" alt="" onerror="this.onerror=null;this.src='/images/logo.jpg'"><span><b>AL-AHRAM</b><small>بوابة الشركات</small></span></a>
        <nav aria-label="أقسام الشركة">
            <span class="cn-nav-label">مساحة العمل</span>
            <a class="active" href="/client/company-next"><i class="fa-solid fa-chart-pie"></i><span>لوحة القيادة</span></a>
            <% if (workspace.permissions.canTransfer) { %><a href="/client/services"><i class="fa-solid fa-paper-plane"></i><span>تحويل جديد</span></a><% } %>
            <a href="/client/transactions"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>العمليات</span><% if (Number(monthSummary.pendingCount||0)>0) { %><em><%= monthSummary.pendingCount %></em><% } %></a>
            <% if (workspace.permissions.canViewBalance) { %><a href="/client/finance"><i class="fa-solid fa-wallet"></i><span>المالية</span></a><% } %>
            <% if (workspace.permissions.canViewReports) { %><a href="/client/reports"><i class="fa-solid fa-chart-line"></i><span>التقارير</span></a><% } %>
            <span class="cn-nav-label">الإدارة</span>
            <% if (workspace.permissions.manager || workspace.permissions.accountant) { %><a href="/client/staff"><i class="fa-solid fa-users-gear"></i><span>الفريق والصلاحيات</span></a><% } %>
            <a href="/client/support"><i class="fa-solid fa-headset"></i><span>الدعم</span></a>
            <a href="/client/settings/workspace"><i class="fa-solid fa-sliders"></i><span>الإعدادات</span></a>
        </nav>
        <a class="cn-help-card" href="/client/support"><span><i class="fa-regular fa-circle-question"></i></span><div><strong>تحتاج مساعدة؟</strong><small>تواصل مع فريق الدعم</small></div><i class="fa-solid fa-arrow-left"></i></a>
        <div class="cn-sidebar-foot"><span class="cn-avatar"><%= String(workspace.actor.name||'م').trim().charAt(0) %></span><div><strong><%= workspace.actor.name %></strong><small><%= workspace.roleLabel %></small></div><a href="/client/logout" aria-label="تسجيل الخروج"><i class="fa-solid fa-arrow-right-from-bracket"></i></a></div>
    </aside>
    <button class="cn-overlay" type="button" data-menu-close aria-label="إغلاق القائمة"></button>

    <main class="cn-main">
        <header class="cn-topbar">
            <div class="cn-topbar-title"><button type="button" data-menu-open aria-label="فتح القائمة"><i class="fa-solid fa-bars"></i></button><div><small>مساحة عمل الشركة</small><strong><%= workspace.entity.name %></strong></div></div>
            <div class="cn-topbar-actions">
                <span class="cn-live <%= systemOpen?'':'off' %>"><i></i><%= systemOpen?'الخدمة متاحة':'الخدمة متوقفة' %></span>
                <a href="/client/dashboard?home=1" class="cn-old-link"><i class="fa-solid fa-arrow-rotate-left"></i><span>الواجهة الحالية</span></a>
            </div>
        </header>

        <div class="cn-preview-note"><i class="fa-solid fa-flask"></i><span><strong>نسخة معاينة مستقلة</strong> تستخدم نفس الرصيد والعمليات والصلاحيات دون تغيير الواجهة الحالية.</span></div>
        <% const dash=companyDashboard; const money=(value,digits=0)=>Number(value||0).toLocaleString('en-US',{minimumFractionDigits:digits,maximumFractionDigits:digits}); %>
        <header class="cd-heading"><div><span class="cn-kicker">تحليل ذكي مباشر</span><h1>لوحة القيادة</h1><p>قراءة سريعة لحجم التحويلات، أداء الفريق، وحركة اليوم.</p></div><div class="cd-heading-actions"><% if(workspace.permissions.canTransfer){ %><a class="cd-primary" href="/client/services"><i class="fa-solid fa-plus"></i>تحويل جديد</a><% } %><a href="/client/transactions"><i class="fa-solid fa-list-check"></i>كل العمليات</a></div></header>

        <section class="cd-periods">
            <% [['today','إجمالي اليوم','fa-calendar-day'],['week','إجمالي الأسبوع','fa-calendar-week'],['month','إجمالي الشهر','fa-calendar-days']].forEach(item=>{ const period=dash.periods[item[0]]; %>
            <article><span class="cd-period-icon"><i class="fa-solid <%= item[2] %>"></i></span><div><small><%= item[1] %></small><strong><%= money(period.totalEGP) %> <em>ج.م</em></strong><p><b><%= money(period.count) %></b> عملية · <b><%= money(period.totalLYD,2) %></b> د.ل</p></div></article>
            <% }) %>
        </section>

        <section class="cd-insights" aria-label="التحليل الذكي">
            <div><i class="fa-solid fa-wand-magic-sparkles"></i><span><small>أقوى يوم هذا الأسبوع</small><strong><%= dash.insights.bestDay %> · <%= money(dash.insights.bestDayTotal) %> ج.م</strong></span></div>
            <div><i class="fa-solid fa-bullseye"></i><span><small>نسبة نجاح العمليات</small><strong><%= money(dash.insights.successRate,1) %>%</strong></span></div>
            <div><i class="fa-solid fa-scale-balanced"></i><span><small>متوسط العملية</small><strong><%= money(dash.insights.averageOperation) %> ج.م</strong></span></div>
            <div><i class="fa-solid fa-user-check"></i><span><small>الموظف الأعلى</small><strong><%= dash.insights.topEmployee %></strong></span></div>
        </section>

        <section class="cd-panel cd-chart-panel">
            <header><div><span class="cn-kicker">آخر سبعة أيام</span><h2>حركة التحويلات الأسبوعية</h2><p>ارتفاع العمود يمثل القيمة الإجمالية، والرقم أعلى العمود يمثل عدد العمليات.</p></div><div class="cd-legend"><span><i class="amount"></i>القيمة بالجنيه</span><span><i class="count"></i>عدد العمليات</span></div></header>
            <div class="cd-chart" role="img" aria-label="رسم بياني لإجماليات الأسبوع">
                <% dash.weeklySeries.forEach(day=>{ %><div class="cd-chart-day"><div class="cd-chart-value"><b><%= day.count %></b><span><%= money(day.totalEGP) %></span></div><div class="cd-chart-track"><i style="height:<%= day.barPercent %>%"></i></div><strong><%= day.shortLabel %></strong><small><%= day.key.slice(5) %></small></div><% }) %>
            </div>
        </section>

        <section class="cd-panel cd-team-panel">
            <header><div><span class="cn-kicker">تقرير الفريق</span><h2>أداء الموظفين هذا الشهر</h2></div><a href="/client/reports?scope=staff">التقرير الكامل <i class="fa-solid fa-arrow-left"></i></a></header>
            <div class="cd-team-table"><div class="cd-team-head"><span>الموظف</span><span>إجمالي التحويلات</span><span>العمليات</span><span>الناجحة</span><span>الإجمالي الليبي</span></div>
                <% if(!dash.employeePerformance.length){ %><div class="cn-empty"><i class="fa-regular fa-folder-open"></i><strong>لا توجد بيانات موظفين بعد</strong></div><% } %>
                <% dash.employeePerformance.forEach((employee,index)=>{ %><div class="cd-team-row"><span><i><%= index+1 %></i><b><%= employee.name %></b></span><strong><%= money(employee.totalEGP) %> ج.م</strong><span><%= employee.count %></span><span><%= employee.completedCount %></span><span><%= money(employee.totalLYD,2) %> د.ل</span></div><% }) %>
            </div>
        </section>

        <section class="cd-panel cd-today-panel">
            <header><div><span class="cn-kicker">المتابعة المباشرة</span><h2>عمليات اليوم</h2><p><%= dash.todayOperations.length %> عملية مسجلة اليوم</p></div><a href="/client/transactions">عرض كل العمليات <i class="fa-solid fa-arrow-left"></i></a></header>
            <div class="cd-operations-wrap"><table class="cd-operations-table"><thead><tr><th>رقم العملية</th><th>رقم الهاتف</th><th>القيمة بالمصري</th><th>سعر الصرف</th><th>الإجمالي الليبي</th><th>الموظف</th><th>الحالة</th><th>إجراء</th></tr></thead><tbody>
                <% if(!dash.todayOperations.length){ %><tr><td colspan="8"><div class="cn-empty"><i class="fa-regular fa-folder-open"></i><strong>لا توجد عمليات اليوم</strong></div></td></tr><% } %>
                <% dash.todayOperations.forEach(tx=>{ const status=statusMeta[tx.status]||{label:tx.status,tone:'neutral'}; %><tr><td><a class="cd-operation-id" href="/client/transactions?search=<%= encodeURIComponent(tx.customId||'') %>"><%= tx.customId||String(tx._id).slice(-8) %></a></td><td class="cd-mono"><%= tx.phone %></td><td><strong><%= money(tx.amountEGP,2) %></strong> <small>ج.م</small></td><td class="cd-mono"><%= money(tx.exchangeRate,2) %></td><td><strong><%= money(tx.totalLYD,2) %></strong> <small>د.ل</small></td><td><%= tx.employeeName %></td><td><span class="cd-status <%= status.tone %>"><%= status.label %></span></td><td><a class="cd-complaint <%= tx.hasComplaint?'sent':'' %>" href="/client/support?transaction=<%= encodeURIComponent(tx.customId||'') %>"><i class="fa-regular fa-message"></i><%= tx.hasComplaint?'متابعة الشكوى':'شكوى' %></a></td></tr><% }) %>
            </tbody></table></div>
        </section>
    </main>
</div>

<div class="cn-mobile-app">
    <header class="cm-header">
        <div class="cm-identity"><span class="cm-avatar"><%= String(workspace.actor.name||'م').trim().charAt(0) %></span><div><small>مرحباً بك</small><strong><%= workspace.actor.name %></strong></div></div>
        <div class="cm-header-actions"><span class="cm-status <%= systemOpen?'':'off' %>" title="حالة الخدمة"></span><a href="/client/support" aria-label="الدعم"><i class="fa-regular fa-bell"></i></a></div>
    </header>

    <main class="cm-content">
        <% if (workspace.permissions.canViewBalance) { %>
        <section class="cm-balance-card">
            <div class="cm-balance-head"><span>الرصيد المتاح</span><button type="button" data-privacy-mobile aria-label="إخفاء الرصيد"><i class="fa-regular fa-eye"></i></button></div>
            <strong data-sensitive-mobile><%= Number(workspace.entity.balance||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong>
            <small>دينار ليبي <b>LYD</b></small>
            <div class="cm-balance-meta"><span><i class="fa-solid fa-arrow-right-arrow-left"></i><b><%= dash.periods.today.count||0 %></b> عملية اليوم</span><span><i class="fa-solid fa-circle-check"></i><b><%= dash.periods.today.completedCount||0 %></b> مكتملة</span></div>
        </section>
        <% } %>

        <section class="cm-period-strip" aria-label="إجماليات الفترات">
            <% [['today','اليوم'],['week','الأسبوع'],['month','الشهر']].forEach(item=>{ const period=dash.periods[item[0]]; %><article><small><%= item[1] %></small><strong><%= money(period.totalEGP) %></strong><span>ج.م · <%= period.count %> عملية</span></article><% }) %>
        </section>

        <section class="cm-section">
            <header><div><small>وصول سريع</small><h2>ماذا تريد أن تفعل؟</h2></div></header>
            <div class="cm-quick-grid">
                <% if(workspace.permissions.canTransfer){ %><a href="/client/services" class="primary"><i class="fa-solid fa-paper-plane"></i><span>تحويل جديد</span></a><% } %>
                <a href="/client/transactions"><i class="fa-solid fa-receipt"></i><span>العمليات</span></a>
                <% if(workspace.permissions.canViewReports){ %><a href="/client/reports"><i class="fa-solid fa-chart-column"></i><span>التقارير</span></a><% } %>
                <% if(workspace.permissions.canRequestDeposit){ %><a href="/client/company/deposits"><i class="fa-solid fa-wallet"></i><span>إيداع</span></a><% } %>
            </div>
        </section>

        <% if(Number(monthSummary.pendingCount||0)>0 || lowBalanceAlert){ %>
        <section class="cm-notice">
            <i class="fa-solid fa-circle-exclamation"></i><div><strong>يحتاج انتباهك</strong><span><%= lowBalanceAlert ? lowBalanceAlert.title : `${monthSummary.pendingCount} عملية ما زالت قيد المتابعة` %></span></div><a href="<%= lowBalanceAlert?'/client/finance':'/client/transactions?status=pending' %>"><i class="fa-solid fa-chevron-left"></i></a>
        </section>
        <% } %>

        <section class="cm-section cm-weekly">
            <header><div><small>التحليل الذكي</small><h2>أداء الأسبوع</h2></div><span>القيمة والعدد</span></header>
            <div class="cm-week-chart"><% dash.weeklySeries.forEach(day=>{ %><div><b><%= day.count %></b><span><i style="height:<%= day.barPercent %>%"></i></span><small><%= day.shortLabel %></small></div><% }) %></div>
            <div class="cm-smart-line"><i class="fa-solid fa-wand-magic-sparkles"></i><span>أقوى يوم <strong><%= dash.insights.bestDay %></strong> بنسبة نجاح <strong><%= money(dash.insights.successRate,1) %>%</strong></span></div>
        </section>

        <% if(dash.employeePerformance.length){ %><section class="cm-section cm-team"><header><div><small>الفريق</small><h2>أعلى الموظفين</h2></div><a href="/client/reports?scope=staff">التقرير</a></header><div><% dash.employeePerformance.slice(0,3).forEach((employee,index)=>{ %><article><span><i><%= index+1 %></i><strong><%= employee.name %></strong></span><b><%= money(employee.totalEGP) %> <small>ج.م</small></b></article><% }) %></div></section><% } %>

        <section class="cm-section cm-recent">
            <header><div><small>آخر حركة</small><h2>العمليات الأخيرة</h2></div><a href="/client/transactions">عرض الكل</a></header>
            <div class="cm-transaction-list">
                <% if(!dash.todayOperations.length){ %><div class="cm-empty"><i class="fa-regular fa-folder-open"></i><span>لا توجد عمليات اليوم</span></div><% } %>
                <% dash.todayOperations.slice(0,5).forEach(tx=>{ const status=statusMeta[tx.status]||{label:tx.status,tone:'neutral'}; %>
                <article class="cm-transaction">
                    <span class="cm-transaction-icon"><i class="fa-solid fa-money-bill-transfer"></i></span>
                    <div><a href="/client/transactions?search=<%= encodeURIComponent(tx.customId||'') %>"><strong><%= tx.phone %></strong><small><%= tx.customId||'عملية' %> · <%= tx.employeeName %></small></a></div>
                    <div class="cm-transaction-value"><b><%= money(tx.amountEGP) %> <small>ج.م</small></b><em class="<%= status.tone %>"><%= status.label %></em></div>
                    <a class="cm-complaint" href="/client/support?transaction=<%= encodeURIComponent(tx.customId||'') %>" aria-label="فتح شكوى للعملية"><i class="fa-regular fa-message"></i></a>
                </article>
                <% }) %>
            </div>
        </section>
    </main>

    <nav class="cm-bottom-nav" aria-label="التنقل على الهاتف">
        <a class="active" href="/client/company-next"><i class="fa-solid fa-house"></i><span>الرئيسية</span></a>
        <% if(workspace.permissions.canTransfer){ %><a href="/client/services"><i class="fa-solid fa-paper-plane"></i><span>تحويل</span></a><% } %>
        <a href="/client/transactions"><i class="fa-solid fa-receipt"></i><span>العمليات</span></a>
        <a href="/client/settings/workspace"><i class="fa-regular fa-user"></i><span>حسابي</span></a>
    </nav>
</div>
<script>
const sidebar=document.getElementById('companyNextSidebar');
document.querySelector('[data-menu-open]')?.addEventListener('click',()=>document.body.classList.add('menu-open'));
document.querySelector('[data-menu-close]')?.addEventListener('click',()=>document.body.classList.remove('menu-open'));
document.querySelector('[data-privacy]')?.addEventListener('click',event=>{const value=document.querySelector('[data-sensitive]'),hidden=value?.classList.toggle('hidden');event.currentTarget.innerHTML=hidden?'<i class="fa-solid fa-eye-slash"></i> إظهار الرصيد':'<i class="fa-solid fa-eye"></i> إخفاء الرصيد'});
document.querySelector('[data-privacy-mobile]')?.addEventListener('click',event=>{const value=document.querySelector('[data-sensitive-mobile]'),hidden=value?.classList.toggle('hidden');event.currentTarget.innerHTML=hidden?'<i class="fa-regular fa-eye-slash"></i>':'<i class="fa-regular fa-eye"></i>'});
</script>
</body>
</html>
