                        <div class="agent-lookup-actions">
                            <div class="form-floating position-relative">
                                <input type="text" class="form-control" id="newAgentCode" name="agentCode" placeholder="0000" dir="ltr" inputmode="numeric" maxlength="4">
                                <label for="newAgentCode">رقم الوكيل المكون من 4 أرقام</label>
                                <i class="fa-solid fa-hashtag input-icon"></i>
