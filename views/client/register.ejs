                            <div class="small text-muted" id="agentLookupMessage">تم العثور على الوكيل</div>
                            <div class="agent-name" id="agentLookupName"></div>
                            <button type="button" class="continue-agent-btn" id="continueAgentRegistration">
                                متابعة التسجيل <i class="fa-solid fa-arrow-left"></i>
                            </button>
                        </div>
                    </div>

                    <div id="newClientDetails">
                        <div class="form-floating position-relative">
                            <input type="text" class="form-control" id="newFullName" name="newFullName" placeholder="الاسم">
                            <label for="newFullName">اسم العميل الثلاثي</label>
                            <i class="fa-solid fa-user input-icon"></i>
                        </div>
                        <div class="form-floating position-relative">
                            <input type="tel" class="form-control" id="newPhone" name="newPhone" placeholder="الهاتف" dir="ltr">
                            <label for="newPhone">رقم الهاتف</label>
                            <i class="fa-solid fa-phone input-icon"></i>
                        </div>
                        <div class="form-floating position-relative">
                            <input type="text" class="form-control has-domain-suffix" id="newUsername" name="newUsername" placeholder="اسم المستخدم" dir="ltr">
                            <label for="newUsername">اسم المستخدم (باللغة الإنجليزية)</label>
                            <i class="fa-solid fa-at input-icon"></i>
                            <span class="domain-suffix">@ahram.com</span>
                        </div>

                        <div class="nationality-group">
                            <button type="button" class="nationality-btn" data-nat="libyan" onclick="selectNationality(this, 'libyan')">
                                <span class="fs-4">🇱🇾</span> ليبي
                            </button>
                            <button type="button" class="nationality-btn" data-nat="egyptian" onclick="selectNationality(this, 'egyptian')">
                                <span class="fs-4">🇪🇬</span> مصري
                            </button>
                        </div>
                        <input type="hidden" name="nationality" id="nationalityInput">

                        <div class="form-floating position-relative">
                            <select class="form-select" id="newCity" name="newCity">
                                <option value="" disabled selected>حدد المدينة...</option>
                                <%
                                    const cities = typeof libyanCities !== 'undefined' ? libyanCities : [
                                        'طرابلس', 'بنغازي', 'مصراتة', 'الزاوية', 'زليتن', 'الخمس', 'سبها', 'سرت', 'درنة', 'طبرق',
                                        'البيضاء', 'اجدابيا', 'غريان', 'المرج', 'نالوت', 'زوارة', 'صبراتة', 'صرمان', 'يفرن', 'ترهونة',
                                        'بني وليد', 'غات', 'غدامس', 'أوباري', 'مرزق', 'هون', 'ودان', 'الجفرة', 'الكفرة', 'تاجوراء',
                                        'جنزور', 'قصر بن غشير', 'العجيلات', 'رقدالين', 'الجميل', 'زلطن', 'الأصابعة', 'مزدة', 'الشويرف', 'القبة'
                                    ];
                                    cities.forEach((city) => {
                                %>
                                    <option value="<%= city %>"><%= city %></option>
                                <% }) %>
                            </select>
                            <label for="newCity">مدينة الإقامة</label>
                            <i class="fa-solid fa-map-pin input-icon"></i>
                        </div>

                        <div class="form-floating position-relative mb-1">
                            <input type="password" class="form-control" id="newPassword" name="newPassword" placeholder="كلمة المرور" dir="ltr">
                            <label for="newPassword">كلمة المرور</label>
                            <i class="fa-solid fa-lock input-icon"></i>
                        </div>
                        <div class="password-strength mb-3"><div class="bar" id="strengthBarNew"></div></div>

                        <div class="form-floating position-relative mb-1">
                            <input type="password" class="form-control" id="newPasswordConfirm" name="newPasswordConfirm" placeholder="تأكيد" dir="ltr">
                            <label for="newPasswordConfirm">تأكيد المرور</label>
                            <i class="fa-solid fa-shield-check input-icon"></i>
                        </div>
                        <div class="password-match" id="passwordMatchMsgNew"></div>
                    </div>
                </div>

                <!-- 🗺️ وكيل منطقة -->
                <div class="form-section" id="section-agent">
                    <div class="form-floating position-relative">
                        <input type="text" class="form-control" id="agentCompanyName" name="agentCompanyName" placeholder="اسم الشركة">
                        <label for="agentCompanyName">اسم الشركة</label>
                        <i class="fa-solid fa-building input-icon"></i>
                    </div>
                    <div class="form-floating position-relative">
                        <input type="text" class="form-control" id="agentFullName" name="agentFullName" placeholder="الاسم">
                        <label for="agentFullName">اسم الوكيل</label>
                        <i class="fa-solid fa-user-tie input-icon"></i>
                    </div>
                    <div class="form-floating position-relative">
                        <input type="tel" class="form-control" id="agentPhone" name="agentPhone" placeholder="الهاتف" dir="ltr">
                        <label for="agentPhone">رقم الهاتف</label>
                        <i class="fa-solid fa-phone input-icon"></i>
                    </div>
                    <div class="form-floating position-relative">
                        <input type="text" class="form-control" id="agentAddress" name="agentAddress" placeholder="العنوان">
                        <label for="agentAddress">العنوان</label>
                        <i class="fa-solid fa-map-location-dot input-icon"></i>
                    </div>
                    <div class="form-floating position-relative">
                        <input type="email" class="form-control" id="agentEmail" name="agentEmail" placeholder="البريد الرسمي للوكيل" dir="ltr">
                        <label for="agentEmail">البريد الرسمي للوكيل</label>
                        <i class="fa-solid fa-envelope input-icon"></i>
                    </div>
                    <div class="form-floating position-relative">
                        <input type="text" class="form-control has-domain-suffix" id="agentUsername" name="agentUsername" placeholder="اسم المستخدم" dir="ltr">
                        <label for="agentUsername">اسم المستخدم (باللغة الإنجليزية)</label>
                        <i class="fa-solid fa-at input-icon"></i>
                        <span class="domain-suffix">@ahram.com</span>
                    </div>
                    <div class="form-floating position-relative mb-1">
                        <input type="password" class="form-control" id="agentPassword" name="agentPassword" placeholder="كلمة المرور" dir="ltr">
                        <label for="agentPassword">كلمة المرور</label>
                        <i class="fa-solid fa-lock input-icon"></i>
                    </div>
                    <div class="password-strength mb-3"><div class="bar" id="strengthBarAgent"></div></div>
                    
                    <div class="form-floating position-relative mb-1">
                        <input type="password" class="form-control" id="agentPasswordConfirm" name="agentPasswordConfirm" placeholder="تأكيد" dir="ltr">
                        <label for="agentPasswordConfirm">تأكيد كلمة المرور</label>
                        <i class="fa-solid fa-shield-check input-icon"></i>
                    </div>
                    <div class="password-match" id="passwordMatchMsgAgent"></div>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn" disabled>
                    إرسال طلب التسجيل <i class="fa-solid fa-arrow-left"></i>
                </button>
            </form>

            <div class="text-center mt-4">
                <a href="/client/login" class="login-link">
                    لديك حساب بالفعل؟ سجل دخولك <i class="fa-solid fa-arrow-left-long"></i>
                </a>
            </div>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let selectedType = '';
        let verifiedAgentCode = '';
        const restoredFormData = <%- JSON.stringify(typeof formData !== 'undefined' ? formData : {}).replace(/</g, '\\u003c') %>;
        const restoreNewAgentVerified = <%- JSON.stringify(typeof restoreNewAgentVerified !== 'undefined' ? restoreNewAgentVerified : false) %>;
        const restoredAgentName = <%- JSON.stringify(typeof restoredAgentName !== 'undefined' ? restoredAgentName : '').replace(/</g, '\\u003c') %>;

        function showRegisterError(message, focusId) {
            const alert = document.getElementById('registerClientAlert');
            const text = document.getElementById('registerClientAlertText');
            if (text) text.textContent = message;
            if (alert) {
                alert.style.display = 'flex';
                alert.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            const field = focusId ? document.getElementById(focusId) : null;
            if (field) setTimeout(() => field.focus({ preventScroll: true }), 250);
            return false;
        }

        function clearRegisterError() {
            const alert = document.getElementById('registerClientAlert');
            const text = document.getElementById('registerClientAlertText');
            if (alert) alert.style.display = 'none';
            if (text) text.textContent = '';
        }

        function valueOf(id) {
            return (document.getElementById(id)?.value || '').trim();
        }

        function isTripleName(value) {
            return String(value || '').trim().split(/\s+/).filter(Boolean).length >= 3;
        }

        function isValidPhone(value) {
            return String(value || '').replace(/\D/g, '').length >= 10;
        }

        function normalizedUsername(value) {
            const username = String(value || '').trim();
            if (!username) return '';
            return username.includes('@') ? username : `${username}@ahram.com`;
        }

        function isValidUsername(value) {
            return /^[a-zA-Z0-9_]{3,20}@ahram\.com$/.test(normalizedUsername(value));
        }

        function isValidEmail(value) {
            return /^\S+@\S+\.\S+$/.test(String(value || '').trim());
        }

        function validateRegisterForm() {
            clearRegisterError();
            if (!selectedType) return showRegisterError('يرجى اختيار نوع الحساب.');

            if (selectedType === 'direct') {
                if (!isTripleName(valueOf('directFullName'))) return showRegisterError('يرجى إدخال الاسم الثلاثي كاملاً.', 'directFullName');
                if (!isValidPhone(valueOf('directPhone'))) return showRegisterError('يرجى إدخال رقم هاتف صحيح لا يقل عن 10 أرقام.', 'directPhone');
                if (!valueOf('directStoreName')) return showRegisterError('يرجى إدخال اسم المتجر أو الكيان.', 'directStoreName');
                if (!valueOf('directAddress')) return showRegisterError('يرجى إدخال العنوان.', 'directAddress');
                if (!isValidUsername(valueOf('directUsername'))) return showRegisterError('اسم المستخدم يجب أن يكون بالإنجليزية من 3 إلى 20 حرفًا وبدون مسافات.', 'directUsername');
                if (valueOf('directPassword').length < 6) return showRegisterError('كلمة المرور يجب أن تكون 6 أحرف على الأقل.', 'directPassword');
                if (valueOf('directPassword') !== valueOf('directPasswordConfirm')) return showRegisterError('تأكيد كلمة المرور غير مطابق.', 'directPasswordConfirm');
                return true;
            }

            if (selectedType === 'company') {
                if (!valueOf('companyName')) return showRegisterError('يرجى إدخال اسم الشركة القانوني.', 'companyName');
                if (!valueOf('companyContact')) return showRegisterError('يرجى إدخال اسم مدير الشركة.', 'companyContact');
                if (!isValidPhone(valueOf('companyPhone'))) return showRegisterError('يرجى إدخال رقم تواصل صحيح للشركة.', 'companyPhone');
                if (!isValidEmail(valueOf('companyEmail'))) return showRegisterError('يرجى إدخال البريد الإلكتروني الرسمي بشكل صحيح.', 'companyEmail');
                if (!isValidUsername(valueOf('companyUsername'))) return showRegisterError('اسم المستخدم يجب أن يكون بالإنجليزية من 3 إلى 20 حرفًا وبدون مسافات.', 'companyUsername');
                if (valueOf('companyPassword').length < 6) return showRegisterError('كلمة المرور يجب أن تكون 6 أحرف على الأقل.', 'companyPassword');
                if (valueOf('companyPassword') !== valueOf('companyPasswordConfirm')) return showRegisterError('تأكيد كلمة المرور غير مطابق.', 'companyPasswordConfirm');
                return true;
            }

            if (selectedType === 'new') {
                const code = valueOf('newAgentCode').replace(/\D/g, '').slice(0, 4);
                const detailsVisible = document.getElementById('newClientDetails')?.classList.contains('visible');
                if (!/^\d{4}$/.test(code)) return showRegisterError('رقم الوكيل يجب أن يكون 4 أرقام.', 'newAgentCode');
                if (!verifiedAgentCode || verifiedAgentCode !== code || !detailsVisible) {
                    showAgentLookupResult({ success: false, message: 'يرجى التحقق من رقم الوكيل والمتابعة قبل إرسال الطلب.', name: '' });
                    return showRegisterError('يرجى التحقق من رقم الوكيل ثم الضغط على متابعة التسجيل.', 'newAgentCode');
                }
                if (!isTripleName(valueOf('newFullName'))) return showRegisterError('يرجى إدخال اسم العميل الثلاثي.', 'newFullName');
                if (!isValidPhone(valueOf('newPhone'))) return showRegisterError('يرجى إدخال رقم هاتف صحيح.', 'newPhone');
                if (!isValidUsername(valueOf('newUsername'))) return showRegisterError('اسم المستخدم يجب أن يكون بالإنجليزية من 3 إلى 20 حرفًا وبدون مسافات.', 'newUsername');
                if (!valueOf('nationalityInput')) return showRegisterError('يرجى اختيار الجنسية.');
                if (!valueOf('newCity')) return showRegisterError('يرجى اختيار المدينة.', 'newCity');
                if (valueOf('newPassword').length < 6) return showRegisterError('كلمة المرور يجب أن تكون 6 أحرف على الأقل.', 'newPassword');
                if (valueOf('newPassword') !== valueOf('newPasswordConfirm')) return showRegisterError('تأكيد كلمة المرور غير مطابق.', 'newPasswordConfirm');
                return true;
            }

            if (selectedType === 'agent') {
                if (!valueOf('agentCompanyName')) return showRegisterError('يرجى إدخال اسم الشركة.', 'agentCompanyName');
                if (!isTripleName(valueOf('agentFullName'))) return showRegisterError('يرجى إدخال اسم الوكيل الثلاثي.', 'agentFullName');
                if (!isValidPhone(valueOf('agentPhone'))) return showRegisterError('يرجى إدخال رقم هاتف صحيح.', 'agentPhone');
                if (!valueOf('agentAddress')) return showRegisterError('يرجى إدخال العنوان.', 'agentAddress');
                if (!isValidEmail(valueOf('agentEmail'))) return showRegisterError('يرجى إدخال بريد إلكتروني رسمي صحيح.', 'agentEmail');
                if (!isValidUsername(valueOf('agentUsername'))) return showRegisterError('اسم المستخدم يجب أن يكون بالإنجليزية من 3 إلى 20 حرفًا وبدون مسافات.', 'agentUsername');
                if (valueOf('agentPassword').length < 6) return showRegisterError('كلمة المرور يجب أن تكون 6 أحرف على الأقل.', 'agentPassword');
                if (valueOf('agentPassword') !== valueOf('agentPasswordConfirm')) return showRegisterError('تأكيد كلمة المرور غير مطابق.', 'agentPasswordConfirm');
                return true;
            }

            return showRegisterError('يرجى اختيار نوع حساب صحيح.');
        }

        function setNewClientDetailsVisible(visible) {
            const details = document.getElementById('newClientDetails');
            if (!details) return;
            if (visible) {
                details.style.display = 'block';
                setTimeout(() => details.classList.add('visible'), 20);
            } else {
                details.classList.remove('visible');
                setTimeout(() => {
                    if (!details.classList.contains('visible')) details.style.display = 'none';
                }, 220);
            }
        }

        function showAgentLookupResult({ success, message, name }) {
            const result = document.getElementById('agentLookupResult');
            const messageEl = document.getElementById('agentLookupMessage');
            const nameEl = document.getElementById('agentLookupName');
            const continueBtn = document.getElementById('continueAgentRegistration');
            if (!result || !messageEl || !nameEl || !continueBtn) return;

            result.classList.add('show');
            result.classList.toggle('error', !success);
            messageEl.textContent = message;
            nameEl.textContent = success ? name : '';
            continueBtn.style.display = success ? 'block' : 'none';
        }

        function resetAgentLookup() {
            verifiedAgentCode = '';
            const result = document.getElementById('agentLookupResult');
            const submitBtn = document.getElementById('submitBtn');
            if (result) result.classList.remove('show', 'error');
            setNewClientDetailsVisible(false);
            if (selectedType === 'new' && submitBtn) submitBtn.disabled = true;
        }

        function selectAccountType(btn, type) {
            document.querySelectorAll('.account-type-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            selectedType = type;
            document.getElementById('accountTypeInput').value = type;

            document.querySelectorAll('.form-section').forEach(s => {
                const isActiveSection = s.id === 'section-' + type;
                s.querySelectorAll('input, select, textarea').forEach(field => {
                    field.disabled = !isActiveSection;
                });
                s.classList.remove('visible');
                setTimeout(() => { if(!s.classList.contains('visible')) s.style.display = 'none'; }, 300);
            });

            const target = document.getElementById('section-' + type);
            if (target) {
                target.style.display = 'block';
                setTimeout(() => target.classList.add('visible'), 50);
            }
            if (type === 'new') {
                resetAgentLookup();
            } else {
                document.getElementById('submitBtn').disabled = false;
            }
        }

        function selectNationality(btn, nat) {
            document.querySelectorAll('.nationality-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('nationalityInput').value = nat;
        }

        // Strength Logic
        function checkPass(val, barId) {
            const bar = document.getElementById(barId);
            if(!val) return bar.className = 'bar', bar.style.width = '0';
            let score = 0;
            if(val.length >= 6) score++;
            if(val.length >= 8 && /[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
            if(/[^A-Za-z0-9]/.test(val)) score++;
            
            bar.className = 'bar';
            if(score === 1) bar.classList.add('weak');
            else if(score === 2) bar.classList.add('medium');
            else if(score >= 3) bar.classList.add('strong');
        }

        function matchPass(p1, p2, msgId) {
            const v1 = document.getElementById(p1).value;
            const v2 = document.getElementById(p2).value;
            const msg = document.getElementById(msgId);
            if(!v2) return msg.textContent = '';
            if(v1 === v2) { msg.textContent = '✅ الكلمتان متطابقتان'; msg.style.color = '#10b981'; }
            else { msg.textContent = '❌ الكلمتان غير متطابقتين'; msg.style.color = '#ef4444'; }
        }

        document.getElementById('directPassword')?.addEventListener('input', function(){ checkPass(this.value, 'strengthBar'); matchPass('directPassword', 'directPasswordConfirm', 'passwordMatchMsg'); });
        document.getElementById('directPasswordConfirm')?.addEventListener('input', () => matchPass('directPassword', 'directPasswordConfirm', 'passwordMatchMsg'));
        
        document.getElementById('newPassword')?.addEventListener('input', function(){ checkPass(this.value, 'strengthBarNew'); matchPass('newPassword', 'newPasswordConfirm', 'passwordMatchMsgNew'); });
        document.getElementById('newPasswordConfirm')?.addEventListener('input', () => matchPass('newPassword', 'newPasswordConfirm', 'passwordMatchMsgNew'));

        document.getElementById('agentPassword')?.addEventListener('input', function(){ checkPass(this.value, 'strengthBarAgent'); matchPass('agentPassword', 'agentPasswordConfirm', 'passwordMatchMsgAgent'); });
        document.getElementById('agentPasswordConfirm')?.addEventListener('input', () => matchPass('agentPassword', 'agentPasswordConfirm', 'passwordMatchMsgAgent'));

        document.getElementById('companyPassword')?.addEventListener('input', function(){ checkPass(this.value, 'strengthBarCompany'); matchPass('companyPassword', 'companyPasswordConfirm', 'passwordMatchMsgCompany'); });
        document.getElementById('companyPasswordConfirm')?.addEventListener('input', () => matchPass('companyPassword', 'companyPasswordConfirm', 'passwordMatchMsgCompany'));

        document.getElementById('newAgentCode')?.addEventListener('input', function() {
            this.value = this.value.replace(/\D/g, '').slice(0, 4);
            resetAgentLookup();
        });

        document.getElementById('lookupAgentBtn')?.addEventListener('click', async function() {
            const codeInput = document.getElementById('newAgentCode');
            const submitBtn = document.getElementById('submitBtn');
            const code = (codeInput?.value || '').replace(/\D/g, '').slice(0, 4);
            if (!/^\d{4}$/.test(code)) {
                showAgentLookupResult({ success: false, message: 'رقم الوكيل يجب أن يكون 4 أرقام.', name: '' });
                return;
            }

            this.disabled = true;
            this.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> فحص';
            if (submitBtn) submitBtn.disabled = true;
            setNewClientDetailsVisible(false);

            try {
                const response = await fetch(`/client/register/agent-lookup?code=${encodeURIComponent(code)}`, {
                    headers: { 'Accept': 'application/json' }
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok || !data.success) {
                    verifiedAgentCode = '';
                    showAgentLookupResult({ success: false, message: data.error || 'رقم الوكيل غير صحيح أو غير نشط.', name: '' });
                    return;
                }

                verifiedAgentCode = code;
                showAgentLookupResult({
                    success: true,
                    message: 'تم التحقق من الوكيل',
                    name: data.agent?.name || 'وكيل معتمد'
                });
            } catch (error) {
                verifiedAgentCode = '';
                showAgentLookupResult({ success: false, message: 'تعذر الاتصال بالخادم للتحقق من الوكيل.', name: '' });
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i> تحقق';
            }
        });

        document.getElementById('continueAgentRegistration')?.addEventListener('click', function() {
            const submitBtn = document.getElementById('submitBtn');
            setNewClientDetailsVisible(true);
            if (submitBtn) submitBtn.disabled = false;
        });

        // Request GPS coordinates immediately
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const latInput = document.getElementById('latitudeInput');
                    const lngInput = document.getElementById('longitudeInput');
                    if (latInput) latInput.value = position.coords.latitude;
                    if (lngInput) lngInput.value = position.coords.longitude;
                },
                (error) => {
                    console.warn("GPS request warning:", error.message);
                },
                { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
            );
        }

        document.getElementById('registerForm')?.addEventListener('input', clearRegisterError);

        document.getElementById('registerForm')?.addEventListener('submit', function(e) {
            if (!validateRegisterForm()) {
                e.preventDefault();
                return;
            }
            const btn = document.getElementById('submitBtn');
            if (btn) {
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الإرسال...';
                btn.style.pointerEvents = 'none';
            }
        });

        function setFieldValue(id, value) {
            const field = document.getElementById(id);
            if (!field || typeof value !== 'string') return;
            field.value = value;
        }

        function restoreRegisterFormData() {
            const type = restoredFormData.accountType;
            if (!type || !['direct', 'company', 'new', 'agent'].includes(type)) return;

            const typeButton = document.querySelector(`.account-type-btn[data-type="${type}"]`);
            if (typeButton) selectAccountType(typeButton, type);

            const restoreMaps = {
                direct: {
                    directFullName: 'fullName',
                    directPhone: 'phone',
                    directStoreName: 'storeName',
                    directAddress: 'address',
                    directUsername: 'username'
                },
                company: {
                    companyName: 'companyName',
                    companyContact: 'companyContact',
                    companyPhone: 'companyPhone',
                    companyEmail: 'companyEmail',
                    companyUsername: 'username'
                },
                new: {
                    newAgentCode: 'agentCode',
                    newFullName: 'newFullName',
                    newPhone: 'newPhone',
                    newUsername: 'newUsername',
                    newCity: 'newCity'
                },
                agent: {
                    agentCompanyName: 'agentCompanyName',
                    agentFullName: 'agentFullName',
                    agentPhone: 'agentPhone',
                    agentAddress: 'agentAddress',
                    agentEmail: 'agentEmail',
                    agentUsername: 'agentUsername'
                }
            };

            Object.entries(restoreMaps[type] || {}).forEach(([id, fieldName]) => {
                setFieldValue(id, restoredFormData[fieldName]);
            });

            if (type === 'new') {
                const nationality = restoredFormData.nationality;
                if (nationality) {
                    const nationalityButton = document.querySelector(`.nationality-btn[data-nat="${nationality}"]`);
                    if (nationalityButton) selectNationality(nationalityButton, nationality);
                    else setFieldValue('nationalityInput', nationality);
                }

                const code = valueOf('newAgentCode').replace(/\D/g, '').slice(0, 4);
                if (code && restoreNewAgentVerified) {
                    verifiedAgentCode = code;
                    showAgentLookupResult({
                        success: true,
                        message: 'تم التحقق من الوكيل',
                        name: restoredAgentName || 'وكيل معتمد'
                    });
                    setNewClientDetailsVisible(true);
                    const submitBtn = document.getElementById('submitBtn');
                    if (submitBtn) submitBtn.disabled = false;
                } else if (code) {
                    setNewClientDetailsVisible(true);
                }
            }
        }

        restoreRegisterFormData();
    </script>
</body>
</html>
