<% const savedTheme = typeof webhookTheme !== 'undefined' && ['day','night','pharaonic'].includes(webhookTheme) ? webhookTheme : ''; %>
<!doctype html>
<html lang="ar" dir="rtl" data-theme="<%= savedTheme || 'day' %>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="<%= savedTheme === 'night' ? '#0b1426' : savedTheme === 'pharaonic' ? '#1a1510' : '#f4f7fb' %>">
    <title>Webhooks | الأهرام</title>
    <script>
        (() => {
            const server = <%- JSON.stringify(savedTheme) %>;
            let stored;
            try { stored = localStorage.getItem(<%- JSON.stringify(portalBase === '/agent-portal' ? 'ahram_client_theme' : 'ahram_company_theme') %>); } catch (_) {}
            const valid = ['day','night','pharaonic'];
            const theme = valid.includes(server) ? server : valid.includes(stored) ? stored : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <link rel="stylesheet" href="/css/merchant-webhooks.css?v=20261028-1">
    <script src="/js/merchant-webhooks.js?v=20261028-2" defer></script>
</head>
<body>
<main class="wh-page">
    <a class="wh-back" href="<%= portalBase %>/settings#integrations"><span aria-hidden="true">→</span> رجوع للتكاملات</a>
    <header class="wh-header">
        <div><h1>Webhooks</h1><p>تحديثات العمليات إلى نظامك.</p></div>
        <button class="wh-button wh-primary" type="button" data-wh-create disabled><span aria-hidden="true">＋</span> إضافة رابط</button>
    </header>
    <merchant-webhooks></merchant-webhooks>
    <noscript><p class="wh-notice">فعّل JavaScript لعرض الروابط وإدارة سجل الإرسال.</p></noscript>
</main>
<script id="webhook-config" type="application/json"><%- JSON.stringify({portalBase, csrf:csrfToken || '', events:events || []}).replace(/</g,'\\u003c') %></script>
</body>
</html>
