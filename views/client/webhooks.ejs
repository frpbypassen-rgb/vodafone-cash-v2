<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>تكاملات Webhook | الأهرام</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root{color-scheme:dark}body{background:#07111f;color:#e8eef8;font-family:system-ui;margin:0}.shell{max-width:1180px;margin:auto;padding:28px 16px 80px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:22px}.top a{color:#9fb1ca;text-decoration:none}.cardx{background:#0d1b2d;border:1px solid #20344d;border-radius:18px;padding:20px;margin-bottom:16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.endpoint{display:grid;grid-template-columns:1fr auto;gap:10px;border:1px solid #20344d;border-radius:14px;padding:14px;margin-top:10px}.muted{color:#91a4bd}.pill{display:inline-flex;padding:4px 9px;border-radius:999px;background:#17304c;font-size:.78rem;margin:2px}.ok{color:#45d69d}.bad{color:#ff7285}.secret{direction:ltr;word-break:break-all;background:#06101c;border:1px dashed #35c7ff;padding:12px;border-radius:10px}.table-responsive{border:1px solid #20344d;border-radius:12px}.table{--bs-table-bg:transparent;--bs-table-color:#e8eef8;white-space:nowrap}.btn-primary{background:#1686ff;border:0}.form-control,.form-select{background:#071525;border-color:#29405c;color:#fff}.form-control:focus,.form-select:focus{background:#071525;color:#fff}@media(max-width:760px){.grid{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}.endpoint{grid-template-columns:1fr}}
    </style>
</head>
<body><main class="shell">
    <header class="top"><div><h1 class="h3 fw-bold"><i class="fa-solid fa-code-branch text-info"></i> Webhooks</h1><div class="muted">إرسال حالة العمليات إلى نظامك بتوقيع HMAC وإعادة تلقائية عند الفشل.</div></div><a href="/client/settings"><i class="fa-solid fa-arrow-right"></i> العودة للحساب</a></header>
    <merchant-webhooks></merchant-webhooks>
</main>
<script>
window.webhookConfig={csrf:<%- JSON.stringify(csrfToken || '').replace(/</g,'\\u003c') %>,events:<%- JSON.stringify(events || []).replace(/</g,'\\u003c') %>};
class MerchantWebhooks extends HTMLElement{
 constructor(){super();this.data={endpoints:[],deliveries:[]}}
 async connectedCallback(){this.render();await this.load()}
 async api(url,options={}){const headers=new Headers(options.headers||{});headers.set('content-type','application/json');if(!['GET','HEAD'].includes(options.method||'GET'))headers.set('x-csrf-token',window.webhookConfig.csrf);const r=await fetch(url,{...options,headers});const j=await r.json();if(!r.ok)throw new Error(j.error||'REQUEST_FAILED');return j}
 esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
 async load(){try{this.data=await this.api('/client/api/webhooks');this.render()}catch(e){this.notice(e.message,'bad')}}
 notice(text,kind='ok'){const box=this.querySelector('[data-notice]');box.className='cardx '+kind;box.textContent=text;box.hidden=false}
 render(){const {endpoints=[],deliveries=[]}=this.data;this.innerHTML=`<div data-notice hidden></div><div class="grid"><section class="cardx"><h2 class="h5">إضافة نقطة اتصال</h2><form data-create><label class="form-label">الاسم</label><input class="form-control mb-3" name="name" maxlength="100" required placeholder="نظام المحاسبة"><label class="form-label">رابط HTTPS العام</label><input class="form-control mb-3" name="url" type="url" required placeholder="https://example.com/webhooks/ahrampay"><label class="form-label">الأحداث</label><div class="mb-3">${window.webhookConfig.events.map(e=>`<label class="pill"><input type="checkbox" name="events" value="${e}" checked> ${e}</label>`).join('')}</div><button class="btn btn-primary w-100">إنشاء Webhook</button></form></section><section class="cardx"><h2 class="h5">نقاط الاتصال</h2>${endpoints.length?endpoints.map(e=>`<div class="endpoint"><div><strong>${this.esc(e.name)}</strong> <span class="${e.enabled?'ok':'muted'}">● ${e.enabled?'نشط':'متوقف'}</span><div class="small muted" dir="ltr">${this.esc(e.url)}</div><div>${e.events.map(x=>`<span class="pill">${x}</span>`).join('')}</div><small class="${e.failureCount?'bad':'muted'}">فشل متتابع: ${e.failureCount} · آخر مفتاح …${this.esc(e.secretHint)}</small></div><div><button class="btn btn-sm btn-outline-warning" data-toggle="${e.id}" data-enabled="${e.enabled}">${e.enabled?'إيقاف':'تفعيل'}</button> <button class="btn btn-sm btn-outline-info" data-rotate="${e.id}">تدوير المفتاح</button> <button class="btn btn-sm btn-outline-danger" data-delete="${e.id}">حذف</button></div></div>`).join(''):'<p class="muted">لم تتم إضافة أي نقطة اتصال.</p>'}</section></div><section class="cardx"><div class="d-flex justify-content-between"><h2 class="h5">آخر محاولات الإرسال</h2><button class="btn btn-sm btn-outline-light" data-refresh>تحديث</button></div><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>الحدث</th><th>الحالة</th><th>المحاولات</th><th>HTTP</th><th>الوقت</th><th></th></tr></thead><tbody>${deliveries.map(d=>`<tr><td dir="ltr">${this.esc(d.eventType)}</td><td class="${d.status==='delivered'?'ok':d.status==='failed'?'bad':''}">${this.esc(d.status)}</td><td>${d.attemptCount}</td><td>${d.responseCode||'—'}</td><td>${d.createdAt?new Date(d.createdAt).toLocaleString('ar'):'—'}</td><td>${d.status!=='delivered'?`<button class="btn btn-sm btn-outline-info" data-retry="${d._id}">إعادة</button>`:''}</td></tr>`).join('')||'<tr><td colspan="6" class="muted">لا توجد محاولات بعد.</td></tr>'}</tbody></table></div></section>`;this.bind()}
 bind(){this.querySelector('[data-create]')?.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{const j=await this.api('/client/api/webhooks',{method:'POST',body:JSON.stringify({name:f.get('name'),url:f.get('url'),events:f.getAll('events')})});await this.load();this.notice('احفظ المفتاح الآن، لن يظهر مرة أخرى:\n'+j.secret,'ok');const n=this.querySelector('[data-notice]');n.classList.add('secret')}catch(x){this.notice(x.message,'bad')}});this.querySelectorAll('[data-toggle]').forEach(b=>b.onclick=()=>this.update(b.dataset.toggle,{enabled:b.dataset.enabled!=='true'}));this.querySelectorAll('[data-rotate]').forEach(b=>b.onclick=async()=>{const j=await this.update(b.dataset.rotate,{rotateSecret:true},false);this.notice('المفتاح الجديد، احفظه الآن:\n'+j.secret,'ok');this.querySelector('[data-notice]').classList.add('secret')});this.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(confirm('حذف نقطة الاتصال وسجلها؟')){await this.api('/client/api/webhooks/'+b.dataset.delete,{method:'DELETE'});await this.load()}});this.querySelectorAll('[data-retry]').forEach(b=>b.onclick=async()=>{await this.api('/client/api/webhook-deliveries/'+b.dataset.retry+'/retry',{method:'POST',body:'{}'});await this.load()});this.querySelector('[data-refresh]')?.addEventListener('click',()=>this.load())}
 async update(id,body,reload=true){try{const j=await this.api('/client/api/webhooks/'+id,{method:'PATCH',body:JSON.stringify(body)});if(reload)await this.load();return j}catch(e){this.notice(e.message,'bad');throw e}}
}customElements.define('merchant-webhooks',MerchantWebhooks);
</script></body></html>
