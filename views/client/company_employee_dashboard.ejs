<!DOCTYPE html>
<html lang="ar" dir="rtl">
<%- include('partials/company_portal_head', { title: 'واجهة الموظف' }) %>
<body>
    <%- include('partials/company_portal_nav') %>

    <main class="shell portal-shell">
        <%- include('partials/company_portal_hero', {
            heroEntity: company,
            heroIcon: 'fa-user-tie',
            heroEyebrow: 'مساحة موظف الشركة',
            heroTitle: 'عمليات اليوم',
            heroSubtitle: company.name + ' - تنفيذ التحويلات ومتابعة عمليات الشركة اليومية من شاشة واحدة.',
            showHeroTransfer: true,
            showHeroSupport: true
        }) %>

        <%- include('partials/company_stats') %>
        <%- include('partials/company_portal_actions', { showTransfer: true, showOperations: true, showTeam: false, showReports: false, showSupport: true }) %>

        <section class="portal-section portal-view" id="profile" data-portal-view="profile" data-portal-title="بيانات الموظف" hidden>
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-id-card"></i>ملف المستخدم</span>
                    <h2 class="portal-section-title">بيانات الموظف</h2>
                </div>
                <span class="portal-section-meta">حساب نشط</span>
            </div>
            <section class="panel">
                <div class="panel-heading">
                    <h2 class="panel-title"><i class="fa-solid fa-id-card"></i>بيانات الموظف</h2>
                    <span class="status-pill st-completed">نشط</span>
                </div>
                <div class="panel-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="small-muted">الاسم</div>
                            <div class="fw-bold"><%= account.name %></div>
                        </div>
                        <div class="col-md-4">
                            <div class="small-muted">اسم المستخدم</div>
                            <div class="mono-num" dir="ltr"><%= account.webUsername %></div>
                        </div>
                        <div class="col-md-4">
                            <div class="small-muted">الشركة</div>
                            <div class="fw-bold"><%= company.name %></div>
                        </div>
                    </div>
                </div>
            </section>
        </section>

        <section class="portal-section portal-view" id="transactions" data-portal-view="transactions" data-portal-title="عمليات اليوم" hidden>
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-list-check"></i>حركة اليوم</span>
                    <h2 class="portal-section-title">عمليات الشركة اليومية</h2>
                </div>
                <span class="portal-section-meta"><%= dateLabel %></span>
            </div>
            <%- include('partials/company_transactions_table', { showFilters: false }) %>
        </section>
    </main>

    <%- include('partials/company_transfer_modal') %>
    <%- include('partials/company_portal_scripts') %>
</body>
</html>
