<section class="bw-smart-transfer" aria-labelledby="smartTransferTitle">
    <header class="bw-smart-transfer-head">
        <div class="bw-smart-transfer-title">
            <span class="bw-smart-transfer-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
            <div><span class="bw-section-kicker">إدخال سريع</span><h2 id="smartTransferTitle">مساعد التحويل الذكي</h2></div>
        </div>
        <span class="bw-private-chip"><i class="fa-solid fa-shield-halved"></i>معالجة آمنة</span>
    </header>
    <div class="bw-smart-transfer-input">
        <label class="bw-field">
            <span>رسالة التحويل</span>
            <textarea id="smartTransferMessage" rows="4" maxlength="2000" placeholder="01012345678 | 1,600 جنيه | ملاحظة: دفعة أحمد"></textarea>
        </label>
        <div class="bw-smart-transfer-command">
            <button type="button" class="bw-button secondary" id="smartTransferAnalyzeButton"><i class="fa-solid fa-bolt"></i>تحليل الرسالة</button>
            <div class="bw-smart-transfer-status" id="smartTransferStatus" aria-live="polite" hidden></div>
        </div>
    </div>
    <div class="bw-smart-transfer-preview" id="smartTransferPreview" hidden>
        <div class="bw-smart-preview-grid">
            <div><span>رقم الهاتف</span><strong class="bw-mono" id="smartPreviewPhone">---</strong></div>
            <div><span>القيمة بالجنيه</span><strong class="bw-mono" id="smartPreviewAmount">---</strong></div>
            <div><span>سعر الصرف</span><strong class="bw-mono" id="smartPreviewRate">---</strong></div>
            <div><span>المقابل بالدينار</span><strong class="bw-mono" id="smartPreviewLyd">---</strong></div>
            <div class="wide"><span>ملاحظة العميل</span><strong id="smartPreviewNote">لا توجد ملاحظة</strong></div>
        </div>
        <div class="bw-smart-preview-actions">
            <span id="smartPreviewService"><i class="fa-solid fa-mobile-screen-button"></i>محافظ كاش</span>
            <button type="button" class="bw-button primary" id="smartTransferSendButton" disabled><i class="fa-solid fa-paper-plane"></i>إرسال العملية</button>
        </div>
    </div>
</section>

<section class="bw-service-layout">
    <div class="bw-service-catalog">
        <header class="bw-section-head">
            <div><span class="bw-section-kicker">اختر الخدمة</span><h2>قنوات التحويل المتاحة</h2></div>
            <span class="bw-meta-chip"><%= serviceCatalog.length %> خدمات</span>
        </header>
        <div class="bw-service-grid" role="list">
            <% serviceCatalog.forEach(service => { %>
                <button type="button" class="bw-service-option <%= servicePage.selectedService === service.key ? 'active' : '' %>" data-service-key="<%= service.key %>" role="listitem" aria-pressed="<%= servicePage.selectedService === service.key ? 'true' : 'false' %>">
                    <span class="bw-service-icon tone-<%= service.tone %>"><i class="fa-solid <%= service.icon %>"></i></span>
                    <span class="bw-service-option-copy"><strong><%= service.label %></strong><small><%= service.description %></small></span>
                    <span class="bw-service-rate"><strong class="bw-mono"><span>1 LYD</span><i>=</i><span data-service-rate-value><%= Number(service.rate).toFixed(2) %> EGP</span></strong><small>سعر الجنيه مقابل الدينار</small></span>
                    <i class="fa-solid fa-circle-check bw-selected-mark"></i>
                </button>
            <% }) %>
        </div>
    </div>

    <section class="bw-transfer-workbench">
        <header class="bw-section-head">
            <div><span class="bw-section-kicker">بيانات العملية</span><h2 id="selectedServiceTitle">إنشاء تحويل</h2></div>
            <span class="bw-secure-label"><i class="fa-solid fa-shield-halved"></i>إرسال آمن</span>
        </header>
        <form id="businessTransferForm" class="bw-form" enctype="multipart/form-data" novalidate>
            <input type="hidden" name="type" id="transferType" value="كاش">
            <input type="hidden" name="number" id="transferAccountNumber" value="">
            <div class="bw-form-grid">
                <label class="bw-field span-2" data-destination-field>
                    <span id="destinationFieldLabel">رقم المحفظة</span>
                    <input type="text" name="phone" id="transferDestination" class="bw-input bw-mono" dir="ltr" inputmode="numeric" autocomplete="off" required>
                    <small id="destinationFieldHint">أدخل رقم المستلم بدقة.</small>
                </label>
                <label class="bw-field span-2" data-beneficiary-field hidden>
                    <span id="beneficiaryFieldLabel">اسم المستفيد</span>
                    <input type="text" name="name" id="transferBeneficiary" autocomplete="off" maxlength="160" placeholder="أدخل اسم المستفيد">
                </label>
                <label class="bw-field" data-subtype-field hidden>
                    <span>نوع خدمة سيفا</span>
                    <select name="serviceSubtype" id="transferSubtype">
                        <option value="nita">NITA</option>
                        <option value="nita_account">NITA Account</option>
                    </select>
                </label>
                <label class="bw-field" data-city-field hidden>
                    <span>مدينة المستفيد</span>
                    <input type="text" name="city" id="transferCity" autocomplete="off" maxlength="100">
                </label>
                <label class="bw-field" data-national-id-field hidden>
                    <span>الرقم القومي (14 رقم)</span>
                    <input type="text" name="nationalId" id="transferNationalId" class="bw-mono" dir="ltr" inputmode="numeric" autocomplete="off" minlength="14" maxlength="14" placeholder="14 رقم">
                </label>
                <label class="bw-field" data-governorate-field hidden>
                    <span>المحافظة</span>
                    <select name="governorate" id="transferGovernorate">
                        <option value="">اختر المحافظة</option>
                        <option value="القاهرة">القاهرة</option>
                        <option value="الإسكندرية">الإسكندرية</option>
                        <option value="الجيزة">الجيزة</option>
                    </select>
                </label>
                <label class="bw-field span-2" data-identity-field hidden>
                    <span>صورة البطاقة من الأمام</span>
                    <input type="file" name="idCardImage" id="transferIdentityImage" accept="image/jpeg,image/png,image/webp">
                    <small>JPG أو PNG أو WEBP، بحد أقصى 5MB.</small>
                </label>
                <div class="bw-currency-pair span-2">
                    <label class="bw-field">
                        <span>المبلغ بالجنيه المصري</span>
                        <div class="bw-input-affix"><input type="number" name="amount" id="transferAmount" min="1" step="0.01" inputmode="decimal" placeholder="0.00" required><b>EGP</b></div>
                    </label>
                    <div class="bw-fx-bridge" aria-live="polite">
                        <span>سعر الصرف</span>
                        <strong class="bw-mono" id="transferRateBridge">1 LYD = 0.00 EGP</strong>
                        <small>EGP ÷ السعر = LYD</small>
                    </div>
                    <label class="bw-field">
                        <span>المقابل بالدينار الليبي</span>
                        <div class="bw-input-affix"><input type="number" id="transferAmountLyd" min="0.01" step="0.01" inputmode="decimal" placeholder="0.00"><b>LYD</b></div>
                    </label>
                </div>
                <label class="bw-field span-2">
                    <span>رقم هاتف العميل <em>اختياري</em></span>
                    <input type="text" name="clientPhone" id="transferClientPhone" class="bw-mono" dir="ltr" inputmode="tel" autocomplete="off" maxlength="30" placeholder="رقم هاتف العميل">
                </label>
                <label class="bw-field span-2">
                    <span>ملاحظة العميل <em>اختياري</em></span>
                    <textarea name="notes" id="transferNotes" rows="3" maxlength="500" placeholder="اكتب الملاحظة التي تريد ظهورها مع العملية فقط"></textarea>
                </label>
            </div>

            <div class="bw-cost-preview">
                <div><span>الخدمة</span><strong id="costServiceLabel">محافظ كاش</strong></div>
                <div><span>سعر الصرف</span><strong class="bw-mono" id="costRate">1 LYD = 0.00 EGP</strong></div>
                <div><span>التكلفة التقديرية</span><strong class="bw-mono" id="costEstimate">0.000 LYD</strong></div>
            </div>
            <div class="bw-form-result" id="transferFormResult" hidden></div>
            <button type="submit" class="bw-button primary wide" id="transferSubmitButton">
                <i class="fa-solid fa-lock"></i><span>مراجعة وإرسال العملية</span>
            </button>
        </form>
    </section>
</section>

<section class="bw-section bw-internal-transfer">
    <header class="bw-section-head">
        <div><span class="bw-section-kicker">بين الحسابات</span><h2>تحويل رصيد داخلي</h2></div>
        <span class="bw-meta-chip">يولد إيصالاً مستقلاً</span>
    </header>
    <form id="balanceTransferForm" class="bw-inline-form">
        <label class="bw-field"><span>رقم حساب المستلم</span><input type="text" name="targetAccountCode" class="bw-input bw-mono" inputmode="numeric" minlength="4" maxlength="6" required></label>
        <label class="bw-field"><span>المبلغ بالدينار</span><input type="number" name="amount" min="0.01" step="0.01" required></label>
        <label class="bw-field grow"><span>ملاحظة التحويل</span><input type="text" name="notes" maxlength="300"></label>
        <button type="submit" class="bw-button secondary"><i class="fa-solid fa-right-left"></i>تحويل الرصيد</button>
    </form>
    <div class="bw-form-result" id="balanceTransferResult" hidden></div>
</section>
