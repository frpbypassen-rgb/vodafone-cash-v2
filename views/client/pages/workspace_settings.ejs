<% const accountCode = workspace.entity.accountCode || workspace.entity.agentCode || '---'; const canEdit = workspace.permissions.canEditSettings; %>

<% if (workspace.isCompany) { %>
<section class="cos-ledger-office">
    <div>
        <span class="bw-section-kicker">ملف الشركة</span>
        <h2>بيانات المنشأة</h2>
        <p>التواصل والمدينة والسجل في هذه الصفحة. كلمة المرور والأجهزة في أمان الحساب.</p>
    </div>
    <div class="cos-ledger-links">
        <a href="/client/security" class="bw-button ghost"><i class="fa-solid fa-shield-halved"></i>أمان الحساب</a>
    </div>
</section>
<% } else { %>
<section class="bw-settings-hero">
    <div><span class="bw-section-kicker"><i class="fa-solid fa-sliders"></i> مركز التحكم</span><h2>إعدادات <%= workspace.entityLabel %></h2><p>كل قسم مستقل في هذه الصفحة. لا تبويبات ولا اختصارات مكررة.</p></div>
    <div class="bw-settings-health">
        <span><i class="fa-solid fa-circle-check"></i> الحساب نشط</span>
        <span><i class="fa-solid fa-signal"></i> <%= systemOpen ? 'الخدمة متاحة' : 'الخدمة متوقفة' %></span>
    </div>
</section>
<% } %>

<section class="bw-settings-health-grid" aria-label="ملخص الحساب">
    <article><span class="tone-blue"><i class="fa-solid fa-id-card"></i></span><div><small>رقم الحساب</small><strong class="bw-mono"><%= accountCode %></strong></div></article>
    <article><span class="tone-green"><i class="fa-solid fa-user-shield"></i></span><div><small>دورك الحالي</small><strong><%= workspace.roleLabel %></strong></div></article>
    <% if (workspace.permissions.canViewBalance) { %>
    <article><span class="tone-gold"><i class="fa-solid fa-wallet"></i></span><div><small>الحد الائتماني</small><strong class="bw-mono"><%= Number(workspace.entity.creditLimit || 0).toFixed(2) %> LYD</strong></div></article>
    <% } %>
    <article><span class="tone-violet"><i class="fa-solid fa-building-shield"></i></span><div><small>اسم الدخول</small><strong dir="ltr"><%= workspace.actor.webUsername || workspace.actor.phone %></strong></div></article>
</section>

<div class="bw-settings-stack">
    <section class="bw-settings-panel active" id="identity">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-blue"><i class="fa-solid fa-address-card"></i></span><div><span>الحساب والملف الشخصي</span><h2>بيانات <%= workspace.entityLabel %></h2><p>معلومات التواصل المستخدمة داخل المنظومة.</p></div></header>
        <form method="POST" action="/client/settings/profile" class="bw-form bw-form-grid">
            <label class="bw-field span-2"><span>اسم <%= workspace.entityLabel %></span><input type="text" value="<%= workspace.entity.name %>" disabled><small>يتم تعديل الاسم القانوني عن طريق الإدارة.</small></label>
            <label class="bw-field"><span>اسم مسؤول التواصل</span><input type="text" name="contactName" value="<%= settingsData.profile.contactName || '' %>" maxlength="120" <%= canEdit ? '' : 'disabled' %>></label><label class="bw-field"><span>رقم التواصل</span><input type="tel" name="phone" value="<%= workspace.entity.phone || '' %>" dir="ltr" maxlength="32" <%= canEdit ? '' : 'disabled' %>></label>
            <label class="bw-field"><span>البريد الإلكتروني</span><input type="email" name="email" value="<%= settingsData.profile.email || '' %>" dir="ltr" maxlength="160" <%= canEdit ? '' : 'disabled' %>></label><label class="bw-field"><span>المدينة</span><input type="text" name="city" value="<%= settingsData.profile.city || '' %>" maxlength="80" <%= canEdit ? '' : 'disabled' %>></label>
            <label class="bw-field span-2"><span>العنوان</span><input type="text" name="address" value="<%= settingsData.profile.address || '' %>" maxlength="240" <%= canEdit ? '' : 'disabled' %>></label><label class="bw-field span-2"><span>رقم السجل أو الترخيص</span><input type="text" name="registrationNumber" value="<%= settingsData.profile.registrationNumber || '' %>" maxlength="80" <%= canEdit ? '' : 'disabled' %>></label>
            <% if (canEdit) { %><div class="bw-form-actions span-2"><button type="submit" class="bw-button primary"><i class="fa-solid fa-floppy-disk"></i>حفظ بيانات الحساب</button></div><% } else { %><p class="bw-setting-note span-2"><i class="fa-solid fa-lock"></i>لا تملك صلاحية تعديل بيانات المنشأة.</p><% } %>
        </form>
    </section>

    <section class="bw-settings-panel" id="preferences">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-violet"><i class="fa-solid fa-palette"></i></span><div><span>المظهر والتجربة</span><h2>واجهة هذا الجهاز</h2><p>هذه الخيارات تُحفظ في المتصفح الحالي فقط.</p></div></header>
        <div class="bw-settings-choice-grid">
            <label class="bw-field"><span>المظهر</span><select id="workspaceThemeSelect" data-preference="theme"><option value="light">فاتح</option><option value="dark">داكن</option><option value="system">حسب الجهاز</option></select></label>
            <% if (!workspace.isCompany) { %>
            <label class="bw-field"><span>كثافة الجداول</span><select id="workspaceDensitySelect" data-preference="density"><option value="comfortable">مريحة</option><option value="compact">مضغوطة</option></select></label>
            <% } %>
        </div>
        <div class="bw-setting-note"><i class="fa-solid fa-display"></i><span><strong>تجربة شخصية لكل جهاز</strong><small>لن يتأثر إعداد أي موظف آخر بخياراتك.</small></span></div>
    </section>

    <% if (!workspace.isCompany) { %>
    <section class="bw-settings-panel bw-settings-security" id="security">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-green"><i class="fa-solid fa-shield-halved"></i></span><div><span>الأمان والدخول</span><h2>حماية الحساب</h2><p>استخدم كلمة مرور قوية وراجع الأجهزة المسجلة بانتظام.</p></div></header>
        <div class="bw-settings-security-grid"><form method="POST" action="/client/settings/password" class="bw-form bw-form-grid"><label class="bw-field span-2"><span>كلمة المرور الحالية</span><input type="password" name="currentPassword" autocomplete="current-password" required></label><label class="bw-field"><span>كلمة المرور الجديدة</span><input type="password" name="newPassword" minlength="8" autocomplete="new-password" required></label><label class="bw-field"><span>تأكيد كلمة المرور</span><input type="password" name="passwordConfirm" minlength="8" autocomplete="new-password" required></label><div class="bw-form-actions span-2"><button type="submit" class="bw-button secondary"><i class="fa-solid fa-key"></i>تحديث كلمة المرور</button><a class="bw-button ghost" href="/security/sessions"><i class="fa-solid fa-laptop-mobile"></i>الأجهزة والجلسات</a></div></form><%- include('../../partials/mfa_security_panel') %></div>
    </section>
    <% } %>

    <% if (!workspace.isCompany) { %>
    <section class="bw-settings-panel" id="services">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-gold"><i class="fa-solid fa-tags"></i></span><div><span>الخدمات والأسعار</span><h2>الأسعار الفعالة لحسابك</h2><p>يتم تحديدها مركزياً بحسب باقة الحساب وصلاحياته.</p></div></header>
        <div class="bw-rate-list"><% serviceCatalog.forEach(service => { %><div class="bw-rate-row"><span class="bw-service-icon tone-<%= service.tone %>"><i class="fa-solid <%= service.icon %>"></i></span><div><strong><%= service.label %></strong><small><%= service.description %></small></div><strong class="bw-mono"><%= Number(service.rate).toFixed(2) %></strong></div><% }) %></div>
    </section>
    <% } %>
</div>
