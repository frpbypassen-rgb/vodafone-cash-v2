<section class="bw-report-toolbar">
    <div class="bw-segmented" role="navigation" aria-label="نوع التقرير">
        <% Object.entries(reportScopes).forEach(([scopeKey, scopeLabel]) => { const params = new URLSearchParams({ ...query, scope: scopeKey }); params.delete('page'); %>
            <a href="/client/reports?<%= params.toString() %>" class="<%= reportScope === scopeKey ? 'active' : '' %>"><i class="fa-solid <%= scopeKey === 'organization' ? 'fa-building' : scopeKey === 'customers' ? 'fa-users' : 'fa-user-group' %>"></i><%= scopeLabel %></a>
        <% }) %>
    </div>
    <% if (workspace.isCompany) { const centralPdfParams = new URLSearchParams(query); %>
        <div class="bw-report-actions"><a href="/client/reports/central.pdf?<%= centralPdfParams.toString() %>" class="bw-button primary bw-central-download"><i class="fa-solid fa-file-pdf"></i>تحميل كشف حساب</a></div>
    <% } %>
</section>

<% if (workspace.isCompany && centralAdminReport) { const centralStats = centralAdminReport.stats || {}; const centralClosure = centralAdminReport.closure || {}; %>
<section class="bw-section bw-central-downloads">
    <header class="bw-section-head"><div><span class="bw-section-kicker">نفس محرك الإدارة</span><h2>الملخص المالي الرسمي</h2></div><span class="bw-meta-chip"><i class="fa-solid fa-building-columns"></i><%= centralAdminReport.range?.dateType === 'day' ? 'تقرير يومي' : 'تقرير شهري' %></span></header>
    <div class="bw-mini-metrics report">
        <article><span>الرصيد السابق</span><strong class="bw-mono"><%= Number(centralStats.previousBalance || 0).toFixed(3) %> <small>LYD</small></strong></article>
        <article class="blue"><span>تكلفة التحويلات</span><strong class="bw-mono"><%= Number(centralStats.operationsCost || 0).toFixed(3) %> <small>LYD</small></strong></article>
        <article class="success"><span>الإيداعات</span><strong class="bw-mono"><%= Number(centralStats.totalDeposits || 0).toFixed(3) %> <small>LYD</small></strong></article>
        <article class="danger"><span>الخصومات</span><strong class="bw-mono"><%= Number(centralStats.totalDeductions || 0).toFixed(3) %> <small>LYD</small></strong></article>
        <article class="warning"><span>صافي الفترة</span><strong class="bw-mono"><%= Number(centralStats.dailyNet || 0).toFixed(3) %> <small>LYD</small></strong></article>
        <article><span>الرصيد الختامي</span><strong class="bw-mono"><%= Number(centralStats.endingBalance || 0).toFixed(3) %> <small>LYD</small></strong></article>
    </div>
    <div class="bw-central-report-banner"><span class="bw-central-report-seal"><i class="fa-solid fa-lock"></i></span><div><strong><%= centralClosure.closedDayCount ? `تم إقفال ${centralClosure.closedDayCount} يوم مالي` : 'الفترة مفتوحة مالياً' %></strong><p><%= centralClosure.hasPostCloseChanges ? `رُصد ${centralAdminReport.closedDayChanges?.length || 0} تعديل بعد الإقفال.` : 'لا توجد تعديلات مالية مرصودة بعد الإقفال.' %></p></div></div>
</section>
<% } %>

<section class="bw-section bw-central-downloads">
    <header class="bw-section-head"><div><span class="bw-section-kicker">سجل موثّق</span><h2>آخر الملفات الصادرة</h2></div><span class="bw-meta-chip"><i class="fa-solid fa-shield-halved"></i>من الإدارة المركزية</span></header>
    <% if (!centralDownloads.length) { %>
        <div class="bw-empty compact"><i class="fa-solid fa-file-arrow-down"></i><strong>لم يتم تنزيل تقارير بعد</strong><span>ستظهر هنا كل نسخة تم تنزيلها من الحساب.</span></div>
    <% } else { %>
        <div class="bw-central-download-list">
            <% centralDownloads.forEach(item => { const meta = item.metadata || {}; %>
                <article><span><i class="fa-solid fa-file-csv"></i></span><div><strong class="bw-mono"><%= meta.reportId || 'تقرير مركزي' %></strong><small><%= meta.scope === 'staff' ? 'تقرير الموظفين' : 'تقرير المنشأة' %> · <%= meta.period || 'الفترة المحددة' %></small></div><div class="bw-central-download-proof"><b class="bw-mono"><%= meta.checksum || 'SHA-256' %></b><small>بواسطة <%= item.performedByName || 'مستخدم الحساب' %> · <%= new Date(item.createdAt).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli', hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' }) %></small></div></article>
            <% }) %>
        </div>
    <% } %>
</section>

<section class="bw-central-report-banner" aria-label="مصدر التقرير">
    <span class="bw-central-report-seal"><i class="fa-solid fa-building-shield"></i></span>
    <div>
        <strong>تقرير موحّد من الإدارة المركزية</strong>
        <p>البيانات والملف يتم إنشاؤهما من المصدر المالي المركزي نفسه لضمان تطابق التقرير لدى الشركة والإدارة.</p>
    </div>
    <dl>
        <div><dt>رقم التقرير</dt><dd class="bw-mono"><%= centralReport.reportId %></dd></div>
        <div><dt>بصمة التحقق</dt><dd class="bw-mono"><%= centralReport.checksum %></dd></div>
        <div><dt>وقت الإنشاء</dt><dd class="bw-mono"><%= new Date(centralReport.issuedAt).toLocaleString('en-GB', { timeZone: 'Africa/Tripoli', hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' }) %></dd></div>
        <div><dt>حالة السجل المركزي</dt><dd class="bw-central-sync <%= centralSync.status === 'ready' ? 'ready' : '' %>"><i class="fa-solid <%= centralSync.status === 'ready' ? 'fa-circle-check' : 'fa-arrows-rotate' %>"></i><%= centralSync.status === 'ready' ? 'متزامن' : 'قيد التحديث' %></dd></div>
    </dl>
</section>

<section class="bw-filter-band">
    <form method="GET" action="/client/reports" class="bw-filter-form">
        <input type="hidden" name="scope" value="<%= reportScope %>">
        <% if (workspace.isCompany) { const companyInput = centralAdminReportInput || {}; %>
            <label><span>نوع الفترة</span><select name="centralDateType"><option value="day" <%= companyInput.dateType === 'day' ? 'selected' : '' %>>يوم محدد</option><option value="month" <%= companyInput.dateType === 'month' ? 'selected' : '' %>>شهر محدد</option><option value="range" <%= companyInput.dateType === 'range' ? 'selected' : '' %>>فترة محددة</option></select></label>
            <label><span>اليوم</span><input type="date" name="centralDay" value="<%= companyInput.dateType === 'day' ? companyInput.dateValue : '' %>"></label>
            <label><span>الشهر</span><input type="month" name="centralMonth" value="<%= companyInput.dateType === 'month' ? companyInput.dateValue : '' %>"></label>
            <label><span>من</span><input type="date" name="centralFrom" value="<%= companyInput.dateFrom || '' %>"></label>
            <label><span>إلى</span><input type="date" name="centralTo" value="<%= companyInput.dateTo || '' %>"></label>
            <label><span>الموظف</span><select name="centralEmployee"><option value="all">كل الموظفين</option><% companyReportEmployees.forEach(employee => { %><option value="<%= employee.name %>" <%= companyInput.subType === employee.name ? 'selected' : '' %>><%= employee.name %><%= employee.role ? ` — ${employee.role}` : '' %></option><% }) %></select></label>
        <% } else if (!workspace.forceToday) { %>
            <label><span>من</span><input type="date" name="from" value="<%= filters.from %>"></label>
            <label><span>إلى</span><input type="date" name="to" value="<%= filters.to %>"></label>
            <label><span>أو اختر شهراً</span><input type="month" name="month" value="<%= filters.month %>"></label>
        <% } else { %>
            <span class="bw-meta-chip"><i class="fa-regular fa-calendar-check"></i>اليوم فقط</span>
        <% } %>
        <button type="submit" class="bw-button primary compact"><i class="fa-solid fa-chart-simple"></i>إنشاء التقرير</button>
    </form>
</section>

<section class="bw-report-cover bw-report-cover-certified">
    <div class="bw-report-brand"><img src="/images/logo.jpeg" alt="Power Pay AL-Ahram" onerror="this.onerror=null;this.src='/images/logo.jpg'"><div><span>Power Pay AL-Ahram</span><strong><%= reportScopeLabel %></strong><small><%= workspace.entity.name %></small></div></div>
    <dl><div><dt>الفترة</dt><dd><%= filters.label %></dd></div><div><dt>المصدر</dt><dd>الإدارة المركزية</dd></div><div><dt>تاريخ الإصدار</dt><dd class="bw-mono"><%= now.toLocaleDateString('en-GB', { timeZone: 'Africa/Tripoli' }) %></dd></div></dl>
</section>

<section class="bw-mini-metrics report">
    <article><span>إجمالي العمليات</span><strong class="bw-mono"><%= reportSummary.totalCount %></strong></article>
    <article class="success"><span>العمليات الناجحة</span><strong class="bw-mono"><%= reportSummary.completedCount %></strong></article>
    <article class="blue"><span>إجمالي التحويلات</span><strong class="bw-mono"><%= Number(reportSummary.totalEGP).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> <small>EGP</small></strong></article>
    <% if (workspace.permissions.canViewBalance) { %><article><span>التكلفة</span><strong class="bw-mono"><%= Number(reportSummary.totalLYD).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> <small>LYD</small></strong></article><% } %>
    <% if (workspace.isAgent && workspace.permissions.canViewBalance) { %><article class="success"><span>ربح الوكالة المحقق</span><strong class="bw-mono"><%= Number(reportSummary.realizedProfit || 0).toFixed(3) %> <small>LYD</small></strong></article><% } %>
    <article class="warning"><span>قيد التنفيذ</span><strong class="bw-mono"><%= reportSummary.pendingCount %></strong></article>
    <article class="danger"><span>ملغية أو مرفوضة</span><strong class="bw-mono"><%= reportSummary.cancelledCount %></strong></article>
</section>

<section class="bw-report-grid">
    <div class="bw-section">
        <header class="bw-section-head"><div><span class="bw-section-kicker">تفصيل النتائج</span><h2><%= reportScopeLabel %></h2></div><span class="bw-meta-chip"><%= reportRows.length %> بند</span></header>
        <div class="bw-table-wrap">
            <table class="bw-table">
                <thead><tr><th><%= reportScope === 'organization' ? 'التاريخ' : reportScope === 'customers' ? 'العميل' : 'الموظف' %></th><th>العمليات</th><th>الناجحة</th><th>قيد التنفيذ</th><th>الملغية</th><th>EGP</th><% if (workspace.permissions.canViewBalance) { %><th>LYD</th><th>صافي الإيداع</th><% } %><% if (workspace.isAgent && workspace.permissions.canViewBalance) { %><th>ربح الوكالة</th><% } %></tr></thead>
                <tbody>
                    <% if (!reportRows.length) { %><tr><td colspan="<%= (workspace.permissions.canViewBalance ? 8 : 6) + (workspace.isAgent && workspace.permissions.canViewBalance ? 1 : 0) %>"><div class="bw-empty"><i class="fa-solid fa-chart-column"></i><strong>لا توجد بيانات للتقرير</strong><span>غيّر الفترة الزمنية أو نوع التقرير.</span></div></td></tr><% } %>
                    <% reportRows.forEach(row => { %><tr><td data-label="البند"><strong><%= row.key %></strong><small><%= row.lastActivity ? new Date(row.lastActivity).toLocaleDateString('ar-LY', { timeZone: 'Africa/Tripoli' }) : '' %></small></td><td data-label="العمليات" class="bw-mono"><%= row.totalCount %></td><td data-label="الناجحة" class="bw-mono text-success"><%= row.completedCount %></td><td data-label="قيد التنفيذ" class="bw-mono"><%= row.pendingCount %></td><td data-label="الملغية" class="bw-mono text-danger"><%= row.cancelledCount %></td><td data-label="EGP" class="bw-mono"><%= Number(row.totalEGP).toLocaleString('en-US', { maximumFractionDigits: 0 }) %></td><% if (workspace.permissions.canViewBalance) { %><td data-label="LYD" class="bw-mono"><%= Number(row.totalLYD).toFixed(2) %></td><td data-label="صافي الإيداع" class="bw-mono"><%= Number(row.deposits - row.deductions).toFixed(2) %></td><% } %><% if (workspace.isAgent && workspace.permissions.canViewBalance) { %><td data-label="ربح الوكالة" class="bw-mono text-success"><%= Number(row.realizedProfit || 0).toFixed(3) %></td><% } %></tr><% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <aside class="bw-section bw-service-analysis">
        <header class="bw-section-head"><div><span class="bw-section-kicker">توزيع الخدمات</span><h2>أداء القنوات</h2></div></header>
        <% const maxServiceCount = Math.max(1, ...serviceBreakdown.map(item => item.count)); %>
        <div class="bw-analysis-list">
            <% if (!serviceBreakdown.length) { %><div class="bw-empty"><i class="fa-solid fa-chart-pie"></i><strong>لا توجد عمليات ناجحة</strong></div><% } %>
            <% serviceBreakdown.forEach(item => { %>
                <div class="bw-analysis-row"><header><strong><%= item.label %></strong><span class="bw-mono"><%= item.count %></span></header><div class="bw-progress"><span style="width:<%= Math.max(5, (item.count / maxServiceCount) * 100) %>%"></span></div><footer><span><%= Number(item.totalEGP).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> <%= item.amountCurrencyLabel || 'EGP' %></span><% if (workspace.permissions.canViewBalance) { %><span><%= Number(item.totalLYD).toFixed(2) %> LYD</span><% } %><% if (workspace.isAgent && workspace.permissions.canViewBalance && item.realizedProfit > 0) { %><span class="text-success">ربح <%= Number(item.realizedProfit).toFixed(3) %></span><% } %></footer></div>
            <% }) %>
        </div>
    </aside>
</section>

<% if (workspace.isAgent && workspace.permissions.canViewBalance && agencyProfitRows.length) { %>
    <section class="bw-section">
        <header class="bw-section-head"><div><span class="bw-section-kicker">ربحية العملاء</span><h2>الأرباح المحققة والمتوقعة</h2></div><a href="/client/finance/profits" class="bw-text-link">لوحة الأرباح <i class="fa-solid fa-arrow-left"></i></a></header>
        <div class="bw-table-wrap"><table class="bw-table"><thead><tr><th>العميل</th><th>العمليات المكتملة</th><th>إجمالي EGP</th><th>ربح محقق</th><th>ربح متوقع</th><th>ربح مستبعد</th></tr></thead><tbody>
            <% agencyProfitRows.forEach(row => { %><tr><td data-label="العميل"><strong><%= row.customerName %></strong></td><td data-label="العمليات المكتملة" class="bw-mono"><%= row.completedCount %></td><td data-label="إجمالي EGP" class="bw-mono"><%= Number(row.totalEGP).toLocaleString('en-US', { maximumFractionDigits: 0 }) %></td><td data-label="ربح محقق" class="bw-mono text-success"><%= Number(row.realizedProfit).toFixed(3) %> LYD</td><td data-label="ربح متوقع" class="bw-mono"><%= Number(row.expectedProfit).toFixed(3) %> LYD</td><td data-label="ربح مستبعد" class="bw-mono text-danger"><%= Number(row.reversedProfit).toFixed(3) %> LYD</td></tr><% }) %>
        </tbody></table></div>
    </section>
<% } %>

<section class="bw-section bw-report-detail">
    <header class="bw-section-head"><div><span class="bw-section-kicker">عينة التدقيق</span><h2>آخر العمليات داخل التقرير</h2></div><a href="/client/transactions" class="bw-text-link">السجل الكامل <i class="fa-solid fa-arrow-left"></i></a></header>
    <div class="bw-table-wrap"><table class="bw-table"><thead><tr><th>العملية</th><th>الخدمة</th><th><%= workspace.isCompany ? 'الموظف' : 'الموظف / العميل' %></th><th>المبلغ</th><th>الحالة</th><th>التاريخ</th></tr></thead><tbody>
        <% reportTransactions.slice(0, 12).forEach(tx => { const status = statusMeta[tx.status] || { label: tx.status, tone: 'neutral' }; const service = serviceCatalog.find(item => item.key === tx.transferType); const hasReceipt = Boolean(tx.proofImage || (Array.isArray(tx.proofImages) && tx.proofImages.some(Boolean))); %>
            <tr>
                <td data-label="العملية"><span class="bw-id-with-receipt"><button type="button" class="bw-id-button bw-mono" data-transaction-id="<%= tx._id %>"><%= tx.customId %></button><% if (hasReceipt) { %><button type="button" class="bw-receipt-indicator" data-transaction-id="<%= tx._id %>" data-receipt-focus title="عرض صور الإيصال" aria-label="عرض صور إيصال العملية <%= tx.customId %>"><i class="fa-solid fa-receipt"></i></button><% } %></span></td>
                <td data-label="الخدمة"><%= service?.shortLabel || tx.transferType %></td>
                <td data-label="<%= workspace.isCompany ? 'الموظف' : 'الموظف / العميل' %>"><strong><%= tx.employeeName || '---' %></strong><% if (!workspace.isCompany) { %><small><%= tx.subAccountName || 'الحساب الرئيسي' %></small><% } %></td>
                <td data-label="المبلغ" class="bw-mono"><%= Number(tx.amount || 0).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> <%= service?.amountCurrencyLabel || 'EGP' %></td>
                <td data-label="الحالة"><span class="bw-status <%= status.tone %>"><%= status.label %></span></td>
                <td data-label="التاريخ" class="bw-mono"><%= new Date(tx.createdAt).toLocaleDateString('en-GB', { timeZone: 'Africa/Tripoli' }) %></td>
            </tr>
        <% }) %>
    </tbody></table></div>
</section>
