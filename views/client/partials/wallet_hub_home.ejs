<%# Ahram Client OS — mobile home is deliberately separate from the desktop layout. %>
<section class="client-os-mobile" aria-label="الرئيسية">
    <header class="client-os-mobile-greeting">
        <div><p>مركز القيادة</p><h1>أهلاً، <%= user.name %></h1><span><i class="fa-solid fa-circle-check"></i> <%= isSystemOpen ? 'الخدمات متاحة الآن' : 'الخدمات متوقفة مؤقتاً' %></span></div>
        <button type="button" onclick="openWalletHubMore()" aria-label="إعدادات الحساب"><i class="fa-solid fa-sliders"></i></button>
    </header>

    <article class="client-os-mobile-balance">
        <div class="client-os-mobile-balance-top"><span>الرصيد المتاح</span><i class="fa-solid fa-shield-halved"></i></div>
        <strong dir="ltr"><%= user.canViewBalance ? Number(user.balance || 0).toFixed(2) : '••••••' %> <small>LYD</small></strong>
        <footer><span><i class="fa-solid fa-lock"></i> حساب محمي</span><button type="button" onclick="openClientSecurityPanel()">الحماية</button></footer>
    </article>

    <% if (user.role !== 'accountant') { %>
    <div class="client-os-mobile-primary-actions">
        <button type="button" data-bs-toggle="modal" data-bs-target="#transferModal"><i class="fa-solid fa-paper-plane"></i><span>تحويل مالي</span></button>
        <button type="button" onclick="openBalanceTransferModal()"><i class="fa-solid fa-wallet"></i><span>تحويل رصيد</span></button>
    </div>
    <% } %>

    <section class="client-os-mobile-rates" aria-label="أسعار مباشرة">
        <div><span>كاش</span><strong class="mono-num" id="liveRateCashMobile"><%= (serviceRates && serviceRates.vodafone ? serviceRates.vodafone : currentRate).toFixed(2) %></strong></div>
        <div><span>بريد بطاقة</span><strong class="mono-num" id="liveRatePostCardMobile"><%= (serviceRates && serviceRates.post_card ? serviceRates.post_card : (currentRate - 0.15)).toFixed(2) %></strong></div>
        <div><span>بريد حساب</span><strong class="mono-num" id="liveRatePostAccMobile"><%= (serviceRates && serviceRates.post_account ? serviceRates.post_account : (currentRate - 0.05)).toFixed(2) %></strong></div>
        <div><span>حساب بنكي</span><strong class="mono-num" id="liveRateBankMobile"><%= (serviceRates && serviceRates.bank_account ? serviceRates.bank_account : (currentRate - 0.10)).toFixed(2) %></strong></div>
    </section>

    <section class="client-os-mobile-summary" aria-label="ملخص اليوم">
        <article><i class="fa-solid fa-list-check"></i><span>عمليات اليوم</span><strong class="mono-num" id="todayTxCount"><%= (todayStats && todayStats.count) || 0 %></strong></article>
        <article><i class="fa-solid fa-coins"></i><span>إجمالي EGP</span><strong class="mono-num" id="todayTotalEGP"><%= ((todayStats && todayStats.totalEGP) || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %></strong></article>
        <article><i class="fa-solid fa-scale-balanced"></i><span>إجمالي LYD</span><strong class="mono-num" id="todayTotalLYD"><%= ((todayStats && todayStats.totalLYD) || 0).toFixed(2) %></strong></article>
    </section>

    <section class="client-os-mobile-activity">
        <header><div><p>نشاطك</p><h2>آخر العمليات</h2></div><button type="button" onclick="openAllOperations()">عرض الكل <i class="fa-solid fa-arrow-left"></i></button></header>
        <div class="client-os-mobile-transactions" id="walletHubRecentList">
            <% const hubRecent = (typeof recentTransactions !== 'undefined' && recentTransactions.length) ? recentTransactions : []; %>
            <% if (!hubRecent.length) { %>
            <div class="wh-empty"><i class="fa-solid fa-folder-open"></i><span>لا توجد عمليات اليوم</span></div>
            <% } else { hubRecent.forEach((tx) => { %>
            <article class="wh-tx-card mobile-tx-card">
                <div class="mobile-tx-header">
                    <span class="tx-custom-id text-muted">#<%= tx.customId || (tx._id ? String(tx._id).slice(-6) : '—') %></span>
                    <span class="badge-st <%= tx.status === 'completed' ? 'st-done' : (tx.status === 'deposit' ? 'st-dep' : 'st-wait') %>">
                        <i class="fa-solid <%= tx.status === 'completed' ? 'fa-check-circle' : (tx.status === 'deposit' ? 'fa-arrow-down' : 'fa-clock') %>"></i>
                        <%= tx.status === 'completed' ? 'مكتمل' : (tx.status === 'deposit' ? 'إيداع' : 'قيد المعالجة') %>
                    </span>
                </div>
                <div class="mobile-tx-body">
                    <div class="tx-amount-section">
                        <div class="tx-amount-wrapper"><span class="tx-amount"><%= Number(tx.amount || 0).toFixed(2) %></span><span class="tx-currency">EGP</span></div>
                        <div class="tx-cost-wrapper text-danger" style="font-size:0.82rem;"><span class="fw-bold"><%= Number(tx.costLYD || tx.subAccountCostLYD || 0).toFixed(2) %></span><span class="tx-currency">LYD</span></div>
                    </div>
                    <div class="text-start" style="font-size:0.85rem;"><span class="tx-phone"><%= tx.vodafoneNumber || tx.accountNumber || '---' %></span></div>
                </div>
            </article>
            <% }); } %>
        </div>
        <div class="mobile-ops-list d-none" id="mobileTransactionsListBrief" aria-hidden="true"></div>
    </section>

    <section class="client-os-mobile-tools">
        <a href="/client/account"><span><i class="fa-solid fa-file-invoice"></i></span><div><strong>كشف الحساب</strong><small>عمليات · إيداعات · تصدير</small></div><i class="fa-solid fa-chevron-left"></i></a>
        <a href="/client/settings?section=profile"><span><i class="fa-solid fa-gear"></i></span><div><strong>الإعدادات</strong><small>الملف · الأمان · الإشعارات</small></div><i class="fa-solid fa-chevron-left"></i></a>
    </section>
</section>
