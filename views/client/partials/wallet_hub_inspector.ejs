<div class="client-os-inspector-backdrop" id="clientOsInspectorBackdrop" aria-hidden="true"></div>
<aside class="client-os-inspector" id="clientOsInspector" aria-label="تفاصيل العملية" aria-hidden="true">
    <header class="client-os-inspector-head">
        <div>
            <p>تفاصيل العملية</p>
            <h2 data-inspector-title>—</h2>
        </div>
        <button type="button" class="client-os-inspector-close" id="clientOsInspectorClose" aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button>
    </header>
    <div class="client-os-inspector-grid">
        <div class="client-os-inspector-row"><span>الحالة</span><strong data-inspector-status>—</strong></div>
        <div class="client-os-inspector-row"><span>القيمة</span><strong data-inspector-amount dir="ltr">—</strong></div>
        <div class="client-os-inspector-row"><span>التكلفة</span><strong data-inspector-cost dir="ltr">—</strong></div>
        <div class="client-os-inspector-row"><span>سعر الصرف</span><strong data-inspector-rate dir="ltr">—</strong></div>
        <div class="client-os-inspector-row"><span>الحساب</span><strong data-inspector-account dir="ltr">—</strong></div>
        <div class="client-os-inspector-row"><span>الوقت</span><strong data-inspector-time>—</strong></div>
    </div>
    <div class="client-os-inspector-actions" data-inspector-actions></div>
</aside>
