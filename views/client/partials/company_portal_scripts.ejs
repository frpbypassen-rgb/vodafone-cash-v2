<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleTheme() {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        document.documentElement.setAttribute('data-bs-theme', next);
        localStorage.setItem('ahram_company_theme', next);
        document.querySelectorAll('#themeIconSidebar, #themeIconHeader').forEach((icon) => {
            icon.className = next === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
        });
    }

    (function syncThemeIcon() {
        const theme = document.documentElement.getAttribute('data-theme') || 'light';
        document.querySelectorAll('#themeIconSidebar, #themeIconHeader').forEach((icon) => {
            icon.className = theme === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
        });
    })();

    (function setupPortalSidebar() {
        const body = document.body;
        const toggles = document.querySelectorAll('[data-sidebar-toggle]');
        const closeTargets = document.querySelectorAll('[data-sidebar-close]');
        const sectionLinks = Array.from(document.querySelectorAll('.portal-sidebar-link[data-portal-section]'));
        const portalViews = Array.from(document.querySelectorAll('[data-portal-view]'));
        const viewMap = new Map(portalViews.map((view) => [view.dataset.portalView, view]));
        const viewLabel = document.getElementById('portalCurrentViewLabel');

        const setSidebarState = (open) => {
            body.classList.toggle('portal-sidebar-open', open);
            toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', open ? 'true' : 'false'));
        };

        const openPortalView = (target, updateHistory = true) => {
            const nextView = viewMap.get(target) || viewMap.get('overview');
            if (!nextView) return;

            const nextTarget = nextView.dataset.portalView;
            portalViews.forEach((view) => {
                const active = view === nextView;
                view.hidden = !active;
                view.classList.toggle('is-active', active);
                view.setAttribute('aria-hidden', active ? 'false' : 'true');
            });

            sectionLinks.forEach((link) => {
                const active = link.dataset.portalSection === nextTarget;
                link.classList.toggle('active', active);
                if (active) link.setAttribute('aria-current', 'page');
                else link.removeAttribute('aria-current');
            });

            if (viewLabel) {
                const activeLink = sectionLinks.find((link) => link.dataset.portalSection === nextTarget);
                viewLabel.textContent = activeLink?.dataset.portalLabel || nextView.dataset.portalTitle || 'الشاشة الرئيسية';
            }

            if (updateHistory && window.location.hash !== `#${nextTarget}`) {
                window.history.pushState({ portalView: nextTarget }, '', `#${nextTarget}`);
            }

            setSidebarState(false);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        };

        toggles.forEach((toggle) => {
            toggle.addEventListener('click', () => setSidebarState(!body.classList.contains('portal-sidebar-open')));
        });
        closeTargets.forEach((target) => target.addEventListener('click', () => setSidebarState(false)));

        document.querySelectorAll('a[href^="#"]').forEach((link) => {
            const target = link.getAttribute('href').slice(1);
            if (!viewMap.has(target)) return;
            link.addEventListener('click', (event) => {
                event.preventDefault();
                openPortalView(target);
            });
        });

        const query = new URLSearchParams(window.location.search);
        const hashTarget = window.location.hash.slice(1);
        let initialTarget = viewMap.has(hashTarget) ? hashTarget : 'overview';
        if (!viewMap.has(hashTarget)) {
            if (query.has('staffSuccess') || query.has('staffError')) initialTarget = 'staff';
            else if (query.has('requestSuccess') || query.has('requestError')) initialTarget = 'requests';
            else if (query.has('search') || query.has('month') || query.has('date')) initialTarget = 'transactions';
        }
        openPortalView(viewMap.has(initialTarget) ? initialTarget : 'overview', false);

        window.addEventListener('popstate', () => {
            const target = window.location.hash.slice(1);
            openPortalView(viewMap.has(target) ? target : 'overview', false);
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') setSidebarState(false);
        });
        window.addEventListener('resize', () => {
            if (window.innerWidth > 1024) setSidebarState(false);
        });
    })();

    const transferForm = document.getElementById('companyTransferForm');
    if (transferForm) {
        const companyType = transferForm.querySelector('[name="type"]');
        const companyBankField = document.getElementById('companyBankField');
        const companyBank = document.getElementById('companyTransferBank');
        const companyBankMethodField = document.getElementById('companyBankMethodField');
        const companyBankMethod = document.getElementById('companyTransferBankMethod');
        const companyPhone = transferForm.querySelector('[name="phone"]');
        const companyBeneficiary = transferForm.querySelector('[name="name"]');
        const companyAcknowledgementField = document.getElementById('companyTransferAcknowledgementField');
        const companyAcknowledgement = document.getElementById('companyTransferAcknowledgement');
        const syncCompanyBankField = () => {
            const bankTransfer = companyType?.value === 'حساب بنكي';
            if (companyBankMethodField) companyBankMethodField.hidden = !bankTransfer;
            if (companyBankMethod) {
                companyBankMethod.required = bankTransfer;
                companyBankMethod.disabled = !bankTransfer;
                if (!bankTransfer) companyBankMethod.value = '';
            }
            const method = bankTransfer ? companyBankMethod?.value : '';
            const needsBank = ['account', 'iban'].includes(method);
            if (companyBankField) companyBankField.hidden = !needsBank;
            if (companyBank) {
                companyBank.required = needsBank;
                companyBank.disabled = !needsBank;
                if (!needsBank) companyBank.value = '';
            }
            if (companyPhone) {
                companyPhone.required = !bankTransfer || Boolean(method);
                if (method === 'iban') companyPhone.value = companyPhone.value.toUpperCase();
                companyPhone.placeholder = ({ mobile: 'رقم موبايل من 11 رقماً', ipa: 'مثال: Ahrampay', account: 'رقم حساب بالأرقام فقط', iban: 'أرقام وحروف إنجليزية' })[method] || (bankTransfer ? 'اختر الطريقة أولاً' : 'رقم الهاتف / الحساب');
                companyPhone.inputMode = method === 'mobile' || method === 'account' ? 'numeric' : 'text';
            }
            if (companyBeneficiary) companyBeneficiary.required = bankTransfer;
            if (companyAcknowledgementField) companyAcknowledgementField.hidden = !bankTransfer;
            if (companyAcknowledgement) companyAcknowledgement.required = bankTransfer;
            if (!bankTransfer && companyAcknowledgement) companyAcknowledgement.checked = false;
            const submit = document.getElementById('companyTransferSubmit');
            if (submit) submit.innerHTML = bankTransfer ? '<i class="fa-solid fa-list-check"></i>مراجعة العملية' : '<i class="fa-solid fa-check"></i>إرسال العملية';
        };
        companyType?.addEventListener('change', () => {
            if (companyType.value !== 'حساب بنكي' && companyBankMethod) companyBankMethod.value = '';
            syncCompanyBankField();
        });
        companyBankMethod?.addEventListener('change', () => {
            if (companyPhone) companyPhone.value = '';
            syncCompanyBankField();
        });
        syncCompanyBankField();
        transferForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const submitBtn = document.getElementById('companyTransferSubmit');
            const formData = new FormData(transferForm);
            const payload = Object.fromEntries(formData.entries());
            if (payload.type === 'حساب بنكي') {
                const destination = String(payload.phone || '').replace(/\s+/g, '');
                const method = payload.bankMethod;
                const errors = {
                    mobile: /^\d{11}$/.test(destination),
                    ipa: /^[A-Za-z0-9._-]{3,64}(?:@[A-Za-z0-9.-]{2,253})?$/.test(destination),
                    account: /^\d{5,34}$/.test(destination),
                    iban: /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z0-9]{5,34}$/.test(destination)
                };
                if (!method || method === 'card' || !errors[method]) {
                    await Swal.fire({ icon: 'warning', title: 'تحقق من البيانات', text: method === 'card' ? 'التحويل بالبطاقة غير متاح حالياً.' : 'بيانات الوجهة لا تطابق طريقة التحويل المختارة.' });
                    return;
                }
                payload.phone = method === 'iban' ? destination.toUpperCase() : destination;
                if (String(payload.name || '').trim().split(/\s+/).filter(Boolean).length < 2) {
                    await Swal.fire({ icon: 'warning', title: 'اسم المستفيد', text: 'أدخل الاسم الأول والثاني على الأقل.' });
                    return;
                }
                if (!companyAcknowledgement?.checked) {
                    await Swal.fire({ icon: 'warning', title: 'إقرار مطلوب', text: 'أقر بصحة بيانات التحويل وتحمل مسؤوليتك عنها.' });
                    return;
                }
            }
            if (payload.type === 'حساب بنكي' && ['account', 'iban'].includes(payload.bankMethod) && !payload.bankCode) {
                Swal.fire({
                    icon: 'warning',
                    title: 'تنبيه',
                    text: 'اختر البنك قبل إرسال بيانات الحساب.',
                    confirmButtonText: 'حسناً'
                });
                return;
            }

            if (payload.type === 'حساب بنكي' && submitBtn?.dataset.reviewed !== '1') {
                const amount = Number(payload.amount || 0);
                const rate = Number(transferForm.dataset.bankRate || 0);
                const lyd = rate > 0 ? amount / rate : 0;
                const escape = (value) => String(value || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
                const result = await Swal.fire({
                    icon: 'info', title: 'مراجعة بيانات التحويل', confirmButtonText: 'إرسال العملية', cancelButtonText: 'تعديل البيانات', showCancelButton: true,
                    html: `<div dir="rtl" style="text-align:right"><p><b>الطريقة:</b> ${escape(companyBankMethod?.selectedOptions?.[0]?.text)}</p><p><b>الوجهة:</b> <span dir="ltr">${escape(payload.phone)}</span></p><p><b>المستفيد:</b> ${escape(payload.name)}</p>${['account', 'iban'].includes(payload.bankMethod) ? `<p><b>البنك:</b> ${escape(companyBank?.selectedOptions?.[0]?.text)}</p>` : ''}<p>🇪🇬 ${escape(amount)} EGP</p><p><b>سعر الصرف:</b> 1 LYD = ${escape(rate || 'غير متاح')} EGP</p><p>🇱🇾 ${escape(lyd.toFixed(2))} LYD</p><p>إقرار صحة البيانات مطلوب قبل الإرسال.</p></div>`
                });
                if (!result.isConfirmed) return;
                if (submitBtn) submitBtn.dataset.reviewed = '1';
                transferForm.requestSubmit();
                return;
            }
            if (submitBtn) {
                delete submitBtn.dataset.reviewed;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جار الإرسال';
            }

            try {
                const transferFingerprint = JSON.stringify({
                    type: payload.type || '',
                    phone: payload.phone || '',
                    number: payload.number || '',
                    amount: payload.amount || '',
                    name: payload.name || '',
                    bankMethod: payload.bankMethod || '',
                    bankCode: payload.bankCode || '',
                    dataEntryAcknowledged: payload.dataEntryAcknowledged === 'true',
                    notes: payload.notes || ''
                });
                window.__ahramCompanyTransferKey = window.__ahramCompanyTransferKey && window.__ahramCompanyTransferKey.fingerprint === transferFingerprint
                    ? window.__ahramCompanyTransferKey
                    : { fingerprint: transferFingerprint, key: (window.crypto && window.crypto.randomUUID ? window.crypto.randomUUID() : '00000000-0000-4000-8000-000000000000'.replace(/0/g, () => (Math.random() * 16 | 0).toString(16))) };
                const response = await fetch('/client/transfer', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'x-csrf-token': window.csrfToken || '',
                        'Idempotency-Key': window.__ahramCompanyTransferKey.key
                    },
                    body: JSON.stringify(payload)
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok || !data.success) {
                    throw new Error(data.error || 'تعذر إرسال العملية');
                }
                window.__ahramCompanyTransferKey = null;

                await Swal.fire({
                    icon: 'success',
                    title: 'تم إرسال العملية',
                    text: data.message || 'تم تسجيل العملية بنجاح',
                    confirmButtonText: 'حسناً'
                });
                window.location.reload();
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'تعذر إرسال العملية',
                    text: error.message || 'حدث خطأ أثناء الإرسال',
                    confirmButtonText: 'حسناً'
                });
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = companyType?.value === 'حساب بنكي'
                        ? '<i class="fa-solid fa-list-check"></i>مراجعة العملية'
                        : '<i class="fa-solid fa-check"></i>إرسال العملية';
                }
            }
        });
    }
</script>
