        .portal-action-card:hover .action-purple { background: linear-gradient(135deg, #8b5cf6, #6d28d9); }
        .portal-action-card:hover .action-sky { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
        .portal-action-card:hover .action-red { background: linear-gradient(135deg, #ef4444, #dc2626); }

        .portal-main-grid {
            align-items: start;
        }

        .portal-section .panel {
            min-width: 0;
        }

        .role-hero {
            min-height: 220px;
            background: linear-gradient(135deg, #001a4d 0%, #000814 100%) !important;
            border: 1px solid rgba(212, 175, 55, 0.24);
            border-radius: 28px !important;
            box-shadow: 0 20px 40px -10px rgba(0, 26, 77, 0.40);
            color: #fff !important;
            padding: clamp(24px, 4vw, 40px);
            margin-bottom: 26px;
            position: relative;
            overflow: hidden;
            transform-style: preserve-3d;
        }

        [data-theme="dark"] .role-hero {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%) !important;
            border-color: rgba(255, 255, 255, 0.08);
        }

        .role-hero::before {
            content: "";
            position: absolute;
            right: -16%;
            top: -50%;
            width: 340px;
            height: 340px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.18) 0%, transparent 70%);
            pointer-events: none;
        }

        .role-hero::after {
            content: "";
            position: absolute;
            top: 0;
            left: -110%;
            width: 52%;
            height: 100%;
            background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.10), transparent);
            transform: skewX(-20deg);
            transition: left 0.7s ease;
            pointer-events: none;
        }

        .role-hero:hover::after {
            left: 150%;
        }

        .role-hero > * {
            position: relative;
            z-index: 1;
            transform: translateZ(24px);
