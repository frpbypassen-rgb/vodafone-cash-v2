        }

        .portal-action-card:hover {
            color: var(--text-main);
            border-color: color-mix(in srgb, var(--brand-gold) 62%, var(--border-glass));
            box-shadow: var(--shadow-hover, 0 16px 34px rgba(15, 23, 42, 0.13));
