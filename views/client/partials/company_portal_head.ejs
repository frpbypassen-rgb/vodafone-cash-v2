        }

        .portal-action-title {
            color: var(--text-main);
            font-size: 0.92rem;
            font-weight: 900;
            text-align: center;
            line-height: 1.25;
        }

        .action-blue { background: rgba(14, 165, 233, 0.12); color: #0ea5e9; }
        .action-green { background: rgba(16, 185, 129, 0.12); color: #10b981; }
        .action-gold { background: rgba(212, 175, 55, 0.16); color: #b88900; }
        .action-purple { background: rgba(139, 92, 246, 0.12); color: #8b5cf6; }
        .action-sky { background: rgba(37, 99, 235, 0.12); color: #2563eb; }
        .action-red { background: rgba(239, 68, 68, 0.10); color: #ef4444; }

        .portal-action-card:hover .action-blue { background: linear-gradient(135deg, #0ea5e9, #2563eb); }
        .portal-action-card:hover .action-green { background: linear-gradient(135deg, #10b981, #0f766e); }
