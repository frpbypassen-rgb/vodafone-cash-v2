            border-radius: 20px !important;
        }

        .panel {
            overflow: hidden;
        }

        .panel-heading {
            background: transparent !important;
            padding: 20px 22px;
        }

        .panel-title {
            font-size: 1.18rem;
        }

        .panel .table-responsive {
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
            padding: 0 14px 16px;
        }

        .company-table {
            border-collapse: separate;
            border-spacing: 0 10px;
        }

        .company-table th {
            background: transparent !important;
            border: 0 !important;
            padding: 8px 14px;
            text-align: center;
        }

