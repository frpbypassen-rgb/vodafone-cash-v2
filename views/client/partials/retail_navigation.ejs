<% const shellNav = [
    {key:'home',href:'/client/dashboard',label:'الرئيسية',icon:'fa-house'},
    {key:'transfers',href:'/client/transfers',label:'تحويل',icon:'fa-paper-plane'},
    {key:'operations',href:'/client/account?tab=operations',label:'العمليات',icon:'fa-receipt'},
    {key:'settings',href:'/client/settings',label:'الإعدادات',icon:'fa-gear'},
    {key:'support',href:'/client/support',label:'الدعم',icon:'fa-headset'}
]; %>
<nav class="<%= navVariant==='mobile'?'bottomnav':'nav' %>" aria-label="<%= navVariant==='mobile'?'التنقل للهاتف':'التنقل الرئيسي' %>"><% shellNav.forEach(item=>{ %><a href="<%= item.href %>" class="<%= activeRetailNav===item.key?'active':'' %>" <%- activeRetailNav===item.key?'aria-current="page"':'' %>><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i><span><%= item.label %></span></a><% }) %></nav>
