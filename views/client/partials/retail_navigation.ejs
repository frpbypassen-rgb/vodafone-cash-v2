<% const shellNav = [
    {key:'home',href:'/client/dashboard',label:'الرئيسية',icon:'fa-house'},
    {key:'transfers',href:'/client/transfers',label:'تحويل',icon:'fa-paper-plane'},
    {key:'operations',href:'/client/account?tab=operations',label:'العمليات',icon:'fa-receipt'},
    {key:'reports',href:'/client/reports',label:'التقارير',icon:'fa-chart-column'},
    ...(typeof canRequestDeposit !== 'undefined' && canRequestDeposit ? [{key:'deposits',href:'/client/account?tab=deposits-new',label:'إضافة رصيد',icon:'fa-circle-plus'}] : []),
    {key:'settings',href:'/client/settings',label:'الإعدادات',icon:'fa-gear'},
    {key:'support',href:'/client/support',label:'الدعم',icon:'fa-headset'}
]; %>
<nav class="<%= navVariant==='mobile'?'bottomnav':'nav' %>" aria-label="<%= navVariant==='mobile'?'التنقل للهاتف':'التنقل الرئيسي' %>"><% shellNav.forEach(item=>{ if(navVariant==='mobile' && ['reports','deposits'].includes(item.key)) return; %><a href="<%= item.href %>" class="<%= activeRetailNav===item.key?'active':'' %>" <%- activeRetailNav===item.key?'aria-current="page"':'' %>><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i><span><%= item.label %></span></a><% }) %><% if(navVariant==='mobile') { %><button type="button" class="retail-more-trigger" data-retail-more-open aria-label="المزيد — جميع صفحات الحساب" aria-controls="retailMoreDialog" aria-haspopup="dialog" aria-expanded="false"><i class="fa-solid fa-bars" aria-hidden="true"></i><span>المزيد</span></button><% } %></nav>
