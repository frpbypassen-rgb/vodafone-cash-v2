<% const allowedFunding = typeof canRequestDeposit !== 'undefined' && canRequestDeposit;
const directory = [
{title:'التحويل والمتابعة',items:[{href:'/client/transfers',label:'خدمات التحويل',icon:'fa-paper-plane'},{href:'/client/smart-transfer',label:'التحويل من رسالة',icon:'fa-wand-magic-sparkles'},{href:'/client/internal-transfer',label:'تحويل رصيد داخلي',icon:'fa-right-left'},{href:'/client/account?tab=operations',label:'العمليات والإيصالات',icon:'fa-receipt'}]},
{title:'الحساب والمالية',items:[{href:'/client/reports',label:'التقارير',icon:'fa-chart-column'},{href:'/client/account?tab=summary',label:'الملخص المالي',icon:'fa-chart-pie'},{href:'/client/account?tab=export',label:'تصدير الكشوف',icon:'fa-file-export'},...(allowedFunding?[{href:'/client/account?tab=deposits-new',label:'إضافة رصيد',icon:'fa-circle-plus'},{href:'/client/account?tab=deposits-pending',label:'الإيداعات قيد المراجعة',icon:'fa-clock'},{href:'/client/account?tab=deposits-accepted',label:'الإيداعات المقبولة',icon:'fa-circle-check'},{href:'/client/account?tab=deposits-rejected',label:'الإيداعات المرفوضة',icon:'fa-circle-xmark'}]:[])]},
{title:'إعدادات الحساب والمساعدة',items:[{href:'/client/settings?section=profile',label:'الملف الشخصي',icon:'fa-user'},{href:'/client/settings?section=security',label:'أمان الحساب',icon:'fa-shield-halved'},{href:'/security/sessions',label:'الأجهزة والجلسات',icon:'fa-laptop'},{href:'/client/settings?section=notifications',label:'الإشعارات',icon:'fa-bell'},{href:'/client/settings?section=appearance',label:'المظهر',icon:'fa-palette'},{href:'/client/settings?section=documents',label:'الحساب والوثائق',icon:'fa-file-shield'},{href:'/client/support',label:'الدعم والشكاوى',icon:'fa-headset'}]}
]; %>
<section class="retail-directory" aria-labelledby="retailDirectoryTitle"><header class="home-section-head"><div><h2 id="retailDirectoryTitle">جميع صفحات حسابك</h2><p class="small">روابط مباشرة لكل الأقسام المتاحة لك.</p></div></header><% directory.forEach(group=>{ %><section class="retail-directory-group"><h3><%= group.title %></h3><div class="retail-directory-grid"><% group.items.forEach(item=>{ if(user.role==='accountant' && ['/client/transfers','/client/smart-transfer','/client/internal-transfer'].includes(item.href)) return; %><a href="<%= item.href %>"><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i><span><%= item.label %></span><i class="fa-solid fa-angle-left" aria-hidden="true"></i></a><% }) %></div></section><% }) %></section>
