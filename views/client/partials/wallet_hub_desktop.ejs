<%# Ahram Client OS — desktop command centre.  Keep dynamic IDs used by dashboard.js. %>
<div class="client-os-shell with-inspector-dock">
    <%- include('wallet_hub_sidebar', {
        user: user,
        activePage: 'dashboard',
        isSystemOpen: isSystemOpen,
        isSatellite: false
    }) %>

    <main class="client-os-main">
        <header class="client-os-topbar">
            <div>
                <p class="client-os-eyebrow"><i class="fa-solid fa-sparkles"></i> مركز القيادة</p>
                <h1>صباح الخير، <%= user.name %></h1>
                <p class="client-os-subtitle">هذه نظرة سريعة وآمنة على حسابك وحركة اليوم.</p>
            </div>
            <div class="client-os-topbar-actions">
                <button type="button" class="client-os-cmd-trigger" id="clientOsCmdTrigger" aria-label="بحث سريع"><i class="fa-solid fa-magnifying-glass"></i><span>بحث سريع</span><kbd>Ctrl+K</kbd></button>
                <span class="client-os-status <%= isSystemOpen ? 'is-open' : 'is-closed' %>"><i class="fa-solid <%= isSystemOpen ? 'fa-circle-check' : 'fa-circle-exclamation' %>"></i><%= isSystemOpen ? 'النظام يعمل' : 'النظام مغلق' %></span>
                <% if (user.role !== 'accountant') { %>
                    <button type="button" class="client-os-create" data-bs-toggle="modal" data-bs-target="#transferModal"><i class="fa-solid fa-plus"></i><span>عملية جديدة</span></button>
                <% } %>
            </div>
        </header>

        <section class="client-os-overview" aria-label="ملخص الحساب">
            <article class="client-os-balance-panel">
                <div class="client-os-panel-top"><span>الرصيد المتاح</span><i class="fa-solid fa-eye"></i></div>
                <div class="client-os-balance-value" dir="ltr"><%= user.canViewBalance ? Number(user.balance || 0).toFixed(2) : '••••••' %> <small>LYD</small></div>
                <div class="client-os-balance-footer">
                    <span><i class="fa-solid fa-shield-heart"></i> رصيد محمي</span>
                    <button type="button" onclick="openClientSecurityPanel()">إعدادات الحماية <i class="fa-solid fa-arrow-left"></i></button>
                </div>
            </article>

            <div class="client-os-kpis">
                <article class="client-os-kpi">
                    <span class="client-os-kpi-icon blue"><i class="fa-solid fa-list-check"></i></span>
                    <div><small>عمليات اليوم</small><strong class="mono-num" id="todayTxCount"><%= (todayStats && todayStats.count) || 0 %></strong><em>حتى الآن</em></div>
                </article>
                <article class="client-os-kpi">
                    <span class="client-os-kpi-icon gold"><i class="fa-solid fa-coins"></i></span>
                    <div><small>إجمالي التحويلات</small><strong class="mono-num" id="todayTotalEGP"><%= ((todayStats && todayStats.totalEGP) || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> <b>EGP</b></strong><em>قيمة اليوم</em></div>
                </article>
                <article class="client-os-kpi">
                    <span class="client-os-kpi-icon mint"><i class="fa-solid fa-scale-balanced"></i></span>
                    <div><small>التكلفة بالعملة المحلية</small><strong class="mono-num" id="todayTotalLYD"><%= ((todayStats && todayStats.totalLYD) || 0).toFixed(2) %> <b>LYD</b></strong><em>قيمة اليوم</em></div>
                </article>
            </div>
        </section>

        <section class="client-os-workbench" aria-label="أدوات العمل">
            <% if (user.role !== 'accountant') { %>
            <button type="button" class="client-os-workbench-action is-primary" data-bs-toggle="modal" data-bs-target="#transferModal">
                <span><i class="fa-solid fa-paper-plane"></i></span><div><strong>ابدأ تحويلاً</strong><small>أنشئ عملية مالية جديدة</small></div><i class="fa-solid fa-arrow-left"></i>
            </button>
            <button type="button" class="client-os-workbench-action" onclick="openBalanceTransferModal()">
                <span><i class="fa-solid fa-wallet"></i></span><div><strong>إدارة الرصيد</strong><small>تحويل الرصيد المتاح</small></div><i class="fa-solid fa-arrow-left"></i>
            </button>
            <% } %>
            <a href="/client/reports" class="client-os-workbench-action">
                <span><i class="fa-solid fa-file-invoice"></i></span><div><strong>كشف الحساب</strong><small>ابحث وحمّل تقريرك</small></div><i class="fa-solid fa-arrow-left"></i>
            </a>
            <a href="/client/support" class="client-os-workbench-action">
                <span><i class="fa-solid fa-headset"></i></span><div><strong>تحتاج مساعدة؟</strong><small>تواصل بأمان مع الدعم</small></div><i class="fa-solid fa-arrow-left"></i>
            </a>
        </section>

        <section class="client-os-activity-grid">
            <article class="client-os-activity-card">
                <div class="client-os-section-heading"><div><p>متابعة سريعة</p><h2>حالة الحساب</h2></div><i class="fa-solid fa-shield-halved"></i></div>
                <div class="client-os-account-state">
                    <span class="client-os-state-orb <%= isSystemOpen ? 'open' : 'closed' %>"><i class="fa-solid <%= isSystemOpen ? 'fa-check' : 'fa-lock' %>"></i></span>
                    <div><strong><%= isSystemOpen ? 'جاهز لتنفيذ العمليات' : 'بانتظار عودة النظام' %></strong><small><%= isSystemOpen ? 'يمكنك بدء عملية جديدة في أي وقت.' : 'ستتوفر الخدمات فور فتح النظام.' %></small></div>
                </div>
                <a href="/client/reports" class="client-os-text-link">عرض التقرير المالي <i class="fa-solid fa-arrow-left"></i></a>
            </article>

            <article class="client-os-rates-card" id="ratesCardContainer">
                <div class="client-os-section-heading"><div><p>أسعار مباشرة</p><h2>سوق التحويل</h2></div><i class="fa-solid fa-arrow-trend-up"></i></div>
                <div class="client-os-rate-strip">
                    <div><span>كاش</span><strong class="mono-num" id="liveRateCash"><%= (serviceRates && serviceRates.vodafone ? serviceRates.vodafone : currentRate).toFixed(2) %></strong></div>
                    <div><span>بريد بطاقة</span><strong class="mono-num" id="liveRatePostCard"><%= (serviceRates && serviceRates.post_card ? serviceRates.post_card : (currentRate - 0.15)).toFixed(2) %></strong></div>
                    <div><span>بريد حساب</span><strong class="mono-num" id="liveRatePostAcc"><%= (serviceRates && serviceRates.post_account ? serviceRates.post_account : (currentRate - 0.05)).toFixed(2) %></strong></div>
                    <div><span>حساب بنكي</span><strong class="mono-num" id="liveRateBank"><%= (serviceRates && serviceRates.bank_account ? serviceRates.bank_account : (currentRate - 0.10)).toFixed(2) %></strong></div>
                    <div class="d-none"><strong id="liveRateNiger"><%= (serviceRates && serviceRates.sefa_niger ? serviceRates.sefa_niger : (currentRate + 0.1)).toFixed(2) %></strong><strong id="liveRateSudan"><%= (serviceRates && serviceRates.bankak_sudan ? serviceRates.bankak_sudan : (currentRate + 0.2)).toFixed(2) %></strong></div>
                </div>
            </article>
        </section>

        <section class="client-os-ledger">
            <header class="client-os-ledger-header">
                <div><p>آخر النشاط</p><h2>سجل العمليات</h2><span>راجع التفاصيل أو الإيصال من العملية نفسها.</span></div>
                <form method="GET" action="/client/dashboard" class="client-os-search">
                    <label class="visually-hidden" for="client-os-search-input">البحث في العمليات</label>
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="client-os-search-input" type="text" name="search" placeholder="رقم العملية أو الهاتف أو ملاحظة" value="<%= typeof search !== 'undefined' ? search : '' %>">
                    <input type="date" name="date" value="<%= typeof targetDate !== 'undefined' ? targetDate : '' %>" aria-label="تاريخ العمليات">
                    <button type="submit">بحث</button>
                </form>
            </header>
            <% if (typeof transactionsTruncated !== 'undefined' && transactionsTruncated) { %><div class="client-os-info"><i class="fa-solid fa-circle-info"></i> نعرض أحدث 200 عملية للحفاظ على سرعة البوابة. استخدم البحث أو التاريخ لتضييق النتائج.</div><% } %>
            <div class="client-os-table-wrap">
                <table class="table-custom client-os-table" id="transactionsTable">
                    <thead><tr><th>#</th><th>رقم العملية</th><th>القيمة</th><th>التكلفة / السعر</th><th>الحساب</th><th>الوقت</th><th>الحالة</th><th>إجراء</th></tr></thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
        </section>
    </main>
    <%- include('partials/wallet_hub_inspector') %>
</div>
