<section class="portal-view portal-metrics-view" id="metrics" data-portal-view="metrics" data-portal-title="مؤشرات الأداء" aria-label="مؤشرات الأداء" hidden>
    <div class="portal-view-intro">
        <div>
            <span class="portal-section-kicker"><i class="fa-solid fa-chart-simple"></i>التحليل المباشر</span>
            <h2 class="portal-section-title">مؤشرات الأداء</h2>
        </div>
        <span class="portal-section-meta"><%= dateLabel %></span>
    </div>
    <div class="metric-grid">
    <% if (canViewBalance) { %>
        <article class="metric-card metric-balance">
            <div class="metric-card-head">
                <span class="metric-icon"><i class="fa-solid fa-wallet"></i></span>
                <span class="metric-state">متاح الآن</span>
            </div>
            <div>
                <div class="metric-label">الرصيد الحالي</div>
                <div class="metric-value mono-num" dir="ltr"><%= Number(company.balance || 0).toFixed(2) %></div>
                <div class="metric-foot">دينار ليبي</div>
            </div>
        </article>
    <% } %>
    <article class="metric-card metric-success">
        <div class="metric-card-head">
            <span class="metric-icon"><i class="fa-solid fa-check"></i></span>
            <span class="metric-state">مكتملة</span>
        </div>
        <div>
            <div class="metric-label">العمليات الناجحة</div>
            <div class="metric-value mono-num"><%= totals.completedCount %></div>
            <div class="metric-foot"><%= dateLabel %></div>
        </div>
    </article>
    <article class="metric-card metric-volume">
        <div class="metric-card-head">
            <span class="metric-icon"><i class="fa-solid fa-money-bill-transfer"></i></span>
            <span class="metric-state">حجم التحويل</span>
        </div>
        <div>
            <div class="metric-label">إجمالي التحويلات</div>
            <div class="metric-value mono-num" dir="ltr"><%= Number(totals.totalEGP || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %></div>
            <div class="metric-foot">جنيه مصري</div>
        </div>
    </article>
    <article class="metric-card metric-pending">
        <div class="metric-card-head">
            <span class="metric-icon"><i class="fa-solid fa-hourglass-half"></i></span>
            <span class="metric-state">تحتاج متابعة</span>
        </div>
        <div>
            <div class="metric-label">قيد المتابعة</div>
            <div class="metric-value mono-num"><%= totals.pendingCount %></div>
            <div class="metric-foot">طلبات لم تكتمل بعد</div>
        </div>
    </article>
    <% if (!canViewBalance) { %>
        <article class="metric-card metric-staff">
            <div class="metric-card-head">
                <span class="metric-icon"><i class="fa-solid fa-user-check"></i></span>
                <span class="metric-state">نشطون</span>
            </div>
            <div>
                <div class="metric-label">الموظفون النشطون</div>
                <div class="metric-value mono-num"><%= staffCount %></div>
                <div class="metric-foot"><%= company.name %></div>
            </div>
        </article>
    <% } %>
    </div>
</section>
