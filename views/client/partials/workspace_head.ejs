<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="<%= typeof workspace !== 'undefined' && workspace.isCompany ? (typeof companyThemeMeta !== 'undefined' && companyThemeMeta.themeColor ? companyThemeMeta.themeColor : '#E7F1F6') : (typeof clientThemeMeta !== 'undefined' && clientThemeMeta.themeColor ? clientThemeMeta.themeColor : '#E8EEFA') %>">
    <title><%= pageMeta.title %> | Power Pay AL-Ahram</title>
    <script>
        (() => {
            const isCompany = <%- JSON.stringify(typeof workspace !== 'undefined' && Boolean(workspace.isCompany)) %>;
            const density = localStorage.getItem('powerpay-business-density') || 'comfortable';
            document.documentElement.dataset.density = density;
            if (isCompany) {
                const valid = ['day', 'night', 'pharaonic'];
                const stored = localStorage.getItem('ahram_company_theme');
                const server = <%- JSON.stringify(typeof companyTheme !== 'undefined' ? companyTheme : '') %>;
                const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                // After login the server preference wins. localStorage is only a
                // fallback for first paint when the account has no saved theme.
                const theme = valid.includes(server) ? server : (valid.includes(stored) ? stored : (prefersDark ? 'night' : 'day'));
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-portal', 'company');
                if (valid.includes(server)) {
                    try { localStorage.setItem('ahram_company_theme', server); } catch (_error) { /* private mode */ }
                }
                const colors = { day: '#E7F1F6', night: '#0B1426', pharaonic: '#1A1510' };
                const meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute('content', colors[theme]);
                return;
            }
            const valid = ['day', 'night', 'pharaonic'];
            const stored = localStorage.getItem('ahram_client_theme');
            const server = <%- JSON.stringify(typeof clientTheme !== 'undefined' ? clientTheme : '') %>;
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = valid.includes(server) ? server : (valid.includes(stored) ? stored : (prefersDark ? 'night' : 'day'));
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-portal', 'customer');
            if (valid.includes(server)) {
                try { localStorage.setItem('ahram_client_theme', server); } catch (_error) { /* private mode */ }
            }
            const colors = { day: '#E8EEFA', night: '#070B14', pharaonic: '#1C1610' };
            const meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', colors[theme]);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/client-workspace.css?v=20260919-proof2">
    <link rel="stylesheet" href="/css/client-portal-2027.css?v=20260919-command1">
    <% if (typeof workspace !== 'undefined' && workspace.isCompany) { %>
        <link rel="stylesheet" href="/css/company-portal.tokens.css?v=20260919-command1">
        <link rel="stylesheet" href="/css/company-portal-layout.css?v=20260919-proof2">
        <link rel="stylesheet" href="/css/company-portal-theme-day.css?v=20260919-command1">
        <link rel="stylesheet" href="/css/company-portal-theme-night.css?v=20260919-command1">
        <link rel="stylesheet" href="/css/company-portal-theme-pharaonic.css?v=20260919-command1">
        <link rel="stylesheet" href="/css/company-portal.css?v=20260919-command1">
    <% } else { %>
        <%- include('customer_portal_styles') %>
    <% } %>
    <link rel="stylesheet" href="/css/rate-alert-overlay.css?v=20260816-3">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/rate-alert-overlay.js?v=20260902-rate2" defer></script>
</head>
