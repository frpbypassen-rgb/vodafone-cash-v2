<section class="rr-page" data-retail-reports data-report-storage="retail-reports:<%= accountType %>:<%= account._id %>" aria-labelledby="rrTitle">
<header class="rr-heading"><div><h1 id="rrTitle">التقارير</h1><p>تحويلاتك وتفاصيلها وإثباتاتها، في مكان واحد.</p></div><button type="button" class="button" data-rr-refresh aria-label="تحديث التقارير"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> تحديث</button></header>
<div class="rr-toolbar"><div class="rr-periods" aria-label="فترة التقرير"><button type="button" data-rr-period="day">اليوم</button><button type="button" data-rr-period="month">هذا الشهر</button><button type="button" data-rr-period="range">فترة مخصصة</button></div><p data-rr-period-label class="rr-muted"></p>
<form class="rr-search" data-rr-search-form><label class="visually-hidden" for="rrSearch">بحث برقم العملية أو حساب المستلم</label><input type="search" id="rrSearch" name="search" maxlength="80" placeholder="رقم العملية، المستلم أو الحساب"><button type="submit" class="button" aria-label="بحث في التقارير"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button><button type="button" class="button" data-rr-filter><i class="fa-solid fa-sliders" aria-hidden="true"></i> تصفية <span data-rr-filter-count></span></button></form>
<div class="rr-chips" data-rr-chips aria-label="الفلاتر المختارة"></div></div>
<div class="rr-summary" data-rr-summary hidden><div><span>عدد العمليات</span><strong data-rr-count></strong></div><div><span>قيمة العمليات</span><strong data-rr-amounts></strong></div><div><span>تكلفة العمليات المكتملة</span><strong data-rr-cost></strong></div></div>
<p role="status" aria-live="polite" data-rr-message class="rr-muted"></p><button type="button" class="button" data-rr-retry hidden>إعادة المحاولة</button>
<section data-rr-results hidden aria-label="نتائج التقرير"><div class="rr-result-heading"><h2>العمليات</h2><small data-rr-updated></small></div>
<div class="rr-mobile-list" data-rr-mobile></div><div class="rr-table-wrap"><table class="rr-table"><thead><tr><th>العملية والتاريخ</th><th>الخدمة</th><th>المستلم / الحساب</th><th>المبلغ</th><th>التكلفة</th><th>الحالة</th><th>التفاصيل</th></tr></thead><tbody data-rr-table></tbody></table></div>
<div class="rr-footer"><span data-rr-shown></span><button type="button" class="button" data-rr-more hidden>تحميل المزيد</button></div></section>
</section>
<dialog class="rr-filter-dialog" data-rr-dialog aria-labelledby="rrFilterTitle"><header><h2 id="rrFilterTitle">تصفية التقارير</h2><button class="button" type="button" data-rr-filter-close aria-label="إغلاق التصفية">×</button></header>
<form data-rr-filter-form><label for="rrDateType">الفترة</label><select id="rrDateType" name="dateType"><option value="day">يوم محدد</option><option value="month">شهر محدد</option><option value="range">فترة مخصصة</option></select>
<div data-rr-date-day><label for="rrDay">اليوم</label><input type="date" name="day" id="rrDay"></div><div data-rr-date-month><label for="rrMonth">الشهر</label><input type="month" name="month" id="rrMonth"></div>
<div class="rr-range" data-rr-date-range><div><label for="rrFrom">من</label><input type="date" name="dateFrom" id="rrFrom"></div><div><label for="rrTo">إلى</label><input type="date" name="dateTo" id="rrTo"></div></div>
<label for="rrStatus">الحالة</label><select id="rrStatus" name="status"><option value="">كل الحالات</option><option value="pending">قيد الانتظار</option><option value="processing">قيد التنفيذ — موجهة</option><option value="accepted">قيد التنفيذ — مستلمة</option><option value="completed">ناجحة</option><option value="rejected">مرفوضة</option><option value="cancelled_by_admin">ملغاة</option></select>
<label for="rrService">الخدمة</label><select id="rrService" name="service"><option value="">كل الخدمات</option><option value="vodafone">محافظ كاش</option><option value="post_account">حساب بريد</option><option value="post_card">بطاقة بريد</option><option value="bank_account">حساب بنكي</option><option value="sefa_niger">سيفا النيجر</option><option value="bankak_sudan">بنكك السودان</option></select>
<p class="rr-muted">الفترة المخصصة حتى سنة. الملخص يتبع البحث والفلاتر المختارة.</p><div class="rr-filter-actions"><button type="button" class="button" data-rr-reset>مسح الفلاتر</button><button type="submit" class="button primary">تطبيق التصفية</button></div></form></dialog>
