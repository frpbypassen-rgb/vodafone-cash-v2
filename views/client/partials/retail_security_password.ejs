<% const fields = [
    { name: 'currentPassword', label: 'كلمة المرور الحالية', autocomplete: 'current-password' },
    { name: 'newPassword', label: 'كلمة المرور الجديدة', autocomplete: 'new-password', hint: 'retailPasswordLength' },
    { name: 'passwordConfirm', label: 'تأكيد كلمة المرور الجديدة', autocomplete: 'new-password', hint: 'retailPasswordMatch' }
]; %>
<div class="retail-profile-panel retail-security-password">
    <form id="retailPasswordForm" method="POST" action="/client/hub/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <div class="retail-password-fields">
            <% for (const field of fields) { %>
                <div class="retail-password-field<%= field.name === 'currentPassword' ? ' retail-password-current' : '' %>">
                    <label for="retail-<%= field.name %>"><%= field.label %></label>
                    <div class="retail-password-input">
                        <input id="retail-<%= field.name %>" class="form-control" name="<%= field.name %>" type="password"
                            autocomplete="<%= field.autocomplete %>" maxlength="128" required
                            <% if (field.hint) { %>minlength="8" aria-describedby="<%= field.hint %>"<% } %>>
                        <button type="button" data-password-toggle="retail-<%= field.name %>" aria-label="إظهار <%= field.label %>"
                            aria-controls="retail-<%= field.name %>" aria-pressed="false">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            <% } %>
        </div>
        <ul id="retailPasswordRules" aria-label="شروط كلمة المرور الجديدة">
            <li id="retailPasswordLength" data-password-length>
                <span class="retail-password-check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                <span data-rule-text>8 أحرف على الأقل</span>
            </li>
            <li id="retailPasswordMatch" data-password-match>
                <span class="retail-password-check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                <span data-rule-text>تطابق كلمة المرور وتأكيدها</span>
            </li>
        </ul>
        <div class="retail-profile-actions">
            <p role="status" id="retailPasswordStatus">أكمل الحقول لتحديث كلمة المرور.</p>
            <button class="btn btn-primary" type="submit" id="retailPasswordSave">
                <i class="fa-solid fa-lock" aria-hidden="true"></i>حفظ كلمة المرور
            </button>
        </div>
    </form>
</div>
<script src="/js/retail-security.js?v=20261123-password" defer></script>
