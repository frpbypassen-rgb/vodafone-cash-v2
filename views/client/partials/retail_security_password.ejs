<% const fields = [
    { name: 'currentPassword', label: 'كلمة المرور الحالية', autocomplete: 'current-password' },
    { name: 'newPassword', label: 'كلمة المرور الجديدة', autocomplete: 'new-password' },
    { name: 'passwordConfirm', label: 'تأكيد كلمة المرور', autocomplete: 'new-password' }
]; %>
<div class="retail-profile-panel retail-security-password">
    <form id="retailPasswordForm" method="POST" action="/client/hub/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <div class="retail-password-fields">
            <% for (const field of fields) { %>
            <div>
                <label for="retail-<%= field.name %>"><%= field.label %></label>
                <div class="retail-password-input">
                    <input id="retail-<%= field.name %>" class="form-control" name="<%= field.name %>" type="password"
                        autocomplete="<%= field.autocomplete %>" maxlength="128" required
                        <% if (field.name !== 'currentPassword') { %>minlength="8" aria-describedby="retailPasswordRules"<% } %>>
                    <button type="button" data-password-toggle="retail-<%= field.name %>" aria-label="إظهار <%= field.label %>" aria-pressed="false">
                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <% } %>
        </div>
        <ul id="retailPasswordRules">
            <li data-password-length><i class="fa-solid fa-check" aria-hidden="true"></i>كلمة المرور الجديدة 8 أحرف على الأقل.</li>
            <li data-password-match><i class="fa-solid fa-check" aria-hidden="true"></i>يجب أن يتطابق تأكيد كلمة المرور.</li>
        </ul>
        <div class="retail-profile-actions">
            <p role="status" id="retailPasswordStatus">أكمل الحقول لتحديث كلمة المرور.</p>
            <button class="btn btn-primary" type="submit" id="retailPasswordSave">حفظ كلمة المرور</button>
        </div>
    </form>
</div>
<script src="/js/retail-security.js?v=20261030-1" defer></script>
