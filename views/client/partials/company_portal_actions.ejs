<%
    const actionTransfer = typeof showTransfer !== 'undefined' ? showTransfer : (typeof canTransfer !== 'undefined' && canTransfer);
    const actionOperations = typeof showOperations !== 'undefined' ? showOperations : true;
    const actionRequests = typeof showRequests !== 'undefined' ? showRequests : false;
    const actionTeam = typeof showTeam !== 'undefined' ? showTeam : false;
    const actionReports = typeof showReports !== 'undefined' ? showReports : true;
    const actionSupport = typeof showSupport !== 'undefined' ? showSupport : true;
%>

<section class="portal-actions-panel no-print" id="quick-actions" aria-label="الإجراءات السريعة">
    <div class="portal-actions-head">
        <div>
            <span class="portal-section-kicker"><i class="fa-solid fa-bolt"></i>مركز التحكم</span>
            <h2 class="portal-section-title">الإجراءات السريعة</h2>
        </div>
        <span class="portal-section-meta">وصول مباشر لأهم مهام الحساب</span>
    </div>
    <div class="portal-action-grid">
        <% if (actionTransfer) { %>
            <button type="button" class="portal-action-card portal-action-button" data-bs-toggle="modal" data-bs-target="#companyTransferModal">
                <span class="portal-action-icon action-blue"><i class="fa-solid fa-paper-plane"></i></span>
                <span class="portal-action-copy">
                    <strong class="portal-action-title">تحويل جديد</strong>
                    <small class="portal-action-description">إرسال عملية مالية جديدة</small>
                </span>
                <i class="fa-solid fa-chevron-left portal-action-arrow"></i>
            </button>
        <% } %>
        <% if (actionOperations) { %>
            <a href="#transactions" class="portal-action-card">
                <span class="portal-action-icon action-green"><i class="fa-solid fa-list-check"></i></span>
                <span class="portal-action-copy">
                    <strong class="portal-action-title">سجل العمليات</strong>
                    <small class="portal-action-description">متابعة الحالات والأرقام المرجعية</small>
                </span>
                <i class="fa-solid fa-chevron-left portal-action-arrow"></i>
            </a>
        <% } %>
        <% if (actionRequests) { %>
            <a href="#requests" class="portal-action-card">
                <span class="portal-action-icon action-gold"><i class="fa-solid fa-user-check"></i></span>
                <span class="portal-action-copy">
                    <strong class="portal-action-title">طلبات العملاء</strong>
                    <small class="portal-action-description">مراجعة طلبات التسجيل الجديدة</small>
                </span>
                <i class="fa-solid fa-chevron-left portal-action-arrow"></i>
            </a>
        <% } %>
        <% if (actionTeam) { %>
            <a href="#staff" class="portal-action-card">
                <span class="portal-action-icon action-purple"><i class="fa-solid fa-users-gear"></i></span>
                <span class="portal-action-copy">
                    <strong class="portal-action-title">الفريق والصلاحيات</strong>
                    <small class="portal-action-description">إدارة الموظفين والمحاسبين</small>
                </span>
                <i class="fa-solid fa-chevron-left portal-action-arrow"></i>
            </a>
        <% } %>
        <% if (actionReports) { %>
            <a href="/client/reports" class="portal-action-card">
                <span class="portal-action-icon action-sky"><i class="fa-solid fa-chart-pie"></i></span>
                <span class="portal-action-copy">
                    <strong class="portal-action-title">التقارير المالية</strong>
                    <small class="portal-action-description">التحليل والتصفية والتصدير</small>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square portal-action-arrow"></i>
            </a>
        <% } %>
        <% if (actionSupport) { %>
            <a href="/client/support" class="portal-action-card">
                <span class="portal-action-icon action-red"><i class="fa-solid fa-headset"></i></span>
                <span class="portal-action-copy">
                    <strong class="portal-action-title">الدعم الفني</strong>
                    <small class="portal-action-description">التواصل ومتابعة طلبات الدعم</small>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square portal-action-arrow"></i>
            </a>
        <% } %>
    </div>
</section>
