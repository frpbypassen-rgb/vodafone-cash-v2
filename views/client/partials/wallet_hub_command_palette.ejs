<%# Command palette — Ctrl+K %>
<dialog class="client-os-palette" id="clientOsCommandPalette" aria-labelledby="clientOsPaletteTitle">
    <div class="client-os-palette-head">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <label class="visually-hidden" for="clientOsPaletteInput" id="clientOsPaletteTitle">بحث سريع</label>
        <input id="clientOsPaletteInput" type="search" placeholder="ابحث عن أمر… تحويل، تقارير، دعم" autocomplete="off">
        <kbd>Ctrl+K</kbd>
    </div>
    <div class="client-os-palette-list" id="clientOsPaletteList" role="listbox"></div>
</dialog>
