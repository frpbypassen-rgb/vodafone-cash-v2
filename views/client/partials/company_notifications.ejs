<div class="cp-bell" data-company-bell>
    <button type="button" class="bw-icon-button cp-bell-button" data-bell-toggle aria-expanded="false" aria-controls="companyBellPanel" title="الإشعارات" aria-label="الإشعارات">
        <i class="fa-regular fa-bell"></i>
        <span class="cp-bell-count" data-bell-count hidden>0</span>
    </button>
    <div class="cp-bell-panel" id="companyBellPanel" data-bell-panel hidden role="dialog" aria-label="صندوق الإشعارات">
        <div class="cp-bell-head">
            <strong>الإشعارات</strong>
            <button type="button" class="cp-bell-mark-all" data-bell-read-all>تعليم الكل كمقروء</button>
        </div>
        <div data-bell-groups>
            <p class="cp-bell-empty">لا إشعارات حالياً</p>
        </div>
    </div>
</div>
