<div class="panel" id="staff-panel">
    <div class="panel-heading">
        <h2 class="panel-title"><i class="fa-solid fa-users-gear text-primary"></i>حسابات فريق الشركة</h2>
        <span class="small-muted"><%= staffCount %> نشط من <%= staff.length %></span>
    </div>
    <div class="panel-body">
        <% if (typeof query !== 'undefined' && query.staffSuccess) { %>
            <div class="success-banner">
                <i class="fa-solid fa-check-circle ms-1"></i>تم حفظ تعديل حسابات الموظفين.
            </div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.staffError) { %>
            <div class="error-banner">
                <i class="fa-solid fa-triangle-exclamation ms-1"></i>
                <% if (query.staffError === 'username') { %>
                    اسم المستخدم مستخدم بالفعل.
                <% } else if (query.staffError === 'username_format') { %>
                    اسم المستخدم يجب أن يكون إنجليزيًا وينتهي بـ @ahram.com.
                <% } else if (query.staffError === 'password') { %>
                    الرقم السري يجب ألا يقل عن 6 أحرف.
                <% } else if (query.staffError === 'forbidden') { %>
                    لا توجد صلاحية لتنفيذ هذا الإجراء.
                <% } else { %>
                    تعذر حفظ التعديل. حاول مرة أخرى.
                <% } %>
            </div>
        <% } %>

        <% if (canCreateStaff) { %>
            <form action="/client/company/staff/add" method="POST" class="mb-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">اسم الموظف</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">رقم الهاتف</label>
                        <input type="text" name="phone" class="form-control mono-num text-center" dir="ltr" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">اسم المستخدم</label>
                        <input type="text" name="webUsername" class="form-control mono-num text-start" dir="ltr" placeholder="employee@ahram.com" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">الرقم السري</label>
                        <input type="text" name="webPassword" class="form-control mono-num text-start" dir="ltr" minlength="6" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">صفة الموظف</label>
                        <select name="role" class="form-select" required>
                            <option value="employee">موظف</option>
                            <option value="accountant">محاسب</option>
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <label class="d-flex align-items-center gap-2 w-100 p-3" style="border: 1px solid var(--border); border-radius: 8px; background: var(--surface-soft); cursor: pointer;">
                            <input type="checkbox" name="canManageCompany" class="form-check-input m-0">
                            <span class="fw-bold">صلاحية مدير تشغيل بدون إنشاء حسابات</span>
                        </label>
                    </div>
                </div>
                <button type="submit" class="primary-btn mt-3">
                    <i class="fa-solid fa-user-plus"></i>إنشاء حساب
                </button>
            </form>
        <% } else { %>
            <div class="success-banner">
                <i class="fa-solid fa-shield-halved ms-1"></i>لديك صلاحية إدارة وتشغيل، ولا تشمل إنشاء حسابات جديدة.
            </div>
        <% } %>

        <div class="staff-list">
            <% staff.forEach((item) => {
                const isOwnerStaff = item.role === 'owner' || item.canCreateCompanyStaff === true;
                const roleText = isOwnerStaff ? 'مدير الشركة' : (item.role === 'accountant' ? 'محاسب' : 'موظف');
            %>
                <div class="staff-item">
                    <div class="staff-main">
                        <div>
                            <div class="staff-name"><%= item.name %></div>
                            <div class="staff-meta">
                                <span dir="ltr"><%= item.webUsername %></span>
                                <span class="mx-1">|</span>
                                <span dir="ltr"><%= item.phone || '---' %></span>
                            </div>
                        </div>
                        <div class="text-start">
                            <span class="status-pill <%= item.status === 'active' ? 'st-completed' : 'st-rejected' %>"><%= item.status === 'active' ? 'نشط' : 'موقوف' %></span>
                            <div class="small-muted mt-1"><%= roleText %><%= item.canManageCompany && !isOwnerStaff ? ' - مدير تشغيل' : '' %></div>
                        </div>
                    </div>
                    <% if (canCreateStaff && !isOwnerStaff && String(item._id) !== String(account._id)) { %>
                        <div class="staff-actions">
                            <form action="/client/company/staff/<%= item._id %>/toggle" method="POST">
                                <button type="submit" class="mini-btn">
                                    <i class="fa-solid <%= item.status === 'active' ? 'fa-user-slash' : 'fa-user-check' %>"></i>
                                    <%= item.status === 'active' ? 'إيقاف' : 'تفعيل' %>
                                </button>
                            </form>
                            <form action="/client/company/staff/<%= item._id %>/password" method="POST" class="d-flex gap-2 flex-wrap">
                                <input type="text" name="newPassword" class="form-control mono-num" dir="ltr" placeholder="رقم سري جديد" minlength="6" required style="min-height:34px; width: 160px;">
                                <button type="submit" class="mini-btn">
                                    <i class="fa-solid fa-key"></i>تغيير
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>
</div>
