<% if (securityView?.key === 'password') { %>
    <%- include('retail_security_password') %>
<% } else if (securityView?.key === 'verification') { %>
    <div class="retail-security-factors" data-retail-login-methods
        data-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <%- include('../../partials/mfa_security_panel',{retailSecurity:true}) %>
        <section class="retail-verification-channels" aria-labelledby="retailVerificationChannels">
            <h2 id="retailVerificationChannels">قنوات رمز الدخول</h2>
            <div class="retail-verification-channel-list">
                <%- include('retail_sms_login') %>
                <%- include('../../partials/email_login_security_panel',{retailSecurity:true,portalBasePath:'/client'}) %>
                <%- include('../../partials/telegram_login_security_panel',{retailSecurity:true,portalBasePath:'/client'}) %>
            </div>
        </section>
        <%- include('retail_login_method_preferences') %>
    </div>
    <script src="/js/retail-login-methods.js?v=1" defer></script>
<% } else { %>
    <nav class="retail-security-menu" aria-label="خيارات أمان الحساب">
        <% for (const item of securityItems) { %>
        <a class="retail-settings-card" data-security-view="<%= item.key %>" href="<%= item.href || securityPath + '&view=' + item.key %>">
            <span class="retail-settings-icon"><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i></span>
            <span class="retail-settings-card-copy">
                <strong><%= item.title %></strong>
                <small><%= item.caption || item.copy %></small>
            </span>
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </a>
        <% } %>
    </nav>
<% } %>
