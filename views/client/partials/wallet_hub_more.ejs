<%# LEGACY_GATED: retail More sheet now uses the shared customer_more_sheet. %>
<%
    const moreUser = (typeof user !== 'undefined' && user) ? user : account;
    const moreProfile = (typeof profile !== 'undefined' && profile) ? profile : {
        userRoleLabel: 'عميل',
        accountCode: moreUser && moreUser.accountCode ? moreUser.accountCode : '',
        canEditProfile: false
    };
    const canDeposit = moreUser && moreUser.role !== 'agent' && moreUser.canRequestDeposit !== false;
    const moreActiveKey = typeof activeNav !== 'undefined' ? String(activeNav) : '';
    const moreItems = [
        { key: 'account', href: '/client/account?tab=operations', label: 'العمليات وكشف الحساب', icon: 'fa-receipt', tone: 'account', active: moreActiveKey === 'account' },
        { key: 'reports', href: '/client/reports', label: 'التقارير', icon: 'fa-chart-column', tone: 'reports', active: moreActiveKey === 'reports' }
    ];
    if (canDeposit) {
        moreItems.push({ key: 'deposits', href: '/client/account?tab=deposits-new', label: 'إضافة رصيد', icon: 'fa-circle-plus', tone: 'deposit', active: moreActiveKey === 'deposits' });
    }
    moreItems.push(
        { key: 'support', href: '/client/support', label: 'الدعم والشكاوى', icon: 'fa-headset', tone: 'support', active: moreActiveKey === 'support' },
        { key: 'security', href: '/client/settings?section=security', label: 'الأمان والإعدادات', icon: 'fa-shield-halved', tone: 'security', active: moreActiveKey === 'settings' }
    );
    if (moreProfile.canEditProfile) {
        moreItems.push({ key: 'profile', href: '/client/settings?section=profile', label: 'الملف الشخصي', icon: 'fa-user-pen', tone: 'profile' });
    }
    moreItems.push({ key: 'logout', href: '/client/logout', label: 'تسجيل الخروج', icon: 'fa-power-off', tone: 'logout', danger: true });
%>
<%- include('customer_more_sheet', {
    moreItems: moreItems,
    user: moreUser,
    moreTitle: moreUser && moreUser.name ? moreUser.name : 'Al-Ahram Pay'
}) %>
<dialog class="wh-more-drawer" id="walletHubMoreDrawer" hidden aria-hidden="true"></dialog>
