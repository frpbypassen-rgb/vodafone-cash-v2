<!doctype html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>رمز Authenticator | أهرام باي</title>
    <script>try{document.documentElement.dataset.theme=['light','day'].includes(localStorage.getItem('ahram_theme'))?'light':'dark';}catch(_){}</script>
    <link rel="stylesheet" href="/css/business-login-otp.css?v=20261029-mfa">
</head>
<body>
<main class="otp-shell">
    <div class="otp-top"><a class="otp-back" href="/login?reset=1">← العودة لتسجيل الدخول</a><button class="otp-theme" type="button" data-mfa-theme aria-label="تغيير المظهر">☀</button></div>
    <header class="otp-brand"><img src="/images/login-otp-logo.jpg" alt="أهرام باي" width="48" height="48"><b dir="ltr">AL-AHRAM Pay</b><span>تأكيد الدخول</span></header>
    <p class="otp-factor">التحقق بواسطة Authenticator</p>
    <h1>أدخل رمز التحقق</h1>
    <p class="otp-description">افتح تطبيق Authenticator وأدخل الرمز المكون من ستة أرقام.</p>
    <p class="otp-alert" role="alert" <%= error ? '' : 'hidden' %>><%= error || '' %></p>
    <form action="/login" method="POST" id="loginForm" data-location-required="<%= locationRequired ? 'true' : 'false' %>">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <% if (adminPortal || clientPortal) { %><input type="hidden" name="portal" value="<%= adminPortal ? 'admin' : 'client' %>"><% } %>
        <input type="hidden" name="latitude" id="latitudeInput" value="<%= mfaLocation ? mfaLocation.latitude : '' %>">
        <input type="hidden" name="longitude" id="longitudeInput" value="<%= mfaLocation ? mfaLocation.longitude : '' %>">
        <input type="hidden" name="locationAccuracy" id="locationAccuracyInput" value="<%= mfaLocation && Number.isFinite(mfaLocation.accuracy) ? mfaLocation.accuracy : '' %>">
        <input type="hidden" name="mfaToken" data-auth-code-input>
        <div class="otp-digits" dir="ltr" aria-label="رمز Authenticator">
            <% for(let index=0;index<6;index++){ %><input type="text" inputmode="numeric" maxlength="1" autocomplete="<%= index===0?'one-time-code':'off' %>" aria-label="الرقم <%= index+1 %>" data-mfa-digit><% } %>
        </div>
        <p id="locationStatus" class="otp-note" role="status"><%= mfaLocation ? 'تم تأكيد الموقع في الخطوة السابقة.' : '' %></p>
        <button id="locationRetryButton" type="button" class="otp-telegram" hidden>إعادة محاولة تحديد الموقع</button>
        <button id="submitBtn" type="submit" class="otp-primary" disabled>تأكيد ومتابعة</button>
    </form>
    <footer>Authenticator مطلوب عند تفعيله. لا تشارك الرمز مع أي شخص.</footer>
</main>
<script src="/js/login-location.js?v=20261029-mfa-location"></script>
<script src="/js/authenticator-login.js?v=20261029-mfa-location"></script>
</body>
</html>
