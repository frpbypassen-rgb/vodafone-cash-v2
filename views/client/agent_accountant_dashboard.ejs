<!DOCTYPE html>
<html lang="ar" dir="rtl">
<%- include('partials/company_portal_head', { title: 'واجهة محاسب الوكيل' }) %>
<body>
    <%- include('partials/company_portal_nav') %>

    <main class="shell portal-shell">
        <%- include('partials/company_portal_hero', {
            heroEntity: agent,
            heroIcon: 'fa-calculator',
            heroEyebrow: 'مساحة محاسب الوكيل',
            heroTitle: 'المركز المالي للوكيل',
            heroSubtitle: agent.name + ' - متابعة الرصيد والإيداعات وحركة العمليات حسب الفترة.',
            showHeroReports: true,
            showHeroSupport: true
        }) %>

        <%- include('partials/company_stats') %>
        <%- include('partials/company_portal_actions', { showTransfer: false, showOperations: true, showRequests: false, showTeam: false, showReports: true, showSupport: true }) %>

        <section class="portal-section portal-view" id="financial-summary" data-portal-view="financial-summary" data-portal-title="الملخص المالي" hidden>
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-scale-balanced"></i>التحليل المالي</span>
                    <h2 class="portal-section-title">الملخص المالي</h2>
                </div>
                <span class="portal-section-meta"><%= dateLabel %></span>
            </div>
            <section class="panel">
                <div class="panel-heading">
                    <h2 class="panel-title"><i class="fa-solid fa-scale-balanced"></i>ملخص مالي</h2>
                    <span class="small-muted"><%= dateLabel %></span>
                </div>
                <div class="panel-body">
                    <div class="staff-list">
                        <div class="staff-item">
                            <div class="small-muted">إجمالي التكلفة</div>
                            <div class="metric-value mono-num" dir="ltr"><%= Number(totals.totalLYD || 0).toFixed(3) %> LYD</div>
                        </div>
                        <div class="staff-item">
                            <div class="small-muted">صافي الإيداعات والخصومات</div>
                            <div class="metric-value mono-num" dir="ltr"><%= Number(totals.deposits || 0).toFixed(2) %> LYD</div>
                        </div>
                        <div class="staff-item">
                            <div class="small-muted">العمليات الملغية أو المرفوضة</div>
                            <div class="metric-value mono-num"><%= totals.cancelledCount %></div>
                        </div>
                    </div>
                </div>
            </section>
        </section>

        <section class="portal-section portal-view" id="transactions" data-portal-view="transactions" data-portal-title="سجل العمليات" hidden>
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-list-check"></i>الحركة المالية</span>
                    <h2 class="portal-section-title">سجل العمليات</h2>
                </div>
                <span class="portal-section-meta"><%= dateLabel %></span>
            </div>
            <%- include('partials/company_transactions_table', { showFilters: true }) %>
        </section>
    </main>

    <%- include('partials/company_portal_scripts') %>
</body>
</html>
