<% const telegramOtp = typeof otpChannel !== 'undefined' && otpChannel === 'telegram'; %>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>التحقق الثنائي | بوابة العملاء</title>
    
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/client-os-site.css?v=20260905-site">
    <style>
        :root {
            --brand-primary: #001a4d;
            --brand-gold: #d4af37;
            --bg-body: #f4f7f6;
            --card-bg: rgba(255, 255, 255, 0.95);
            --text-main: #1e293b;
        }
        [data-theme="dark"] {
            --brand-primary: #3b82f6;
            --brand-gold: #fbbf24;
            --bg-body: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.85);
            --text-main: #f8fafc;
        }

        body { 
            font-family: 'Tajawal', sans-serif; 
            background: var(--bg-body);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
            transition: 0.3s;
        }
        .bg-glow {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 0;
            pointer-events: none;
        }
        .verify-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            border: 1px solid rgba(255,255,255,0.1);
            overflow: hidden;
            width: 100%;
            max-width: 420px;
            padding: 40px;
            text-align: center;
            position: relative;
            z-index: 1;
            border-bottom: 6px solid var(--brand-gold);
        }
        .icon-box {
            width: 80px;
            height: 80px;
            background: rgba(212, 175, 55, 0.1);
            color: var(--brand-gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 20px;
            border: 1px solid rgba(212, 175, 55, 0.3);
        }
        .otp-input {
            letter-spacing: 15px;
            font-size: 1.5rem;
            text-align: center;
            font-family: monospace;
            font-weight: bold;
            border-radius: 12px;
            padding: 15px;
            border: 2px solid rgba(212, 175, 55, 0.3);
            background: rgba(0,0,0,0.05);
            color: var(--text-main);
        }
        [data-theme="dark"] .otp-input { background: rgba(255,255,255,0.05); }
        .otp-input:focus {
            border-color: var(--brand-gold);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
            background: transparent;
            color: var(--text-main);
        }
        .btn-verify {
            background: linear-gradient(90deg, var(--brand-gold) 0%, #b5952f 100%);
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 800;
            font-size: 1.1rem;
            transition: 0.3s;
            color: white;
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }
        .btn-verify:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(212, 175, 55, 0.4);
            color: white;
        }
    </style>
    <link rel="stylesheet" href="/css/brand-ui.css?v=20260804-brand1">
    <link rel="stylesheet" href="/css/client-nile-theme.css?v=20260826-nile">
    <link rel="stylesheet" href="/css/auth-verification-control-room.css?v=20261017-control-room3">
    <style>
        .auth-verify-host { max-width: 470px; padding: 0; border: 0; background: transparent; box-shadow: none; }
        .auth-verify-host .auth-control-room { width: 100%; }
        body.auth-verification-page .client-os-auth-shell { width: 100%; min-height: 100vh; }
        body.auth-verification-page .auth-verify-host { min-height: 100vh; }
        body.auth-verification-page .client-os-auth-mark { display: none; }
    </style>

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Al-Ahram">
    <!-- End PWA Setup -->
</head>
<body class="client-os-auth-page auth-verification-page">
    <div class="client-os-auth-shell">
        <a class="client-os-auth-mark" href="/login?portal=client" aria-label="Al-Ahram Pay">
            <span class="client-os-auth-mark-icon"><i class="fa-solid fa-gem"></i></span>
            <span><b>AHRAM</b><small>CLIENT OS</small></span>
        </a>
        <div class="verify-card client-os-auth-card auth-verify-host">
            <form action="/client/verify" method="POST" data-auth-verification-form>
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <section class="auth-control-room" role="dialog" aria-modal="true" aria-labelledby="otp-control-room-title" data-auth-method="<%= telegramOtp ? 'telegram' : 'email' %>">
                    <div class="auth-control-room-head">
                        <a class="auth-control-room-back auth-control-room-top-back" href="/login?portal=client" aria-label="العودة لتسجيل الدخول"><i class="fa-solid fa-arrow-right"></i></a>
                        <span class="auth-control-room-kicker">التحقق من الهوية</span>
                        <span class="auth-control-room-signal"><i></i> آمن</span>
                    </div>
                    <div class="auth-control-room-scenery" aria-hidden="true"><span></span><i class="fa-solid fa-pyramid"></i><b></b></div>
                    <h2 id="otp-control-room-title">تأكيد رمز OTP</h2>
                    <p class="auth-control-room-description"><%= telegramOtp ? 'أدخل رمز التحقق المرسل إلى بوت تليجرام المرتبط بحسابك' : 'أدخل رمز التحقق المرسل إلى بريدك الإلكتروني' %></p>
                    <% if (error) { %>
                        <div class="auth-control-room-error" role="alert"><i class="fa-solid fa-triangle-exclamation"></i><span><%= error %></span></div>
                    <% } %>
                    <div class="auth-code-grid" dir="ltr" aria-label="رمز التحقق">
                        <% for (let codeIndex = 0; codeIndex < 6; codeIndex += 1) { %><input type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" class="auth-code-slot" data-auth-code-slot data-slot-index="<%= codeIndex %>" autocomplete="one-time-code" aria-label="رقم <%= codeIndex + 1 %>"><% } %>
                    </div>
                    <input type="hidden" name="otp" data-auth-code-input data-login-otp>
                    <div class="auth-method-switch" role="group" aria-label="طريقة التحقق">
                        <span class="auth-method-chip is-muted"><i class="fa-solid fa-mobile-screen-button"></i><span>تطبيق<br><b>Authenticator</b></span><i class="fa-regular fa-circle auth-method-check"></i></span>
                        <span class="auth-method-chip is-active"><i class="<%= telegramOtp ? 'fa-brands fa-telegram' : 'fa-regular fa-envelope' %>"></i><span><%= telegramOtp ? 'رمز تليجرام' : 'رمز البريد' %></span><i class="fa-solid fa-circle-check auth-method-check"></i></span>
                    </div>
                    <div class="auth-control-room-gauge" data-auth-gauge role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <div class="auth-control-room-gauge-copy"><strong data-auth-percent>0%</strong><small data-auth-gauge-label>جاهز</small></div>
                    </div>
                    <button type="submit" class="auth-control-room-submit" data-auth-submit>تأكيد الرمز والدخول <i class="fa-solid fa-arrow-left ms-1"></i></button>
                    <div class="auth-control-room-steps" aria-label="مراحل التحقق">
                        <div class="auth-control-room-step is-active" data-auth-step><i class="fa-solid fa-inbox"></i>استلام الرمز</div>
                        <div class="auth-control-room-step" data-auth-step><i class="fa-solid fa-fingerprint"></i>فحص الصيغة</div>
                        <div class="auth-control-room-step" data-auth-step><i class="fa-solid fa-server"></i>تأكيد الخادم</div>
                    </div>
                    <a href="/login?portal=client" class="auth-control-room-back auth-control-room-bottom-back"><i class="fa-solid fa-arrow-right"></i> العودة لتسجيل الدخول</a>
                </section>
            </form>
        </div>
    </div>
    <%- include('../partials/login_otp_field_script') %>
    <script src="/js/auth-verification-control-room.js?v=20261017-control-room3"></script>
</body>
</html>
