<!doctype html><html lang="ar" dir="rtl" data-portal="customer" data-theme="<%= clientTheme || 'day' %>"><head><%- include('partials/retail_page_head',{retailPage:'account'}) %></head><body class="retail-page" data-customer-shell><%- include('partials/retail_shell_start',{activeRetailNav:'operations'}) %><div class="heading"><div><h1>التقارير</h1><p>ابحث في العمليات وتابع حالتها وكشوف الحساب.</p></div></div>    <div class="client-hub-mobile-content">
        <% const tab = typeof activeTab !== 'undefined' ? activeTab : 'operations'; %>
        <nav class="client-hub-tabs" aria-label="أقسام الحساب">
            <a href="/client/account?tab=operations" class="<%= tab === 'operations' ? 'is-active' : '' %>"><i class="fa-solid fa-list"></i> سجل العمليات</a>
            <% if (canRequestDeposit) { %>
            <a href="/client/account?tab=deposits-new" class="<%= tab.startsWith('deposit') ? 'is-active' : '' %>"><i class="fa-solid fa-arrow-down"></i> الإيداعات</a>
            <% } %>
            <a href="/client/account?tab=summary" class="<%= tab === 'summary' ? 'is-active' : '' %>"><i class="fa-solid fa-chart-pie"></i> ملخص مالي</a>
            <a href="/client/account?tab=export" class="<%= tab === 'export' ? 'is-active' : '' %>"><i class="fa-solid fa-file-export"></i> تصدير</a>
        </nav>

        <% if (tab.startsWith('deposit')) { %>
            <%- include('partials/hub_account_deposits', { tab: tab, user: user, canRequestDeposit: canRequestDeposit }) %>
        <% } else if (tab === 'summary' || tab === 'export') { %>
            <%- include('partials/hub_account_reports', { tab: tab, account: account, accountType: accountType }) %>
        <% } else { %>
            <%- include('partials/hub_account_reports', { tab: 'operations', account: account, accountType: accountType }) %>
        <% } %>
    </div>

<%- include('partials/retail_shell_end',{activeRetailNav:'operations'}) %><%- include('partials/retail_page_foot') %><script src="/js/client-hub-account.js?v=20261030-search" defer></script></body></html>