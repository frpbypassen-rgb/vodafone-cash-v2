<!DOCTYPE html>
<html lang="ar" dir="rtl">
<%- include('partials/company_portal_head', { title: canCreateStaff ? 'لوحة مدير الوكيل' : 'لوحة مدير التشغيل' }) %>
<body>
    <%- include('partials/company_portal_nav') %>

    <main class="shell portal-shell">
        <%- include('partials/company_portal_hero', {
            heroEntity: agent,
            heroIcon: 'fa-map-location-dot',
            heroEyebrow: canCreateStaff ? 'مساحة مدير الوكيل' : 'مساحة مدير التشغيل',
            heroTitle: agent.name,
            heroSubtitle: 'إدارة الفريق واعتماد العملاء ومتابعة التحويلات من مركز تشغيل موحد.',
            showHeroTransfer: canTransfer,
            showHeroRequests: true,
            showHeroTeam: true
        }) %>

        <%- include('partials/company_stats') %>
        <%- include('partials/company_portal_actions', { showTransfer: canTransfer, showOperations: true, showRequests: true, showTeam: true, showReports: true, showSupport: true }) %>

        <section class="portal-section" id="operations">
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-list-check"></i>مركز الوكيل</span>
                    <h2 class="portal-section-title">سجل العمليات والحالات</h2>
                </div>
                <span class="portal-section-meta"><%= dateLabel %></span>
            </div>
            <div>
                <%- include('partials/company_transactions_table', { showFilters: true }) %>
            </div>
        </section>

        <section class="portal-section">
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-user-check"></i>اعتماد العملاء</span>
                    <h2 class="portal-section-title">طلبات التسجيل الجديدة</h2>
                </div>
                <span class="portal-section-meta"><%= pendingRequests.length %> طلب معلق</span>
            </div>
            <%- include('partials/agent_requests_panel') %>
        </section>

        <section class="portal-section">
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-users-gear"></i>إدارة الحسابات</span>
                    <h2 class="portal-section-title">الفريق والصلاحيات</h2>
                </div>
                <span class="portal-section-meta"><%= staffCount %> حساب نشط</span>
            </div>
            <%- include('partials/agent_staff_panel') %>
        </section>
    </main>

    <%- include('partials/company_transfer_modal') %>
    <%- include('partials/company_portal_scripts') %>
</body>
</html>
