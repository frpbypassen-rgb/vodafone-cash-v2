<!doctype html>
<html lang="ar" dir="rtl" data-portal="customer" data-theme="<%= clientTheme || 'day' %>">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="<%= clientTheme==='night'?'#0b1422':'#f3f6fa' %>"><title>الرئيسية | أهرام باي</title>
<link rel="stylesheet" href="/css/portal-shell/base.css?v=20261030"><link rel="stylesheet" href="/css/retail-transfers.css?v=20261030-home"><link rel="stylesheet" href="/css/retail-home.css?v=20261030-1"><link rel="stylesheet" href="/css/retail-pages.css?v=20261030-1"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"><link rel="stylesheet" href="/css/rate-alert-overlay.css?v=20261030">
</head><body data-customer-shell data-retail-home>
<% const home = retailHome || {available:false};
const canTransfer = user.role !== 'accountant';
const number = (value,digits=0) => Number(value || 0).toLocaleString('en-US',{minimumFractionDigits:digits,maximumFractionDigits:digits});
const historyHref='/client/account?tab=operations'; %>
<%- include('partials/retail_shell_start',{activeRetailNav:'home'}) %>
<section class="retail-home" aria-label="الرئيسية">
<div class="heading"><div><h1>أهلًا <%= String(user.name || '').split(/\s+/)[0] %>،</h1><p>رصيدك وعملياتك، في مكان واحد.</p></div></div>
<% if (locals.showMfaNotice) { %><div class="home-security-note"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><div><strong>عزّز أمان حسابك</strong><p>راجع خيارات التحقق الثنائي لحماية تسجيل الدخول.</p></div><a class="home-text-link" href="/client/settings?section=security">إعدادات الأمان ←</a></div><% } %>
<div class="home-grid"><section class="home-balance" aria-labelledby="homeBalanceTitle"><div><p id="homeBalanceTitle">الرصيد المتاح</p><div class="home-money"><bdi><%= number(user.balance,3) %></bdi><small>د.ل</small></div><div class="home-account-code">رقم الحساب <bdi><%= user.accountCode || '—' %></bdi></div></div><div class="home-balance-bottom"><div><% if(home.available) { %><span>قيد التنفيذ هذا الشهر</span><strong><%= number(home.summary.pendingCount) %> عملية</strong><% } else { %><span>رصيد الحساب المعروض</span><strong>بالدينار الليبي</strong><% } %></div><a class="button" href="<%= historyHref %>">حركة الحساب ←</a></div></section>
<section class="home-panel home-quick" aria-labelledby="homeQuickTitle"><h2 id="homeQuickTitle">ماذا تريد أن تفعل؟</h2>
<% if(canTransfer) { %><a class="button primary home-transfer-action" href="/client/transfers"><span>تحويل جديد</span><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></a><% } else { %><p class="home-readonly">حسابك للعرض والمتابعة.</p><% } %>
<a class="button" href="<%= historyHref %>"><span>متابعة عملية</span><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a>
</section>
<% if(home.available) { %><section class="home-metrics" aria-label="إحصاءات التحويلات لهذا الشهر"><div class="home-metric"><span>تحويلات هذا الشهر</span><strong><%= number(home.summary.totalCount) %></strong><small><%= home.monthLabel %></small></div><div class="home-metric"><span>مكتملة</span><strong><%= number(home.summary.completedCount) %></strong></div><div class="home-metric"><span>قيد التنفيذ</span><strong><%= number(home.summary.pendingCount) %></strong></div></section><% } %>
<section class="home-panel home-recent" aria-labelledby="homeRecentTitle"><header class="home-section-head"><h2 id="homeRecentTitle">آخر العمليات</h2><a class="home-text-link" href="<%= historyHref %>">عرض الكل ←</a></header>
<% if(!home.available) { %><div class="home-empty" role="status"><strong>تعذر تحديث الملخص وآخر العمليات</strong><p>يمكنك فتح كشف الحساب أو إعادة المحاولة.</p><a class="button" href="/client/dashboard">إعادة المحاولة</a></div>
<% } else if(!home.recent.length) { %><div class="home-empty"><span class="home-empty-icon" aria-hidden="true"><i class="fa-solid fa-receipt"></i></span><h3>لا توجد تحويلات بعد</h3><p>ستظهر هنا آخر عملياتك بعد تسجيلها.</p><% if(canTransfer) { %><a class="button primary" href="/client/transfers">ابدأ تحويلًا</a><% } %></div>
<% } else { home.recent.forEach(tx=>{ %>
<a class="home-transaction" href="<%= historyHref %>&amp;search=<%= encodeURIComponent(tx.reference) %>&amp;dateType=month&amp;dateValue=<%= tx.createdAt ? new Date(tx.createdAt).getFullYear()+'-'+String(new Date(tx.createdAt).getMonth()+1).padStart(2,'0') : '' %>"><span class="home-tx-icon" aria-hidden="true"><i class="fa-solid <%= tx.icon %>"></i></span><div class="home-tx-main"><strong><%= tx.serviceLabel %></strong><bdi class="home-reference"><%= tx.reference %></bdi></div><time class="home-tx-date" datetime="<%= tx.createdAt ? new Date(tx.createdAt).toISOString() : '' %>"><%= tx.createdAt ? new Date(tx.createdAt).toLocaleString('ar-LY',{timeZone:'Africa/Tripoli',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) : '—' %></time><span class="home-status tone-<%= tx.tone %>"><%= tx.statusLabel %></span><span class="home-tx-amount"><bdi><%= number(tx.amount,2) %></bdi><small><%= tx.currency %></small></span></a>
<% }); } %>
</section></div></section>
<%- include('partials/retail_directory') %>
<%- include('partials/retail_shell_end',{activeRetailNav:'home'}) %>
<script>window.clientPortal = <%- JSON.stringify({csrfToken,retail:true,page:'home'}).replace(/</g,'\\u003c') %>;window.rateAlertInitial = <%- JSON.stringify(locals.pendingRateUpdate || null).replace(/</g,'\\u003c') %>;window.rateAlertCsrfToken = <%- JSON.stringify(csrfToken || '').replace(/</g,'\\u003c') %>;window.rateAlertPushPublicKey = <%- JSON.stringify(process.env.WEB_PUSH_PUBLIC_KEY || '').replace(/</g,'\\u003c') %>;</script>
<% if(!locals.localPreview) { %><script src="/socket.io/socket.io.js" defer></script><script src="/js/portal-realtime.js?v=20261028-shared" defer></script><script src="/js/rate-alert-overlay.js?v=20261030" defer></script><% } %>
<script src="/js/client-portal.js?v=20261030-home" defer></script>
</body></html>
