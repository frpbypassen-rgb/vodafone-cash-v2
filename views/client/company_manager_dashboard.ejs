<!DOCTYPE html>
<html lang="ar" dir="rtl">
<%- include('partials/company_portal_head', { title: canCreateStaff ? 'لوحة مدير الشركة' : 'لوحة مدير التشغيل' }) %>
<body>
    <%- include('partials/company_portal_nav') %>

    <main class="shell portal-shell">
        <%- include('partials/company_portal_hero', {
            heroEntity: company,
            heroIcon: 'fa-building-shield',
            heroEyebrow: canCreateStaff ? 'مساحة مدير الشركة' : 'مساحة مدير التشغيل',
            heroTitle: company.name,
            heroSubtitle: canCreateStaff ? 'إدارة الفريق ومتابعة العمليات والتحويلات من شاشة تشغيل واحدة.' : 'متابعة عمليات الشركة وتشغيل التحويلات بدون صلاحية إنشاء حسابات.',
            showHeroTransfer: canTransfer,
            showHeroTeam: true,
            showHeroReports: true
        }) %>

        <%- include('partials/company_stats') %>
        <%- include('partials/company_portal_actions', { showTransfer: canTransfer, showOperations: true, showTeam: true, showReports: true, showSupport: true }) %>

        <section class="portal-section" id="operations">
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-list-check"></i>مركز التشغيل</span>
                    <h2 class="portal-section-title">سجل العمليات والحالات</h2>
                </div>
                <span class="portal-section-meta"><%= dateLabel %></span>
            </div>
            <div>
                <%- include('partials/company_transactions_table', { showFilters: true }) %>
            </div>
        </section>

        <section class="portal-section">
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker"><i class="fa-solid fa-users-gear"></i>إدارة الحسابات</span>
                    <h2 class="portal-section-title">الفريق والصلاحيات</h2>
                </div>
                <span class="portal-section-meta"><%= staffCount %> حساب نشط</span>
            </div>
            <%- include('partials/company_staff_panel') %>
        </section>
    </main>

    <%- include('partials/company_transfer_modal') %>
    <%- include('partials/company_portal_scripts') %>
</body>
</html>
