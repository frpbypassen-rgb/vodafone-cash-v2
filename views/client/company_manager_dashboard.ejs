<!DOCTYPE html>
<html lang="ar" dir="rtl">
<%- include('partials/company_portal_head', { title: canCreateStaff ? 'لوحة مدير الشركة' : 'لوحة مدير التشغيل' }) %>
<body>
    <%- include('partials/company_portal_nav') %>

    <main class="shell">
        <section class="role-hero">
            <div>
                <div class="eyebrow"><i class="fa-solid fa-building-shield"></i><%= canCreateStaff ? 'مساحة المدير' : 'مساحة مدير التشغيل' %></div>
                <h1 class="page-title"><%= company.name %></h1>
                <p class="page-subtitle">
                    <%= canCreateStaff ? 'إدارة الفريق، متابعة العمليات، وإرسال التحويلات من حساب الشركة.' : 'متابعة عمليات الشركة وتشغيل التحويلات بدون صلاحية إنشاء حسابات.' %>
                </p>
            </div>
            <div class="toolbar">
                <% if (canTransfer) { %>
                    <button type="button" class="primary-btn" data-bs-toggle="modal" data-bs-target="#companyTransferModal">
                        <i class="fa-solid fa-paper-plane"></i>تحويل جديد
                    </button>
                <% } %>
                <a href="#staff" class="secondary-btn"><i class="fa-solid fa-users-gear"></i>الفريق</a>
                <a href="/client/reports" class="secondary-btn"><i class="fa-solid fa-file-invoice"></i>التقارير</a>
            </div>
        </section>

        <%- include('partials/company_stats') %>

        <section class="layout-grid">
            <div>
                <%- include('partials/company_transactions_table', { showFilters: true }) %>
            </div>
            <aside>
                <%- include('partials/company_staff_panel') %>
            </aside>
        </section>
    </main>

    <%- include('partials/company_transfer_modal') %>
    <%- include('partials/company_portal_scripts') %>
</body>
</html>
