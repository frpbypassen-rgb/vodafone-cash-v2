<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>طلب إيداع | Al-Ahram Pay</title>
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/brand-ui.css?v=20260827-deposits">
    <link rel="stylesheet" href="/css/client-nile-theme.css?v=20260827-deposits">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/client-theme.js?v=20260827-deposits" defer></script>
    <style>
        .deposit-page { max-width: 980px; margin: 0 auto; padding: 18px 14px 110px; }
        .deposit-hero { display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: start; margin-bottom: 18px; }
        .deposit-hero h1 { font-size: clamp(1.3rem, 3vw, 1.85rem); font-weight: 900; margin: 0 0 6px; }
        .deposit-hero p { margin: 0; color: var(--nile-muted, #64748b); line-height: 1.65; max-width: 620px; }
        .deposit-balance { min-width: 190px; padding: 14px 16px; border-radius: 16px; border: 1px solid rgba(16, 185, 129, 0.28); background: rgba(16, 185, 129, 0.08); }
        .deposit-balance span { display: block; font-size: 0.74rem; font-weight: 800; color: var(--nile-muted, #64748b); margin-bottom: 4px; }
        .deposit-balance strong { font-family: 'JetBrains Mono', monospace; font-size: 1.25rem; color: #10b981; }
        .deposit-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 16px; }
        .deposit-step { padding: 12px; border-radius: 14px; border: 1px solid var(--nile-border, #e2e8f0); background: var(--nile-surface, #fff); }
        .deposit-step strong { display: block; font-size: 0.82rem; margin-bottom: 4px; }
        .deposit-step small { color: var(--nile-muted, #64748b); font-size: 0.72rem; line-height: 1.5; }
        .deposit-grid { display: grid; grid-template-columns: minmax(280px, 0.95fr) minmax(0, 1.05fr); gap: 16px; align-items: start; }
        .deposit-card { border: 1px solid var(--nile-border, #e2e8f0); border-radius: 18px; background: var(--nile-surface, #fff); padding: 18px; box-shadow: var(--nile-shadow, 0 8px 24px rgba(15, 23, 42, 0.06)); }
        .deposit-card h2 { font-size: 1rem; font-weight: 900; margin: 0 0 16px; }
        .deposit-card h2 i { color: #0ea5e9; margin-left: 6px; }
        .deposit-form label { font-size: 0.78rem; font-weight: 800; color: var(--nile-muted, #64748b); margin-bottom: 6px; }
        .deposit-form .form-control { border-radius: 12px; padding: 12px; }
        .submit-deposit { width: 100%; border: 0; border-radius: 13px; padding: 13px; background: linear-gradient(135deg, #0ea5e9, #2563eb); color: #fff; font-weight: 900; }
        .submit-deposit:disabled { opacity: 0.55; cursor: not-allowed; }
        .deposit-list { display: flex; flex-direction: column; gap: 10px; }
        .deposit-row { padding: 14px; border-radius: 14px; border: 1px solid var(--nile-border, #e2e8f0); background: rgba(255,255,255,0.02); }
        .deposit-row.is-pending { border-color: rgba(245, 158, 11, 0.35); }
        .deposit-ref { font-family: 'JetBrains Mono', monospace; font-size: 0.76rem; color: #0ea5e9; }
        .deposit-value { font-family: 'JetBrains Mono', monospace; font-size: 1.05rem; font-weight: 900; }
        .deposit-meta { color: var(--nile-muted, #64748b); font-size: 0.74rem; margin-top: 4px; line-height: 1.55; }
        .status { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; padding: 5px 9px; font-size: 0.72rem; font-weight: 900; }
        .status.pending { color: #f59e0b; background: rgba(245, 158, 11, 0.12); }
        .status.deposit { color: #10b981; background: rgba(16, 185, 129, 0.12); }
        .status.rejected { color: #ef4444; background: rgba(239, 68, 68, 0.12); }
        .empty { text-align: center; color: var(--nile-muted, #64748b); padding: 36px 12px; }
        @media (max-width: 850px) {
            .deposit-grid, .deposit-steps, .deposit-hero { grid-template-columns: 1fr; }
            .deposit-balance { width: 100%; }
        }
    </style>
</head>
<body class="client-nile-theme client-satellite-page">
    <%- include('partials/wallet_shell_topbar', { account: user }) %>

    <nav class="glass-nav no-print d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <h4 class="m-0 fw-bold nile-page-title"><i class="fa-solid fa-arrow-down me-2"></i> طلب إيداع</h4>
            <div class="d-flex align-items-center gap-2">
                <button class="nav-btn btn-theme" type="button" onclick="toggleTheme()" title="تبديل الوضع"><i class="fa-solid fa-moon" id="themeIcon"></i></button>
                <a href="/client/dashboard" class="nav-btn"><i class="fa-solid fa-arrow-left me-1"></i> رجوع للوحة</a>
            </div>
        </div>
    </nav>

    <main class="deposit-page">
        <header class="deposit-hero">
            <div>
                <h1>طلب إيداع رصيد</h1>
                <p>أرسل قيمة الإيداع مع ملاحظة توضح مرجع التحويل. يصل الطلب للإدارة للمراجعة، ولا يُضاف الرصيد إلا بعد الموافقة.</p>
            </div>
            <div class="deposit-balance">
                <span><i class="fa-solid fa-wallet ms-1"></i> الرصيد الحالي</span>
                <strong dir="ltr" id="currentBalance"><%= Number(user.balance || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> LYD</strong>
            </div>
        </header>

        <section class="deposit-steps">
            <article class="deposit-step"><strong>1. أرسل الطلب</strong><small>القيمة وملاحظة توضح مصدر الإيداع.</small></article>
            <article class="deposit-step"><strong>2. مراجعة الإدارة</strong><small>يراجع فريق الدعم الطلب ويتحقق من التفاصيل.</small></article>
            <article class="deposit-step"><strong>3. القبول أو الإلغاء</strong><small>عند القبول يُضاف المبلغ إلى رصيدك مرة واحدة.</small></article>
        </section>

        <section class="deposit-grid">
            <form class="deposit-card deposit-form" id="depositForm">
                <h2><i class="fa-solid fa-circle-plus"></i>طلب إيداع جديد</h2>
                <div class="mb-3">
                    <label for="depositAmount">قيمة الإيداع (LYD)</label>
                    <input id="depositAmount" class="form-control" type="number" min="1" max="1000000" step="0.01" required placeholder="مثال: 500">
                </div>
                <div class="mb-3">
                    <label for="depositNote">ملاحظة للإدارة</label>
                    <textarea id="depositNote" class="form-control" rows="4" maxlength="1000" required placeholder="مرجع التحويل، اسم البنك، أو أي تفاصيل تساعد المراجعة"></textarea>
                </div>
                <button class="submit-deposit" type="submit" id="submitDepositBtn">
                    <i class="fa-solid fa-paper-plane ms-1"></i>إرسال طلب الإيداع للمراجعة
                </button>
            </form>

            <section class="deposit-card">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <h2 class="m-0"><i class="fa-solid fa-clock-rotate-left"></i>متابعة الطلبات</h2>
                    <span class="small text-muted" id="depositLiveBadge"><i class="fa-solid fa-signal"></i> تحديث تلقائي</span>
                </div>
                <div class="deposit-list" id="depositList">
                    <div class="empty"><i class="fa-solid fa-circle-notch fa-spin"></i> جارٍ تحميل الطلبات...</div>
                </div>
            </section>
        </section>
    </main>

    <%- include('partials/wallet_shell_bottom_nav', { activeNav: 'more' }) %>

    <script>
        const csrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
        let refreshTimer = null;

        const esc = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char]));
        const date = (value) => value ? new Date(value).toLocaleString('ar-LY', { dateStyle: 'medium', timeStyle: 'short' }) : '---';

        async function clientApiFetch(url, options = {}) {
            const requestOptions = { ...(options || {}) };
            const method = String(requestOptions.method || 'GET').toUpperCase();
            const headers = new Headers(requestOptions.headers || {});
            headers.set('Accept', 'application/json');
            if (csrfToken && !['GET', 'HEAD', 'OPTIONS'].includes(method)) {
                headers.set('x-csrf-token', csrfToken);
            }
            requestOptions.headers = headers;
            return fetch(url, requestOptions);
        }

        async function readApiResponse(response) {
            const data = await response.json().catch(() => ({}));
            if (response.status === 401) {
                window.location.assign('/login');
                throw new Error('انتهت جلسة الدخول.');
            }
            if (!response.ok || data.success === false) {
                throw new Error(data.message || data.error || 'تعذر إكمال الطلب.');
            }
            return data;
        }

        function statusMeta(request) {
            if (request.status === 'deposit') return ['deposit', 'مقبول', 'fa-circle-check'];
            if (request.status === 'rejected') return ['rejected', 'مرفوض', 'fa-circle-xmark'];
            return ['pending', 'قيد المراجعة', 'fa-clock'];
        }

        function renderRequests(requests) {
            const list = document.getElementById('depositList');
            if (!requests.length) {
                list.innerHTML = '<div class="empty"><i class="fa-regular fa-folder-open"></i>لا توجد طلبات إيداع حتى الآن.<br><small class="mt-2 d-block">استخدم النموذج لإرسال أول طلب.</small></div>';
                return;
            }

            list.innerHTML = requests.map((request) => {
                const [tone, label, icon] = statusMeta(request);
                const reviewedLine = request.reviewedByName
                    ? `<div class="deposit-meta">آخر مراجعة: ${esc(request.reviewedByName)} · ${date(request.reviewedAt || request.updatedAt)}</div>`
                    : `<div class="deposit-meta">آخر تحديث: ${date(request.updatedAt || request.createdAt)}</div>`;
                const rejectBlock = request.rejectionReason
                    ? `<div class="deposit-meta text-danger">سبب الرفض: ${esc(request.rejectionReason)}</div>`
                    : '';
                return `
                    <article class="deposit-row ${tone === 'pending' ? 'is-pending' : ''}">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <div class="deposit-ref">${esc(request.customId)}</div>
                                <div class="deposit-meta">${esc(request.note || 'لا توجد ملاحظة')} · ${date(request.createdAt)}</div>
                                ${reviewedLine}
                                ${rejectBlock}
                            </div>
                            <div class="text-start">
                                <div class="deposit-value">${Number(request.amount).toLocaleString('en-US', { maximumFractionDigits: 2 })} LYD</div>
                                <span class="status ${tone}"><i class="fa-solid ${icon}"></i>${label}</span>
                            </div>
                        </div>
                    </article>
                `;
            }).join('');
        }

        async function loadRequests(options = {}) {
            try {
                const data = await readApiResponse(await clientApiFetch('/client/api/deposits'));
                renderRequests(Array.isArray(data.requests) ? data.requests : []);
                if (Number.isFinite(Number(data.balance))) {
                    document.getElementById('currentBalance').textContent = `${Number(data.balance).toLocaleString('en-US', { maximumFractionDigits: 2 })} LYD`;
                }
                const hasPending = (data.requests || []).some((request) => request.status === 'pending');
                const badge = document.getElementById('depositLiveBadge');
                badge.innerHTML = hasPending
                    ? '<i class="fa-solid fa-arrows-rotate fa-spin"></i> متابعة الطلبات قيد المراجعة'
                    : '<i class="fa-solid fa-signal"></i> تحديث تلقائي';
                if (refreshTimer) window.clearInterval(refreshTimer);
                refreshTimer = hasPending ? window.setInterval(() => loadRequests({ silent: true }), 20000) : null;
            } catch (error) {
                document.getElementById('depositList').innerHTML = `<div class="empty text-danger">${esc(error.message)}</div>`;
            }
        }

        document.getElementById('depositForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const form = event.currentTarget;
            const submitBtn = document.getElementById('submitDepositBtn');
            submitBtn.disabled = true;
            try {
                const response = await clientApiFetch('/client/api/deposits', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        amount: document.getElementById('depositAmount').value,
                        note: document.getElementById('depositNote').value
                    })
                });
                const data = await readApiResponse(response);
                await Swal.fire({
                    icon: 'success',
                    title: 'تم إرسال الطلب',
                    html: `<p>رقم الطلب: <b dir="ltr">${esc(data.request.customId)}</b></p><p class="small text-muted mb-0">الحالة الآن: <b>قيد المراجعة</b>. سيتم إبلاغك عند قبول أو إلغاء الطلب.</p>`,
                    confirmButtonColor: '#2563eb'
                });
                form.reset();
                await loadRequests();
            } catch (error) {
                Swal.fire('تعذر الإرسال', error.message, 'error');
            } finally {
                submitBtn.disabled = false;
            }
        });

        loadRequests();
        window.addEventListener('beforeunload', () => {
            if (refreshTimer) window.clearInterval(refreshTimer);
        });
    </script>
</body>
</html>
