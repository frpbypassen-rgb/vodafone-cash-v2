<!DOCTYPE html>
<html lang="ar" dir="rtl">
<%- include('partials/company_portal_head', { title: 'واجهة موظف الوكيل' }) %>
<body>
    <%- include('partials/company_portal_nav') %>

    <main class="shell portal-shell">
        <section class="role-hero" id="overview">
            <div>
                <div class="eyebrow"><i class="fa-solid fa-user-tie"></i>واجهة موظف الوكيل</div>
                <h1 class="page-title">عمليات اليوم</h1>
                <p class="page-subtitle"><%= agent.name %> - تظهر عمليات اليوم الخاصة بالوكيل والعملاء التابعين له مع اسم الموظف المنفذ.</p>
            </div>
            <div class="toolbar">
                <button type="button" class="primary-btn" data-bs-toggle="modal" data-bs-target="#companyTransferModal">
                    <i class="fa-solid fa-paper-plane"></i>تحويل جديد
                </button>
                <a href="/client/support" class="secondary-btn"><i class="fa-solid fa-headset"></i>الدعم</a>
            </div>
        </section>

        <%- include('partials/company_portal_actions', { showTransfer: true, showOperations: true, showRequests: false, showTeam: false, showReports: false, showSupport: true }) %>
        <%- include('partials/company_stats') %>

        <section class="portal-section" id="operations">
            <div class="portal-section-head">
                <div>
                    <span class="portal-section-kicker">&#1605;&#1587;&#1575;&#1581;&#1577; &#1575;&#1604;&#1605;&#1608;&#1592;&#1601;</span>
                    <h2 class="portal-section-title">&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1581;&#1587;&#1575;&#1576; &#1608;&#1593;&#1605;&#1604;&#1610;&#1575;&#1578; &#1575;&#1604;&#1610;&#1608;&#1605;</h2>
                </div>
                <span class="portal-section-meta"><%= dateLabel %></span>
            </div>
            <div class="single-column-stack">
        <section class="panel mb-3">
            <div class="panel-heading">
                <h2 class="panel-title"><i class="fa-solid fa-id-card text-primary"></i>بيانات الموظف</h2>
                <span class="status-pill st-completed">نشط</span>
            </div>
            <div class="panel-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="small-muted">الاسم</div>
                        <div class="fw-bold"><%= account.name %></div>
                    </div>
                    <div class="col-md-4">
                        <div class="small-muted">اسم المستخدم</div>
                        <div class="mono-num" dir="ltr"><%= account.webUsername %></div>
                    </div>
                    <div class="col-md-4">
                        <div class="small-muted">الوكيل</div>
                        <div class="fw-bold"><%= agent.name %></div>
                    </div>
                </div>
            </div>
        </section>

        <%- include('partials/company_transactions_table', { showFilters: false }) %>
            </div>
        </section>
    </main>

    <%- include('partials/company_transfer_modal') %>
    <%- include('partials/company_portal_scripts') %>
</body>
</html>
