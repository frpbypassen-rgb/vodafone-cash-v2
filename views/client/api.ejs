<% const savedTheme = ['day','night','pharaonic'].includes(webhookTheme) ? webhookTheme : ''; %>
<!doctype html>
<html lang="ar" dir="rtl" data-theme="<%= savedTheme || 'day' %>">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <title>مفتاح API | الأهرام</title>
    <script>(()=>{let stored;try{stored=localStorage.getItem(<%- JSON.stringify(portalBase === '/client' ? 'ahram_company_theme' : 'ahram_client_theme') %>);}catch(_){}const server=<%- JSON.stringify(savedTheme) %>;document.documentElement.dataset.theme=server||(['day','night','pharaonic'].includes(stored)?stored:matchMedia('(prefers-color-scheme: dark)').matches?'night':'day');})();</script>
    <link rel="stylesheet" href="/css/merchant-webhooks.css?v=20261028-1">
    <link rel="stylesheet" href="/css/merchant-api-page.css?v=20261028-3">
    <script src="/js/merchant-api-page.js?v=20261028-3" defer></script>
</head>
<body>
<main class="wh-page api-page" data-api-page>
    <a class="wh-back" href="<%= portalBase %>/settings#integrations">→ رجوع للتكاملات</a>
    <header class="wh-header"><div><h1>مفتاح API</h1><p>اربط نظامك وتابع عمليات الربط.</p></div><button type="button" class="wh-button" data-api-refresh aria-label="تحديث حالة API">تحديث</button></header>
    <p class="wh-notice" data-api-notice role="status" aria-live="polite" hidden></p>
    <div class="api-grid">
        <section class="wh-panel" aria-labelledby="api-key-title">
            <div class="wh-section-head"><h2 id="api-key-title">مفتاح الربط</h2><span class="wh-badge" data-api-state>جارٍ التحقق</span></div>
            <p class="api-caption" data-api-description></p>
            <div class="api-mask" dir="ltr" data-api-hint aria-label="آخر أحرف المفتاح">•••• •••• ••••</div>
            <dl class="api-meta"><div><dt>تاريخ الإصدار</dt><dd data-api-created>—</dd></div><div><dt>آخر عملية API</dt><dd data-api-last>—</dd></div></dl>
            <p class="api-caption">لأمان حسابك، لا يمكن عرض المفتاح الحالي كاملًا.</p>
            <div class="api-actions"><button type="button" class="wh-button wh-primary" data-api-rotate disabled>إنشاء مفتاح</button><button type="button" class="wh-button wh-danger-button" data-api-revoke hidden>إيقاف المفتاح</button></div>
        </section>
        <section class="wh-panel" aria-labelledby="api-start-title">
            <div class="wh-section-head"><h2 id="api-start-title">ابدأ الربط</h2><a class="wh-button api-download" href="<%= portalBase %>/integrations/api/guide.pdf" download>تحميل الوثيقة</a></div>
            <label class="api-caption" for="api-address">عنوان الخدمة</label>
            <div class="api-address-row"><input id="api-address" class="wh-input" readonly dir="ltr" value="<%= apiBase %>"><button class="wh-button" type="button" data-api-copy-base>نسخ</button></div>
            <p class="api-caption">أرسل المفتاح في ترويسة <code dir="ltr">x-api-key</code> من خادمك عبر HTTPS.</p>
            <details class="api-guide" id="api-example"><summary>عرض مثال الربط</summary><pre class="api-code" dir="ltr" data-api-example></pre><button type="button" class="wh-button" data-api-copy-example>نسخ المثال</button></details>
            <p class="api-caption">للتحويلات، أرسل <code dir="ltr">Idempotency-Key</code> فريدًا لكل طلب، واستخدم المفتاح نفسه والبيانات نفسها عند إعادة المحاولة.</p>
            <a class="wh-button api-download api-webhooks" href="<%= portalBase %>/integrations/webhooks" data-api-webhooks hidden>إدارة Webhooks ←</a>
            <span class="api-caption api-webhooks" data-api-webhooks-locked hidden>Webhooks غير مفعّلة من الإدارة.</span>
        </section>
    </div>
    <section class="wh-panel api-ip-policy" aria-labelledby="api-ip-title">
        <div class="wh-section-head"><h2 id="api-ip-title">القائمة البيضاء IP</h2><span class="wh-badge" data-api-ip-state>غير مفعّلة</span></div>
        <p class="api-caption">اقبل طلبات API من عناوين سيرفرك فقط.</p>
        <p class="api-ip-addresses" dir="ltr" data-api-ip-addresses></p>
        <button type="button" class="wh-button" data-api-ip-manage>إدارة القائمة</button>
    </section>
    <section class="wh-panel api-history" aria-labelledby="api-history-title"><div class="wh-section-head"><h2 id="api-history-title">آخر عمليات API</h2><span class="api-caption">آخر 5 عمليات</span></div><div data-api-history aria-live="polite"><p class="api-caption">جارٍ التحميل…</p></div></section>
    <dialog class="wh-dialog" data-api-dialog aria-labelledby="api-dialog-title"></dialog>
    <noscript><p class="wh-notice">فعّل JavaScript لإدارة مفتاح API.</p></noscript>
</main>
<script id="api-page-config" type="application/json"><%- JSON.stringify({portalBase,csrf:csrfToken,status,apiBase}).replace(/</g,'\\u003c') %></script>
</body></html>
