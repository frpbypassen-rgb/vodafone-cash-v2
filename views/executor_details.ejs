<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= bot.name %> · ملف المنفذ | الأهرام</title>
    
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.9);
            --glass-border: rgba(0, 0, 0, 0.08);
            --shadow-3d: 0 10px 30px rgba(0, 0, 0, 0.04);
            --text-main: #1e293b;
            --text-muted: #64748b;
            --input-bg: #f8fafc;
            --brand-primary: #10b981;
        }

        [data-theme="dark"] {
            --glass-bg: rgba(30, 41, 59, 0.7);
            --glass-border: rgba(255, 255, 255, 0.1);
            --shadow-3d: 0 10px 30px rgba(0, 0, 0, 0.3);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --input-bg: rgba(0, 0, 0, 0.2);
            --brand-primary: #10b981;
        }

        .glass-card {
            background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border); border-radius: 20px; padding: 25px;
            box-shadow: var(--shadow-3d); transition: 0.3s; position: relative; overflow: hidden;
        }

        .glass-card::before {
            content: ''; position: absolute; top: -50%; right: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 60%);
            transform: rotate(45deg); pointer-events: none; z-index: 0;
        }

        .profile-icon {
            width: 75px; height: 75px; border-radius: 20px;
            display: flex; align-items: center; justify-content: center; font-size: 2.2rem;
            color: white; box-shadow: 0 10px 20px rgba(0,0,0,0.15); position: relative; z-index: 1; margin-bottom: 15px;
        }

        .info-box {
            background: var(--input-bg); border-radius: 14px; padding: 15px;
            border: 1px solid var(--glass-border); margin-bottom: 15px; position: relative; z-index: 1;
            display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
        }
        
        .control-card-3d {
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-style: preserve-3d; border-radius: 16px !important; padding: 15px !important;
        }
        .control-card-3d:hover {
            transform: translateY(-4px); box-shadow: 0 15px 25px rgba(0,0,0,0.08) !important;
        }
        [data-theme="dark"] .control-card-3d:hover { box-shadow: 0 15px 25px rgba(0,0,0,0.4) !important; }
        
        .btn-3d-hover { transition: all 0.2s; }
        .btn-3d-hover:hover { transform: translateY(-2px); filter: brightness(1.1); box-shadow: 0 6px 12px rgba(0,0,0,0.15); }
        .btn-3d-hover:active { transform: translateY(1px); }

        .mono-num { font-family: 'JetBrains Mono', monospace; font-weight: 800;}
        .form-control, .form-select { background: var(--input-bg); color: var(--text-main); border: 1px solid var(--glass-border); font-weight: bold; border-radius: 10px; }
        .form-control:focus, .form-select:focus { background: transparent; border-color: var(--brand-primary); box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); color: var(--text-main); }
        
        .unified-height { min-height: 42px; display: flex; align-items: center; }
        .settlement-card { background: linear-gradient(135deg, rgba(245,158,11,.13), rgba(16,185,129,.08)); border: 1px solid rgba(245,158,11,.3); border-radius: 18px; padding: 20px; position: relative; overflow: hidden; }
        .settlement-card::after { content:''; position:absolute; inset:auto -45px -70px auto; width:170px; height:170px; border-radius:50%; background:rgba(245,158,11,.12); pointer-events:none; }
        .settlement-head { display:flex; align-items:flex-start; gap:12px; position:relative; z-index:1; margin-bottom:16px; }
        .settlement-icon { width:42px; height:42px; border-radius:13px; display:grid; place-items:center; color:#1f2937; background:linear-gradient(135deg,#fde68a,#f59e0b); font-size:1.1rem; }
        .settlement-head h6 { color:var(--text-main); font-weight:900; margin:0 0 3px; }
        .settlement-head p { color:var(--text-muted); font-size:.76rem; margin:0; }
        .receipt-drop { min-height:52px; border:1px dashed rgba(16,185,129,.65); border-radius:12px; background:rgba(16,185,129,.07); display:flex; align-items:center; gap:9px; padding:8px 12px; cursor:pointer; position:relative; z-index:1; }
        .receipt-drop i { color:#10b981; font-size:1.15rem; }
        .receipt-drop strong { color:var(--text-main); font-size:.8rem; display:block; }
        .receipt-drop small { color:var(--text-muted); font-size:.68rem; display:block; }
        .receipt-drop input { position:absolute; opacity:0; inset:0; cursor:pointer; }
        .settlement-submit { min-height:52px; border:0; border-radius:12px; font-weight:900; background:linear-gradient(135deg,#fbbf24,#f59e0b); color:#1f2937; position:relative; z-index:1; }
        .settlement-submit:disabled { opacity:.65; }

        /* 🔘 Switch */
        .switch-container { display: flex; align-items: center; justify-content: space-between; background: var(--input-bg); border-radius: 14px; padding: 15px; border: 1px solid var(--glass-border); }
        .cyber-switch { position: relative; width: 60px; height: 30px; background: #475569; border-radius: 30px; cursor: pointer; transition: 0.4s; box-shadow: inset 0 2px 5px rgba(0,0,0,0.3); }
        .cyber-switch::before { content: ''; position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; background: white; border-radius: 50%; transition: 0.4s; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        .cyber-switch.active { background: #10b981; box-shadow: inset 0 2px 5px rgba(0,0,0,0.2), 0 0 10px rgba(16, 185, 129, 0.4); }
        .cyber-switch.active::before { transform: translateX(30px); }
    </style>

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Al-Ahram">
    <!-- End PWA Setup -->
<%- include('partials/admin_modern_head') %>
<link rel="stylesheet" href="/css/admin-merchants.css?v=20261027-cards">
<link rel="stylesheet" href="/css/admin-executor-detail.css?v=20261027">
</head>
<body class="am-merchant-body">

<%- include('partials/sidebar', { activePage: 'executors' }) %>

<div class="main-content am-executor-detail"><div class="am-executor-wrap" data-executor-detail data-tab="<%= history.filters.tab %>">
<%
const detailLabels = {ledger:'السجل المالي',operations:'العمليات',staff:'الموظفون',settings:'الإعدادات'};
const detailUrl = (tab, changes = {}) => {
 const params = new URLSearchParams({tab});
 if(tab === history.filters.tab) for(const key of ['q','status','service','from','to','period']) if(history.filters[key]) params.set(key,history.filters[key]);
 for(const [key,value] of Object.entries(changes)) { if(value) params.set(key,String(value)); else params.delete(key); }
 return '/executor/'+bot._id+'?'+params.toString();
};
const detailMoney = value => Number(value || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
const detailColor = value => Number(value)>0?'am-positive':Number(value)<0?'am-negative':'';
const detailStatuses = {completed:'مكتملة',deposit:'إيداع',deduction:'خصم',deposit_pending:'إيداع قيد المراجعة',pending:'معلقة',processing:'قيد التنفيذ',accepted:'مقبولة',rejected:'مرفوضة',cancelled_by_admin:'ملغاة'};
const detailView = {detailLabels,detailUrl,detailMoney,detailColor,detailStatuses};
%>
<%- include('partials/admin_executor_detail_header', detailView) %>
<%- include('partials/admin_executor_detail_alerts', detailView) %>
<%- include('partials/admin_executor_detail_summary', detailView) %>
<%- include('partials/admin_executor_detail_nav', detailView) %>
<% if(history.filters.tab === 'settings') { %><section class="am-detail-panel"><%- include('partials/admin_executor_detail_settings', detailView) %></section>
<% } else if(history.filters.tab === 'staff') { %><%- include('partials/admin_executor_detail_staff', detailView) %>
<% } else { %><%- include('partials/admin_executor_detail_history', detailView) %><% } %>
</div></div>
<script>
    const settlementForm = document.getElementById('settlementForm');
    if (settlementForm) {
        // الاعتماد أولاً على الحقل الذي يضيفه وسيط CSRF للخادم يضمن تطابق
        // الرمز مع جلسة الصفحة حتى لو تغيّرت متغيرات القالب أو أعيد تحميلها.
        const adminCsrfToken = settlementForm.querySelector('input[name="_csrf"]')?.value
            || <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
        const amountInput = settlementForm.querySelector('[name="amount"]');
        const receiptInput = document.getElementById('settlementReceipts');
        const receiptLabel = document.getElementById('receiptLabel');
        const submitButton = document.getElementById('settlementSubmit');
        receiptInput.addEventListener('change', () => { receiptLabel.textContent = receiptInput.files.length ? `${receiptInput.files.length} إيصال جاهز للإرسال` : 'إرفاق الإيصالات'; });
        const toDataUrl = (file) => new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });
        settlementForm.addEventListener('submit', async (event) => {
            const amount = Number(amountInput.value);
            if (!(amount > 0)) return;
            event.preventDefault();
            const files = [...receiptInput.files];
            if (!files.length) return Swal.fire('الإيصال مطلوب', 'أرفق إيصال إيداع واحدًا على الأقل.', 'warning');
            if (files.length > 5 || files.some((file) => file.size > 5 * 1024 * 1024)) return Swal.fire('حجم الإيصالات غير صالح', 'الحد الأقصى 5 صور، وبحجم 5MB لكل صورة.', 'warning');
            submitButton.disabled = true;
            try {
                const response = await fetch(settlementForm.action, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': adminCsrfToken, 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ amount: amountInput.value, notes: settlementForm.querySelector('[name="notes"]').value, fundingServiceKey: settlementForm.querySelector('[name="fundingServiceKey"]')?.value, receiptsBase64: await Promise.all(files.map(toDataUrl)) }) });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.error || 'تعذر إرسال الطلب.');
                await Swal.fire('تم الإرسال', `طلب الإيداع ${data.request.customId} قيد المراجعة الآن.`, 'success');
                window.location.href = `${settlementForm.action.replace('/settle', '')}?depositRequest=${encodeURIComponent(data.request.customId)}`;
            } catch (error) { Swal.fire('تعذر الإرسال', error.message, 'error'); } finally { submitButton.disabled = false; }
        });
    }

    function toggleSidebar() { 
        document.querySelector('.sidebar').classList.toggle('active');
        document.querySelector('.sidebar-overlay').classList.toggle('active'); 
    }

    function confirmToggle() {
        const switchEl = document.getElementById('cyberSwitch');
        const isCurrentlyActive = switchEl.classList.contains('active');
        const actionText = isCurrentlyActive ? 'إيقاف وتعطيل' : 'تشغيل وتفعيل';
        const actionColor = isCurrentlyActive ? '#ef4444' : '#10b981';

        Swal.fire({
            title: `تأكيد ${actionText} البوت؟`,
            text: isCurrentlyActive ? "لن يستقبل البوت أي عمليات وسيتم إرسال إشعار للمنفذين بتوقف عملهم." : "سيعود البوت للعمل واستقبال العمليات وسيتم إشعار المنفذين.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: actionColor,
            cancelButtonColor: '#64748b',
            confirmButtonText: `نعم، ${actionText}`,
            cancelButtonText: 'تراجع',
            customClass: { popup: 'rounded-4 bg-glass' }
        }).then((result) => {
            if (result.isConfirmed) {
                switchEl.classList.toggle('active');
                document.getElementById('statusText').innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري...';
                document.getElementById('toggleForm').submit();
            }
        });
    }

    document.getElementById('sessionTtlEnabled')?.addEventListener('change', (event) => {
        const hours = document.getElementById('sessionTtlHours');
        if (hours) hours.disabled = !event.currentTarget.checked;
    });
    document.querySelectorAll('form[action*="execution-policy"]').forEach((form) => {
        const inherit = form.querySelector('.js-inherit-company');
        const fields = form.querySelector('.js-override-fields');
        const ttl = form.querySelector('.js-session-ttl');
        const hours = form.querySelector('.js-session-hours');
        inherit?.addEventListener('change', () => fields?.classList.toggle('d-none', inherit.checked));
        ttl?.addEventListener('change', () => { if (hours) hours.disabled = !ttl.checked; });
    });
</script>
<script src="/js/admin-executor-detail.js?v=20261027"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
