<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= company.name %> | مركز إدارة الشركة</title>
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('ahram_theme') || 'dark');</script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <style>
        :root { --ws-bg:#f4f7fb; --ws-card:#fff; --ws-text:#182337; --ws-muted:#68758a; --ws-border:#e4eaf2; --ws-primary:#4f46e5; --ws-shadow:0 10px 30px rgba(21,35,60,.07); }
        [data-theme="dark"] { --ws-bg:#0b1220; --ws-card:#121d2f; --ws-text:#eef4ff; --ws-muted:#a1aec1; --ws-border:#27364e; --ws-primary:#818cf8; --ws-shadow:0 12px 32px rgba(0,0,0,.26); }
        body { background:var(--ws-bg); color:var(--ws-text); font-family:Tajawal,Arial,sans-serif; }
        .main-content { background:var(--ws-bg); min-height:100vh; padding:24px; }
        .ws-shell { max-width:1480px; margin:auto; display:grid; grid-template-columns:250px minmax(0,1fr); gap:20px; }
        .ws-sidebar,.ws-card { background:var(--ws-card); border:1px solid var(--ws-border); border-radius:18px; box-shadow:var(--ws-shadow); }
        .ws-sidebar { position:sticky; top:16px; align-self:start; padding:14px; }
        .ws-brand { padding:12px 10px 18px; border-bottom:1px solid var(--ws-border); margin-bottom:10px; }
        .ws-brand-name { color:var(--ws-text); font-weight:900; line-height:1.4; }
        .ws-brand-meta { color:var(--ws-muted); font-size:.78rem; margin-top:4px; }
        .ws-nav { display:flex; flex-direction:column; gap:4px; }
        .ws-nav a { color:var(--ws-muted); text-decoration:none; padding:10px 11px; border-radius:10px; font-weight:800; font-size:.89rem; }
        .ws-nav a:hover,.ws-nav a.active { color:#fff; background:var(--ws-primary); }
        .ws-nav i { width:23px; text-align:center; }
        .ws-content { min-width:0; }
        .ws-top { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:16px; }
        .ws-top h1 { font-size:1.28rem; font-weight:900; margin:0; color:var(--ws-text); }
        .ws-top p { color:var(--ws-muted); margin:4px 0 0; font-size:.84rem; }
        .ws-card { padding:20px; margin-bottom:16px; }
        .ws-card h2 { font-size:1rem; font-weight:900; color:var(--ws-text); margin:0 0 16px; }
        .ws-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
        .ws-metric { border:1px solid var(--ws-border); border-radius:14px; padding:15px; background:color-mix(in srgb,var(--ws-card) 90%,var(--ws-primary)); }
        .ws-metric small,.ws-label { color:var(--ws-muted); display:block; font-weight:800; font-size:.76rem; }
        .ws-metric strong { display:block; color:var(--ws-text); font:900 1.4rem 'JetBrains Mono',monospace; margin-top:7px; }
        .ws-value { color:var(--ws-text); font-weight:900; overflow-wrap:anywhere; }
        .ws-definition { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
        .ws-definition > div { border-bottom:1px dashed var(--ws-border); padding:8px 0; }
        .ws-section-row { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 0; border-bottom:1px dashed var(--ws-border); }
        .ws-section-row:last-child { border-bottom:0; }
        .ws-section-row .sub { color:var(--ws-muted); font-size:.77rem; margin-top:3px; }
        .table { --bs-table-bg:transparent; --bs-table-color:var(--ws-text); --bs-table-border-color:var(--ws-border); color:var(--ws-text); }
        .table th { color:var(--ws-muted); font-size:.78rem; white-space:nowrap; }
        .form-control,.form-select { background:var(--ws-bg); color:var(--ws-text); border-color:var(--ws-border); }
        .form-control:focus,.form-select:focus { color:var(--ws-text); background:var(--ws-bg); border-color:var(--ws-primary); box-shadow:0 0 0 .2rem rgba(79,70,229,.15); }
        .mono { font-family:'JetBrains Mono',monospace; } .text-muted { color:var(--ws-muted)!important; }
        .ws-empty { text-align:center; padding:30px; color:var(--ws-muted); font-weight:800; }
        .company-logo { width:108px; height:108px; border-radius:22px; object-fit:cover; border:1px solid var(--ws-border); background:var(--ws-bg); }
        .company-logo-empty { width:108px; height:108px; border-radius:22px; display:grid; place-items:center; color:var(--ws-primary); background:color-mix(in srgb,var(--ws-primary) 12%,var(--ws-card)); font-size:2.5rem; border:1px dashed var(--ws-primary); }
        .profile-hero { display:flex; align-items:center; gap:18px; padding-bottom:18px; margin-bottom:20px; border-bottom:1px solid var(--ws-border); }
        .profile-hero h2 { margin:0; }.profile-hero p { margin:5px 0 0; color:var(--ws-muted); font-size:.83rem; font-weight:700; }
        .profile-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }.profile-form-grid .full { grid-column:1/-1; }
        .profile-section-title { margin:26px 0 12px; padding-top:20px; border-top:1px solid var(--ws-border); font-size:1rem; font-weight:900; color:var(--ws-text); }
        .profile-actions { position:sticky; bottom:10px; z-index:4; display:flex; justify-content:flex-end; gap:10px; padding:12px; margin:22px -4px -4px; border:1px solid var(--ws-border); border-radius:14px; background:color-mix(in srgb,var(--ws-card) 94%,transparent); backdrop-filter:blur(10px); }
        .security-account { border:1px solid var(--ws-border); border-radius:14px; padding:14px; margin-bottom:10px; background:color-mix(in srgb,var(--ws-card) 93%,var(--ws-primary)); }
        .security-account summary { cursor:pointer; list-style:none; display:flex; align-items:center; justify-content:space-between; gap:12px; }
        .security-account summary::-webkit-details-marker { display:none; }
        .security-account[open] summary { padding-bottom:14px; margin-bottom:14px; border-bottom:1px dashed var(--ws-border); }
        .permission-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
        .server-pick { cursor:pointer; border:1px solid var(--ws-border); background:var(--ws-bg); color:var(--ws-text); border-radius:10px; padding:7px 10px; font-weight:800; }
        .server-pick:hover { border-color:var(--ws-primary); color:var(--ws-primary); }
        @media (max-width:991px) { .main-content { padding:12px; } .ws-shell { display:block; } .ws-sidebar { position:sticky; top:4px; z-index:10; margin-bottom:12px; padding:9px; } .ws-brand { display:none; } .ws-nav { overflow-x:auto; flex-direction:row; } .ws-nav a { white-space:nowrap; padding:8px 10px; font-size:.78rem; } .ws-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .ws-definition,.profile-form-grid { grid-template-columns:1fr; } .ws-card { padding:15px; border-radius:14px; } .ws-top { align-items:flex-start; flex-direction:column; } .profile-hero { align-items:flex-start; } .company-logo,.company-logo-empty { width:82px; height:82px; border-radius:18px; } .profile-actions { bottom:6px; } }
    </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'clients' }) %>
<% const txMetrics = transactionMetrics || {}; const apiSummary = apiMetrics || {}; const total = Number(txMetrics.totalCount || 0); const completed = Number(txMetrics.completedCount || 0); const rate = total ? Math.round((completed / total) * 100) : 0; const activeStaff = (employees || []).filter((item) => item.status === 'active'); const securedStaff = activeStaff.filter((item) => item.mfaEnabled); const profile = company.businessProfile || {}; const legacyLogo = (company.verificationDocuments || []).find((item) => item.kind === 'profile_photo'); const companyLogo = company.logoUrl || legacyLogo?.fileUrl || ''; const sectionNames = { overview:'نظرة عامة',profile:'البيانات الشخصية',security:'الأمان والصلاحيات',finance:'الحساب المالي',operations:'العمليات',api:'API والتكامل',webhooks:'Webhooks',reports:'التقارير',audit:'سجل التدقيق' }; const route = (name) => `/company/${company._id}/${name}`; %>
<main class="main-content"><div class="ws-shell">
    <aside class="ws-sidebar">
        <div class="ws-brand"><div class="ws-brand-name"><i class="fa-solid fa-building-shield text-primary me-1"></i><%= company.name %></div><div class="ws-brand-meta">رصيد: <span class="mono"><%= Number(company.balance || 0).toFixed(2) %> LYD</span></div></div>
        <nav class="ws-nav" aria-label="أقسام الشركة">
            <% [['overview','fa-gauge-high'],['profile','fa-id-card'],['security','fa-shield-halved'],['finance','fa-wallet'],['operations','fa-list-check'],['api','fa-code'],['webhooks','fa-tower-broadcast'],['reports','fa-chart-line'],['audit','fa-clock-rotate-left']].forEach(([name,icon]) => { %><a href="<%= route(name) %>" class="<%= section === name ? 'active' : '' %>"><i class="fa-solid <%= icon %>"></i><%= sectionNames[name] %></a><% }) %>
        </nav>
    </aside>
    <section class="ws-content">
        <header class="ws-top"><div><h1><%= sectionNames[section] %></h1><p><%= company.name %> · <span class="<%= company.status === 'active' ? 'text-success' : 'text-danger' %>"><%= company.status === 'active' ? 'نشط' : 'موقوف' %></span></p></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-sm btn-outline-secondary" href="/clients">القائمة</a><a class="btn btn-sm btn-primary" href="/admin/accounts/company/<%= company._id %>/edit">تعديل البيانات</a></div></header>
        <% if (query && (query.balanceSaved || query.rateUpdated || query.codeSaved || query.routePolicySaved || query.webhookDeleted || query.apiTokenRotated || query.profileSaved || query.securitySaved || query.apiServerSaved || query.apiServerLocked || query.apiServerUnlocked || query.apiServerDeleted)) { %><div class="alert alert-success fw-bold">تم حفظ التعديل بنجاح.</div><% } %>
        <% if (query && (query.balanceError || query.rateError || query.codeError || query.routePolicyError || query.webhookDeleteError || query.apiTokenError || query.profileError || query.securityError)) { const profileErrors = { INVALID_COMPANY_NAME:'اسم الشركة يجب أن يتكون من حرفين على الأقل.', INVALID_PHONE:'أحد أرقام الهاتف غير صالح.', INVALID_REGION:'المنطقة المختارة غير صالحة.', INVALID_MANAGER_USERNAME:'اسم المستخدم يجب أن يكون 3 أحرف على الأقل وبدون مسافات.', MANAGER_USERNAME_TAKEN:'اسم المستخدم مستخدم بالفعل في حساب آخر.', MANAGER_PASSWORD_WEAK:'كلمة مرور المدير يجب أن تتكون من 10 أحرف على الأقل.', LAST_COMPANY_OWNER:'لا يمكن إيقاف آخر مدير نشط أو تحويله إلى دور آخر.', INVALID_API_SERVER:'أدخل اسم الخادم وعنوان IP عاماً صالحاً.', INVALID_API_SERVER_URL:'رابط الخادم يجب أن يكون عنوان HTTP أو HTTPS صحيحاً دون بيانات دخول أو استعلامات.', API_SERVER_NOT_FOUND:'الخادم المحدد غير موجود أو غير مفعل.', LOCKED_API_SERVER_DELETE_FORBIDDEN:'ألغ قفل الخادم أولاً قبل حذفه.', logo:'الشعار يجب أن يكون JPG أو PNG أو WEBP وبحجم لا يتجاوز 3MB.' }; %><div class="alert alert-danger fw-bold"><%= profileErrors[query.profileError || query.securityError] || 'تعذر حفظ التعديل. راجع البيانات ثم أعد المحاولة.' %></div><% } %>

        <% if (section === 'overview') { %>
            <div class="ws-grid mb-3"><div class="ws-metric"><small>الرصيد المتاح</small><strong class="<%= company.balance < 0 ? 'text-danger' : 'text-success' %>"><%= Number(company.balance || 0).toFixed(2) %> <small>LYD</small></strong></div><div class="ws-metric"><small>معلّق للتنفيذ</small><strong class="text-warning"><%= Number(txMetrics.pendingCount || 0) %></strong></div><div class="ws-metric"><small>نسبة النجاح</small><strong class="text-success"><%= rate %>%</strong></div><div class="ws-metric"><small>حماية الموظفين</small><strong><%= securedStaff.length %>/<%= activeStaff.length %> <small>2FA</small></strong></div></div>
            <div class="ws-card"><h2>تنبيهات وتشغيل سريع</h2><div class="ws-section-row"><div><strong>قنوات Webhook النشطة</strong><div class="sub">تصل تحديثات الحالة مباشرة إلى أنظمة الشركة.</div></div><a class="btn btn-sm btn-outline-primary" href="<%= route('webhooks') %>"><%= (webhookSubscriptions || []).filter((item) => item.status === 'active').length %> قناة</a></div><div class="ws-section-row"><div><strong>التوجيه الآلي للشركة</strong><div class="sub"><%= company.autoRoutePolicy?.enabled ? `مفعل حتى ${company.autoRoutePolicy.maxAutoAmount} EGP` : 'غير مفعل؛ العمليات تتبع سياسة النظام العامة' %></div></div><a class="btn btn-sm btn-outline-primary" href="<%= route('api') %>">إدارة التوجيه</a></div><div class="ws-section-row"><div><strong>آخر العمليات</strong><div class="sub">عرض العمليات والحالات وسجل التنفيذ.</div></div><a class="btn btn-sm btn-outline-primary" href="<%= route('operations') %>">فتح العمليات</a></div></div>
        <% } %>

        <% if (section === 'profile') { %>
            <% const manager = primaryManager || null; const managerName = profile.managerName || profile.contactName || manager?.name || ''; const managerPhone = profile.managerPhone || manager?.phone || ''; %>
            <% if (!isMaster) { %>
                <div class="ws-card"><h2>وصول مقيّد</h2><div class="alert alert-warning mb-0">تعديل هوية الشركة وبيانات مديرها متاح للمدير الرئيسي فقط.</div></div>
            <% } else { %>
                <form class="ws-card" action="/company/<%= company._id %>/profile" method="POST" enctype="multipart/form-data">
                    <div class="profile-hero">
                        <% if (companyLogo) { %><img class="company-logo" data-logo-preview src="<%= companyLogo %>" alt="شعار <%= company.name %>"><% } else { %><div class="company-logo-empty" data-logo-placeholder><i class="fa-solid fa-building"></i></div><img class="company-logo d-none" data-logo-preview alt="معاينة الشعار"><% } %>
                        <div><h2>هوية الشركة</h2><p>الشعار وصورة الهوية يقبلان من الهاتف أو الكمبيوتر. الحد الأقصى 3MB بصيغ JPG وPNG وWEBP.</p><label class="btn btn-sm btn-outline-primary mt-2" for="companyLogo"><i class="fa-solid fa-image me-1"></i>رفع أو استبدال الشعار</label><input id="companyLogo" name="companyLogo" class="d-none" type="file" accept="image/jpeg,image/png,image/webp" data-logo-input></div>
                    </div>
                    <div class="profile-form-grid">
                        <div><label class="ws-label mb-1" for="companyName">اسم الشركة</label><input id="companyName" name="name" class="form-control" value="<%= company.name %>" maxlength="120" required></div>
                        <div><label class="ws-label mb-1">رقم الشركة الداخلي</label><input class="form-control mono" value="<%= company.accountCode || 'غير محدد بعد' %>" readonly></div>
                        <div><label class="ws-label mb-1" for="companyPhone">رقم هاتف الشركة</label><input id="companyPhone" name="companyPhone" class="form-control mono" value="<%= company.phone || '' %>" maxlength="24" inputmode="tel" placeholder="+2189XXXXXXXX"></div>
                        <div><label class="ws-label mb-1" for="headquarters">مقر الشركة</label><input id="headquarters" name="headquarters" class="form-control" value="<%= profile.headquarters || profile.address || '' %>" maxlength="240" placeholder="اسم المقر أو العنوان التفصيلي"></div>
                        <div><label class="ws-label mb-1" for="regionCode">المنطقة</label><select id="regionCode" name="regionCode" class="form-select"><option value="">اختر المنطقة</option><% (libyaRegions || []).forEach((region) => { %><option value="<%= region.code %>" <%= profile.regionCode === region.code ? 'selected' : '' %>><%= region.name %></option><% }) %></select></div>
                    </div>

                    <h3 class="profile-section-title"><i class="fa-solid fa-user-tie me-1"></i>مدير الحساب</h3>
                    <div class="profile-form-grid">
                        <div><label class="ws-label mb-1" for="managerName">اسم المدير</label><input id="managerName" name="managerName" class="form-control" value="<%= managerName %>" maxlength="120" required></div>
                        <div><label class="ws-label mb-1" for="managerPhone">رقم هاتف المدير</label><input id="managerPhone" name="managerPhone" class="form-control mono" value="<%= managerPhone %>" maxlength="24" inputmode="tel" placeholder="+2189XXXXXXXX" required></div>
                        <div><label class="ws-label mb-1" for="managerUsername">اسم المستخدم</label><input id="managerUsername" name="managerUsername" class="form-control mono" value="<%= manager?.webUsername || '' %>" minlength="3" maxlength="100" autocomplete="off" required></div>
                        <div><label class="ws-label mb-1" for="managerPassword"><%= manager ? 'كلمة مرور جديدة (اختيارية)' : 'كلمة مرور مدير الحساب' %></label><input id="managerPassword" name="managerPassword" type="password" class="form-control mono" minlength="10" maxlength="128" autocomplete="new-password" <%= manager ? '' : 'required' %>><small class="text-muted">لا تظهر كلمة المرور المحفوظة. ترك الحقل فارغاً يبقيها دون تغيير.</small></div>
                    </div>

                    <h3 class="profile-section-title"><i class="fa-solid fa-bell me-1"></i>الإشعارات والإيصالات</h3>
                    <div class="profile-form-grid">
                        <div><label class="ws-label mb-1" for="notificationPhone">رقم التنبيهات المهمة</label><input id="notificationPhone" name="notificationPhone" class="form-control mono" value="<%= profile.notificationPhone || '' %>" maxlength="24" inputmode="tel" placeholder="+2189XXXXXXXX"><small class="text-muted">لتنبيهات الأسعار والحالة التشغيلية.</small></div>
                        <div><label class="ws-label mb-1" for="receiptPhone">رقم استلام إيصالات العمليات</label><input id="receiptPhone" name="receiptPhone" class="form-control mono" value="<%= profile.receiptPhone || '' %>" maxlength="24" inputmode="tel" placeholder="+2189XXXXXXXX"><label class="small text-muted mt-1"><input type="checkbox" data-copy-notification-phone> استخدم رقم التنبيهات نفسه</label></div>
                    </div>
                    <div class="profile-actions"><a class="btn btn-outline-secondary" href="<%= route('overview') %>">إلغاء</a><button class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-1"></i>حفظ ملف الشركة</button></div>
                </form>
            <% } %>
        <% } %>

        <% if (section === 'security') { const apiAccessPolicy = company.apiAccessPolicy || {}; const companyApiServers = apiAccessPolicy.servers || []; const lockedApiServerId = String(apiAccessPolicy.lockedServerId || ''); const requiredMfaStaff = activeStaff.filter((item) => item.mfaRequired); const blockedStaff = (employees || []).filter((item) => item.status !== 'active'); %>
            <% if (!isMaster) { %>
                <div class="ws-card"><h2>وصول مقيّد</h2><div class="alert alert-warning mb-0">إدارة الحسابات، التحقق الإلزامي وقفل التنفيذ متاحة للمدير الرئيسي فقط.</div></div>
            <% } else { %>
                <div class="ws-card"><h2>مؤشر حماية الحسابات</h2><div class="ws-grid"><div class="ws-metric"><small>حسابات نشطة</small><strong><%= activeStaff.length %></strong></div><div class="ws-metric"><small>2FA مفعّل</small><strong class="text-success"><%= securedStaff.length %></strong></div><div class="ws-metric"><small>2FA إلزامي</small><strong class="<%= requiredMfaStaff.length ? 'text-warning' : 'text-success' %>"><%= requiredMfaStaff.length %></strong></div><div class="ws-metric"><small>حسابات موقوفة</small><strong class="<%= blockedStaff.length ? 'text-danger' : 'text-success' %>"><%= blockedStaff.length %></strong></div></div></div>

                <div class="ws-card"><h2>الحسابات والصلاحيات</h2><p class="text-muted small">اضغط على الحساب لفتح صلاحياته. عند إلزام التحقق، يُحوّل الحساب تلقائياً إلى صفحة إعداد تطبيق المصادقة عند دخوله.</p><% if ((employees || []).length) { employees.forEach((employee) => { const canTransfer = typeof employee.canTransfer === 'boolean' ? employee.canTransfer : employee.role !== 'accountant'; %><details class="security-account"><summary><div><strong><%= employee.name %></strong><div class="sub mono" dir="ltr"><%= employee.webUsername || employee.phone || '—' %></div></div><div class="d-flex gap-1 flex-wrap"><span class="badge bg-secondary"><%= employee.role %></span><span class="badge <%= employee.status === 'active' ? 'bg-success' : 'bg-dark' %>"><%= employee.status === 'active' ? 'نشط' : 'موقوف' %></span><span class="badge <%= employee.mfaEnabled ? 'bg-success' : (employee.mfaRequired ? 'bg-warning text-dark' : 'bg-secondary') %>"><%= employee.mfaEnabled ? '2FA مفعّل' : (employee.mfaRequired ? '2FA مطلوب' : '2FA اختياري') %></span></div></summary><form action="/company/<%= company._id %>/security/accounts/<%= employee._id %>" method="POST"><div class="row g-3"><div class="col-md-4"><label class="ws-label mb-1">الدور</label><select class="form-select" name="role"><option value="owner" <%= employee.role === 'owner' ? 'selected' : '' %>>مدير الشركة</option><option value="employee" <%= employee.role === 'employee' ? 'selected' : '' %>>موظف تشغيل</option><option value="accountant" <%= employee.role === 'accountant' ? 'selected' : '' %>>محاسب / تقارير</option></select></div><div class="col-md-4"><label class="ws-label mb-1">حالة الحساب</label><select class="form-select" name="status"><option value="active" <%= employee.status === 'active' ? 'selected' : '' %>>نشط</option><option value="banned" <%= employee.status !== 'active' ? 'selected' : '' %>>موقوف</option></select></div><div class="col-md-4"><label class="ws-label mb-1">آخر تحقق</label><input class="form-control" readonly value="<%= employee.mfaEnabled ? 'تطبيق المصادقة مفعّل' : 'غير مفعّل' %>"></div></div><div class="permission-list mt-3"><label class="form-check"><input class="form-check-input" type="checkbox" name="canTransfer" <%= canTransfer ? 'checked' : '' %>> <span class="form-check-label">السماح بإرسال التحويلات</span></label><label class="form-check"><input class="form-check-input" type="checkbox" name="canViewAllReports" <%= employee.canViewAllReports ? 'checked' : '' %>> <span class="form-check-label">عرض جميع التقارير</span></label><label class="form-check"><input class="form-check-input" type="checkbox" name="canManageCompany" <%= employee.canManageCompany ? 'checked' : '' %>> <span class="form-check-label">إدارة بيانات الشركة وإعداداتها</span></label><label class="form-check"><input class="form-check-input" type="checkbox" name="canCreateCompanyStaff" <%= employee.canCreateCompanyStaff ? 'checked' : '' %>> <span class="form-check-label">إضافة وإدارة موظفي الشركة</span></label><label class="form-check full"><input class="form-check-input" type="checkbox" name="mfaRequired" <%= employee.mfaRequired ? 'checked' : '' %>> <span class="form-check-label fw-bold">إلزام التحقق بخطوتين عبر تطبيق المصادقة</span></label></div><div class="d-flex justify-content-end mt-3"><button class="btn btn-primary">حفظ صلاحيات الحساب</button></div></form></details><% }) } else { %><div class="ws-empty">لا توجد حسابات موظفين لهذه الشركة.</div><% } %></div>

                <div class="ws-card"><h2>خوادم API الخاصة بالشركة</h2><p class="text-muted small">أضف عنوان الـIP العام الثابت للخادم الذي ترسل منه الشركة طلبات API. هذا ليس منفذ تنفيذ العمليات الداخلي.</p><form action="/company/<%= company._id %>/security/api-servers" method="POST" class="row g-3"><div class="col-lg-4"><label class="ws-label mb-1">اسم الخادم</label><input class="form-control" name="name" required maxlength="100" placeholder="Production API Server"></div><div class="col-lg-3"><label class="ws-label mb-1">عنوان IP العام الثابت</label><input class="form-control mono" name="sourceIp" required inputmode="url" placeholder="203.0.113.25 أو IPv6"></div><div class="col-lg-3"><label class="ws-label mb-1">رابط الخادم (اختياري)</label><input class="form-control mono" type="url" name="baseUrl" maxlength="240" placeholder="https://api.company.com"></div><div class="col-lg-2 d-flex align-items-end"><button class="btn btn-primary w-100">إضافة خادم</button></div></form></div>

                <div class="ws-card">
                    <h2>قفل مصدر Merchant API</h2>
                    <p class="text-muted small">تُكتشف عناوين IP والأجهزة تلقائياً بعد أول طلب API صالح. راجع سجل المصدر قبل قفل الحساب على مصدر واحد.</p>
                    <% if (apiAccessPolicy.mode === 'locked') { const lockedServer = companyApiServers.find((server) => String(server._id) === lockedApiServerId); %>
                        <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3 flex-wrap"><div><strong>القفل مفعل.</strong> يقبل هذا الحساب الطلبات من <span class="mono" dir="ltr"><%= lockedServer?.sourceIp || 'خادم غير صالح' %></span> فقط.</div><form action="/company/<%= company._id %>/security/api-server-lock/unlock" method="POST"><button class="btn btn-outline-danger btn-sm">إلغاء القفل</button></form></div>
                    <% } else { %>
                        <div class="alert alert-secondary small">القفل غير مفعل حالياً؛ لن يُمنع أي مصدر تلقائياً. اختر مصدراً موثوقاً من القائمة لقفل الحساب عليه.</div>
                    <% } %>
                    <% if (companyApiServers.length) { %>
                        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>المصدر / الخادم</th><th>عنوان IP</th><th>الرابط</th><th>آخر اتصال</th><th>الجهاز</th><th>الطلبات</th><th>الحالة</th><th>السجل والإجراءات</th></tr></thead><tbody>
                        <% companyApiServers.forEach((server) => { const isLocked = String(server._id) === lockedApiServerId && apiAccessPolicy.mode === 'locked'; %>
                            <tr>
                                <td><strong><%= server.name %></strong><div class="small text-muted"><%= server.discovered ? 'اكتشفه النظام تلقائياً' : `أضيف ${new Date(server.createdAt).toLocaleString('ar-EG')}` %></div></td>
                                <td class="mono" dir="ltr"><%= server.sourceIp %></td>
                                <td class="small mono" dir="ltr"><%= server.baseUrl || '—' %></td>
                                <td class="small"><%= server.lastSeenAt ? new Date(server.lastSeenAt).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli' }) : 'لم يتصل بعد' %><div class="text-muted mono" dir="ltr"><%= server.lastSeenEndpoint || '' %></div></td>
                                <td><%= server.lastDeviceLabel || 'لم يُرصد بعد' %><div class="small text-muted mono text-break" dir="ltr"><%= server.lastUserAgent || '' %></div></td>
                                <td class="mono"><%= Number(server.requestCount || 0) %></td>
                                <td><span class="badge <%= isLocked ? 'bg-warning text-dark' : 'bg-success' %>"><%= isLocked ? 'الخادم الوحيد المسموح' : (server.discovered ? 'مصدر مكتشف' : 'معتمد') %></span></td>
                                <td class="d-flex gap-1 flex-wrap"><a class="btn btn-sm btn-outline-info" target="_blank" href="/company/<%= company._id %>/security/api-servers/<%= server._id %>/activity">سجل العمليات</a><% if (!isLocked) { %><form action="/company/<%= company._id %>/security/api-servers/<%= server._id %>/lock" method="POST" onsubmit="return confirm('سيُسمح لهذا الخادم وحده بإرسال Merchant API لهذه الشركة. هل تريد المتابعة؟')"><button class="btn btn-sm btn-warning">قفل على هذا المصدر</button></form><form action="/company/<%= company._id %>/security/api-servers/<%= server._id %>/delete" method="POST" onsubmit="return confirm('حذف مصدر API؟')"><button class="btn btn-sm btn-outline-danger">حذف</button></form><% } %></td>
                            </tr>
                        <% }) %>
                        </tbody></table></div>
                    <% } else { %>
                        <div class="ws-empty">لا توجد مصادر API مرصودة بعد. ستظهر تلقائياً بعد أول طلب Merchant API صالح، أو أضف عنوان IP ثابتاً يدوياً.</div>
                    <% } %>
                </div>
            <% } %>
        <% } %>

        <% if (section === 'finance') { %>
            <div class="ws-grid mb-3"><div class="ws-metric"><small>الرصيد</small><strong><%= Number(company.balance || 0).toFixed(2) %> <small>LYD</small></strong></div><div class="ws-metric"><small>الحد الائتماني</small><strong><%= Number(company.creditLimit || 0).toFixed(2) %></strong></div><div class="ws-metric"><small>مستوى التسعير</small><strong><%= company.tier || 1 %></strong></div><div class="ws-metric"><small>نمط السعر</small><strong style="font-size:1rem"><%= companyRateConfig.mode === 'custom' ? 'خاص' : 'عام' %></strong></div></div>
            <div class="ws-card"><h2>تسوية الرصيد</h2><form action="/company/<%= company._id %>/add-balance" method="POST" class="row g-2"><div class="col-md-4"><input class="form-control" type="number" step="any" name="amount" required placeholder="المبلغ، موجب للإيداع وسالب للخصم"></div><div class="col-md-5"><input class="form-control" name="notes" placeholder="سبب التسوية"></div><div class="col-md-3"><button class="btn btn-warning w-100 fw-bold">تنفيذ التسوية</button></div></form></div>
            <div class="ws-card"><h2>إعدادات مالية الشركة</h2><div class="row g-3"><div class="col-lg-4"><form action="/company/<%= company._id %>/update-account-code" method="POST"><label class="ws-label mb-1">رقم الشركة للتحويل الداخلي</label><div class="input-group"><input class="form-control mono" name="accountCode" value="<%= company.accountCode || '' %>" inputmode="numeric" maxlength="<%= accountCodeLength %>" placeholder="<%= '0'.repeat(accountCodeLength) %>"><button class="btn btn-outline-primary">حفظ</button></div></form></div><div class="col-lg-4"><form action="/company/<%= company._id %>/update-limit" method="POST"><label class="ws-label mb-1">الحد الائتماني</label><div class="input-group"><input class="form-control mono" name="creditLimit" type="number" step="any" value="<%= company.creditLimit || 0 %>"><button class="btn btn-outline-danger">تحديث</button></div></form></div><div class="col-lg-4"><form action="/company/<%= company._id %>/change-level" method="POST"><label class="ws-label mb-1">مستوى التسعير</label><div class="input-group"><select class="form-select" name="tier"><% [1,2,3].forEach((value) => { %><option value="<%= value %>" <%= company.tier === value ? 'selected' : '' %>>المستوى <%= value %></option><% }) %></select><button class="btn btn-outline-primary">حفظ</button></div></form></div></div></div>
            <div class="ws-card"><h2>أسعار الخدمات</h2><form action="/company/<%= company._id %>/update-rate" method="POST" class="row g-2"><div class="col-md-4"><label class="ws-label">سياسة التسعير</label><select class="form-select" name="rateMode" data-rate-mode><option value="general" <%= companyRateConfig.mode === 'general' ? 'selected' : '' %>>السعر العام</option><option value="custom" <%= companyRateConfig.mode === 'custom' ? 'selected' : '' %>>سعر خاص</option></select></div><% rateServices.forEach((service) => { %><div class="col-6 col-md-4 col-xl-2"><label class="ws-label"><%= service.label %></label><input class="form-control mono" name="companyRate_<%= service.key %>" type="number" min="0.01" step="0.01" value="<%= Number(companyRateConfig.effectiveRates[service.key]).toFixed(2) %>" data-rate-input <%= companyRateConfig.mode === 'general' ? 'disabled' : '' %>></div><% }) %><div class="col-12"><button class="btn btn-primary">حفظ أسعار الشركة</button></div></form></div>
            <div class="ws-card"><h2>آخر حركات دفتر الأستاذ</h2><% if ((ledgerEntries || []).length) { %><div class="table-responsive"><table class="table table-sm"><thead><tr><th>المرجع</th><th>النوع</th><th>الأثر</th><th>الرصيد بعده</th><th>التاريخ</th></tr></thead><tbody><% ledgerEntries.forEach((entry) => { %><tr><td class="mono"><%= entry.transactionId %></td><td><%= entry.type %></td><td class="mono"><%= Number(entry.amount || 0).toFixed(2) %></td><td class="mono"><%= Number(entry.balanceAfter || 0).toFixed(2) %></td><td><%= new Date(entry.createdAt).toLocaleString('ar-EG') %></td></tr><% }) %></tbody></table></div><% } else { %><div class="ws-empty">لا توجد حركات مالية بعد.</div><% } %></div>
        <% } %>

        <% if (section === 'operations') { %>
            <div class="ws-card"><h2>آخر 50 عملية</h2><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>المرجع</th><th>المستلم</th><th>المبلغ</th><th>الخدمة</th><th>الحالة</th><th>الوقت</th><th></th></tr></thead><tbody><% if (!(transactions || []).length) { %><tr><td colspan="7" class="ws-empty">لا توجد عمليات.</td></tr><% } %><% (transactions || []).forEach((tx) => { %><tr><td class="mono"><%= tx.customId || String(tx._id).slice(-8) %></td><td class="mono"><%= tx.vodafoneNumber || '—' %></td><td class="mono"><%= Number(tx.amount || 0).toFixed(2) %> <small>EGP</small></td><td><%= tx.transferType || 'vodafone' %></td><td><span class="badge <%= tx.status === 'completed' ? 'bg-success' : (['rejected','failed','cancelled_by_admin'].includes(tx.status) ? 'bg-danger' : 'bg-warning text-dark') %>"><%= tx.status %></span></td><td class="small"><%= new Date(tx.updatedAt).toLocaleString('ar-EG') %></td><td><% if (tx.isApiReview || tx.apiResultData) { %><a class="btn btn-sm btn-outline-primary" target="_blank" href="/company/<%= company._id %>/api-communication/<%= tx._id %>">سجل API</a><% } %></td></tr><% }) %></tbody></table></div></div>
        <% } %>

        <% if (section === 'api' && !isMaster) { %>
            <div class="ws-card"><h2>وصول مقيّد</h2><div class="alert alert-warning mb-0">قسم API والتكامل يحتوي على مفاتيح وربط تشغيلي حساس، وهو متاح لحساب المدير الرئيسي فقط.</div></div>
        <% } %>

        <% if (section === 'api' && isMaster) { const policy = company.autoRoutePolicy || {}; %>
            <div class="ws-card"><h2>مفتاح وربط API</h2><div class="alert alert-warning small">المفتاح حساس. لا يظهر إلا للإدارة، ويجب إرساله إلى الشركة عبر قناة آمنة فقط.</div><code class="d-block p-3 rounded bg-dark text-light text-break mono" style="filter:blur(4px)" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='blur(4px)'"><%= company.token || 'سيتم إنشاؤه عند تنزيل الوثيقة' %></code><div class="d-flex flex-wrap gap-2 mt-3"><a class="btn btn-outline-primary" href="/company/<%= company._id %>/integration-guide.pdf">وثيقة الربط</a><a class="btn btn-outline-secondary" href="/company/<%= company._id %>/sandbox-api-guide.pdf">وثيقة الاختبار</a><form action="/company/<%= company._id %>/rotate-api-token" method="POST" onsubmit="return confirm('سيتم إلغاء المفتاح الحالي فوراً. هل تريد المتابعة؟')"><button class="btn btn-outline-danger">تدوير المفتاح</button></form></div></div>
            <div class="ws-card"><h2>توجيه الشركة إلى منفذ واحد</h2><form action="/company/<%= company._id %>/auto-route-policy" method="POST" class="row g-2 align-items-end"><div class="col-md-2"><label class="form-check-label"><input class="form-check-input" type="checkbox" name="enabled" <%= policy.enabled ? 'checked' : '' %>> تفعيل</label></div><div class="col-md-5"><label class="ws-label">المنفذ</label><select class="form-select" name="executorGroupId" <%= policy.enabled ? 'required' : '' %>><option value="">اختر منفذًا</option><% (executorGroups || []).forEach((executor) => { %><option value="<%= executor._id %>" <%= String(policy.executorGroupId || '') === String(executor._id) ? 'selected' : '' %>><%= executor.name %> — <%= executor.serviceKey %></option><% }) %></select></div><div class="col-md-3"><label class="ws-label">حد التوجيه الآلي EGP</label><input class="form-control mono" type="number" min="1" name="maxAutoAmount" value="<%= policy.maxAutoAmount || '' %>" <%= policy.enabled ? 'required' : '' %>></div><div class="col-md-2"><button class="btn btn-primary w-100">حفظ</button></div></form><p class="small text-muted mt-3 mb-0">ما يزيد عن الحد يبقى معلّقاً للمراجعة اليدوية ولا يعود للتوجيه العام.</p></div>
        <% } %>

        <% if (section === 'webhooks' && !isMaster) { %>
            <div class="ws-card"><h2>وصول مقيّد</h2><div class="alert alert-warning mb-0">إدارة روابط Webhook وعرض عناوين الشركاء متاحان لحساب المدير الرئيسي فقط.</div></div>
        <% } %>

        <% if (section === 'webhooks' && isMaster) { %>
            <div class="ws-card"><h2>إضافة رابط Webhook</h2><form data-webhook-form data-company-id="<%= company._id %>" class="row g-2"><div class="col-lg-6"><input class="form-control" type="url" name="url" required placeholder="https://partner.example.com/webhooks/ahrampay" dir="ltr"></div><div class="col-lg-4 d-flex flex-wrap gap-2 align-items-center small"><% webhookEvents.forEach((eventName) => { %><label><input type="checkbox" name="events" value="<%= eventName %>" checked> <span dir="ltr"><%= eventName.replace('transaction.','') %></span></label><% }) %></div><div class="col-lg-2"><button class="btn btn-success w-100">إضافة</button></div></form><div data-webhook-result class="small mt-3"></div></div><div class="ws-card"><h2>روابط الشركة الحالية</h2><% if ((webhookSubscriptions || []).length) { %><div class="table-responsive"><table class="table align-middle"><thead><tr><th>العنوان</th><th>الأحداث</th><th>الحالة</th><th>آخر تسليم</th><th></th></tr></thead><tbody><% webhookSubscriptions.forEach((item) => { %><tr><td class="mono small text-break" dir="ltr"><%= item.url %></td><td class="small" dir="ltr"><%= item.events.join(', ') %></td><td><span class="badge <%= item.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= item.status %></span></td><td class="small"><%= item.lastDeliveredAt ? new Date(item.lastDeliveredAt).toLocaleString('ar-EG') : '—' %></td><td class="d-flex gap-1"><a class="btn btn-sm btn-outline-secondary" href="/company/<%= company._id %>/webhooks/<%= item._id %>/deliveries" target="_blank">السجل</a><form action="/company/<%= company._id %>/webhooks/<%= item._id %>/delete" method="POST" onsubmit="return confirm('حذف هذا الرابط نهائياً؟')"><button class="btn btn-sm btn-outline-danger">حذف</button></form></td></tr><% }) %></tbody></table></div><% } else { %><div class="ws-empty">لا توجد روابط مفعلة.</div><% } %></div>
        <% } %>

        <% if (section === 'reports') { %>
            <div class="ws-grid mb-3"><div class="ws-metric"><small>إجمالي العمليات</small><strong><%= total %></strong></div><div class="ws-metric"><small>منفذة بنجاح</small><strong class="text-success"><%= completed %></strong></div><div class="ws-metric"><small>حجم التحويلات</small><strong><%= Number(txMetrics.transferVolumeEGP || 0).toFixed(0) %> <small>EGP</small></strong></div><div class="ws-metric"><small>تكلفة العمليات</small><strong><%= Number(txMetrics.costVolumeLYD || 0).toFixed(2) %> <small>LYD</small></strong></div></div><div class="ws-card"><h2>جودة التكامل التقني</h2><div class="ws-definition"><div><span class="ws-label">سجلات API الكلية</span><span class="ws-value mono"><%= Number(apiSummary.total || 0) %></span></div><div><span class="ws-label">سجلات API الناجحة</span><span class="ws-value mono text-success"><%= Number(apiSummary.success || 0) %></span></div><div><span class="ws-label">طلبات API المعلقة</span><span class="ws-value mono text-warning"><%= Number(apiSummary.pending || 0) %></span></div><div><span class="ws-label">طلبات API الفاشلة</span><span class="ws-value mono <%= Number(apiSummary.failed || 0) ? 'text-danger' : 'text-success' %>"><%= Number(apiSummary.failed || 0) %></span></div></div></div>
        <% } %>

        <% if (section === 'audit') { %>
            <div class="ws-card"><h2>آخر أحداث التدقيق</h2><% if ((auditEntries || []).length) { auditEntries.forEach((entry) => { %><div class="ws-section-row"><div><strong><i class="fa-solid <%= entry.severity === 'critical' ? 'fa-triangle-exclamation text-danger' : (entry.severity === 'warning' ? 'fa-shield-halved text-warning' : 'fa-circle-info text-info') %> me-1"></i><%= entry.action || 'حدث تشغيلي' %></strong><div class="sub">بواسطة <%= entry.performedByName || 'النظام' %><% if (entry.endpoint) { %> · <span dir="ltr"><%= entry.endpoint %></span><% } %></div></div><div class="text-end"><span class="badge <%= entry.result === 'فاشل' || entry.result === 'محظور' ? 'bg-danger' : 'bg-success' %>"><%= entry.result || 'ناجح' %></span><div class="sub mono"><%= new Date(entry.createdAt).toLocaleString('en-GB') %></div></div></div><% }) } else { %><div class="ws-empty">لا توجد سجلات تدقيق ظاهرة لهذه الشركة.</div><% } %></div>
        <% } %>
    </section>
</div></main>
<script>
document.querySelector('[data-logo-input]')?.addEventListener('change', (event) => { const file=event.target.files?.[0]; if(!file) return; const preview=document.querySelector('[data-logo-preview]'); const placeholder=document.querySelector('[data-logo-placeholder]'); if(preview) { preview.src=URL.createObjectURL(file); preview.classList.remove('d-none'); } placeholder?.classList.add('d-none'); });
document.querySelector('[data-copy-notification-phone]')?.addEventListener('change', (event) => { if(event.target.checked) document.getElementById('receiptPhone').value=document.getElementById('notificationPhone').value; });
document.querySelectorAll('[data-webhook-form]').forEach((form) => form.addEventListener('submit', async (event) => { event.preventDefault(); const result=form.querySelector('[data-webhook-result]'); const data=new FormData(form); result.textContent='جارٍ الحفظ والتحقق من الرابط...'; try { const response=await fetch(`/company/${form.dataset.companyId}/webhooks`,{method:'POST',headers:{'Content-Type':'application/json','x-csrf-token':data.get('_csrf')||''},body:JSON.stringify({url:data.get('url'),events:data.getAll('events')})}); const payload=await response.json(); if(!response.ok) throw new Error(payload.error||'تعذر إنشاء القناة.'); result.className='small mt-3 text-success fw-bold'; result.textContent=`تم الإنشاء. مفتاح التوقيع (انسخه الآن): ${payload.signing_secret}`; setTimeout(()=>location.reload(),7000); } catch(error) { result.className='small mt-3 text-danger fw-bold'; result.textContent=error.message; } }));
document.querySelectorAll('[data-rate-mode]').forEach((mode) => { const sync=()=>document.querySelectorAll('[data-rate-input]').forEach((input)=>{ input.disabled=mode.value !== 'custom'; }); mode.addEventListener('change',sync); sync(); });
</script>
</body></html>
