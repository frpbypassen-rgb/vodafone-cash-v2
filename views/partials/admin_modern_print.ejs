<!-- Self-contained so PDF renderers need no authenticated asset requests. -->
<style>
    body {font-family:'Segoe UI',Tahoma,Arial,sans-serif;color:#182234;background:#fff;print-color-adjust:exact;-webkit-print-color-adjust:exact}
    .header,.report-head {border-bottom-color:#265ed7!important}
    .header h1,.header h2,.header h3,.brand {color:#265ed7!important}
    table {border-collapse:collapse}
    thead th {background:#eaf0ff!important;color:#265ed7!important;border-color:#e2e7ef!important}
    tbody td {border-color:#e2e7ef!important}
    .summary-box,.summary-card,.summary {border-color:#e2e7ef!important;background:#f7f8fb!important;border-radius:12px}
    .summary-item {border-color:#e2e7ef!important}
    @media print {a,button,.no-print {display:none!important}body {margin:0;background:white!important;color:#182234!important}}
</style>
