<script>
(() => {
    document.documentElement.classList.add('admin-modern');
    let theme = 'light';
    try { theme = localStorage.getItem('ahram_theme') || theme; } catch (_) { /* Private browsing may block storage. */ }
    document.documentElement.setAttribute('data-theme', theme);
    document.documentElement.setAttribute('data-bs-theme', theme);
})();
</script>
<link rel="stylesheet" href="/css/admin-modern.css?v=20261024-1">
<script src="/js/admin-modern.js?v=20261024-1" defer></script>
