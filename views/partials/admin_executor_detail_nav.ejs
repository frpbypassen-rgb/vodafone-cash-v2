<%
const detailSections = [
    {key:'deposits', icon:'fa-wallet', hint:'إيداع وسجل'},
    {key:'operations', icon:'fa-arrow-right-arrow-left', hint:'بحث ومتابعة'},
    {key:'ledger', icon:'fa-receipt', hint:'حركة الرصيد'},
    {key:'staff', icon:'fa-users', hint:'حسابات الفريق'},
    {key:'settings', icon:'fa-sliders', hint:'الضبط والصلاحيات'}
];
%>
<nav class="am-detail-tabs" aria-label="أقسام ملف المنفذ">
    <% detailSections.forEach(section => { %>
    <a href="<%= detailUrl(section.key) %>" <%= history.filters.tab === section.key ? 'aria-current=page' : '' %>>
        <i class="fa-solid <%= section.icon %>" aria-hidden="true"></i>
        <span><strong><%= detailLabels[section.key] %></strong><small><%= section.hint %></small></span>
    </a>
    <% }); %>
</nav>
