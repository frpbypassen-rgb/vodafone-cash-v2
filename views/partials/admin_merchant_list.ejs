<%
const companyList = activeSection === 'companies';
const directList = activeSection === 'users';
const rows = companyList ? companies : directList ? users : agents;
const type = companyList ? 'company' : directList ? 'user' : 'agent';
const path = companyList ? '/company/' : '/user/';
const label = companyList ? 'شركة' : directList ? 'عميل مباشر' : 'وكيل';
const icon = companyList ? 'fa-building' : directList ? 'fa-user' : 'fa-user-tie';
%>
<div class="am-account-grid" data-merchant-list role="list" aria-label="<%= companyList ? 'الشركات' : directList ? 'العملاء المباشرون' : 'الوكلاء' %>">
    <% if (!rows.length) { %>
    <div class="am-directory-empty" role="status"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><h2>لا توجد حسابات مطابقة</h2><p>جرّب تغيير البحث أو حالة الحساب.</p><a class="am-button" href="/clients?section=<%= activeSection %>" data-directory-nav>عرض جميع الحسابات</a></div>
    <% } %>
    <% rows.forEach(account => { const balance = Number(account.balance || 0); const url = path + account._id; const code = account.accountCode || account.agentCode; %>
    <article class="am-account-card is-<%= type %>" role="listitem" aria-label="<%= label %>: <%= account.name %>">
        <header class="am-card-heading">
            <span class="am-card-avatar"><i class="fa-solid <%= icon %>" aria-hidden="true"></i></span>
            <div class="am-card-identity"><h2><a href="<%= url %>"><%= account.name || 'حساب بدون اسم' %></a></h2><span><%= label %> · مستوى <%= account.tier || 1 %></span></div>
            <span class="am-status <%= account.status === 'active' ? 'is-active' : '' %>"><i class="fa-solid <%= account.status === 'active' ? 'fa-circle-check' : 'fa-circle-pause' %>" aria-hidden="true"></i> <%= account.status === 'active' ? 'نشط' : 'متوقف' %></span>
        </header>
        <div class="am-card-balance"><span>الرصيد المتاح</span><strong class="<%= balance > 0 ? 'am-positive' : balance < 0 ? 'am-negative' : '' %>"><bdi><%= balance.toLocaleString('en-US', {minimumFractionDigits:3, maximumFractionDigits:3}) %></bdi> <small>د.ل</small></strong></div>
        <dl class="am-card-info">
            <div><dt>رقم الحساب</dt><dd><bdi><%= code || '—' %></bdi><% if(code) { %><button class="am-copy-code" type="button" data-copy-code="<%= code %>" aria-label="نسخ رقم حساب <%= account.name %>"><i class="fa-regular fa-copy" aria-hidden="true"></i></button><% } %></dd></div>
            <div><dt>الهاتف</dt><dd><% if(account.phone && /^\+?\d+$/.test(account.phone)) { %><a href="tel:<%= account.phone %>"><bdi><%= account.phone %></bdi></a><% } else { %>—<% } %></dd></div>
            <div><dt>المدينة</dt><dd><%= account.businessProfile && account.businessProfile.city || '—' %></dd></div>
        </dl>
        <footer class="am-card-footer">
            <a class="am-card-open" href="<%= url %>">عرض الحساب <i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a>
            <% if(isMaster) { %><a class="am-card-finance" href="<%= url %><%= directList ? '#account-balance' : '?tab=finance#balance' %>">إيداع / خصم</a><% } %>
            <details class="am-actions"><summary aria-label="إجراءات <%= account.name %>">⋮</summary><div>
                <a href="<%= url %><%= directList ? '' : '?tab=ledger' %>">السجل المالي</a>
                <% if(!directList) { %><a href="<%= url %>?tab=staff">الموظفون</a><% } %>
                <% if(isMaster) { %><a href="/admin/accounts/<%= type %>/<%= account._id %>/edit">تعديل البيانات</a><% if(!directList) { %><a href="<%= url %>?tab=settings">إعدادات البوابة</a><a href="<%= url %>/sandbox-api-guide.pdf">تحميل ملف اختبار API</a><% } %><% } %>
            </div></details>
        </footer>
    </article>
    <% }); %>
</div>
<span class="am-sr-only" role="status" aria-live="polite" data-directory-feedback></span>
