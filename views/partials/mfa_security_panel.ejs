<% const compactMfaPanel = locals.retailSecurity || typeof workspace !== 'undefined' && (workspace.isCompany || workspace.isAgent); %>
<section class="mfa-security-panel<%= compactMfaPanel ? ' mfa-compact' : '' %>" data-mfa-panel data-mfa-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="mfa-panel-heading">
        <div>
            <% if (compactMfaPanel) { %>
            <h2><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> التحقق الثنائي</h2>
            <% } else { %><span class="mfa-kicker"><i class="fa-solid fa-shield-halved"></i> أمان الحساب</span><h2>حماية الحساب الاختيارية</h2><% } %>
        </div>
        <span class="mfa-state" data-mfa-state role="status" aria-live="polite">جارٍ الفحص</span>
    </div>

    <p class="mfa-description">أضف رمزًا من تطبيق <b dir="ltr">Authenticator</b> لحماية تسجيل الدخول.</p>
    <% if (compactMfaPanel) { %>
    <p class="mfa-login-summary"><span>عند الدخول:</span> <strong data-mfa-login-rule>جارٍ الفحص</strong></p>
    <% } else { %><div class="mfa-device-summary">
        <div><span>حالة Authenticator</span><strong data-mfa-enabled>جاري الفحص</strong></div>
        <div><span>عند تسجيل الدخول</span><strong data-mfa-login-rule>جاري الفحص</strong></div>
    </div><% } %>

    <div class="mfa-message" data-mfa-message role="status" aria-live="polite" hidden></div>

    <div class="mfa-actions">
        <button type="button" class="mfa-button primary" data-mfa-start>
            <i class="fa-solid fa-lock"></i> تفعيل Authenticator
        </button>
        <% if (compactMfaPanel) { %>
        <button type="button" class="mfa-button primary" data-mfa-manage aria-expanded="false" aria-controls="mfaAccountManagement" hidden><i class="fa-solid fa-sliders" aria-hidden="true"></i> إدارة التحقق الثنائي</button>
        <% } else { %>
        <button type="button" class="mfa-button danger" data-mfa-disable hidden>
            <i class="fa-solid fa-shield-slash"></i> إيقاف الحماية
        </button>
        <a class="mfa-button" href="/security/sessions">
            <i class="fa-solid fa-display"></i> الأجهزة والجلسات
        </a>
        <% } %>
    </div>
    <% if (compactMfaPanel) { %>
    <div class="mfa-management" id="mfaAccountManagement" data-mfa-management hidden>
        <p>لإيقاف الحماية، ستحتاج رمز التطبيق أو أحد رموز الاسترداد.</p>
        <button type="button" class="mfa-button danger" data-mfa-disable hidden><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> إيقاف الحماية</button>
    </div>
    <% } %>

    <div class="mfa-setup" data-mfa-setup hidden>
        <ol class="mfa-steps" aria-label="خطوات التفعيل"><li data-mfa-step-label="1" aria-current="step"><span>1</span> إضافة الحساب</li><li data-mfa-step-label="2"><span>2</span> تأكيد الرمز</li></ol>
        <div data-mfa-add-step>
            <h3 class="mfa-step-title">أضف الحساب إلى تطبيق المصادقة</h3>
            <p class="mfa-help">اختر طريقة واحدة فقط. لن تتفعل الحماية حتى تأكيد الرمز.</p>
            <a class="mfa-button primary mfa-wide" data-mfa-open-app referrerpolicy="no-referrer"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> فتح تطبيق المصادقة</a>
            <p class="mfa-help">إن لم يفتح التطبيق، استخدم QR أو الإضافة اليدوية أدناه.</p>
            <div class="mfa-methods">
                <details data-mfa-method><summary>مسح رمز QR <span>من جهاز آخر</span></summary><div class="mfa-qr"><img data-mfa-qr-image alt="امسح الرمز بتطبيق المصادقة لإضافة الحساب" width="216" height="216"></div></details>
                <details data-mfa-method><summary>إضافة يدوية</summary><div class="mfa-secret-label">اسم الحساب</div><div class="mfa-account-label" data-mfa-account-label></div><div class="mfa-secret-label">نوع الحساب: حسب الوقت (TOTP)</div><div class="mfa-secret-row"><code data-mfa-secret></code><button type="button" data-mfa-copy-secret aria-label="نسخ مفتاح الإعداد"><i class="fa-regular fa-copy" aria-hidden="true"></i></button></div></details>
            </div>
            <div class="mfa-actions mfa-step-actions"><button type="button" class="mfa-button primary mfa-wide" data-mfa-next>أضفت الحساب — متابعة</button><button type="button" class="mfa-button mfa-wide" data-mfa-cancel>إلغاء الإعداد</button></div>
        </div>
        <div data-mfa-confirm-step hidden>
            <h3 class="mfa-step-title">أدخل رمز التطبيق</h3>
            <p class="mfa-help">افتح التطبيق واكتب الرمز الحالي من 6 أرقام، ثم ارجع هنا للتأكيد.</p>
            <div class="mfa-confirm-row"><input type="text" inputmode="numeric" maxlength="32" autocomplete="one-time-code" aria-label="رمز Authenticator المكون من 6 أرقام" data-mfa-confirm-token placeholder="000000"><button type="button" class="mfa-button primary" data-mfa-confirm>تأكيد التفعيل</button></div>
            <button type="button" class="mfa-button mfa-wide mfa-step-actions" data-mfa-back>الرجوع لطريقة الإضافة</button>
        </div>
    </div>
    <div class="mfa-setup" data-mfa-recovery-step hidden>
        <h3 class="mfa-step-title">تم تفعيل الحماية</h3>
        <p class="mfa-help">احفظ رموز الاسترداد في مكان آمن قبل الإغلاق. ستحتاجها عند فقدان هاتفك، ويُستخدم كل رمز مرة واحدة.</p>
        <label class="mfa-secret-label">رموز الاسترداد<textarea class="mfa-recovery-codes" data-mfa-recovery readonly rows="8" dir="ltr" autocomplete="off"></textarea></label>
        <div class="mfa-actions"><button type="button" class="mfa-button" data-mfa-copy-recovery>نسخ الرموز</button><button type="button" class="mfa-button" data-mfa-download-recovery>تنزيل الرموز</button></div>
        <button type="button" class="mfa-button primary mfa-wide mfa-step-actions" data-mfa-finish>حفظت الرموز — إنهاء</button>
    </div>
</section>

<style>
    .mfa-security-panel {
        --mfa-bg: var(--bw-surface, #fff); --mfa-soft: var(--bw-surface-soft, #f8fafc);
        --mfa-line: var(--bw-border, #dce5f3); --mfa-ink: var(--bw-text, #0f172a); --mfa-muted: var(--bw-muted, #52647d);
        --mfa-ready: #047857; --mfa-ready-bg: #dcfce7; --mfa-warn: #92400e; --mfa-warn-bg: #fef3c7;
        --mfa-error: #b91c1c; --mfa-error-bg: #fef2f2; --mfa-info: #1d4ed8; --mfa-info-bg: #eff6ff;
        min-width: 0; padding: 18px; border: 1px solid var(--mfa-line); border-radius: 16px;
        color: var(--mfa-ink); background: var(--mfa-bg);
    }
    :is([data-theme="dark"], [data-theme="night"]) .mfa-security-panel {
        --mfa-bg: var(--bw-surface, #182333); --mfa-soft: var(--bw-surface-soft, #202d3e);
        --mfa-line: var(--bw-border, #34465b); --mfa-ink: var(--bw-text, #f3f7fb); --mfa-muted: var(--bw-muted, #b2c2d5);
        --mfa-ready: #86efac; --mfa-ready-bg: #173c30; --mfa-warn: #fcd68d; --mfa-warn-bg: #40331c;
        --mfa-error: #ffb0b7; --mfa-error-bg: #44242e; --mfa-info: #b8d4ff; --mfa-info-bg: #1a3153;
    }
    .mfa-security-panel [hidden] { display: none !important; }
    .mfa-security-panel[data-mfa-progress="true"] :is(.mfa-description, .mfa-login-summary, .mfa-device-summary) { display: none; }
    .mfa-security-panel :is(button, a, summary, input, textarea) { scroll-margin-block: 100px; }
    .mfa-panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .mfa-panel-heading > div { min-width: 0; }
    .mfa-kicker { display: block; margin-bottom: 5px; color: var(--mfa-info); font-size: 12px; font-weight: 700; }
    .mfa-panel-heading h2 { margin: 0; color: var(--mfa-ink); font-size: 16px; line-height: 1.5; font-weight: 800; }
    .mfa-panel-heading h2 i { color: var(--mfa-info); margin-inline-end: 4px; }
    .mfa-description, .mfa-management p { margin: 10px 0; color: var(--mfa-muted); font-size: 13px; line-height: 1.7; }
    .mfa-state { flex: 0 0 auto; padding: 5px 9px; border-radius: 999px; color: var(--mfa-muted); background: var(--mfa-soft); font-size: 11px; font-weight: 700; }
    .mfa-state.ready { color: var(--mfa-ready); background: var(--mfa-ready-bg); }
    .mfa-state.warn { color: var(--mfa-warn); background: var(--mfa-warn-bg); }
    .mfa-device-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 16px 0; }
    .mfa-device-summary > div { padding: 12px; border: 1px solid var(--mfa-line); border-radius: 10px; background: var(--mfa-soft); }
    .mfa-device-summary span, .mfa-device-summary strong { display: block; }
    .mfa-device-summary span { color: var(--mfa-muted); font-size: 12px; }
    .mfa-device-summary strong { margin-top: 5px; color: var(--mfa-ink); font-size: 13px; }
    .mfa-login-summary { display: flex; flex-wrap: wrap; gap: 4px; margin: 12px 0; color: var(--mfa-muted); font-size: 12px; line-height: 1.7; }
    .mfa-login-summary strong { color: var(--mfa-ink); font-weight: 600; }
    .mfa-actions, .mfa-confirm-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .mfa-button { min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 9px 12px; border: 1px solid var(--mfa-line); border-radius: 10px; color: var(--mfa-ink); background: var(--mfa-soft); font: inherit; font-weight: 700; font-size: 13px; cursor: pointer; text-decoration: none; }
    .mfa-button.primary { color: #fff; border-color: #2563eb; background: #2563eb; }
    .mfa-button.danger { color: var(--mfa-error); border-color: var(--mfa-error); background: transparent; }
    .mfa-button:disabled { opacity: .55; cursor: wait; }
    .mfa-security-panel :is(button, input):focus-visible { outline: 3px solid var(--mfa-info); outline-offset: 3px; }
    .mfa-compact .mfa-actions > .mfa-button { width: 100%; }
    .mfa-management { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--mfa-line); }
    .mfa-message { margin: 12px 0; padding: 10px 12px; border-radius: 9px; color: var(--mfa-info); background: var(--mfa-info-bg); font-size: 12px; line-height: 1.7; }
    .mfa-message.error { color: var(--mfa-error); background: var(--mfa-error-bg); }
    .mfa-setup { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--mfa-line); min-width: 0; }
    .mfa-qr { width: min(100%, 216px); margin: 0 auto 10px; background: #fff; border-radius: 8px; }
    .mfa-qr img { display: block; width: 100%; height: auto; }
    .mfa-steps { display: flex; gap: 8px; padding: 0; margin: 0 0 16px; list-style: none; }
    .mfa-steps li { flex: 1; color: var(--mfa-muted); font-size: 12px; line-height: 1.8; }
    .mfa-steps li[aria-current="step"] { color: var(--mfa-info); font-weight: 700; }
    .mfa-steps li span { display: inline-flex; justify-content: center; align-items: center; width: 24px; height: 24px; border: 1px solid var(--mfa-line); border-radius: 50%; }
    .mfa-step-title { margin: 0; color: var(--mfa-ink); font-size: 14px; line-height: 1.6; }
    .mfa-help { color: var(--mfa-muted); font-size: 12px; line-height: 1.8; margin: 8px 0 12px; }
    .mfa-wide { width: 100%; }
    .mfa-step-actions { margin-top: 12px; }
    .mfa-methods { display: grid; gap: 8px; }
    .mfa-methods details { border: 1px solid var(--mfa-line); border-radius: 10px; padding: 0 12px; }
    .mfa-methods summary { min-height: 44px; line-height: 44px; cursor: pointer; color: var(--mfa-ink); font-size: 13px; }
    .mfa-methods summary span { font-size: 11px; color: var(--mfa-muted); }
    .mfa-methods details[open] { padding-bottom: 12px; }
    .mfa-account-label { overflow-wrap: anywhere; color: var(--mfa-ink); font-size: 13px; }
    .mfa-recovery-codes { box-sizing: border-box; display: block; width: 100%; margin-top: 8px; padding: 10px; border: 1px solid var(--mfa-line); border-radius: 10px; color: var(--mfa-ink); background: var(--mfa-soft); font: 14px/1.8 monospace; text-align: center; }
    .mfa-notice { display: grid; gap: 4px; padding: 11px 12px; margin-bottom: 14px; border-radius: 9px; color: var(--mfa-warn); background: var(--mfa-warn-bg); font-size: 12px; line-height: 1.7; }
    .mfa-secret-label { display: block; margin: 9px 0 5px; color: var(--mfa-muted); font-size: 12px; font-weight: 700; }
    .mfa-secret-row, .mfa-uri-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .mfa-secret-row code, .mfa-uri-row code { min-width: 0; flex: 1; overflow: auto; padding: 9px 10px; border: 1px solid var(--mfa-line); border-radius: 8px; color: var(--mfa-ink); background: var(--mfa-soft); direction: ltr; font-size: 12px; white-space: nowrap; }
    .mfa-secret-row button, .mfa-uri-row button { flex: 0 0 44px; width: 44px; height: 44px; border: 1px solid var(--mfa-line); border-radius: 8px; color: var(--mfa-info); background: var(--mfa-soft); cursor: pointer; }
    .mfa-recovery-box { margin: 14px 0; padding: 12px; border: 1px dashed var(--mfa-line); border-radius: 9px; background: var(--mfa-soft); }
    .mfa-recovery-box > strong { display: block; margin-bottom: 8px; color: var(--mfa-ink); font-size: 12px; }
    .mfa-recovery-box > div { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; direction: ltr; }
    .mfa-recovery-box code { padding: 5px; overflow-wrap: anywhere; color: var(--mfa-ink); background: var(--mfa-bg); border-radius: 5px; text-align: center; font-size: 12px; }
    .mfa-confirm-row input { box-sizing: border-box; min-width: 0; min-height: 44px; flex: 1; padding: 9px 10px; border: 1px solid var(--mfa-line); border-radius: 9px; color: var(--mfa-ink); background: var(--mfa-soft); direction: ltr; text-align: center; font-size: 16px; }
    @media (max-width: 620px) {
        .mfa-security-panel { padding: 14px; }
        .mfa-panel-heading h2 { font-size: 15px; }
        .mfa-device-summary { grid-template-columns: 1fr; }
        .mfa-recovery-box > div { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .mfa-confirm-row input, .mfa-confirm-row .mfa-button { width: 100%; flex-basis: 100%; }
    }
</style>

<script src="/js/mfa-enrollment.js?v=20261027-steps" defer></script>
