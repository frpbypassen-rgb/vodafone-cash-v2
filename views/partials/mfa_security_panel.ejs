<section class="mfa-security-panel" data-mfa-panel>
    <div class="mfa-panel-heading">
        <div>
            <span class="mfa-kicker"><i class="fa-solid fa-shield-halved"></i> أمان الحساب</span>
            <h2>حماية الحساب الاختيارية</h2>
            <p>أداة الحماية المتاحة لهذا الحساب هي <b>Authenticator</b>. تفعيلها اختياري، وعند تفعيلها يُطلب الرمز عند كل دخول.</p>
        </div>
        <span class="mfa-state" data-mfa-state>جاري الفحص</span>
    </div>

    <div class="mfa-device-summary">
        <div><span>حالة Authenticator</span><strong data-mfa-enabled>جاري الفحص</strong></div>
        <div><span>عند تسجيل الدخول</span><strong data-mfa-login-rule>جاري الفحص</strong></div>
    </div>

    <div class="mfa-message" data-mfa-message hidden></div>

    <div class="mfa-actions">
        <button type="button" class="mfa-button primary" data-mfa-start>
            <i class="fa-solid fa-lock"></i> تفعيل Authenticator
        </button>
        <button type="button" class="mfa-button danger" data-mfa-disable hidden>
            <i class="fa-solid fa-shield-slash"></i> إيقاف الحماية
        </button>
        <a class="mfa-button" href="/security/sessions">
            <i class="fa-solid fa-display"></i> الأجهزة والجلسات
        </a>
    </div>

    <div class="mfa-setup" data-mfa-setup hidden>
        <div class="mfa-notice">
            <strong>احفظ بيانات الاسترداد قبل المتابعة</strong>
            <span>أضف المفتاح يدويًا في Google Authenticator أو Microsoft Authenticator. هذه البيانات تظهر أثناء الإعداد فقط.</span>
        </div>
        <label class="mfa-secret-label">مفتاح الإعداد</label>
        <div class="mfa-secret-row"><code data-mfa-secret></code><button type="button" data-mfa-copy-secret title="نسخ"><i class="fa-regular fa-copy"></i></button></div>
        <label class="mfa-secret-label">رابط الإعداد</label>
        <div class="mfa-uri-row"><code data-mfa-uri></code><button type="button" data-mfa-copy-uri title="نسخ"><i class="fa-regular fa-copy"></i></button></div>
        <div class="mfa-recovery-box"><strong>رموز الاسترداد</strong><div data-mfa-recovery></div></div>
        <div class="mfa-confirm-row">
            <input type="text" inputmode="numeric" maxlength="6" data-mfa-confirm-token placeholder="رمز Authenticator المكون من 6 أرقام">
            <button type="button" class="mfa-button primary" data-mfa-confirm>تأكيد التفعيل</button>
        </div>
    </div>
</section>

<style>
    .mfa-security-panel { padding: 20px; border: 1px solid color-mix(in srgb, #2563eb 18%, #cbd5e1); border-radius: 14px; background: color-mix(in srgb, #fff 92%, #eff6ff); box-shadow: 0 12px 30px rgba(15, 23, 42, .06); }
    .mfa-panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }
    .mfa-kicker { display: block; margin-bottom: 5px; color: #2563eb; font-size: .76rem; font-weight: 900; }
    .mfa-panel-heading h2 { margin: 0; color: #0f172a; font-size: 1.06rem; font-weight: 900; }
    .mfa-panel-heading p { margin: 7px 0 0; color: #64748b; font-size: .78rem; line-height: 1.6; }
    .mfa-state { flex: 0 0 auto; padding: 6px 10px; border-radius: 999px; color: #64748b; background: #f1f5f9; font-size: .72rem; font-weight: 900; }
    .mfa-state.ready { color: #047857; background: #d1fae5; }
    .mfa-state.warn { color: #b45309; background: #fef3c7; }
    .mfa-device-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 18px 0 14px; }
    .mfa-device-summary > div { padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; background: rgba(255,255,255,.72); }
    .mfa-device-summary span, .mfa-device-summary strong { display: block; }
    .mfa-device-summary span { color: #64748b; font-size: .7rem; }
    .mfa-device-summary strong { margin-top: 5px; color: #0f172a; font-size: .82rem; }
    .mfa-actions, .mfa-confirm-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .mfa-button { min-height: 38px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 9px; color: #1e3a8a; background: #fff; font-weight: 900; font-size: .76rem; cursor: pointer; text-decoration: none; }
    .mfa-button.primary { color: #fff; border-color: #2563eb; background: #2563eb; }
    .mfa-button.danger { color: #b91c1c; }
    .mfa-button:disabled { opacity: .55; cursor: wait; }
    .mfa-message { margin: 12px 0; padding: 10px 12px; border-radius: 9px; color: #1d4ed8; background: #eff6ff; font-size: .76rem; font-weight: 800; }
    .mfa-message.error { color: #b91c1c; background: #fef2f2; }
    .mfa-setup { margin-top: 16px; padding-top: 16px; border-top: 1px solid #e2e8f0; }
    .mfa-notice { display: grid; gap: 4px; padding: 11px 12px; margin-bottom: 14px; border-radius: 9px; color: #92400e; background: #fffbeb; font-size: .76rem; line-height: 1.6; }
    .mfa-notice strong { font-weight: 900; }
    .mfa-secret-label { display: block; margin: 9px 0 5px; color: #475569; font-size: .72rem; font-weight: 900; }
    .mfa-secret-row, .mfa-uri-row { display: flex; align-items: center; gap: 8px; }
    .mfa-secret-row code, .mfa-uri-row code { min-width: 0; flex: 1; overflow: auto; padding: 9px 10px; border: 1px solid #e2e8f0; border-radius: 8px; color: #0f172a; background: #f8fafc; direction: ltr; font-size: .72rem; white-space: nowrap; }
    .mfa-secret-row button, .mfa-uri-row button { width: 38px; height: 38px; border: 1px solid #cbd5e1; border-radius: 8px; color: #1d4ed8; background: #fff; cursor: pointer; }
    .mfa-recovery-box { margin: 14px 0; padding: 12px; border: 1px dashed #94a3b8; border-radius: 9px; background: #f8fafc; }
    .mfa-recovery-box strong { display: block; margin-bottom: 8px; color: #0f172a; font-size: .76rem; }
    .mfa-recovery-box div { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; direction: ltr; }
    .mfa-recovery-box code { padding: 5px; color: #1e3a8a; background: #fff; border-radius: 5px; text-align: center; font-size: .72rem; }
    .mfa-confirm-row input { min-width: 230px; flex: 1; padding: 9px 10px; border: 1px solid #cbd5e1; border-radius: 9px; direction: ltr; text-align: center; }
    [data-theme="dark"] .mfa-security-panel { border-color: #34465b; background: #182333; box-shadow: 0 16px 34px rgba(0, 0, 0, .24); }
    [data-theme="dark"] .mfa-panel-heading h2,
    [data-theme="dark"] .mfa-device-summary strong,
    [data-theme="dark"] .mfa-recovery-box strong { color: #f3f7fb; }
    [data-theme="dark"] .mfa-panel-heading p,
    [data-theme="dark"] .mfa-device-summary span,
    [data-theme="dark"] .mfa-secret-label { color: #aebdcd; }
    [data-theme="dark"] .mfa-state { color: #c1cedc; background: #263446; }
    [data-theme="dark"] .mfa-state.ready { color: #7ee2bb; background: #163d32; }
    [data-theme="dark"] .mfa-state.warn { color: #f4c56d; background: #493916; }
    [data-theme="dark"] .mfa-device-summary > div { border-color: #34465b; background: rgba(255, 255, 255, .035); }
    [data-theme="dark"] .mfa-button { color: #d6e4f5; border-color: #43566c; background: #202d3e; }
    [data-theme="dark"] .mfa-button.primary { color: #fff; border-color: #4f8df7; background: #2563eb; }
    [data-theme="dark"] .mfa-button.danger { color: #ff9a9f; }
    [data-theme="dark"] .mfa-message { color: #a9c9ff; background: #1a3158; }
    [data-theme="dark"] .mfa-message.error { color: #ffadb2; background: #4a2328; }
    [data-theme="dark"] .mfa-setup { border-top-color: #34465b; }
    [data-theme="dark"] .mfa-notice { color: #f6d68a; background: #47391c; }
    [data-theme="dark"] .mfa-secret-row code,
    [data-theme="dark"] .mfa-uri-row code,
    [data-theme="dark"] .mfa-recovery-box { color: #dce8f5; border-color: #43566c; background: #202d3e; }
    [data-theme="dark"] .mfa-secret-row code,
    [data-theme="dark"] .mfa-uri-row code { color: #e8f0fa; }
    [data-theme="dark"] .mfa-recovery-box code { color: #c4d9ff; background: #2a3a4d; }
    [data-theme="dark"] .mfa-secret-row button,
    [data-theme="dark"] .mfa-uri-row button { color: #9fc1ff; border-color: #43566c; background: #202d3e; }
    [data-theme="dark"] .mfa-confirm-row input { color: #f3f7fb; border-color: #43566c; background: #202d3e; }
    @media (max-width: 620px) { .mfa-device-summary { grid-template-columns: 1fr; } .mfa-panel-heading { display: block; } .mfa-state { display: inline-block; margin-top: 10px; } .mfa-recovery-box div { grid-template-columns: repeat(2, minmax(0, 1fr)); } .mfa-confirm-row input, .mfa-confirm-row .mfa-button { width: 100%; } }
</style>

<script>
(() => {
    const panel = document.querySelector('[data-mfa-panel]');
    if (!panel || panel.dataset.bound === 'true') return;
    panel.dataset.bound = 'true';
    const csrf = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
    const $ = (selector) => panel.querySelector(selector);
    const setMessage = (message, error = false) => { const node = $('[data-mfa-message]'); node.textContent = message || ''; node.hidden = !message; node.classList.toggle('error', error); };
    const request = async (path, options = {}) => {
        const response = await fetch(path, { credentials: 'same-origin', ...options, headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf, ...(options.headers || {}) } });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.success === false) throw new Error(data.error || 'تعذر إكمال الطلب.');
        return data;
    };
    const setBusy = (busy) => panel.querySelectorAll('button').forEach((button) => { button.disabled = busy; });
    const render = (data) => {
        const enabled = data.enabled === true;
        $('[data-mfa-enabled]').textContent = enabled ? 'مفعّل' : 'غير مفعّل';
        $('[data-mfa-login-rule]').textContent = enabled ? 'رمز مطلوب' : 'دخول مباشر';
        const state = $('[data-mfa-state]'); state.textContent = enabled ? 'حماية نشطة' : 'غير مفعّل'; state.classList.toggle('ready', enabled); state.classList.toggle('warn', false);
        $('[data-mfa-start]').hidden = enabled;
        $('[data-mfa-disable]').hidden = !enabled;
    };
    const refresh = async () => { try { render(await request('/security/mfa/status', { method: 'GET', headers: {} })); } catch (error) { setMessage(error.message, true); } };
    const copy = async (value) => { await navigator.clipboard.writeText(value); setMessage('تم نسخ البيانات.'); setTimeout(() => setMessage(''), 1800); };
    $('[data-mfa-copy-secret]').addEventListener('click', () => copy($('[data-mfa-secret]').textContent));
    $('[data-mfa-copy-uri]').addEventListener('click', () => copy($('[data-mfa-uri]').textContent));
    $('[data-mfa-start]').addEventListener('click', async () => {
        setBusy(true); setMessage('');
        try {
            const data = await request('/security/mfa/setup', { method: 'POST', body: '{}' });
            $('[data-mfa-secret]').textContent = data.setup.secret; $('[data-mfa-uri]').textContent = data.setup.qrUri;
            $('[data-mfa-recovery]').innerHTML = (data.setup.recoveryCodes || []).map((code) => `<code>${code}</code>`).join(''); $('[data-mfa-setup]').hidden = false; $('[data-mfa-start]').hidden = true; setMessage('أدخل المفتاح في تطبيق Authenticator ثم اكتب الرمز الحالي للتأكيد.');
        } catch (error) { setMessage(error.message, true); } finally { setBusy(false); }
    });
    $('[data-mfa-confirm]').addEventListener('click', async () => {
        const token = $('[data-mfa-confirm-token]').value.trim(); const secret = $('[data-mfa-secret]').textContent.trim(); const recoveryCodes = Array.from($('[data-mfa-recovery]').querySelectorAll('code')).map((node) => node.textContent.trim());
        if (!/^\d{6}$/.test(token)) return setMessage('أدخل رمز Authenticator المكون من 6 أرقام.', true);
        setBusy(true);
        try { await request('/security/mfa/confirm', { method: 'POST', body: JSON.stringify({ secret, token, recoveryCodes }) }); $('[data-mfa-setup]').hidden = true; setMessage('تم تفعيل Authenticator وتوثيق هذا الجهاز لمدة 24 ساعة.'); await refresh(); } catch (error) { setMessage(error.message, true); } finally { setBusy(false); }
    });
    $('[data-mfa-disable]').addEventListener('click', async () => {
        const token = window.prompt('أدخل رمز Authenticator أو رمز الاسترداد لإيقاف الحماية:')?.trim(); if (!token) return;
        setBusy(true); try { await request('/security/mfa/disable', { method: 'POST', body: JSON.stringify({ token }) }); setMessage('تم إيقاف Authenticator وإلغاء وثوق الأجهزة.'); await refresh(); } catch (error) { setMessage(error.message, true); } finally { setBusy(false); }
    });
    refresh();
})();
</script>
