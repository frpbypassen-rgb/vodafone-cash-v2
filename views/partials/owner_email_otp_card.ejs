<div class="col-12" id="owner-email-otp">
    <div class="info-box border-0 m-0 shadow-sm control-card-3d d-block" style="background: rgba(8, 127, 116, 0.08); border-right: 4px solid #087f74 !important;">
        <label class="form-label fw-bold text-dark mb-1" for="accountOwnerEmail"><i class="fa-solid fa-envelope-circle-check me-1" style="color:#087f74;"></i> البريد الإلكتروني لصاحب الحساب <span class="text-danger">*</span></label>
        <% if (ownerOtp.missingOwner) { %>
            <div class="alert alert-warning fw-bold small mb-2">لا يوجد حساب مالك لهذه الشركة. أنشئ حساب المالك قبل حفظ بريد صاحب الحساب.</div>
        <% } else if (ownerOtp.showLoginAccount && ownerOtp.ownerName) { %>
            <div class="small text-muted fw-bold mb-2">حساب الدخول: <%= ownerOtp.ownerName %><% if (ownerOtp.ownerUsername) { %> — <bdi dir="ltr"><%= ownerOtp.ownerUsername %></bdi><% } %></div>
        <% } %>
        <form action="/admin/accounts/<%= ownerOtp.type %>/<%= ownerOtp.id %>/owner-otp" method="POST" class="row g-2 align-items-center">
            <div class="col-md-7">
                <input id="accountOwnerEmail" type="text" inputmode="email" autocapitalize="none" spellcheck="false" name="email" class="form-control fw-bold unified-height border-0 shadow-sm" dir="ltr" maxlength="254" value="<%= ownerOtp.email || '' %>" placeholder="name@example.com" autocomplete="off" <%= ownerOtp.missingOwner ? 'disabled' : '' %> data-required-email="owner" data-email-otp-address title="يلزم بريد صالح فقط عند تفعيل رمز الدخول بالبريد.">
            </div>
            <div class="col-md-5">
                <button type="submit" class="btn w-100 fw-bold text-white unified-height justify-content-center shadow-sm btn-3d-hover d-flex align-items-center gap-2" style="background:#087f74;" <%= ownerOtp.missingOwner ? 'disabled' : '' %>>
                    <i class="fa-solid fa-floppy-disk"></i> <span>حفظ البريد</span>
                </button>
            </div>
            <div class="col-12">
                <% if (!ownerOtp.missingOwner) { %>
                <label class="d-flex align-items-center gap-2 fw-bold mb-0">
                    <input type="checkbox" name="emailOtpEnabled" value="true" data-email-otp-toggle <%= ownerOtp.emailOtpEnabled || ownerOtp.loginOtpChannel === 'telegram' ? 'checked' : '' %>>
                    <span>طلب كود التحقق عند تسجيل الدخول</span>
                </label>
                <label class="d-block mt-2">قناة كود الدخول<select class="form-select mt-1" name="loginOtpChannel"><option value="email" <%= ownerOtp.loginOtpChannel !== 'telegram' ? 'selected' : '' %>>البريد الإلكتروني</option><option value="telegram" <%= ownerOtp.loginOtpChannel === 'telegram' ? 'selected' : '' %> <%= ownerOtp.telegramVerified ? '' : 'disabled' %>>تليجرام — يلزم ربط مؤكد</option></select></label>
                <div class="small text-muted mt-1">تليجرام: <%= ownerOtp.telegramVerified ? 'مرتبط ومؤكد' : 'غير مرتبط' %><% if(ownerOtp.telegramAccount) { %> — <bdi>@<%= ownerOtp.telegramAccount %></bdi><% } %></div>
                <% } else { %>
                <label class="d-flex align-items-center gap-2 fw-bold mb-0">
                    <input type="checkbox" disabled>
                    <span>إرسال رمز التحقق عبر البريد</span>
                </label>
                <% } %>
                <% if (ownerOtp.verified) { %><div class="small text-success mt-1">تم تأكيد البريد بكود من صاحب الحساب.</div><% } %>
                <div class="small text-muted mt-1">الحالة متزامنة مع حساب صاحب المنشأة. عند التفعيل يُطلب كود القناة المختارة عند الدخول. Authenticator يظل مطلوبًا إذا كان مفعّلًا.</div>
            </div>
        </form>
    </div>
</div>
<%- include('required_owner_email_script') %>
