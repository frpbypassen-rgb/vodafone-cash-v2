<%
const summaryCounts = opsSummary.counts || {};
const orderedCompanies = [...opsCompanies].sort((left, right) => (right.activityCount || 0) - (left.activityCount || 0));
const busyExecutors = opsExecutors.filter(row => row.activityCount > 0).sort((left, right) => (right.activityCount || 0) - (left.activityCount || 0));
const idleExecutors = opsExecutors.filter(row => !row.activityCount);
%>
<section class="ow-dashboard" aria-label="ملخص العمليات">
    <div class="ow-totals">
        <article class="ow-total"><h2>إجمالي اليوم بالمصري</h2><div class="ow-split"><span>الكاش<strong dir="ltr"><%= formatMoney(opsToday.cashEGP) %></strong></span><span>البنكي<strong dir="ltr"><%= formatMoney(opsToday.bankEGP) %></strong></span></div><footer>الإجمالي <strong dir="ltr"><%= formatMoney(opsToday.egyptianEGP) %> EGP</strong></footer></article>
        <article class="ow-total"><h2>مقابل شغل اليوم بالليبي</h2><strong class="ow-amount" dir="ltr"><%= formatMoney(opsToday.totalLYD) %></strong><span>LYD · تكلفة العمليات المكتملة</span></article>
        <% [{title:'إيداعات الشركات اليوم', rows:opsCompanies, total:opsSummary.todayDepositsTotal, currency:'LYD'}, {title:'إيداعات المنفذين اليوم',rows:opsExecutors,total:opsSummary.todayExecutorDepositsTotal,currency:'EGP'}].forEach(deposits => { %>
        <article class="ow-total"><h2><%= deposits.title %></h2><div class="ow-deposits"><% const depositRows = deposits.rows.filter(row => row.depositsToday); depositRows.forEach(row => { %><div><span><%= row.name %></span><strong dir="ltr"><%= formatMoney(row.depositsToday) %></strong></div><% }); if (!depositRows.length) { %><span>لا توجد إيداعات للحسابات المعروضة</span><% } %></div><footer>الإجمالي <strong dir="ltr"><%= formatMoney(deposits.total) %> <%= deposits.currency %></strong></footer></article>
        <% }); %>
        <article class="ow-total ow-counts"><h2>مقارنة عدد العمليات</h2><div><% [['today','المنفذة اليوم'],['cancelled','الملغاة اليوم'],['week','آخر 7 أيام'],['month','الشهر الحالي'],['total','كل المنفذة']].forEach(metric => { %><span><%= metric[1] %><strong><%= formatCount(summaryCounts[metric[0]]) %></strong></span><% }); %></div></article>
    </div>
    <div class="ow-workspace">
        <section class="ow-companies" aria-label="الشركات"><h2>الشركات <small>الأكثر حركة أولًا</small></h2><div class="ow-cards"><% orderedCompanies.forEach(company => { %><a class="ow-account ow-company" href="/company/<%= company.id %>"><b><%= company.name %></b><strong class="<%= company.balance < 0 ? 'ow-negative' : (company.balance > 0 ? 'ow-positive' : 'ow-zero') %>" dir="ltr"><%= formatMoney(company.balance) %> <small>LYD</small></strong><span>المكتملة اليوم <b><%= formatCount(company.completedToday) %></b></span></a><% }); if (!orderedCompanies.length) { %><p>لا توجد شركات نشطة</p><% } %></div></section>
        <form class="ow-search" action="/transactions/operations" method="get" role="search"><label for="owSearch">بحث شامل · كل التواريخ</label><div><input id="owSearch" name="search" value="<%= search %>" placeholder="رقم، حساب، اسم أو عملية" maxlength="120"><input type="hidden" name="fromDate" value=""><input type="hidden" name="toDate" value=""><button type="submit" aria-label="عرض نتائج البحث"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> عرض</button><button type="button" class="ow-refresh" aria-label="تحديث سجل العمليات" title="تحديث سجل العمليات" onclick="window.location.reload()"><span aria-hidden="true">↻</span> تحديث</button></div><small>اضغط رقم العملية في النتائج لعرض التفاصيل</small></form>
        <section class="ow-executors" aria-label="المنفذون"><h2>المنفذون أصحاب الحركة</h2><div class="ow-cards"><% busyExecutors.forEach(executor => { %><a class="ow-account ow-executor" href="/transactions/operations?executorId=<%= executor.id %>&fromDate=&toDate="><b><%= executor.name %></b><div class="ow-exec-balances"><span>رصيد الكاش <% if (executor.cashBalance != null) { %><strong dir="ltr" class="<%= executor.cashBalance < 0 ? 'ow-negative' : 'ow-positive' %>"><%= formatMoney(executor.cashBalance) %> <small>EGP</small></strong><% } else { %><strong>غير متاح</strong><% } %></span><% if (executor.bankBalance != null) { %><span>رصيد البنك<strong dir="ltr" class="<%= executor.bankBalance < 0 ? 'ow-negative' : 'ow-positive' %>"><%= formatMoney(executor.bankBalance) %> <small>EGP</small></strong></span><% } %></div><span>المنفذة اليوم <b><%= formatCount(executor.completedToday) %></b></span></a><% }); if (!busyExecutors.length) { %><p>لا توجد حركة اليوم أو عمليات جارية</p><% } %></div><% if (idleExecutors.length) { %><details><summary>باقي المنفذين (<%= idleExecutors.length %>)</summary><div class="ow-cards"><% idleExecutors.forEach(executor => { %><a class="ow-account ow-executor" href="/executor/<%= executor.id %>"><b><%= executor.name %></b><div class="ow-exec-balances"><span>رصيد الكاش <% if (executor.cashBalance != null) { %><strong dir="ltr" class="<%= executor.cashBalance < 0 ? 'ow-negative' : 'ow-positive' %>"><%= formatMoney(executor.cashBalance) %> <small>EGP</small></strong><% } else { %><strong>غير متاح</strong><% } %></span><% if (executor.bankBalance != null) { %><span>رصيد البنك<strong dir="ltr" class="<%= executor.bankBalance < 0 ? 'ow-negative' : 'ow-positive' %>"><%= formatMoney(executor.bankBalance) %> <small>EGP</small></strong></span><% } %></div><span>المنفذة اليوم <b><%= formatCount(executor.completedToday) %></b></span></a><% }); %></div></details><% } %></section>
    </div>
</section>
<style>
.ow-dashboard .ow-executors .ow-executor{width:200px;min-width:0;max-width:100%;min-height:145px;padding:12px;gap:8px}.ow-dashboard .ow-executors .ow-executor>b{font-size:15px;line-height:1.5}.ow-exec-balances{display:grid;gap:6px;width:100%}.ow-dashboard .ow-exec-balances>span{display:grid;gap:3px;font-size:12px;border-top:1px solid #ffffff35;padding-top:6px}.ow-exec-balances strong{font-size:21px;font-weight:900;line-height:1.4;overflow-wrap:anywhere}.ow-dashboard .ow-executors .ow-executor>span{font-size:12px}
.ow-dashboard .ow-companies .ow-company{background:linear-gradient(145deg,#173fba,#123395);border-color:#769cff}.ow-dashboard .ow-companies .ow-company>b{color:#fff!important;font-weight:900}.ow-dashboard .ow-companies .ow-company>strong.ow-positive{color:#65ff9e!important}.ow-dashboard .ow-companies .ow-company>strong.ow-negative{color:#ff919d!important}.ow-dashboard .ow-companies .ow-company>strong.ow-zero{color:#fff!important}
.ow-dashboard .ow-companies .ow-company{width:170px;min-width:0;max-width:100%;height:var(--ow-company-height,auto);min-height:122px;padding:10px;display:grid;grid-template-rows:1fr auto auto;align-items:center;justify-items:center;gap:6px}.ow-dashboard .ow-companies .ow-company>b{width:100%;overflow-wrap:anywhere;line-height:1.5}.ow-dashboard .ow-companies .ow-company>strong{width:100%;font-size:19px;overflow-wrap:anywhere}.ow-dashboard .ow-companies .ow-company>span{width:100%;font-size:12px}
.ow-dashboard .ow-counts{width:100%;justify-self:stretch}
.ow-dashboard .ow-executor{background:linear-gradient(145deg,#0867dc 0%,#0752bb 52%,#123c99 100%);border:1px solid #7ec8ff;box-shadow:inset 0 1px 0 #ffffff65,0 3px 8px #0867dc30}.ow-dashboard .ow-company{background:linear-gradient(145deg,#008343 0%,#007439 52%,#005c32 100%);border:1px solid #69edb2;box-shadow:inset 0 1px 0 #ffffff65,0 3px 8px #00834330}.ow-dashboard .ow-account{color:#fff!important;text-shadow:0 1px 1px #00000065;min-width:100px;max-width:100%}.ow-dashboard .ow-account>b{font-size:13px;font-weight:800;line-height:1.5;white-space:normal}.ow-dashboard .ow-account>strong{font-size:19px;font-weight:900;line-height:1.4;white-space:normal;overflow-wrap:anywhere;max-width:100%}.ow-dashboard .ow-account span{color:#fff;font-weight:600;font-size:11px;line-height:1.6}.ow-dashboard .ow-account small{font-size:11px;font-weight:700}.ow-dashboard .ow-account .ow-positive{color:#b5ffda!important}.ow-dashboard .ow-account .ow-negative{color:#ffe0e4!important}.ow-dashboard .ow-account:focus-visible{outline:3px solid #f4bc30;outline-offset:3px}
.ow-executors>.ow-cards{direction:ltr}.ow-executors .ow-account{direction:rtl}.ow-executors h2{text-align:left}
.ow-workspace .ow-cards{flex-wrap:wrap-reverse;align-content:flex-start;align-items:flex-end;overflow:visible}
.ow-dashboard{direction:rtl;margin:4px 0 4px;font-family:inherit}.ow-dashboard *{box-sizing:border-box}.ow-dashboard h2{font-size:13px;font-weight:800;margin:0 0 6px;color:inherit}.ow-totals{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.85fr) minmax(0,1fr);grid-template-areas:"companies egyptian executors" "companies libyan executors" "companies counts executors";gap:6px 12px;align-items:start;margin-bottom:10px}.ow-total{background:#173352;color:#fff!important;border:1px solid #345574;border-radius:10px;padding:10px;text-align:center;display:flex;flex-direction:column;gap:6px;min-width:0}.ow-total h2{color:#fff!important}.ow-total:nth-child(1){grid-area:egyptian}.ow-total:nth-child(2){grid-area:libyan}.ow-total:nth-child(3){grid-area:companies;align-self:stretch}.ow-total:nth-child(4){grid-area:executors;align-self:stretch}.ow-total strong{color:#fff;font-size:19px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.ow-total .ow-amount{font-size:23px}.ow-total:nth-child(2)>span{font-size:11px}.ow-split{display:flex;justify-content:space-around;gap:8px}.ow-split span{display:grid;gap:3px;font-size:12px}.ow-total footer{border-top:1px solid #ffffff40;padding-top:6px;display:flex;justify-content:center;align-items:center;gap:8px;margin-top:auto;font-size:12px}.ow-deposits{overflow:auto;max-height:240px;min-height:75px;font-size:12px}.ow-deposits div{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 2px;border-bottom:1px solid #ffffff25}.ow-deposits strong{font-size:17px;white-space:nowrap}.ow-counts{grid-area:counts;background:#493371;border-color:#795ca2;padding:6px;justify-self:center;width:max-content;max-width:100%}.ow-counts h2{font-size:11px;margin:0}.ow-counts>div{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:3px}.ow-counts span{display:grid;gap:3px;min-width:0;padding:5px 4px;border:1px solid #ffffff35;border-radius:5px;font-size:10px;white-space:nowrap}.ow-counts strong{font-size:17px}.ow-workspace{display:grid;grid-template-columns:minmax(0,1fr) minmax(210px,.65fr) minmax(0,1fr);gap:6px;align-items:end;margin:0}.ow-cards{display:flex;flex-wrap:nowrap;gap:5px;align-items:start;overflow-x:auto;padding:2px 0 3px}.ow-account{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 auto;width:max-content;max-width:180px;padding:8px;gap:4px;border-radius:8px;text-align:center;text-decoration:none!important;color:#fff!important;border:1px solid #ffffff35}.ow-company{background:#087343}.ow-executor{background:#124da1}.ow-account>b{font-size:12px;max-width:100%;overflow-wrap:anywhere}.ow-account>strong{font-size:18px;line-height:1.25;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}.ow-account span,.ow-account small{font-size:10px}.ow-positive{color:#a3ffc8!important}.ow-negative{color:#ffb5bd!important}.ow-search{align-self:end;text-align:center;color:var(--text-main,inherit);padding-bottom:3px}.ow-search label{display:block;font-size:11px;font-weight:800;margin-bottom:4px}.ow-search>div{display:flex;gap:3px}.ow-search input:not([type=hidden]){width:100%;min-width:0;border:1px solid #8b9bb0;border-radius:7px;background:var(--bg-card,#fff);color:var(--text-main,#17243c);padding:8px;font-size:11px}.ow-search button{border:0;border-radius:7px;background:#174d90;color:#fff;padding:8px;white-space:nowrap;font-size:12px}.ow-search small{display:none}.ow-executors details{margin-top:3px}.ow-executors summary{cursor:pointer;padding:3px;font-size:11px}.ow-workspace p{font-size:12px;margin:4px}.ow-companies h2,.ow-executors h2{color:var(--text-main,inherit)}.ow-workspace h2 small{font-size:10px;font-weight:500}@media(max-width:760px){.ow-totals{grid-template-columns:1fr 1fr;grid-template-areas:"egyptian libyan" "companies executors" "counts counts"}.ow-workspace{grid-template-columns:1fr 1fr}.ow-search{grid-column:1/-1;grid-row:2}.ow-counts{width:max-content}.ow-deposits{min-height:40px}}@media(max-width:440px){.ow-totals{grid-template-columns:1fr;grid-template-areas:"egyptian" "libyan" "companies" "executors" "counts"}.ow-workspace{grid-template-columns:1fr}.ow-search{grid-column:auto;grid-row:2}.ow-counts span{font-size:9px}}
</style>
<script>
(() => {
    if (window.owCompanySizingReady) return;
    window.owCompanySizingReady = true;
    let pending = false;
    const resizeCards = () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
            pending = false;
            const container = document.querySelector('.ow-companies > .ow-cards');
            if (!container) return;
            const cards = [...container.querySelectorAll('.ow-company')];
            container.style.removeProperty('--ow-company-height');
            const height = Math.max(122, ...cards.map(card => card.getBoundingClientRect().height));
            container.style.setProperty('--ow-company-height', `${Math.ceil(height)}px`);
        });
    };
    window.addEventListener('resize', resizeCards);
    new MutationObserver(resizeCards).observe(document.querySelector('.main-content') || document.body, { childList: true, subtree: true });
    document.fonts?.ready.then(resizeCards);
    resizeCards();
})();
</script>
