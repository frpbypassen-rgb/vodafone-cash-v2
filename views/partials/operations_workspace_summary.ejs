<%
const summaryCounts = opsSummary.counts || {};
const orderedCompanies = [...opsCompanies].sort((left, right) => (left.activityCount || 0) - (right.activityCount || 0));
const orderedExecutors = [...opsExecutors].sort((left, right) => (right.activityCount || 0) - (left.activityCount || 0));
const rangeStart = typeof fromDate === 'undefined' ? '' : fromDate;
const rangeEnd = typeof toDate === 'undefined' ? '' : toDate;
const activeExecutor = typeof executorId === 'undefined' ? '' : executorId;
const activeStatus = typeof statusFilter === 'undefined' ? '' : statusFilter;
const activeType = typeof filterType === 'undefined' ? '' : filterType;
const totals = [
    { label: 'إجمالي اليوم بالمصري', icon: 'arrow-right-arrow-left', value: opsToday.egyptianEGP, currency: 'EGP' },
    { label: 'تكلفة اليوم بالليبي', icon: 'coins', value: opsToday.totalLYD, currency: 'LYD' },
    { label: 'إيداعات الشركات اليوم', icon: 'building', value: opsSummary.todayDepositsTotal, currency: 'LYD' },
    { label: 'إيداعات المنفذين اليوم', icon: 'wallet', value: opsSummary.todayExecutorDepositsTotal, currency: 'EGP' }
];
const dailyChannels = [
    { key: 'cash', label: 'الكاش اليوم', detail: 'فودافون كاش', icon: 'mobile-screen-button', value: opsToday.vodafoneCashEGP },
    { key: 'bank', label: 'البنكي اليوم', detail: 'التحويلات المكتملة', icon: 'building-columns', value: opsToday.bankEGP }
];
const periodCounts = [
    ['today', 'المنفذة اليوم'],
    ['cancelled', 'الملغاة اليوم'],
    ['week', 'آخر 7 أيام'],
    ['month', 'الشهر الحالي'],
    ['total', 'إجمالي المنفذة']
];
%>
<section class="ow-dashboard" aria-label="ملخص العمليات">
    <div class="ow-workspace">
        <section class="ow-companies" aria-labelledby="owCompaniesTitle">
            <h2 id="owCompaniesTitle" class="ow-panel-title"><i class="ow-card-icon fa-solid fa-building" aria-hidden="true"></i> الشركات <bdi><%= formatCount(orderedCompanies.length) %></bdi></h2>
            <div class="ow-cards">
                <% for (const company of orderedCompanies) { %>
                <a class="ow-account ow-company" href="/company/<%= encodeURIComponent(company.id) %>">
                    <h3 class="ow-account-heading"><bdi><%= company.name %></bdi><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></h3>
                    <dl class="ow-account-facts">
                        <div class="ow-account-balance">
                            <dt>الرصيد</dt>
                            <dd class="<%= company.balance < 0 ? 'ow-negative' : (company.balance > 0 ? 'ow-positive' : '') %>"><bdi class="ow-amount" dir="ltr"><%= formatMoney(company.balance) %> <small>LYD</small></bdi></dd>
                        </div>
                        <div><dt>المكتملة اليوم</dt><dd><bdi dir="ltr"><%= formatCount(company.completedToday) %></bdi></dd></div>
                        <% if (company.depositsToday) { %>
                        <div><dt>إيداع اليوم</dt><dd><bdi class="ow-amount" dir="ltr"><%= formatMoney(company.depositsToday) %> <small>LYD</small></bdi></dd></div>
                        <% } %>
                    </dl>
                </a>
                <% } %>
                <% if (!orderedCompanies.length) { %><p class="ow-panel-empty">لا توجد شركات نشطة.</p><% } %>
            </div>
        </section>

        <div class="ow-workspace-side">
            <section class="ow-breakdown" aria-labelledby="owBreakdownTitle">
                <h2 id="owBreakdownTitle" class="ow-panel-title"><i class="ow-card-icon fa-solid fa-chart-simple" aria-hidden="true"></i> الإحصائيات</h2>
                <dl class="ow-daily-channels">
                    <% for (const channel of dailyChannels) { %>
                    <div class="ow-daily-channel ow-daily-channel-<%= channel.key %>">
                        <dt>
                            <i class="ow-card-icon fa-solid fa-<%= channel.icon %>" aria-hidden="true"></i>
                            <span><%= channel.label %><small><%= channel.detail %></small></span>
                        </dt>
                        <dd><bdi class="ow-amount" dir="ltr"><%= formatMoney(channel.value) %> <small>EGP</small></bdi></dd>
                    </div>
                    <% } %>
                </dl>
                <dl class="ow-totals">
                    <% for (const total of totals) { %>
                    <div class="ow-total">
                        <dt><i class="ow-card-icon fa-solid fa-<%= total.icon %>" aria-hidden="true"></i> <span><%= total.label %></span></dt>
                        <dd><bdi class="ow-amount" dir="ltr"><%= formatMoney(total.value) %> <small><%= total.currency %></small></bdi></dd>
                    </div>
                    <% } %>
                </dl>
                <dl class="ow-stat-grid">
                    <% for (const [key, label] of periodCounts) { %>
                    <div class="ow-stat ow-stat-<%= key %>"><dt><%= label %></dt><dd><bdi dir="ltr"><%= formatCount(summaryCounts[key]) %></bdi></dd></div>
                    <% } %>
                </dl>
            </section>

            <section class="ow-executors" aria-labelledby="owExecutorsTitle">
                <h2 id="owExecutorsTitle" class="ow-panel-title"><i class="ow-card-icon fa-solid fa-user-gear" aria-hidden="true"></i> المنفذون <bdi><%= formatCount(opsExecutors.length) %></bdi></h2>
                <div class="ow-cards">
                    <% for (const executor of orderedExecutors) { %>
                    <%- include('operations_executor_account', { executor, formatMoney, formatCount }) %>
                    <% } %>
                    <% if (!orderedExecutors.length) { %><p class="ow-panel-empty">لا يوجد منفذون للعرض.</p><% } %>
                </div>
            </section>
        </div>
    </div>
</section>

<form class="ow-search" action="/transactions/operations" method="get" role="search" aria-label="بحث شامل">
    <% if (activeExecutor) { %><input type="hidden" name="executorId" value="<%= activeExecutor %>"><% } %>
    <% if (activeType) { %><input type="hidden" name="filterType" value="<%= activeType %>"><% } %>
    <div class="ow-search-field">
        <label for="owSearch" class="visually-hidden">بحث شامل</label>
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input id="owSearch" class="form-control" name="search" type="search" value="<%= search %>" placeholder="رقم العملية أو الحساب أو اسم العميل" maxlength="120">
    </div>
    <button type="submit" class="btn btn-primary ow-submit">بحث</button>
    <button type="button" class="btn ow-refresh" aria-label="تحديث سجل العمليات" title="تحديث سجل العمليات" onclick="window.location.reload()"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
    <div class="ow-status">
        <label class="visually-hidden" for="owStatus">حالة العملية</label>
        <select id="owStatus" name="status" class="form-select">
            <% for (const [value, label] of [['','كل الحالات'],['pending','معلّقة'],['processing','قيد التنفيذ'],['accepted','قيد العمل'],['completed','مكتملة'],['rejected','مرفوضة'],['cancelled_by_admin','ملغاة']]) { %>
            <option value="<%= value %>" <%= activeStatus === value ? 'selected' : '' %>><%= label %></option>
            <% } %>
        </select>
    </div>
    <details class="ow-date-range"<%= rangeStart || rangeEnd ? ' open' : '' %>>
        <summary><i class="fa-regular fa-calendar" aria-hidden="true"></i> الفترة</summary>
        <div>
            <label>من<input type="date" class="form-control" name="fromDate" value="<%= rangeStart || '' %>"></label>
            <label>إلى<input type="date" class="form-control" name="toDate" value="<%= rangeEnd || '' %>"></label>
        </div>
    </details>
    <% if (search || activeStatus || activeExecutor || activeType || rangeStart || rangeEnd) { %>
    <a class="ow-reset" href="/transactions/operations">مسح الفلاتر</a>
    <% } %>
</form>
