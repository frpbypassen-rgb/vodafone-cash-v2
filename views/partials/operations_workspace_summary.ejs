<%
const summaryCounts = opsSummary.counts || {};
const orderedCompanies = [...opsCompanies].sort((left, right) => (right.activityCount || 0) - (left.activityCount || 0));
const busyExecutors = opsExecutors.filter(row => row.activityCount > 0).sort((left, right) => (right.activityCount || 0) - (left.activityCount || 0));
const idleExecutors = opsExecutors.filter(row => !row.activityCount);
const rangeStart = typeof fromDate === 'undefined' ? '' : fromDate;
const rangeEnd = typeof toDate === 'undefined' ? '' : toDate;
const activeExecutor = typeof executorId === 'undefined' ? '' : executorId;
const activeStatus = typeof statusFilter === 'undefined' ? '' : statusFilter;
const activeType = typeof filterType === 'undefined' ? '' : filterType;
const deposits = [
    { title: 'إيداعات الشركات اليوم', icon: 'building', rows: opsCompanies, total: opsSummary.todayDepositsTotal, currency: 'LYD' },
    { title: 'إيداعات المنفذين اليوم', icon: 'wallet', rows: opsExecutors, total: opsSummary.todayExecutorDepositsTotal, currency: 'EGP' }
];
%>
<section class="ow-dashboard" aria-label="ملخص العمليات">
    <div class="ow-totals">
        <article class="ow-total">
            <h2><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i> إجمالي اليوم بالمصري</h2>
            <strong dir="ltr"><%= formatMoney(opsToday.egyptianEGP) %> <small>EGP</small></strong>
        </article>
        <article class="ow-total">
            <h2><i class="fa-solid fa-coins" aria-hidden="true"></i> تكلفة اليوم بالليبي</h2>
            <strong dir="ltr"><%= formatMoney(opsToday.totalLYD) %> <small>LYD</small></strong>
        </article>
        <% for (const deposit of deposits) { %>
        <article class="ow-total">
            <h2><i class="fa-solid fa-<%= deposit.icon %>" aria-hidden="true"></i> <%= deposit.title %></h2>
            <strong dir="ltr"><%= formatMoney(deposit.total) %> <small><%= deposit.currency %></small></strong>
        </article>
        <% } %>
    </div>

    <div class="ow-workspace">
        <section class="ow-breakdown" aria-labelledby="owBreakdownTitle">
            <h2 id="owBreakdownTitle" class="ow-panel-title"><i class="fa-solid fa-chart-simple" aria-hidden="true"></i> إحصاءات وإيداعات</h2>
            <div class="ow-breakdown-grid">
                <dl class="ow-lines ow-stat-lines">
                    <div><dt>الكاش</dt><dd><bdi><%= formatMoney(opsToday.cashEGP) %> EGP</bdi></dd></div>
                    <div><dt>البنكي</dt><dd><bdi><%= formatMoney(opsToday.bankEGP) %> EGP</bdi></dd></div>
                    <% for (const [key, label] of [['today','المنفذة اليوم'],['cancelled','الملغاة اليوم'],['week','آخر 7 أيام'],['month','الشهر الحالي'],['total','كل المنفذة']]) { %>
                    <div><dt><%= label %></dt><dd><bdi><%= formatCount(summaryCounts[key]) %></bdi></dd></div>
                    <% } %>
                </dl>
                <% for (const deposit of deposits) {
                    const depositRows = deposit.rows.filter(row => row.depositsToday);
                %>
                <div class="ow-deposit-list">
                    <h3><%= deposit.title %></h3>
                    <dl class="ow-lines">
                        <% for (const row of depositRows) { %>
                        <div><dt><%= row.name %></dt><dd><bdi><%= formatMoney(row.depositsToday) %> <%= deposit.currency %></bdi></dd></div>
                        <% } %>
                    </dl>
                    <% if (!depositRows.length) { %><p>لا توجد إيداعات للحسابات المعروضة.</p><% } %>
                </div>
                <% } %>
            </div>
        </section>

        <section class="ow-companies" aria-labelledby="owCompaniesTitle">
            <h2 id="owCompaniesTitle" class="ow-panel-title"><i class="fa-solid fa-building" aria-hidden="true"></i> الشركات <bdi><%= orderedCompanies.length %></bdi></h2>
            <div class="ow-cards">
                <% for (const company of orderedCompanies) { %>
                <a class="ow-account ow-company" href="/company/<%= company.id %>">
                    <div class="ow-account-heading"><b><%= company.name %></b><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></div>
                    <div class="ow-account-meta">
                        <span>المكتملة اليوم <b><%= formatCount(company.completedToday) %></b></span>
                        <strong class="<%= company.balance < 0 ? 'ow-negative' : (company.balance > 0 ? 'ow-positive' : '') %>" dir="ltr"><%= formatMoney(company.balance) %> <small>LYD</small></strong>
                    </div>
                </a>
                <% } %>
                <% if (!orderedCompanies.length) { %><p>لا توجد شركات نشطة.</p><% } %>
            </div>
        </section>

        <section class="ow-executors" aria-labelledby="owExecutorsTitle">
            <h2 id="owExecutorsTitle" class="ow-panel-title"><i class="fa-solid fa-user-gear" aria-hidden="true"></i> المنفذون <bdi><%= opsExecutors.length %></bdi></h2>
            <div class="ow-cards">
                <% for (const executor of busyExecutors) { %>
                <%- include('operations_executor_account', { executor, formatMoney, formatCount, active: true }) %>
                <% } %>
                <% if (!busyExecutors.length) { %><p>لا توجد حركة اليوم أو عمليات جارية.</p><% } %>
            </div>
            <% if (idleExecutors.length) { %>
            <h3 class="ow-panel-subtitle">باقي المنفذين (<%= idleExecutors.length %>)</h3>
            <div class="ow-cards">
                <% for (const executor of idleExecutors) { %>
                <%- include('operations_executor_account', { executor, formatMoney, formatCount, active: false }) %>
                <% } %>
            </div>
            <% } %>
        </section>
    </div>
</section>

<form class="ow-search" action="/transactions/operations" method="get" role="search" aria-label="بحث شامل">
    <% if (activeExecutor) { %><input type="hidden" name="executorId" value="<%= activeExecutor %>"><% } %>
    <% if (activeType) { %><input type="hidden" name="filterType" value="<%= activeType %>"><% } %>
    <div class="ow-search-field">
        <label for="owSearch" class="visually-hidden">بحث شامل</label>
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input id="owSearch" class="form-control" name="search" type="search" value="<%= search %>" placeholder="رقم العملية أو الحساب أو اسم العميل" maxlength="120">
    </div>
    <button type="submit" class="btn btn-primary ow-submit">بحث</button>
    <button type="button" class="btn ow-refresh" aria-label="تحديث سجل العمليات" title="تحديث سجل العمليات" onclick="window.location.reload()"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
    <div class="ow-status">
        <label class="visually-hidden" for="owStatus">حالة العملية</label>
        <select id="owStatus" name="status" class="form-select">
            <% for (const [value, label] of [['','كل الحالات'],['pending','معلّقة'],['processing','قيد التنفيذ'],['accepted','قيد العمل'],['completed','مكتملة'],['rejected','مرفوضة'],['cancelled_by_admin','ملغاة']]) { %>
            <option value="<%= value %>" <%= activeStatus === value ? 'selected' : '' %>><%= label %></option>
            <% } %>
        </select>
    </div>
    <details class="ow-date-range"<%= rangeStart || rangeEnd ? ' open' : '' %>>
        <summary><i class="fa-regular fa-calendar" aria-hidden="true"></i> الفترة</summary>
        <div>
            <label>من<input type="date" class="form-control" name="fromDate" value="<%= rangeStart || '' %>"></label>
            <label>إلى<input type="date" class="form-control" name="toDate" value="<%= rangeEnd || '' %>"></label>
        </div>
    </details>
    <% if (search || activeStatus || activeExecutor || activeType || rangeStart || rangeEnd) { %>
    <a class="ow-reset" href="/transactions/operations">مسح الفلاتر</a>
    <% } %>
</form>
