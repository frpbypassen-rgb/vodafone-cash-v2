<a class="ow-account ow-executor" href="/executor/<%= encodeURIComponent(executor.id) %>">
    <h3 class="ow-account-heading"><bdi><%= executor.name %></bdi><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></h3>
    <dl class="ow-account-facts">
        <div class="ow-account-balance">
            <dt>رصيد الكاش</dt>
            <% if (executor.cashBalance != null) { %>
            <dd class="<%= executor.cashBalance < 0 ? 'ow-negative' : (executor.cashBalance > 0 ? 'ow-positive' : '') %>"><bdi class="ow-amount" dir="ltr"><%= formatMoney(executor.cashBalance) %> <small>EGP</small></bdi></dd>
            <% } else { %><dd class="ow-unavailable">غير متاح</dd><% } %>
        </div>
        <% if (executor.bankBalance != null) { %>
        <div><dt>رصيد البنك</dt><dd class="<%= executor.bankBalance < 0 ? 'ow-negative' : (executor.bankBalance > 0 ? 'ow-positive' : '') %>"><bdi class="ow-amount" dir="ltr"><%= formatMoney(executor.bankBalance) %> <small>EGP</small></bdi></dd></div>
        <% } %>
        <div><dt>المنفذة اليوم</dt><dd><bdi dir="ltr"><%= formatCount(executor.completedToday) %></bdi></dd></div>
        <% if (executor.depositsToday) { %>
        <div><dt>إيداع اليوم</dt><dd><bdi class="ow-amount" dir="ltr"><%= formatMoney(executor.depositsToday) %> <small>EGP</small></bdi></dd></div>
        <% } %>
    </dl>
</a>
