    <details class="am-detail-heading-menu"><summary aria-label="خيارات ملف المنفذ">⋮</summary><div><% if(isMaster) { %><a href="/admin/accounts/executor/<%= bot._id %>/edit">تعديل البيانات</a><% } %><a href="<%= detailUrl('settings') %>#executor-status">حالة استقبال الطلبات</a><a href="/executors">دليل المنفذين والأرشيف</a></div></details>
</header>
