<% if (typeof providerReviewMode !== 'undefined' && providerReviewMode) {
    const counts = Object.fromEntries((typeof providerReviewCounts !== 'undefined' ? providerReviewCounts : []).map(item => [item._id || 'awaiting', item.count]));
    const attention = ['returned','rejected','mismatch','failed','missing_reference','missing_executor','exhausted']
        .reduce((sum, key) => sum + (counts[key] || 0), 0);
    const metrics = [
        ['total', 'layer-group', 'إجمالي النتائج', totalTxs],
        ['waiting', 'hourglass-half', 'بانتظار نتيجة', (counts.pending || 0) + (counts.awaiting || 0)],
        ['paid', 'circle-check', 'نجاح لدى المزود', counts.paid || 0],
        ['attention', 'circle-exclamation', 'تحتاج تدخّلًا', attention]
    ];
%>
<section id="providerReviewSummary" class="review-summary" aria-labelledby="reviewSummaryTitle">
    <h2 class="visually-hidden" id="reviewSummaryTitle">عمليات API تحتاج مراجعة</h2>
    <dl class="review-metrics">
        <% for (const [tone, icon, label, count] of metrics) { %>
        <div class="review-metric review-<%= tone %>">
            <dt><span class="review-metric-icon"><i class="fa-solid fa-<%= icon %>" aria-hidden="true"></i></span><%= label %></dt>
            <dd><bdi><%= Number(count).toLocaleString('ar-LY') %></bdi></dd>
        </div>
        <% } %>
    </dl>
    <div class="review-monitor-bar">
        <span class="review-monitor <%= providerMonitorEnabled ? 'is-enabled' : '' %>" title="يفحص المراقب العام حتى 10 عمليات في الدورة، وبحد أقصى 8 محاولات لكل عملية. تراجع الإدارة النتيجة عند تأكيد النجاح أو الإلغاء أو اختلاف البيانات.">
            <i class="fa-solid <%= providerMonitorEnabled ? 'fa-rotate' : 'fa-pause' %>" aria-hidden="true"></i>
            المتابعة الدورية <%= providerMonitorEnabled ? 'مفعّلة' : 'متوقفة' %>
        </span>
        <span><i class="fa-regular fa-clock" aria-hidden="true"></i> تحديث كل 30 ثانية</span>
    </div>
</section>
<% } %>
