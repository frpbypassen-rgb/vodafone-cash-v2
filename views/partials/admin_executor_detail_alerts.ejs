        <% if (typeof query !== 'undefined' && query.profileUpdated === '1') { %>
            <div class="alert alert-success fw-bold shadow-sm"><i class="fa-solid fa-circle-check me-2"></i> تم تحديث بيانات المنفذ بنجاح.</div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.receiptPrefixUpdated === '1') { %>
            <div class="alert alert-success fw-bold shadow-sm"><i class="fa-solid fa-circle-check me-2"></i> تم تحديث رمز مرجع إيصالات المنفذ بنجاح.</div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.receiptPrefixError) { %>
            <div class="alert alert-danger fw-bold shadow-sm"><i class="fa-solid fa-triangle-exclamation me-2"></i> تعذر حفظ رمز المرجع. تأكد أنه مكون من 3 أرقام وغير مستخدم لدى منفذ آخر.</div>
        <% } %>

        <% if (typeof query !== 'undefined' && query.employeePolicyUpdated === '1') { %>
            <div class="alert alert-success fw-bold shadow-sm"><i class="fa-solid fa-circle-check me-2"></i> تم تحديث صلاحيات المنفذ بنجاح.</div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.employeePolicyError) { %>
            <div class="alert alert-danger fw-bold shadow-sm"><i class="fa-solid fa-triangle-exclamation me-2"></i> تعذر حفظ صلاحيات المنفذ. التعديل متاح للإدارة فقط ولا يشمل حساب المدير.</div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.servicesUpdated === '1') { %>
            <div class="alert alert-success fw-bold shadow-sm"><i class="fa-solid fa-circle-check me-2"></i> تم تحديث خدمات شركة التنفيذ. الأرصدة تظهر منفصلة لكل خدمة.</div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.manualPolicyError) { %>
            <div class="alert alert-danger fw-bold shadow-sm"><i class="fa-solid fa-triangle-exclamation me-2"></i> تعذر حفظ صلاحيات المنفذ اليدوي.</div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.depositRequest) { %>
            <div class="alert alert-info fw-bold shadow-sm"><i class="fa-solid fa-clock me-2"></i>تم إرسال طلب الإيداع <span dir="ltr"><%= query.depositRequest %></span> إلى الدعم مع الإيصالات. سيصل الرصيد إلى المنفذ بعد القبول النهائي.</div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.settlementError === 'RECEIPT_REQUIRED') { %>
            <div class="alert alert-danger fw-bold shadow-sm"><i class="fa-solid fa-image me-2"></i>أرفق إيصال إيداع واحدًا على الأقل قبل إرسال الطلب.</div>
        <% } else if (typeof query !== 'undefined' && query.settlementError === 'ACTOR_REQUIRED') { %>
            <div class="alert alert-danger fw-bold shadow-sm"><i class="fa-solid fa-user-shield me-2"></i>تعذر تحديد المدير المنفّذ. سجّل الدخول من جديد ثم أعد تسجيل الإيداع أو الخصم.</div>
        <% } %>
