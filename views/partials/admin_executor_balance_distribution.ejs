<div class="info-box d-block text-center border-0 shadow-sm py-3" style="background: rgba(16, 185, 129, 0.05); border-right: 4px solid #10b981 !important;">
                        <% const snapshot = typeof companyBalances === 'object' && companyBalances ? companyBalances : null; %>
                        <% const serviceRows = Array.isArray(snapshot?.byService) && snapshot.byService.length ? snapshot.byService : null; %>
                        <% const externalTotal = snapshot ? Number(snapshot.allocatedBalance || 0) : (Array.isArray(externalEmployees) ? externalEmployees.reduce((sum, item) => sum + Number(item.workingBalance || item.balance || 0), 0) : 0); %>
                        <% const companyDirectBalance = snapshot ? Number(snapshot.privateBalance || 0) : Number(bot.balance || 0); %>
                        <% if (serviceRows && snapshot?.multiService) { %>
                            <span class="d-block small text-muted fw-bold mb-2"><i class="fa-solid fa-layer-group me-1"></i> الأرصدة حسب الخدمة (EGP)</span>
                            <div class="d-grid gap-2 text-start">
                                <% serviceRows.forEach((row) => { %>
                                    <div class="info-box py-2 px-3 m-0">
                                        <span class="fw-bold"><%= row.label %></span>
                                        <% if (row.appliesPoolModel) { %>
                                            <small class="text-muted d-block"><%= row.totalLabel %></small>
                                            <strong class="mono-num <%= Number(row.totalBalance) < 0 ? 'text-danger' : 'text-success' %>" dir="ltr"><%= Number(row.totalBalance).toFixed(2) %></strong>
                                            <div class="d-flex justify-content-between small mt-1">
                                                <span class="text-muted"><%= row.privateLabel %></span>
                                                <strong class="mono-num" dir="ltr"><%= Number(row.privateBalance).toFixed(2) %></strong>
                                            </div>
                                        <% } else { %>
                                            <small class="text-muted d-block"><%= row.singleLabel %></small>
                                            <strong class="mono-num <%= Number(row.privateBalance) < 0 ? 'text-danger' : 'text-success' %>" dir="ltr"><%= Number(row.privateBalance).toFixed(2) %></strong>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                        <span class="d-block small text-muted fw-bold mb-1"><i class="fa-solid fa-wallet me-1"></i> إجمالي الرصيد (EGP)</span>
                        <% const combinedBalance = snapshot ? Number(snapshot.totalBalance || 0) : companyDirectBalance + externalTotal; %>
                        <h2 class="m-0 fw-900 mono-num <%= combinedBalance < 0 ? 'text-danger' : 'text-success' %>" dir="ltr"><%= combinedBalance.toFixed(2) %></h2>
                        <% } %>
                        <div class="mt-3 text-start small">
                            <% if (!(serviceRows && snapshot?.multiService)) { %>
                            <div class="d-flex justify-content-between py-1 border-bottom" style="border-color: var(--glass-border) !important;">
                                <span class="text-muted fw-bold">الرصيد الخاص</span>
                                <strong class="mono-num" dir="ltr"><%= companyDirectBalance.toFixed(2) %></strong>
                            </div>
                            <% } %>
                            <div class="d-flex justify-content-between py-1 border-bottom" style="border-color: var(--glass-border) !important;">
                                <span class="text-muted fw-bold">المتاح عند المنفذين الخارجيين</span>
                                <strong class="mono-num" dir="ltr"><%= externalTotal.toFixed(2) %></strong>
                            </div>
                            <% if (Array.isArray(externalPools) && externalPools.length) { %>
                                <details class="mt-2">
                                    <summary class="fw-bold text-primary" style="cursor:pointer;">مجموعات الرصيد المشتركة</summary>
                                    <div class="mt-2 d-grid gap-2">
                                        <% externalPools.forEach((pool) => { %>
                                            <div class="info-box py-2 px-3 m-0">
                                                <span class="fw-bold"><%= pool.name %></span>
                                                <small class="text-muted"><%= (pool.members || []).map((member) => member.name).join(' · ') || 'بدون أعضاء' %></small>
                                                <strong class="mono-num <%= Number(pool.balance || 0) < 0 ? 'text-danger' : 'text-success' %>" dir="ltr"><%= Number(pool.balance || 0).toFixed(2) %> EGP</strong>
                                            </div>
                                        <% }) %>
                                    </div>
                                </details>
                            <% } %>
                            <% if (Array.isArray(externalEmployees) && externalEmployees.length) { %>
                                <details class="mt-2">
                                    <summary class="fw-bold text-primary" style="cursor:pointer;">عرض المنفذين الخارجيين</summary>
                                    <div class="mt-2 d-grid gap-2">
                                        <% externalEmployees.forEach((member) => { %>
                                            <div class="info-box py-2 px-3 m-0">
                                                <span class="fw-bold"><%= member.name %></span>
                                                <small class="text-muted"><%= member.balancePool ? member.balancePool.name : 'رصيد فردي' %></small>
                                                <strong class="mono-num <%= Number(member.workingBalance || member.balance || 0) < 0 ? 'text-danger' : 'text-success' %>" dir="ltr"><%= Number(member.workingBalance || member.balance || 0).toFixed(2) %> EGP</strong>
                                            </div>
                                        <% }) %>
                                    </div>
                                </details>
                            <% } %>
                        </div>
                    </div>
