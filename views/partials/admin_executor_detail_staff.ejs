<section class="am-detail-panel am-team-panel">
    <header class="am-detail-section-head"><div><span class="am-detail-section-kicker">فريق التنفيذ</span><h2>حسابات الفريق</h2><p>الموظفون المرتبطون بهذا المنفذ وحالة كل حساب.</p></div><span class="am-detail-count"><bdi><%= teamEmployees.length %></bdi> موظف</span></header>
    <div class="am-detail-team">
        <% teamEmployees.forEach(member => { %>
        <article class="am-team-member">
            <span class="am-team-avatar" aria-hidden="true"><%= String(member.name || 'م').trim().charAt(0) || 'م' %></span>
            <div class="am-team-identity"><h3><%= member.name %></h3><p><%= {manager:'مدير',accountant:'محاسب',external:'منفذ خارجي',operator:'موظف تنفيذ'}[member.role] || member.role %></p><bdi dir="ltr"><%= member.phone || '—' %></bdi></div>
            <div class="am-team-actions"><span class="am-team-status <%= member.status === 'active' ? 'is-active' : '' %>"><%= member.status === 'active' ? 'نشط' : 'متوقف' %></span><% if(isMaster) { %><a class="am-button" href="/admin/accounts/executor-employee/<%= member._id %>/edit">فتح الحساب</a><% } %></div>
        </article>
        <% }); %>
        <% if(!teamEmployees.length) { %><p class="am-empty">لا يوجد موظفون مسجلون لهذا المنفذ.</p><% } %>
    </div>
</section>
<details class="am-detail-panel am-team-extra"><summary><span><i class="fa-solid fa-wallet" aria-hidden="true"></i> توزيع الرصيد والمنفذون الخارجيون</span><small>الأرصدة الفردية والمجموعات المشتركة</small></summary><%- include('admin_executor_balance_distribution') %></details>
<% if(isMaster && !bot.isManagerBot) { %><details class="am-detail-panel am-team-extra"><summary><span><i class="fa-solid fa-user-shield" aria-hidden="true"></i> صلاحيات التنفيذ للموظفين</span><small>إعدادات كل منفذ وواجهته</small></summary><%- include('admin_executor_employee_policies') %></details><% } %>
