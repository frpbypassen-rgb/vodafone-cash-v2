<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <title>مراقبة العمليات الحية | الأهرام Pay</title>
    <script>
        (function () {
            const mode = localStorage.getItem('ahram_theme_mode');
            let theme = localStorage.getItem('ahram_theme') || 'dark';
            if (mode === 'auto' || !localStorage.getItem('ahram_theme')) {
                const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Tripoli', hour: '2-digit', hourCycle: 'h23' }).format(new Date()));
                const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                theme = (hour >= 19 || hour < 7 || prefersDark) ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        :root{--live-card:#fff;--live-soft:#f4f7fb;--live-line:#e3e9f2;--live-text:#142036;--live-muted:#708198;--live-blue:#2563eb;--live-green:#059669;--live-red:#dc2626;--live-amber:#d97706}
        [data-theme=dark]{--live-card:#101c2e;--live-soft:#14243a;--live-line:#263a55;--live-text:#eef5ff;--live-muted:#91a5bd;--live-blue:#60a5fa;--live-green:#34d399;--live-red:#fb7185;--live-amber:#fbbf24}
        body{background:var(--body-bg);color:var(--live-text)}.live-shell{max-width:1900px;margin:auto;padding-bottom:35px}.mono{font-family:'JetBrains Mono',monospace;direction:ltr;display:inline-block}
        .live-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin:18px 0;padding:20px 22px;border:1px solid var(--live-line);border-radius:20px;background:var(--live-card)}.live-head h1{font-size:1.3rem;font-weight:900;margin:0}.live-head p{font-size:.76rem;color:var(--live-muted);margin:5px 0 0}.connection{display:flex;align-items:center;gap:7px;color:var(--live-green);font-weight:900;font-size:.72rem}.connection:before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor;box-shadow:0 0 0 5px color-mix(in srgb,currentColor 15%,transparent)}.connection.off{color:var(--live-amber)}
        .alert-strip{display:none;margin-bottom:12px;padding:12px 15px;border:1px solid rgba(220,38,38,.25);border-radius:13px;background:rgba(220,38,38,.09);color:var(--live-red);font-weight:900}.alert-strip.show{display:block}
        .metric-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:11px;margin-bottom:13px}.metric{position:relative;padding:15px 54px 14px 14px;border:1px solid var(--live-line);border-radius:16px;background:var(--live-card)}.metric i{position:absolute;right:14px;top:18px;color:var(--live-blue)}.metric span{display:block;color:var(--live-muted);font-size:.66rem;font-weight:800}.metric strong{display:block;margin-top:5px;font:800 1.05rem 'JetBrains Mono';direction:ltr;text-align:right}.metric.success strong{color:var(--live-green)}.metric.pending strong{color:var(--live-amber)}
        .filters{display:grid;grid-template-columns:minmax(210px,1.5fr) repeat(4,minmax(130px,.7fr)) auto;gap:9px;padding:13px;margin-bottom:13px;border:1px solid var(--live-line);border-radius:16px;background:var(--live-card)}.filters input,.filters select{height:42px;border:1px solid var(--live-line);border-radius:10px;padding:0 11px;background:var(--live-soft);color:var(--live-text);font-size:.74rem;font-weight:700}.filter-actions{display:flex;gap:7px}.live-btn{height:42px;border:1px solid var(--live-line);border-radius:10px;padding:0 13px;background:var(--live-soft);color:var(--live-text);font-size:.72rem;font-weight:900;white-space:nowrap}.live-btn.primary{border-color:#2563eb;background:#2563eb;color:#fff}.custom-range{display:none;grid-column:1/-1;grid-template-columns:1fr 1fr;gap:9px}.custom-range.show{display:grid}
        .table-box{border:1px solid var(--live-line);border-radius:18px;background:var(--live-card);overflow:hidden}.table-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--live-line)}.table-head h2{font-size:.9rem;font-weight:900;margin:0}.table-head small{color:var(--live-muted)}.scroll{overflow:auto;max-height:calc(100vh - 365px);min-height:330px}.live-table{width:100%;min-width:1120px;border-collapse:separate;border-spacing:0}.live-table th{position:sticky;top:0;z-index:2;padding:11px;background:var(--live-soft);color:var(--live-muted);font-size:.65rem;text-align:right}.live-table td{padding:12px 11px;border-top:1px solid var(--live-line);font-size:.72rem;vertical-align:middle}.live-table tbody tr{cursor:pointer;transition:.15s}.live-table tbody tr:hover{background:color-mix(in srgb,var(--live-blue) 7%,transparent)}.live-table tbody tr.flash{animation:flash 1.2s ease}.risk-row{box-shadow:inset -3px 0 var(--live-amber)}@keyframes flash{50%{background:rgba(37,99,235,.22)}}.status{display:inline-flex;padding:5px 8px;border-radius:999px;font-size:.62rem;font-weight:900}.s-completed,.s-deposit,.s-deduction{color:var(--live-green);background:color-mix(in srgb,var(--live-green) 12%,transparent)}.s-rejected,.s-cancelled_by_admin{color:var(--live-red);background:color-mix(in srgb,var(--live-red) 12%,transparent)}.s-pending,.s-processing,.s-accepted,.s-deposit_pending{color:var(--live-amber);background:color-mix(in srgb,var(--live-amber) 12%,transparent)}.risk{color:var(--live-amber)}.pager{display:flex;justify-content:center;padding:12px}.empty{text-align:center;padding:60px 20px;color:var(--live-muted)}
        .flyout-backdrop{position:fixed;inset:0;z-index:1040;background:rgba(2,8,23,.55);opacity:0;visibility:hidden;transition:.2s}.flyout-backdrop.open{opacity:1;visibility:visible}.flyout{position:fixed;z-index:1050;top:0;bottom:0;left:0;width:min(520px,100%);padding:20px;overflow:auto;background:var(--live-card);color:var(--live-text);transform:translateX(-105%);transition:.25s}.flyout.open{transform:none}.flyout-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.flyout h2{font-size:1.12rem;font-weight:900}.close-flyout{width:36px;height:36px;border:1px solid var(--live-line);border-radius:10px;background:var(--live-soft);color:var(--live-text)}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:15px 0}.detail-card{padding:11px;border:1px solid var(--live-line);border-radius:11px;background:var(--live-soft)}.detail-card span{display:block;color:var(--live-muted);font-size:.63rem}.detail-card strong{display:block;margin-top:4px;font-size:.77rem}.section-title{margin:18px 0 10px;font-size:.8rem;font-weight:900}.timeline{position:relative;padding-right:20px}.timeline:before{content:"";position:absolute;right:6px;top:8px;bottom:8px;width:2px;background:var(--live-line)}.event{position:relative;padding:0 7px 14px}.event:before{content:"";position:absolute;right:-18px;top:5px;width:10px;height:10px;border:2px solid var(--live-card);border-radius:50%;background:var(--live-green)}.event.error:before{background:var(--live-red)}.event strong,.event time{display:block}.event strong{font-size:.72rem}.event time{margin-top:3px;color:var(--live-muted);font:.61rem 'JetBrains Mono';direction:ltr;text-align:right}.error-box{padding:12px;border-radius:11px;background:rgba(220,38,38,.1);color:var(--live-red);font-size:.72rem}.flyout-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
        @media(max-width:1200px){.metric-grid{grid-template-columns:repeat(3,1fr)}.filters{grid-template-columns:1fr 1fr 1fr}.filter-actions{grid-column:1/-1}}
        @media(max-width:700px){.main-content{padding:9px!important}.live-head{padding:15px;margin:8px 0 11px}.live-head p{display:none}.metric-grid{grid-template-columns:1fr 1fr;gap:7px}.metric{padding:12px 43px 11px 9px}.metric i{right:11px;top:15px}.metric strong{font-size:.88rem}.filters{grid-template-columns:1fr 1fr;padding:9px}.filters input:first-child{grid-column:1/-1}.filter-actions{display:grid;grid-template-columns:1fr 1fr}.live-btn{padding:0 8px}.scroll{max-height:none}.live-table{min-width:980px}.flyout{padding:16px}.detail-grid{grid-template-columns:1fr}}
        .filters-toolbar{display:grid;grid-template-columns:minmax(210px,1.5fr) minmax(140px,.7fr) auto;gap:9px;padding:13px;margin-bottom:13px;border:1px solid var(--live-line);border-radius:16px;background:var(--live-card)}
        .filters-toolbar input,.filters-toolbar select{height:42px;border:1px solid var(--live-line);border-radius:10px;padding:0 11px;background:var(--live-soft);color:var(--live-text);font-size:.74rem;font-weight:700}
        .filters.can-collapse{grid-template-columns:repeat(3,minmax(130px,1fr)) auto}
        @media(max-width:700px){.filters-toolbar{grid-template-columns:1fr;padding:9px}}
    </style>
</head>
<body>
<button class="mobile-nav-toggle no-print" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button><div class="sidebar-overlay no-print" onclick="toggleSidebar()"></div>
<%- include('partials/sidebar', { activePage: 'transactions_live' }) %>
<main class="main-content"><div class="container-fluid live-shell">
    <header class="live-head"><div><h1><i class="fa-solid fa-wave-square ms-2 text-primary"></i>مراقبة العمليات الحية</h1><p data-focus-hide>بحث وتحليل وتفاصيل فورية دون مغادرة الصفحة</p></div><div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" class="live-btn js-admin-focus-toggle" aria-pressed="false"><i class="fa-solid fa-crosshairs ms-1"></i><span data-focus-label>وضع التركيز</span></button>
        <button type="button" class="live-btn js-admin-cinema-toggle" aria-pressed="false"><i class="fa-solid fa-film ms-1"></i><span data-cinema-label>الوضع السينمائي</span></button>
        <button type="button" class="live-btn" id="copyLink">نسخ الرابط</button>
        <button type="button" class="live-btn" id="voiceSearch"><i class="fa-solid fa-microphone ms-1"></i>بحث صوتي</button>
        <% if (typeof capabilities !== 'undefined' && capabilities.emergencyHalt) { %><button type="button" class="live-btn panic-btn" id="panicBtn"><span id="panicState">إيقاف التحويلات</span></button><% } %>
        <div id="connection" class="connection off">جارِ الاتصال</div>
    </div></header>
    <div id="failureAlert" class="alert-strip"><i class="fa-solid fa-triangle-exclamation ms-2"></i><span></span></div>
    <div id="congestionBanner" class="alert-strip" style="border-color:rgba(217,119,6,.3);background:rgba(217,119,6,.1);color:var(--live-amber)"><i class="fa-solid fa-chart-line ms-2"></i><span></span></div>
    <div id="haltBanner" class="alert-strip"><i class="fa-solid fa-hand ms-2"></i><span></span></div>
    <small id="voiceStatus" class="geo-meta"></small>
    <section class="ops-watchdog" id="opsWatchdog" data-cinema-hide></section>
    <section class="metric-grid" data-focus-hide>
        <div class="metric"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>إجمالي تحويلات اليوم</span><strong id="metricTotal">0</strong></div>
        <div class="metric"><i class="fa-solid fa-coins"></i><span>السيولة المتداولة</span><strong id="metricLiquidity">0 ج.م</strong></div>
        <div class="metric success"><i class="fa-solid fa-circle-check"></i><span>نسبة النجاح</span><strong id="metricSuccess">100%</strong></div>
        <div class="metric pending"><i class="fa-solid fa-hourglass-half"></i><span>معلقة / معالجة</span><strong id="metricPending">0</strong></div>
        <div class="metric"><i class="fa-solid fa-stopwatch"></i><span>متوسط التنفيذ</span><strong id="metricDuration">—</strong></div>
    </section>
    <section class="geo-card" id="geoHeatmapCard" data-focus-hide>
        <header>
            <h2><i class="fa-solid fa-map-location-dot ms-1 text-danger"></i>خريطة حرارية لمصدر العمليات</h2>
            <select id="geoWindow" class="live-btn" style="height:34px;">
                <option value="15m" selected>آخر 15 دقيقة</option>
                <option value="1h">آخر ساعة</option>
                <option value="24h">آخر 24 ساعة</option>
            </select>
        </header>
        <div id="geoHeatmap"><div class="geo-empty">جاري تحميل الإشارة الجغرافية...</div></div>
    </section>
    <section class="filters-toolbar" id="liveToolbar">
        <input id="filterSearch" placeholder="رقم الهاتف، العميل، المرجع أو المحفظة" autocomplete="off">
        <select id="filterStatus"><option value="">كل الحالات</option><option value="success">ناجحة</option><option value="failed">فاشلة</option><option value="pending">معلقة</option><option value="cancelled">ملغاة</option></select>
        <div class="filter-actions">
            <button type="button" id="toggleFilters" class="live-btn">الفلاتر</button>
            <button id="resetFilters" class="live-btn">مسح</button>
            <button id="exportCsv" class="live-btn primary" data-focus-hide><i class="fa-solid fa-file-csv ms-1"></i>تصدير الظاهر</button>
        </div>
    </section>
    <section class="filters can-collapse" id="liveFilters">
        <select id="filterType"><option value="">كل الأنواع</option><option value="cash_transfer">كل التحويلات النقدية</option><option value="vodafone">محفظة إلكترونية</option><option value="post_account">حساب بريدي</option><option value="post_card">بطاقة بريدية</option><option value="bank_account">حساب بنكي</option><option value="deposit">إيداع</option><option value="deduction">خصم رصيد</option><option value="internal_transfer">تحويل داخلي</option></select>
        <select id="filterRange"><option value="1h">آخر ساعة</option><option value="24h" selected>آخر 24 ساعة</option><option value="all">كل الوقت</option><option value="custom">نطاق مخصص</option></select>
        <input id="filterMin" type="number" min="0" placeholder="المبلغ من (مثال 10000)">
        <div id="customRange" class="custom-range"><input id="filterFrom" type="datetime-local"><input id="filterTo" type="datetime-local"></div>
    </section>
    <section class="ops-timeflow" id="opsTimeflow" aria-label="البصمة الزمنية"></section>
    <section class="table-box"><header class="table-head"><h2>العمليات</h2><small id="resultCount">جاري التحميل...</small></header><div class="scroll"><table class="live-table"><thead><tr><th></th><th>المرجع</th><th>العميل</th><th>المستلم</th><th>النوع</th><th>المبلغ</th><th>المنفذ</th><th>الحالة</th><th>الأمان</th><th>الوقت</th></tr></thead><tbody id="rows"></tbody></table><div id="empty" class="empty" hidden>لا توجد عمليات مطابقة</div></div><div class="pager"><button id="loadMore" class="live-btn" hidden>تحميل المزيد</button></div></section>
</div></main>
<div id="flyoutBackdrop" class="flyout-backdrop"></div><aside id="flyout" class="flyout" aria-hidden="true"><div class="flyout-top"><div><small class="text-muted">تفاصيل العملية</small><h2 id="detailReference" class="mono">—</h2></div><button id="closeFlyout" class="close-flyout"><i class="fa-solid fa-xmark"></i></button></div><div id="detailBody"></div></aside>
<div id="opsFab" class="ops-fab" aria-live="polite">
    <span id="fabCount">0 محدد</span>
    <button type="button" id="fabLink">نسخ العرض</button>
    <button type="button" id="fabExport">تصدير المحدد</button>
    <button type="button" id="fabAssign" data-need="manage">إسناد متابعة</button>
</div>
<div id="haltModal" class="halt-modal" hidden>
    <form class="behavior-card" style="max-width:420px;width:100%;" onsubmit="return false;">
        <h2>إيقاف التحويلات الصادرة</h2>
        <p class="geo-meta">يوقف إنشاء التحويلات الجديدة فقط (isManualClosed). لا يلغي العمليات الجارية ولا يفعّل إغلاق الأمن. المدير الأساسي فقط، مع عبارة تأكيد وكلمة المرور.</p>
        <label class="d-block mt-2 small fw-bold">عبارة التأكيد: إيقاف التحويلات</label>
        <input id="haltPhrase" class="form-control mb-2" autocomplete="off">
        <label class="d-block small fw-bold">كلمة مرور المدير</label>
        <input id="haltPassword" type="password" class="form-control mb-2">
        <label class="d-block small fw-bold">السبب</label>
        <input id="haltReason" class="form-control mb-2" maxlength="300">
        <div id="haltError" class="text-danger small fw-bold mb-2"></div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" id="haltConfirm" class="live-btn panic-btn">تأكيد الإيقاف</button>
            <button type="button" id="haltLift" class="live-btn">رفع الإيقاف</button>
            <button type="button" id="haltCancel" class="live-btn">إلغاء</button>
        </div>
    </form>
</div>
<script>window.__opsCapabilities = <%- JSON.stringify(typeof capabilities === 'undefined' ? {} : capabilities) %>;</script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/admin-ops-tools.js"></script>
<script src="/js/admin-ops-live.js"></script>
</body></html>
