<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>مراقبة العمليات الحية | الأهرام Pay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet">
<%- include('partials/admin_modern_head') %>
    <link rel="stylesheet" href="/css/live-operations.css?v=20261120-4">
</head>
<body>
<button class="mobile-nav-toggle no-print" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button><div class="sidebar-overlay no-print" onclick="toggleSidebar()"></div>
<%- include('partials/sidebar', { activePage: 'transactions_live' }) %>
<main class="main-content"><div class="container-fluid live-shell">
    <section class="live-overview" aria-labelledby="liveTitle">
        <header class="live-heading">
            <h1 id="liveTitle"><i class="fa-solid fa-wave-square" aria-hidden="true"></i> المراقبة الحية</h1>
            <div id="connection" class="connection off" role="status">جارٍ الاتصال</div>
        </header>
        <dl class="live-metrics">
            <div><dt><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i> تحويلات اليوم</dt><dd id="metricTotal">—</dd></div>
            <div><dt><i class="fa-solid fa-coins" aria-hidden="true"></i> السيولة المتداولة</dt><dd id="metricLiquidity">—</dd></div>
            <div class="metric-positive"><dt><i class="fa-solid fa-circle-check" aria-hidden="true"></i> نسبة النجاح</dt><dd id="metricSuccess">—</dd></div>
            <div class="metric-waiting"><dt><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> معلّقة أو قيد المعالجة</dt><dd id="metricPending">—</dd></div>
            <div><dt><i class="fa-solid fa-stopwatch" aria-hidden="true"></i> متوسط التنفيذ</dt><dd id="metricDuration">—</dd></div>
        </dl>
    </section>
    <div id="failureAlert" class="alert-strip" role="status" hidden><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span></span></div>

    <section class="live-filters" aria-label="تصفية العمليات الحية">
        <div class="live-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="filterSearch" type="search" placeholder="المرجع، العميل أو المحفظة" aria-label="البحث بالمرجع أو العميل أو المحفظة" autocomplete="off"></div>
        <select id="filterStatus" aria-label="الحالة"><option value="">كل الحالات</option><option value="success">ناجحة</option><option value="failed">فاشلة</option><option value="pending">معلقة</option><option value="cancelled">ملغاة</option></select>
        <select id="filterType" aria-label="النوع"><option value="">كل الأنواع</option><option value="cash_transfer">كل التحويلات النقدية</option><option value="vodafone">محفظة إلكترونية</option><option value="post_account">حساب بريدي</option><option value="post_card">بطاقة بريدية</option><option value="bank_account">حساب بنكي</option><option value="deposit">إيداع</option><option value="deduction">خصم رصيد</option><option value="internal_transfer">تحويل داخلي</option></select>
        <select id="filterRange" aria-label="الفترة"><option value="1h">آخر ساعة</option><option value="24h" selected>آخر 24 ساعة</option><option value="all">كل الوقت</option><option value="custom">نطاق مخصص</option></select>
        <input id="filterMin" type="number" min="0" placeholder="الحد الأدنى للمبلغ" aria-label="الحد الأدنى للمبلغ بالجنيه المصري">
        <div class="live-filter-actions">
            <button type="button" id="resetFilters" class="live-btn" aria-label="مسح الفلاتر">مسح</button>
            <button type="button" id="exportCsv" class="live-btn primary"><i class="fa-solid fa-download" aria-hidden="true"></i> تصدير CSV</button>
        </div>
        <div id="customRange" class="custom-range" hidden>
            <label>من<input id="filterFrom" type="datetime-local"></label>
            <label>إلى<input id="filterTo" type="datetime-local"></label>
        </div>
    </section>
    <section class="live-results" aria-labelledby="liveResultsTitle">
        <header class="live-results-heading">
            <h2 id="liveResultsTitle"><i class="fa-solid fa-list-ul" aria-hidden="true"></i> العمليات</h2>
            <output id="resultCount" role="status">جارٍ التحميل…</output>
        </header>
        <div class="live-results-scroll am-keep-table">
            <table class="live-table" role="table">
                <thead role="rowgroup"><tr role="row"><th scope="col">المرجع</th><th scope="col">العميل</th><th scope="col">المستلم</th><th scope="col">النوع</th><th scope="col">المبلغ</th><th scope="col">المنفذ</th><th scope="col">الحالة</th><th scope="col">الأمان</th><th scope="col">الوقت</th></tr></thead>
                <tbody id="rows" role="rowgroup"></tbody>
            </table>
            <div id="empty" class="live-empty" hidden><i class="fa-solid fa-inbox" aria-hidden="true"></i> لا توجد عمليات مطابقة</div>
        </div>
        <div class="pager"><button type="button" id="loadMore" class="live-btn" hidden>تحميل المزيد</button></div>
    </section>
</div></main>
<div id="flyoutBackdrop" class="flyout-backdrop"></div>
<aside id="flyout" class="flyout" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="liveDetailTitle detailReference" inert>
    <header class="flyout-top">
        <div>
            <h2 id="liveDetailTitle"><i class="fa-solid fa-receipt" aria-hidden="true"></i> تفاصيل العملية</h2>
            <p id="detailReference" class="mono">—</p>
        </div>
        <button type="button" id="closeFlyout" class="close-flyout" aria-label="إغلاق التفاصيل"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </header>
    <div id="detailSummary" class="detail-summary-slot" hidden></div>
    <div id="detailTabs" class="detail-tabs" role="tablist" aria-label="أقسام تفاصيل العملية" hidden>
        <button type="button" role="tab" id="detailTabJourney" aria-controls="detailJourney" aria-selected="true"><i class="fa-solid fa-route" aria-hidden="true"></i> المسار</button>
        <button type="button" role="tab" id="detailTabFinance" aria-controls="detailFinance" aria-selected="false" tabindex="-1"><i class="fa-solid fa-wallet" aria-hidden="true"></i> الحسابات</button>
        <button type="button" role="tab" id="detailTabRecord" aria-controls="detailRecord" aria-selected="false" tabindex="-1"><i class="fa-solid fa-database" aria-hidden="true"></i> بيانات الحفظ</button>
    </div>
    <div id="detailBody" class="live-detail-body"></div>
    <footer id="detailActions" class="flyout-actions" hidden></footer>
</aside>
<script src="/socket.io/socket.io.js"></script>
<script>
const state={page:1,pages:1,loading:false,pendingRefresh:false,latestId:'',refreshTimer:null,detailTrigger:null,detailRequest:null};
const byId=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
const number=value=>Number(value||0).toLocaleString('en-US',{maximumFractionDigits:2});
const dateFormatter = new Intl.DateTimeFormat('ar-LY', { dateStyle:'short', timeStyle:'short', timeZone:'Africa/Tripoli' });
const timelineDateFormatter = new Intl.DateTimeFormat('ar-LY', { dateStyle:'short', timeStyle:'medium', timeZone:'Africa/Tripoli' });
const date = (value, formatter = dateFormatter) => value && Number.isFinite(new Date(value).getTime()) ? formatter.format(new Date(value)) : '—';
const typeLabels = new Map([...byId('filterType').options].filter(option => option.value).map(option => [option.value, option.textContent]));
const typeLabel = type => typeLabels.get(type === 'balance_transfer' ? 'internal_transfer' : type) || type;
const statusLabels={pending:'معلق',processing:'قيد المعالجة',accepted:'مقبول',completed:'ناجح',rejected:'فشل',deposit_pending:'إيداع معلق',deposit:'إيداع',deduction:'سحب',cancelled_by_admin:'ملغي'};
function toggleSidebar(){document.querySelector('.sidebar')?.classList.toggle('active');document.querySelector('.sidebar-overlay')?.classList.toggle('active')}
function queryParams(page=1){const params=new URLSearchParams({page,limit:40,range:byId('filterRange').value});const values={q:byId('filterSearch').value,status:byId('filterStatus').value,type:byId('filterType').value,minAmount:byId('filterMin').value};Object.entries(values).forEach(([key,value])=>{if(value.trim())params.set(key,value.trim())});if(params.get('range')==='custom'){if(byId('filterFrom').value)params.set('from',new Date(byId('filterFrom').value).toISOString());if(byId('filterTo').value)params.set('to',new Date(byId('filterTo').value).toISOString())}return params}
function duration(ms){if(!ms)return'—';if(ms<60000)return`${(ms/1000).toFixed(1)} ث`;return`${(ms/60000).toFixed(1)} د`}
function renderMetrics(metrics) {
    byId('metricTotal').textContent = number(metrics.total);
    byId('metricLiquidity').textContent = `${number(metrics.liquidity)} ج.م`;
    byId('metricSuccess').textContent = `${Number(metrics.successRate || 0).toFixed(1)}%`;
    byId('metricPending').textContent = number(metrics.pending);
    byId('metricDuration').textContent = duration(metrics.averageDurationMs);
    const alert = byId('failureAlert');
    alert.hidden = metrics.alert !== true;
    alert.querySelector('span').textContent = `نسبة الفشل خلال آخر 5 دقائق ${Number(metrics.failureRate5m || 0).toFixed(1)}% — تحتاج مراجعة فورية.`;
}
function riskLabels(security) {
    return [security?.largeAmount && 'مبلغ كبير', security?.newDevice && 'جهاز جديد'].filter(Boolean);
}
function statusHtml(status) {
    return `<span class="status s-${esc(status)}">${esc(statusLabels[status] || status || 'غير محددة')}</span>`;
}
const amountCurrencyLabel = row => !row.amountCurrency || row.amountCurrency === 'EGP' ? 'ج.م' : esc(row.amountCurrency);
function rowHtml(row) {
    const risks = riskLabels(row.security);
    return `<tr role="row" data-id="${esc(row.id)}" class="${row.security?.flagged ? 'risk-row' : ''}">
        <td role="cell" class="live-row-ref"><button type="button" class="live-reference" aria-label="عرض تفاصيل ${esc(row.reference)}"><bdi class="mono">${esc(row.reference)}</bdi><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button></td>
        <td role="cell" class="live-row-customer" data-label="العميل">${esc(row.customer)}</td>
        <td role="cell" class="live-row-recipient" data-label="المستلم"><bdi class="mono">${esc(row.recipient)}</bdi></td>
        <td role="cell" class="live-row-type" data-label="النوع">${esc(typeLabel(row.type) || '—')}</td>
        <td role="cell" class="live-row-amount"><strong><bdi class="mono">${number(row.amount)}</bdi> <small>${amountCurrencyLabel(row)}</small></strong></td>
        <td role="cell" class="live-row-executor" data-label="المنفذ">${esc(row.executor)}</td>
        <td role="cell" class="live-row-status">${statusHtml(row.status)}</td>
        <td role="cell" class="live-row-risk${risks.length ? '' : ' risk-empty'}">${risks.length ? `<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> ${esc(risks.join('، '))}` : '—'}</td>
        <td role="cell" class="live-row-date">${date(row.createdAt)}</td>
    </tr>`;
}
async function load(reset = true) {
    if (state.loading) {
        if (reset) state.pendingRefresh = true;
        return;
    }
    state.loading = true;
    const more = byId('loadMore');
    more.disabled = true;
    try {
        const nextPage = reset ? 1 : state.page + 1;
        const response = await fetch('/api/transactions/live?' + queryParams(nextPage), { headers:{ Accept:'application/json' } });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'تعذر تحميل العمليات.');
        const body = byId('rows');
        const focusedRow = body.contains(document.activeElement) ? document.activeElement.closest('tr[data-id]') : null;
        if (reset) body.innerHTML = '';
        body.insertAdjacentHTML('beforeend', data.rows.map(rowHtml).join(''));
        if (reset && focusedRow) {
            const replacement = [...body.rows].find(row => row.dataset.id === focusedRow.dataset.id);
            (replacement?.querySelector('.live-reference') || byId('filterSearch')).focus({ preventScroll:true });
        }
        if (reset && data.rows[0]?.id && data.rows[0].id !== state.latestId) {
            body.querySelector('tr')?.classList.add('flash');
            state.latestId = data.rows[0].id;
        }
        state.page = data.pagination.page;
        state.pages = data.pagination.pages;
        byId('resultCount').textContent = `${number(data.pagination.total)} عملية`;
        byId('empty').hidden = data.pagination.total > 0;
        more.hidden = state.page >= state.pages;
        renderMetrics(data.metrics);
    } catch (error) {
        byId('resultCount').textContent = error.message;
    } finally {
        more.disabled = false;
        state.loading = false;
        if (state.pendingRefresh) {
            state.pendingRefresh = false;
            load(true);
        }
    }
}
function scheduleLoad(){clearTimeout(state.refreshTimer);state.refreshTimer=setTimeout(()=>load(true),350)}
function moneyText(value, currency) {
    if (value == null) return '—';
    return `<bdi>${number(value)} ${esc(currency)}</bdi>`;
}
function renderFinance(finance, tx) {
    if (!finance) return '<p class="detail-note">لا تتوفر بيانات الحسابات لهذه العملية.</p>';
    const movements = finance.movements || [];
    return `<section class="detail-panel" aria-labelledby="detailFinanceTitle">
        <h3 id="detailFinanceTitle"><i class="fa-solid fa-wallet" aria-hidden="true"></i> حركة الحسابات</h3>
        ${tx.costLYD > 0 || tx.exchangeRate > 0 ? `<dl class="detail-amount-meta detail-fields">
            ${tx.costLYD > 0 ? `<div><dt>التكلفة</dt><dd><bdi>${number(tx.costLYD)}</bdi> د.ل</dd></div>` : ''}
            ${tx.exchangeRate > 0 ? `<div><dt>سعر الصرف</dt><dd><bdi>${number(tx.exchangeRate)}</bdi></dd></div>` : ''}
        </dl>` : ''}
        ${!finance.available ? '<p class="detail-note">تُعرض القيود لصلاحية قراءة التقارير المالية.</p>' :
            movements.length ? `<ul class="detail-movements">${movements.map(movement => `
                <li class="movement movement-${esc(movement.kind)}">
                    <div class="movement-top">
                        <strong>${esc(movement.label)} · ${esc(movement.account)}</strong>
                        <strong>${moneyText(movement.amount, movement.currency)}</strong>
                    </div>
                    ${movement.accountName ? `<p class="detail-note">${esc(movement.accountName)}</p>` : ''}
                    <dl class="detail-fields">
                        <div><dt>الرصيد قبل</dt><dd>${moneyText(movement.balanceBefore, movement.currency)}</dd></div>
                        <div><dt>الرصيد بعد</dt><dd>${moneyText(movement.balanceAfter, movement.currency)}</dd></div>
                    </dl>
                    <time>${date(movement.at, timelineDateFormatter)}</time>
                </li>`).join('')}</ul>` : '<p class="detail-note">لا توجد قيود مالية مرتبطة في دفتر الحسابات.</p>'}
        ${finance.available && tx.status === 'cancelled_by_admin' && !movements.some(row => row.kind === 'refund')
            ? '<p class="detail-note">لا يظهر قيد رد رصيد مسجّل لهذه العملية.</p>' : ''}
        ${finance.truncated ? '<p class="detail-note">تُعرض أول 200 حركة مرتبطة.</p>' : ''}
    </section>`;
}
function renderTimeline(timeline, movements, truncated) {
    const movementById = new Map(movements.map(row => [row.id, row]));
    if (!timeline.length) return '<p class="detail-note">لا توجد أحداث مسجلة.</p>';
    return `<ol class="timeline">${timeline.map(item => {
        const movement = movementById.get(item.movementId);
        const executorLabel = item.kind === 'admin_pulled' ? 'سُحبت من' : 'حساب التنفيذ';
        const tone = item.state === 'error' || ['cancelled', 'rejected'].includes(item.kind) ? 'error'
            : item.kind === 'admin_pulled' ? 'event-pull'
                : ['completed','refund'].includes(item.kind) ? 'event-done' : '';
        const context = [
            item.actor && `بواسطة <bdi>${esc(item.actor)}</bdi>`,
            item.executor && item.executor !== item.actor && `${executorLabel} <bdi>${esc(item.executor)}</bdi>`,
            item.previousRouter && `التوجيه السابق بواسطة <bdi>${esc(item.previousRouter)}</bdi>`,
            item.previousExecutor && `المنفذ السابق <bdi>${esc(item.previousExecutor)}</bdi>`,
            movement && `${esc(movement.accountName || movement.account)} · ${moneyText(movement.amount, movement.currency)}`
        ].filter(Boolean).join(' · ');
        return `<li class="event ${tone}">
            <div class="event-head">
                <strong><bdi>${esc(item.label)}</bdi></strong>
                <span>${item.at ? date(item.at, timelineDateFormatter) : 'وقت غير مسجّل'}</span>
            </div>
            ${context ? `<p>${context}</p>` : ''}
        </li>`;
    }).join('')}</ol>${truncated ? '<p class="detail-note">تُعرض أول 200 نتيجة من سجل التدقيق.</p>' : ''}`;
}
function showDetailTab(tab, focus = false) {
    for (const candidate of byId('detailTabs').querySelectorAll('[role="tab"]')) {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
        byId(candidate.getAttribute('aria-controls')).hidden = !selected;
    }
    byId('detailBody').scrollTop = 0;
    if (focus) tab.focus();
}
function renderDetail(data) {
    const tx = data.transaction;
    const audit = data.audit || {};
    const parties = data.parties || {};
    const risks = riskLabels(tx.security);
    const lifecycle = data.lifecycle || {};
    const source = lifecycle.source;
    const record = lifecycle.record;

    byId('detailReference').textContent = tx.reference || '—';
    byId('detailSummary').innerHTML = `
        <section class="live-detail-summary" aria-label="ملخص العملية">
            <div>
                <div class="detail-summary-amount"><bdi class="mono">${number(tx.amount)}</bdi> <small>${amountCurrencyLabel(tx)}</small></div>
                <div class="detail-summary-type">${esc(typeLabel(tx.type) || 'العملية')}${source ? ` · ${esc(source.label)}` : ''}</div>
            </div>
            ${statusHtml(tx.status)}
            <div class="detail-summary-time">
                <i class="fa-regular fa-clock" aria-hidden="true"></i> ${date(tx.createdAt)}
                ${tx.durationMs != null ? ` · مدة التنفيذ ${tx.durationMs === 0 ? '0 ث' : duration(tx.durationMs)}` : ''}
            </div>
        </section>`;
    byId('detailSummary').hidden = false;
    byId('detailBody').innerHTML = `
        <section id="detailJourney" class="detail-tabpanel" role="tabpanel" tabindex="0" aria-labelledby="detailTabJourney">
            ${data.error ? `<section class="error-box" aria-labelledby="detailErrorTitle">
                <h3 id="detailErrorTitle"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> سبب الفشل</h3>
                <p>${esc(data.error.message || 'تعذر إتمام العملية.')}</p>
                ${data.error.code ? `<bdi>${esc(data.error.code)}</bdi>` : ''}
            </section>` : ''}
            ${renderTimeline(data.timeline || [], lifecycle.finance?.movements || [], lifecycle.historyTruncated)}
        </section>
        <section id="detailFinance" class="detail-tabpanel" role="tabpanel" tabindex="0" aria-labelledby="detailTabFinance" hidden>
            ${renderFinance(lifecycle.finance, tx)}
        </section>
        <section id="detailRecord" class="detail-tabpanel" role="tabpanel" tabindex="0" aria-labelledby="detailTabRecord" hidden>
            <section class="detail-panel" aria-labelledby="detailPartiesTitle">
                <h3 id="detailPartiesTitle"><i class="fa-solid fa-people-arrows" aria-hidden="true"></i> الأطراف والتنفيذ</h3>
                <dl class="detail-fields">
                    ${source ? `<div><dt>مصدر الطلب</dt><dd>${esc(source.label)}</dd>
                        ${source.name ? `<dd class="detail-note">${esc(source.name)}</dd>` : ''}</div>` : ''}
                    <div><dt>المرسل</dt><dd>${esc(parties.sender || tx.customer || '—')}</dd>
                        ${parties.senderActor && parties.senderActor !== parties.sender ? `<dd class="detail-note">${esc(parties.senderActor)}</dd>` : ''}</div>
                    <div><dt>المستلم</dt><dd><bdi class="mono">${esc(parties.recipient || tx.recipient || '—')}</bdi></dd></div>
                    <div><dt>المنفذ</dt><dd><bdi>${esc(tx.executor || 'غير محدد')}</bdi></dd></div>
                </dl>
            </section>
            ${record ? `<section class="detail-panel" aria-labelledby="detailRecordTitle">
                <h3 id="detailRecordTitle"><i class="fa-solid fa-database" aria-hidden="true"></i> سجل قاعدة البيانات</h3>
                <dl class="detail-fields">
                    <div><dt>رقم العملية</dt><dd><bdi>${esc(record.reference || '—')}</bdi></dd></div>
                    <div><dt>الحالة المحفوظة</dt><dd>${statusHtml(record.status)}</dd></div>
                    <div><dt>معرّف السجل</dt><dd><bdi class="mono">${esc(record.id)}</bdi></dd></div>
                    <div><dt>آخر تحديث</dt><dd>${date(record.updatedAt, timelineDateFormatter)}</dd></div>
                    ${record.cancellationNumber ? `<div><dt>رقم الإلغاء</dt><dd><bdi>${esc(record.cancellationNumber)}</bdi></dd></div>` : ''}
                </dl>
            </section>` : ''}
            <section class="detail-panel" aria-labelledby="detailAuditTitle">
                <h3 id="detailAuditTitle"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> الأمان</h3>
                ${risks.length ? `<p class="detail-risk"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> ${esc(risks.join('، '))}</p>` : ''}
                <dl class="detail-fields">
                    <div><dt>عنوان IP</dt><dd><bdi class="mono">${esc(audit.ip || 'غير مسجل')}</bdi></dd></div>
                    <div><dt>الجهاز</dt><dd>${esc(audit.deviceType || 'غير مسجل')}</dd></div>
                </dl>
            </section>
        </section>`;
    byId('detailTabs').hidden = false;
    showDetailTab(byId('detailTabJourney'));

    const actions = byId('detailActions');
    actions.innerHTML = `
        ${['pending','processing','accepted'].includes(tx.status) ? '<a class="live-btn primary" href="/transactions/pulse"><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i> فتح للتوجيه</a>' : ''}
        <a class="live-btn" target="_blank" rel="noopener" href="/transactions/live/${encodeURIComponent(tx.id)}/receipt">
            <i class="fa-solid fa-print" aria-hidden="true"></i> طباعة الإيصال
        </a>`;
    actions.hidden = false;
}
async function openDetail(id, trigger) {
    state.detailRequest?.abort();
    const request = new AbortController();
    state.detailRequest = request;
    state.detailTrigger = trigger;

    const flyout = byId('flyout');
    const body = byId('detailBody');
    byId('detailReference').textContent = trigger?.querySelector('bdi')?.textContent || '—';
    byId('detailSummary').hidden = true;
    byId('detailTabs').hidden = true;
    byId('detailActions').hidden = true;
    body.innerHTML = '<p class="detail-loading" role="status">جارٍ تحميل تفاصيل العملية…</p>';
    flyout.inert = false;
    flyout.setAttribute('aria-hidden', 'false');
    flyout.classList.add('open');
    byId('flyoutBackdrop').classList.add('open');
    body.scrollTop = 0;
    byId('closeFlyout').focus();

    try {
        const response = await fetch('/api/transactions/live/' + encodeURIComponent(id), {
            headers:{ Accept:'application/json' }, signal:request.signal
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'تعذر تحميل تفاصيل العملية.');
        if (!request.signal.aborted) renderDetail(data);
    } catch (error) {
        if (request.signal.aborted) return;
        body.innerHTML = `<div class="error-box" role="alert">
            <p>${esc(error.message || 'تعذر تحميل تفاصيل العملية.')}</p>
            <button type="button" class="live-btn" id="retryDetail">إعادة المحاولة</button>
        </div>`;
        byId('retryDetail').addEventListener('click', () => openDetail(id, trigger));
    } finally {
        if (state.detailRequest === request) state.detailRequest = null;
    }
}
function closeDetail() {
    state.detailRequest?.abort();
    const flyout = byId('flyout');
    const trigger = state.detailTrigger;
    const activeRow = trigger?.closest('tr[data-id]');
    const replacement = activeRow && [...byId('rows').rows].find(row => row.dataset.id === activeRow.dataset.id);
    (trigger?.isConnected ? trigger : replacement?.querySelector('.live-reference') || byId('filterSearch')).focus();
    flyout.classList.remove('open');
    byId('flyoutBackdrop').classList.remove('open');
    flyout.setAttribute('aria-hidden', 'true');
    flyout.inert = true;
    state.detailTrigger = null;
}
document.addEventListener('DOMContentLoaded', () => {
    const updateRange = () => { byId('customRange').hidden = byId('filterRange').value !== 'custom'; };
    const filters = ['filterSearch', 'filterStatus', 'filterType', 'filterRange', 'filterMin', 'filterFrom', 'filterTo'];
    for (const id of filters.slice(1)) {
        byId(id).addEventListener('change', () => { updateRange(); scheduleLoad(); });
    }
    byId('filterSearch').addEventListener('input', scheduleLoad);
    byId('resetFilters').addEventListener('click', () => {
        for (const id of filters) byId(id).value = id === 'filterRange' ? '24h' : '';
        updateRange();
        clearTimeout(state.refreshTimer);
        load(true);
    });
    byId('exportCsv').addEventListener('click', () => {
        const params = queryParams(1);
        params.delete('page');
        params.delete('limit');
        location.href = '/api/transactions/live-export.csv?' + params;
    });
    byId('loadMore').addEventListener('click', () => load(false));
    byId('rows').addEventListener('click', event => {
        const row = event.target.closest('tr[data-id]');
        if (row) openDetail(row.dataset.id, row.querySelector('.live-reference'));
    });
    byId('closeFlyout').addEventListener('click', closeDetail);
    byId('flyoutBackdrop').addEventListener('click', closeDetail);
    byId('detailTabs').addEventListener('click', event => {
        const tab = event.target.closest('[role="tab"]');
        if (tab) showDetailTab(tab);
    });
    byId('detailTabs').addEventListener('keydown', event => {
        const tabs = [...byId('detailTabs').querySelectorAll('[role="tab"]')];
        const index = tabs.indexOf(event.target);
        if (index < 0) return;
        const offset = { ArrowLeft:1, ArrowRight:-1 }[event.key] || 0;
        if (!offset && event.key !== 'Home' && event.key !== 'End') return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + offset + tabs.length) % tabs.length;
        showDetailTab(tabs[next], true);
    });
    byId('flyout').addEventListener('keydown', event => {
        if (event.key === 'Escape') closeDetail();
        if (event.key !== 'Tab') return;
        const controls = [...byId('flyout').querySelectorAll('button, a[href], [tabindex="0"]')]
            .filter(control => control.tabIndex >= 0 && control.getClientRects().length);
        if (event.shiftKey && document.activeElement === controls[0]) {
            event.preventDefault();
            controls.at(-1).focus();
        } else if (!event.shiftKey && document.activeElement === controls.at(-1)) {
            event.preventDefault();
            controls[0].focus();
        }
    });
    load(true);
    const initialOperation = new URLSearchParams(location.search).get('operation') || '';
    if (/^[a-f\d]{24}$/i.test(initialOperation)) openDetail(initialOperation, null);
    setInterval(() => { if (document.visibilityState === 'visible') load(true); }, 30000);
    const socket = window.io ? io({ transports: ['websocket', 'polling'] }) : null;
    if (!socket) {
        byId('connection').textContent = 'تحديث كل 30 ثانية';
        return;
    }
    socket.on('connect', () => {
        byId('connection').classList.remove('off');
        byId('connection').textContent = 'متصل لحظيًا';
        socket.emit('transactions:subscribe');
    });
    socket.on('disconnect', () => {
        byId('connection').classList.add('off');
        byId('connection').textContent = 'إعادة الاتصال';
    });
    socket.on('transactions:changed', scheduleLoad);
});
</script>
</body></html>
