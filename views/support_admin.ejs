<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>مساحة عمل الدعم | شركة الأهرام</title>
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/support-workspace.css?v=20260826-deposit-review">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
</head>
<body>
    <button class="mobile-nav-toggle" onclick="toggleSidebar()" title="فتح القائمة"><i class="fa-solid fa-bars"></i></button>
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <%- include('partials/sidebar', { activePage: 'support' }) %>

    <main class="main-content">
        <div class="support-page">
            <header class="support-topbar">
                <div class="support-title">
                    <span class="support-title-icon"><i class="fa-solid fa-headset"></i></span>
                    <div>
                        <h1>مساحة عمل الدعم</h1>
                        <p>إدارة المحادثات، بيانات الحساب، والمعاملات المرتبطة من شاشة واحدة</p>
                    </div>
                </div>
                <div class="support-actions">
                    <button type="button" class="support-icon-btn" data-action="refresh" title="تحديث البيانات"><i class="fa-solid fa-rotate-right"></i></button>
                    <button type="button" class="support-command-btn is-whatsapp" data-action="whatsapp-test" title="اختبار واتساب">
                        <i class="fa-brands fa-whatsapp"></i><span>اختبار واتساب</span>
                    </button>
                </div>
            </header>

            <section class="support-metrics" aria-label="ملخص مركز الدعم">
                <button type="button" class="support-metric" data-metric-filter="active">
                    <span class="support-metric-icon"><i class="fa-regular fa-comments"></i></span>
                    <span><span class="support-metric-label">تذاكر نشطة</span><strong class="support-metric-value" id="supportMetricActive">0</strong></span>
                </button>
                <button type="button" class="support-metric is-unread" data-metric-filter="unread">
                    <span class="support-metric-icon"><i class="fa-regular fa-envelope"></i></span>
                    <span><span class="support-metric-label">رسائل غير مقروءة</span><strong class="support-metric-value" id="supportMetricUnread">0</strong></span>
                </button>
                <button type="button" class="support-metric is-urgent" data-metric-filter="urgent">
                    <span class="support-metric-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
                    <span><span class="support-metric-label">عاجلة</span><strong class="support-metric-value" id="supportMetricUrgent">0</strong></span>
                </button>
                <button type="button" class="support-metric is-unassigned" data-metric-filter="unassigned">
                    <span class="support-metric-icon"><i class="fa-regular fa-user"></i></span>
                    <span><span class="support-metric-label">غير معيّنة</span><strong class="support-metric-value" id="supportMetricUnassigned">0</strong></span>
                </button>
                <div class="support-metric is-overdue">
                    <span class="support-metric-icon"><i class="fa-regular fa-clock"></i></span>
                    <span><span class="support-metric-label">تجاوزت الزمن</span><strong class="support-metric-value" id="supportMetricOverdue">0</strong></span>
                </div>
            </section>

            <section class="support-workspace" aria-label="إدارة تذاكر الدعم">
                <aside class="support-panel support-queue is-mobile-active" id="supportQueuePanel">
                    <div class="support-panel-heading">
                        <h2><i class="fa-solid fa-inbox"></i> صندوق المحادثات</h2>
                        <span class="support-panel-count" id="supportQueueCount">0</span>
                    </div>
                    <div class="support-queue-tools">
                        <label class="support-search" for="supportTicketSearch">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input id="supportTicketSearch" type="search" placeholder="اسم، هاتف، أو رقم تذكرة" autocomplete="off">
                        </label>
                        <div class="support-view-tabs" role="group" aria-label="نطاق التعيين">
                            <button type="button" class="support-view-tab is-active" data-assigned-filter="">الجميع</button>
                            <button type="button" class="support-view-tab" data-assigned-filter="mine">تذاكري</button>
                            <button type="button" class="support-view-tab" data-assigned-filter="unassigned">غير معيّنة</button>
                        </div>
                        <div class="support-filter-row">
                            <select id="supportStatusFilter" aria-label="تصفية حسب الحالة">
                                <option value="active">الحالات النشطة</option>
                                <option value="open">بانتظار الرد</option>
                                <option value="answered">تم الرد</option>
                                <option value="pending_internal">متابعة داخلية</option>
                                <option value="resolved">تم الحل</option>
                                <option value="closed">مغلقة</option>
                                <option value="all">كل الحالات</option>
                            </select>
                            <select id="supportPriorityFilter" aria-label="تصفية حسب الأولوية">
                                <option value="">كل الأولويات</option>
                                <option value="urgent">عاجلة</option>
                                <option value="high">مرتفعة</option>
                                <option value="normal">عادية</option>
                                <option value="low">منخفضة</option>
                            </select>
                            <select id="supportChannelFilter" aria-label="تصفية حسب القناة">
                                <option value="">كل القنوات</option>
                                <option value="whatsapp">واتساب</option>
                                <option value="portal">بوابة العميل</option>
                            </select>
                            <button type="button" class="support-icon-btn" data-action="refresh" title="تحديث القائمة"><i class="fa-solid fa-rotate"></i></button>
                        </div>
                    </div>
                    <div class="support-ticket-list" id="supportTicketList">
                        <div class="support-list-state"><i class="fa-solid fa-spinner fa-spin"></i><strong>جاري تحميل المحادثات...</strong></div>
                    </div>
                </aside>

                <section class="support-panel support-conversation" id="supportConversationPanel">
                    <div class="support-empty-state">
                        <i class="fa-regular fa-comments"></i>
                        <h3>اختر محادثة للبدء</h3>
                        <p>ستظهر الرسائل في المنتصف، بينما تُعرض بيانات الحساب وآخر العمليات في اللوحة الجانبية.</p>
                    </div>
                </section>

                <aside class="support-panel support-context" id="supportContextPanel">
                    <div class="support-panel-heading"><h2><i class="fa-regular fa-address-card"></i> سياق العميل</h2></div>
                    <div class="support-empty-state">
                        <i class="fa-regular fa-user"></i>
                        <h3>لا توجد محادثة محددة</h3>
                        <p>اختر تذكرة لعرض الحساب والمعاملات والتذاكر السابقة.</p>
                    </div>
                </aside>
            </section>
        </div>
    </main>

    <script>
        window.supportWorkspaceConfig = {
            admin: <%- JSON.stringify(supportAdmin || {}).replace(/</g, '\\u003c') %>,
            csrfToken: <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>
        };
        function toggleSidebar() {
            document.querySelector('.sidebar')?.classList.toggle('active');
            document.querySelector('.sidebar-overlay')?.classList.toggle('active');
        }
    </script>
    <script src="/js/support-workspace.js?v=20260826-deposit-review"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
