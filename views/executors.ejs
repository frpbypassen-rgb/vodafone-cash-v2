<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>حسابات التنفيذ | الأهرام</title>
    
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script>
        const csrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        /* =========================================
           ✨ 3D Modern Cards - التصميم ثلاثي الأبعاد
           ========================================= */
        .card-3d-wrapper {
            perspective: 1000px;
            height: 100%;
        }

        .bot-card-3d {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 25px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
            position: relative;
            overflow: hidden;
            border: 1px solid var(--border-glass);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            z-index: 1;
        }

        /* توهج خلفي (Glass Glow) */
        .bot-card-3d::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 60%);
            transform: rotate(45deg);
            pointer-events: none;
            z-index: -1;
        }

        [data-theme="dark"] .bot-card-3d {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        /* 🚀 تأثير الرفع والدوران (Tilt) */
        .bot-card-3d:hover {
            transform: translateY(-10px) rotateX(2deg) rotateY(-2deg);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        }

        [data-theme="dark"] .bot-card-3d:hover {
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.1);
        }

        /* 🌟 الأيقونة المتوهجة */
        .bot-icon-3d {
            width: 65px;
            height: 65px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: white;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            position: relative;
        }

        .bot-icon-3d::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: inherit;
            background: inherit;
            filter: blur(12px);
            z-index: -1;
            opacity: 0.6;
            transition: 0.3s;
        }

        .bot-card-3d:hover .bot-icon-3d::after {
            filter: blur(18px);
            opacity: 0.9;
        }

        .manager-bot-icon { background: linear-gradient(135deg, #3b82f6, #2563eb); }
        .normal-bot-icon { background: linear-gradient(135deg, #10b981, #059669); }
        .api-bot-icon { background: linear-gradient(135deg, #f59e0b, #d97706); }

        /* 💰 مربع الرصيد العميق */
        .balance-box {
            background: var(--input-bg);
            border-radius: 20px;
            padding: 20px;
            margin: 25px 0;
            border: 1px solid var(--border-glass);
            position: relative;
            overflow: hidden;
            box-shadow: inset 0 4px 10px rgba(0,0,0,0.02);
        }

        [data-theme="dark"] .balance-box {
            box-shadow: inset 0 4px 10px rgba(0,0,0,0.2);
        }

        .balance-box::after {
            content: '\f0d6';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            position: absolute;
            left: -15px;
            bottom: -20px;
            font-size: 90px;
            opacity: 0.04;
            transform: rotate(-15deg);
            color: var(--text-main);
            pointer-events: none;
        }

        .mono-num { font-family: 'JetBrains Mono', monospace; font-size: 2.2rem; font-weight: 900; line-height: 1; }

        /* 🔘 الزر التفاعلي */
        .btn-3d {
            background: var(--input-bg);
            border: 1px solid var(--border-glass);
            color: var(--text-main);
            border-radius: 16px;
            padding: 14px;
            font-weight: 800;
            transition: all 0.3s;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .btn-3d:hover {
            background: var(--brand-primary);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 26, 77, 0.3);
            border-color: var(--brand-primary);
        }

        [data-theme="dark"] .btn-3d:hover {
            background: var(--brand-gold);
            color: black;
            border-color: var(--brand-gold);
            box-shadow: 0 10px 25px rgba(212, 175, 55, 0.3);
        }

        .executor-access-bar {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 14px;
            padding: 18px;
            margin-bottom: 18px;
            background: var(--input-bg);
            border: 1px solid var(--border-glass);
            border-radius: 8px;
        }
        .executor-link-label { color: var(--text-muted); font-size: 0.78rem; font-weight: 800; margin-bottom: 7px; }
        .executor-link-input { min-width: 0; direction: ltr; text-align: left; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; }
        .copy-link-btn { width: 44px; flex: 0 0 44px; }
        @media (max-width: 767px) {
            .executor-access-bar { grid-template-columns: 1fr; padding: 14px; }
            .admin-nav { align-items: stretch !important; gap: 12px; }
            .admin-nav .btn { width: 100%; }
        }
    </style>

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Al-Ahram">
    <!-- End PWA Setup -->
</head>
<body>

<button class="mobile-nav-toggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<%- include('partials/sidebar', { activePage: 'executors' }) %>

<div class="main-content">
    <div class="container-fluid">
        <div class="admin-nav mb-4">
            <h3 class="fw-bold m-0 text-dark"><i class="fa-solid fa-network-wired text-primary me-2"></i> منفذو العمليات</h3>
            <button type="button" class="btn btn-primary fw-bold shadow-sm px-4" data-bs-toggle="modal" data-bs-target="#createExecutorModal"><i class="fa-solid fa-user-plus me-1"></i> إضافة منفذ يدوياً</button>
        </div>

        <div class="executor-access-bar" aria-label="روابط المنفذين">
            <div>
                <div class="executor-link-label"><i class="fa-solid fa-user-pen me-1"></i> رابط تقديم طلب منفذ جديد</div>
                <div class="input-group">
                    <input id="executorRegistrationUrl" class="form-control executor-link-input" value="<%= executorRegistrationUrl %>" readonly aria-label="رابط تسجيل المنفذين">
                    <a class="btn btn-outline-primary copy-link-btn" href="<%= executorRegistrationUrl %>" target="_blank" rel="noopener" title="فتح رابط التسجيل"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                    <button type="button" class="btn btn-primary copy-link-btn" onclick="copyExecutorLink('executorRegistrationUrl', 'تم نسخ رابط التسجيل')" title="نسخ رابط التسجيل"><i class="fa-regular fa-copy"></i></button>
                </div>
            </div>
            <div>
                <div class="executor-link-label"><i class="fa-solid fa-right-to-bracket me-1"></i> رابط دخول المنفذين بعد التفعيل</div>
                <div class="input-group">
                    <input id="executorLoginUrl" class="form-control executor-link-input" value="<%= executorLoginUrl %>" readonly aria-label="رابط دخول المنفذين">
                    <a class="btn btn-outline-primary copy-link-btn" href="<%= executorLoginUrl %>" target="_blank" rel="noopener" title="فتح رابط الدخول"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                    <button type="button" class="btn btn-primary copy-link-btn" onclick="copyExecutorLink('executorLoginUrl', 'تم نسخ رابط الدخول')" title="نسخ رابط الدخول"><i class="fa-regular fa-copy"></i></button>
                </div>
            </div>
        </div>

        <% if (typeof query !== 'undefined' && query.created) { %>
            <div class="alert alert-success fw-bold rounded-4 border-0 shadow-sm">
                <i class="fa-solid fa-check-circle me-1"></i> تم إنشاء منفذ التنفيذ بنجاح.
            </div>
        <% } else if (typeof query !== 'undefined' && query.createError) {
            const createErrors = {
                MISSING_NAME: 'اسم المنفذ مطلوب.',
                MISSING_LOGIN: 'بيانات دخول مسؤول المنفذ مطلوبة.',
                INVALID_MANAGER_NAME: 'يرجى إدخال اسم مسؤول المنفذ كاملاً.',
                INVALID_USERNAME: 'اسم الدخول غير صالح. استخدم حروفاً إنجليزية وأرقاماً فقط.',
                USERNAME_TAKEN: 'اسم الدخول مستخدم بالفعل.',
                INVALID_PHONE: 'رقم الهاتف غير صالح.',
                WEAK_PASSWORD: 'كلمة المرور يجب ألا تقل عن 6 أحرف.',
                INVALID_BALANCE: 'الرصيد الافتتاحي غير صالح.'
            };
        %>
            <div class="alert alert-danger fw-bold rounded-4 border-0 shadow-sm">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> <%= createErrors[query.createError] || 'تعذر إنشاء المنفذ. تأكد من البيانات وحاول مرة أخرى.' %>
            </div>
        <% } %>

        <div class="row g-4 mt-2 pb-5">
            <% if (bots.length === 0) { %>
                <div class="col-12 text-center py-5">
                    <i class="fa-solid fa-robot fa-4x text-muted opacity-25 mb-3"></i>
                    <h5 class="text-muted fw-bold">لا يوجد أي بوتات تنفيذ مسجلة حتى الآن.</h5>
                </div>
            <% } %>
            
            <% bots.forEach(bot => { %>
                <div class="col-xl-4 col-md-6">
                    <div class="card-3d-wrapper">
                        <div class="bot-card-3d" style="border-top: 5px solid <%= bot.isApiBot ? '#f59e0b' : (bot.isManagerBot ? '#3b82f6' : '#10b981') %>;">
                            
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bot-icon-3d <%= bot.isApiBot ? 'api-bot-icon' : (bot.isManagerBot ? 'manager-bot-icon' : 'normal-bot-icon') %>">
                                            <i class="fa-solid <%= bot.isApiBot ? 'fa-plug-circle-bolt' : (bot.isManagerBot ? 'fa-building' : 'fa-robot') %>"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold m-0 text-dark mb-1"><%= bot.name %></h5>
                                            <span class="badge <%= bot.status === 'active' ? 'bg-success text-success border-success' : 'bg-danger text-danger border-danger' %> bg-opacity-10 border rounded-pill px-3 py-1 mt-1" style="font-size:0.75rem;">
                                                <i class="fa-solid <%= bot.status === 'active' ? 'fa-check-circle' : 'fa-ban' %> me-1"></i><%= bot.status === 'active' ? 'مفعل ونشط' : 'متوقف' %>
                                            </span>
                                            <% if (bot.isApiBot) { %>
                                                <div class="text-muted small fw-bold mt-2">
                                                    <i class="fa-solid fa-plug me-1"></i>
                                                    <%= bot.apiProviderKey === 'zayn_external_aggregator' ? 'Zayn External Aggregator' : (bot.apiProviderKey || 'API Provider') %>
                                                </div>
                                                <% if (bot.lastApiTestAt) { %>
                                                    <div class="small mt-2 <%= bot.lastApiTestStatus === 'success' ? 'text-success' : 'text-danger' %>">
                                                        <i class="fa-solid <%= bot.lastApiTestStatus === 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation' %> me-1"></i>
                                                        آخر اختبار: <%= new Date(bot.lastApiTestAt).toLocaleString('ar-EG') %>
                                                    </div>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="balance-box text-center">
                                    <div class="text-muted small fw-bold mb-2"><i class="fa-solid fa-wallet me-1 opacity-50"></i> الرصيد / المديونية الحالية</div>
                                    <div class="mono-num <%= bot.balance < 0 ? 'text-danger' : 'text-success' %>" dir="ltr">
                                        <%= bot.balance.toFixed(2) %> <span class="fs-6 text-muted">EGP</span>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between align-items-center p-3 rounded-4 mb-3 border" style="background: rgba(0,0,0,0.02);">
                                    <span class="fw-bold small text-muted"><i class="fa-solid fa-check-double me-1 opacity-50"></i> إجمالي العمليات المنجزة</span>
                                    <span class="badge bg-primary fs-6 rounded-pill px-3 shadow-sm"><%= bot.txCount %> طلب</span>
                                </div>
                                <% if (bot.isApiBot) { %>
                                    <button type="button" class="btn-3d w-100 mb-2 api-test-btn" data-api-bot-id="<%= bot._id %>" onclick="testApiExecutor(this)">
                                        <i class="fa-solid fa-signal me-2"></i> اختبار اتصال API والرصيد
                                    </button>
                                <% } %>
                                <a href="/executor/<%= bot._id %>" class="btn-3d w-100">
                                    <i class="fa-solid fa-folder-open me-2"></i> إدارة التفاصيل والملف المحاسبي
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</div>

<div class="modal fade" id="createExecutorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="background: var(--card-bg); color: var(--text-main); border-radius: 18px;">
            <form action="/executors/add" method="POST">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-user-plus text-primary me-2"></i> إضافة منفذ تنفيذ يدوي
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">اسم المنفذ</label>
                            <input type="text" name="name" class="form-control fw-bold" required placeholder="مثال: منفذ طرابلس 1" autocomplete="organization">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-muted">نوع المنفذ</label>
                            <select name="botType" id="botType" class="form-select fw-bold">
                                <option value="normal">منفذ يدوي</option>
                                <option value="manager">مجموعة إشراف</option>
                                <option value="api">منفذ API</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-muted">الرصيد الافتتاحي</label>
                            <input type="number" step="any" name="balance" class="form-control fw-bold text-center" value="0" dir="ltr">
                        </div>

                        <div class="col-12" id="humanLoginFields">
                            <div class="p-3 rounded-4 border" style="background: var(--input-bg); border-color: var(--border-glass) !important;">
                                <div class="fw-bold mb-3"><i class="fa-solid fa-user-tie text-success me-1"></i> حساب مسؤول المنفذ</div>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small text-muted">اسم المسؤول</label>
                                        <input type="text" name="managerName" class="form-control human-required" placeholder="الاسم الثلاثي" autocomplete="name" minlength="3" required>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small text-muted">رقم الهاتف</label>
                                        <input type="tel" name="managerPhone" class="form-control human-required" placeholder="0910000000" autocomplete="tel" inputmode="tel" dir="ltr" required>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small text-muted">اسم الدخول</label>
                                        <div class="input-group" dir="ltr">
                                            <input type="text" name="webUsername" class="form-control human-required" placeholder="executor_1" autocomplete="username" pattern="[A-Za-z0-9_]+" minlength="3" required>
                                            <span class="input-group-text">@ahram.com</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small text-muted">كلمة المرور</label>
                                        <input type="password" name="webPassword" class="form-control human-required" placeholder="6 أحرف على الأقل" autocomplete="new-password" minlength="6" required>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 d-none" id="apiFields">
                            <div class="p-3 rounded-4 border" style="background: rgba(245, 158, 11, 0.08); border-color: rgba(245, 158, 11, 0.35) !important;">
                                <div class="fw-bold mb-3 text-warning"><i class="fa-solid fa-plug-circle-bolt me-1"></i> بيانات API الخاصة بهذا المنفذ</div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small text-muted">مزود الخدمة</label>
                                        <select name="apiProviderKey" id="apiProviderKey" class="form-select fw-bold">
                                            <% (typeof apiProviderPresets !== 'undefined' ? apiProviderPresets : []).forEach(provider => { %>
                                                <option value="<%= provider.key %>"
                                                        data-api-url="<%= provider.apiUrl %>"
                                                        data-service-id="<%= provider.serviceId %>"
                                                        data-provider-id="<%= provider.providerId %>"
                                                        data-field-id="<%= provider.fieldId %>"
                                                        data-machine-serial="<%= provider.machineSerial %>">
                                                    <%= provider.nameAr || provider.name %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small text-muted">رابط API</label>
                                        <input type="text" name="apiUrl" class="form-control" placeholder="https://zaynpay.com" value="https://zaynpay.com" dir="ltr">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small text-muted">اسم مستخدم API</label>
                                        <input type="text" name="apiUsername" class="form-control" dir="ltr">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small text-muted">كلمة مرور API</label>
                                        <input type="password" name="apiPassword" class="form-control" dir="ltr">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small text-muted">API Token / Secret</label>
                                        <input type="text" name="apiToken" class="form-control" dir="ltr">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small text-muted">Service ID</label>
                                        <input type="number" name="apiServiceId" class="form-control text-center" value="85" dir="ltr">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small text-muted">Current Provider ID</label>
                                        <input type="number" name="apiProviderId" class="form-control text-center" value="16" dir="ltr">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small text-muted">Field ID</label>
                                        <input type="number" name="apiFieldId" class="form-control text-center" value="5488" dir="ltr">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small text-muted">Machine Serial</label>
                                        <input type="text" name="apiMachineSerial" class="form-control text-center" value="XP1" dir="ltr">
                                    </div>
                                    <div class="col-md-9 d-flex align-items-end">
                                        <div class="text-muted small">يمكن إضافة أكثر من منفذ API، وكل منفذ سيستخدم بياناته عند توجيه الطلب إليه.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light fw-bold px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i> إنشاء المنفذ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleSidebar() { 
        document.querySelector('.sidebar').classList.toggle('active');
        document.querySelector('.sidebar-overlay').classList.toggle('active'); 
    }

    function toggleExecutorApiFields() {
        const typeField = document.getElementById('botType');
        const apiFields = document.getElementById('apiFields');
        const humanFields = document.getElementById('humanLoginFields');
        if (!typeField || !apiFields || !humanFields) return;
        const isApi = typeField.value === 'api';
        apiFields.classList.toggle('d-none', !isApi);
        humanFields.classList.toggle('d-none', isApi);
        humanFields.querySelectorAll('.human-required').forEach((input) => {
            input.required = !isApi;
            input.disabled = isApi;
        });
    }

    async function copyExecutorLink(inputId, successMessage) {
        const input = document.getElementById(inputId);
        if (!input) return;
        try {
            await navigator.clipboard.writeText(input.value);
            Swal.fire({ icon: 'success', title: successMessage, timer: 1300, showConfirmButton: false });
        } catch (_) {
            input.focus();
            input.select();
            document.execCommand('copy');
            Swal.fire({ icon: 'success', title: successMessage, timer: 1300, showConfirmButton: false });
        }
    }

    function applyApiProviderPreset() {
        const providerField = document.getElementById('apiProviderKey');
        if (!providerField) return;
        const selected = providerField.options[providerField.selectedIndex];
        if (!selected) return;
        const setValue = (name, value) => {
            const input = document.querySelector(`[name="${name}"]`);
            if (input && value) input.value = value;
        };
        setValue('apiUrl', selected.dataset.apiUrl);
        setValue('apiServiceId', selected.dataset.serviceId);
        setValue('apiProviderId', selected.dataset.providerId);
        setValue('apiFieldId', selected.dataset.fieldId);
        setValue('apiMachineSerial', selected.dataset.machineSerial);
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    async function testApiExecutor(button) {
        const botId = button?.dataset?.apiBotId;
        if (!botId) return;
        const originalHtml = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> جاري اختبار الرصيد...';

        try {
            const res = await fetch(`/executor/${encodeURIComponent(botId)}/test-api`, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'x-csrf-token': csrfToken
                },
                body: '{}'
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) {
                throw new Error(data.message || data.error || 'فشل اختبار منفذ API');
            }

            Swal.fire({
                icon: 'success',
                title: 'منفذ API يعمل بنجاح',
                html: `
                    <div style="direction:rtl;text-align:right;line-height:1.9">
                        <div><b>رصيد الخدمة:</b> <span dir="ltr">${Number(data.serviceCredit || 0).toFixed(2)}</span></div>
                        <div><b>الرصيد النقدي:</b> <span dir="ltr">${Number(data.cashCredit || 0).toFixed(2)}</span></div>
                        <div><b>المتاح:</b> <span dir="ltr">${Number(data.availableBalance || data.balance || 0).toFixed(2)}</span></div>
                    </div>
                `,
                confirmButtonText: 'تمام'
            }).then(() => window.location.reload());
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'فشل اختبار منفذ API',
                html: `<div style="direction:rtl;text-align:right">${escapeHtml(error.message)}</div>`,
                confirmButtonText: 'إغلاق'
            });
        } finally {
            button.disabled = false;
            button.innerHTML = originalHtml;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const typeField = document.getElementById('botType');
        if (typeField) typeField.addEventListener('change', toggleExecutorApiFields);
        toggleExecutorApiFields();
        const providerField = document.getElementById('apiProviderKey');
        if (providerField) providerField.addEventListener('change', applyApiProviderPreset);
        applyApiProviderPreset();

        const shouldOpenCreateModal = <%- JSON.stringify(typeof query !== 'undefined' && query.openCreate ? true : false) %>;
        const createModalEl = document.getElementById('createExecutorModal');
        if (shouldOpenCreateModal && createModalEl && window.bootstrap) {
            new bootstrap.Modal(createModalEl).show();
        }
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
