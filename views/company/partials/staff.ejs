<% const staffQuery = locals.query || {}; %>
<div class="agent-balances agent-staff">
    <% if (staffQuery.search || staffQuery.role || staffQuery.status) { %><a class="agent-staff-report" href="/client/staff">عرض جميع الموظفين ومسح الفلاتر</a><% } %>
    <header class="agent-staff-head"><h2>الموظفون <small><%= staff.length %></small></h2><% if (workspace.permissions.canManageStaff) { %><button class="bw-button primary compact" type="button" data-dialog-open="createStaffDialog"><i class="fa-solid fa-user-plus"></i>إضافة موظف</button><% } %></header>
    <section class="agent-balances-panel">
        <label class="agent-balances-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-staff-search value="<%= staffQuery.search || '' %>" placeholder="الاسم، الهاتف أو اسم الدخول" aria-label="البحث عن موظف" autocomplete="off"></label>
        <div class="agent-balances-controls"><label><span>الحالة</span><select data-staff-status><option value="">الكل</option><option value="active" <%= staffQuery.status === 'active' ? 'selected' : '' %>>نشط</option><option value="inactive" <%= staffQuery.status === 'inactive' ? 'selected' : '' %>>موقوف</option></select></label><label><span>الدور</span><select data-staff-role><option value="">الكل</option><option value="manager" <%= staffQuery.role === 'manager' ? 'selected' : '' %>>مدير</option><option value="accountant" <%= staffQuery.role === 'accountant' ? 'selected' : '' %>>محاسب</option><option value="employee" <%= staffQuery.role === 'employee' ? 'selected' : '' %>>موظف</option></select></label></div>
    </section>
    <section class="agent-balances-panel">
        <% staff.slice().sort((a,b) => String(a.name || '').localeCompare(String(b.name || ''),'ar')).forEach(member => { const accessRole = member.role === 'owner' || member.canManageCompany ? 'manager' : member.role === 'accountant' ? 'accountant' : 'employee'; const roleLabel = accessRole === 'manager' ? 'مدير' : accessRole === 'accountant' ? 'محاسب' : 'موظف'; const isSelf = String(member._id) === String(workspace.actor._id); const stats = member.stats || {}; const memberAccess = member.portalPermissions || member.staffPermissions; %>
        <details class="agent-staff-entry" data-staff-row data-status="<%= member.status === 'active' ? 'active' : 'inactive' %>" data-role="<%= accessRole %>" data-search="<%= [member.name,member.phone,member.webUsername].filter(Boolean).join(' ') %>">
            <summary class="agent-balance-row"><span class="agent-balance-identity"><strong><%= member.name %><%= isSelf ? ' (أنت)' : '' %></strong><small><%= roleLabel %> · <bdi><%= member.phone || 'بدون هاتف' %></bdi></small></span><span class="agent-staff-status <%= member.status === 'active' ? 'active' : '' %>"><%= member.status === 'active' ? 'نشط' : 'موقوف' %></span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
            <div class="agent-staff-detail"><dl><div><dt>اسم الدخول</dt><dd dir="ltr"><%= member.webUsername || 'غير متوفر' %></dd></div><div><dt>الدور</dt><dd><%= roleLabel %></dd></div><div><dt>التقارير</dt><dd><%= (memberAccess ? memberAccess.canViewAllReports : member.canViewAllReports || accessRole === 'manager' || accessRole === 'accountant') ? 'تقارير كاملة' : 'عملياته فقط' %></dd></div><div><dt>إنشاء الموظفين</dt><dd><%= (memberAccess ? memberAccess.canManageStaff : member.role === 'owner' || member.canCreateCompanyStaff) ? 'مسموح' : 'غير مسموح' %></dd></div><div><dt>عمليات الشهر</dt><dd><%= stats.transactionCount || 0 %> عملية</dd></div><div><dt>حجم التحويلات المكتملة</dt><dd dir="ltr"><%= Number(stats.totalEGP || 0).toLocaleString('en-US', {maximumFractionDigits:2}) %> EGP</dd></div><div><dt>آخر حركة</dt><dd><%= stats.lastActivity ? new Date(stats.lastActivity).toLocaleString('en-GB', {timeZone:'Africa/Tripoli'}) : 'لا توجد' %></dd></div></dl>
            <% if (member.canEditPermissions || workspace.permissions.owner && !isSelf && !['owner','agent'].includes(member.role)) { const memberPermissions = {canManageCompany:member.canManageCompany,canCreateTransfer:member.canCreateTransfer ?? member.role !== 'accountant',canViewAllReports:member.canViewAllReports,canManageCompanyProfile:member.canManageCompanyProfile ?? member.canManageCompany}; %>
            <button type="button" class="bw-button ghost compact agent-staff-permission-open" data-dialog-open="staffPermissions-<%= member._id %>"><i class="fa-solid fa-sliders" aria-hidden="true"></i>صلاحيات الموظف</button>
            <dialog class="bw-dialog agent-permission-screen" id="staffPermissions-<%= member._id %>" aria-labelledby="staffPermissionsTitle-<%= member._id %>">
                <form class="agent-create-form" method="POST" action="/client/company/staff/<%= encodeURIComponent(String(member._id)) %>/permissions" data-permission-edit-form>
                    <header class="agent-create-head"><div><h2 id="staffPermissionsTitle-<%= member._id %>">صلاحيات الموظف</h2><p><%= member.name %> · <%= roleLabel %></p></div><button type="button" class="bw-icon-button" data-dialog-close aria-label="رجوع"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></header>
                    <div class="agent-create-body"><input type="hidden" name="version" value="<%= member.sessionVersion || 0 %>"><%- include('staff_permissions', {permissionValues:memberPermissions,permissionRole:member.role,permissionEdit:true}) %><p data-permission-result class="agent-create-result" role="status" aria-live="polite" hidden></p></div>
                    <footer class="agent-create-footer"><p class="agent-create-description">بعد الحفظ، سيحتاج الموظف إلى تسجيل الدخول مجددًا.</p><button type="submit" class="bw-button primary" disabled>حفظ الصلاحيات</button></footer>
                </form>
            </dialog>
            <% } %>
            <details class="agent-staff-actions"><summary>إجراءات الحساب</summary><div>
                <a class="bw-button ghost compact" href="/client/transactions?staff=<%= encodeURIComponent(member.name) %>&history=all">سجل العمليات</a>
                <% if (workspace.permissions.canManageStaff && !isSelf && member.role !== 'owner' && (member.canEditPermissions || workspace.permissions.owner)) { %><button class="bw-button ghost compact" type="button" data-staff-password data-member-id="<%= member._id %>" data-member-name="<%= member.name %>" data-member-username="<%= member.webUsername %>">تغيير كلمة المرور</button><form method="POST" action="/client/company/staff/<%= member._id %>/toggle" data-confirm="<%= member.status === 'active' ? 'إيقاف حساب الموظف؟' : 'إعادة تنشيط حساب الموظف؟' %>"><input type="hidden" name="nextStatus" value="<%= member.status === 'active' ? 'banned' : 'active' %>"><button class="bw-button ghost compact" type="submit"><%= member.status === 'active' ? 'إيقاف الحساب' : 'تنشيط الحساب' %></button></form><% } %>
            </div></details></div>
        </details>
        <% }) %>
        <p class="agent-balances-empty" data-staff-empty <%= staff.length ? 'hidden' : '' %>>لا توجد حسابات موظفين.</p>
        <footer class="agent-balances-footer" data-staff-footer hidden><span data-staff-progress role="status" aria-live="polite"></span><button type="button" class="bw-button ghost compact" data-staff-more>تحميل المزيد</button></footer>
    </section>
</div>
