                    </html>
                `);
                printWindow.document.close();
            });
            return;
        }

        const entityName = (tx.companyName && tx.companyName !== 'عميل فردي') ? tx.companyName : (tx.employeeName || 'عميل فردي');
        let typeLabel = 'محفظة كاش';
        let numStrP = tx.vodafoneNumber || tx.accountNumber || '';
        const transferKey = String(tx.transferType || tx.canonicalServiceKey || '').toLowerCase();
        if (transferKey === 'bank_account' || transferKey === 'bank_transfer') typeLabel = 'تحويل بنكي';
        else if(tx.transferType === 'post_account') typeLabel = 'حساب بريد';
        else if(tx.transferType === 'post_card') typeLabel = 'بطاقة عميل';
        else if(tx.status === 'deposit' || tx.status === 'deduction') typeLabel = 'تسوية مالية';
        else if(numStrP.startsWith('010')) typeLabel = 'فودافون كاش';
        else if(numStrP.startsWith('011')) typeLabel = 'اتصالات كاش';
        else if(numStrP.startsWith('012')) typeLabel = 'اورانج كاش';
        else if(numStrP.startsWith('015')) typeLabel = 'وي باي';

        const statusMap = { 'completed': 'مكتمل ✅', 'pending': 'معلق ⏳', 'processing': 'قيد التوجيه ⚙️', 'accepted': 'قيد العمل 👤', 'deposit': 'إيداع 💰', 'deduction': 'خصم 📉', 'rejected': 'ملغي ❌', 'cancelled_by_admin': 'ملغي من الإدارة ❌', 'deposit_pending': 'طلب إيداع 🖐️' };
        const statusText = statusMap[tx.status] || tx.status;
        const rate = tx.exchangeRate ? Number(tx.exchangeRate).toFixed(2) : (tx.costLYD ? (tx.amount / tx.costLYD).toFixed(2) : '---');
        const costLYD = tx.costLYD ? tx.costLYD.toFixed(2) : '---';
        const accountNameHtml = tx.accountName ? `<tr><th>اسم المستلم:</th><td>${txEscape(tx.accountName)}</td></tr>` : '';
        const printedBank = (tx.serviceDetails && tx.serviceDetails.bankName) || tx.bankName || '';
        const bankHtml = printedBank ? `<tr><th>البنك:</th><td>${txEscape(printedBank)}</td></tr>` : '';
        const cancellationRows = tx.cancellationNumber ? `<tr><th>رقم الإلغاء:</th><td class="mono-num" dir="ltr">${tx.cancellationNumber}</td></tr><tr><th>سبب الإلغاء:</th><td>${tx.cancellationReason || '---'}</td></tr>` : '';
        const printWindow = window.open('', '_blank');
        printWindow.document.write(`
            <html lang="ar" dir="rtl"><head><title>فاتورة ${tx.customId || tx._id}</title><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;800&display=swap" rel="stylesheet"><style> * { box-sizing: border-box; } @page { size: A4; margin: 10mm; } body { font-family: 'Tajawal', sans-serif; background: #fff; color: #333; margin: 0; padding: 0; font-size: 14px; -webkit-print-color-adjust: exact; print-color-adjust: exact; } .invoice-box { width: 100%; padding: 10px; border-top: 10px solid #001a4d; } .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 15px; } .header .logo-text { color: #001a4d; font-size: 26px; font-weight: 800; margin: 0 0 5px 0; }
            .header .sub-text { color: #dc3545; font-size: 13px; font-weight: 700; margin: 0; } .invoice-info table { width: 100%; font-size: 13px; text-align: left;} .invoice-info td { padding: 4px 8px; font-weight: 700; color: #444; } .invoice-info .highlight { color: #001a4d; background: #f8f9fa; border-radius: 4px; } .title-bar { background-color: #f8f9fa; padding: 6px 15px; border-right: 5px solid #d4af37; font-size: 15px; font-weight: 800; color: #001a4d; margin-bottom: 15px; page-break-after: avoid; } .content-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px; page-break-inside: avoid; } .content-table th, .content-table td { border: 1px solid #ddd; padding: 8px 15px; text-align: right; } .content-table th { background-color: #f8f9fa; color: #001a4d; font-weight: 800; width: 30%; } .content-table td { font-weight: 700; color: #222; } .totals-container { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; page-break-inside: avoid; } .qr-placeholder { width: 90px; height: 90px; border: 2px dashed #ccc; display: flex; align-items: center; justify-content: center; color: #aaa; font-weight: bold; border-radius: 8px; font-size: 12px; text-align: center; } .totals { width: 75%; border-collapse: collapse; } .totals th, .totals td { border: 2px solid #001a4d; padding: 8px; text-align: center; } .totals th { background-color: #001a4d; color: #fff; font-weight: 800; font-size: 14px; } .totals td { font-weight: 800; font-size: 17px; background: #fafafa; } .totals .lyd { color: #dc3545; } .totals .egp { color: #198754; } .footer { text-align: center; color: #666; border-top: 1px dashed #ccc; padding-top: 15px; font-size: 12px; font-weight: 700; margin-top: 20px; page-break-inside: avoid; }</style></head>
            <body><div class="invoice-box"><div class="header"><div><h1 class="logo-text">شركة الأهرام</h1><p class="sub-text">لخدمات التحويلات المالية الذكية</p></div><div class="invoice-info"><table><tr><td>رقم الفاتورة:</td><td class="highlight" dir="ltr">#${tx.customId || tx._id.slice(-6)}</td></tr><tr><td>تاريخ الإصدار:</td><td class="highlight" dir="ltr">${f(tx.createdAt)}</td></tr><tr><td>حالة العملية:</td><td class="highlight" style="color:#198754;">${statusText}</td></tr></table></div></div><div class="title-bar">تفاصيل الجهة والمستفيد</div><table class="content-table"><tr><th>الجهة / العميل:</th><td>${entityName}</td></tr><tr><th>رقم الهاتف / الحساب:</th><td dir="ltr" style="text-align: right; letter-spacing: 1px;">${tx.vodafoneNumber || tx.accountNumber || '---'}</td></tr>${accountNameHtml}${bankHtml}${cancellationRows}<tr><th>نوع التحويل:</th><td>${typeLabel}</td></tr><tr><th>الموظف المنفذ:</th><td>${tx.executorName || '---'}</td></tr><tr><th>ملاحظة العميل / الرقم المرجعي:</th><td style="color:#666; font-size: 13px;">${txEscape(printNoteView.customerText || 'لا توجد ملاحظات.')}</td></tr></table><div class="title-bar">تفاصيل المبالغ والتكلفة</div><div class="totals-container"><div class="qr-placeholder">QR Code<br>للتوثيق</div><table class="totals"><tr><th>سعر الصرف المعتمد</th><th>المبلغ المحول (مصري)</th><th>التكلفة (ليبي)</th></tr><tr><td>${rate}</td><td class="egp">${tx.amount.toFixed(2)} EGP</td><td class="lyd">${costLYD} LYD</td></tr></table></div><div class="footer">نقدر ثقتكم في خدماتنا.. شكراً لاختياركم شركة الأهرام 🚀<br><span style="font-weight: 400; color:#999; margin-top:5px; display:inline-block;">هذه الفاتورة تم إصدارها إلكترونياً ولا تحتاج إلى ختم أو توقيع.</span></div></div><script>window.onload = function() { setTimeout(function() { window.print(); window.close(); }, 500); }<\/script></body></html>
        `);
        printWindow.document.close();
    }

    function confirmEmergencyAlert(form) {
        const msg = prompt("🚨 رسالة الإنذار للمنفذ:", "تنبيه عاجل! يرجى التنفيذ فوراً!");
        if (msg === null) return false;
        form.querySelector('.alert-message-input').value = msg;
        return true;
    }

    function promptRejectDeposit(form) {
        const reason = prompt("❌ سبب رفض طلب الإيداع:");
        if (!reason) return false;
        form.querySelector('.reject-reason-input').value = reason;
        return true;
    }

    function promptGlobalCancel(form) {
        const reason = prompt("سبب إلغاء العملية وإرجاع الرصيد:", "إلغاء من الإدارة");
        if (!reason) return false;
        form.querySelector('.cancel-reason-input').value = reason;
        return true;
    }

    async function runProviderRowAction(button) {
        if (!button || button.disabled) return;
        const action = button.dataset.providerRowAction;
        const transactionId = button.dataset.transactionId;
        const updatedAt = button.dataset.providerUpdatedAt || '';
        if (!action || !transactionId) return;

        const actionGroup = button.closest('[data-provider-row-actions]');
        const buttons = actionGroup ? Array.from(actionGroup.querySelectorAll('button')) : [button];
        buttons.forEach((item) => { item.disabled = true; });
        const post = async (url, body = {}) => {
            const response = await fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    Accept: 'application/json',
                    'Content-Type': 'application/json',
                    ...(window.__csrfToken ? { 'x-csrf-token': window.__csrfToken } : {})
                },
                body: JSON.stringify(body)
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok || (payload.success === false && action !== 'check')) {
                throw new Error(payload.message || payload.error || 'تعذر تنفيذ الإجراء.');
            }
            return payload;
        };

        try {
            if (action === 'check') {
                const result = await post('/transaction/' + encodeURIComponent(transactionId) + '/provider-status-check');
                const isStillPending = result.code === 'PROVIDER_STILL_PENDING';
                await Swal.fire({
                    icon: isStillPending ? 'info' : (result.success ? 'success' : 'warning'),
                    title: isStillPending ? 'العملية ما زالت معلقة' : (result.message || 'تم تحديث نتيجة المزود.'),
                    text: isStillPending ? 'لم يرسل المزود نتيجة نهائية بعد.' : undefined,
                    confirmButtonText: 'حسناً'
                });
                await refreshTransactionsList();
                return;
            }

            const isCancel = action === 'cancel';
            const dialog = await Swal.fire({
                title: isCancel ? 'إلغاء ورد الرصيد' : 'إنجاح العملية',
                html: '<div style="text-align:right; direction:rtl;">'
                    + '<label class="form-label fw-bold">مرجع إثبات المزود</label>'
                    + '<input id="provider-row-evidence" class="swal2-input" style="width:100%; margin:0 0 12px;" placeholder="' + (isCancel ? 'رقم الإلغاء أو الرد من المزود' : 'الرقم المرجعي المؤكد') + '">'
                    + '<label class="form-label fw-bold">ملاحظة القرار</label>'
                    + '<textarea id="provider-row-note" class="swal2-textarea" style="width:100%; margin:0;" placeholder="' + (isCancel ? 'اكتب سبب الإلغاء ورد الرصيد' : 'اكتب سبب اعتماد العملية') + '"></textarea>'
                    + '</div>',
                showCancelButton: true,
                reverseButtons: true,
                focusConfirm: false,
                confirmButtonText: isCancel ? 'إلغاء ورد الرصيد' : 'إنجاح العملية',
                cancelButtonText: 'تراجع',
                confirmButtonColor: isCancel ? '#dc2626' : '#059669',
                preConfirm: () => {
                    const popup = Swal.getPopup();
                    const evidenceReference = popup?.querySelector('#provider-row-evidence')?.value.trim() || '';
                    const note = popup?.querySelector('#provider-row-note')?.value.trim() || '';
                    if (!evidenceReference || !note) {
                        Swal.showValidationMessage('أدخل مرجع إثبات المزود والملاحظة أولاً.');
                        return false;
                    }
                    return { evidenceReference, note };
                }
            });
            if (!dialog.isConfirmed || !dialog.value) return;

            const outcome = isCancel ? 'provider_not_paid' : 'provider_paid';
            await post('/transaction/' + encodeURIComponent(transactionId) + '/resolve-provider-result', {
                outcome,
                evidenceReference: dialog.value.evidenceReference,
                note: dialog.value.note,
                confirm: true,
                expectedUpdatedAt: updatedAt
            });
            if (isCancel) {
                await post('/transaction/' + encodeURIComponent(transactionId) + '/global-cancel', {
                    reason: dialog.value.note
                });
            }
            await refreshTransactionsList();
            await Swal.fire({
                toast: true,
                position: 'top',
                icon: 'success',
                title: isCancel ? 'تم إلغاء العملية ورد الرصيد.' : 'تم إنجاح العملية.',
                showConfirmButton: false,
                timer: 2200
            });
        } catch (error) {
            await Swal.fire({
                icon: 'error',
                title: 'تعذر تنفيذ الإجراء',
                text: error.message || 'حاول مرة أخرى.'
            });
        } finally {
            buttons.forEach((item) => { item.disabled = false; });
        }
    }

    let currentDepTxId = null;
    function showAcceptDepositModal(id) {
        currentDepTxId = id;
        document.getElementById('depositProofInput').value = '';
        new bootstrap.Modal(document.getElementById('acceptDepositModal')).show();
    }

    document.getElementById('btnFinishDepositAccept').onclick = async function() {
        const file = document.getElementById('depositProofInput').files[0];
        if(!file) return Swal.fire('خطأ','يرجى اختيار الإيصال','error');
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الرفع...';
        const reader = new FileReader();
        reader.onload = async function() {
            const res = await fetch('/transaction/' + currentDepTxId + '/accept-deposit-web', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ imageBase64: reader.result }) });
            if((await res.json()).success) window.location.reload();
            else {
                Swal.fire('خطأ', 'فشل الرفع', 'error');
                btn.disabled = false;
                btn.innerHTML = 'تأكيد وموافقة';
            }
        };
        reader.readAsDataURL(file);
    };

    let currentMobileTabGroup = 'all';

    const isOperationsWorkspace = <%= operationWorkspace ? 'true' : 'false' %>;
    if (isOperationsWorkspace) localStorage.removeItem('ahram_operations_last_filters');
    document.addEventListener('keydown', (event) => {
        const editable = ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName);
        if (event.key.toLowerCase() === 'r' && !editable) {
            event.preventDefault();
            refreshTransactionsList();
        }
    });

    let transactionsAutoRefreshInFlight = false;
    let transactionsRevision = '';
    let transactionsRefreshController = null;
    document.addEventListener('submit', async (event) => {
        const form = event.target.closest('form.js-transaction-action');
        if (!form) return;
        event.preventDefault();

        const confirmation = String(form.dataset.confirm || '').trim();
        if (confirmation && !window.confirm(confirmation)) return;
        if (form.querySelector('.cancel-reason-input') && !promptGlobalCancel(form)) return;

        const submitter = event.submitter || form.querySelector('button[type="submit"], button:not([type])');
        if (submitter?.disabled) return;
        const originalHtml = submitter?.innerHTML;
        if (submitter) {
            submitter.disabled = true;
            submitter.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        }

        try {
            const csrfToken = form.querySelector('input[name="_csrf"]')?.value || '';
            // These actions do not upload files. Send URL-encoded data so the
            // existing Express urlencoded parser receives req.body correctly.
            const requestBody = new URLSearchParams(new FormData(form));
            const response = await fetch(form.action, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                    ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {})
                },
                body: requestBody,
                credentials: 'same-origin'
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success) throw new Error(result.message || 'تعذر تنفيذ العملية.');

            await refreshTransactionsList();
            Swal.fire({
                toast: true,
                position: 'top',
                icon: 'success',
                title: result.message || 'تم تحديث العملية.',
                showConfirmButton: false,
                timer: 2200,
                timerProgressBar: true
            });
        } catch (error) {
            Swal.fire('تعذر التنفيذ', error.message || 'تعذر تنفيذ العملية حالياً.', 'error');
        } finally {
            if (submitter) {
                submitter.disabled = false;
                submitter.innerHTML = originalHtml;
            }
        }
    });

    async function refreshTransactionsList() {
        if (document.hidden || transactionsAutoRefreshInFlight) return;
        if (document.querySelector('.modal.show, .dropdown-menu.show, .swal2-container')) return;
        transactionsAutoRefreshInFlight = true;
        const controller = new AbortController();
        transactionsRefreshController = controller;
        const timeout = setTimeout(() => controller.abort(), 20000);
        try {
            const url = new URL(window.location.href);
            url.searchParams.set('fragment', 'list');
            const response = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-Admin-Revision': transactionsRevision },
                signal: controller.signal,
                cache: 'no-store'
            });
            if (!response.ok || response.redirected || response.headers.get('X-Admin-Fragment') !== 'transactions') return;
            if (response.status === 204) return;
            const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
            // A dialog may have opened while the request was running. Do not replace its source controls.
            if (document.hidden || document.querySelector('.modal.show, .dropdown-menu.show, .swal2-container')) return;
            let mobileChanged = false;
            for (const selector of ['#transactionsTable tbody', '#mobileTransactionRows', '#transactionPagination', '#providerReviewSummary', '#transactionRowsData']) {
                const incoming = doc.querySelector(selector);
                const current = document.querySelector(selector);
                if (incoming && current && current.innerHTML !== incoming.innerHTML) {
                    current.innerHTML = incoming.innerHTML;
                    if (selector === '#mobileTransactionRows') mobileChanged = true;
                }
            }
            if (mobileChanged) applyMobileFilters();
            transactionsRevision = response.headers.get('X-Admin-Revision') || '';
        } catch (_) {
            // Keep the existing list and retry on the next read-only refresh.
        } finally {
            clearTimeout(timeout);
            transactionsRefreshController = null;
            transactionsAutoRefreshInFlight = false;
        }
    }
    setInterval(refreshTransactionsList, isOperationsWorkspace ? 30000 : 15000);
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) transactionsRefreshController?.abort();
        else refreshTransactionsList();
    });

    function filterMobileCards(group, btn) {
        if (btn) {
            document.querySelectorAll('.mobile-tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
        currentMobileTabGroup = group;
        applyMobileFilters();
    }

    function searchMobileCards(query) {
        applyMobileFilters();
    }

    function applyMobileFilters() {
        const query = (document.getElementById('mobileSearchInput')?.value || '').trim().toLowerCase();
        let count = 0;

        document.querySelectorAll('.mobile-tx-card').forEach(card => {
            const status = card.getAttribute('data-status');
            const customId = (card.getAttribute('data-custom-id') || '').toLowerCase();
            const id = (card.getAttribute('data-id') || '').toLowerCase();
            const last6Id = id.slice(-6);
            const number = (card.getAttribute('data-number') || '').toLowerCase();
            const entity = (card.getAttribute('data-entity') || '').toLowerCase();

            // 1. Check tab group match
            let groupMatch = currentMobileTabGroup === 'all';
            if (currentMobileTabGroup === 'pending') {
                groupMatch = ['pending', 'processing', 'accepted'].includes(status);
            } else if (currentMobileTabGroup === 'completed') {
                groupMatch = ['completed', 'rejected', 'cancelled_by_admin'].includes(status);
            } else if (currentMobileTabGroup === 'deposit') {
                groupMatch = ['deposit', 'deposit_pending', 'deduction'].includes(status);
            }

            // 2. Check search query match (if query is not empty)
            let queryMatch = true;
            if (query) {
                queryMatch = customId.includes(query) || id.includes(query) || last6Id.includes(query) || number.includes(query) || entity.includes(query);
            }

            if (groupMatch && queryMatch) {
                card.style.setProperty('display', 'block', 'important');
                count++;
            } else {
                card.style.setProperty('display', 'none', 'important');
            }
        });

        const emptyState = document.getElementById('mobileEmptyState');
        if (emptyState) {
            if (count === 0) {
                emptyState.style.setProperty('display', 'block', 'important');
            } else {
                emptyState.style.setProperty('display', 'none', 'important');
            }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const activeTab = document.querySelector('.mobile-tab-btn.active');
        if (activeTab) {
            filterMobileCards('all', activeTab);
        } else {
            applyMobileFilters();
        }
    });
</script>
</body>
</html>
