        .ops-micro-stack {
            display: flex;
            flex-direction: column;
            gap: 4px;
            width: 100%;
        }
        .ops-micro {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            width: 100%;
            box-sizing: border-box;
            padding: 4px 6px;
            border-radius: 8px;
            background: var(--input-bg);
            border: 1px solid var(--border-glass);
            box-shadow: none;
        }
        .ops-micro-value { font-size: .74rem; color: var(--text-main); }
        .ops-micro-deposit .ops-micro-value { color: #3b82f6; }
        .ops-exec-card .ops-micro-stack { gap: 3px; }
        .ops-exec-card .ops-micro {
            padding: 2px 5px;
            border-radius: 7px;
            gap: 4px;
        }
        .ops-exec-card .ops-micro-label {
            font-size: .56rem;
