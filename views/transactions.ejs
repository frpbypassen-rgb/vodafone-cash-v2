<body>
<%
    const noteSystemPatterns = [
        /^سبب الرفض:/,
        /^\[تم /,
        /^\[فشل /,
        /^\[معلقة /,
        /^\[رقم الإلغاء:/,
        /^تحويل رصيد صادر إلى/,
        /^تحويل رصيد وارد من/,
        /^تمويل نقطة بيع/,
        /^سحب رصيد من نقطة بيع/,
        /^\[طلب وارد عبر API/
    ];
    const isBankTransferOperation = (tx = {}) => {
        const type = String(tx.transferType || '').trim().toLowerCase();
        const canonical = String(tx.canonicalServiceKey || '').trim().toLowerCase();
        return type === 'bank_account' || type === 'bank_transfer' || canonical === 'bank_account' || canonical === 'bank_transfer';
    };
    const splitTxNotesForView = (tx = {}) => {
        const rawNotes = String(tx.notes || '').trim();
        const explicitCustomerNotes = String(tx.customerNotes || '').trim();
        const systemParts = [];
        let customerSource = rawNotes;
        const apiIndex = rawNotes.indexOf('--- سجل الـ API');
        if (apiIndex >= 0) {
            customerSource = rawNotes.slice(0, apiIndex).trim();
            systemParts.push(rawNotes.slice(apiIndex).trim());
        }

        const legacyTransferMatch = customerSource.match(/(?:تحويل رصيد صادر إلى|تحويل رصيد وارد من).*\|\s*(.+)$/s);
        const customerLines = explicitCustomerNotes
            ? explicitCustomerNotes.split(/\r?\n/).map(line => line.trim()).filter(Boolean)
            : legacyTransferMatch
                ? [legacyTransferMatch[1].trim()]
                : customerSource.split(/\r?\n/).map(line => line.trim()).filter(Boolean).filter(line => {
                if (/رقم المرسل|الرقم المرجعي|مرجع|reference|ref/i.test(line)) return true;
                if (noteSystemPatterns.some(pattern => pattern.test(line))) {
                    systemParts.push(line);
                    return false;
                }
                return true;
            });

        if (explicitCustomerNotes) {
            customerSource.split(/\r?\n/).map(line => line.trim()).filter(Boolean).forEach(line => {
                if (explicitCustomerNotes.split(/\r?\n/).some(noteLine => noteLine.trim() === line)) return;
                if (/رقم المرسل|الرقم المرجعي|مرجع|reference|ref/i.test(line)) customerLines.push(line);
                else systemParts.push(line);
            });
        }

        const executionNumberForView = tx.executorExecutionNumber || tx.executorExecutionNumberMasked || tx.executorSenderPhone;
        if (executionNumberForView && !systemParts.some(line => line.includes(executionNumberForView))) {
            systemParts.push(`[رقم التنفيذ: ${executionNumberForView}]`);
        }
        if (tx.adminNotes) systemParts.push(String(tx.adminNotes).trim());

        return {
            customerText: customerLines.filter(Boolean).join('\n').trim(),
            systemText: systemParts.filter(Boolean).join('\n').trim()
        };
    };
    const apiLogForView = (tx = {}) => {
        const merged = [tx.adminNotes, tx.notes].filter(Boolean).join('\n');
        return merged.includes('--- سجل الـ API') ? merged : '';
    };
    const formatCount = (value) => Number(value || 0).toLocaleString('en-US');
    const formatMoney = (value) => Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const ledgerPeriodStats = (typeof periodStats !== 'undefined' && periodStats) ? periodStats : { today: { count: 0, amountEGP: 0 }, week: { count: 0, amountEGP: 0 }, month: { count: 0, amountEGP: 0 } };
    const ledgerCompanies = Array.isArray(typeof activeClientCompanies !== 'undefined' ? activeClientCompanies : null) ? activeClientCompanies : [];
    const ledgerExecutors = Array.isArray(typeof fundedExecutorCompanies !== 'undefined' ? fundedExecutorCompanies : null) ? fundedExecutorCompanies : [];
    const opsWorkspace = typeof operationWorkspace !== 'undefined' && Boolean(operationWorkspace);
    const providerReviewView = typeof providerReviewMode !== 'undefined' && providerReviewMode;
    const reviewCounts = Object.fromEntries((typeof providerReviewCounts !== 'undefined' ? providerReviewCounts : []).map((item) => [item._id || 'awaiting', item.count]));
    const opsSummary = opsWorkspace
        ? ((typeof operationsSummary !== 'undefined' && operationsSummary) ? operationsSummary : { today: { egyptianEGP: 0, libyanLYD: 0, cashEGP: 0, bankEGP: 0, totalLYD: 0 }, todayDepositsTotal: 0, todayExecutorDepositsTotal: 0, activeExecutors: [], companies: [] })
        : null;
    const opsToday = opsSummary && opsSummary.today ? opsSummary.today : { egyptianEGP: 0, libyanLYD: 0, cashEGP: 0, bankEGP: 0, totalLYD: 0 };
    const opsExecutors = opsSummary && Array.isArray(opsSummary.activeExecutors) ? opsSummary.activeExecutors : [];
    const opsCompanies = opsSummary && Array.isArray(opsSummary.companies) ? opsSummary.companies : [];
    const operationAgeFor = (tx = {}) => {
        const createdAt = new Date(tx.createdAt || Date.now());
        const minutes = Math.max(0, Math.floor((Date.now() - createdAt.getTime()) / 60000));
        const label = minutes < 1 ? 'وصلت الآن'
            : minutes < 60 ? `منذ ${minutes} د`
            : minutes < 1440 ? `منذ ${Math.floor(minutes / 60)} س`
            : `منذ ${Math.floor(minutes / 1440)} ي`;
        const active = ['pending', 'processing', 'accepted'].includes(tx.status);
        return { label: active ? label : `أُنشئت ${label}`, isLate: active && minutes >= 15 };
    };
%>

<button class="mobile-nav-toggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<%- include('partials/sidebar', { activePage: typeof operationWorkspace !== 'undefined' && operationWorkspace ? 'transactions' : 'transactions_central' }) %>

<div class="main-content am-operations-page">
    <div class="container-fluid"><% if (opsWorkspace) { %><header class="am-page-heading"><span>إدارة العمليات</span><h1><%= providerReviewView ? 'مراجعة عمليات API' : 'سجل العمليات' %></h1><p>متابعة التنفيذ والنتائج والتكاليف من مكان واحد</p></header><% } %>
        <%- include('partials/transaction_review_summary') %>
        <% if (!operationWorkspace) { %>
        <div class="d-flex justify-content-between align-items-center mb-4 tx-page-title">
            <h3 class="fw-bold m-0" style="color: var(--text-main);"><i class="fa-solid fa-server text-primary me-2"></i> السجل المركزي والمراقبة <span class="spinner-grow spinner-grow-sm text-success ms-2 opacity-50" title="تحديث تلقائي"></span></h3>
            <div class="d-flex flex-wrap gap-2">
                <a href="/transactions/deposits?party=company" class="btn btn-sm btn-outline-primary fw-bold rounded-3 px-3">إيداعات الشركات</a>
                <a href="/transactions/deposits?party=executor" class="btn btn-sm btn-outline-success fw-bold rounded-3 px-3">إيداعات التنفيذ</a>
                <a href="/reports" class="btn btn-sm fw-bold rounded-3 px-3" style="background: var(--brand-gold); color: #000;">
                    <i class="fa-solid fa-file-invoice me-1"></i> كشوفات العملاء
                </a>
            </div>
        </div>
        <% } %>

        <% if (query && query.settlementVoided) { %>
            <div class="alert alert-info fw-bold rounded-3"><i class="fa-solid fa-rotate-left me-1"></i> تم حذف أثر التسوية من الرصيد، مع الاحتفاظ بالقيد الأصلي وحركة العكس في السجل المالي.</div>
        <% } %>
        <% if (query && query.voidError === 'actor') { %>
            <div class="alert alert-danger fw-bold rounded-3"><i class="fa-solid fa-triangle-exclamation me-1"></i> تعذر تحديد المدير المنفّذ. سجّل الدخول من جديد ثم أعد المحاولة.</div>
        <% } else if (query && query.voidError) { %>
            <div class="alert alert-danger fw-bold rounded-3"><i class="fa-solid fa-triangle-exclamation me-1"></i> تعذر حذف التسوية أو سبق إلغاؤها. راجع القيد المالي ثم أعد المحاولة.</div>
        <% } %>
        <% if (query && query.routeError) { %>
            <% const transactionErrorMessages = {
                service_mismatch: 'لا يمكن توجيه العملية إلى هذا المنفذ لأن خدمته لا تطابق نوع العملية.',
                financial_unavailable: 'تعذر تأكيد التعديل المالي حالياً. لم يتم حفظ أي تغيير؛ حاول لاحقاً.',
                transaction_unavailable: 'العملية لم تعد متاحة لهذا التعديل أو أن بياناتها غير صالحة.',
                actor_missing: 'تعذر تحديد المدير المنفّذ للعملية. سجّل الدخول من جديد ثم أعد المحاولة.',
                update_failed: 'تعذر تنفيذ التعديل. راجع البيانات ثم أعد المحاولة أو تواصل مع الدعم.'
            }; %>
            <div class="alert alert-danger fw-bold rounded-3"><i class="fa-solid fa-triangle-exclamation me-1"></i> <%= transactionErrorMessages[query.routeError] || transactionErrorMessages.update_failed %></div>
        <% } %>

        <% if (!operationWorkspace) { %>
        <div class="ledger-stats-bar mb-3" role="group" aria-label="إجماليات العمليات الناجحة">
            <div class="ledger-stat ledger-stat-today">
                <div class="ledger-stat-copy">
                    <span class="ledger-stat-label">إجمالي العمليات الناجحة اليوم</span>
                    <strong class="ledger-stat-value"><%= formatCount(ledgerPeriodStats.today.count) %> <small>عملية</small></strong>
                    <span class="ledger-stat-amount"><%= formatMoney(ledgerPeriodStats.today.amountEGP) %> EGP</span>
                </div>
                <span class="ledger-stat-icon" aria-hidden="true"><i class="fa-solid fa-circle-check"></i></span>
            </div>
            <div class="ledger-stat ledger-stat-week">
                <div class="ledger-stat-copy">
                    <span class="ledger-stat-label">إجمالي الأسبوع</span>
                    <strong class="ledger-stat-value"><%= formatCount(ledgerPeriodStats.week.count) %> <small>عملية</small></strong>
                    <span class="ledger-stat-amount"><%= formatMoney(ledgerPeriodStats.week.amountEGP) %> EGP</span>
                </div>
                <span class="ledger-stat-icon" aria-hidden="true"><i class="fa-solid fa-calendar-week"></i></span>
            </div>
            <div class="ledger-stat ledger-stat-month">
                <div class="ledger-stat-copy">
                    <span class="ledger-stat-label">إجمالي الشهر</span>
                    <strong class="ledger-stat-value"><%= formatCount(ledgerPeriodStats.month.count) %> <small>عملية</small></strong>
                    <span class="ledger-stat-amount"><%= formatMoney(ledgerPeriodStats.month.amountEGP) %> EGP</span>
                </div>
                <span class="ledger-stat-icon" aria-hidden="true"><i class="fa-solid fa-calendar-days"></i></span>
            </div>
        </div>

        <div class="row g-3 mb-4 ledger-overview-cols">
            <div class="col-lg-6">
                <section class="ledger-panel">
                    <div class="ledger-panel-head">
                        <div>
                            <h6><i class="fa-solid fa-building text-primary ms-1"></i> الشركات النشطة</h6>
                            <p>أرصدة الشركة</p>
                        </div>
                        <span class="ledger-panel-count"><%= formatCount(ledgerCompanies.length) %></span>
                    </div>
                    <div class="ledger-panel-list">
                        <% if (ledgerCompanies.length) { %>
                            <% ledgerCompanies.forEach(company => { %>
                                <a class="ledger-balance-row" href="/company/<%= company.id %>" title="فتح ملف <%= company.name %>">
                                    <span class="ledger-balance-name"><%= company.name %><small class="ledger-balance-meta"><%= company.accountCode ? ('كود ' + company.accountCode) : 'بدون كود حساب' %></small></span>
                                    <span class="ledger-balance-value <%= Number(company.balance) < 0 ? 'is-negative' : '' %>" dir="ltr"><%= formatMoney(company.balance) %> LYD</span>
                                </a>
                            <% }); %>
                        <% } else { %>
                            <div class="ledger-empty"><i class="fa-solid fa-building ms-1 opacity-50"></i> لا توجد شركات نشطة حالياً.</div>
                        <% } %>
                    </div>
                </section>
            </div>
            <div class="col-lg-6">
                <section class="ledger-panel">
                    <div class="ledger-panel-head">
                        <div>
                            <h6><i class="fa-solid fa-user-gear text-success ms-1"></i> الشركات المنفذة</h6>
                            <p>رصيد متاح أكبر من صفر</p>
                        </div>
                        <span class="ledger-panel-count"><%= formatCount(ledgerExecutors.length) %></span>
                    </div>
                    <div class="ledger-panel-list">
                        <% if (ledgerExecutors.length) { %>
                            <% ledgerExecutors.forEach(group => { %>
                                <a class="ledger-balance-row" href="/executor/<%= group.id %>" title="فتح ملف <%= group.name %>">
                                    <span class="ledger-balance-name"><%= group.name %><small class="ledger-balance-meta"><%= group.isManager ? 'وكالة تنفيذ' : (group.balanceSource === 'api_service' ? 'API · رصيد خدمة' : 'منفذ · رصيد داخلي') %></small></span>
                                    <span class="ledger-balance-value" dir="ltr"><%= formatMoney(group.balance) %> EGP</span>
                                </a>
                            <% }); %>
                        <% } else { %>
                            <div class="ledger-empty"><i class="fa-solid fa-wallet ms-1 opacity-50"></i> لا توجد شركة منفذة برصيد متاح حالياً.</div>
                        <% } %>
                    </div>
                </section>
            </div>
        </div>
        <% } %>


        <% if (opsWorkspace && providerReviewView) { %>
        <form method="GET" action="/transactions/operations" class="am-operation-filters d-flex flex-wrap align-items-end gap-2 mb-3" aria-label="فترة العمليات">
            <% if (providerReviewView) { %>
            <input type="hidden" name="providerReview" value="1">
            <div><label class="form-label small fw-bold mb-1" for="providerSearch">رقم العملية أو المستلم</label><input class="form-control form-control-sm" id="providerSearch" name="search" value="<%= search %>"></div>
            <div><label class="form-label small fw-bold mb-1" for="providerState">نتيجة المتابعة</label>
                <select class="form-select form-select-sm" id="providerState" name="providerState">
                    <% for (const [value, label] of Object.entries({ '': 'كل النتائج', awaiting: 'بانتظار الفحص', pending: 'بانتظار المزود', paid: 'نجاح لدى المزود', returned: 'إلغاء لدى المزود', mismatch: 'اختلاف البيانات', failed: 'تعذر الفحص', missing_reference: 'رقم المزود مفقود', missing_executor: 'إعدادات المنفذ', exhausted: 'انتهت المحاولات' })) { %>
                    <option value="<%= value %>" <%= (query.providerState || '') === value ? 'selected' : '' %>><%= label %></option>
                    <% } %>
                </select>
            </div>
            <% } %>
            <% if (!providerReviewView) { %>
            <div class="am-wide-field"><label for="operationSearch" class="form-label">رقم العملية أو المستلم</label><input id="operationSearch" class="form-control" name="search" value="<%= search %>" placeholder="رقم العملية، الهاتف، اسم العميل"></div>
            <div><label for="operationStatus" class="form-label">الحالة</label><select id="operationStatus" name="status" class="form-select"><% [['','كل الحالات'],['pending','معلقة'],['processing','قيد التنفيذ'],['accepted','مقبولة'],['completed','مكتملة'],['rejected','مرفوضة'],['cancelled_by_admin','ملغية']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= statusFilter===value?'selected':'' %>><%= label %></option><% }); %></select></div>
            <% } %>
            <div>
                <label for="operationsFromDate" class="form-label small fw-bold mb-1">من</label>
                <input id="operationsFromDate" name="fromDate" type="date" class="form-control form-control-sm" value="<%= fromDate %>">
            </div>
            <div>
                <label for="operationsToDate" class="form-label small fw-bold mb-1">إلى</label>
                <input id="operationsToDate" name="toDate" type="date" class="form-control form-control-sm" value="<%= toDate %>">
            </div>
            <button type="submit" class="btn btn-sm btn-primary">عرض الفترة</button>
            <a href="/transactions/operations" class="btn btn-sm btn-outline-secondary">كل العمليات</a>
            <% if (!providerReviewView) { %><a href="/transactions/operations?providerReview=1" class="btn btn-sm btn-outline-warning">مراجعة عمليات API المتأخرة</a><% } %>
            <span class="small text-muted ms-auto" aria-live="polite"><%= Number(totalTxs) || 0 %> عملية</span>
        </form>
        <% } %>

        <% if (opsSummary && !providerReviewView) { %>
        <%- include('partials/operations_workspace_summary', { opsSummary, opsToday, opsCompanies, opsExecutors, formatMoney, formatCount, search }) %>
        <% } %>
        <%- include('partials/transaction_list') %>
    </div>
</div>

