            gap: 10px;
            margin-top: 3px;
        }
        .ops-currency-name {
            color: var(--text-muted);
            font-size: .68rem;
            font-weight: 800;
        }
        .ops-currency-value,
        .ops-mini-value,
        .ops-exec-value,
        .ops-company-balance,
        .ops-micro-value {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 900;
            line-height: 1.15;
            direction: ltr;
            white-space: nowrap;
        }
        .ops-currency-value { font-size: .82rem; color: var(--text-main); }
        .ops-currency-value small,
        .ops-mini-value small,
        .ops-exec-value small,
        .ops-company-balance small,
        .ops-micro-value small {
            font-family: 'Tajawal', sans-serif;
            font-size: .6rem;
            font-weight: 800;
            color: var(--text-muted);
        }
        .ops-mini-value {
            display: block;
            margin-top: 2px;
            font-size: .9rem;
            color: #3b82f6;
        }
        .ops-exec-head {
            width: 100%;
            color: var(--text-muted);
            font-size: .66rem;
            font-weight: 800;
            text-align: right;
        }
        .ops-exec-row,
        .ops-company-row {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .ops-exec-row {
            width: 100%;
            direction: rtl;
            justify-content: flex-start;
        }
        .ops-company-row { direction: rtl; }
        .ops-exec-label,
        .ops-company-label {
            font-size: .72rem;
        }
