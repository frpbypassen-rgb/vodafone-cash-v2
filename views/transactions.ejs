<body>
<%
    const noteSystemPatterns = [
        /^سبب الرفض:/,
        /^\[تم /,
        /^\[فشل /,
        /^\[معلقة /,
        /^\[رقم الإلغاء:/,
        /^تحويل رصيد صادر إلى/,
        /^تحويل رصيد وارد من/,
        /^تمويل نقطة بيع/,
        /^سحب رصيد من نقطة بيع/,
        /^\[طلب وارد عبر API/
    ];
    const splitTxNotesForView = (tx = {}) => {
        const rawNotes = String(tx.notes || '').trim();
        const explicitCustomerNotes = String(tx.customerNotes || '').trim();
        const systemParts = [];
        let customerSource = rawNotes;
        const apiIndex = rawNotes.indexOf('--- سجل الـ API');
        if (apiIndex >= 0) {
            customerSource = rawNotes.slice(0, apiIndex).trim();
            systemParts.push(rawNotes.slice(apiIndex).trim());
        }

        const legacyTransferMatch = customerSource.match(/(?:تحويل رصيد صادر إلى|تحويل رصيد وارد من).*\|\s*(.+)$/s);
        const customerLines = explicitCustomerNotes
            ? explicitCustomerNotes.split(/\r?\n/).map(line => line.trim()).filter(Boolean)
            : legacyTransferMatch
                ? [legacyTransferMatch[1].trim()]
                : customerSource.split(/\r?\n/).map(line => line.trim()).filter(Boolean).filter(line => {
                if (/رقم المرسل|الرقم المرجعي|مرجع|reference|ref/i.test(line)) return true;
                if (noteSystemPatterns.some(pattern => pattern.test(line))) {
                    systemParts.push(line);
                    return false;
                }
                return true;
            });

        if (explicitCustomerNotes) {
            customerSource.split(/\r?\n/).map(line => line.trim()).filter(Boolean).forEach(line => {
                if (explicitCustomerNotes.split(/\r?\n/).some(noteLine => noteLine.trim() === line)) return;
                if (/رقم المرسل|الرقم المرجعي|مرجع|reference|ref/i.test(line)) customerLines.push(line);
                else systemParts.push(line);
            });
        }

        const executionNumberForView = tx.executorExecutionNumber || tx.executorExecutionNumberMasked || tx.executorSenderPhone;
        if (executionNumberForView && !systemParts.some(line => line.includes(executionNumberForView))) {
            systemParts.push(`[رقم التنفيذ: ${executionNumberForView}]`);
        }
        if (tx.adminNotes) systemParts.push(String(tx.adminNotes).trim());

        return {
            customerText: customerLines.filter(Boolean).join('\n').trim(),
            systemText: systemParts.filter(Boolean).join('\n').trim()
        };
    };
    const apiLogForView = (tx = {}) => {
        const merged = [tx.adminNotes, tx.notes].filter(Boolean).join('\n');
        return merged.includes('--- سجل الـ API') ? merged : '';
    };
    const formatCount = (value) => Number(value || 0).toLocaleString('en-US');
    const formatMoney = (value) => Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const ledgerPeriodStats = (typeof periodStats !== 'undefined' && periodStats) ? periodStats : { today: { count: 0, amountEGP: 0 }, week: { count: 0, amountEGP: 0 }, month: { count: 0, amountEGP: 0 } };
    const ledgerCompanies = Array.isArray(typeof activeClientCompanies !== 'undefined' ? activeClientCompanies : null) ? activeClientCompanies : [];
    const ledgerExecutors = Array.isArray(typeof fundedExecutorCompanies !== 'undefined' ? fundedExecutorCompanies : null) ? fundedExecutorCompanies : [];
    const opsWorkspace = typeof operationWorkspace !== 'undefined' && Boolean(operationWorkspace);
    const opsSummary = opsWorkspace
        ? ((typeof operationsSummary !== 'undefined' && operationsSummary) ? operationsSummary : { today: { egyptianEGP: 0, libyanLYD: 0 }, todayDepositsTotal: 0, todayExecutorDepositsTotal: 0, activeExecutors: [], companies: [] })
        : null;
    const opsToday = opsSummary && opsSummary.today ? opsSummary.today : { egyptianEGP: 0, libyanLYD: 0 };
    const opsExecutors = opsSummary && Array.isArray(opsSummary.activeExecutors) ? opsSummary.activeExecutors : [];
    const opsCompanies = opsSummary && Array.isArray(opsSummary.companies) ? opsSummary.companies : [];
    const operationAgeFor = (tx = {}) => {
        const createdAt = new Date(tx.createdAt || Date.now());
        const minutes = Math.max(0, Math.floor((Date.now() - createdAt.getTime()) / 60000));
        const label = minutes < 1 ? 'وصلت الآن'
            : minutes < 60 ? `منذ ${minutes} د`
            : minutes < 1440 ? `منذ ${Math.floor(minutes / 60)} س`
            : `منذ ${Math.floor(minutes / 1440)} ي`;
        const active = ['pending', 'processing', 'accepted'].includes(tx.status);
        return { label: active ? label : `أُنشئت ${label}`, isLate: active && minutes >= 15 };
    };
%>

