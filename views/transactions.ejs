<script>
    function toggleSidebar() { document.querySelector('.sidebar').classList.toggle('active'); document.querySelector('.sidebar-overlay').classList.toggle('active'); }

    const botsMapElement = document.getElementById('botsMapData');
    const allBotsMap = botsMapElement && botsMapElement.textContent.trim() ? JSON.parse(botsMapElement.textContent) : {};

    const txSystemNotePatterns = [
        /^سبب الرفض:/,
        /^\[تم /,
        /^\[فشل /,
        /^\[معلقة /,
        /^\[رقم الإلغاء:/,
        /^تحويل رصيد صادر إلى/,
        /^تحويل رصيد وارد من/,
        /^تمويل نقطة بيع/,
        /^سحب رصيد من نقطة بيع/,
        /^\[طلب وارد عبر API/
    ];

    function splitTransactionNotes(tx = {}) {
        const rawNotes = String(tx.notes || '').trim();
        const explicitCustomerNotes = String(tx.customerNotes || '').trim();
        const systemParts = [];
        let customerSource = rawNotes;
        const apiIndex = rawNotes.indexOf('--- سجل الـ API');
        if (apiIndex >= 0) {
            customerSource = rawNotes.slice(0, apiIndex).trim();
            systemParts.push(rawNotes.slice(apiIndex).trim());
        }

        const legacyTransferMatch = customerSource.match(/(?:تحويل رصيد صادر إلى|تحويل رصيد وارد من).*\|\s*(.+)$/s);
        const customerLines = explicitCustomerNotes
            ? explicitCustomerNotes.split(/\r?\n/).map((line) => line.trim()).filter(Boolean)
            : legacyTransferMatch
                ? [legacyTransferMatch[1].trim()]
                : customerSource.split(/\r?\n/).map((line) => line.trim()).filter(Boolean).filter((line) => {
                if (/رقم المرسل|الرقم المرجعي|مرجع|reference|ref/i.test(line)) return true;
                if (txSystemNotePatterns.some((pattern) => pattern.test(line))) {
                    systemParts.push(line);
                    return false;
                }
                return true;
            });

        if (explicitCustomerNotes) {
            const explicitLines = explicitCustomerNotes.split(/\r?\n/).map((line) => line.trim());
            customerSource.split(/\r?\n/).map((line) => line.trim()).filter(Boolean).forEach((line) => {
                if (explicitLines.includes(line)) return;
                if (/رقم المرسل|الرقم المرجعي|مرجع|reference|ref/i.test(line)) customerLines.push(line);
                else systemParts.push(line);
            });
        }

        const executionNumberForView = tx.executorExecutionNumber || tx.executorExecutionNumberMasked || tx.executorSenderPhone;
        if (executionNumberForView && !systemParts.some((line) => line.includes(executionNumberForView))) {
            systemParts.push(`[رقم التنفيذ: ${executionNumberForView}]`);
        }
        if (tx.adminNotes) systemParts.push(String(tx.adminNotes).trim());
        if (tx.cancellationReason) systemParts.push(`[سبب الإلغاء: ${tx.cancellationReason}]`);
        if (tx.cancellationNumber) systemParts.push(`[رقم الإلغاء: ${tx.cancellationNumber}]`);

        return {
            customerText: customerLines.filter(Boolean).join('\n').trim(),
            systemText: [...new Set(systemParts.filter(Boolean))].join('\n').trim()
        };
    }

    // 🟢 دالة عرض نافذة السجل المنبثقة (مُحدثة لتقرأ الجملة الجديدة والقديمة معاً)
    function showApiLog(btn) {
        const rawNotes = decodeURIComponent(btn.getAttribute('data-log'));
        let logContent = rawNotes;

        // التحقق من الصيغة القديمة والصيغة الجديدة
        if (rawNotes.includes('--- سجل الـ API (Terminal Log) ---')) {
            logContent = rawNotes.split('--- سجل الـ API (Terminal Log) ---')[1].trim();
        } else if (rawNotes.includes('--- سجل الـ API ---')) {
            logContent = rawNotes.split('--- سجل الـ API ---')[1].trim();
        } else if (rawNotes.includes('--- سجل الـ API')) {
            logContent = rawNotes.split('--- سجل الـ API')[1].trim();
        }

        Swal.fire({
            title: '<div style="color:#10b981; font-family:monospace; font-size:1.2rem; display:flex; align-items:center; gap:10px; justify-content:center;"><i class="fa-solid fa-terminal"></i> سجل التخاطب مع السيرفر</div>',
            html: `<div style="background:#0f172a; color:#a5b4fc; padding:15px; border-radius:8px; text-align:left; direction:ltr; font-family:'JetBrains Mono', monospace; font-size:0.85rem; white-space:pre-wrap; max-height:400px; overflow-y:auto; border:1px solid #334155; box-shadow:inset 0 2px 4px rgba(0,0,0,0.5);">${logContent}</div>`,
            background: '#1e293b',
            color: '#fff',
            confirmButtonColor: '#3b82f6',
            confirmButtonText: 'إغلاق الشاشة',
            width: '600px',
            customClass: { popup: 'border border-secondary rounded-4' }
        });
    }

    function openEditTxModal(txId, currentAmount, currentIsoDate) {
        document.getElementById('editTxForm').action = '/transaction/' + txId + '/edit-data';
        document.getElementById('newAmountInput').value = currentAmount;
        if (currentIsoDate) {
            const dateObj = new Date(currentIsoDate);
            const tzOffset = dateObj.getTimezoneOffset() * 60000;
            document.getElementById('newDateInput').value = (new Date(dateObj - tzOffset)).toISOString().slice(0, 16);
        }
        new bootstrap.Modal(document.getElementById('editTxModal')).show();
    }

    function openEditRateModal(txId, currentRate) {
        document.getElementById('editRateForm').action = '/transaction/' + txId + '/edit-rate';
        document.getElementById('newRateInput').value = (currentRate && currentRate !== '0') ? currentRate : '';
        new bootstrap.Modal(document.getElementById('editRateModal')).show();
    }

    function txEscape(value) {
        return String(value ?? '---')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function copyAdminDetailValue(button) {
        const value = button?.dataset?.copy || '';
        if (!value) return;
        if (window.AdminOperationDetails && AdminOperationDetails.copyText) {
            return AdminOperationDetails.copyText(value, button);
        }
    }

    async function viewTransactionDetails(el) {
        const reference = JSON.parse(el.getAttribute('data-tx'));
        const snapshots = JSON.parse(document.getElementById('transactionRowsData')?.textContent || '{}');
        const txData = snapshots[reference._id] || reference;
        const modalEl = document.getElementById('txModal');
        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
        if (window.AdminOperationDetails) AdminOperationDetails.showLoading(modalEl);
        modalInstance.show();

        let tx = txData;
        let ledgerInfo = null;
        let balanceTransferPair = null;

        try {
            const response = await fetch(`/transactions/${txData._id}/details`);
            const resData = await response.json();
            if (resData.success) {
                tx = resData.transaction;
                ledgerInfo = resData.ledgerInfo;
                balanceTransferPair = resData.balanceTransferPair;
            }
        } catch (err) {
            console.error('Error fetching transaction details:', err);
        }

        window.currentTxToPrint = tx;
        window.currentLedgerInfo = ledgerInfo;

        const executorBotsElement = document.getElementById('executorBotsData');
        const executorBots = executorBotsElement && executorBotsElement.textContent.trim() ? JSON.parse(executorBotsElement.textContent) : [];
        const formatDate = (d) => d ? new Date(d).toLocaleString('en-GB', { timeZone: 'Africa/Tripoli' }).replace(',', '') : (window.AdminOperationDetails ? AdminOperationDetails.EMPTY_NONE : 'لا يوجد');

        if (window.AdminOperationDetails) {
            AdminOperationDetails.mount(modalEl, {
                tx,
                ledgerInfo,
                balanceTransferPair,
                allBotsMap,
                executorBots,
                noteView: splitTransactionNotes(tx),
                formatDate
            });
        }
    }

    function printInvoice() {
        if (!window.currentTxToPrint) return;
        const tx = window.currentTxToPrint;
        const printNoteView = splitTransactionNotes(tx);
        const f = (d) => d ? new Date(d).toLocaleString('ar-EG', { timeZone: 'Africa/Tripoli', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '---';

        if (tx.transferType === 'balance_transfer') {
            // Show alert box to ask whether to include client balances
            Swal.fire({
                title: 'خيارات طباعة الإيصال 🧾',
                text: 'هل تريد إظهار رصيد المرسل والمستلم (قبل وبعد العملية) في إيصال الطباعة؟',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'نعم، إظهار الأرصدة',
                cancelButtonText: 'لا، إخفاء الأرصدة',
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#64748b',
                background: document.documentElement.getAttribute('data-theme') === 'dark' ? '#1e293b' : '#fff',
                color: document.documentElement.getAttribute('data-theme') === 'dark' ? '#fff' : '#000',
            }).then((result) => {
                const showBalances = result.isConfirmed;

                // Get sender and receiver information
                let senderName = tx.accountName || '---';
                let senderCode = tx.accountNumber || tx.vodafoneNumber || '---';
                let recipientName = '---';
                let recipientCode = '---';

                // Find sender and receiver ledger entries from global variable
                let ledgerInfo = window.currentLedgerInfo || null;
                let senderLedger = ledgerInfo ? ledgerInfo.find(l => l.amount < 0) : null;
                let receiverLedger = ledgerInfo ? ledgerInfo.find(l => l.amount > 0) : null;

                let senderBefore = senderLedger ? senderLedger.balanceBefore.toFixed(2) + ' LYD' : '---';
                let senderAfter = senderLedger ? senderLedger.balanceAfter.toFixed(2) + ' LYD' : '---';
                let receiverBefore = receiverLedger ? receiverLedger.balanceBefore.toFixed(2) + ' LYD' : '---';
                let receiverAfter = receiverLedger ? receiverLedger.balanceAfter.toFixed(2) + ' LYD' : '---';

                if (senderLedger && senderLedger.description) {
                    const match = /تحويل رصيد إلى\s+(.*?)\s*\((.*?)\)/.exec(senderLedger.description);
                    if (match) {
                        recipientName = match[1].trim();
                        recipientCode = match[2].trim();
                    }
                }
                if (recipientName === '---') {
                    const match = /إلى\s+(.*?)\s+-\s+ID:\s*(\w+)/.exec([tx.adminNotes, tx.notes].filter(Boolean).join('\n'));
                    if (match) {
                        recipientName = match[1].trim();
                        recipientCode = match[2].trim();
                    }
                }

                const baseId = tx.customId.replace(/-[CD]$/, '');
                const transferIdD = `${baseId}-D`;
                const transferIdC = `${baseId}-C`;

                const printWindow = window.open('', '_blank');
                printWindow.document.write(`
                    <html lang="ar" dir="rtl">
                    <head>
                        <title>إيصال تحويل رصيد - ${baseId}</title>
                        <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;800;900&display=swap" rel="stylesheet">
                        <style>
                            * { box-sizing: border-box; }
                            @page { size: A5 landscape; margin: 0; }
                            body {
                                font-family: 'Tajawal', sans-serif;
                                background: #fff;
                                color: #333;
                                margin: 0;
                                padding: 0;
                                -webkit-print-color-adjust: exact;
                                print-color-adjust: exact;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                width: 210mm;
                                height: 148mm;
                            }
                            .receipt-box {
                                width: 210mm;
                                height: 148mm;
                                padding: 10mm 15mm;
                                border: none;
                                background: #fff;
                                display: flex;
                                flex-direction: column;
                                justify-content: space-between;
                                box-sizing: border-box;
                            }
                            .brand-header {
                                display: flex;
                                justify-content: space-between;
                                align-items: center;
                                border-bottom: 2px solid #f1f5f9;
                                padding-bottom: 8px;
                                margin-bottom: 12px;
                            }
                            .brand-name {
                                font-size: 32px;
                                font-weight: 900;
                                color: #0f172a;
                                margin: 0;
                                letter-spacing: 0.5px;
                            }
                            .receipt-title {
                                font-size: 16px;
                                color: #64748b;
                                font-weight: 700;
                                background: #f8fafc;
                                padding: 6px 16px;
                                border-radius: 20px;
                                border: 1px solid #e2e8f0;
                            }
                            .flow-container {
                                display: flex;
                                align-items: center;
                                justify-content: space-between;
                                background: #f8fafc;
                                border: 1px solid #e2e8f0;
                                padding: 10px 20px;
                                border-radius: 12px;
                                margin-bottom: 15px;
                            }
                            .flow-node {
                                text-align: center;
                                flex: 1;
                            }
                            .flow-node-title {
                                font-size: 12px;
                                color: #64748b;
                                font-weight: bold;
                                margin-bottom: 4px;
                            }
                            .flow-node-name {
                                font-size: 18px;
                                font-weight: 800;
                                color: #0f172a;
                            }
                            .flow-node-code {
                                font-size: 13px;
                                color: #475569;
                                font-family: monospace;
                            }
                            .flow-arrow {
                                font-size: 24px;
                                color: #3b82f6;
                                padding: 0 15px;
                            }
                            .content-row {
                                display: flex;
                                gap: 20px;
                                flex: 1;
                                align-items: center;
                            }
                            .content-col {
                                flex: 1;
                            }
                            .col-left {
                                display: flex;
                                flex-direction: column;
                                justify-content: center;
                                align-items: center;
                                border-left: 2px dashed #e2e8f0;
                                padding-left: 20px;
                            }
                            .amount-card {
                                background: #eff6ff;
                                border: 1px solid #bfdbfe;
                                border-radius: 12px;
                                padding: 20px;
                                text-align: center;
                                width: 100%;
                            }
                            .amount-label {
                                font-size: 14px;
                                color: #1e3a8a;
                                font-weight: bold;
                            }
                            .amount-val {
                                font-size: 32px;
                                font-weight: 900;
                                color: #1d4ed8;
                                margin-top: 4px;
                            }
                            .details-table {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .details-table th, .details-table td {
                                padding: 8px 6px;
                                text-align: right;
                                border-bottom: 1px solid #f1f5f9;
                                font-size: 13px;
                            }
                            .details-table th {
                                color: #64748b;
                                font-weight: 700;
                                width: 40%;
                            }
                            .details-table td {
                                color: #0f172a;
                                font-weight: 800;
                            }
                            .balance-block {
                                display: flex;
                                justify-content: space-between;
                                font-size: 12px;
                                color: #475569;
                                background: #fafafa;
                                padding: 6px 10px;
                                border-radius: 6px;
                                margin-top: 4px;
                                border: 1px solid #e2e8f0;
                            }
                            .footer {
                                display: flex;
