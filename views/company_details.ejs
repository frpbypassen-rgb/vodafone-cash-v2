<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>تفاصيل الشركة | شركة الأهرام</title>

    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.9);
            --glass-border: rgba(0, 0, 0, 0.08);
            --shadow-3d: 0 10px 30px rgba(0, 0, 0, 0.04);
            --text-main: #1e293b;
            --text-muted: #64748b;
            --input-bg: #f8fafc;
            --brand-primary: #8b5cf6;
        }

        [data-theme="dark"] {
            --glass-bg: rgba(30, 41, 59, 0.7);
            --glass-border: rgba(255, 255, 255, 0.1);
            --shadow-3d: 0 10px 30px rgba(0, 0, 0, 0.3);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --input-bg: rgba(0, 0, 0, 0.2);
            --brand-primary: #a855f7;
        }

        .glass-card {
            background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border); border-radius: 20px; padding: 25px;
            box-shadow: var(--shadow-3d); transition: 0.3s; position: relative; overflow: hidden;
        }

        .glass-card::before {
            content: ''; position: absolute; top: -50%; right: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 60%);
            transform: rotate(45deg); pointer-events: none; z-index: 0;
        }

        .profile-icon {
            width: 75px; height: 75px; border-radius: 20px;
            display: flex; align-items: center; justify-content: center; font-size: 2.2rem;
            color: white; box-shadow: 0 10px 20px rgba(0,0,0,0.15); position: relative; z-index: 1; margin-bottom: 15px;
        }

        .info-box {
            background: var(--input-bg); border-radius: 14px; padding: 15px;
            border: 1px solid var(--glass-border); margin-bottom: 15px; position: relative; z-index: 1;
            display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
        }

        .control-card-3d {
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-style: preserve-3d; border-radius: 16px !important;
            padding: 15px !important;
        }
        .control-card-3d:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 25px rgba(0,0,0,0.08) !important;
        }
        [data-theme="dark"] .control-card-3d:hover { box-shadow: 0 15px 25px rgba(0,0,0,0.4) !important; }

        .btn-3d-hover { transition: all 0.2s; }
        .btn-3d-hover:hover { transform: translateY(-2px); filter: brightness(1.1); box-shadow: 0 6px 12px rgba(0,0,0,0.15); }
        .btn-3d-hover:active { transform: translateY(1px); }
        .void-adjustment-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px; }

        .mono-num { font-family: 'JetBrains Mono', monospace; font-weight: 800;}
        .form-control, .form-select { background: var(--input-bg); color: var(--text-main); border: 1px solid var(--glass-border); font-weight: bold; border-radius: 10px; }
        .form-control:focus, .form-select:focus { background: transparent; border-color: var(--brand-primary); box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2); color: var(--text-main); }

        .company-command-center { margin-bottom: 24px; }
        .company-hero {
            background: linear-gradient(135deg, rgba(99, 102, 241, .18), rgba(16, 185, 129, .10));
            border: 1px solid var(--glass-border); border-radius: 22px; padding: 22px; box-shadow: var(--shadow-3d);
        }
        .company-hero h4 { color: var(--text-main); }
        .company-metric {
            min-height: 110px; border: 1px solid var(--glass-border); background: var(--glass-bg);
            border-radius: 16px; padding: 14px; box-shadow: var(--shadow-3d);
        }
        .company-metric .metric-label { color: var(--text-muted); font-size: .76rem; font-weight: 800; }
        .company-metric .metric-value { color: var(--text-main); font-size: 1.35rem; font-weight: 900; margin-top: 6px; }
        .company-section-nav {
            position: sticky; top: 10px; z-index: 15; display: flex; gap: 8px; overflow-x: auto;
            padding: 10px; margin-top: 14px; border-radius: 16px; background: color-mix(in srgb, var(--glass-bg) 94%, transparent);
            border: 1px solid var(--glass-border); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
        }
        .company-section-nav a {
            color: var(--text-main); text-decoration: none; white-space: nowrap; font-size: .82rem; font-weight: 800;
            border: 1px solid var(--glass-border); border-radius: 10px; padding: 8px 11px; transition: .2s;
        }
        .company-section-nav a:hover, .company-section-nav a.is-active { background: var(--brand-primary); color: #fff; border-color: var(--brand-primary); }
        .company-section-title { scroll-margin-top: 90px; color: var(--text-main); font-weight: 900; margin: 30px 0 14px; }
        .company-section-title small { color: var(--text-muted); display: block; font-size: .78rem; font-weight: 700; margin-top: 3px; }
        .security-employee { border-bottom: 1px dashed var(--glass-border); padding: 10px 0; }
        .security-employee:last-child { border-bottom: 0; padding-bottom: 0; }
        .audit-row { border-bottom: 1px dashed var(--glass-border); padding: 12px 0; }
        .audit-row:last-child { border-bottom: 0; }
        .company-empty { color: var(--text-muted); text-align: center; padding: 24px; font-weight: 800; }

        /* توحيد الارتفاعات */
        .unified-height { min-height: 42px; display: flex; align-items: center; }

        @media (max-width: 991.98px) {
            .client-detail-title {
                align-items: stretch !important;
                gap: 10px;
                flex-wrap: wrap;
            }
            .client-detail-title h3 {
                font-size: 1.05rem;
                line-height: 1.45;
            }
            .client-detail-title .btn {
                width: 100%;
                justify-content: center;
            }
            .glass-card {
                border-radius: 16px;
                padding: 16px;
            }
            .info-box {
                align-items: flex-start;
                gap: 8px;
            }
            .statement-card {
                background: var(--glass-bg);
                border: 1px solid var(--glass-border);
                border-radius: 16px;
                padding: 14px;
                box-shadow: var(--shadow-3d);
                overflow: hidden;
            }
            .statement-card + .statement-card {
                margin-top: 12px;
            }
            .statement-head,
            .statement-row {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                gap: 10px;
                align-items: center;
            }
            .statement-row {
                padding-top: 10px;
                margin-top: 10px;
                border-top: 1px dashed var(--glass-border);
            }
            .statement-label {
                display: block;
                color: var(--text-muted);
                font-size: 0.72rem;
                font-weight: 800;
            }
            .statement-value {
                display: block;
                color: var(--text-main);
                font-size: 0.88rem;
                font-weight: 900;
                overflow-wrap: anywhere;
            }
            .statement-note {
                color: var(--text-muted);
                font-size: 0.82rem;
                line-height: 1.6;
            }
            .company-hero { padding: 16px; border-radius: 16px; }
            .company-section-nav { top: 4px; margin-inline: -2px; border-radius: 12px; }
            .company-metric { min-height: 92px; }
        }
    </style>

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Al-Ahram">
    <!-- End PWA Setup -->
</head>
<body>

<%- include('partials/sidebar', { activePage: 'clients' }) %>

<% const reversibleIds = new Set((typeof reversibleSettlements !== 'undefined' ? reversibleSettlements : []).map(String)); %>

<div class="main-content">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4 client-detail-title">
            <h3 class="fw-bold m-0" style="color: var(--text-main);"><i class="fa-solid fa-building text-primary me-2"></i> بيانات الشركة (الوكيل)</h3>
            <div class="d-flex flex-wrap gap-2">
                <% if (typeof isMaster !== 'undefined' && isMaster) { %>
                    <a href="/admin/accounts/company/<%= company._id %>/edit" class="btn btn-success fw-bold rounded-3 shadow-sm px-3 btn-3d-hover"><i class="fa-solid fa-pen-to-square me-1"></i> تعديل البيانات</a>
                    <a href="/company/<%= company._id %>/integration-guide.pdf" class="btn btn-dark fw-bold rounded-3 shadow-sm px-3 btn-3d-hover" title="تنزيل وثيقة ربط API الخاصة بالشركة"><i class="fa-solid fa-file-pdf me-1"></i> وثيقة ربط API</a>
                <% } %>
                <a href="/clients" class="btn btn-secondary fw-bold rounded-3 shadow-sm px-3 btn-3d-hover"><i class="fa-solid fa-arrow-right me-1"></i> عودة للقائمة</a>
            </div>
        </div>
        <% if (query && query.codeSaved) { %>
            <div class="alert alert-success fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-check-circle me-1"></i> تم حفظ ID الشركة بنجاح.</div>
        <% } else if (query && query.profileUpdated) { %>
            <div class="alert alert-success fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-circle-check me-1"></i> تم تحديث بيانات الشركة وتسجيل التغيير في سجل التدقيق.</div>
        <% } else if (query && query.codeError) { %>
            <div class="alert alert-danger fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-triangle-exclamation me-1"></i> لم يتم حفظ ID الشركة. تأكد من 5 أرقام وعدم تكرار الرقم.</div>
        <% } %>
        <% if (query && query.balanceSaved) { %>
            <div class="alert alert-success fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-circle-check me-1"></i> تم تسجيل <%= query.balanceSaved === 'deposit' ? 'الإيداع' : 'الخصم' %> وتحديث الرصيد بنجاح. يمكن أن يصبح الرصيد سالبًا عند الخصم.</div>
        <% } %>
        <% if (query && query.settlementVoided) { %>
            <div class="alert alert-info fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-rotate-left me-1"></i> تم حذف أثر التسوية من الرصيد مع الاحتفاظ بالقيد الأصلي وحركة الإلغاء في السجل المالي.</div>
        <% } %>
        <% if (query && query.balanceError) { %>
            <div class="alert alert-danger fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-triangle-exclamation me-1"></i> تعذر تحديث الرصيد. تحقق من المبلغ والحساب ثم أعد المحاولة.</div>
        <% } %>
        <% if (query && query.routePolicySaved) { %>
            <div class="alert alert-success fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-circle-check me-1"></i> تم حفظ سياسة توجيه الشركة. العمليات التي تتجاوز الحد ستبقى للمراجعة اليدوية.</div>
        <% } else if (query && query.routePolicyError) { %>
            <div class="alert alert-danger fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-triangle-exclamation me-1"></i> تعذر حفظ سياسة التوجيه. <%= query.routePolicyError === 'limit' ? 'أدخل حدًا ماليًا أكبر من صفر.' : (query.routePolicyError === 'executor' ? 'اختر منفذ تنفيذ نشطًا صالحًا.' : 'أعد المحاولة.') %></div>
        <% } %>
        <% if (query && query.webhookDeleted) { %>
            <div class="alert alert-success fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-circle-check me-1"></i> تم حذف رابط الـWebhook المختار وإيقاف أي إرسال جديد إليه.</div>
        <% } else if (query && query.webhookDeleteError) { %>
            <div class="alert alert-danger fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-triangle-exclamation me-1"></i> تعذر حذف رابط الـWebhook. أعد تحميل الصفحة ثم حاول مرة أخرى.</div>
        <% } %>
        <% if (query && query.apiTokenRotated) { %>
            <div class="alert alert-success fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-key me-1"></i> تم إصدار مفتاح API جديد وإيقاف المفتاح السابق فوراً. حمّل وثيقة الربط الجديدة وشارك المفتاح الجديد فقط مع جهة الربط.</div>
        <% } else if (query && query.apiTokenError) { %>
            <div class="alert alert-danger fw-bold rounded-4 shadow-sm"><i class="fa-solid fa-triangle-exclamation me-1"></i> تعذر إصدار مفتاح API جديد. لم يتغير المفتاح السابق، أعد المحاولة.</div>
        <% } %>

        <% const txMetrics = transactionMetrics || {}; const apiSummary = apiMetrics || {}; const completedCount = Number(txMetrics.completedCount || 0); const totalCount = Number(txMetrics.totalCount || 0); const successRate = totalCount ? Math.round((completedCount / totalCount) * 100) : 0; const activeEmployees = (employees || []).filter((employee) => employee.status === 'active'); const protectedEmployees = activeEmployees.filter((employee) => employee.mfaEnabled); %>
        <section class="company-command-center" id="company-overview">
            <div class="company-hero">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                    <div>
                        <div class="small fw-bold text-muted mb-1">مركز التحكم الموحد</div>
                        <h4 class="m-0 fw-bold"><i class="fa-solid fa-building-shield text-primary me-2"></i><%= company.name %></h4>
                        <div class="small text-muted mt-2">ملف تشغيلي ومالي وأمني واحد لإدارة الشركة دون تداخل بين الأقسام.</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge <%= company.status === 'active' ? 'bg-success' : 'bg-danger' %> px-3 py-2"><%= company.status === 'active' ? 'حساب نشط' : 'حساب موقوف' %></span>
                        <span class="badge bg-dark px-3 py-2 mono-num">#<%= company.accountCode || String(company._id).slice(-8) %></span>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-6 col-lg-3"><div class="company-metric"><div class="metric-label">الرصيد المتاح</div><div class="metric-value mono-num <%= company.balance < 0 ? 'text-danger' : 'text-success' %>" dir="ltr"><%= Number(company.balance || 0).toFixed(2) %> <small>LYD</small></div></div></div>
                    <div class="col-6 col-lg-3"><div class="company-metric"><div class="metric-label">العمليات المعلقة</div><div class="metric-value text-warning mono-num"><%= Number(txMetrics.pendingCount || 0) %></div></div></div>
                    <div class="col-6 col-lg-3"><div class="company-metric"><div class="metric-label">نسبة نجاح العمليات</div><div class="metric-value text-success mono-num"><%= successRate %>%</div></div></div>
                    <div class="col-6 col-lg-3"><div class="company-metric"><div class="metric-label">حماية الموظفين</div><div class="metric-value mono-num"><%= protectedEmployees.length %>/<%= activeEmployees.length %> <small>2FA</small></div></div></div>
                </div>
            </div>
            <nav class="company-section-nav" aria-label="أقسام ملف الشركة">
                <a href="#company-overview" class="is-active"><i class="fa-solid fa-gauge-high me-1"></i> نظرة عامة</a>
                <a href="#company-profile"><i class="fa-solid fa-id-card me-1"></i> البيانات</a>
                <a href="#company-security"><i class="fa-solid fa-shield-halved me-1"></i> الأمان</a>
                <a href="#company-finance"><i class="fa-solid fa-wallet me-1"></i> المالية</a>
                <a href="#company-operations"><i class="fa-solid fa-list-check me-1"></i> العمليات</a>
                <a href="#company-api-integration"><i class="fa-solid fa-code me-1"></i> API</a>
                <a href="#company-webhook-integration"><i class="fa-solid fa-tower-broadcast me-1"></i> Webhooks</a>
                <a href="#company-reports"><i class="fa-solid fa-chart-line me-1"></i> التقارير</a>
                <a href="#company-audit"><i class="fa-solid fa-clock-rotate-left me-1"></i> التدقيق</a>
            </nav>
        </section>

        <h5 class="company-section-title" id="company-profile"><i class="fa-solid fa-id-card text-primary me-2"></i> البيانات الشخصية والتجارية<small>هوية الشركة وبيانات مسؤول التواصل</small></h5>

        <div class="row g-4 mb-4">
            <div class="col-xl-4 col-lg-5">
                <div class="glass-card h-100" style="border-top: 5px solid #8b5cf6;">
                    <div class="profile-icon mx-auto" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">
                        <i class="fa-solid fa-building"></i>
                    </div>
                    <h4 class="fw-bold text-center mb-1" style="color: var(--text-main);"><%= company.name %></h4>
                    <p class="text-center text-muted fw-bold mb-3 small">وكالة / شركة مسجلة في النظام</p>

                    <div class="info-box d-block text-center border-0 shadow-sm py-3" style="background: rgba(139, 92, 246, 0.05); border-right: 4px solid #8b5cf6 !important;">
                        <span class="d-block small text-muted fw-bold mb-1"><i class="fa-solid fa-wallet me-1"></i> الرصيد الحالي (LYD)</span>
                        <h2 class="m-0 fw-900 mono-num <%= company.balance < 0 ? 'text-danger' : 'text-success' %>" dir="ltr"><%= company.balance.toFixed(2) %></h2>
                    </div>

                    <div class="info-box py-2 px-3">
                        <span class="small text-muted fw-bold"><i class="fa-solid fa-phone me-1"></i> الهاتف</span>
                        <span class="fw-bold text-dark mono-num" dir="ltr"><%= company.phone %></span>
                    </div>

                    <div class="info-box py-2 px-3">
                        <span class="small text-muted fw-bold"><i class="fa-solid fa-user-tie me-1"></i> مسؤول التواصل</span>
                        <span class="fw-bold text-dark"><%= company.businessProfile?.contactName || 'غير محدد' %></span>
                    </div>

                    <div class="info-box py-2 px-3">
                        <span class="small text-muted fw-bold"><i class="fa-solid fa-envelope me-1"></i> البريد الإلكتروني</span>
                        <span class="fw-bold text-dark small text-break" dir="ltr"><%= company.businessProfile?.email || 'غير محدد' %></span>
                    </div>

                    <div class="info-box py-2 px-3">
                        <span class="small text-muted fw-bold"><i class="fa-solid fa-location-dot me-1"></i> المدينة والسجل</span>
                        <span class="fw-bold text-dark small"><%= company.businessProfile?.city || 'غير محدد' %> · <span dir="ltr"><%= company.businessProfile?.registrationNumber || '—' %></span></span>
                    </div>

                    <div class="info-box py-2 px-3">
                        <span class="small text-muted fw-bold"><i class="fa-solid fa-id-badge me-1"></i> ID الشركة</span>
                        <span class="fw-bold text-dark mono-num" dir="ltr"><%= company.accountCode || 'غير محدد' %></span>
                    </div>

                    <div class="info-box py-2 px-3">
                        <span class="small text-muted fw-bold"><i class="fa-solid fa-key me-1"></i> مفتاح ربط API</span>
                        <% if (typeof isMaster !== 'undefined' && isMaster) { %>
                            <span class="fw-bold text-dark mono-num small" dir="ltr" style="filter: blur(3px); transition: 0.3s; cursor: pointer;" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='blur(3px)'"><%= company.token %></span>
                        <% } else { %>
                            <span class="small fw-bold text-muted">محمي — متاح للإدارة فقط</span>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-xl-8 col-lg-7">
                <div class="glass-card h-100 border-start border-4" style="border-left-color: #f59e0b;">
                    <div class="d-flex align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--glass-border) !important;">
                        <i class="fa-solid fa-gears text-warning fs-4 me-2"></i>
                        <h5 class="fw-bold m-0" style="color: var(--text-main);">التحكم المحاسبي والإداري</h5>
                    </div>

                    <div class="row g-3">
                        <% if (typeof isMaster !== 'undefined' && isMaster) { %>
                            <div class="col-12" id="company-api-integration">
                                <div class="info-box border-0 m-0 shadow-sm control-card-3d d-block" style="background: rgba(14, 165, 233, 0.06); border-right: 4px solid #0ea5e9 !important;">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                        <label class="form-label fw-bold text-dark mb-0"><i class="fa-solid fa-plug-circle-bolt text-info me-1"></i> إدارة ربط API للشركة</label>
                                        <span class="badge bg-info text-dark">المفتاح الحالي نشط</span>
                                    </div>
                                    <div class="row g-2 align-items-center">
                                        <div class="col-lg-5">
                                            <div class="small text-muted fw-bold mb-1">المفتاح الحالي</div>
                                            <code class="d-block p-2 rounded bg-dark text-light text-break" dir="ltr" style="font-size:.75rem; filter: blur(3px); cursor:pointer;" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='blur(3px)'"><%= company.token || 'سيتم إنشاؤه عند تنزيل الوثيقة' %></code>
                                        </div>
                                        <div class="col-lg-4">
                                            <a href="/company/<%= company._id %>/integration-guide.pdf" class="btn btn-outline-info w-100 fw-bold unified-height justify-content-center"><i class="fa-solid fa-file-pdf me-1"></i> تحميل وثيقة الربط</a>
                                        </div>
                                        <div class="col-lg-3">
                                            <form action="/company/<%= company._id %>/rotate-api-token" method="POST" onsubmit="return confirm('سيتم إيقاف مفتاح API الحالي فوراً وإصدار مفتاح جديد. هل تريد المتابعة؟');">
                                                <button type="submit" class="btn btn-danger w-100 fw-bold unified-height justify-content-center"><i class="fa-solid fa-arrows-rotate me-1"></i> تبديل المفتاح</button>
                                            </form>
                                        </div>
                                    </div>
                                    <small class="d-block text-muted mt-2"><i class="fa-solid fa-shield-halved me-1"></i> عند تبديل المفتاح يتوقف القديم فوراً. حمّل الوثيقة الجديدة وأرسل المفتاح الجديد عبر قناة آمنة فقط.</small>
                                </div>
                            </div>
                            <% const routePolicy = company.autoRoutePolicy || {}; %>
                            <div class="col-12" id="company-auto-routing">
                                <div class="info-box border-0 m-0 shadow-sm control-card-3d d-block" style="background: rgba(245, 158, 11, 0.08); border-right: 4px solid #f59e0b !important;">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                        <label class="form-label fw-bold text-dark mb-0"><i class="fa-solid fa-route text-warning me-1"></i> توجيه عمليات الشركة إلى منفذ واحد</label>
                                        <span class="badge <%= routePolicy.enabled ? 'bg-success' : 'bg-secondary' %>"><%= routePolicy.enabled ? 'مفعّل' : 'متوقف' %></span>
                                    </div>
                                    <p class="small text-muted mb-3">عند التفعيل، يُرسل النظام فقط العمليات التي لا تتجاوز الحد إلى المنفذ المحدد. أي عملية أكبر من الحد، أو غير متوافقة مع خدمة المنفذ، تبقى <strong>معلّقة للمراجعة اليدوية</strong> ولا تستخدم التوجيه العام.</p>
                                    <form action="/company/<%= company._id %>/auto-route-policy" method="POST" class="row g-2 align-items-end">
                                        <div class="col-lg-2">
                                            <div class="form-check form-switch pt-2">
                                                <input class="form-check-input" type="checkbox" role="switch" id="company-auto-route-enabled" name="enabled" <%= routePolicy.enabled ? 'checked' : '' %>>
                                                <label class="form-check-label fw-bold" for="company-auto-route-enabled">تفعيل</label>
                                            </div>
                                        </div>
                                        <div class="col-lg-5">
                                            <label class="form-label small fw-bold mb-1" for="company-auto-route-executor">منفذ التنفيذ</label>
                                            <select class="form-select unified-height" id="company-auto-route-executor" name="executorGroupId" <%= routePolicy.enabled ? 'required' : '' %>>
                                                <option value="">اختر منفذًا نشطًا</option>
                                                <% (executorGroups || []).forEach((executor) => { %>
                                                    <option value="<%= executor._id %>" <%= String(routePolicy.executorGroupId || '') === String(executor._id) ? 'selected' : '' %>><%= executor.name %> — <%= executor.serviceKey %><%= executor.isApiBot || executor.isApiGroup ? ' (API)' : ' (يدوي)' %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label class="form-label small fw-bold mb-1" for="company-auto-route-limit">الحد الأقصى للتوجيه الآلي (ج.م)</label>
                                            <input class="form-control unified-height mono-num" id="company-auto-route-limit" name="maxAutoAmount" type="number" min="1" step="1" inputmode="decimal" value="<%= Number(routePolicy.maxAutoAmount) > 0 ? Number(routePolicy.maxAutoAmount) : '' %>" placeholder="مثال: 5000" <%= routePolicy.enabled ? 'required' : '' %> dir="ltr">
                                        </div>
                                        <div class="col-lg-2">
                                            <button class="btn btn-warning w-100 fw-bold unified-height justify-content-center" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i> حفظ</button>
                                        </div>
                                    </form>
                                    <% if (routePolicy.updatedAt) { %><small class="d-block text-muted mt-2">آخر تعديل: <%= new Date(routePolicy.updatedAt).toLocaleString('ar-EG') %> بواسطة <%= routePolicy.updatedBy || 'الإدارة' %>.</small><% } %>
                                </div>
                            </div>
                            <div class="col-12" id="company-webhook-integration">
                                <div class="info-box border-0 m-0 shadow-sm control-card-3d d-block" style="background: rgba(16, 185, 129, 0.06); border-right: 4px solid #10b981 !important;">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                        <label class="form-label fw-bold text-dark mb-0"><i class="fa-solid fa-tower-broadcast text-success me-1"></i> Webhooks الشركة</label>
                                        <span class="badge bg-success">تحديث حالة العمليات مباشرة</span>
                                    </div>
                                    <p class="small text-muted mb-3">يرسل النظام إشعاراً موقّعاً إلى خادم الشركة عند إنشاء العملية أو تغير حالتها. لا يُقبل إلا عنوان HTTPS عام، ومفتاح التوقيع يظهر مرة واحدة فقط.</p>
                                    <form method="post" class="row g-2" data-webhook-form data-company-id="<%= company._id %>">
                                        <div class="col-lg-6"><input name="url" type="url" class="form-control unified-height" placeholder="https://partner.example.com/webhooks/ahrampay" required dir="ltr"></div>
                                        <div class="col-lg-4 d-flex flex-wrap align-items-center gap-2 small">
                                            <% webhookEvents.forEach((eventName) => { %>
                                                <label class="form-check-label"><input class="form-check-input" type="checkbox" name="events" value="<%= eventName %>" checked> <span dir="ltr"><%= eventName.replace('transaction.', '') %></span></label>
                                            <% }) %>
                                        </div>
                                        <div class="col-lg-2"><button class="btn btn-success w-100 fw-bold unified-height" type="submit"><i class="fa-solid fa-plus me-1"></i> إضافة</button></div>
                                    </form>
                                    <div class="mt-3 small" data-webhook-result></div>
                                    <% if (webhookSubscriptions.length) { %>
                                        <div class="table-responsive mt-3"><table class="table table-sm align-middle mb-0"><thead><tr><th>العنوان</th><th>الأحداث</th><th>الحالة</th><th>آخر تسليم</th><th>الإجراءات</th></tr></thead><tbody>
                                            <% webhookSubscriptions.forEach((item) => { %><tr><td class="text-break" dir="ltr"><%= item.url %></td><td dir="ltr"><%= item.events.join(', ') %></td><td><span class="badge <%= item.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= item.status %></span></td><td><%= item.lastDeliveredAt ? new Date(item.lastDeliveredAt).toLocaleString('ar-EG') : '—' %></td><td class="d-flex gap-1"><a class="btn btn-sm btn-outline-dark" href="/company/<%= company._id %>/webhooks/<%= item._id %>/deliveries" target="_blank">السجل</a><form action="/company/<%= company._id %>/webhooks/<%= item._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('سيتم حذف هذا الرابط وإيقاف الإرسال إليه نهائياً. هل تريد المتابعة؟');"><button class="btn btn-sm btn-outline-danger" type="submit" title="حذف الرابط"><i class="fa-solid fa-trash"></i> حذف</button></form></td></tr><% }) %>
                                        </tbody></table></div>
                                    <% } else { %><div class="small text-muted mt-3">لا توجد قنوات Webhook مفعلة لهذه الشركة حتى الآن.</div><% } %>
                                </div>
                            </div>
                        <% } %>

                        <div class="col-12" id="company-finance">
                            <div class="info-box border-0 m-0 shadow-sm control-card-3d d-block" style="background: rgba(139, 92, 246, 0.05); border-right: 4px solid var(--brand-primary) !important;">
                                <label class="form-label fw-bold text-dark small mb-2"><i class="fa-solid fa-id-badge me-1" style="color: var(--brand-primary);"></i> ID الشركة للتحويل الداخلي (<%= accountCodeLength %> أرقام)</label>
                                <form action="/company/<%= company._id %>/update-account-code" method="POST" class="row g-2 align-items-center">
                                    <div class="col-md-8">
                                        <input type="text" name="accountCode" class="form-control text-center fw-bold mono-num unified-height border-0 shadow-sm" value="<%= company.accountCode || '' %>" placeholder="<%= '0'.repeat(accountCodeLength) %>" pattern="\d{<%= accountCodeLength %>}" maxlength="<%= accountCodeLength %>" inputmode="numeric">
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn text-white w-100 fw-bold btn-3d-hover unified-height justify-content-center shadow-sm" style="background: var(--brand-primary);">حفظ ID</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-box border-0 m-0 shadow-sm control-card-3d d-block" style="background: rgba(245, 158, 11, 0.05); border-right: 4px solid #f59e0b !important;">
                                <label class="form-label fw-bold text-dark small mb-2"><i class="fa-solid fa-money-bill-transfer text-warning me-1"></i> تسوية الرصيد (موجب للإيداع / سالب للخصم)</label>
                                <form action="/company/<%= company._id %>/add-balance" method="POST" class="row g-2 align-items-center">
                                    <div class="col-md-4">
                                        <div class="input-group shadow-sm">
                                            <input type="number" step="any" name="amount" class="form-control mono-num fw-bold text-center unified-height border-0" placeholder="المبلغ..." required>
                                            <span class="input-group-text border-0 fw-bold px-2" style="background: #fcd34d; color:#000;">LYD</span>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="input-group shadow-sm">
                                            <span class="input-group-text border-0 bg-light text-muted px-2"><i class="fa-solid fa-pen"></i></span>
                                            <input type="text" name="notes" class="form-control fw-bold unified-height border-0" placeholder="ملاحظة للتسوية...">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-warning w-100 fw-bold text-dark btn-3d-hover unified-height justify-content-center shadow-sm"><i class="fa-solid fa-floppy-disk me-1"></i> تنفيذ</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box border-0 m-0 shadow-sm d-block control-card-3d" style="background: rgba(239, 68, 68, 0.05); border-right: 4px solid #ef4444 !important;">
                                <label class="form-label fw-bold text-dark small mb-2"><i class="fa-solid fa-hand-holding-dollar text-danger me-1"></i> حد السحب المكشوف</label>
                                <form action="/company/<%= company._id %>/update-limit" method="POST" class="row g-2 align-items-center">
                                    <div class="col-8">
                                        <input type="number" step="any" name="creditLimit" class="form-control text-center fw-bold mono-num unified-height border-0 shadow-sm" value="<%= company.creditLimit || 0 %>" placeholder="المبلغ" required>
                                    </div>
                                    <div class="col-4">
                                        <button type="submit" class="btn btn-danger w-100 fw-bold btn-3d-hover unified-height justify-content-center shadow-sm">تحديث</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box border-0 m-0 shadow-sm d-block control-card-3d" style="background: rgba(14, 165, 233, 0.05); border-right: 4px solid #0ea5e9 !important;">
                                <label class="form-label fw-bold text-dark small mb-2"><i class="fa-solid fa-layer-group text-info me-1"></i> مستوى التسعير</label>
                                <form action="/company/<%= company._id %>/change-level" method="POST" class="row g-2 align-items-center">
                                    <div class="col-8">
                                        <select name="tier" class="form-select fw-bold text-center unified-height border-0 shadow-sm">
                                            <option value="1" <%= company.tier === 1 ? 'selected' : '' %>>مستوى 1 (أساسي)</option>
                                            <option value="2" <%= company.tier === 2 ? 'selected' : '' %>>مستوى 2 (متوسط)</option>
                                            <option value="3" <%= company.tier === 3 ? 'selected' : '' %>>مستوى 3 (VIP)</option>
                                        </select>
                                    </div>
                                    <div class="col-4">
                                        <button type="submit" class="btn btn-info text-white w-100 fw-bold btn-3d-hover unified-height justify-content-center shadow-sm">تغيير</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="col-12" id="company-pricing">
                            <div class="info-box border-0 m-0 shadow-sm d-block control-card-3d" style="background: rgba(139, 92, 246, 0.05); border-right: 4px solid var(--brand-primary) !important;">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                    <label class="form-label fw-bold text-dark mb-0"><i class="fa-solid fa-exchange-alt me-1" style="color: var(--brand-primary)"></i> أسعار الصرف الخاصة بالشركة</label>
                                    <span class="badge <%= companyRateConfig.mode === 'custom' ? 'bg-primary' : 'bg-success' %>"><%= companyRateConfig.mode === 'custom' ? 'مرتبطة بالعام بفروق خاصة' : 'تتبع السعر العام' %></span>
                                </div>
                                <% if (query && query.rateUpdated) { %><div class="alert alert-success py-2 fw-bold"><i class="fa-solid fa-circle-check me-1"></i>تم حفظ أسعار الشركة.</div><% } %>
                                <% if (query && query.rateError) { %><div class="alert alert-danger py-2 fw-bold"><i class="fa-solid fa-circle-exclamation me-1"></i>تعذر حفظ الأسعار. راجع القيم المدخلة.</div><% } %>
                                <form action="/company/<%= company._id %>/update-rate" method="POST" class="row g-3 align-items-end" data-company-detail-rate-form>
                                    <div class="col-12 col-lg-4">
                                        <label class="form-label small fw-bold text-muted">سياسة التسعير</label>
                                        <select name="rateMode" class="form-select fw-bold text-center unified-height" data-company-detail-rate-mode>
                                            <option value="general" <%= companyRateConfig.mode === 'general' ? 'selected' : '' %>>السعر العام التلقائي</option>
                                            <option value="custom" <%= companyRateConfig.mode === 'custom' ? 'selected' : '' %>>سعر خاص مرتبط بالعام</option>
                                        </select>
                                    </div>
                                    <% rateServices.forEach((service) => { %>
                                        <div class="col-6 col-md-4 col-xl-2">
                                            <label class="form-label small fw-bold text-muted"><%= service.label %><% if (service.rateDirection === 'source_to_lyd') { %><small class="d-block">1 سيفا = د.ل</small><% } %></label>
                                            <input type="number" min="0.01" step="0.01" name="companyRate_<%= service.key %>" class="form-control text-center fw-bold mono-num unified-height" value="<%= Number(companyRateConfig.effectiveRates[service.key]).toFixed(2) %>" data-company-detail-rate-input <%= companyRateConfig.mode === 'general' ? 'disabled' : '' %>>
                                            <small class="text-muted"><%= service.rateDirection === 'source_to_lyd' ? 'العام: 1 سيفا = ' : 'العام: ' %><%= Number(companyRateConfig.generalRates[service.key]).toFixed(2) %><%= service.rateDirection === 'source_to_lyd' ? ' د.ل' : '' %></small>
                                        </div>
                                    <% }) %>
                                    <div class="col-12 col-lg-4 ms-auto">
                                        <button type="submit" class="btn text-white w-100 fw-bold btn-3d-hover unified-height justify-content-center shadow-sm" style="background: var(--brand-primary);"><i class="fa-solid fa-floppy-disk me-1"></i>حفظ أسعار الشركة</button>
                                    </div>
                                </form>
                                <script>
                                    (() => {
                                        const form = document.querySelector('[data-company-detail-rate-form]');
                                        const mode = form?.querySelector('[data-company-detail-rate-mode]');
                                        const syncMode = () => form?.querySelectorAll('[data-company-detail-rate-input]').forEach((input) => {
                                            input.disabled = mode.value !== 'custom';
                                        });
                                        mode?.addEventListener('change', syncMode);
                                        syncMode();
                                    })();
                                </script>
                            </div>
                        </div>

                        <div class="col-12 mt-1">
                            <form action="/company/<%= company._id %>/toggle-status" method="POST" class="m-0" onsubmit="return confirm('تأكيد تعديل حالة الشركة؟');">
                                <button type="submit" class="btn btn-<%= company.status === 'active' ? 'danger' : 'success' %> w-100 fw-bold unified-height justify-content-center rounded-3 shadow-sm btn-3d-hover d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-power-off"></i> <span><%= company.status === 'active' ? 'إيقاف وحظر الشركة نهائياً' : 'تنشيط وإعادة تشغيل البوت' %></span>
                                </button>
                            </form>
                        </div>

                        <div class="col-12 mt-1">
                            <form action="/company/<%= company._id %>/delete" method="POST" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذه الشركة؟ سيتم إيقاف دخول موظفيها والعملاء التابعين لها مع حفظ العمليات السابقة.');">
                                <button type="submit" class="btn btn-outline-danger w-100 fw-bold unified-height justify-content-center rounded-3 shadow-sm btn-3d-hover d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-trash-can"></i> <span>حذف الحساب</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <section id="company-security">
            <h5 class="company-section-title"><i class="fa-solid fa-shield-halved text-success me-2"></i> الأمان والصلاحيات<small>حماية حسابات الشركة ومراجعة صلاحيات الموظفين</small></h5>
            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="glass-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3"><span class="fw-bold" style="color:var(--text-main)">حالة الحماية</span><i class="fa-solid fa-user-shield text-success fs-4"></i></div>
                        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small fw-bold">الموظفون النشطون</span><span class="mono-num fw-bold"><%= activeEmployees.length %></span></div>
                        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small fw-bold">المفعّل لديهم 2FA</span><span class="mono-num fw-bold text-success"><%= protectedEmployees.length %></span></div>
                        <div class="d-flex justify-content-between py-2"><span class="text-muted small fw-bold">دون حماية إضافية</span><span class="mono-num fw-bold <%= activeEmployees.length > protectedEmployees.length ? 'text-warning' : 'text-success' %>"><%= Math.max(0, activeEmployees.length - protectedEmployees.length) %></span></div>
                        <div class="small text-muted mt-3">لا تظهر كلمات المرور أو أسرار المصادقة في هذه الصفحة. راجع صلاحيات الموظفين قبل تعطيل أي حساب.</div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="glass-card h-100">
                        <div class="d-flex justify-content-between align-items-center gap-2 mb-3"><div><div class="fw-bold" style="color:var(--text-main)">موظفو الشركة وصلاحياتهم</div><div class="small text-muted">عرض تشغيلي للحسابات المرتبطة بالشركة</div></div><a href="/employees?section=clients" class="btn btn-sm btn-outline-primary fw-bold">إدارة الموظفين</a></div>
                        <% if ((employees || []).length) { %>
                            <% employees.slice(0, 6).forEach((employee) => { %>
                                <div class="security-employee d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div><div class="fw-bold" style="color:var(--text-main)"><%= employee.name %> <span class="badge bg-light text-dark ms-1"><%= employee.role === 'owner' ? 'مالك' : (employee.role === 'accountant' ? 'محاسب' : 'موظف') %></span></div><div class="small text-muted" dir="ltr"><%= employee.webUsername || employee.phone || '—' %></div></div>
                                    <div class="d-flex gap-1"><span class="badge <%= employee.status === 'active' ? 'bg-success' : 'bg-secondary' %>"><%= employee.status === 'active' ? 'نشط' : 'موقوف' %></span><span class="badge <%= employee.mfaEnabled ? 'bg-success' : 'bg-warning text-dark' %>"><%= employee.mfaEnabled ? '2FA مفعّل' : '2FA غير مفعّل' %></span></div>
                                </div>
                            <% }) %>
                            <% if (employees.length > 6) { %><div class="small text-muted mt-2">+ <%= employees.length - 6 %> حسابات أخرى ضمن صفحة إدارة الموظفين.</div><% } %>
                        <% } else { %><div class="company-empty">لا توجد حسابات موظفين مرتبطة بهذه الشركة.</div><% } %>
                    </div>
                </div>
            </div>
        </section>

        <section id="company-reports">
            <h5 class="company-section-title"><i class="fa-solid fa-chart-line text-info me-2"></i> التقارير والتحليلات<small>ملخص تشغيلي مباشر من بيانات الشركة الفعلية</small></h5>
            <div class="row g-3">
                <div class="col-6 col-lg-3"><div class="company-metric"><div class="metric-label">إجمالي العمليات</div><div class="metric-value mono-num"><%= totalCount %></div><div class="small text-muted">جميع السجلات</div></div></div>
                <div class="col-6 col-lg-3"><div class="company-metric"><div class="metric-label">حجم التحويلات</div><div class="metric-value mono-num"><%= Number(txMetrics.transferVolumeEGP || 0).toFixed(0) %> <small>EGP</small></div><div class="small text-muted">دون حركات الإيداع والخصم</div></div></div>
                <div class="col-6 col-lg-3"><div class="company-metric"><div class="metric-label">تكلفة العمليات</div><div class="metric-value mono-num"><%= Number(txMetrics.costVolumeLYD || 0).toFixed(2) %> <small>LYD</small></div><div class="small text-muted">إجمالي تكلفة التنفيذ</div></div></div>
                <div class="col-6 col-lg-3"><div class="company-metric"><div class="metric-label">سجل API</div><div class="metric-value mono-num"><%= Number(apiSummary.success || 0) %>/<%= Number(apiSummary.total || 0) %></div><div class="small text-muted">سجلات اتصال ناجحة</div></div></div>
                <div class="col-lg-7"><div class="glass-card h-100"><div class="fw-bold mb-3" style="color:var(--text-main)"><i class="fa-solid fa-book-open text-warning me-1"></i> آخر الحركات المالية</div><% if ((ledgerEntries || []).length) { %><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>المرجع</th><th>النوع</th><th>الأثر</th><th>الرصيد بعده</th><th>التاريخ</th></tr></thead><tbody><% ledgerEntries.slice(0, 5).forEach((entry) => { %><tr><td class="mono-num small"><%= entry.transactionId %></td><td><span class="badge bg-light text-dark"><%= entry.type %></span></td><td class="mono-num <%= Number(entry.amount) >= 0 ? 'text-success' : 'text-danger' %>" dir="ltr"><%= Number(entry.amount || 0).toFixed(2) %></td><td class="mono-num" dir="ltr"><%= Number(entry.balanceAfter || 0).toFixed(2) %></td><td class="small"><%= new Date(entry.createdAt).toLocaleDateString('ar-EG') %></td></tr><% }) %></tbody></table></div><% } else { %><div class="company-empty">لا توجد حركات دفتر أستاذ ظاهرة لهذه الشركة.</div><% } %></div></div>
                <div class="col-lg-5"><div class="glass-card h-100"><div class="fw-bold mb-3" style="color:var(--text-main)"><i class="fa-solid fa-plug-circle-bolt text-primary me-1"></i> صحة التكامل</div><div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted fw-bold small">قنوات Webhook النشطة</span><span class="badge bg-success mono-num"><%= (webhookSubscriptions || []).filter((item) => item.status === 'active').length %></span></div><div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted fw-bold small">اتصالات API المعلقة</span><span class="badge bg-warning text-dark mono-num"><%= Number(apiSummary.pending || 0) %></span></div><div class="d-flex justify-content-between py-2"><span class="text-muted fw-bold small">اتصالات API الفاشلة</span><span class="badge <%= Number(apiSummary.failed || 0) ? 'bg-danger' : 'bg-success' %> mono-num"><%= Number(apiSummary.failed || 0) %></span></div><a href="#company-api-integration" class="btn btn-outline-primary w-100 mt-3 fw-bold">فتح إعدادات API</a></div></div>
            </div>
        </section>

        <h5 class="company-section-title" id="company-operations"><i class="fa-solid fa-list-check text-primary me-2"></i> العمليات والتنفيذ<small>آخر 50 عملية مع سجل الاتصال عند توفره</small></h5>
        <div class="glass-card p-0 overflow-hidden">
            <div class="table-responsive m-0 border-0 d-none d-lg-block">
                <table class="table text-center align-middle m-0 table-hover">
                    <thead class="table-light">
                        <tr><th>الرقم</th><th>المبلغ</th><th>التكلفة (LYD)</th><th>البيان / الحساب</th><th>الملاحظة</th><th>الوقت</th><th>الحالة</th><th>الإجراء</th></tr>
                    </thead>
                    <tbody>
                        <% if(transactions.length === 0) { %>
                            <tr><td colspan="8" class="py-4 text-muted fw-bold border-0"><i class="fa-solid fa-folder-open fs-2 d-block mb-2 opacity-25"></i>لا توجد عمليات.</td></tr>
                        <% } %>
                        <% transactions.forEach(tx => {
                            const settlementStatus = tx.balanceAdjustment && tx.balanceAdjustment.originalStatus ? tx.balanceAdjustment.originalStatus : tx.status;
                            const isSettlement = ['deposit', 'deduction'].includes(settlementStatus);
                            const isVoidedSettlement = Boolean(tx.balanceAdjustment && tx.balanceAdjustment.voidedAt);
                            const canVoidSettlement = ['deposit', 'deduction'].includes(tx.status) && reversibleIds.has(String(tx.customId));
                        %>
                            <tr style="<%= settlementStatus === 'deposit' ? 'background: rgba(16, 185, 129, 0.05);' : (settlementStatus === 'deduction' ? 'background: rgba(239, 68, 68, 0.05);' : '') %>">
                                <td class="fw-bold text-muted small mono-num">#<%= tx.customId || tx._id.toString().slice(-6) %></td>
                                <td class="fw-bold mono-num fs-6 <%= isVoidedSettlement ? 'text-muted text-decoration-line-through' : (settlementStatus === 'deposit' ? 'text-success' : (settlementStatus === 'deduction' ? 'text-danger' : 'text-primary')) %>"><%= tx.amount.toFixed(2) %> <small><%= isSettlement ? 'LYD' : 'EGP' %></small></td>
                                <td class="fw-bold text-danger mono-num fs-6"><%= tx.costLYD ? tx.costLYD.toFixed(2) : '---' %></td>
                                <td class="fw-bold text-dark small" dir="ltr"><%= settlementStatus === 'deposit' ? 'إيداع نقدي' : (settlementStatus === 'deduction' ? 'خصم مديونية' : (tx.vodafoneNumber || '---')) %></td>
                                <td class="small text-muted text-wrap" style="max-width: 200px;"><%= tx.notes || '---' %></td>
                                <td class="small mono-num opacity-75" dir="ltr"><%= new Date(tx.updatedAt).toLocaleString('en-GB', { timeZone: 'Africa/Tripoli' }) %></td>
                                <td>
                                    <% if(isVoidedSettlement) { %><span class="badge bg-secondary">محذوف ومعكوس</span>
                                    <% } else if(tx.status === 'completed') { %><span class="badge bg-success">منفذ</span>
                                    <% } else if(tx.status === 'deposit') { %><span class="badge bg-primary">إيداع</span>
                                    <% } else if(tx.status === 'deduction') { %><span class="badge bg-danger">خصم</span>
                                    <% } else if(tx.status === 'rejected' || tx.status === 'cancelled_by_admin') { %><span class="badge bg-secondary">ملغي</span>
                                    <% } else { %><span class="badge bg-warning text-dark">معلق</span><% } %>
                                </td>
                                <td>
                                    <% if (canVoidSettlement) { %>
                                        <form action="/transaction/<%= tx._id %>/void-balance-adjustment" method="POST" class="d-inline" onsubmit="return confirm('هل تريد حذف هذه التسوية؟ سيتم عكس أثرها من الرصيد مع الاحتفاظ بالقيد وحركة الإلغاء في السجل المالي.');">
                                            <input type="hidden" name="reason" value="حذف التسوية من صفحة حساب الشركة أو الوكيل">
                                            <button type="submit" class="btn btn-outline-danger void-adjustment-btn" title="حذف التسوية وعكس أثرها" aria-label="حذف التسوية وعكس أثرها"><i class="fa-solid fa-trash-can"></i></button>
                                        </form>
                                    <% } else if (tx.isApiReview || tx.apiResultData || String(tx.adminNotes || '').includes('سجل الـ API')) { %>
                                        <a class="btn btn-sm btn-outline-primary" target="_blank" href="/company/<%= company._id %>/api-communication/<%= tx._id %>" title="سجل تخاطب API"><i class="fa-solid fa-terminal"></i></a>
                                    <% } else { %><span class="text-muted">-</span><% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="d-lg-none p-3">
                <% if(transactions.length === 0) { %>
                    <div class="text-center py-4 text-muted fw-bold">
                        <i class="fa-solid fa-folder-open fs-2 d-block mb-2 opacity-25"></i>لا توجد عمليات.
                    </div>
                <% } %>
                <% transactions.forEach(tx => {
                    const settlementStatus = tx.balanceAdjustment && tx.balanceAdjustment.originalStatus ? tx.balanceAdjustment.originalStatus : tx.status;
                    const isSettlement = ['deposit', 'deduction'].includes(settlementStatus);
                    const isVoidedSettlement = Boolean(tx.balanceAdjustment && tx.balanceAdjustment.voidedAt);
                    const canVoidSettlement = ['deposit', 'deduction'].includes(tx.status) && reversibleIds.has(String(tx.customId));
                %>
                    <div class="statement-card">
                        <div class="statement-head">
                            <div>
                                <span class="statement-label">رقم العملية</span>
                                <span class="statement-value mono-num">#<%= tx.customId || tx._id.toString().slice(-6) %></span>
                            </div>
                            <div class="text-end">
                                <% if(isVoidedSettlement) { %><span class="badge bg-secondary">محذوف ومعكوس</span>
                                <% } else if(tx.status === 'completed') { %><span class="badge bg-success">منفذ</span>
                                <% } else if(tx.status === 'deposit') { %><span class="badge bg-primary">إيداع</span>
                                <% } else if(tx.status === 'deduction') { %><span class="badge bg-danger">خصم</span>
                                <% } else if(tx.status === 'rejected' || tx.status === 'cancelled_by_admin') { %><span class="badge bg-secondary">ملغي</span>
                                <% } else { %><span class="badge bg-warning text-dark">معلق</span><% } %>
                            </div>
                        </div>
                        <div class="statement-row">
                            <div>
                                <span class="statement-label">المبلغ</span>
                                <span class="statement-value mono-num <%= isVoidedSettlement ? 'text-muted text-decoration-line-through' : (settlementStatus === 'deposit' ? 'text-success' : (settlementStatus === 'deduction' ? 'text-danger' : 'text-primary')) %>"><%= tx.amount.toFixed(2) %> <%= isSettlement ? 'LYD' : 'EGP' %></span>
                            </div>
                            <div>
                                <span class="statement-label">التكلفة</span>
                                <span class="statement-value mono-num text-danger"><%= tx.costLYD ? tx.costLYD.toFixed(2) : '---' %> LYD</span>
                            </div>
                        </div>
                        <div class="statement-row">
                            <div>
                                <span class="statement-label">البيان</span>
                                <span class="statement-value" dir="ltr"><%= settlementStatus === 'deposit' ? 'إيداع نقدي' : (settlementStatus === 'deduction' ? 'خصم مديونية' : (tx.vodafoneNumber || '---')) %></span>
                            </div>
                            <div>
                                <span class="statement-label">الوقت</span>
                                <span class="statement-value mono-num" dir="ltr"><%= new Date(tx.updatedAt).toLocaleString('en-GB', { timeZone: 'Africa/Tripoli' }) %></span>
                            </div>
                        </div>
                        <% if (tx.notes) { %>
                            <div class="statement-row" style="grid-template-columns: 1fr;">
                                <div>
                                    <span class="statement-label">الملاحظة</span>
                                    <div class="statement-note"><%= tx.notes %></div>
                                </div>
                            </div>
                        <% } %>
                        <% if (canVoidSettlement) { %>
                            <form action="/transaction/<%= tx._id %>/void-balance-adjustment" method="POST" class="mt-3" onsubmit="return confirm('هل تريد حذف هذه التسوية؟ سيتم عكس أثرها من الرصيد مع الاحتفاظ بالقيد وحركة الإلغاء في السجل المالي.');">
                                <input type="hidden" name="reason" value="حذف التسوية من صفحة حساب الشركة أو الوكيل">
                                <button type="submit" class="btn btn-outline-danger w-100 fw-bold"><i class="fa-solid fa-trash-can me-1"></i> حذف التسوية وعكس الرصيد</button>
                            </form>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>

        <section id="company-audit">
            <h5 class="company-section-title"><i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i> سجل التدقيق<small>آخر تغييرات الإدارة والعمليات الحساسة المرتبطة بالشركة</small></h5>
            <div class="glass-card">
                <% if ((auditEntries || []).length) { %>
                    <% auditEntries.forEach((entry) => { %>
                        <div class="audit-row d-flex flex-wrap align-items-start justify-content-between gap-2">
                            <div>
                                <div class="fw-bold" style="color:var(--text-main)"><i class="fa-solid <%= entry.severity === 'critical' ? 'fa-triangle-exclamation text-danger' : (entry.severity === 'warning' ? 'fa-shield-halved text-warning' : 'fa-circle-info text-info') %> me-1"></i><%= entry.action || 'حدث تشغيلي' %></div>
                                <div class="small text-muted mt-1">بواسطة: <%= entry.performedByName || 'النظام' %><% if (entry.endpoint) { %> · <span dir="ltr"><%= entry.endpoint %></span><% } %></div>
                            </div>
                            <div class="text-end"><span class="badge <%= entry.result === 'فاشل' || entry.result === 'محظور' ? 'bg-danger' : (entry.result === 'معلق' ? 'bg-warning text-dark' : 'bg-success') %>"><%= entry.result || 'ناجح' %></span><div class="small text-muted mt-1 mono-num" dir="ltr"><%= new Date(entry.createdAt).toLocaleString('en-GB', { timeZone: 'Africa/Tripoli' }) %></div></div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="company-empty"><i class="fa-solid fa-shield-heart fs-3 d-block mb-2 opacity-50"></i>لا توجد أحداث تدقيق ظاهرة لهذه الشركة حتى الآن.</div>
                <% } %>
            </div>
        </section>

    </div>
</div>

<script>
    function toggleSidebar() {
        document.querySelector('.sidebar').classList.toggle('active');
        document.querySelector('.sidebar-overlay').classList.toggle('active');
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
<script>
document.querySelectorAll('[data-webhook-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const result = form.parentElement.querySelector('[data-webhook-result]');
        const data = new FormData(form);
        const events = data.getAll('events');
        result.className = 'mt-3 small text-muted'; result.textContent = 'جارٍ إنشاء قناة Webhook والتحقق من العنوان...';
        try {
            const response = await fetch(`/company/${form.dataset.companyId}/webhooks`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': data.get('_csrf') || '' }, body: JSON.stringify({ url: data.get('url'), events }) });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.error || 'تعذر إنشاء القناة.');
            result.className = 'mt-3 small text-success fw-bold';
            result.textContent = `تم الإنشاء. مفتاح التوقيع (انسخه الآن): ${payload.signing_secret}`;
            form.reset();
            setTimeout(() => window.location.reload(), 8000);
        } catch (error) { result.className = 'mt-3 small text-danger fw-bold'; result.textContent = error.message; }
    });
});

(() => {
    const navigation = [...document.querySelectorAll('.company-section-nav a')];
    const targets = navigation.map((link) => document.querySelector(link.getAttribute('href'))).filter(Boolean);
    const updateActiveSection = () => {
        const current = targets.reduce((selected, section) => (
            section.getBoundingClientRect().top <= 130 ? section : selected
        ), targets[0]);
        if (!current) return;
        navigation.forEach((link) => link.classList.toggle('is-active', link.getAttribute('href') === `#${current.id}`));
    };
    navigation.forEach((link) => link.addEventListener('click', () => {
        navigation.forEach((item) => item.classList.toggle('is-active', item === link));
    }));
    window.addEventListener('scroll', updateActiveSection, { passive: true });
    updateActiveSection();
})();
</script>
</html>
