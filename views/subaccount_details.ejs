<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>عميل الوكيل | شركة الأهرام</title>
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <style>
        :root { --glass-bg: rgba(255,255,255,.9); --glass-border: rgba(0,0,0,.08); --shadow-3d: 0 10px 30px rgba(0,0,0,.04); --text-main:#1e293b; --text-muted:#64748b; --input-bg:#f8fafc; }
        [data-theme="dark"] { --glass-bg: rgba(30,41,59,.7); --glass-border: rgba(255,255,255,.1); --shadow-3d: 0 10px 30px rgba(0,0,0,.3); --text-main:#f8fafc; --text-muted:#94a3b8; --input-bg: rgba(0,0,0,.2); }
        .glass-card { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 20px; padding: 25px; box-shadow: var(--shadow-3d); }
        .mono-num { font-family: 'JetBrains Mono', monospace; font-weight: 800; }
        .info-box { background: var(--input-bg); border-radius: 14px; padding: 15px; border: 1px solid var(--glass-border); margin-bottom: 12px; }
    </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'clients' }) %>
<% const reversibleIds = new Set((typeof reversibleSettlements !== 'undefined' ? reversibleSettlements : []).map(String)); %>
<% const ownerHref = subAccount.masterType === 'company' ? `/company/${subAccount.masterId}` : `/user/${subAccount.masterId}`; %>

<div class="main-content">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h3 class="fw-bold m-0" style="color: var(--text-main);"><i class="fa-solid fa-shop text-success me-2"></i> عميل الوكيل</h3>
            <div class="d-flex flex-wrap gap-2">
                <% if (typeof isMaster !== 'undefined' && isMaster) { %>
                    <a href="/admin/accounts/subaccount/<%= subAccount._id %>/edit" class="btn btn-success fw-bold rounded-3 shadow-sm px-3"><i class="fa-solid fa-pen-to-square me-1"></i> تعديل البيانات</a>
                <% } %>
                <a href="<%= ownerHref %>" class="btn btn-warning fw-bold rounded-3 shadow-sm px-3"><i class="fa-solid fa-user-tie me-1"></i> ملف الوكالة</a>
                <a href="/clients?section=subaccounts" class="btn btn-secondary fw-bold rounded-3 shadow-sm px-3"><i class="fa-solid fa-arrow-right me-1"></i> دليل الحسابات</a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="glass-card h-100" style="border-top: 5px solid #10b981;">
                    <h4 class="fw-bold mb-1" style="color: var(--text-main);"><%= subAccount.name %></h4>
                    <p class="text-muted fw-bold small mb-3"><%= subAccount.agencyLabel || 'عميل تابع لوكالة' %></p>
                    <div class="info-box text-center">
                        <span class="d-block small text-muted fw-bold mb-1">الرصيد الحالي (LYD)</span>
                        <strong class="mono-num fs-4 <%= Number(subAccount.balance) < 0 ? 'text-danger' : 'text-success' %>"><%= Number(subAccount.balance || 0).toFixed(2) %></strong>
                    </div>
                    <div class="info-box"><span class="text-muted small fw-bold">الهاتف</span><div class="fw-bold" dir="ltr"><%= subAccount.phone || 'بدون هاتف' %></div></div>
                    <div class="info-box"><span class="text-muted small fw-bold">اسم الدخول</span><div class="fw-bold"><code><%= subAccount.webUsername %></code></div></div>
                    <div class="info-box"><span class="text-muted small fw-bold">ID الحساب</span><div class="fw-bold mono-num"><%= subAccount.accountCode || '—' %></div></div>
                    <div class="info-box"><span class="text-muted small fw-bold">حد الائتمان</span><div class="fw-bold mono-num"><%= Number(subAccount.creditLimit || 0).toFixed(2) %></div></div>
                    <div class="info-box mb-0">
                        <span class="text-muted small fw-bold">الوكالة المالكة</span>
                        <div><a href="<%= ownerHref %>" class="fw-bold text-decoration-none"><%= subAccount.masterName || 'غير معروف' %></a></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="glass-card">
                    <h5 class="fw-bold mb-3" style="color: var(--text-main);"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> حركات الإيداع والتحويل</h5>
                    <div class="table-responsive">
                        <table class="table text-center align-middle">
                            <thead class="table-light">
                                <tr><th>الرقم</th><th>المبلغ</th><th>البيان</th><th>الوقت</th><th>الحالة</th><th></th></tr>
                            </thead>
                            <tbody>
                                <% if (!transactions.length) { %>
                                    <tr><td colspan="6" class="py-4 text-muted fw-bold">لا توجد عمليات ظاهرة للإدارة على هذا الحساب.</td></tr>
                                <% } %>
                                <% transactions.forEach((tx) => {
                                    const settlementStatus = tx.balanceAdjustment && tx.balanceAdjustment.originalStatus ? tx.balanceAdjustment.originalStatus : tx.status;
                                    const isVoided = Boolean(tx.balanceAdjustment && tx.balanceAdjustment.voidedAt);
                                    const canVoid = ['deposit', 'deduction'].includes(tx.status) && reversibleIds.has(String(tx.customId));
                                %>
                                    <tr>
                                        <td class="mono-num small">#<%= tx.customId || String(tx._id).slice(-6) %></td>
                                        <td class="mono-num fw-bold <%= settlementStatus === 'deposit' ? 'text-success' : (settlementStatus === 'deduction' ? 'text-danger' : '') %>"><%= Number(tx.amount || 0).toFixed(2) %></td>
                                        <td class="small"><%= tx.adminNotes || tx.notes || tx.subAccountName || '—' %></td>
                                        <td class="small mono-num" dir="ltr"><%= tx.createdAt ? new Date(tx.createdAt).toLocaleString('en-GB', { timeZone: 'Africa/Tripoli' }) : '—' %></td>
                                        <td>
                                            <% if (isVoided) { %><span class="badge bg-secondary">محذوف ومعكوس</span>
                                            <% } else if (tx.status === 'deposit') { %><span class="badge bg-primary">إيداع</span>
                                            <% } else if (tx.status === 'deduction') { %><span class="badge bg-danger">خصم</span>
                                            <% } else if (tx.status === 'completed') { %><span class="badge bg-success">منفذ</span>
                                            <% } else { %><span class="badge bg-warning text-dark"><%= tx.status %></span><% } %>
                                        </td>
                                        <td>
                                            <% if (canVoid) { %>
                                                <form action="/transaction/<%= tx._id %>/void-balance-adjustment" method="POST" onsubmit="return confirm('هل تريد حذف هذه التسوية؟');">
                                                    <input type="hidden" name="reason" value="حذف التسوية من صفحة عميل الوكيل">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash-can"></i></button>
                                                </form>
                                            <% } else { %>—<% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
