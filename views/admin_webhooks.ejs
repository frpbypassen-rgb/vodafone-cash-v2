<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>مراقبة Webhooks</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
<style>
body{background:#091321;color:#eaf1fb}
.shell{max-width:1400px;margin:auto;padding:28px 15px}
.box{background:#102033;border:1px solid #263d57;border-radius:16px;padding:18px;margin-bottom:15px}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.metric strong{font-size:1.8rem;display:block}
.table{--bs-table-bg:transparent;--bs-table-color:#eef5ff;white-space:nowrap}
.ok{color:#39d99b}
.bad{color:#ff7185}
.muted{color:#91a6bf}
@media(max-width:700px){.metrics{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<main class="shell">
<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<h1>مراقبة Webhooks</h1>
<div class="muted">حالة نقاط اتصال التجار ومحاولات التسليم</div>
</div>
<a class="btn btn-outline-light" href="/">لوحة القيادة</a>
</div>
<div id="app"></div>
</main>
<script src="/js/admin-webhooks.js"></script>
<script>
const csrf = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '').replace(/</g, '\\u003c') %>;
const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const failHtml = '<section class="box"><p class="bad">تعذر تحميل مراقبة الويب هوك. الاستجابة ليست ناجحة، لذلك لا تُعرض أصفار مكان البيانات.</p></section>';
async function load() {
    const app = document.getElementById('app');
    try {
        const response = await fetch('/admin/api/webhooks', { headers: { accept: 'application/json' } });
        const body = await response.json().catch(() => null);
        if (typeof classifyAdminWebhookLoad !== 'function') {
            app.innerHTML = failHtml;
            return;
        }
        const state = classifyAdminWebhookLoad(response.status, body);
        if (!state.ok) {
            app.innerHTML = failHtml;
            return;
        }
        const endpoints = state.endpoints;
        const deliveries = state.deliveries;
        const summary = state.summary;
        app.innerHTML = `<section class="metrics mb-3">${[['تم التسليم', summary.delivered || 0], ['فشل', summary.failed || 0], ['قيد الانتظار', summary.pending || 0], ['نقاط الاتصال', endpoints.length]].map((x) => `<div class="box metric"><strong>${x[1]}</strong><span class="muted">${x[0]}</span></div>`).join('')}</section><section class="box"><h2 class="h5">النقاط</h2>${endpoints.map((e) => `<div class="border-bottom py-2"><strong>${esc(e.name)}</strong> · <span dir="ltr">${esc(e.url)}</span> · <span class="${e.failureCount ? 'bad' : 'ok'}">فشل ${e.failureCount}</span></div>`).join('') || '<span class="muted">لا توجد نقاط</span>'}</section><section class="box"><div class="table-responsive"><table class="table"><thead><tr><th>الحدث</th><th>الحالة</th><th>المحاولات</th><th>HTTP</th><th>الخطأ</th><th></th></tr></thead><tbody>${deliveries.map((x) => `<tr><td dir="ltr">${esc(x.eventType)}</td><td class="${x.status === 'delivered' ? 'ok' : x.status === 'failed' ? 'bad' : ''}">${esc(x.status)}</td><td>${x.attemptCount}</td><td>${x.responseCode || '—'}</td><td>${esc(x.lastError || '—')}</td><td>${x.status !== 'delivered' ? `<button class="btn btn-sm btn-outline-info" onclick="retry('${x._id}')">إعادة</button>` : ''}</td></tr>`).join('')}</tbody></table></div></section>`;
    } catch (_error) {
        app.innerHTML = failHtml;
    }
}
async function retry(id) {
    await fetch('/admin/api/webhook-deliveries/' + id + '/retry', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
        body: '{}'
    });
    load();
}
load();
setInterval(load, 30000);
</script>
</body>
</html>
