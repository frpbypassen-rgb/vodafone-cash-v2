<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل دخول المنفذين | الأهرام</title>
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260824-contrast">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260824-contrast">
    <style>
        body.executor-portal-v2 { display: grid; place-items: center; min-height: 100vh; padding: 20px; }
        .x-login-card {
            width: 100%; max-width: 440px;
            background: var(--x-surface, rgba(13, 18, 35, 0.85));
            border: 1px solid var(--x-border, rgba(94, 234, 212, 0.18));
            border-radius: 24px;
            padding: 36px 28px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.35), 0 0 30px rgba(34, 211, 238, 0.06);
            animation: cardEnter 0.5s ease both;
        }
        .x-login-brand { display: flex; align-items: center; gap: 14px; margin-bottom: 28px; }
        .x-login-brand .x-logo-icon { width: 50px; height: 50px; border-radius: 14px; border: 1px solid var(--x-border-gold, rgba(251, 191, 36, 0.25)); display: grid; place-items: center; color: var(--x-gold, #facc15); font-size: 1.4rem; }
        .x-login-brand h1 { font-size: 1.25rem; font-weight: 900; color: var(--x-text, #f8fafc); margin: 0; }
        .x-login-brand p { font-size: 0.75rem; color: var(--x-muted, #94a3b8); margin: 0; }
        .x-form-label { color: var(--x-muted, #94a3b8); font-size: 0.78rem; font-weight: 800; margin-bottom: 8px; }
        .x-form-control {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--x-border, rgba(94, 234, 212, 0.18));
            color: var(--x-text, #f8fafc);
            border-radius: 12px;
            padding: 12px 14px;
            font-weight: 700;
            transition: 0.2s;
        }
        .x-form-control:focus { background: rgba(255,255,255,0.07); border-color: var(--x-cyan, #22d3ee); color: var(--x-text, #f8fafc); box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.1); }
        .x-form-control::placeholder { color: var(--x-muted, #94a3b8); }
        .x-btn-primary {
            width: 100%; border: 0; border-radius: 12px; padding: 14px;
            background: linear-gradient(135deg, var(--x-cyan, #22d3ee), var(--x-cyan-dim, #0891b2));
            color: #000; font-weight: 900; font-size: 1rem;
            box-shadow: 0 8px 24px rgba(34, 211, 238, 0.2);
            transition: 0.2s;
        }
        .x-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(34, 211, 238, 0.3); }
        .x-alert { border-radius: 12px; padding: 12px 14px; margin-bottom: 20px; font-weight: 800; font-size: 0.85rem; }
        .x-alert-danger { background: rgba(251, 113, 133, 0.1); border: 1px solid rgba(251, 113, 133, 0.25); color: var(--x-red, #fb7185); }
        .x-alert-info { background: rgba(34, 211, 238, 0.08); border: 1px solid rgba(34, 211, 238, 0.2); color: var(--x-cyan, #22d3ee); }
        .x-secure-badge { display: inline-flex; align-items: center; gap: 8px; color: var(--x-green, #34d399); font-size: 0.75rem; font-weight: 800; margin-bottom: 20px; }
        .x-mfa-dialog { text-align: center; padding: 8px 2px 2px; }
        .x-mfa-icon { width: 64px; height: 64px; display: grid; place-items: center; margin: 0 auto 16px; border-radius: 20px; color: var(--x-cyan, #22d3ee); background: rgba(34, 211, 238, .1); border: 1px solid rgba(34, 211, 238, .24); font-size: 1.6rem; }
        .x-mfa-dialog h2 { color: var(--x-text, #f8fafc); font-size: 1.15rem; font-weight: 900; margin-bottom: 8px; }
        .x-mfa-dialog p { color: var(--x-muted, #94a3b8); font-size: .84rem; line-height: 1.7; margin-bottom: 22px; }
        .x-mfa-token { text-align: center; letter-spacing: .42em; font-family: 'JetBrains Mono', monospace; font-size: 1.35rem; }
        .x-back-link { color: var(--x-muted, #94a3b8); font-size: .8rem; text-decoration: none; }
        @keyframes cardEnter { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
        @media (max-width: 480px) { .x-login-card { padding: 28px 20px; } }
    </style>
</head>
<body class="executor-portal-v2 executor-login-shell">
    <div class="x-login-card">
        <div class="x-login-brand">
            <div class="x-logo-icon"><i class="fa-solid fa-network-wired"></i></div>
            <div>
                <h1>بوابة التنفيذ</h1>
                <p>غرفة عمليات الأهرام</p>
            </div>
        </div>

        <% if (error) { %>
        <div class="x-alert x-alert-danger"><i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %></div>
        <% } %>

        <% if (mfaNotice) { %>
        <div class="x-alert x-alert-info"><i class="fa-solid fa-shield-halved me-1"></i> حسابك غير محمي برمز Authenticator. نوصي بتفعيله من الإعدادات لأمان أعلى.</div>
        <% } %>

        <form action="/executor-portal/login" method="POST">
            <% if (mfaRequired) { %>
            <section class="x-mfa-dialog" role="dialog" aria-modal="true" aria-labelledby="mfa-title" aria-describedby="mfa-description">
                <div class="x-mfa-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <h2 id="mfa-title">التحقق برمز Authenticator</h2>
                <p id="mfa-description">حسابك محمي. أدخل الرمز المكوّن من 6 أرقام الظاهر في تطبيق Authenticator لإكمال الدخول.</p>
                <div class="mb-3 text-start">
                    <label class="x-form-label" for="mfaToken">رمز التحقق</label>
                    <input id="mfaToken" type="text" name="mfaToken" class="x-form-control x-mfa-token" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required dir="ltr" autocomplete="one-time-code" autofocus>
                </div>
                <button type="submit" class="x-btn-primary">تحقق والدخول <i class="fa-solid fa-arrow-left ms-1"></i></button>
                <a href="/executor-portal/login" class="x-back-link d-inline-block mt-3"><i class="fa-solid fa-arrow-right me-1"></i> العودة لتسجيل الدخول</a>
            </section>
            <% } else { %>
            <div class="mb-3">
                <label class="x-form-label">اسم المستخدم</label>
                <input type="text" name="username" class="x-form-control" value="<%= submittedUsername || '' %>" placeholder="اسم المستخدم" required dir="ltr" autocomplete="username">
            </div>
            <div class="mb-4">
                <label class="x-form-label">كلمة المرور</label>
                <input type="password" name="password" class="x-form-control" placeholder="••••••••" required dir="ltr" autocomplete="current-password">
            </div>
            <button type="submit" class="x-btn-primary">دخول إلى غرفة التنفيذ <i class="fa-solid fa-arrow-left ms-1"></i></button>
            <% } %>
        </form>

        <div class="text-center mt-3">
            <a href="/executor-portal/register" class="text-decoration-none small" style="color: var(--x-muted, #94a3b8);">إنشاء حساب منفذ جديد</a>
        </div>
    </div>
</body>
</html>
