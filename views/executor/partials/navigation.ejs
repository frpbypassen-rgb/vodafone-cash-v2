<%
    const executorRole = String(emp?.role || 'operator');
    const currentPage = String(typeof activePage === 'undefined' ? '' : activePage);
    const executorRoleLabel = executorRole === 'manager'
        ? 'مدير تنفيذي'
        : (executorRole === 'accountant' ? 'محاسب' : 'موظف تنفيذ');
    const canHandleTasks = executorRole !== 'accountant';
    const canManageEmployees = executorRole === 'manager';
    const navItems = [
        ...(canHandleTasks ? [{ key: 'tasks', href: '/executor-portal/dashboard', icon: 'tasks', fa: 'fa-list-check', label: 'المهام' }] : []),
        { key: 'reports', href: '/executor-portal/reports', icon: 'reports', fa: 'fa-chart-column', label: 'التقارير' },
        ...(canManageEmployees ? [{ key: 'deposits', href: '/executor-portal/deposits', icon: 'wallet', fa: 'fa-building-columns', label: 'الإيداعات' }] : []),
        ...(canManageEmployees ? [{ key: 'employees', href: '/executor-portal/employees', icon: 'employees', fa: 'fa-users-gear', label: 'الفريق' }] : []),
        { key: 'support', href: '/executor-portal/support', icon: 'support', fa: 'fa-headset', label: 'الدعم' },
        { key: 'settings', href: '/executor-portal/settings', icon: 'settings', fa: 'fa-sliders', label: 'الإعدادات' }
    ];
%>
<%- include('exo-icons') %>

<% if (typeof showMfaNotice !== 'undefined' && showMfaNotice) { %>
<div class="container-fluid px-3 px-md-4 pt-3">
    <div class="alert alert-info alert-dismissible fade show mb-0 rounded-3 border-0 x-notice-info" role="alert">
        <i class="fa-solid fa-shield-halved me-1"></i>
        حسابك غير محمي برمز <b>Authenticator</b>. نوصي بتفعيله من <a href="/executor-portal/settings" class="text-decoration-underline">الإعدادات</a> لأمان أعلى.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق" style="filter: invert(0.7);"></button>
    </div>
</div>
<% } %>
<div id="offlineIndicator" class="container-fluid px-3 px-md-4 pt-3 d-none">
    <div class="alert alert-warning rounded-3 border-0 mb-0 x-notice-warn" role="alert">
        <i class="fa-solid fa-wifi me-1"></i> أنت في وضع offline. بعض البيانات قد لا تكون محدثة حتى يعود الاتصال.
    </div>
</div>
<script>
    (function() {
        const el = document.getElementById('offlineIndicator');
        const update = () => el?.classList.toggle('d-none', navigator.onLine);
        window.addEventListener('online', update);
        window.addEventListener('offline', update);
        update();
    })();
</script>
<% if (typeof emp !== 'undefined' && emp.role === 'manager' && emp.groupId && Number(emp.groupId.balance || 0) < 1000) { %>
<div class="container-fluid px-3 px-md-4 pt-3">
    <div class="alert alert-warning alert-dismissible fade show mb-0 rounded-3 border-0 x-notice-warn" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>
        رصيد شركة التنفيذ منخفض (<b><%= Number(emp.groupId.balance || 0).toLocaleString('en-US') %> ج.م</b>). يرجى الإيداع لتجنب توقف العمليات.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق" style="filter: invert(0.7);"></button>
    </div>
</div>
<% } %>

<aside class="exo-rail" aria-label="التنقل الرئيسي">
    <a class="exo-rail-brand" href="<%= canHandleTasks ? '/executor-portal/dashboard' : '/executor-portal/reports' %>">
        <img src="/images/logo.jpg" alt="">
        <span>AH</span>
    </a>
    <div class="exo-rail-live" title="متصل">
        <i></i>
    </div>
    <nav class="exo-rail-links">
        <% navItems.forEach((item) => { %>
            <a class="exo-rail-link <%= currentPage === item.key ? 'is-active' : '' %>" href="<%= item.href %>" <%= currentPage === item.key ? 'aria-current="page"' : '' %> title="<%= item.label %>">
                <span class="exo-ico-wrap">
                    <svg class="exo-ico"><use href="#exo-<%= item.icon %>"></use></svg>
                </span>
                <span class="exo-rail-label"><%= item.label %></span>
            </a>
        <% }) %>
    </nav>
    <a class="exo-rail-link is-exit" href="/executor-portal/logout" title="خروج">
        <span class="exo-ico-wrap">
            <svg class="exo-ico"><use href="#exo-logout"></use></svg>
        </span>
        <span class="exo-rail-label">خروج</span>
    </a>
</aside>

<nav class="exo-dock" aria-label="التنقل على الهاتف">
    <% navItems.forEach((item) => { %>
        <a class="exo-dock-link <%= currentPage === item.key ? 'is-active' : '' %>" href="<%= item.href %>" <%= currentPage === item.key ? 'aria-current="page"' : '' %>>
            <span class="exo-ico-wrap">
                <svg class="exo-ico"><use href="#exo-<%= item.icon %>"></use></svg>
            </span>
            <span><%= item.label %></span>
        </a>
    <% }) %>
</nav>
