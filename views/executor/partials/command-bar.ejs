<%
    const exoName = String(emp?.name || 'منفذ');
    const exoInitial = exoName.trim().charAt(0) || 'أ';
    const exoShowBalance = typeof showBalance === 'undefined' ? (emp?.role === 'manager') : showBalance;
    const snapshot = typeof companyBalances === 'object' && companyBalances ? companyBalances : null;
    const exoPrivate = snapshot ? Number(snapshot.privateBalance || 0) : Number(emp?.groupId?.balance || 0);
    const exoTotal = snapshot ? Number(snapshot.totalBalance || 0) : exoPrivate;
    const exoBalanceClass = exoPrivate > 0 ? 'is-positive' : (exoPrivate < 0 ? 'is-negative' : 'is-zero');
    const formatEgp = (value) => Number(value || 0).toLocaleString('en-US', { maximumFractionDigits: 2 });
%>
<header class="exo-command">
    <div class="exo-who">
        <div class="exo-avatar" aria-hidden="true"><%= exoInitial %></div>
        <div>
            <strong><%= exoName %></strong>
            <small><%= emp?.groupId?.name || 'غرفة العمليات' %></small>
        </div>
    </div>
    <div class="exo-command-actions">
        <% if (exoShowBalance) { %>
            <span class="exo-chip exo-balance <%= exoTotal > 0 ? 'is-positive' : '' %>" title="إجمالي الرصيد كما تراه الإدارة">
                <i class="fa-solid fa-vault"></i>
                <span>إجمالي الرصيد</span>
                <strong dir="ltr"><%= formatEgp(exoTotal) %> ج.م</strong>
            </span>
            <span id="executorManagerBalance" class="exo-chip exo-balance <%= exoBalanceClass %>" title="الرصيد الخاص المتاح للمدير">
                <i class="fa-solid fa-wallet"></i>
                <span>الرصيد الخاص</span>
                <strong dir="ltr"><%= formatEgp(exoPrivate) %> ج.م</strong>
            </span>
        <% } %>
        <%- typeof extras === 'string' ? extras : '' %>
        <button class="exo-icon-btn" type="button" onclick="typeof toggleTheme === 'function' ? toggleTheme() : toggleExecutorTheme()" data-executor-theme-toggle title="المظهر">
            <i class="fa-solid fa-moon" id="themeIcon" data-executor-theme-icon></i>
        </button>
        <a class="exo-icon-btn is-danger" href="/executor-portal/logout" title="تسجيل الخروج">
            <svg class="exo-ico"><use href="#exo-logout"></use></svg>
        </a>
    </div>
</header>
