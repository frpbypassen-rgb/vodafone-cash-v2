<%
    const exoName = String(emp?.name || 'منفذ');
    const exoInitial = exoName.trim().charAt(0) || 'أ';
    const exoShowBalance = typeof showBalance === 'undefined' ? (emp?.role === 'manager') : showBalance;
    const snapshot = typeof companyBalances === 'object' && companyBalances ? companyBalances : null;
    const exoPrivate = snapshot ? Number(snapshot.privateBalance || 0) : Number(emp?.groupId?.balance || 0);
    const exoTotal = snapshot ? Number(snapshot.totalBalance || 0) : exoPrivate;
    const exoBalanceClass = exoPrivate > 0 ? 'is-positive' : (exoPrivate < 0 ? 'is-negative' : 'is-zero');
    const formatEgp = (value) => Number(value || 0).toLocaleString('en-US', { maximumFractionDigits: 2 });
    const serviceRows = Array.isArray(snapshot?.byService) ? snapshot.byService : [];
    const multiService = Boolean(snapshot?.multiService) && serviceRows.length > 1;
%>
<header class="exo-command">
    <div class="exo-who">
        <div class="exo-avatar" aria-hidden="true"><%= exoInitial %></div>
        <div>
            <strong><%= exoName %></strong>
            <small><%= emp?.groupId?.name || 'غرفة العمليات' %></small>
        </div>
    </div>
    <div class="exo-command-actions">
        <% if (exoShowBalance) { %>
            <% if (multiService) { %>
                <% serviceRows.forEach((row) => { %>
                    <% if (row.appliesPoolModel) { %>
                        <span class="exo-chip exo-balance <%= Number(row.totalBalance) > 0 ? 'is-positive' : '' %>" data-company-balance="service-total" data-service-key="<%= row.serviceKey %>" title="<%= row.totalLabel %>">
                            <i class="fa-solid fa-vault"></i>
                            <span class="exo-balance-full"><%= row.totalLabel %></span>
                            <span class="exo-balance-short"><%= row.shortLabel %></span>
                            <strong dir="ltr"><%= formatEgp(row.totalBalance) %> ج.م</strong>
                        </span>
                        <span class="exo-chip exo-balance <%= Number(row.privateBalance) > 0 ? 'is-positive' : (Number(row.privateBalance) < 0 ? 'is-negative' : 'is-zero') %>" data-company-balance="service-private" data-service-key="<%= row.serviceKey %>" title="<%= row.privateLabel %>">
                            <i class="fa-solid fa-wallet"></i>
                            <span class="exo-balance-full"><%= row.privateLabel %></span>
                            <span class="exo-balance-short">خاص <%= row.shortLabel %></span>
                            <strong dir="ltr"><%= formatEgp(row.privateBalance) %> ج.م</strong>
                        </span>
                    <% } else { %>
                        <span class="exo-chip exo-balance <%= Number(row.privateBalance) > 0 ? 'is-positive' : (Number(row.privateBalance) < 0 ? 'is-negative' : 'is-zero') %>" data-company-balance="service-private" data-service-key="<%= row.serviceKey %>" title="<%= row.singleLabel %>">
                            <i class="fa-solid fa-building-columns"></i>
                            <span class="exo-balance-full"><%= row.singleLabel %></span>
                            <span class="exo-balance-short"><%= row.shortLabel %></span>
                            <strong dir="ltr"><%= formatEgp(row.privateBalance) %> ج.م</strong>
                        </span>
                    <% } %>
                <% }); %>
            <% } else { %>
            <span id="executorTotalBalance" class="exo-chip exo-balance <%= exoTotal > 0 ? 'is-positive' : '' %>" data-company-balance="total" title="إجمالي الرصيد: الرصيد الخاص + مجموعات الرصيد + المنفذين المنفردين (كما تراه الإدارة).">
                <i class="fa-solid fa-vault"></i>
                <span class="exo-balance-full">إجمالي الرصيد</span>
                <span class="exo-balance-short">إجمالي</span>
                <strong dir="ltr"><%= formatEgp(exoTotal) %> ج.م</strong>
            </span>
            <span id="executorManagerBalance" class="exo-chip exo-balance <%= exoBalanceClass %>" data-company-balance="private" title="الرصيد الخاص: رأس مال الشركة المتاح للمدير فقط. تمويل منفّذ خارجي يُخصم من هنا.">
                <i class="fa-solid fa-wallet"></i>
                <span class="exo-balance-full">الرصيد الخاص</span>
                <span class="exo-balance-short">خاص</span>
                <strong dir="ltr"><%= formatEgp(exoPrivate) %> ج.م</strong>
            </span>
            <% } %>
        <% } %>
        <%- typeof extras === 'string' ? extras : '' %>
        <button class="exo-icon-btn" type="button" onclick="typeof toggleTheme === 'function' ? toggleTheme() : toggleExecutorTheme()" data-executor-theme-toggle title="المظهر">
            <i class="fa-solid fa-moon" id="themeIcon" data-executor-theme-icon></i>
        </button>
        <a class="exo-icon-btn is-danger" href="/executor-portal/logout" title="تسجيل الخروج">
            <svg class="exo-ico"><use href="#exo-logout"></use></svg>
        </a>
    </div>
</header>
