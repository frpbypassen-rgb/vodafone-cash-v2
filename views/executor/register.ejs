<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إنشاء حساب منفذ | Power Pay AL-Ahram</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#071a33">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Al-Ahram">
    <link rel="stylesheet" href="/css/executor/pages/register.css">
</head>
<body>
    <main class="registration-shell">
        <aside class="identity-panel" aria-label="هوية بوابة المنفذين">
            <div class="brand-lockup">
                <div class="brand-mark">
                    <img src="/images/logo.jpg" alt="شعار شركة الأهرام للاتصالات والتقنية">
                </div>
                <div class="brand-name">
                    <strong>شركة الأهرام للاتصالات والتقنية</strong>
                    <span>Power Pay AL-Ahram</span>
                </div>
            </div>

            <div class="identity-intro">
                <p class="identity-kicker"><i class="fa-solid fa-circle"></i> بوابة المنفذين</p>
                <h1>حساب منفذ جديد</h1>
                <p>أرسل بيانات الجهة والمسؤول لمراجعتها وتفعيل الوصول إلى منصة التنفيذ.</p>
            </div>

            <ol class="process-list" aria-label="مراحل تفعيل الحساب">
                <li class="process-item">
                    <span class="process-icon"><i class="fa-solid fa-pen-to-square"></i></span>
                    <span class="process-copy"><strong>بيانات الحساب</strong><span>إدخال بيانات الجهة والدخول</span></span>
                </li>
                <li class="process-item">
                    <span class="process-icon"><i class="fa-solid fa-shield-halved"></i></span>
                    <span class="process-copy"><strong>مراجعة الإدارة</strong><span>التحقق من الطلب وبيانات التواصل</span></span>
                </li>
                <li class="process-item">
                    <span class="process-icon"><i class="fa-solid fa-circle-check"></i></span>
                    <span class="process-copy"><strong>تفعيل المنفذ</strong><span>إتاحة الدخول بعد الموافقة</span></span>
                </li>
            </ol>

            <div class="identity-footer">
                <i class="fa-solid fa-lock"></i>
                <span>تُحفظ بيانات الطلب بصورة آمنة حتى اكتمال المراجعة.</span>
            </div>
        </aside>

        <section class="form-panel">
            <% if (!success) { %>
                <header class="form-toolbar">
                    <div class="page-heading">
                        <span>طلب انضمام جديد</span>
                        <h2>إنشاء حساب منفذ</h2>
                    </div>
                    <a href="/executor-portal/login" class="login-link" aria-label="تسجيل الدخول إلى بوابة المنفذين">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        <span>تسجيل الدخول</span>
                    </a>
                </header>

                <% if (error) { %>
                    <div class="server-alert" role="alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form id="executorRegistrationForm" action="/executor-portal/register" method="POST" novalidate>
                    <section class="form-section" aria-labelledby="organizationSectionTitle">
                        <div class="section-heading">
                            <i class="fa-solid fa-building"></i>
                            <h3 id="organizationSectionTitle">بيانات الجهة</h3>
                        </div>
                        <div class="form-grid">
                            <div class="field" data-field="companyName">
                                <label for="companyName">اسم الشركة أو المنفذ <span class="required-mark">*</span></label>
                                <div class="input-frame">
                                    <i class="fa-solid fa-briefcase"></i>
                                    <input id="companyName" type="text" name="companyName" value="<%= (formData && formData.companyName) || '' %>" placeholder="مثال: شركة النور" autocomplete="organization" minlength="3" maxlength="100" required>
                                </div>
                                <span class="validation-message" data-error-for="companyName" aria-live="polite"></span>
                            </div>

                            <div class="field" data-field="managerName">
                                <label for="managerName">اسم المدير الثلاثي <span class="required-mark">*</span></label>
                                <div class="input-frame">
                                    <i class="fa-solid fa-user-tie"></i>
                                    <input id="managerName" type="text" name="managerName" value="<%= (formData && formData.managerName) || '' %>" placeholder="الاسم بالكامل" autocomplete="name" minlength="3" maxlength="100" required>
                                </div>
                                <span class="validation-message" data-error-for="managerName" aria-live="polite"></span>
                            </div>

                            <div class="field" data-field="phone">
                                <label for="phone">رقم الهاتف <span class="required-mark">*</span></label>
                                <div class="input-frame">
                                    <i class="fa-solid fa-phone"></i>
                                    <input id="phone" class="ltr-input" type="tel" name="phone" value="<%= (formData && formData.phone) || '' %>" placeholder="01xxxxxxxxx" autocomplete="tel" inputmode="tel" maxlength="20" required>
                                </div>
                                <span class="validation-message" data-error-for="phone" aria-live="polite"></span>
                            </div>
                            <div class="field" data-field="executorServiceKey">
                                <label for="executorServiceKey">الخدمة التي ستنفذها <span class="required-mark">*</span></label>
                                <div class="input-frame">
                                    <i class="fa-solid fa-layer-group"></i>
                                    <select id="executorServiceKey" name="executorServiceKey" required>
                                        <% (executorServiceOptions || []).forEach((service) => { %>
                                            <option value="<%= service.key %>" <%= formData && formData.executorServiceKey === service.key ? 'selected' : '' %>><%= service.label %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <span class="field-help">سيظهر لهذا الحساب نوع العمليات المطابق للخدمة فقط.</span>
                                <span class="validation-message" data-error-for="executorServiceKey" aria-live="polite"></span>
                            </div>
                        </div>
                    </section>

                    <section class="form-section" aria-labelledby="accessSectionTitle">
                        <div class="section-heading">
                            <i class="fa-solid fa-key"></i>
                            <h3 id="accessSectionTitle">بيانات الدخول</h3>
                        </div>
                        <div class="form-grid">
                            <div class="field field-full" data-field="webUsername">
                                <label for="webUsername">اسم المستخدم <span class="required-mark">*</span></label>
                                <div class="input-frame username-frame">
                                    <i class="fa-solid fa-at"></i>
                                    <input id="webUsername" class="ltr-input" type="text" name="webUsername" value="<%= (formData && formData.webUsername) || '' %>" placeholder="username" autocomplete="username" minlength="3" maxlength="40" pattern="[A-Za-z0-9_]+" required>
                                    <span class="username-domain">@ahram.com</span>
                                </div>
                                <span class="field-help">حروف إنجليزية وأرقام والشرطة السفلية فقط.</span>
                                <span class="validation-message" data-error-for="webUsername" aria-live="polite"></span>
                            </div>

                            <div class="field" data-field="webPassword">
                                <label for="webPassword">كلمة المرور <span class="required-mark">*</span></label>
                                <div class="input-frame password-frame">
                                    <i class="fa-solid fa-lock"></i>
                                    <input id="webPassword" class="ltr-input" type="password" name="webPassword" placeholder="••••••••" autocomplete="new-password" minlength="8" maxlength="128" required>
                                    <button class="visibility-button" type="button" data-password-toggle="webPassword" aria-label="إظهار كلمة المرور" title="إظهار كلمة المرور">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                                <div id="passwordStrength" class="password-strength" data-level="0" aria-live="polite">
                                    <span class="strength-bars" aria-hidden="true"><span></span><span></span><span></span></span>
                                    <span class="strength-label">6 أحرف على الأقل</span>
                                </div>
                                <span class="validation-message" data-error-for="webPassword" aria-live="polite"></span>
                            </div>

                            <div class="field" data-field="confirmPassword">
                                <label for="confirmPassword">تأكيد كلمة المرور <span class="required-mark">*</span></label>
                                <div class="input-frame password-frame">
                                    <i class="fa-solid fa-lock"></i>
                                    <input id="confirmPassword" class="ltr-input" type="password" name="confirmPassword" placeholder="••••••••" autocomplete="new-password" minlength="8" maxlength="128" required>
                                    <button class="visibility-button" type="button" data-password-toggle="confirmPassword" aria-label="إظهار تأكيد كلمة المرور" title="إظهار تأكيد كلمة المرور">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                                <span class="field-help">أعد إدخال كلمة المرور نفسها.</span>
                                <span class="validation-message" data-error-for="confirmPassword" aria-live="polite"></span>
                            </div>
                        </div>
                    </section>

                    <div class="form-actions">
                        <p class="agreement-note">بإرسال الطلب ستتم مراجعته من الإدارة قبل تفعيل الحساب وإتاحة تسجيل الدخول.</p>
                        <button id="submitBtn" class="submit-button" type="submit">
                            <span>إرسال طلب الانضمام</span>
                            <i class="fa-solid fa-arrow-left default-icon"></i>
                            <i class="fa-solid fa-spinner fa-spin loading-icon"></i>
                        </button>
                    </div>
                </form>
            <% } else { %>
                <div class="success-state" role="status">
                    <div class="success-icon"><i class="fa-solid fa-check"></i></div>
                    <h2>تم إرسال طلب الانضمام</h2>
                    <p>استلمت الإدارة طلبك بنجاح. احتفظ بالرقم المرجعي لمتابعة حالة التفعيل.</p>

                    <div class="request-summary">
                        <div class="summary-row">
                            <span>الرقم المرجعي</span>
                            <div class="summary-value">
                                <strong id="registrationRef"><%= success.refCode %></strong>
                                <button class="copy-button" type="button" data-copy-target="registrationRef" aria-label="نسخ الرقم المرجعي" title="نسخ الرقم المرجعي">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                        </div>
                        <div class="summary-row">
                            <span>اسم الدخول بعد التفعيل</span>
                            <div class="summary-value">
                                <strong id="registrationUsername"><%= success.username %></strong>
                                <button class="copy-button" type="button" data-copy-target="registrationUsername" aria-label="نسخ اسم المستخدم" title="نسخ اسم المستخدم">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="copyStatus" class="copy-status" aria-live="polite"></div>
                    <a href="/executor-portal/login" class="success-login-button">
                        <span>الانتقال إلى تسجيل الدخول</span>
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                </div>
            <% } %>
        </section>
    </main>

    <script src="/js/executor/register/form.js"></script>
</body>
</html>
