<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>محادثة شركة التنفيذ | الأهرام</title>
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
        window.executorCsrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260825-balance1">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260825-balance1">
    <link rel="stylesheet" href="/css/executor-os.css?v=20260930-mobile-shell">
    <link rel="stylesheet" href="/css/executor-support-chat.css?v=20261002-chat-only">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/executor-api.js"></script>
</head>
<body class="executor-os executor-portal-v2 executor-page-support">
<%- include('partials/navigation', { emp, activePage: 'support' }) %>
<div class="exo-stage">
    <%- include('partials/command-bar', { emp, companyBalances: typeof companyBalances === 'undefined' ? null : companyBalances }) %>
</div>

<main class="support-container">
    <section class="group-chat" aria-label="محادثة شركة التنفيذ مع الإدارة">
        <header class="group-chat-head">
            <span class="group-chat-icon"><i class="fa-solid fa-comments"></i></span>
            <div class="group-chat-title"><strong>محادثة الشركة والإدارة</strong><small><%= emp.groupId?.name || 'شركة التنفيذ' %> · <span id="groupMemberCount">جاري التحميل</span></small></div>
            <button class="group-refresh" type="button" id="groupRefresh" title="تحديث المحادثة" aria-label="تحديث المحادثة"><i class="fa-solid fa-rotate"></i></button>
        </header>
        <details class="group-participants"><summary><i class="fa-solid fa-user-group"></i> المشاركون</summary><div id="groupMemberList" class="group-member-list"></div></details>
        <div class="group-message-list" id="groupMessageList" aria-live="polite"><div class="group-chat-loading">جاري تحميل المحادثة...</div></div>
        <form class="group-reply-area" id="groupReplyForm">
            <div class="group-attachment-preview" id="groupAttachmentPreview"></div>
            <input class="d-none" id="groupReplyFiles" type="file" accept="image/jpeg,image/png,image/webp" multiple>
            <button class="group-attach" type="button" id="groupAttach" title="إرفاق صور" aria-label="إرفاق صور"><i class="fa-solid fa-paperclip"></i></button>
            <label for="groupReplyText" class="visually-hidden">رسالة إلى الإدارة والفريق</label>
            <textarea id="groupReplyText" rows="1" maxlength="2000" placeholder="رسالة إلى الإدارة والفريق..."></textarea>
            <button class="group-send" type="submit" title="إرسال الرسالة" aria-label="إرسال الرسالة"><i class="fa-solid fa-paper-plane"></i></button>
        </form>
    </section>
</main>

<script src="/js/executor-workspace.js?v=20260819-1"></script>
<script>
(() => {
    const currentEmployeeName = <%- JSON.stringify(emp.name || '') %>;
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char]));
    const formatDate = (value) => value ? new Date(value).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
    const roleLabel = (role) => ({ admin: 'الإدارة', manager: 'المدير', accountant: 'المحاسب', operator: 'موظف تنفيذ', external: 'منفذ خارجي' })[role] || 'الفريق';
    let loading = false;
    let fingerprint = '';
    let images = [];

    const filesToBase64 = async (files) => Promise.all(Array.from(files).slice(0, 3).map((file) => new Promise((resolve, reject) => {
        if (!/^image\/(jpeg|png|webp)$/.test(file.type) || file.size > 2 * 1024 * 1024) return reject(new Error('الصور يجب أن تكون JPG أو PNG أو WEBP وأقل من 2 ميجابايت.'));
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
    })));

    async function loadChat() {
        if (loading) return;
        loading = true;
        try {
            const data = await readExecutorApiResponse(await executorApiFetch('/executor-portal/api/support/group-chat'));
            const members = data.members || [];
            document.getElementById('groupMemberCount').textContent = `${members.length} مشاركين`;
            document.getElementById('groupMemberList').innerHTML = members.map((member) => `<span class="group-member"><b>${escapeHtml(member.name)}</b><small>${escapeHtml(roleLabel(member.role))}</small></span>`).join('');
            const messages = data.ticket?.messages || [];
            const nextFingerprint = messages.map((message) => message.id || `${message.createdAt}:${message.text}`).join('|');
            if (nextFingerprint !== fingerprint) {
                const list = document.getElementById('groupMessageList');
                const nearBottom = list.scrollHeight - list.scrollTop - list.clientHeight < 80;
                list.innerHTML = messages.map((message) => {
                    const own = message.sender === 'user' && message.senderName === currentEmployeeName;
                    const kind = message.sender === 'system' ? 'is-system' : own ? 'is-own' : message.sender === 'admin' ? 'is-admin' : 'is-team';
                    return `<article class="group-message ${kind}"><b>${escapeHtml(message.senderName || (message.sender === 'admin' ? 'الإدارة' : 'موظف التنفيذ'))}</b>${message.imageUrl ? `<img src="${escapeHtml(message.imageUrl)}" alt="مرفق من ${escapeHtml(message.senderName || 'المشارك')}">` : ''}${message.text ? `<p>${escapeHtml(message.text)}</p>` : ''}<time>${formatDate(message.createdAt)}</time></article>`;
                }).join('') || '<div class="group-chat-loading">لا توجد رسائل بعد.</div>';
                fingerprint = nextFingerprint;
                if (nearBottom || messages.length < 2) list.scrollTop = list.scrollHeight;
            }
        } catch (error) {
            if (!fingerprint) document.getElementById('groupMessageList').innerHTML = `<div class="group-chat-loading text-danger">${escapeHtml(error.message || 'تعذر تحميل المحادثة')}</div>`;
        } finally { loading = false; }
    }

    document.getElementById('groupRefresh').addEventListener('click', loadChat);
    document.getElementById('groupAttach').addEventListener('click', () => document.getElementById('groupReplyFiles').click());
    document.getElementById('groupReplyFiles').addEventListener('change', async (event) => {
        try {
            images = await filesToBase64(event.target.files);
            document.getElementById('groupAttachmentPreview').innerHTML = images.map((src) => `<img src="${src}" alt="صورة مرفقة">`).join('');
        } catch (error) {
            images = [];
            event.target.value = '';
            Swal.fire('مرفق غير صالح', error.message, 'error');
        }
    });
    document.getElementById('groupReplyForm').addEventListener('submit', async (event) => {
        event.preventDefault();
        const input = document.getElementById('groupReplyText');
        const message = input.value.trim();
        if (!message && !images.length) return;
        const button = event.currentTarget.querySelector('[type="submit"]');
        button.disabled = true;
        try {
            await readExecutorApiResponse(await executorApiFetch('/executor-portal/api/support/group-chat/replies', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message, imagesBase64: images })
            }));
            input.value = '';
            document.getElementById('groupReplyFiles').value = '';
            document.getElementById('groupAttachmentPreview').innerHTML = '';
            images = [];
            await loadChat();
            document.getElementById('groupMessageList').scrollTop = document.getElementById('groupMessageList').scrollHeight;
        } catch (error) { Swal.fire('تعذر إرسال الرسالة', error.message, 'error'); }
        finally { button.disabled = false; }
    });

    loadChat();
    setInterval(() => { if (!document.hidden) loadChat(); }, 10000);
})();
</script>
</body>
</html>
