<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>تقارير المنفذ | الأهرام</title>

    <script>window.executorCsrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;</script>
    <script src="/js/executor-api.js"></script>

    <script src="/js/executor/reports/receipts.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260921-pool-ui">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260825-balance1">
    <link rel="stylesheet" href="/css/executor-os.css?v=20260930-mobile-shell">
    <link rel="stylesheet" href="/css/executor-report-controls.css?v=20260930-report-layout">

    <link rel="stylesheet" href="/css/executor/pages/reports.css">
</head>
<body class="executor-os executor-portal-v2 executor-page-reports">
<%- include('partials/navigation', { emp, activePage: 'reports' }) %>
    <div class="exo-stage">
        <%- include('partials/command-bar', { emp, companyBalances: typeof companyBalances === 'undefined' ? null : companyBalances }) %>
    </div>
    <nav class="navbar-glass">
        <div class="executor-info">
            <div class="executor-avatar"><i class="fa-solid fa-user-astronaut"></i></div>
            <div>
                <h4 class="executor-name"><%= emp.name %></h4>
                <span class="executor-role"><i class="fa-solid fa-network-wired me-1"></i> غرفة العمليات: <%= emp.groupId ? emp.groupId.name : 'غير محدد' %></span>
            </div>
        </div>
        <div class="nav-actions">
            <% if (!['operator', 'external'].includes(emp.role)) { %>
            <% const reportNavRows = Array.isArray(companyBalances?.byService) ? companyBalances.byService : []; %>
            <% if (companyBalances?.multiService && reportNavRows.length > 1) { %>
                <% reportNavRows.forEach((row) => { %>
                    <span class="nav-btn text-success border border-success border-opacity-25" style="cursor: default; font-weight: 800;" title="<%= row.appliesPoolModel ? row.totalLabel : row.singleLabel %>"><i class="fa-solid fa-wallet me-1"></i> <%= row.shortLabel %> <%= Number(row.appliesPoolModel ? row.totalBalance : row.privateBalance).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
                <% }); %>
            <% } else { %>
            <span class="nav-btn text-success border border-success border-opacity-25" style="cursor: default; font-weight: 800;" title="إجمالي الرصيد"><i class="fa-solid fa-vault me-1"></i> <%= Number(companyBalances?.totalBalance ?? emp.groupId?.balance ?? 0).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
            <span class="nav-btn text-warning border border-warning border-opacity-25" style="cursor: default; font-weight: 800;" title="الرصيد الخاص"><i class="fa-solid fa-wallet me-1"></i> <%= Number(companyBalances?.privateBalance ?? emp.groupId?.balance ?? 0).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
            <% } %>
            <% } %>
            <button class="nav-btn btn-theme shadow-sm" onclick="toggleTheme()" title="المظهر"><i class="fa-solid fa-moon" id="themeIcon"></i></button>
            <a href="/executor-portal/logout" class="nav-btn btn-logout"><i class="fa-solid fa-power-off"></i></a>
        </div>
    </nav>

    <div class="container-fluid px-3 px-md-4 mt-2 mb-5">
        <div class="executor-page-heading">
            <div>
                <span class="executor-kicker"><i class="fa-solid fa-chart-column"></i> مركز التقارير</span>
                <h1><%= ['operator', 'external'].includes(emp.role) ? 'تقاريري الشخصية' : 'تقارير شركة التنفيذ' %></h1>
                <p><%= ['operator', 'external'].includes(emp.role) ? 'يعرض هذا القسم عمليات حسابك فقط.' : 'مراجعة العمليات والأرصدة وأداء فريق التنفيذ حسب الفترة.' %></p>
            </div>
        </div>

        <div class="executor-report-search-block mb-3">
            <label for="reportSearch" class="form-label text-muted fw-bold mb-1 executor-report-search-label">بحث سريع في العمليات</label>
            <div class="input-group executor-report-search" role="search">
                <span class="input-group-text bg-transparent border-secondary"><i class="fa-solid fa-search text-muted" aria-hidden="true"></i></span>
                <input type="search" id="reportSearch" class="form-control" dir="auto" maxlength="64" placeholder="رقم العملية أو الهاتف أو المبلغ" autocomplete="off" oninput="scheduleExecutorOperationSearch()" onkeydown="if (event.key === 'Enter') { event.preventDefault(); searchExecutorOperations(); }">
            </div>
            <small id="reportSearchHint" class="text-muted d-block mt-1 report-search-hint" aria-live="polite">تظهر النتائج المشابهة أثناء الكتابة.</small>
        </div>

        <!-- Filters -->
        <div class="card-glass mb-3 executor-report-filters">
            <div class="row g-2 align-items-end">
                <% if (['manager', 'accountant'].includes(emp.role)) { %>
                <div class="col-12 col-md-3 executor-report-employee">
                    <label for="employeeFilter" class="form-label text-muted fw-bold">نطاق التقرير</label>
                    <select id="employeeFilter" class="form-select"><option value="">كل شركة التنفيذ</option></select>
                </div>
                <% } %>
                <div class="col-12 col-md-2 executor-report-period">
                    <label class="form-label text-muted fw-bold">الفترة الزمنية</label>
                    <select id="dateType" class="form-select" onchange="toggleDateInput()">
                        <option value="all">كل العمليات</option>
                        <option value="day">يوم محدد</option>
                        <option value="month">شهر محدد</option>
                        <option value="range">فترة من / إلى</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 executor-report-date">
                    <label class="form-label text-muted fw-bold">التاريخ</label>
                    <input type="date" id="dateValueDay" class="form-control">
                    <input type="month" id="dateValueMonth" class="form-control" style="display:none;">
                    <div id="dateRangeInputs" class="d-none gap-2" style="grid-template-columns:1fr 1fr">
                        <div><label for="dateFrom" class="form-label text-muted">من</label><input type="date" id="dateFrom" class="form-control"></div>
                        <div><label for="dateTo" class="form-label text-muted">إلى</label><input type="date" id="dateTo" class="form-control"></div>
                    </div>
                </div>
                <div class="col-12 col-md-2 text-end executor-report-load">
                    <button id="btnLoadReport" class="btn btn-warning w-100 fw-bold py-2" onclick="fetchReport()">
                        <i class="fa-solid fa-chart-column"></i> عرض التقرير
                    </button>
                </div>
                <div id="reportDownloadContainer" class="col-12 col-md-2 text-end executor-report-download d-none">
                    <button id="btnDownloadPdf" class="btn btn-danger w-100 fw-bold py-2" onclick="downloadReportPdf()">
                        <i class="fa-solid fa-file-pdf"></i> تحميل PDF
                    </button>
                </div>
            </div>
            <div class="row g-2 mt-1 align-items-center executor-report-shortcuts">
                <div class="col-12">
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-bold" onclick="setQuickPeriod('today')">اليوم</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-bold" onclick="setQuickPeriod('yesterday')">الأمس</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-bold" onclick="setQuickPeriod('last7')">آخر 7 أيام</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-bold" onclick="setQuickPeriod('thisMonth')">الشهر الحالي</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div id="statsSection" class="d-none">
            <div id="statsGrid" class="x-stat-grid"></div>
        </div>

        <!-- Operations Table -->
        <div class="card-glass d-none" id="tableSection">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-list text-muted me-1"></i> تفاصيل العمليات</h5>
            <div class="table-responsive d-none d-md-block">
                <table class="x-report-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>رقم العملية</th>
                            <th>النوع</th>
                            <th>المبلغ</th>
                            <th>رقم العميل</th>
                            <th>وقت الوصول</th>
                            <th>وقت الإكمال</th>
                            <th>المدة</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <% if (!['operator', 'external'].includes(emp.role)) { %><th id="executorColumnHeader">المنفذ</th><% } %>
                        </tr>
                    </thead>
                    <tbody id="reportTableBody"></tbody>
                </table>
            </div>
            <div class="d-md-none d-flex flex-column gap-3" id="mobileReportList"></div>

            <!-- Chart -->
            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                <h6 class="fw-bold mb-3" style="color: var(--x-muted, #94a3b8);"><i class="fa-solid fa-chart-column me-1"></i> توزيع العمليات حسب اليوم</h6>
                <div style="height: 220px;"><canvas id="reportChart"></canvas></div>
            </div>
        </div>

        <!-- Cancelled Section -->
        <div class="card-glass d-none mt-3" id="cancelledSection">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold m-0 text-danger"><i class="fa-solid fa-ban me-1"></i> العمليات الملغاة</h5>
                <small class="text-muted">لا تُحسب في الإجمالي</small>
            </div>
            <div class="table-responsive d-none d-md-block">
                <table class="x-report-table">
                    <thead><tr><th>#</th><th>رقم العملية</th><th>المبلغ</th><th>التاريخ</th><th>الحالة</th></tr></thead>
                    <tbody id="cancelledReportTableBody"></tbody>
                </table>
            </div>
            <div class="d-md-none d-flex flex-column gap-3" id="mobileCancelledList"></div>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade x-detail-modal" id="operationDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered px-2">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="detailModalTitle">تفاصيل العملية</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(0.5);"></button>
                </div>
                <div class="modal-body p-4" id="detailModalBody"></div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                    <button type="button" class="btn btn-primary" id="detailDownloadBtn"><i class="fa-solid fa-download me-1"></i> تحميل الإيصال</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="/js/executor-workspace.js?v=20260819-1"></script>
    <script>window.executorPersonalReport = <%= ['operator', 'external'].includes(emp.role) ? 'true' : 'false' %>;</script>
<script src="/js/executor/reports/workspace.js"></script>
<script src="/js/executor/reports/rendering.js"></script>
<script src="/js/executor/reports/operation-detail.js"></script>
<script src="/js/executor/reports/attachments.js"></script>
<script src="/js/executor/reports/filters.js"></script>
</body>
</html>
