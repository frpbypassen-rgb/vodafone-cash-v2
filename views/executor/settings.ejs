<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إعدادات التنفيذ | الأهرام</title>
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260825-settings1">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260825-settings1">
    <link rel="stylesheet" href="/css/executor-os.css?v=20260825-settings1">
    <link rel="stylesheet" href="/css/executor-settings.css?v=20260825-settings1">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>window.executorCsrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;</script>
    <script src="/js/executor-api.js"></script>
    <style>body { font-family: 'Tajawal', sans-serif; }</style>
</head>
<body class="executor-os executor-portal-v2 executor-page-settings">
<%- include('partials/navigation', { emp, activePage: 'settings' }) %>
<div class="exo-stage">
    <%- include('partials/command-bar', { emp }) %>
</div>

<header class="settings-topbar">
    <div class="settings-brand">
        <img src="/images/logo.jpg" alt="شعار الأهرام">
        <div>
            <strong><%= emp.groupId?.name || 'شركة التنفيذ' %></strong>
            <small><%= emp.name %></small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="icon-command" type="button" data-executor-theme-toggle title="تبديل الوضع"><i class="fa-solid fa-moon" data-executor-theme-icon></i></button>
        <a class="icon-command text-danger" href="/executor-portal/logout" title="تسجيل الخروج"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
    </div>
</header>

<main class="settings-container">
    <div class="executor-page-heading">
        <div>
            <span class="executor-kicker"><i class="fa-solid fa-sliders"></i> مركز التحكم</span>
            <h1>إعدادات حساب التنفيذ</h1>
            <p>بيانات الحساب، الإشعارات، والأمان في مكان واحد.</p>
        </div>
        <button class="icon-command" type="button" id="refreshOverview" title="تحديث البيانات"><i class="fa-solid fa-rotate"></i></button>
    </div>

    <% const roleLabel = { manager: 'مدير تنفيذي', accountant: 'محاسب', external: 'موظف خارجي', operator: 'موظف تنفيذ' }[emp.role] || 'موظف تنفيذ'; %>

    <article class="settings-identity">
        <div class="settings-identity-avatar"><i class="fa-solid fa-user-shield"></i></div>
        <div class="settings-identity-body">
            <h2><%= overview.executor?.name || emp.name %></h2>
            <div class="settings-identity-meta">
                <span class="executor-role-pill"><%= roleLabel %></span>
                <span><i class="fa-solid fa-building"></i><%= overview.company?.name || emp.groupId?.name || '---' %></span>
                <span dir="ltr"><i class="fa-solid fa-phone"></i><%= overview.executor?.phone || emp.phone || '---' %></span>
            </div>
        </div>
        <span class="executor-status-pill" style="--pill-color: var(--executor-green)"><i class="fa-solid fa-circle-check"></i> نشط</span>
    </article>

    <% const isManager = emp.role === 'manager'; const isOperator = emp.role === 'operator'; const isAccountant = emp.role === 'accountant'; const isExternal = emp.role === 'external'; %>
    <section class="executor-summary-grid settings-summary-grid <%= isAccountant || isExternal ? 'cols-1' : (isOperator ? 'cols-3' : '') %> mb-3">
        <% if (overview.permissions?.canViewCompanyBalance) { %>
            <article class="executor-summary-card" style="--summary-color: var(--executor-green)">
                <span class="summary-icon"><i class="fa-solid fa-wallet"></i></span>
                <small>رصيد شركة التنفيذ</small>
                <strong dir="ltr"><%= Number(overview.company?.balance || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> ج.م</strong>
            </article>
        <% } %>
        <% if (isExternal && typeof emp.balance !== 'undefined' && emp.balance !== null) { %>
            <article class="executor-summary-card" style="--summary-color: var(--executor-green)">
                <span class="summary-icon"><i class="fa-solid fa-wallet"></i></span>
                <small>رصيدك الشخصي</small>
                <strong dir="ltr"><%= Number(emp.balance || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> ج.م</strong>
            </article>
        <% } %>
        <% if (!isAccountant) { %>
            <% if (isManager) { %>
                <article class="executor-summary-card" style="--summary-color: var(--executor-blue)">
                    <span class="summary-icon"><i class="fa-solid fa-check-double"></i></span>
                    <small>عمليات اليوم</small>
                    <strong><%= Number(overview.metrics?.todayOperations || 0) %></strong>
                </article>
                <article class="executor-summary-card" style="--summary-color: var(--executor-gold)">
                    <span class="summary-icon"><i class="fa-solid fa-calendar-days"></i></span>
                    <small>عمليات الشهر</small>
                    <strong><%= Number(overview.metrics?.monthOperations || 0) %></strong>
                </article>
                <article class="executor-summary-card" style="--summary-color: var(--executor-navy)">
                    <span class="summary-icon"><i class="fa-solid fa-bolt"></i></span>
                    <small>قيمة تنفيذاتك اليوم</small>
                    <strong dir="ltr"><%= Number(overview.myPerformance?.totalEGP || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> ج.م</strong>
                </article>
            <% } else if (isOperator || isExternal) { %>
                <article class="executor-summary-card" style="--summary-color: var(--executor-blue)">
                    <span class="summary-icon"><i class="fa-solid fa-check-double"></i></span>
                    <small>عملياتك اليوم</small>
                    <strong><%= Number(overview.myPerformance?.completedCount || 0) %></strong>
                </article>
                <article class="executor-summary-card" style="--summary-color: var(--executor-navy)">
                    <span class="summary-icon"><i class="fa-solid fa-bolt"></i></span>
                    <small>قيمة تنفيذاتك اليوم</small>
                    <strong dir="ltr"><%= Number(overview.myPerformance?.totalEGP || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> ج.م</strong>
                </article>
                <% if (isOperator) { %>
                    <article class="executor-summary-card" style="--summary-color: var(--executor-blue)" id="pushSummaryCard">
                        <span class="summary-icon"><i class="fa-solid fa-bell"></i></span>
                        <small>إشعارات المتصفح</small>
                        <strong><span class="executor-status-pill" id="pushSummaryPill" style="--pill-color: var(--executor-muted)">فحص</span></strong>
                    </article>
                <% } %>
            <% } %>
        <% } %>
    </section>

    <div class="settings-shell">
        <nav class="settings-nav" aria-label="أقسام الإعدادات">
            <button class="settings-nav-item" type="button" data-settings-tab="account"><i class="fa-solid fa-user"></i> حسابي</button>
            <button class="settings-nav-item active" type="button" data-settings-tab="notifications"><i class="fa-solid fa-bell"></i> الإشعارات</button>
            <button class="settings-nav-item" type="button" data-settings-tab="security"><i class="fa-solid fa-shield-halved"></i> الأمان</button>
            <% if (isManager) { %>
                <button class="settings-nav-item" type="button" data-settings-tab="team"><i class="fa-solid fa-users-gear"></i> إدارة الفريق</button>
            <% } %>
        </nav>

        <div class="settings-mobile-tabs" aria-label="أقسام الإعدادات">
            <button class="settings-nav-item" type="button" data-settings-tab="account"><i class="fa-solid fa-user"></i> حسابي</button>
            <button class="settings-nav-item active" type="button" data-settings-tab="notifications"><i class="fa-solid fa-bell"></i> الإشعارات</button>
            <button class="settings-nav-item" type="button" data-settings-tab="security"><i class="fa-solid fa-shield-halved"></i> الأمان</button>
            <% if (isManager) { %>
                <button class="settings-nav-item" type="button" data-settings-tab="team"><i class="fa-solid fa-users-gear"></i> الفريق</button>
            <% } %>
        </div>

        <div class="settings-panels">
            <!-- حسابي -->
            <section class="settings-panel workspace-panel" id="panel-account" data-settings-panel="account">
                <h2 class="panel-title"><i class="fa-solid fa-id-card"></i> حسابي</h2>
                <p class="panel-lead">بيانات التشغيل الأساسية المرتبطة بحسابك في منصة التنفيذ.</p>
                <div class="settings-two-col">
                    <div>
                        <div class="executor-detail-row"><span>شركة التنفيذ</span><strong><%= overview.company?.name || emp.groupId?.name || '---' %></strong></div>
                        <div class="executor-detail-row"><span>اسم المنفذ</span><strong><%= overview.executor?.name || emp.name %></strong></div>
                        <div class="executor-detail-row"><span>رقم الهاتف</span><strong dir="ltr"><%= overview.executor?.phone || emp.phone || '---' %></strong></div>
                    </div>
                    <div>
                        <div class="executor-detail-row"><span>نوع الحساب</span><strong><span class="executor-role-pill"><%= roleLabel %></span></strong></div>
                        <div class="executor-detail-row"><span>الخدمة</span><strong><span class="executor-role-pill service-chip"><%= overview.company?.serviceKey || emp.groupId?.serviceKey || 'غير محددة' %></span></strong></div>
                        <div class="executor-detail-row"><span>حالة الحساب</span><strong><span class="executor-status-pill" style="--pill-color: var(--executor-green)"><i class="fa-solid fa-circle-check"></i> نشط</span></strong></div>
                    </div>
                </div>
            </section>

            <!-- الإشعارات -->
            <section class="settings-panel workspace-panel active" id="panel-notifications" data-settings-panel="notifications">
                <h2 class="panel-title"><i class="fa-solid fa-bell"></i> إشعارات المهام</h2>
                <p class="panel-lead">تصل التنبيهات حتى عند إغلاق صفحة البوابة بعد منح الإذن.</p>

                <div class="push-hero">
                    <div class="push-hero-main">
                        <div class="push-hero-icon"><i class="fa-solid fa-bell"></i></div>
                        <div>
                            <strong id="pushStatusTitle">جاري فحص الإعداد...</strong>
                            <small id="pushStatusHint">فعّل الإشعارات لتصلك المهام الجديدة فورًا.</small>
                        </div>
                    </div>
                    <div class="push-hero-aside">
                        <span class="executor-status-pill" id="pushStatusPill">فحص</span>
                        <small>آخر إرسال: <span id="lastPushAt">لا يوجد</span></small>
                    </div>
                </div>

                <div class="push-steps">
                    <div class="push-step" id="pushStep1">
                        <span class="push-step-num">1</span>
                        <span class="push-step-label">إذن المتصفح</span>
                        <span class="push-step-value" id="browserPermission">جاري الفحص</span>
                    </div>
                    <div class="push-step" id="pushStep2">
                        <span class="push-step-num">2</span>
                        <span class="push-step-label">اتصال الخادم</span>
                        <span class="push-step-value" id="serverPushStatus">جاري الفحص</span>
                    </div>
                    <div class="push-step" id="pushStep3">
                        <span class="push-step-num">3</span>
                        <span class="push-step-label">جاهز للاستقبال</span>
                        <span class="push-step-value" id="pushReadyStatus">جاري الفحص</span>
                    </div>
                </div>

                <div class="push-actions">
                    <button class="settings-btn-primary" type="button" id="enablePush"><i class="fa-solid fa-bell"></i> تفعيل الإشعارات</button>
                    <button class="settings-btn-primary danger" type="button" id="disablePush" hidden><i class="fa-solid fa-bell-slash"></i> إيقاف الإشعارات</button>
                    <div class="push-secondary-links">
                        <button class="push-link-btn" type="button" id="testPush"><i class="fa-solid fa-paper-plane"></i> اختبار من الخادم</button>
                        <button class="push-link-btn" type="button" id="previewPush"><i class="fa-solid fa-volume-high"></i> معاينة</button>
                    </div>
                </div>

                <div class="push-learn-more">
                    <button class="push-learn-toggle" type="button" id="pushLearnToggle" aria-expanded="false">
                        <span><i class="fa-solid fa-circle-info"></i> اعرف المزيد — قواعد الإشعارات</span>
                        <i class="fa-solid fa-chevron-down chevron"></i>
                    </button>
                    <div class="push-learn-body" id="pushLearnBody">
                        <div class="executor-detail-row"><span>عملية جديدة</span><strong>تنبيه فوري</strong></div>
                        <div class="executor-detail-row"><span>عملية موجهة</span><strong>للمنفذ المحدد فقط</strong></div>
                        <div class="executor-detail-row"><span>إنذار الإدارة</span><strong>أولوية مرتفعة</strong></div>
                        <div class="executor-detail-row"><span>خصوصية الرقم</span><strong>أول 3 أرقام قبل القبول</strong></div>
                    </div>
                </div>
            </section>

            <!-- الأمان -->
            <section class="settings-panel workspace-panel" id="panel-security" data-settings-panel="security">
                <%- include('../partials/mfa_security_panel') %>
            </section>

            <!-- إدارة الفريق (manager only) -->
            <% if (isManager) { %>
            <section class="settings-panel workspace-panel" id="panel-team" data-settings-panel="team">
                <div class="routing-control">
                    <div>
                        <h2 class="panel-title mb-0"><i class="fa-solid fa-route"></i> التوجيه اليدوي للمهام</h2>
                        <p id="routingDescription"><%= emp.groupId?.manualTaskRoutingEnabled ? 'لا تظهر العملية للموظف إلا بعد أن يوجهها المدير إليه بالاسم.' : 'تظهر العمليات المتاحة للمدير والموظفين ويمكن لأول منفذ متاح قبولها.' %></p>
                    </div>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="manualRoutingSwitch" <%= emp.groupId?.manualTaskRoutingEnabled ? 'checked' : '' %>>
                    </div>
                </div>
            </section>
            <% } %>
        </div>
    </div>
</main>

<script src="/js/executor-workspace.js?v=20260819-1"></script>
<script>
    const formatDate = (value) => value
        ? new Date(value).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli', dateStyle: 'medium', timeStyle: 'short' })
        : 'لا يوجد';

    const permissionLabels = { granted: 'مسموح', denied: 'مرفوض', default: 'لم يطلب بعد' };

    const setPushBusy = (busy) => {
        ['enablePush', 'testPush', 'previewPush', 'disablePush'].forEach((id) => {
            const button = document.getElementById(id);
            if (button) button.disabled = busy;
        });
    };

    const setStepState = (stepEl, state) => {
        if (!stepEl) return;
        stepEl.classList.remove('done', 'fail');
        if (state === 'done') stepEl.classList.add('done');
        if (state === 'fail') stepEl.classList.add('fail');
    };

    async function refreshPushStatus() {
        try {
            const status = await window.executorBrowserPush.status();
            const permLabel = permissionLabels[status.permission] || status.permission;
            const serverLabel = status.configured ? 'جاهز' : 'إعداد الخادم غير مكتمل';
            const ready = status.supported && status.configured && status.subscribed && status.permission === 'granted';

            document.getElementById('browserPermission').textContent = permLabel;
            document.getElementById('serverPushStatus').textContent = serverLabel;
            document.getElementById('pushReadyStatus').textContent = ready ? 'جاهز' : (status.supported ? 'بانتظار التفعيل' : 'غير مدعوم');
            document.getElementById('lastPushAt').textContent = formatDate(status.lastSuccessAt);

            setStepState(document.getElementById('pushStep1'), status.permission === 'granted' ? 'done' : (status.permission === 'denied' ? 'fail' : null));
            setStepState(document.getElementById('pushStep2'), status.configured ? 'done' : 'fail');
            setStepState(document.getElementById('pushStep3'), ready ? 'done' : null);

            document.getElementById('pushStatusTitle').textContent = ready ? 'الإشعارات تعمل على هذا المتصفح' : 'الإشعارات تحتاج إلى تفعيل';
            document.getElementById('pushStatusHint').textContent = ready
                ? 'ستصلك تنبيهات المهام حتى عند إغلاق هذه الصفحة.'
                : 'فعّل الإشعارات لتصلك المهام الجديدة فورًا.';
            document.getElementById('pushStatusPill').textContent = ready ? 'تعمل' : 'تحتاج إعدادًا';
            document.getElementById('pushStatusPill').style.setProperty('--pill-color', ready ? 'var(--executor-green)' : 'var(--executor-red)');

            document.getElementById('enablePush').hidden = ready;
            document.getElementById('disablePush').hidden = !ready;

            const summaryPill = document.getElementById('pushSummaryPill');
            if (summaryPill) {
                summaryPill.textContent = ready ? 'تعمل' : 'غير مفعّلة';
                summaryPill.style.setProperty('--pill-color', ready ? 'var(--executor-green)' : 'var(--executor-red)');
            }
        } catch (_) {
            document.getElementById('pushStatusTitle').textContent = 'تعذر فحص الإشعارات';
            document.getElementById('pushStatusPill').textContent = 'غير متصل';
            document.getElementById('pushStatusPill').style.setProperty('--pill-color', 'var(--executor-red)');
        }
    }

    const pushAction = async (action, successText) => {
        setPushBusy(true);
        try {
            await action();
            await refreshPushStatus();
            await Swal.fire({ icon: 'success', title: successText, timer: 1700, showConfirmButton: false });
        } catch (error) {
            await Swal.fire({ icon: 'error', title: 'تعذر إكمال الطلب', text: error.message || 'حدث خطأ غير متوقع.' });
        } finally { setPushBusy(false); }
    };

    document.getElementById('enablePush').addEventListener('click', () => pushAction(() => window.executorBrowserPush.enable(), 'تم تفعيل إشعارات المتصفح'));
    document.getElementById('testPush').addEventListener('click', () => pushAction(() => window.executorBrowserPush.test(), 'تم إرسال إشعار الاختبار'));
    document.getElementById('previewPush').addEventListener('click', () => pushAction(() => window.executorBrowserPush.preview(), 'تم تشغيل المعاينة'));
    document.getElementById('disablePush').addEventListener('click', () => pushAction(() => window.executorBrowserPush.disable(), 'تم إيقاف إشعارات هذا المتصفح'));
    document.getElementById('refreshOverview').addEventListener('click', () => window.location.reload());

    document.getElementById('manualRoutingSwitch')?.addEventListener('change', async (event) => {
        const input = event.currentTarget;
        input.disabled = true;
        try {
            const response = await executorApiFetch('/executor-portal/api/task-routing-mode', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ enabled: input.checked })
            });
            const data = await readExecutorApiResponse(response);
            input.checked = data.manualTaskRoutingEnabled === true;
            document.getElementById('routingDescription').textContent = input.checked
                ? 'لا تظهر العملية للموظف إلا بعد أن يوجهها المدير إليه بالاسم.'
                : 'تظهر العمليات المتاحة للمدير والموظفين ويمكن لأول منفذ متاح قبولها.';
            Swal.fire({ icon: 'success', title: 'تم تحديث وضع التوجيه', timer: 1400, showConfirmButton: false });
        } catch (error) {
            input.checked = !input.checked;
            Swal.fire({ icon: 'error', title: 'تعذر تحديث التوجيه', text: error.message });
        } finally { input.disabled = false; }
    });

    document.getElementById('pushLearnToggle')?.addEventListener('click', (event) => {
        const button = event.currentTarget;
        const body = document.getElementById('pushLearnBody');
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        body.classList.toggle('open', !expanded);
    });

    const activateSettingsTab = (tabId) => {
        document.querySelectorAll('[data-settings-tab]').forEach((btn) => {
            btn.classList.toggle('active', btn.dataset.settingsTab === tabId);
        });
        document.querySelectorAll('[data-settings-panel]').forEach((panel) => {
            panel.classList.toggle('active', panel.dataset.settingsPanel === tabId);
        });
    };

    document.querySelectorAll('[data-settings-tab]').forEach((button) => {
        button.addEventListener('click', () => activateSettingsTab(button.dataset.settingsTab));
    });

    refreshPushStatus();
</script>
</body>
</html>
