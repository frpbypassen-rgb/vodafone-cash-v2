<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إعدادات التنفيذ | الأهرام</title>
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260921-quick-exec">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260825-settings1">
    <link rel="stylesheet" href="/css/executor-os.css?v=20260930-mobile-shell">
    <link rel="stylesheet" href="/css/executor-settings.css?v=20261002-settings-mobile">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer></script>
    <script>window.executorCsrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;</script>
    <script src="/js/executor-api.js"></script>
    <link rel="stylesheet" href="/css/executor/pages/settings.css?v=20261025-review">
</head>
<body class="executor-os executor-portal-v2 executor-page-settings">
<%- include('partials/navigation', { emp, activePage: 'settings' }) %>
<div class="exo-stage">
    <%- include('partials/command-bar', { emp, companyBalances: typeof companyBalances === 'undefined' ? null : companyBalances }) %>
</div>

<header class="settings-topbar">
    <div class="settings-brand">
        <img src="/images/logo.jpg" alt="شعار الأهرام">
        <div>
            <strong><%= emp.groupId?.name || 'شركة التنفيذ' %></strong>
            <small><%= emp.name %></small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="icon-command" type="button" data-executor-theme-toggle title="تبديل الوضع"><i class="fa-solid fa-moon" data-executor-theme-icon></i></button>
        <a class="icon-command text-danger" href="/executor-portal/logout" title="تسجيل الخروج"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
    </div>
</header>

<main class="settings-container">
    <% const isManager = emp.role === 'manager'; const isOperator = emp.role === 'operator'; const isAccountant = emp.role === 'accountant'; const isExternal = emp.role === 'external'; %>
    <nav class="settings-mobile-tabs" aria-label="أقسام الإعدادات">
        <button class="settings-nav-item active" type="button" data-settings-tab="account"><i class="fa-solid fa-user"></i> حسابي</button>
        <% if (isManager) { %><button class="settings-nav-item" type="button" data-settings-tab="team"><i class="fa-solid fa-users-gear"></i> الفريق</button><% } %>
        <button class="settings-nav-item" type="button" data-settings-tab="notifications"><i class="fa-solid fa-bell"></i> الإشعارات</button>
        <button class="settings-nav-item" type="button" data-settings-tab="security"><i class="fa-solid fa-shield-halved"></i> الأمان</button>
    </nav>
    <div class="executor-page-heading">
        <div>
            <span class="executor-kicker"><i class="fa-solid fa-sliders"></i> مركز التحكم</span>
            <h1>إعدادات حساب التنفيذ</h1>
            <p>بيانات الحساب، الإشعارات، والأمان في مكان واحد.</p>
        </div>
        <button class="icon-command" type="button" id="refreshOverview" title="تحديث البيانات"><i class="fa-solid fa-rotate"></i></button>
    </div>

    <% const roleLabel = { manager: 'مدير تنفيذي', accountant: 'محاسب', external: 'منفّذ خارجي', operator: 'موظف تنفيذ' }[emp.role] || 'موظف تنفيذ'; %>

    <div id="settingsAccountOverview">
    <article class="settings-identity">
        <div class="settings-identity-avatar"><i class="fa-solid fa-user-shield"></i></div>
        <div class="settings-identity-body">
            <h2><%= overview.executor?.name || emp.name %></h2>
            <div class="settings-identity-meta">
                <span class="executor-role-pill"><%= roleLabel %></span>
                <span><i class="fa-solid fa-building"></i><%= overview.company?.name || emp.groupId?.name || '---' %></span>
                <span dir="ltr"><i class="fa-solid fa-phone"></i><%= overview.executor?.phone || emp.phone || '---' %></span>
            </div>
        </div>
        <span class="executor-status-pill" style="--pill-color: var(--executor-green)"><i class="fa-solid fa-circle-check"></i> نشط</span>
    </article>

    <section class="executor-summary-grid settings-summary-grid <%= isAccountant || isExternal ? 'cols-2' : (isOperator ? 'cols-3' : '') %> mb-3">
        <% if (overview.permissions?.canViewCompanyBalance) { %>
            <%- include('partials/service-balance-cards', { companyBalances }) %>
        <% } %>
        <% if (isExternal) { %>
            <article class="executor-summary-card" style="--summary-color: var(--executor-green)">
                <span class="summary-icon"><i class="fa-solid fa-wallet"></i></span>
                <small><%= overview.executor?.balancePool ? `رصيد مجموعة «${overview.executor.balancePool.name}»` : 'رصيدك المنفرد' %></small>
                <strong dir="ltr"><%= Number(overview.executor?.workingBalance ?? emp.balance ?? 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> ج.م</strong>
            </article>
        <% } %>
        <% if (!isAccountant) { %>
            <% if (isManager) { %>
                <article class="executor-summary-card" style="--summary-color: var(--executor-blue)">
                    <span class="summary-icon"><i class="fa-solid fa-check-double"></i></span>
                    <small>عمليات اليوم</small>
                    <strong><%= Number(overview.metrics?.todayOperations || 0) %></strong>
                </article>
                <article class="executor-summary-card" style="--summary-color: var(--executor-gold)">
                    <span class="summary-icon"><i class="fa-solid fa-calendar-days"></i></span>
                    <small>عمليات الشهر</small>
                    <strong><%= Number(overview.metrics?.monthOperations || 0) %></strong>
                </article>
                <article class="executor-summary-card" style="--summary-color: var(--executor-navy)">
                    <span class="summary-icon"><i class="fa-solid fa-bolt"></i></span>
                    <small>قيمة تنفيذاتك اليوم</small>
                    <strong dir="ltr"><%= Number(overview.myPerformance?.totalEGP || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> ج.م</strong>
                </article>
            <% } else if (isOperator || isExternal) { %>
                <article class="executor-summary-card" style="--summary-color: var(--executor-blue)">
                    <span class="summary-icon"><i class="fa-solid fa-check-double"></i></span>
                    <small>عملياتك اليوم</small>
                    <strong><%= Number(overview.myPerformance?.completedCount || 0) %></strong>
                </article>
                <article class="executor-summary-card" style="--summary-color: var(--executor-navy)">
                    <span class="summary-icon"><i class="fa-solid fa-bolt"></i></span>
                    <small>قيمة تنفيذاتك اليوم</small>
                    <strong dir="ltr"><%= Number(overview.myPerformance?.totalEGP || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> ج.م</strong>
                </article>
                <% if (isOperator) { %>
                    <article class="executor-summary-card" style="--summary-color: var(--executor-blue)" id="pushSummaryCard">
                        <span class="summary-icon"><i class="fa-solid fa-bell"></i></span>
                        <small>إشعارات المتصفح</small>
                        <strong><span class="executor-status-pill" id="pushSummaryPill" style="--pill-color: var(--executor-muted)">فحص</span></strong>
                    </article>
                <% } %>
            <% } %>
        <% } %>
    </section>
    </div>

    <div class="settings-shell">
        <nav class="settings-nav" aria-label="أقسام الإعدادات">
            <button class="settings-nav-item active" type="button" data-settings-tab="account"><i class="fa-solid fa-user"></i> حسابي</button>
            <% if (isManager) { %>
                <button class="settings-nav-item" type="button" data-settings-tab="team"><i class="fa-solid fa-users-gear"></i> إدارة الفريق</button>
            <% } %>
            <button class="settings-nav-item" type="button" data-settings-tab="notifications"><i class="fa-solid fa-bell"></i> الإشعارات</button>
            <button class="settings-nav-item" type="button" data-settings-tab="security"><i class="fa-solid fa-shield-halved"></i> الأمان</button>
        </nav>

        <div class="settings-panels">
            <!-- حسابي -->
            <section class="settings-panel workspace-panel active" id="panel-account" data-settings-panel="account">
                <h2 class="panel-title"><i class="fa-solid fa-id-card"></i> حسابي</h2>
                <div class="settings-two-col">
                    <div>
                        <div class="executor-detail-row"><span>شركة التنفيذ</span><strong><%= overview.company?.name || emp.groupId?.name || '---' %></strong></div>
                        <div class="executor-detail-row"><span>اسم المنفذ</span><strong><%= overview.executor?.name || emp.name %></strong></div>
                        <div class="executor-detail-row"><span>رقم الهاتف</span><strong dir="ltr"><%= overview.executor?.phone || emp.phone || '---' %></strong></div>
                    </div>
                    <div>
                        <div class="executor-detail-row"><span>نوع الحساب</span><strong><span class="executor-role-pill"><%= roleLabel %></span></strong></div>
                        <div class="executor-detail-row"><span>الخدمة</span><strong><span class="executor-role-pill service-chip"><%= typeof serviceLabel !== 'undefined' && serviceLabel ? serviceLabel : 'غير محددة' %></span></strong></div>
                        <div class="executor-detail-row"><span>حالة الحساب</span><strong><span class="executor-status-pill" style="--pill-color: var(--executor-green)"><i class="fa-solid fa-circle-check"></i> نشط</span></strong></div>
                    </div>
                </div>
                <form id="settingsProfileForm" class="settings-form-grid">
                    <label>الاسم<input class="form-control" name="name" autocomplete="name" required minlength="3" maxlength="100" value="<%= overview.executor?.name || emp.name %>"></label>
                    <label>رقم الهاتف<input class="form-control" name="phone" inputmode="tel" autocomplete="tel" required value="<%= overview.executor?.phone || emp.phone || '' %>"></label>
                    <button class="settings-btn-primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> حفظ البيانات</button>
                </form>
                <% if (!isAccountant) { %>
                <% const quickExecute = overview.quickExecute || {}; %>
                <div class="quick-execute-settings mt-4 pt-3 border-top">
                    <h3 class="panel-title mb-1"><i class="fa-solid fa-phone-flip"></i> تنفيذ سريع</h3>
                    <p class="panel-lead mb-3">اختر شبكة محفظتك. لشبكات اتصالات وأورنج ووي يُحفظ رقم السر مشفراً ويظهر في شاشة الاتصال فقط.</p>
                    <form id="quickExecuteForm" class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">الشبكة</label>
                            <div class="d-flex flex-wrap gap-3" id="quickExecuteNetworks">
                                <label class="form-check"><input class="form-check-input" type="radio" name="ussdNetwork" value="vodafone" <%= (quickExecute.network || 'vodafone') === 'vodafone' ? 'checked' : '' %>> فودافون</label>
                                <label class="form-check"><input class="form-check-input" type="radio" name="ussdNetwork" value="etisalat" <%= quickExecute.network === 'etisalat' ? 'checked' : '' %>> اتصالات</label>
                                <label class="form-check"><input class="form-check-input" type="radio" name="ussdNetwork" value="orange" <%= quickExecute.network === 'orange' ? 'checked' : '' %>> أورنج</label>
                                <label class="form-check"><input class="form-check-input" type="radio" name="ussdNetwork" value="we" <%= quickExecute.network === 'we' ? 'checked' : '' %>> وي</label>
                            </div>
                        </div>
                        <div class="col-md-6" id="quickExecutePinWrap">
                            <label class="form-label fw-bold" for="quickExecutePin">رقم سر المحفظة</label>
                            <input class="form-control" type="password" inputmode="numeric" autocomplete="new-password" maxlength="8" id="quickExecutePin" placeholder="<%= quickExecute.pinSet ? 'محفوظ مشفراً — اتركه فارغاً للإبقاء' : '4 إلى 8 أرقام' %>" dir="ltr">
                            <small class="text-muted" id="quickExecutePinHint"><%= quickExecute.pinSet ? 'رقم السر محفوظ مشفراً.' : 'مطلوب لاتصالات وأورنج ووي.' %></small>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-warning py-2 px-3 mb-0 small" id="quickExecuteSecurityNote">
                                تنبيه أمني: لشبكات اتصالات وأورنج ووي يظهر رقم سر المحفظة في شاشة الاتصال. لا تشارك الشاشة ولا تترك الهاتف دون مراقبة أثناء الاتصال.
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-2">
                            <button type="submit" class="settings-btn-primary"><i class="fa-solid fa-floppy-disk"></i> حفظ شبكة التنفيذ</button>
                            <button type="button" class="settings-btn-primary danger" id="quickExecuteClearPin" <%= quickExecute.pinSet ? '' : 'hidden' %>><i class="fa-solid fa-eraser"></i> حذف رقم السر</button>
                        </div>
                    </form>
                </div>
                <% } %>
            </section>

            <!-- الإشعارات -->
            <section class="settings-panel workspace-panel" id="panel-notifications" data-settings-panel="notifications">
                <h2 class="panel-title"><i class="fa-solid fa-bell"></i> إشعارات المهام</h2>

                <div class="push-hero">
                    <div class="push-hero-main">
                        <div class="push-hero-icon"><i class="fa-solid fa-bell"></i></div>
                        <div>
                            <strong id="pushStatusTitle">جاري فحص الإعداد...</strong>
                            <small id="pushStatusHint">فعّل الإشعارات لتصلك المهام الجديدة فورًا.</small>
                        </div>
                    </div>
                    <div class="push-hero-aside">
                        <span class="executor-status-pill" id="pushStatusPill">فحص</span>
                    </div>
                </div>

                <div class="push-actions">
                    <button class="settings-btn-primary" type="button" id="enablePush"><i class="fa-solid fa-bell"></i> تفعيل الإشعارات</button>
                    <button class="settings-btn-primary danger" type="button" id="disablePush" hidden><i class="fa-solid fa-bell-slash"></i> إيقاف الإشعارات</button>
                </div>
            </section>

            <!-- الأمان -->
            <section class="settings-panel workspace-panel" id="panel-security" data-settings-panel="security">
                <%- include('../partials/mfa_security_panel') %>
                <form id="settingsPasswordForm" class="settings-password-form">
                    <h3 class="panel-title"><i class="fa-solid fa-key"></i> تغيير كلمة المرور</h3>
                    <label>كلمة المرور الحالية<input class="form-control" type="password" name="currentPassword" autocomplete="current-password" required></label>
                    <label>كلمة المرور الجديدة<input class="form-control" type="password" name="newPassword" autocomplete="new-password" minlength="8" required></label>
                    <label>تأكيد كلمة المرور الجديدة<input class="form-control" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required></label>
                    <button class="settings-btn-primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> تغيير كلمة المرور</button>
                </form>
            </section>

            <!-- إدارة الفريق (manager only) -->
            <% if (isManager) { %>
            <section class="settings-panel workspace-panel" id="panel-team" data-settings-panel="team">
                <div class="routing-control">
                    <div>
                        <h2 class="panel-title mb-0"><i class="fa-solid fa-route"></i> التوجيه اليدوي للمهام</h2>
                        <p id="routingDescription"><%= emp.groupId?.manualTaskRoutingEnabled ? 'لا تظهر العملية للموظف إلا بعد أن يوجهها المدير إليه بالاسم.' : 'تظهر العمليات المتاحة للمدير والموظفين ويمكن لأول منفذ متاح قبولها.' %></p>
                    </div>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="manualRoutingSwitch" <%= emp.groupId?.manualTaskRoutingEnabled ? 'checked' : '' %>>
                    </div>
                </div>

                <div class="routing-control mt-4 align-items-start">
                    <div class="w-100">
                        <h2 class="panel-title mb-1"><i class="fa-solid fa-shield-halved"></i> صلاحيات التنفيذ</h2>
                        <p class="mb-3">الافتراضي للشركة. يمكن تجاوزه لكل منفّذ من صفحة الفريق.</p>
                        <% const companyLengths = Array.isArray(emp.groupId?.manualAllowedPhoneLengths) ? emp.groupId.manualAllowedPhoneLengths : [3,4,11]; %>
                        <% const companyMode = companyLengths.length === 1 ? String(companyLengths[0]) : 'all'; %>
                        <form id="executionPolicyForm" class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">أرقام إثبات المرسل</label>
                                <div class="d-flex flex-wrap gap-3">
                                    <label class="form-check"><input class="form-check-input" type="radio" name="phoneLengthMode" value="3" <%= companyMode === '3' ? 'checked' : '' %>> 3 أرقام فقط</label>
                                    <label class="form-check"><input class="form-check-input" type="radio" name="phoneLengthMode" value="4" <%= companyMode === '4' ? 'checked' : '' %>> 4 أرقام فقط</label>
                                    <label class="form-check"><input class="form-check-input" type="radio" name="phoneLengthMode" value="11" <%= companyMode === '11' ? 'checked' : '' %>> 11 رقماً فقط</label>
                                    <label class="form-check"><input class="form-check-input" type="radio" name="phoneLengthMode" value="all" <%= companyMode === 'all' ? 'checked' : '' %>> الثلاثة مسموحة</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="proofRequiredSwitch" <%= emp.groupId?.manualProofRequired ? 'checked' : '' %>>
                                    <label class="form-check-label fw-bold" for="proofRequiredSwitch">صورة الإثبات إجبارية</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="quickExecuteSwitch" <%= emp.groupId?.manualQuickExecuteEnabled ? 'checked' : '' %>>
                                    <label class="form-check-label fw-bold" for="quickExecuteSwitch">تنفيذ سريع (USSD)</label>
                                </div>
                                <small class="text-muted">يظهر زر الاتصال بجانب إنهاء للمنفّذ بعد قبول المهمة.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold" for="maxConcurrentDevices">أقصى أجهزة متزامنة</label>
                                <input class="form-control" type="number" min="1" max="20" id="maxConcurrentDevices" value="<%= Number(emp.groupId?.maxConcurrentDevices || 1) %>">
                                <small class="text-muted">1 = الدخول الجديد يُخرج الجهاز السابق.</small>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="sessionTtlSwitch" <%= emp.groupId?.sessionTtlEnabled ? 'checked' : '' %>>
                                    <label class="form-check-label fw-bold" for="sessionTtlSwitch">حد مدة الجلسة</label>
                                </div>
                                <small class="text-muted">عند الإيقاف تبقى الجلسة مفتوحة ويُحدَّث التوكن تلقائياً.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold" for="sessionTtlHours">مدة الجلسة (ساعات)</label>
                                <input class="form-control" type="number" min="1" max="720" id="sessionTtlHours" value="<%= Math.max(1, Math.round(Number(emp.groupId?.sessionTtlSeconds || 28800) / 3600)) %>" <%= emp.groupId?.sessionTtlEnabled ? '' : 'disabled' %>>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="settings-btn-primary"><i class="fa-solid fa-floppy-disk"></i> حفظ صلاحيات الشركة</button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
            <% } %>
        </div>
    </div>
</main>

<script src="/js/executor-workspace.js?v=20260819-1"></script>
<script src="/js/executor/settings/page.js?v=20261025-review"></script>
</body>
</html>
