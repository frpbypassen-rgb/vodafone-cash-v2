            box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
            padding-bottom: env(safe-area-inset-bottom);
        }
        .bottom-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            color: var(--text-muted);
            text-decoration: none;
            flex: 1;
            height: 100%;
            transition: all 0.2s ease;
            font-size: 0.72rem;
            font-weight: 700;
        }
        .bottom-nav-item i {
