        }
        .bottom-nav-item:hover {
            color: var(--text-main);
        }
        .bottom-nav-item.active {
            color: var(--accent-gold);
        }
        .bottom-nav-item.active i {
            transform: translateY(-2px);
        }

        /* ط¨ط·ط§ظ‚ط§طھ ط§ظ„ظ…ظˆط¸ظپظٹظ† ظ„ظ„ظ‡ط§طھظپ */
        .mobile-emp-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            transition: transform 0.15s ease;
        }
        .mobile-emp-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        .emp-card-name {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--text-main);
            display: block;
        }
        .emp-card-username {
            font-size: 0.78rem;
            font-weight: 700;
            font-family: monospace;
        }
        .mobile-emp-body {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            background: rgba(0, 0, 0, 0.02);
            padding: 10px;
            border-radius: 12px;
        }
        [data-theme="dark"] .mobile-emp-body {
            background: rgba(255, 255, 255, 0.02);
        }
        .emp-info-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .emp-info-item .info-label {
            font-size: 0.72rem;
            color: var(--text-muted);
            font-weight: 700;
        }
        .emp-info-item .info-value {
            font-size: 0.85rem;
            font-weight: 800;
            color: var(--text-main);
        }
        .mobile-emp-actions {
            display: flex;
