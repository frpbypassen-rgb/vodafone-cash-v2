<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>إدارة الموظفين | الأهرام</title>
    
    <script src="/js/executor/employees/theme-init.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>window.executorCsrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;</script>
    <script src="/js/executor-api.js"></script>
    
    <link rel="stylesheet" href="/css/executor/pages/employees.css">
    <link rel="stylesheet" href="/css/brand-ui.css?v=20260804-brand1">
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260923-team-rtl">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260825-balance1">
    <link rel="stylesheet" href="/css/executor-os.css?v=20260930-mobile-shell">
    <link rel="stylesheet" href="/css/executor-team-mobile.css?v=20261002-compact">

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Al-Ahram">
    <!-- End PWA Setup -->
</head>
<body class="executor-os executor-portal-v2 executor-page-employees">

<%- include('partials/navigation', { emp, activePage: 'employees' }) %>
<div class="exo-stage">
    <%- include('partials/command-bar', { emp, companyBalances: typeof companyBalances === 'undefined' ? null : companyBalances }) %>
</div>

<nav class="navbar-glass">
    <div class="executor-info">
        <div class="executor-avatar"><i class="fa-solid fa-user-astronaut"></i></div>
        <div>
            <h4 class="executor-name"><%= emp.name %></h4>
            <span class="executor-role"><i class="fa-solid fa-network-wired me-1"></i> غرفة العمليات: <%= emp.groupId ? emp.groupId.name : 'غير محدد' %></span>
        </div>
    </div>
    <div class="nav-actions">
        <% const employeeNavRows = Array.isArray(companyBalances?.byService) ? companyBalances.byService : []; %>
        <% if (companyBalances?.multiService && employeeNavRows.length > 1) { %>
            <% employeeNavRows.forEach((row) => { %>
                <span class="nav-btn text-success border border-success border-opacity-25" style="cursor: default; font-weight: 800;" title="<%= row.appliesPoolModel ? row.totalLabel : row.singleLabel %>"><i class="fa-solid fa-wallet me-1"></i> <%= row.shortLabel %> <%= Number(row.appliesPoolModel ? row.totalBalance : row.privateBalance).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
            <% }); %>
        <% } else { %>
        <span class="nav-btn text-success border border-success border-opacity-25" style="cursor: default; font-weight: 800;" title="إجمالي الرصيد: الخاص + مجموعات الرصيد + المنفردين"><i class="fa-solid fa-vault me-1"></i> إجمالي <%= Number(companyBalances?.totalBalance ?? emp.groupId?.balance ?? 0).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
        <span class="nav-btn text-warning border border-warning border-opacity-25" style="cursor: default; font-weight: 800;" title="الرصيد الخاص المتاح للمدير"><i class="fa-solid fa-wallet me-1"></i> خاص <%= Number(companyBalances?.privateBalance ?? emp.groupId?.balance ?? 0).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
        <% } %>
        <button class="nav-btn btn-theme shadow-sm" onclick="toggleTheme()" title="المظهر"><i class="fa-solid fa-moon" id="themeIcon"></i></button>
        <a href="/executor-portal/logout" class="nav-btn btn-logout"><i class="fa-solid fa-power-off"></i></a>
    </div>
</nav>

<div class="container-fluid px-3 px-md-4">
    <div class="executor-page-heading">
        <div>
            <span class="executor-kicker"><i class="fa-solid fa-users-gear"></i> إدارة الفريق</span>
            <h1>الموظفون وحالة التشغيل</h1>
            <p>متابعة التوفر والمهام الحالية، وإدارة حسابات الفريق ومجموعات رصيد المنفذين الخارجيين من مكان واحد.</p>
        </div>
        <button type="button" class="nav-btn" onclick="loadEmployees()" title="تحديث"><i class="fa-solid fa-rotate"></i></button>
    </div>

    <section class="executor-summary-grid mb-4">
        <%- include('partials/service-balance-cards', { companyBalances }) %>
        <article class="executor-summary-card" style="--summary-color: var(--executor-blue)"><span class="summary-icon"><i class="fa-solid fa-users"></i></span><small>إجمالي الفريق</small><strong id="summaryTotal">0</strong></article>
        <article class="executor-summary-card" style="--summary-color: var(--executor-green)"><span class="summary-icon"><i class="fa-solid fa-signal"></i></span><small>متصلون الآن</small><strong id="summaryOnline">0</strong></article>
        <article class="executor-summary-card" style="--summary-color: var(--executor-gold)"><span class="summary-icon"><i class="fa-solid fa-bolt"></i></span><small>ينفذون الآن</small><strong id="summaryBusy">0</strong></article>
        <article class="executor-summary-card" style="--summary-color: #7a57d1"><span class="summary-icon"><i class="fa-solid fa-check-double"></i></span><small>عمليات اليوم</small><strong id="summaryCompleted">0</strong></article>
    </section>

    <div class="page-card mb-4" id="externalPoolWorkspace">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <h5 class="section-title m-0"><i class="fa-solid fa-link"></i> مجموعات الرصيد للمنفذين الخارجيين</h5>
            <button type="button" class="btn-create" style="padding:10px 18px;font-size:0.9rem" onclick="createBalancePool()"><i class="fa-solid fa-plus me-1"></i> مجموعة رصيد جديدة</button>
        </div>
        <p class="text-muted small mb-3">أنشئ <b>مجموعة رصيد</b> باسم واضح (مثل «شركة النور») واربط بها المنفذين الخارجيين، أو اترك المنفّذ <b>منفردًا</b>. العضوية حصرية: مجموعة واحدة أو منفرد — ليس الاثنين. تمويل منفّذ خارجي يُخصم من <b>الرصيد الخاص</b>، والإيصال يظهر <b>للمستلم فقط</b>.</p>
        <div class="pool-workspace">
            <section class="pool-workspace-col" aria-label="مجموعات الرصيد">
                <h6><i class="fa-solid fa-layer-group"></i> مجموعات الرصيد</h6>
                <div id="poolList" class="d-flex flex-column gap-3"></div>
                <div id="poolEmpty" class="empty-state d-none">
                    <i class="fa-solid fa-layer-group d-block"></i>
                    <p class="fw-bold">لا توجد مجموعات رصيد حالياً</p>
                    <p class="small">أنشئ مجموعة باسم ثم أضف إليها المنفذين الخارجيين الذين تريد أن يشاركوا نفس الرصيد.</p>
                </div>
            </section>
            <section class="pool-workspace-col" aria-label="منفّذون خارجيون منفردون">
                <h6><i class="fa-solid fa-user"></i> منفّذون خارجيون منفردون</h6>
                <div id="soloList" class="d-flex flex-column gap-3"></div>
                <div id="soloEmpty" class="empty-state d-none">
                    <i class="fa-solid fa-user-slash d-block"></i>
                    <p class="fw-bold">لا يوجد منفّذ خارجي منفرد</p>
                    <p class="small">كل المنفذين الخارجيين مرتبطون بمجموعة رصيد، أو لم يُنشأ منفّذ خارجي بعد.</p>
                </div>
            </section>
        </div>
    </div>
    <!-- قسم إنشاء حساب جديد -->
    <div class="page-card mb-4">
        <h5 class="section-title"><i class="fa-solid fa-user-plus"></i> إنشاء حساب موظف جديد</h5>
        
        <form id="createForm">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label"><i class="fa-solid fa-user me-1"></i> الاسم الكامل</label>
                    <input type="text" id="empName" class="form-control" placeholder="اسم الموظف" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="fa-solid fa-phone me-1"></i> رقم الهاتف</label>
                    <input type="tel" id="empPhone" class="form-control" placeholder="01xxxxxxxxx" autocomplete="tel" inputmode="tel" dir="ltr" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="fa-solid fa-briefcase me-1"></i> الوظيفة</label>
                    <select id="empRole" class="form-select">
                        <option value="operator">موظف تنفيذ (Operator)</option>
                        <option value="accountant">محاسب (Accountant)</option>
                        <option value="external">منفّذ خارجي</option>
                    </select>
                </div>
            </div>
            <hr style="border-color: var(--glass-border);">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label"><i class="fa-solid fa-at me-1"></i> اسم المستخدم</label>
                    <div class="input-group" dir="ltr">
                        <input type="text" id="empUsername" class="form-control text-end border-end-0" placeholder="username" autocomplete="username" pattern="[A-Za-z0-9_]+" minlength="3" required>
                        <span class="input-group-text border-start-0">@ahram.com</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="fa-solid fa-lock me-1"></i> كلمة المرور</label>
                    <input type="password" id="empPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" minlength="8" dir="ltr" required>
                </div>
                <div class="col-md-4" id="externalPoolField" hidden>
                    <label class="form-label"><i class="fa-solid fa-layer-group me-1"></i> مجموعة رصيد (اختياري)</label>
                    <select id="empPoolId" class="form-select">
                        <option value="">منفرد — بدون مجموعة رصيد</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn-create w-100"><i class="fa-solid fa-plus me-2"></i> إنشاء الحساب</button>
                </div>
            </div>
        </form>
    </div>

    <!-- قسم قائمة الموظفين -->
    <div class="page-card">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <h5 class="section-title m-0"><i class="fa-solid fa-users"></i> فريق العمل (<span id="empCount">0</span>)</h5>
            <div class="team-toolbar">
                <input type="search" id="employeeSearch" class="form-control" placeholder="بحث بالاسم أو الهاتف أو اسم المستخدم">
                <select id="employeeRoleFilter" class="form-select" style="max-width:170px"><option value="">كل الوظائف</option><option value="operator">موظف تنفيذ</option><option value="accountant">محاسب</option><option value="external">منفّذ خارجي</option><option value="manager">مدير</option></select>
            </div>
        </div>
        
        <div class="table-responsive d-none d-md-block">
            <table class="emp-table">
                <thead>
                    <tr>
                        <th>الاسم</th>
                        <th>اسم المستخدم</th>
                        <th>الهاتف</th>
                        <th>الوظيفة</th>
                        <th>رصيد العمل</th>
                        <th>الحالة والتوفر</th>
                        <th>أداء اليوم</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody id="empTableBody">
                </tbody>
            </table>
        </div>
        <!-- قائمة الموظفين للموبايل (تظهر كبطاقات تطبيق) -->
        <div class="mobile-emp-list d-flex flex-column gap-3 d-md-none" id="mobileEmpList"></div>
        <div id="emptyState" class="empty-state d-none">
            <i class="fa-solid fa-users-slash d-block"></i>
            <p class="fw-bold">لا يوجد موظفين حالياً</p>
            <p class="small">قم بإنشاء حسابات لفريق عملك من النموذج أعلاه</p>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/executor-workspace.js?v=20260819-1"></script>
<script>window.executorEmployeeBalances = <%- JSON.stringify({ totalBalance: Number(companyBalances?.totalBalance || 0), privateBalance: Number(companyBalances?.privateBalance || 0) }).replace(/</g, '\u003c') %>;</script>
<script src="/js/executor/employees/workspace.js"></script>
<script src="/js/executor/employees/rendering.js"></script>
<script src="/js/executor/employees/accounts.js"></script>
<script src="/js/executor/employees/balance-pools.js"></script>
        
        <!-- شريط التنقل السفلي للهواتف (App-like Bottom Navigation) -->
        <!-- شريط التنقل السفلي للهواتف (App-like Bottom Navigation) -->
        <div class="bottom-nav-mobile d-md-none">
            <!-- حسابي (الملف الشخصي والمنجزات) -->
            <a href="/executor-portal/dashboard#profile" class="bottom-nav-item" id="nav-profile">
                <i class="fa-solid fa-circle-user"></i>
                <span>حسابي</span>
            </a>
            <!-- الرادار -->
            <a href="/executor-portal/dashboard#radar" class="bottom-nav-item" id="nav-dash">
                <i class="fa-solid fa-satellite-dish"></i>
                <span>الرادار</span>
            </a>
            <!-- التقارير -->
            <a href="/executor-portal/reports" class="bottom-nav-item" id="nav-rep">
                <i class="fa-solid fa-chart-line"></i>
                <span>التقارير</span>
            </a>
            <% if (emp.role === 'manager') { %>
            <!-- الموظفين -->
            <a href="/executor-portal/employees" class="bottom-nav-item" id="nav-emp">
                <i class="fa-solid fa-users"></i>
                <span>الموظفين</span>
            </a>
            <% } %>
        </div>
        <script src="/js/executor/employees/navigation.js"></script>
</body>
</html>
