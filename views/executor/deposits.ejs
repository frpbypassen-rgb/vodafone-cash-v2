<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>إيداعات شركة التنفيذ | الأهرام</title>
    <script>window.executorCsrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;</script>
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('ahram_theme') || 'light');</script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/executor-api.js"></script>
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260921-pool-ui">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260826-deposit-review">
    <link rel="stylesheet" href="/css/executor-os.css?v=20260930-mobile-shell">
    <link rel="stylesheet" href="/css/executor-deposits.css?v=20261002-compact-balances">
</head>
<body class="executor-os">
    <%- include('partials/navigation', { emp, activePage: 'deposits', showMfaNotice }) %>
    <div class="exo-stage">
        <%- include('partials/command-bar', { emp, companyBalances: typeof companyBalances === 'undefined' ? null : companyBalances }) %>
    </div>
    <% const isExternalDepositView = depositScope === 'external'; %>
    <main class="deposit-main">
        <header class="deposit-hero">
            <div>
                <h1><i class="fa-solid <%= isExternalDepositView ? 'fa-wallet' : 'fa-building-columns' %> text-info ms-2"></i><%= isExternalDepositView ? 'حركات رصيدك' : 'إيداعات شركة التنفيذ' %></h1>
                <p><%= isExternalDepositView
                    ? 'هنا تظهر فقط الإيداعات والخصومات التي أضافها لك مدير شركة التنفيذ. لا تظهر لك أي بيانات أو إيداعات تخص الشركة.'
                    : (emp.role === 'manager'
                        ? 'تصل إليك طلبات الإيداع الصادرة من الإدارة مع الإيصالات. راجع الطلب ثم اقبله أو ألغِه من هذه الصفحة.'
                        : 'متابعة طلبات إيداع الشركة والإيصالات. هذا الحساب للعرض فقط — القبول والإلغاء لمدير التنفيذ.') %></p>
            </div>
            <div class="deposit-balance-stack">
                <% if (isExternalDepositView) { %>
                    <div class="deposit-balance-card">
                        <span><i class="fa-solid fa-wallet ms-1"></i> <%= workingBalance && workingBalance.pool ? `رصيد مجموعة «${workingBalance.pool.name}»` : 'رصيدك المنفرد' %></span>
                        <strong dir="ltr"><%= Number((workingBalance && workingBalance.balance != null) ? workingBalance.balance : (emp.balance || 0)).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> EGP</strong>
                        <small class="deposit-balance-help"><%= workingBalance && workingBalance.pool ? 'تشارك هذا الرصيد مع باقي أعضاء المجموعة. إيصال التمويل يظهر لك وحدك.' : 'رصيدك الخاص كمنفّذ خارجي منفرد.' %></small>
                    </div>
                <% } else { %>
                    <%- include('partials/service-balance-cards', { companyBalances, boxVariant: 'cards' }) %>
                <% } %>
            </div>
        </header>

        <section class="deposit-grid review-only">
            <form class="deposit-card deposit-form d-none" id="depositForm" aria-hidden="true">
                <h2><i class="fa-solid fa-circle-plus"></i>طلب إيداع جديد</h2>
                <div class="mb-3">
                    <label for="depositAmount">قيمة الإيداع (EGP)</label>
                    <input id="depositAmount" class="form-control" type="number" min="1" max="1000000" step="0.01" required placeholder="مثال: 5000">
                </div>
                <div class="mb-3">
                    <label for="depositNote">ملاحظة للدعم</label>
                    <textarea id="depositNote" class="form-control" rows="3" maxlength="1000" placeholder="مرجع التحويل، اسم البنك، أو أي تفاصيل تساعد المراجعة"></textarea>
                </div>
                <div class="mb-3">
                    <label>إيصالات الإيداع</label>
                    <label class="drop-zone" id="depositDropZone" for="depositReceipts">
                        <i class="fa-solid fa-images"></i>
                        <strong>اسحب الصور أو اضغط للاختيار</strong>
                        <small>من 1 إلى 5 صور — JPG أو PNG أو WEBP — حتى 5MB للصورة</small>
                        <input id="depositReceipts" type="file" accept="image/jpeg,image/png,image/webp" multiple>
                    </label>
                    <div class="receipt-toolbar">
                        <span id="receiptCountLabel">لم تُرفق صور بعد</span>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 d-none" id="clearReceipts">مسح الكل</button>
                    </div>
                    <div class="receipt-preview" id="receiptPreview"></div>
                </div>
                <button class="submit-deposit" type="submit" id="submitDepositBtn" disabled>
                    <i class="fa-solid fa-paper-plane ms-1"></i>إرسال طلب الإيداع للمراجعة
                </button>
            </form>

            <section class="deposit-card">
                <div class="deposit-list-head">
                    <h2 class="m-0"><i class="fa-solid fa-clock-rotate-left"></i><%= isExternalDepositView ? 'سجل حركات رصيدك' : 'متابعة طلبات الإيداع' %></h2>
                    <span class="deposit-live" id="depositLiveBadge"><i class="fa-solid fa-signal"></i> تحديث تلقائي</span>
                </div>
                <div class="deposit-list" id="depositList">
                    <div class="empty"><i class="fa-solid fa-circle-notch fa-spin"></i>جارٍ تحميل الطلبات...</div>
                </div>
            </section>
        </section>
    </main>
    <script>window.executorDepositConfig = { canReviewAdminDeposits: <%= emp.role === 'manager' ? 'true' : 'false' %>, isExternalDepositView: <%= isExternalDepositView ? 'true' : 'false' %> };</script>
<script src="/js/executor/deposits/page.js?v=20261025-review"></script>
</body>
</html>
