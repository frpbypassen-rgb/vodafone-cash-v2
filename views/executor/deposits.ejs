<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>إيداعات شركة التنفيذ | الأهرام</title>
    <script>window.executorCsrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;</script>
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('ahram_theme') || 'light');</script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/executor-api.js"></script>
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260826-deposit-review">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260826-deposit-review">
    <link rel="stylesheet" href="/css/executor-os.css?v=20260826-deposit-review">
    <style>
        body { font-family: Tajawal, sans-serif; background: var(--x-bg, #08111f); color: var(--x-text, #edf5ff); }
        .deposit-main { max-width: 1180px; margin: 0 auto; padding: 30px 22px 110px; }
        .deposit-hero { display: grid; grid-template-columns: 1fr auto; gap: 18px; align-items: start; margin-bottom: 22px; }
        .deposit-hero h1 { font-size: clamp(1.35rem, 3vw, 2rem); font-weight: 900; margin: 0 0 6px; }
        .deposit-hero p { color: var(--x-muted, #9cadc3); margin: 0; max-width: 640px; line-height: 1.7; }
        .deposit-balance-card { min-width: 220px; padding: 14px 16px; border-radius: 16px; border: 1px solid rgba(52, 211, 153, 0.28); background: rgba(52, 211, 153, 0.08); text-align: start; }
        .deposit-balance-card span { display: block; color: var(--x-muted, #9cadc3); font-size: 0.74rem; font-weight: 800; margin-bottom: 4px; }
        .deposit-balance-card strong { font-family: 'JetBrains Mono', monospace; font-size: 1.35rem; color: #34d399; }
        .deposit-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 18px; }
        .deposit-step { padding: 12px; border-radius: 14px; border: 1px solid var(--x-border, rgba(94, 234, 212, 0.18)); background: rgba(255, 255, 255, 0.03); }
        .deposit-step strong { display: block; font-size: 0.82rem; margin-bottom: 4px; }
        .deposit-step small { color: var(--x-muted, #9cadc3); font-size: 0.72rem; line-height: 1.5; }
        .deposit-grid { display: grid; grid-template-columns: minmax(300px, 0.95fr) minmax(0, 1.45fr); gap: 18px; align-items: start; }
        .deposit-grid.review-only { grid-template-columns: minmax(0, 1fr); }
        .deposit-card { background: var(--x-surface, rgba(17, 29, 48, 0.93)); border: 1px solid var(--x-border, rgba(94, 234, 212, 0.18)); border-radius: 20px; padding: 20px; box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18); }
        .deposit-card h2 { font-size: 1.05rem; font-weight: 900; margin: 0 0 18px; }
        .deposit-card h2 i { color: var(--x-cyan, #22d3ee); margin-left: 7px; }
        .deposit-form label { color: var(--x-muted, #9cadc3); font-size: 0.8rem; font-weight: 800; margin-bottom: 7px; }
        .deposit-form .form-control { background: rgba(255, 255, 255, 0.04); border-color: var(--x-border, rgba(94, 234, 212, 0.18)); color: inherit; border-radius: 12px; padding: 12px; }
        .drop-zone { border: 1px dashed rgba(34, 211, 238, 0.45); background: rgba(34, 211, 238, 0.04); border-radius: 15px; padding: 16px; text-align: center; cursor: pointer; color: var(--x-muted, #9cadc3); transition: 0.2s; }
        .drop-zone:hover, .drop-zone.is-dragover { border-color: rgba(34, 211, 238, 0.75); background: rgba(34, 211, 238, 0.08); }
        .drop-zone input { display: none; }
        .drop-zone i { font-size: 1.35rem; color: var(--x-cyan, #22d3ee); display: block; margin-bottom: 6px; }
        .drop-zone strong { color: var(--x-text, #edf5ff); display: block; }
        .drop-zone small { font-size: 0.72rem; }
        .receipt-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 10px; font-size: 0.74rem; color: var(--x-muted, #9cadc3); font-weight: 800; }
        .receipt-preview { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 8px; }
        .receipt-item { position: relative; }
        .receipt-item img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; border: 1px solid var(--x-border, rgba(94, 234, 212, 0.18)); }
        .receipt-remove { position: absolute; top: 4px; left: 4px; width: 24px; height: 24px; border: 0; border-radius: 999px; background: rgba(239, 68, 68, 0.92); color: #fff; font-size: 0.72rem; }
        .submit-deposit { width: 100%; border: 0; border-radius: 13px; padding: 13px; background: linear-gradient(135deg, #0e9b86, #0077b6); color: white; font-weight: 900; }
        .submit-deposit:disabled { opacity: 0.55; cursor: not-allowed; }
        .deposit-list-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
        .deposit-live { display: inline-flex; align-items: center; gap: 6px; color: var(--x-muted, #9cadc3); font-size: 0.72rem; font-weight: 800; }
        .deposit-live.is-active { color: #facc15; }
        .deposit-list { display: flex; flex-direction: column; gap: 12px; }
        .deposit-review-card { display: flex; flex-direction: column; gap: 12px; padding: 16px; border-radius: 16px; border: 1px solid var(--x-border, rgba(94, 234, 212, 0.18)); background: rgba(255, 255, 255, 0.025); }
        .deposit-review-card.is-pending { border-color: rgba(250, 204, 21, 0.32); box-shadow: 0 10px 28px rgba(250, 204, 21, 0.06); }
        .deposit-review-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
        .deposit-review-card-side { text-align: start; flex: 0 0 auto; }
        .deposit-ref { font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: var(--x-cyan, #22d3ee); }
        .deposit-value { font-family: 'JetBrains Mono', monospace; font-size: 1.08rem; font-weight: 900; margin-bottom: 6px; }
        .deposit-meta { color: var(--x-muted, #9cadc3); font-size: 0.76rem; margin-top: 4px; line-height: 1.6; }
        .deposit-thumbs { display: flex; gap: 8px; flex-wrap: wrap; }
        .deposit-thumbs img { width: 52px; height: 52px; object-fit: cover; border-radius: 10px; border: 1px solid var(--x-border, rgba(94, 234, 212, 0.18)); cursor: zoom-in; }
        .status { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; padding: 5px 9px; font-size: 0.72rem; font-weight: 900; }
        .status.pending { color: #facc15; background: rgba(250, 204, 21, 0.12); }
        .status.deposit { color: #34d399; background: rgba(52, 211, 153, 0.12); }
        .status.rejected { color: #fb7185; background: rgba(251, 113, 133, 0.12); }
        .deposit-new-btn { margin-top: 8px; border: 0; border-radius: 999px; padding: 6px 10px; background: rgba(34, 211, 238, 0.12); color: var(--x-cyan, #22d3ee); font-size: 0.72rem; font-weight: 900; }
        .deposit-review-box { padding: 12px; border-radius: 14px; border: 1px dashed rgba(34, 211, 238, 0.35); background: rgba(34, 211, 238, 0.05); display: flex; flex-direction: column; gap: 10px; }
        .deposit-review-box-label { display: flex; align-items: center; gap: 6px; font-size: 0.74rem; font-weight: 900; color: var(--x-cyan, #22d3ee); }
        .deposit-review-box-note { margin: 0; font-size: 0.72rem; line-height: 1.55; color: var(--x-muted, #9cadc3); font-weight: 700; }
        .deposit-review-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; width: 100%; }
        .deposit-review-action { min-height: 46px; border-radius: 12px; border: 1px solid transparent; font-family: inherit; font-weight: 900; font-size: 0.82rem; display: inline-flex; align-items: center; justify-content: center; gap: 6px; transition: transform .18s ease, filter .18s ease; }
        .deposit-review-action:hover { transform: translateY(-1px); filter: brightness(1.06); }
        .deposit-review-action.is-approve { color: #052e27; background: linear-gradient(135deg, #5eead4, #22c55e); box-shadow: 0 8px 20px rgba(34, 197, 94, .2); }
        .deposit-review-action.is-cancel { color: #fecaca; background: rgba(127, 29, 29, .24); border-color: rgba(251, 113, 133, .5); }
        .deposit-review-result { padding: 10px 12px; border-radius: 12px; font-size: 0.74rem; font-weight: 800; line-height: 1.55; }
        .deposit-review-result.is-success { color: #34d399; background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.22); }
        .deposit-review-result.is-danger { color: #fb7185; background: rgba(251, 113, 133, 0.1); border: 1px solid rgba(251, 113, 133, 0.22); }
        .deposit-review-result.is-warn { color: #facc15; background: rgba(250, 204, 21, 0.1); border: 1px solid rgba(250, 204, 21, 0.22); }
        .empty { text-align: center; color: var(--x-muted, #9cadc3); padding: 42px 12px; }
        .empty i { display: block; font-size: 2rem; margin-bottom: 8px; }
        @media (max-width: 850px) {
            .deposit-main { padding: 20px 14px 104px; }
            .deposit-grid, .deposit-steps { grid-template-columns: 1fr; }
            .deposit-hero { grid-template-columns: 1fr; }
            .deposit-balance-card { width: 100%; }
            .deposit-card { padding: 16px; }
            .deposit-review-card-head { flex-direction: column; }
            .deposit-review-card-side { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
            .deposit-review-actions { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body class="executor-os">
    <%- include('partials/navigation', { emp, activePage: 'deposits', showMfaNotice }) %>
    <main class="deposit-main">
        <header class="deposit-hero">
            <div>
                <h1><i class="fa-solid fa-building-columns text-info ms-2"></i>إيداعات شركة التنفيذ</h1>
                <p>تصل إليك طلبات الإيداع الصادرة من الإدارة مع الإيصالات. راجع الطلب ثم اقبله أو ألغِه من هذه الصفحة.</p>
            </div>
            <div class="deposit-balance-card">
                <span><i class="fa-solid fa-wallet ms-1"></i> الرصيد المتاح حالياً</span>
                <strong dir="ltr"><%= Number(emp.groupId?.balance || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> EGP</strong>
            </div>
        </header>

        <section class="deposit-grid review-only">
            <form class="deposit-card deposit-form d-none" id="depositForm" aria-hidden="true">
                <h2><i class="fa-solid fa-circle-plus"></i>طلب إيداع جديد</h2>
                <div class="mb-3">
                    <label for="depositAmount">قيمة الإيداع (EGP)</label>
                    <input id="depositAmount" class="form-control" type="number" min="1" max="1000000" step="0.01" required placeholder="مثال: 5000">
                </div>
                <div class="mb-3">
                    <label for="depositNote">ملاحظة للدعم</label>
                    <textarea id="depositNote" class="form-control" rows="3" maxlength="1000" placeholder="مرجع التحويل، اسم البنك، أو أي تفاصيل تساعد المراجعة"></textarea>
                </div>
                <div class="mb-3">
                    <label>إيصالات الإيداع</label>
                    <label class="drop-zone" id="depositDropZone" for="depositReceipts">
                        <i class="fa-solid fa-images"></i>
                        <strong>اسحب الصور أو اضغط للاختيار</strong>
                        <small>من 1 إلى 5 صور — JPG أو PNG أو WEBP — حتى 5MB للصورة</small>
                        <input id="depositReceipts" type="file" accept="image/jpeg,image/png,image/webp" multiple>
                    </label>
                    <div class="receipt-toolbar">
                        <span id="receiptCountLabel">لم تُرفق صور بعد</span>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 d-none" id="clearReceipts">مسح الكل</button>
                    </div>
                    <div class="receipt-preview" id="receiptPreview"></div>
                </div>
                <button class="submit-deposit" type="submit" id="submitDepositBtn" disabled>
                    <i class="fa-solid fa-paper-plane ms-1"></i>إرسال طلب الإيداع للمراجعة
                </button>
            </form>

            <section class="deposit-card">
                <div class="deposit-list-head">
                    <h2 class="m-0"><i class="fa-solid fa-clock-rotate-left"></i>متابعة طلبات الإيداع</h2>
                    <span class="deposit-live" id="depositLiveBadge"><i class="fa-solid fa-signal"></i> تحديث تلقائي</span>
                </div>
                <div class="deposit-list" id="depositList">
                    <div class="empty"><i class="fa-solid fa-circle-notch fa-spin"></i>جارٍ تحميل الطلبات...</div>
                </div>
            </section>
        </section>
    </main>
    <script>
        const input = document.getElementById('depositReceipts');
        const dropZone = document.getElementById('depositDropZone');
        const preview = document.getElementById('receiptPreview');
        const submitBtn = document.getElementById('submitDepositBtn');
        const amountInput = document.getElementById('depositAmount');
        const receiptCountLabel = document.getElementById('receiptCountLabel');
        const clearReceiptsBtn = document.getElementById('clearReceipts');
        const depositLiveBadge = document.getElementById('depositLiveBadge');
        let selectedFiles = [];
        let refreshTimer = null;
        let requestsCache = [];
        const canReviewAdminDeposits = <%= emp.role === 'manager' ? 'true' : 'false' %>;

        if (window.matchMedia('(pointer: coarse)').matches) {
            input.setAttribute('capture', 'environment');
        }

        const esc = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char]));
        const date = (value) => value ? new Date(value).toLocaleString('ar-LY', { dateStyle: 'medium', timeStyle: 'short' }) : '---';

        function updateSubmitState() {
            const amount = Number(amountInput.value);
            submitBtn.disabled = !(selectedFiles.length > 0 && Number.isFinite(amount) && amount > 0);
        }

        function syncInputFiles() {
            try {
                const dataTransfer = new DataTransfer();
                selectedFiles.forEach((file) => dataTransfer.items.add(file));
                input.files = dataTransfer.files;
            } catch (_) {
                // بعض المتصفحات القديمة لا تدعم DataTransfer — selectedFiles تكفي للإرسال.
            }
            receiptCountLabel.textContent = selectedFiles.length
                ? `${selectedFiles.length} / 5 إيصالات جاهزة للإرسال`
                : 'لم تُرفق صور بعد';
            clearReceiptsBtn.classList.toggle('d-none', !selectedFiles.length);
            updateSubmitState();
        }

        function drawPreview() {
            preview.innerHTML = '';
            selectedFiles.forEach((file, index) => {
                const wrap = document.createElement('div');
                wrap.className = 'receipt-item';
                const img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.onload = () => URL.revokeObjectURL(img.src);
                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'receipt-remove';
                remove.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                remove.addEventListener('click', () => {
                    selectedFiles.splice(index, 1);
                    drawPreview();
                    syncInputFiles();
                });
                wrap.appendChild(img);
                wrap.appendChild(remove);
                preview.appendChild(wrap);
            });
            syncInputFiles();
        }

        function addFiles(files) {
            const incoming = [...files];
            for (const file of incoming) {
                if (selectedFiles.length >= 5) {
                    Swal.fire('تنبيه', 'الحد الأقصى خمسة إيصالات.', 'warning');
                    break;
                }
                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire('تنبيه', `الملف ${file.name} أكبر من 5MB.`, 'warning');
                    continue;
                }
                selectedFiles.push(file);
            }
            drawPreview();
        }

        input.addEventListener('change', () => {
            const picked = [...input.files];
            input.value = '';
            addFiles(picked);
        });

        amountInput.addEventListener('input', updateSubmitState);

        ['dragenter', 'dragover'].forEach((eventName) => {
            dropZone.addEventListener(eventName, (event) => {
                event.preventDefault();
                dropZone.classList.add('is-dragover');
            });
        });
        ['dragleave', 'drop'].forEach((eventName) => {
            dropZone.addEventListener(eventName, (event) => {
                event.preventDefault();
                dropZone.classList.remove('is-dragover');
            });
        });
        dropZone.addEventListener('drop', (event) => {
            addFiles(event.dataTransfer?.files || []);
        });

        clearReceiptsBtn.addEventListener('click', () => {
            selectedFiles = [];
            drawPreview();
        });

        async function toDataUrl(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        function statusMeta(request) {
            if (request.status === 'deposit') return ['deposit', 'مقبول', 'fa-circle-check'];
            if (request.status === 'rejected') return ['rejected', 'مرفوض', 'fa-circle-xmark'];
            return ['pending', 'قيد المراجعة', 'fa-clock'];
        }

        function renderRequests(requests) {
            const list = document.getElementById('depositList');
            if (!requests.length) {
                list.innerHTML = '<div class="empty"><i class="fa-regular fa-folder-open"></i>لا توجد طلبات إيداع حتى الآن.<br><small class="mt-2 d-block">استخدم النموذج على اليسار لإرسال أول طلب.</small></div>';
                return;
            }

            list.innerHTML = requests.map((request) => {
                const [tone, label, icon] = statusMeta(request);
                const thumbs = (request.receiptUrls || []).slice(0, 4).map((url, index) =>
                    `<img src="${esc(url)}" alt="إيصال ${index + 1}" data-image-url="${esc(url)}">`
                ).join('');
                const reviewedLine = request.reviewedByName
                    ? `<div class="deposit-meta">آخر مراجعة: ${esc(request.reviewedByName)} · ${date(request.reviewedAt || request.updatedAt)}</div>`
                    : `<div class="deposit-meta">آخر تحديث: ${date(request.updatedAt || request.createdAt)}</div>`;
                const rejectBlock = request.rejectionReason
                    ? `<div class="deposit-meta text-danger">سبب الرفض: ${esc(request.rejectionReason)}</div><button type="button" class="deposit-new-btn" data-scroll-form="1"><i class="fa-solid fa-rotate-right ms-1"></i>إنشاء طلب جديد</button>`
                    : '';
                const fromAdmin = request.submittedByRole === 'admin';
                const reviewActions = request.status === 'pending' && canReviewAdminDeposits
                    ? `<div class="deposit-review-box">
                        <div class="deposit-review-box-label"><i class="fa-solid fa-scale-balanced"></i> قرار المراجعة</div>
                        <p class="deposit-review-box-note">راجع الإيصالات ثم اختر قبول الإيداع لإضافة الرصيد، أو إلغاء الطلب مع توضيح السبب.</p>
                        <div class="deposit-review-actions">
                            <button type="button" class="deposit-review-action is-approve" data-admin-deposit-review="approve" data-request-id="${esc(request.id)}"><i class="fa-solid fa-circle-check"></i> قبول الإيداع</button>
                            <button type="button" class="deposit-review-action is-cancel" data-admin-deposit-review="reject" data-request-id="${esc(request.id)}"><i class="fa-solid fa-ban"></i> إلغاء الطلب</button>
                        </div>
                    </div>`
                    : (request.status === 'pending'
                        ? `<div class="deposit-review-result is-warn"><i class="fa-solid fa-clock ms-1"></i> طلب قيد المراجعة بانتظار موافقة مدير الشركة.</div>`
                        : '');
                return `
                    <article class="deposit-review-card ${tone === 'pending' ? 'is-pending' : ''}">
                        <header class="deposit-review-card-head">
                            <div>
                                <div class="deposit-ref">${esc(request.customId)}</div>
                                <div class="deposit-meta">${fromAdmin ? 'طلب وارد من الإدارة' : 'طلب مقدم من الشركة'} · ${esc(request.note || 'لا توجد ملاحظة')} · ${date(request.createdAt)} · ${request.receiptCount || 0} إيصال</div>
                                ${reviewedLine}
                                ${rejectBlock}
                            </div>
                            <div class="deposit-review-card-side">
                                <div class="deposit-value">${Number(request.amount).toLocaleString('en-US', { maximumFractionDigits: 2 })} EGP</div>
                                <span class="status ${tone}"><i class="fa-solid ${icon}"></i>${label}</span>
                            </div>
                        </header>
                        ${thumbs ? `<div class="deposit-thumbs">${thumbs}</div>` : ''}
                        ${reviewActions}
                    </article>
                `;
            }).join('');
        }

        async function loadRequests(options = {}) {
            try {
                const data = await readExecutorApiResponse(await executorApiFetch('/executor-portal/api/deposits'));
                requestsCache = Array.isArray(data.requests) ? data.requests : [];
                renderRequests(requestsCache);
                const hasPending = requestsCache.some((request) => request.status === 'pending');
                depositLiveBadge.classList.toggle('is-active', hasPending);
                depositLiveBadge.innerHTML = hasPending
                    ? '<i class="fa-solid fa-arrows-rotate fa-spin"></i> متابعة الطلبات قيد المراجعة'
                    : '<i class="fa-solid fa-signal"></i> تحديث تلقائي';
                if (refreshTimer) window.clearInterval(refreshTimer);
                refreshTimer = hasPending ? window.setInterval(() => loadRequests({ silent: true }), 20000) : null;
                if (!options.silent && hasPending) {
                    // no toast — silent background refresh only
                }
            } catch (error) {
                document.getElementById('depositList').innerHTML = `<div class="empty text-danger">${esc(error.message)}</div>`;
            }
        }

        document.getElementById('depositForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const amount = Number(amountInput.value);
            if (!selectedFiles.length) {
                await Swal.fire('إيصال مطلوب', 'أرفق صورة إيصال واحدة على الأقل قبل إرسال الطلب.', 'warning');
                return;
            }
            if (!Number.isFinite(amount) || amount <= 0) {
                await Swal.fire('قيمة غير صالحة', 'أدخل قيمة إيداع أكبر من صفر.', 'warning');
                return;
            }
            submitBtn.disabled = true;
            const form = event.currentTarget;
            try {
                const receiptsBase64 = await Promise.all(selectedFiles.map(toDataUrl));
                const response = await executorApiFetch('/executor-portal/api/deposits', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        amount: document.getElementById('depositAmount').value,
                        note: document.getElementById('depositNote').value,
                        receiptsBase64
                    })
                });
                if (response.status === 413) {
                    throw new Error('إجمالي الإيصالات كبير جداً. أرسل حتى 5 صور، وبحجم لا يتجاوز 5MB للصورة.');
                }
                const data = await readExecutorApiResponse(response);
                await Swal.fire({
                    icon: 'success',
                    title: 'تم إرسال الطلب',
                    html: `<p>رقم الطلب: <b dir="ltr">${esc(data.request.customId)}</b></p><p class="small text-muted mb-0">الحالة الآن: <b>قيد المراجعة</b>. سيتم تحديث القائمة تلقائياً عند قبول أو رفض الطلب.</p>`,
                    confirmButtonColor: '#0e9b86'
                });
                form.reset();
                amountInput.value = '';
                selectedFiles = [];
                drawPreview();
                await loadRequests();
            } catch (error) {
                Swal.fire('تعذر الإرسال', error.message, 'error');
            } finally {
                updateSubmitState();
            }
        });

        document.getElementById('depositList').addEventListener('click', async (event) => {
            const thumb = event.target.closest('[data-image-url]');
            if (thumb) {
                await Swal.fire({
                    imageUrl: thumb.dataset.imageUrl,
                    imageAlt: 'إيصال الإيداع',
                    showConfirmButton: false,
                    showCloseButton: true,
                    width: 'min(920px, 96vw)'
                });
                return;
            }
            if (event.target.closest('[data-scroll-form="1"]')) {
                document.getElementById('depositAmount').focus();
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }
            const reviewButton = event.target.closest('[data-admin-deposit-review]');
            if (reviewButton) {
                const decision = reviewButton.dataset.adminDepositReview;
                let reason = '';
                if (decision === 'reject') {
                    const result = await Swal.fire({ title: 'سبب إلغاء الإيداع', input: 'textarea', inputPlaceholder: 'اكتب سبباً واضحاً للإدارة...', showCancelButton: true, confirmButtonText: 'تأكيد الإلغاء', cancelButtonText: 'تراجع', inputValidator: value => value?.trim().length >= 3 ? undefined : 'سبب الإلغاء مطلوب.' });
                    if (!result.isConfirmed) return;
                    reason = result.value.trim();
                } else {
                    const result = await Swal.fire({ icon: 'warning', title: 'قبول الإيداع؟', text: 'سيضاف المبلغ إلى رصيد الشركة مرة واحدة فقط.', showCancelButton: true, confirmButtonText: 'قبول وإضافة الرصيد', cancelButtonText: 'تراجع', confirmButtonColor: '#0e9b86' });
                    if (!result.isConfirmed) return;
                }
                reviewButton.disabled = true;
                try {
                    const response = await executorApiFetch(`/executor-portal/api/deposits/${reviewButton.dataset.requestId}/review`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ decision, reason }) });
                    await readExecutorApiResponse(response);
                    await Swal.fire(decision === 'approve' ? 'تم القبول' : 'تم الإلغاء', decision === 'approve' ? 'تمت إضافة الرصيد إلى الشركة.' : 'تم إرسال قرار الإلغاء إلى الإدارة.', 'success');
                    await loadRequests();
                } catch (error) { Swal.fire('تعذر حفظ القرار', error.message, 'error'); }
            }
        });

        drawPreview();
        loadRequests();
        window.addEventListener('beforeunload', () => {
            if (refreshTimer) window.clearInterval(refreshTimer);
        });
    </script>
</body>
</html>
