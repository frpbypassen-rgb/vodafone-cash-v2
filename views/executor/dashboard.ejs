<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <title><%= activeTaskId ? 'العملية النشطة' : 'منصة التنفيذ' %> | الأهرام</title>
    
    <script src="/js/executor/dashboard/theme-init.js"></script>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>window.executorCsrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;</script>
    <script src="/js/executor-api.js"></script>
    
    <link rel="stylesheet" href="/css/executor/pages/dashboard.css">
    <link rel="stylesheet" href="/css/brand-ui.css?v=20260804-brand1">
    <link rel="stylesheet" href="/css/executor-workspace.css?v=20260921-task-card">
    <link rel="stylesheet" href="/css/executor-2030-override.css?v=20260825-balance1">
    <link rel="stylesheet" href="/css/executor-os.css?v=20260930-mobile-shell">
    <link rel="stylesheet" href="/css/executor-dashboard-mobile.css?v=20260930-active-task">
</head>
<body class="executor-os executor-portal-v2 executor-page-dashboard <%= emp.role === 'manager' ? 'executor-role-manager' : '' %> <%= activeTaskId ? 'executor-active-task' : '' %>">

<%- include('partials/navigation', { emp, activePage: 'tasks' }) %>
<div class="exo-stage">
    <%- include('partials/command-bar', { emp, companyBalances: typeof companyBalances === 'undefined' ? null : companyBalances }) %>
</div>

<div id="emergencyOverlay">
    <i class="fa-solid fa-radiation shake-icon"></i>
    <h1 class="text-white fw-900 mb-3 px-3" style="font-size: 2.5rem; text-shadow: 0 4px 10px rgba(0,0,0,0.5);">🚨 إنذار طارئ! 🚨</h1>
    <h4 id="emergencyMessage" class="text-white fw-bold mb-5 px-4" style="line-height: 1.8; max-width: 700px; text-shadow: 0 2px 5px rgba(0,0,0,0.5);">يوجد طلب متأخر يجب سحبه فوراً!</h4>
    <button onclick="dismissEmergency(event)" class="btn btn-light fw-900 px-5 py-4 fs-3 text-danger shadow-lg" style="border-radius: 50px; border: 4px solid white; transition: 0.2s;">
        <i class="fa-solid fa-volume-xmark me-3"></i> إيقـاف الإنـذار 🔇
    </button>
</div>

<script>
    const myExecutorId = '<%= emp._id %>';
    const activeTaskId = <%- JSON.stringify(activeTaskId || null) %>;
    const isExecutorManager = <%= emp.role === 'manager' ? 'true' : 'false' %>;
    const executorTaskTypeMeta = {
        vodafone: { name: 'تحويل محفظة كاش', short: 'كاش', icon: 'fa-mobile-screen-button' },
        post_account: { name: 'تحويل بريد حساب', short: 'بريد', icon: 'fa-envelope' },
        post_card: { name: 'تحويل بريد بطاقة', short: 'بطاقة', icon: 'fa-id-card' },
        bank_account: { name: 'تحويل بنكي', short: 'بنك', icon: 'fa-building-columns' },
        sefa_niger: { name: 'سيفا النيجر', short: 'سيفا', icon: 'fa-globe' },
        bankak_sudan: { name: 'بنكك السودان', short: 'بنكك', icon: 'fa-building' },
        bank_transfer: { name: 'تحويل بنكي', short: 'بنك', icon: 'fa-building-columns' }
    };
    const taskTypeMeta = (transferType) => executorTaskTypeMeta[String(transferType || '').trim().toLowerCase()]
        || { name: 'عملية تنفيذ', short: 'تنفيذ', icon: 'fa-bolt' };
    let executorManualPolicy = {
        proofRequired: <%= (typeof executionPolicy !== 'undefined' ? executionPolicy.proofRequired : emp.groupId?.manualProofRequired) ? 'true' : 'false' %>,
        quickExecuteEnabled: <%= (typeof executionPolicy !== 'undefined' ? executionPolicy.quickExecuteEnabled : emp.groupId?.manualQuickExecuteEnabled) ? 'true' : 'false' %>,
        allowedPhoneLengths: <%= JSON.stringify((typeof executionPolicy !== 'undefined' && Array.isArray(executionPolicy.allowedPhoneLengths)) ? executionPolicy.allowedPhoneLengths : (Array.isArray(emp.groupId?.manualAllowedPhoneLengths) ? emp.groupId.manualAllowedPhoneLengths : [3, 4, 11])) %>,
        splitRequiresFullPhone: <%= (typeof executionPolicy !== 'undefined' ? executionPolicy.splitRequiresFullPhone !== false : emp.groupId?.manualSplitRequiresFullPhone !== false) ? 'true' : 'false' %>
    };
    let executorQuickExecute = {
        enabled: executorManualPolicy.quickExecuteEnabled,
        network: 'vodafone',
        pinRequired: false,
        pinSet: false
    };
</script>

<nav class="navbar-glass">
    <div class="executor-info">
        <div class="executor-avatar"><i class="fa-solid fa-user-astronaut"></i></div>
        <div>
            <h4 class="executor-name"><%= emp.name %></h4>
            <span class="executor-role"><i class="fa-solid fa-network-wired me-1"></i> غرفة العمليات: <%= emp.groupId?.name || 'بدون غرفة' %></span>
        </div>
    </div>
    <div class="nav-actions">
        <% if (emp.role === 'manager') { %>
            <% const liveRows = Array.isArray(companyBalances?.byService) ? companyBalances.byService : []; %>
            <% if (companyBalances?.multiService && liveRows.length > 1) { %>
                <% liveRows.forEach((row) => { %>
                    <span class="nav-btn text-success border border-success border-opacity-25" style="cursor: default; font-weight: 800;" title="<%= row.appliesPoolModel ? row.totalLabel : row.singleLabel %>"><i class="fa-solid fa-wallet me-1"></i> <%= row.shortLabel %> <%= Number(row.appliesPoolModel ? row.totalBalance : row.privateBalance).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
                <% }); %>
            <% } else { %>
            <span class="nav-btn text-success border border-success border-opacity-25" style="cursor: default; font-weight: 800;" title="إجمالي الرصيد"><i class="fa-solid fa-vault me-1"></i> <%= Number(companyBalances?.totalBalance ?? emp.groupId?.balance ?? 0).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
            <span class="nav-btn text-warning border border-warning border-opacity-25" style="cursor: default; font-weight: 800;" title="الرصيد الخاص"><i class="fa-solid fa-wallet me-1"></i> <%= Number(companyBalances?.privateBalance ?? emp.groupId?.balance ?? 0).toLocaleString('en-US', { maximumFractionDigits: 0 }) %> ج.م</span>
            <% } %>
        <% } %>
        <button class="nav-btn btn-theme shadow-sm" onclick="toggleTheme()" title="المظهر"><i class="fa-solid fa-moon" id="themeIcon"></i></button>
        <a href="/executor-portal/logout" class="nav-btn btn-logout"><i class="fa-solid fa-power-off"></i></a>
    </div>
</nav>

<div class="container-fluid px-3 px-md-4 mt-2 mb-5">
    <div id="radarSection">
        <header class="executor-live-heading">
            <div>
                <h1><%= activeTaskId ? 'العملية النشطة' : 'غرفة التنفيذ' %></h1>
                <% if (activeTaskId) { %><p class="executor-focus-hint">تبقى هذه العملية أمامك حتى الإنهاء أو الإلغاء، ثم تعود قائمة المهام.</p><% } %>
                <% if (!activeTaskId) { %><p>تصل المهام الجديدة فورًا، ويظهر رقم المستلم كاملًا بعد قبول المهمة.</p><% } %>
            </div>
            <% if (!activeTaskId) { %><div class="d-flex align-items-center gap-2">
                <% if (emp.role === 'manager') { %>
                    <a href="/executor-portal/settings" class="nav-btn" title="إعدادات توزيع المهام"><i class="fa-solid fa-route"></i><span class="d-none d-md-inline"> التوجيه</span></a>
                <% } %>
                <span class="executor-live-status"><i></i> المراقبة نشطة</span>
            </div><% } %>
        </header>

        <div class="executor-task-layout">
            <section class="executor-task-stage">
                <div id="taskBoardStatus" class="executor-board-status" hidden role="alert"></div>
                <div id="tasksList" class="row g-3" aria-live="polite"><% if (activeTaskId) { %><div class="col-12 text-center py-4">جار فتح العملية النشطة...</div><% } %></div>
            </section>

            <aside class="executor-monitor-rail" aria-label="مراقبة غرفة العمليات">
                <section class="executor-monitor-panel">
                    <div>
                        <div class="executor-monitor-visual" role="img" aria-label="رادار مراقبة العمليات"><svg viewBox="0 0 72 72" width="128" height="128" aria-hidden="true" focusable="false"><circle cx="36" cy="36" r="26" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="36" cy="36" r="14" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="36" cy="36" r="4" fill="currentColor"/><path d="M36 36 52 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></div>
                        <strong>الرادار يعمل</strong>
                        <small>متصل بغرفة العمليات لحظة بلحظة</small>
                    </div>
                </section>
                <section class="executor-day-panel">
                    <h2>ملخص اليوم</h2>
                    <div class="executor-day-stat"><span>تم التنفيذ</span><strong id="monitorCompletedCount">0</strong></div>
                    <div class="executor-day-stat"><span>إجمالي القيمة</span><strong id="monitorCompletedAmount">0 ج.م</strong></div>
                    <div class="executor-day-stat"><span>قيد التنفيذ</span><strong id="monitorActiveCount" class="is-live">0</strong></div>
                </section>
            </aside>
        </div>
    </div>

    <!-- 👤 قسم حسابي -->
    <div id="profileSection" style="display: none;">
        <div class="row g-3 g-xl-4">
            <!-- كارت الملف الشخصي والتعريف -->
            <div class="col-12 col-lg-4">
                <div class="p-4" style="background: var(--glass-bg); backdrop-filter: blur(14px); border: 1px solid var(--glass-border); border-radius: 20px; box-shadow: var(--shadow-card); text-align: center;">
                    <div class="mx-auto mb-3" style="width: 80px; height: 80px; border-radius: 22px; background: linear-gradient(135deg, rgba(212,175,55,0.15), rgba(212,175,55,0.05)); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(212,175,55,0.25);">
                        <i class="fa-solid fa-user-astronaut fs-1 text-warning"></i>
                    </div>
                    <h4 class="fw-bold mb-1" style="color: var(--text-main);"><%= emp.name %></h4>
                    <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-1.5 rounded-pill mb-4" style="font-size: 0.8rem; border: 1px solid rgba(251,191,36,0.2);">
                        <%= emp.role === 'manager' ? 'مدير تنفيذي' : (emp.role === 'accountant' ? 'محاسب' : (emp.role === 'external' ? 'منفّذ خارجي' : 'موظف تنفيذ')) %>
                    </span>
                    
                    <div class="text-start border-top pt-3" style="border-top-style: dashed !important; border-color: var(--glass-border) !important; display: flex; flex-direction: column; gap: 12px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="fa-regular fa-envelope me-1"></i> اسم المستخدم:</span>
                            <span class="fw-bold" style="color: var(--text-main);"><%= emp.webUsername %></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="fa-solid fa-network-wired me-1"></i> غرفة العمليات:</span>
                            <span class="fw-bold" style="color: var(--text-main);"><%= emp.groupId?.name || 'بدون غرفة' %></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="fa-solid fa-phone me-1"></i> رقم الهاتف:</span>
                            <span class="fw-bold" style="color: var(--text-main); font-family: monospace;"><%= emp.phone || '---' %></span>
                        </div>
                        <% if (emp.telegramId) { %>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="fa-brands fa-telegram me-1"></i> معرف التليجرام:</span>
                            <span class="fw-bold" style="color: var(--text-main); font-family: monospace;"><%= emp.telegramId %></span>
                        </div>
                        <% } %>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><i class="fa-solid fa-circle-check me-1"></i> الحالة:</span>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 py-1 px-2.5">نشط</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- كارت إدارة العهدة والإحصائيات -->
            <div class="col-12 col-lg-8">


                <!-- إحصائيات اليوم -->
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-4 text-center" style="background: var(--glass-bg); backdrop-filter: blur(14px); border: 1px solid var(--glass-border); border-radius: 20px; box-shadow: var(--shadow-card); height: 100%;">
                            <div class="mb-2 text-success"><i class="fa-solid fa-check-double fs-1"></i></div>
                            <span class="text-muted small fw-bold">العمليات المنفذة اليوم</span>
                            <h2 id="completedCount" class="fw-bold mt-2 text-main m-0">0</h2>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-4 text-center" style="background: var(--glass-bg); backdrop-filter: blur(14px); border: 1px solid var(--glass-border); border-radius: 20px; box-shadow: var(--shadow-card); height: 100%;">
                            <div class="mb-2 text-primary"><i class="fa-solid fa-sack-dollar fs-1"></i></div>
                            <span class="text-muted small fw-bold">إجمالي المبالغ اليوم</span>
                            <h2 id="completedSum" class="fw-bold mt-2 text-success m-0" style="font-family: 'JetBrains Mono', monospace; font-size: 1.8rem;">0 <span class="fs-6 fw-normal text-muted">EGP</span></h2>
                        </div>
                    </div>
                </div>

                <!-- العمليات المنفذة اليوم -->
                <div class="p-4" style="background: var(--glass-bg); backdrop-filter: blur(14px); border: 1px solid var(--glass-border); border-radius: 20px; box-shadow: var(--shadow-card);">
                    <h5 class="fw-bold mb-3 text-main"><i class="fa-solid fa-clock-rotate-left text-muted me-1"></i> تفاصيل العمليات المنفذة اليوم</h5>
                    <div id="completedTasksList" style="max-height: 380px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-left: 5px;">
                        <!-- dynamic items -->
                        <div class="text-center text-muted py-4"><i class="fa-solid fa-satellite-dish fs-3 mb-2 opacity-50"></i><p class="m-0 small">لا يوجد عمليات منفذة اليوم بعد</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered px-2">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" style="color: var(--accent-green);"><i class="fa-solid fa-cloud-arrow-up me-2"></i> توثيق وإنهاء العملية</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="resetUploadModal()" style="filter: invert(0.5);"></button>
            </div>
            <div class="modal-body p-4">
                <div id="dropZone" class="drop-zone mb-3">
                    <i class="fa-solid fa-images fs-2 mb-2" style="color: var(--accent-green); filter: drop-shadow(0 0 10px rgba(16,185,129,0.3));"></i>
                    <h6 class="mb-1 fw-bold" id="proofRequirementTitle">إرفاق الصورة اختياري</h6>
                    <p class="text-muted small m-0" id="proofRequirementHint" style="font-size: 0.75rem;">يمكنك إرفاق صور متعددة، أو المتابعة لإنشاء إيصال نظام تلقائي</p>
                    <input type="file" id="proofInput" class="d-none" accept="image/*" multiple>
                </div>
                
                <div id="previewsGrid" class="row g-2 mb-3"></div>

                <div class="mb-3" id="splitOperationBlock">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="splitOperationToggle" onchange="toggleSplitOperationMode()">
                        <label class="form-check-label fw-bold" for="splitOperationToggle">تقسيم العملية على أكثر من رقم مرسل</label>
                    </div>
                    <small class="text-muted d-block mt-1" id="splitOperationHint">عند التفعيل، أدخل رقم الهاتف والمبلغ وصورة الإثبات لكل جزء حتى يساوي مجموع العملية.</small>
                </div>

                <div id="bankTransferCompletionNote" class="alert alert-info py-2 small fw-bold d-none" role="status">
                    تحويل بنكي: أرفق صورة الإثبات فقط. تُرسل الصورة نفسها للعميل، دون رقم هاتف ودون تقسيم.
                </div>

                <div id="singleSenderBlock" class="mb-4">
                    <label class="data-label mb-2"><i class="fa-solid fa-fingerprint me-1"></i> رقم التنفيذ / المرسل</label>
                    <input type="text" id="senderPhoneInput" class="form-control fw-bold text-center val-phone" placeholder="01108172258 أو 2258 أو 899" inputmode="numeric" maxlength="11" dir="ltr">
                    <div class="form-text text-muted">يظهر في الإيصال بصيغة مخفية، بينما رقم هاتف العميل يظهر كاملاً.</div>
                </div>

                <div id="splitSenderBlock" class="d-none mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="data-label m-0"><i class="fa-solid fa-layer-group me-1"></i> أرقام المرسلين والمبالغ</label>
                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="addSenderEntryRow()"><i class="fa-solid fa-plus"></i> إضافة رقم</button>
                    </div>
                    <div id="senderEntriesContainer" class="d-grid gap-3"></div>
                    <div class="mt-2 small fw-bold" id="splitAmountSummary">المجموع: 0 / 0 ج.م</div>
                </div>
                
                <button id="btnFinish" class="btn-cyber-main w-100 m-0">
                    <i class="fa-solid fa-check-double me-2"></i> تأكيد التنفيذ والإرسال <kbd class="ms-2 bg-dark bg-opacity-25 border-0 text-white px-2 py-1 rounded" style="font-size: 0.75rem; font-family: sans-serif;">Enter ↵</kbd>
                </button>
            </div>
        </div>
    </div>
</div>

<audio id="sirenSound" src="https://assets.mixkit.co/active_storage/sfx/991/991-preview.mp3" loop preload="none"></audio>
<audio id="alertSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="none"></audio>

<!-- شريط التنقل السفلي للهواتف (App-like Bottom Navigation) -->
<div class="bottom-nav-mobile d-md-none">
    <!-- حسابي (الملف الشخصي والمنجزات) -->
    <a href="#profile" onclick="switchSection('profile')" class="bottom-nav-item" id="nav-profile">
        <i class="fa-solid fa-circle-user"></i>
        <span>حسابي</span>
    </a>
    <!-- الرادار -->
    <a href="#radar" onclick="switchSection('radar')" class="bottom-nav-item active" id="nav-dash">
        <i class="fa-solid fa-satellite-dish"></i>
        <span>الرادار</span>
    </a>
    <!-- التقارير -->
    <a href="/executor-portal/reports" class="bottom-nav-item" id="nav-rep">
        <i class="fa-solid fa-chart-line"></i>
        <span>التقارير</span>
    </a>
    <% if (emp.role === 'manager') { %>
    <!-- الموظفين -->
    <a href="/executor-portal/employees" class="bottom-nav-item" id="nav-emp">
        <i class="fa-solid fa-users"></i>
        <span>الموظفين</span>
    </a>
    <% } %>
</div>

<script src="/js/executor-workspace.js?v=20260819-1"></script>
<script src="/js/executor/dashboard/navigation.js"></script>
<script src="/js/executor/dashboard/state.js"></script>
<script src="/js/executor/dashboard/proofs.js"></script>
<script src="/js/executor/dashboard/routing.js"></script>
<script src="/js/executor/dashboard/tasks.js"></script>
<script src="/js/executor/dashboard/timers.js"></script>
<script src="/js/executor/dashboard/quick-execute.js"></script>
<script src="/js/executor/dashboard/actions.js"></script>
<script src="/js/executor/dashboard/polling.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
