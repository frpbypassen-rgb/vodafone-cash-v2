<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>إعدادات المنظومة | الأهرام</title>
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <style>
        .settings-nav { background: var(--input-bg); border-radius: 16px; padding: 10px; border: 1px solid var(--border-glass); margin-bottom: 25px; overflow-x: auto; white-space: nowrap;}
        .settings-nav .nav-link { color: var(--text-muted); font-weight: 700; border-radius: 12px; padding: 12px 20px; transition: 0.3s; margin: 0 4px; font-size: 0.9rem;}
        .settings-nav .nav-link:hover { background: var(--card-bg); color: var(--text-main); }
        .settings-nav .nav-link.active { background: var(--brand-primary); color: white !important; box-shadow: 0 4px 15px rgba(0, 26, 77, 0.2); }
        [data-theme="dark"] .settings-nav .nav-link.active { background: var(--brand-gold); color: black !important; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .min-w-fit { min-width: fit-content; }
        .mono-num { font-family: 'JetBrains Mono', monospace; font-size: 1.2rem;}
        .company-rates-band { margin-top: 26px; padding: 26px; border-top: 1px solid var(--border-glass); }
        .company-rates-head { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 18px; }
        .company-rates-head h4 { margin: 0; font-weight: 900; color: var(--text-main); }
        .company-rates-head p { margin: 6px 0 0; color: var(--text-muted); font-size: .88rem; }
        .company-rate-search { width: min(340px, 100%); }
        .company-rate-list { display: grid; gap: 12px; }
        .company-rate-row { padding: 18px; border: 1px solid var(--border-glass); border-radius: 8px; background: var(--card-bg); }
        .company-rate-row-head { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(230px, .55fr) auto; gap: 14px; align-items: end; }
        .company-rate-identity strong { display: block; color: var(--text-main); font-size: 1rem; }
        .company-rate-identity span { display: block; color: var(--text-muted); font-size: .78rem; margin-top: 4px; }
        .company-rate-grid { display: grid; grid-template-columns: repeat(6, minmax(130px, 1fr)); gap: 10px; margin-top: 15px; }
        .company-rate-field { display: grid; gap: 6px; }
        .company-rate-field span { color: var(--text-muted); font-size: .76rem; font-weight: 800; }
        .company-rate-field small { color: var(--text-muted); font-size: .66rem; }
        .company-rate-field input:disabled { opacity: .65; cursor: not-allowed; }
        .rate-table { min-width: 720px; }
        .rate-service-name { display: flex; align-items: center; gap: 9px; }
        .rate-service-name small { display: block; margin-top: 3px; color: var(--text-muted); font-size: .68rem; font-weight: 700; }
        .linked-rate-input { background: rgba(14, 165, 233, .07) !important; color: var(--text-main) !important; cursor: default; }
        .auto-route-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .auto-route-row { display: grid; grid-template-columns: minmax(150px, .75fr) minmax(220px, 1.25fr); align-items: center; gap: 14px; padding: 14px; border: 1px solid var(--border-glass); border-radius: 8px; background: var(--card-bg); }
        .auto-route-service strong, .auto-route-service span { display: block; }
        .auto-route-service strong { color: var(--text-main); font-size: .88rem; }
        .auto-route-service span { margin-top: 3px; color: var(--text-muted); font-size: .7rem; }
        @media (max-width: 1100px) { .company-rate-grid { grid-template-columns: repeat(3, minmax(140px, 1fr)); } }
        @media (max-width: 767px) {
            .company-rates-band { padding: 20px 0; }
            .company-rates-head, .company-rate-row-head { display: grid; grid-template-columns: 1fr; align-items: stretch; }
            .company-rate-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .auto-route-grid { grid-template-columns: 1fr; }
            .auto-route-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<button class="mobile-nav-toggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<%- include('partials/sidebar', { activePage: 'settings' }) %>

<div class="main-content">
    <div class="container-fluid">
        <div class="admin-nav mb-4">
            <h3 class="fw-bold text-dark m-0"><i class="fa-solid fa-gears text-primary me-2"></i> لوحة تحكم الإعدادات الشاملة</h3>
        </div>

        <ul class="nav nav-pills settings-nav d-flex flex-nowrap hide-scrollbar">
            <li class="nav-item text-center min-w-fit"><a class="nav-link active text-nowrap" href="/settings"><i class="fa-solid fa-sliders me-1"></i> العامة والأسعار</a></li>
            <li class="nav-item text-center min-w-fit"><a class="nav-link text-nowrap" href="/settings/clients-web"><i class="fa-solid fa-globe me-1"></i> ويب العملاء</a></li>
            <li class="nav-item text-center min-w-fit"><a class="nav-link text-nowrap" href="/settings/executors-web"><i class="fa-solid fa-laptop-code me-1"></i> ويب المنفذين</a></li>
            <% if (typeof role !== 'undefined' && role === 'master') { %>
            <li class="nav-item text-center min-w-fit ms-auto"><a class="nav-link text-danger text-nowrap" href="/settings/users"><i class="fa-solid fa-user-shield me-1"></i> المديرين</a></li>
            <% } %>
        </ul>

        <div class="data-card p-4 border-start border-4 border-warning">
            <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-money-bills text-warning me-2"></i> الإعدادات العامة للأسعار والمنظومة</h5>
            <form action="/settings/update" method="POST">
                <div class="row g-4">
                    <div class="col-md-12">
                        <div class="p-4 rounded-4 border" style="background-color: var(--input-bg);">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
                                <h6 class="fw-bold text-success m-0"><i class="fa-solid fa-arrow-trend-up me-2"></i> مستويات أسعار الصرف</h6>
                                <span class="badge bg-info bg-opacity-10 text-info border border-info px-3 py-2">أسعار البريد والبنك تُحسب تلقائياً من فودافون</span>
                            </div>
                            <div class="table-responsive mb-4">
                                <table class="table rate-table align-middle text-center mb-0">
                                    <thead>
                                        <tr>
                                            <th class="text-start">الخدمة</th>
                                            <th>المستوى 1</th>
                                            <th>المستوى 2</th>
                                            <th>المستوى 3</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% (rateServices || []).forEach(service => { %>
                                            <tr>
                                                <% const linkedOffsets = { post_account: -0.05, post_card: -0.15, bank_account: -0.10 }; const linkedDelta = linkedOffsets[service.key]; %>
                                                <td class="text-start fw-bold">
                                                    <span class="rate-service-name">
                                                        <i class="fa-solid <%= service.key === 'vodafone' ? 'fa-mobile-screen-button text-danger' : service.key.startsWith('post_') ? 'fa-building-columns text-warning' : service.key === 'bank_account' ? 'fa-landmark text-info' : 'fa-money-bill-transfer text-success' %>"></i>
                                                        <span><%= service.label %><% if (service.rateDirection === 'source_to_lyd') { %><small><%= service.rateHint %></small><% } else if (linkedDelta !== undefined) { %><small>أقل من فودافون بمقدار <%= Math.abs(linkedDelta).toFixed(2) %></small><% } %></span>
                                                    </span>
                                                </td>
                                                <% ['level1', 'level2', 'level3'].forEach(level => {
                                                    const fieldName = service.fields[level];
                                                    const value = service.values[level];
                                                    const levelNumber = level.replace('level', '');
                                                %>
                                                    <td>
                                                        <input type="number" min="0.16" step="0.01" name="<%= fieldName %>" class="form-control fw-bold text-center text-primary mono-num <%= linkedDelta !== undefined ? 'linked-rate-input' : '' %>" value="<%= Number(value).toFixed(2) %>" data-rate-service="<%= service.key %>" data-rate-level="<%= levelNumber %>" <% if (linkedDelta !== undefined) { %>data-rate-delta="<%= linkedDelta %>" readonly<% } %> required>
                                                    </td>
                                                <% }) %>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <div class="row g-4 d-none">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">سعر الصرف المستوى 1</label>
                                    <div class="input-group">
                                        <span class="input-group-text border-end-0"><i class="fa-solid fa-coins text-muted"></i></span>
                                        <input type="number" step="any" name="rateLevel1" class="form-control fw-bold text-center text-primary mono-num border-start-0" value="<%= settings.rateLevel1 || 6.40 %>" required>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">سعر الصرف المستوى 2</label>
                                    <div class="input-group">
                                        <span class="input-group-text border-end-0"><i class="fa-solid fa-coins text-muted"></i></span>
                                        <input type="number" step="any" name="rateLevel2" class="form-control fw-bold text-center text-primary mono-num border-start-0" value="<%= settings.rateLevel2 || 6.45 %>" required>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">سعر الصرف المستوى 3</label>
                                    <div class="input-group">
                                        <span class="input-group-text border-end-0"><i class="fa-solid fa-coins text-muted"></i></span>
                                        <input type="number" step="any" name="rateLevel3" class="form-control fw-bold text-center text-primary mono-num border-start-0" value="<%= settings.rateLevel3 || 6.50 %>" required>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small"><i class="fa-solid fa-clock text-danger me-1"></i> توقيت الإغلاق التلقائي (التقفيل)</label>
                        <input type="time" name="closingTime" class="form-control text-center mono-num" value="<%= settings.closingTime || '23:59' %>" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small"><i class="fa-solid fa-headset text-info me-1"></i> حساب الدعم الفني (تليجرام)</label>
                        <input type="text" name="supportContact" class="form-control text-center mono-num" value="<%= settings.supportContact || '@AhramSupport' %>" dir="ltr" placeholder="@Username">
                    </div>

                    <div class="col-md-12 mt-4" id="auto-routing">
                        <div class="p-4 rounded-4 border" style="background-color: var(--input-bg);">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                                <div>
                                    <h6 class="fw-bold mb-1 text-primary"><i class="fa-solid fa-route me-2"></i> التوجيه التلقائي حسب الخدمة</h6>
                                    <div class="text-muted small">كل عملية جديدة تُرسل فقط إلى المنفذ المخصص لنوع خدمتها.</div>
                                </div>
                                <div class="form-check form-switch d-flex align-items-center gap-2">
                                    <input class="form-check-input ms-0" type="checkbox" name="autoRouteEnabled" value="true" id="autoRoute" style="width: 3.5rem; height: 1.8rem; cursor: pointer;" <%= settings.autoRouteEnabled ? 'checked' : '' %>>
                                    <label class="form-check-label fw-bold" for="autoRoute" style="cursor: pointer;">تشغيل التوجيه التلقائي</label>
                                </div>
                            </div>

                            <% if (query && query.autoRouteError) { %>
                                <div class="alert alert-danger fw-bold py-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>تعذر الحفظ لأن المنفذ المختار لا يعمل على الخدمة المحددة.</div>
                            <% } %>

                            <div class="auto-route-grid">
                                <% (autoRouteRows || []).forEach((row) => { %>
                                    <label class="auto-route-row">
                                        <span class="auto-route-service">
                                            <strong><%= row.label %></strong>
                                            <span><%= row.key === 'post_account' || row.key === 'post_card' ? 'يُعرض منفذ البريد فقط' : 'منفذ مخصص لهذه الخدمة فقط' %></span>
                                        </span>
                                        <select name="autoRouteExecutor_<%= row.key %>" class="form-select fw-bold">
                                            <option value="">بدون توجيه تلقائي</option>
                                            <% row.executors.forEach((bot) => { %>
                                                <option value="<%= bot._id %>" <%= row.selectedExecutorId && String(row.selectedExecutorId) === String(bot._id) ? 'selected' : '' %>><%= bot.name %><%= bot.isApiBot ? ' (API)' : '' %></option>
                                            <% }) %>
                                        </select>
                                    </label>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12 mt-4">
                        <div class="form-check form-switch p-4 rounded-4 d-flex align-items-center gap-3 border shadow-sm" style="background: <%= settings.isManualClosed ? 'rgba(239, 68, 68, 0.05)' : 'rgba(16, 185, 129, 0.05)' %>;">
                            <input class="form-check-input ms-0" type="checkbox" name="isManualClosed" value="true" id="manualClose" style="width: 3.5rem; height: 1.8rem; cursor: pointer;" <%= settings.isManualClosed ? 'checked' : '' %>>
                            <div class="ms-3">
                                <label class="form-check-label fw-bold fs-5 <%= settings.isManualClosed ? 'text-danger' : 'text-success' %>" for="manualClose" style="cursor: pointer;">تعليق وإغلاق النظام يدوياً للعملاء (صيانة/توقف)</label>
                                <div class="text-muted small mt-1">عند تفعيل هذا الخيار، لن يتمكن العملاء من تقديم طلبات تحويل جديدة حتى تقوم بإلغائه.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top text-end" style="border-color: var(--border-glass) !important;">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm rounded-pill"><i class="fa-solid fa-floppy-disk me-2"></i> حفظ الإعدادات</button>
                </div>
            </form>
        </div>

        <section class="data-card p-4 mt-4" id="whatsapp-integration" aria-labelledby="whatsappIntegrationTitle">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h5 id="whatsappIntegrationTitle" class="fw-bold mb-1 text-dark"><i class="fa-brands fa-whatsapp text-success me-2"></i>ربط WhatsApp عبر WhatChimp</h5>
                    <div class="text-muted small">حالة إرسال رموز التحقق وإيصالات العمليات للعملاء.</div>
                </div>
                <span class="badge <%= whatsAppStatus && whatsAppStatus.receiptOperational ? 'bg-success' : 'bg-danger' %> px-3 py-2">
                    <i class="fa-solid <%= whatsAppStatus && whatsAppStatus.receiptOperational ? 'fa-circle-check' : 'fa-circle-xmark' %> me-1"></i>
                    <%= whatsAppStatus && whatsAppStatus.receiptOperational ? 'إيصالات واتساب جاهزة' : 'إرسال الإيصالات متوقف' %>
                </span>
            </div>

            <% if (query && query.whatsAppTest === 'success') { %>
                <div class="alert alert-success py-2 mb-3"><i class="fa-solid fa-circle-check me-1"></i>تم الاتصال بحساب WhatChimp وقراءة القوالب بنجاح.</div>
            <% } else if (query && query.whatsAppTest === 'failed') { %>
                <div class="alert alert-danger py-2 mb-3"><i class="fa-solid fa-circle-xmark me-1"></i>تعذر الاتصال بـ WhatChimp. راجع بيانات الربط والقوالب.</div>
            <% } %>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border p-3 h-100">
                        <div class="small text-muted mb-1">بيانات حساب المنصة</div>
                        <strong class="<%= whatsAppStatus && whatsAppStatus.credentialsReady ? 'text-success' : 'text-danger' %>"><%= whatsAppStatus && whatsAppStatus.credentialsReady ? 'مكتملة' : 'مطلوبة' %></strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border p-3 h-100">
                        <div class="small text-muted mb-1">قالب رمز التحقق</div>
                        <strong class="<%= whatsAppStatus && whatsAppStatus.otpOperational ? 'text-success' : 'text-danger' %>"><%= whatsAppStatus && whatsAppStatus.otpOperational ? 'معتمد وجاهز' : `غير جاهز${whatsAppStatus?.otpTemplate?.status ? ` (${whatsAppStatus.otpTemplate.status})` : ''}` %></strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border p-3 h-100">
                        <div class="small text-muted mb-1">قالب الإيصال والرابط الموقّع</div>
                        <strong class="<%= whatsAppStatus && whatsAppStatus.receiptOperational ? 'text-success' : 'text-danger' %>"><%= whatsAppStatus && whatsAppStatus.receiptOperational ? 'معتمد وجاهز' : `غير جاهز${whatsAppStatus?.receiptTemplate?.status ? ` (${whatsAppStatus.receiptTemplate.status})` : ''}` %></strong>
                    </div>
                </div>
            </div>

            <% if (whatsAppStatus && whatsAppStatus.missing && whatsAppStatus.missing.length) { %>
                <div class="small text-muted mt-3">النواقص: <span class="mono-num"><%= whatsAppStatus.missing.join(' · ') %></span></div>
            <% } %>

            <form action="/settings/whatsapp/test" method="POST" class="mt-4">
                <button type="submit" class="btn btn-outline-success fw-bold"><i class="fa-solid fa-plug-circle-check me-1"></i> اختبار الاتصال</button>
                <a href="/whatsapp-monitor" class="btn btn-outline-primary fw-bold ms-2"><i class="fa-solid fa-list-check me-1"></i> مراقبة الرسائل</a>
            </form>
        </section>

        <section class="company-rates-band" id="company-rates" aria-labelledby="companyRatesTitle">
            <header class="company-rates-head">
                <div>
                    <h4 id="companyRatesTitle"><i class="fa-solid fa-building-circle-check text-primary me-2"></i>أسعار الشركات</h4>
                    <p>إدارة سعر كل خدمة للشركة وربطه بحركة السعر العام.</p>
                </div>
                <div class="company-rate-search input-group">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="search" id="companyRateSearch" class="form-control" placeholder="بحث باسم الشركة أو الهاتف">
                </div>
            </header>

            <% if (query && query.ratesScheduled) { %>
                <div class="alert alert-warning fw-bold"><i class="fa-solid fa-clock me-2"></i>تم إشعار الحسابات. ستُطبَّق أسعار الصرف الجديدة تلقائياً خلال 60 ثانية.</div>
            <% } else if (query && query.ratesUpdated) { %>
                <div class="alert alert-success fw-bold"><i class="fa-solid fa-circle-check me-2"></i>تم تحديث الأسعار العامة، وتم احتساب أسعار الشركات المرتبطة بها تلقائياً.</div>
            <% } %>

            <div class="company-rate-list" id="companyRateList">
                <% if (!(companyRateRows || []).length) { %>
                    <div class="text-center text-muted py-5"><i class="fa-solid fa-building-circle-xmark fs-2 d-block mb-3"></i>لا توجد شركات متاحة.</div>
                <% } %>
                <% (companyRateRows || []).forEach((row) => { const company = row.company; const rateConfig = row.rateConfig; %>
                    <form action="/company/<%= company._id %>/update-rate" method="POST" class="company-rate-row" data-company-rate-form data-company-search="<%= `${company.name || ''} ${company.phone || ''}`.toLowerCase() %>">
                        <div class="company-rate-row-head">
                            <div class="company-rate-identity">
                                <strong><%= company.name %></strong>
                                <span><%= company.phone || 'بدون هاتف' %> · المستوى <%= company.tier || 1 %> · <%= company.status === 'active' ? 'نشطة' : 'موقوفة' %></span>
                            </div>
                            <label>
                                <span class="form-label small fw-bold text-muted">سياسة التسعير</span>
                                <select name="rateMode" class="form-select fw-bold" data-company-rate-mode>
                                    <option value="general" <%= rateConfig.mode === 'general' ? 'selected' : '' %>>السعر العام التلقائي</option>
                                    <option value="custom" <%= rateConfig.mode === 'custom' ? 'selected' : '' %>>سعر خاص مرتبط بالعام</option>
                                </select>
                            </label>
                            <button type="submit" class="btn btn-primary fw-bold"><i class="fa-solid fa-floppy-disk me-1"></i>حفظ</button>
                        </div>
                        <div class="company-rate-grid">
                            <% rateServices.forEach((service) => { %>
                                <label class="company-rate-field">
                                    <span><%= service.label %></span>
                                    <input type="number" min="0.01" step="0.01" name="companyRate_<%= service.key %>" class="form-control text-center fw-bold mono-num" value="<%= Number(rateConfig.effectiveRates[service.key]).toFixed(2) %>" data-company-rate-input <%= rateConfig.mode === 'general' ? 'disabled' : '' %>>
                                    <small><%= service.rateDirection === 'source_to_lyd' ? '1 سيفا = ' : 'العام: ' %><b><%= Number(rateConfig.generalRates[service.key]).toFixed(2) %></b><%= service.rateDirection === 'source_to_lyd' ? ' د.ل' : '' %></small>
                                </label>
                            <% }) %>
                        </div>
                    </form>
                <% }) %>
            </div>
        </section>
    </div>
</div>

<script>
    function toggleSidebar() { document.querySelector('.sidebar').classList.toggle('active'); document.querySelector('.sidebar-overlay').classList.toggle('active'); }

    document.querySelectorAll('[data-rate-service="vodafone"]').forEach((cashInput) => {
        const updateLinkedRates = () => {
            const cashRate = Number(cashInput.value);
            if (!Number.isFinite(cashRate)) return;
            document.querySelectorAll(`[data-rate-level="${cashInput.dataset.rateLevel}"][data-rate-delta]`).forEach((linkedInput) => {
                linkedInput.value = (cashRate + Number(linkedInput.dataset.rateDelta)).toFixed(2);
            });
        };
        cashInput.addEventListener('input', updateLinkedRates);
        cashInput.addEventListener('change', updateLinkedRates);
    });

    document.querySelectorAll('[data-company-rate-form]').forEach((form) => {
        const mode = form.querySelector('[data-company-rate-mode]');
        const syncMode = () => form.querySelectorAll('[data-company-rate-input]').forEach((input) => {
            input.disabled = mode.value !== 'custom';
        });
        mode.addEventListener('change', syncMode);
        syncMode();
    });

    document.getElementById('companyRateSearch')?.addEventListener('input', (event) => {
        const query = event.target.value.trim().toLowerCase();
        document.querySelectorAll('[data-company-rate-form]').forEach((row) => {
            row.hidden = query && !row.dataset.companySearch.includes(query);
        });
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
