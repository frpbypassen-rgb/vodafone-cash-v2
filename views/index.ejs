        .hero{display:none}.reference-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin:20px 0 24px;padding:4px 0}.reference-heading{text-align:right}.reference-kicker{display:inline-flex;align-items:center;gap:8px;color:var(--dash-amber);font-size:.78rem;font-weight:900}.reference-heading h1{margin:9px 0 4px;color:var(--text-main);font-size:clamp(1.5rem,2.8vw,2.25rem);font-weight:900}.reference-heading p{margin:0;color:var(--text-muted);font-size:.84rem;font-weight:700}.reference-heading .updated-at{color:var(--text-muted);font-size:.7rem;margin-top:8px}.reference-controls{display:flex;align-items:center;gap:9px}.reference-select,.reference-date{height:42px;display:flex;align-items:center;gap:10px;padding:0 14px;border-radius:12px;border:1px solid var(--border-glass);background:var(--input-bg);color:var(--text-main);font-weight:800;font-size:.78rem}.reference-select{flex-direction:row-reverse}.reference-select i{color:var(--text-muted)}.reference-date input{border:0;background:transparent;color:var(--text-main);font:700 .78rem 'JetBrains Mono';width:115px}.reference-date input::-webkit-calendar-picker-indicator{filter:invert(.7)}.reference-kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-bottom:16px}.reference-operation-card{position:relative;padding:21px 22px 17px;border-radius:18px;background:linear-gradient(135deg,var(--card-bg),var(--input-bg));border:1px solid var(--reference-accent);box-shadow:var(--shadow-soft);overflow:hidden}.reference-operation-card:after{content:"";position:absolute;inset:auto -50px -90px auto;width:190px;height:190px;border-radius:50%;background:var(--reference-accent);opacity:.09}.reference-operation-card.cash{--reference-accent:#f59e0b}.reference-operation-card.bank{--reference-accent:#10b981}.reference-operation-head{display:flex;justify-content:space-between;align-items:flex-start;color:var(--text-muted);font-size:.78rem;font-weight:800}.reference-operation-head>div{display:flex;align-items:center;gap:10px}.reference-operation-head strong{font:800 1.55rem 'JetBrains Mono';color:var(--text-main)}.reference-operation-head>i{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:color-mix(in srgb,var(--reference-accent) 16%,transparent);color:var(--reference-accent);font-size:1.2rem}.reference-operation-amount{direction:ltr;text-align:right;color:var(--text-main);font:900 clamp(1.55rem,3vw,2.25rem) 'JetBrains Mono';margin:14px 0}.reference-operation-amount small{font:700 .85rem 'Tajawal';color:var(--text-muted)}.reference-operation-status{display:flex;gap:8px;flex-wrap:wrap;position:relative;z-index:1}.reference-operation-status span{display:inline-flex;align-items:center;gap:7px;padding:8px 11px;border-radius:10px;font-size:.72rem;font-weight:800}.status-completed{background:rgba(16,185,129,.13);color:#10b981}.status-pending{background:rgba(245,158,11,.13);color:#f59e0b}.reference-operation-card h2{position:absolute;right:22px;bottom:15px;margin:0;color:var(--text-main);font-size:.92rem;font-weight:900}.reference-panel{background:var(--card-bg);border:1px solid var(--border-glass);box-shadow:var(--shadow-soft);border-radius:19px;padding:18px;height:100%}.reference-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:15px}.reference-panel-head h2{margin:0 0 5px;color:var(--text-main);font-size:1rem;font-weight:900}.reference-panel-head h2 i{color:var(--dash-amber);margin-left:8px}.reference-panel-head p{margin:0;color:var(--text-muted);font-size:.72rem;font-weight:700}.reference-outline-btn{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid var(--border-glass);border-radius:9px;background:var(--input-bg);color:var(--text-muted);font-size:.7rem;font-weight:800;text-decoration:none;white-space:nowrap}.reference-outline-btn:hover{color:var(--dash-blue)}.reference-executors{margin-bottom:16px}.reference-two-col{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.8fr);gap:16px;margin-bottom:16px}.reference-bottom{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(300px,.8fr);gap:16px;margin-bottom:16px}.reference-chart .hourly-chart-wrap{height:260px}.reference-pending-list{font-size:.76rem}.reference-pending-list>div{display:grid;grid-template-columns:1fr .7fr .7fr;align-items:center;gap:10px;padding:13px 5px;border-bottom:1px solid var(--border-glass);color:var(--text-main)}.reference-pending-list>div:first-child{padding-top:2px;color:var(--text-muted);font-size:.68rem;font-weight:800}.reference-pending-list b{font-size:.76rem}.reference-pending-list strong{color:var(--text-muted);font-size:.68rem;font-weight:700}.pending-pill,.processing-pill,.completed-pill{justify-self:start;padding:4px 8px;border-radius:999px;font:800 .72rem 'JetBrains Mono'}.pending-pill{background:rgba(245,158,11,.14);color:#f59e0b}.processing-pill{background:rgba(6,182,212,.14);color:#06b6d4}.completed-pill{background:rgba(16,185,129,.14);color:#10b981}
        @media(max-width:900px){.reference-header{display:block}.reference-controls{margin-top:15px;flex-wrap:wrap}.reference-kpis{grid-template-columns:1fr}.reference-two-col,.reference-bottom{grid-template-columns:1fr}}
        @media(max-width:767px){.reference-header{margin-top:12px}.reference-controls>*{flex:1}.reference-date input{width:100%}.reference-operation-card{padding:17px}.reference-operation-card h2{right:17px;bottom:12px}.reference-operation-status{padding-bottom:22px}.reference-panel{padding:15px;border-radius:17px}.reference-panel-head{align-items:center}.reference-panel-head h2{font-size:.92rem}.reference-bottom .reference-chart{min-height:290px}.reference-chart .hourly-chart-wrap{height:220px}.reference-pending-list>div{grid-template-columns:1fr .65fr .65fr}}
