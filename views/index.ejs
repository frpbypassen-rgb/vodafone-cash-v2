        @media(max-width:1200px){.peak-list{grid-template-columns:repeat(2,1fr)}.report-controls{grid-template-columns:1fr 2fr}.report-summary{grid-template-columns:repeat(2,1fr)}}
        .overview-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:16px}.overview-card{position:relative;overflow:hidden;padding:20px;border-radius:22px;background:var(--card-bg);border:1px solid var(--border-glass);box-shadow:var(--shadow-soft)}.overview-card:after{content:"";position:absolute;width:170px;height:170px;border-radius:50%;right:-85px;bottom:-105px;background:var(--overview-accent,#2563eb);opacity:.1}.overview-card .overview-label{display:flex;justify-content:space-between;align-items:center;color:var(--text-muted);font-size:.82rem;font-weight:800}.overview-card .overview-label i{color:var(--overview-accent,#2563eb);font-size:1.15rem}.overview-card .overview-value{font:900 clamp(1.45rem,3vw,2.15rem) 'JetBrains Mono';color:var(--text-main);margin:17px 0 7px;direction:ltr;text-align:right}.overview-card .overview-meta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:var(--text-muted);font-size:.76rem;font-weight:700}.overview-card .overview-meta strong{color:var(--text-main);font-family:'JetBrains Mono'}.overview-card.cash{--overview-accent:#10b981}.overview-card.bank{--overview-accent:#3b82f6}.overview-card.total{--overview-accent:#f59e0b}.overview-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(320px,.9fr);gap:16px;margin-bottom:16px}.executor-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px}.executor-tile{padding:16px;border-radius:17px;background:var(--input-bg);border:1px solid var(--border-glass)}.executor-tile header{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:13px}.executor-tile header strong{font-size:.91rem;color:var(--text-main);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.executor-badge{padding:4px 8px;border-radius:999px;background:rgba(16,185,129,.13);color:#059669;font-size:.68rem;font-weight:900;white-space:nowrap}.executor-total{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:12px}.executor-total strong{font:800 1.2rem 'JetBrains Mono';color:var(--text-main)}.executor-total span{font-size:.72rem;color:var(--text-muted);font-weight:700}.executor-split{display:grid;grid-template-columns:1fr 1fr;gap:8px}.executor-channel{padding:10px;border-radius:12px;background:var(--card-bg);border:1px solid var(--border-glass)}.executor-channel span{display:block;font-size:.68rem;color:var(--text-muted);font-weight:800;margin-bottom:4px}.executor-channel strong{font:800 .82rem 'JetBrains Mono';color:var(--text-main);direction:ltr;display:block;text-align:right}.executor-channel small{display:block;color:var(--text-muted);font-size:.67rem;margin-top:3px}.deposit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.deposit-tile{padding:13px;border-radius:14px;background:var(--input-bg);border:1px solid var(--border-glass)}.deposit-tile span{display:block;color:var(--text-muted);font-size:.7rem;font-weight:800}.deposit-tile strong{display:block;margin-top:7px;color:var(--text-main);font:800 1rem 'JetBrains Mono';direction:ltr;text-align:right}.deposit-tile small{display:block;margin-top:3px;color:var(--text-muted);font-size:.66rem}.flow-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.flow-tile{padding:13px;border-radius:14px;background:var(--input-bg);border-right:3px solid var(--flow-color,#10b981)}.flow-tile span{display:block;font-size:.7rem;color:var(--text-muted);font-weight:800}.flow-tile strong{display:block;margin-top:6px;font:800 1rem 'JetBrains Mono';color:var(--text-main);direction:ltr;text-align:right}.flow-tile.in{--flow-color:#10b981}.flow-tile.out{--flow-color:#ef4444}.flow-tile.net{--flow-color:#2563eb}.flow-tile.profit{--flow-color:#f59e0b}.overview-note{display:flex;align-items:center;gap:8px;margin-top:12px;color:var(--text-muted);font-size:.73rem;font-weight:700}.overview-note i{color:var(--dash-blue)}.flow-currency-title{font-size:.74rem;font-weight:900;color:var(--text-main);padding:8px 10px;margin:2px 0 8px;border-right:3px solid #2563eb;background:rgba(37,99,235,.08);border-radius:8px}.flow-currency-title.egp-title{border-right-color:#f59e0b;margin-top:14px}.legacy-summary{display:none}.hourly-chart-wrap{height:235px;position:relative}
        @media(max-width:1100px){.overview-layout{grid-template-columns:1fr}.overview-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}}
