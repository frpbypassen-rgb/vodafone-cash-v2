        .smart-table{width:100%;border-collapse:separate;border-spacing:0 7px}.smart-table th{padding:0 12px 8px;color:var(--text-muted);font-size:.72rem;font-weight:800;white-space:nowrap}.smart-table td{padding:13px 12px;background:var(--input-bg);font-size:.8rem;color:var(--text-main);white-space:nowrap}.smart-table td:first-child{border-radius:0 13px 13px 0}.smart-table td:last-child{border-radius:13px 0 0 13px}.score{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--dash-green) calc(var(--score)*1%),rgba(148,163,184,.18) 0);position:relative;font:700 .68rem 'JetBrains Mono'}.score:before{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--input-bg)}.score span{position:relative}.mono{font-family:'JetBrains Mono'}
