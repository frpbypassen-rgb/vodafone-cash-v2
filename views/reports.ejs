<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>التقارير الشاملة - الأهرام باي</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
        }

        .main-content {
            margin-right: 260px;
            padding: 20px;
            transition: 0.3s;
        }

        @media (max-width: 991px) {
            .main-content {
                margin-right: 0;
                padding: 15px;
            }
        }

        .card-glass {
            background: var(--card-bg);
            border: 1px solid var(--border-glass);
            border-radius: 16px;
            box-shadow: var(--shadow-soft);
            padding: 20px;
            margin-bottom: 20px;
        }

        .form-select,
        .form-control {
            background-color: var(--input-bg);
            color: var(--text-main);
            border: 1px solid var(--border-glass);
            border-radius: 10px;
            padding: 10px;
        }

        .form-select:focus,
        .form-control:focus {
            background-color: var(--input-bg);
            color: var(--text-main);
            border-color: var(--brand-gold);
            box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.25);
        }

        .stat-card {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(212, 175, 55, 0.02));
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            color: var(--brand-gold);
        }

        .table-custom {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 12px;
        }

        .table-custom th {
            color: var(--text-muted);
            font-weight: 700;
            padding: 14px 16px;
            font-size: 0.85rem;
            border: none;
            text-align: center;
        }

        .table-custom tr {
            transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .table-custom td {
            background: var(--card-bg);
            border-top: 1px solid var(--border-glass);
            border-bottom: 1px solid var(--border-glass);
            padding: 16px 14px;
            vertical-align: middle;
            text-align: center;
            font-size: 0.9rem;
            color: var(--text-main);
            transition: background 0.25s, box-shadow 0.25s, border-color 0.25s;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        }

        [data-theme="dark"] .table-custom td {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        .table-custom tr td:first-child {
            border-right: 1px solid var(--border-glass);
            border-top-right-radius: 14px;
            border-bottom-right-radius: 14px;
        }

        .table-custom tr td:last-child {
            border-left: 1px solid var(--border-glass);
            border-top-left-radius: 14px;
            border-bottom-left-radius: 14px;
        }

        /* Hover */
        .table-custom tbody tr:hover {
            transform: translateY(-3px) scale(1.005);
        }

        .table-custom tbody tr:hover td {
            background: rgba(255, 255, 255, 0.98);
            border-color: rgba(14, 165, 233, 0.3);
            box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.06);
        }

        [data-theme="dark"] .table-custom tbody tr:hover td {
            background: rgba(30, 41, 59, 0.98);
            border-color: rgba(251, 191, 36, 0.3);
            box-shadow: 0 12px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 15px -6px rgba(0, 0, 0, 0.35);
        }

        .badge-st {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.78rem;
            font-weight: 700;
            line-height: 1;
        }

        .st-done {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        .st-fail {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        /* Indicator dots for badges */
        .indicator-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            margin-left: 6px;
            vertical-align: middle;
        }
        .dot-done {
            background-color: #10b981;
            box-shadow: 0 0 6px #10b981;
        }
        .dot-fail {
            background-color: #ef4444;
            box-shadow: 0 0 6px #ef4444;
        }
    </style>

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Al-Ahram">
    <!-- End PWA Setup -->
</head>

<body>
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>
    <%- include('partials/sidebar', { activePage: 'reports' }) %>

        <div class="main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold m-0" style="color: var(--brand-gold);"><i class="fa-solid fa-chart-line me-2"></i>
                    التقارير الشاملة والديناميكية</h4>
            </div>

            <!-- فلاتر التقرير -->
            <div class="card-glass">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label text-muted fw-bold">القسم الرئيسي</label>
                        <select id="mainCategory" class="form-select" onchange="updateSubCategory()">
                            <option value="">-- اختر القسم --</option>
                            <option value="direct_client">عميل مباشر</option>
                            <option value="company">شركة</option>
                            <option value="agent">وكيل</option>
                            <option value="executor">المنفذين</option>
                            <option value="api_executor">منفذ API</option>
                        </select>
                    </div>

                    <div class="col-md-3" id="subEntityCol" style="display:none;">
                        <label class="form-label text-muted fw-bold" id="subEntityLabel">الجهة</label>
                        <select id="subEntity" class="form-select" onchange="updateThirdCategory()">
                            <option value="">-- اختر --</option>
                        </select>
                    </div>

                    <div class="col-md-2" id="thirdCategoryCol" style="display:none;">
                        <label class="form-label text-muted fw-bold" id="thirdCategoryLabel">التقسيم الداخلي</label>
                        <select id="thirdCategory" class="form-select">
                            <option value="all">تقارير عامة (الكل)</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label text-muted fw-bold">الفترة الزمنية</label>
                        <select id="dateType" class="form-select" onchange="toggleDateInput()">
                            <option value="day">يوم محدد</option>
                            <option value="month">شهر محدد</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label text-muted fw-bold">&nbsp;</label>
                        <input type="date" id="dateValueDay" class="form-control">
                        <input type="month" id="dateValueMonth" class="form-control" style="display:none;">
                    </div>

                    <div class="col-md-12 mt-3 text-end">
                        <button class="btn btn-warning fw-bold px-4" onclick="fetchReport()"><i
                                class="fa-solid fa-search"></i> عرض التقرير</button>
                        <button id="btnDownloadPdf" class="btn btn-danger fw-bold px-4 ms-2 d-none"
                            onclick="generatePDF()"><i class="fa-solid fa-file-pdf"></i> تحميل تقرير PDF</button>
                    </div>
                </div>
            </div>

            <!-- الإحصائيات -->
            <div class="row g-3 mb-4 d-none" id="statsSection">
                <div class="col-md-3">
                    <div class="stat-card"
                        style="background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(59,130,246,0.02)); border-color: rgba(59,130,246,0.2);">
                        <h5 class="fw-bold mb-2 text-primary" id="statPrevBalance">0.00</h5>
                        <small class="text-primary fw-bold">الرصيد السابق</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card"
                        style="background: linear-gradient(135deg, rgba(239,68,68,0.1), rgba(239,68,68,0.02)); border-color: rgba(239,68,68,0.2);">
                        <h5 class="fw-bold mb-2 text-danger" id="statTotalOps">0.00</h5>
                        <small class="text-danger fw-bold">إجمالي عمليات اليوم</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card"
                        style="background: linear-gradient(135deg, rgba(16,185,129,0.1), rgba(16,185,129,0.02)); border-color: rgba(16,185,129,0.2);">
                        <h5 class="fw-bold mb-2 text-success" id="statTotalDeposits">0.00</h5>
                        <small class="text-success fw-bold">إجمالي إيداعات اليوم</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card"
                        style="background: linear-gradient(135deg, rgba(212,175,55,0.1), rgba(212,175,55,0.02)); border-color: rgba(212,175,55,0.2);">
                        <h5 class="fw-bold mb-2 text-warning" id="statEndingBalance">0.00</h5>
                        <small class="text-warning fw-bold">الرصيد الختامي</small>
                    </div>
                </div>
            </div>

            <!-- جدول العمليات -->
            <div class="card-glass d-none" id="tableSection">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-list text-muted me-1"></i> تفاصيل العمليات</h5>
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>رقم العملية</th>
                                <th>المبلغ</th>
                                <th>التكلفة</th>
                                <th>الحالة</th>
                                <th>التاريخ</th>
                                <th>المنفذ</th>
                            </tr>
                        </thead>
                        <tbody id="reportTableBody">
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- جدول الإيداعات -->
            <div class="card-glass d-none mt-4" id="depositsSection">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-money-bill-wave text-success me-1"></i> عمليات الإيداع
                    والتسوية</h5>
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>رقم العملية</th>
                                <th>القيمة (LYD)</th>
                                <th>الملاحظة</th>
                                <th>التاريخ</th>
                                <th>الحالة والمسؤول</th>
                            </tr>
                        </thead>
                        <tbody id="depositsTableBody">
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // حقن البيانات من الخادم
            const dbUsers = <%- JSON.stringify(users) %>;
            const dbCompanies = <%- JSON.stringify(companies) %>;
            const dbAgents = <%- JSON.stringify(agents) %>;
            const dbExecutors = <%- JSON.stringify(executors) %>;
            const dbApiExecutors = <%- JSON.stringify(apiExecutors) %>;
            const csrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;

            (function() {
                const originalFetch = window.fetch;
                window.fetch = function(url, options) {
                    options = options || {};
                    options.headers = options.headers || {};
                    const method = String(options.method || 'GET').toUpperCase();
                    if (csrfToken && !['GET', 'HEAD', 'OPTIONS'].includes(method)) {
                        if (options.headers instanceof Headers) {
                            options.headers.set('x-csrf-token', csrfToken);
                        } else {
                            options.headers['x-csrf-token'] = csrfToken;
                        }
                    }
                    return originalFetch.call(this, url, options);
                };
            })();

            // تهيئة التواريخ
            document.getElementById('dateValueDay').valueAsDate = new Date();
            const yyyyMM = new Date().toISOString().substring(0, 7);
            document.getElementById('dateValueMonth').value = yyyyMM;

            function toggleSidebar() {
                document.querySelector('.sidebar').classList.toggle('active');
                document.querySelector('.sidebar-overlay').classList.toggle('active');
            }

            function toggleDateInput() {
                const type = document.getElementById('dateType').value;
                if (type === 'day') {
                    document.getElementById('dateValueDay').style.display = 'block';
                    document.getElementById('dateValueMonth').style.display = 'none';
                } else {
                    document.getElementById('dateValueDay').style.display = 'none';
                    document.getElementById('dateValueMonth').style.display = 'block';
                }
            }

            function updateSubCategory() {
                const main = document.getElementById('mainCategory').value;
                const subCol = document.getElementById('subEntityCol');
                const subSel = document.getElementById('subEntity');
                const thirdCol = document.getElementById('thirdCategoryCol');

                subSel.innerHTML = '<option value="">-- اختر --</option>';
                thirdCol.style.display = 'none';

                if (!main) { subCol.style.display = 'none'; return; }
                subCol.style.display = 'block';

                let list = [];
                if (main === 'direct_client') { document.getElementById('subEntityLabel').innerText = 'اسم العميل المباشر'; list = dbUsers; }
                else if (main === 'company') { document.getElementById('subEntityLabel').innerText = 'اسم الشركة'; list = dbCompanies; }
                else if (main === 'agent') { document.getElementById('subEntityLabel').innerText = 'اسم الوكيل'; list = dbAgents; }
                else if (main === 'executor') { document.getElementById('subEntityLabel').innerText = 'مجموعة التنفيذ'; list = dbExecutors; }
                else if (main === 'api_executor') { document.getElementById('subEntityLabel').innerText = 'شركة API'; list = dbApiExecutors; }

                list.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item._id;
                    opt.textContent = item.name + (item.phone ? ' (' + item.phone + ')' : '');
                    subSel.appendChild(opt);
                });
            }

            function updateThirdCategory() {
                const main = document.getElementById('mainCategory').value;
                const subId = document.getElementById('subEntity').value;
                const thirdCol = document.getElementById('thirdCategoryCol');
                const thirdSel = document.getElementById('thirdCategory');

                thirdSel.innerHTML = '<option value="all">تقارير عامة (الكل)</option>';

                if (!subId) { thirdCol.style.display = 'none'; return; }

                let hasOptions = false;

                if (main === 'company') {
                    const comp = dbCompanies.find(c => c._id === subId);
                    if (comp && comp.employees && comp.employees.length > 0) {
                        comp.employees.forEach(emp => {
                            if (emp) thirdSel.innerHTML += `<option value="${emp}">موظف: ${emp}</option>`;
                        });
                        hasOptions = true;
                    }
                }
                else if (main === 'agent') {
                    const agent = dbAgents.find(a => a._id === subId);
                    if (agent && agent.subAccounts && agent.subAccounts.length > 0) {
                        agent.subAccounts.forEach(sub => {
                            thirdSel.innerHTML += `<option value="${sub._id}">عميل الوكيل: ${sub.name}</option>`;
                        });
                        hasOptions = true;
                    }
                }
                else if (main === 'executor') {
                    const exec = dbExecutors.find(e => e._id === subId);
                    if (exec && exec.employees && exec.employees.length > 0) {
                        exec.employees.forEach(emp => {
                            if (emp) thirdSel.innerHTML += `<option value="${emp}">منفذ: ${emp}</option>`;
                        });
                        hasOptions = true;
                    }
                }

                thirdCol.style.display = hasOptions ? 'block' : 'none';
            }

            let lastReportData = null;

            function cleanTxNotes(tx = {}) {
                const raw = String(tx.notes || '').trim();
                const beforeApiLog = raw.split(/---\s*سجل\s+الـ\s+API/i)[0].trim();
                const legacyTransfer = beforeApiLog.match(/(?:تحويل رصيد صادر إلى|تحويل رصيد وارد من).*\|\s*(.+)$/);
                const systemPatterns = [/^سبب الرفض:/, /^\[تم /, /^\[فشل /, /^\[معلقة /, /^\[رقم الإلغاء:/, /^تحويل رصيد صادر إلى/, /^تحويل رصيد وارد من/, /^تمويل نقطة بيع/, /^سحب رصيد من نقطة بيع/, /^\[طلب وارد عبر API/];
                const lines = legacyTransfer ? [legacyTransfer[1].trim()] : beforeApiLog.split(/\r?\n/).map(line => line.trim()).filter(Boolean).filter(line => {
                    if (/رقم المحول|رقم المرسل|الرقم المرجعي|مرجع|reference|ref/i.test(line)) return true;
                    return !systemPatterns.some(pattern => pattern.test(line));
                });
                if (tx.executorSenderPhone && !lines.some(line => line.includes(tx.executorSenderPhone))) lines.push(`[رقم المرسل: ${tx.executorSenderPhone}]`);
                return lines.filter(Boolean).join('\n').trim();
            }

            async function fetchReport() {
                const mainCategory = document.getElementById('mainCategory').value;
                const subId = document.getElementById('subEntity').value;
                const subType = document.getElementById('thirdCategory').value;
                const dateType = document.getElementById('dateType').value;
                const dateValue = dateType === 'day' ? document.getElementById('dateValueDay').value : document.getElementById('dateValueMonth').value;

                if (!mainCategory || !subId || !dateValue) {
                    return Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار القسم والجهة والتاريخ.' });
                }

                const btn = document.querySelector('button.btn-warning');
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري التحميل...';
                btn.disabled = true;

                try {
                    const res = await fetch('/api/reports/filter', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ mainCategory, subId, subType, dateType, dateValue })
                    });
                    const data = await res.json();

                    if (!data.success) throw new Error(data.error);

                    const curr = data.stats.isExecutor ? 'EGP' : 'LYD';

                    // Update Stats
                    document.getElementById('statPrevBalance').innerHTML = `${(data.stats.previousBalance).toFixed(2)} <span class="fs-6">${curr}</span>`;
                    const opsCost = data.stats.isExecutor ? data.stats.totalEGP : data.stats.totalLYD;
                    document.getElementById('statTotalOps').innerHTML = `${(opsCost).toFixed(2)} <span class="fs-6">${curr}</span>`;
                    document.getElementById('statTotalDeposits').innerHTML = `${(data.stats.totalDeposits).toFixed(2)} <span class="fs-6">${curr}</span>`;
                    document.getElementById('statEndingBalance').innerHTML = `${(data.stats.endingBalance).toFixed(2)} <span class="fs-6">${curr}</span>`;

                    lastReportData = data;
                    document.getElementById('statsSection').classList.remove('d-none');
                    document.getElementById('tableSection').classList.remove('d-none');
                    document.getElementById('depositsSection').classList.remove('d-none');
                    document.getElementById('btnDownloadPdf').classList.remove('d-none');

                    // ترتيب العمليات: الناجح أولاً، والملغي أخيراً
                    data.operations.sort((a, b) => {
                        if (a.status === 'completed' && b.status !== 'completed') return -1;
                        if (b.status === 'completed' && a.status !== 'completed') return 1;
                        const aFail = (a.status === 'rejected' || a.status === 'cancelled_by_admin');
                        const bFail = (b.status === 'rejected' || b.status === 'cancelled_by_admin');
                        if (aFail && !bFail) return 1;
                        if (bFail && !aFail) return -1;
                        return new Date(b.createdAt) - new Date(a.createdAt);
                    });

                    // Render Operations Table
                    const tbody = document.getElementById('reportTableBody');
                    tbody.innerHTML = '';
                    if (data.operations.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">لا توجد عمليات</td></tr>';
                    } else {
                        data.operations.forEach((tx, i) => {
                            let stHtml = '';
                            if (tx.status === 'completed') stHtml = '<span class="badge-st st-done"><span class="indicator-dot dot-done"></span>مكتمل</span>';
                            else if (tx.status === 'rejected' || tx.status === 'cancelled_by_admin') stHtml = '<span class="badge-st st-fail"><span class="indicator-dot dot-fail"></span>مرفوض</span>';
                            else stHtml = '<span class="badge-st bg-secondary text-white"><span class="indicator-dot bg-light"></span>' + tx.status + '</span>';

                            let by = tx.operatorName || tx.executorName || tx.employeeName || tx.subAccountName || '---';
                            if (by === 'بوت تنفيذ' && tx.executorGroupName) {
                                by = by + ' - ' + tx.executorGroupName;
                            }

                            const dateObj = new Date(tx.createdAt);
                            const dateStr = dateObj.toLocaleDateString('en-GB');
                            const timeStr = dateObj.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

                            tbody.innerHTML += `
                            <tr>
                                <td class="text-muted fw-bold">${i + 1}</td>
                                <td dir="ltr" class="fw-bold text-end">#${tx.customId || tx._id.toString().slice(-6)}</td>
                                <td class="fw-bold">${tx.amount} <small class="text-muted">EGP</small></td>
                                <td>
                                    <div class="fw-bold text-warning">${(tx.costLYD || 0).toFixed(2)} <small class="text-muted">LYD</small></div>
                                    <div style="font-size: 0.75rem; color: #94a3b8;">السعر: ${tx.exchangeRate || 0}</div>
                                </td>
                                <td>${stHtml}</td>
                                <td>
                                    <div dir="ltr" style="font-size:0.85em;" class="text-end">${dateStr}</div>
                                    <div dir="ltr" style="font-size:0.75rem; color: #94a3b8;" class="text-end">${timeStr}</div>
                                </td>
                                <td>${by}</td>
                            </tr>
                        `;
                        });
                    }

                    // Render Deposits Table
                    const dtbody = document.getElementById('depositsTableBody');
                    dtbody.innerHTML = '';
                    if (data.deposits.length === 0) {
                        dtbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">لا توجد إيداعات</td></tr>';
                    } else {
                        data.deposits.forEach((tx, i) => {
                            let stHtml = '';
                            if (tx.status === 'deposit') stHtml = '<span class="badge-st bg-success text-white"><span class="indicator-dot bg-light"></span>إيداع</span>';
                            else if (tx.status === 'deduction') stHtml = '<span class="badge-st bg-danger text-white"><span class="indicator-dot bg-light"></span>خصم</span>';
                            else stHtml = '<span class="badge-st bg-secondary text-white"><span class="indicator-dot bg-light"></span>' + tx.status + '</span>';

                            const dateObj = new Date(tx.createdAt);
                            const dateStr = dateObj.toLocaleDateString('en-GB');
                            const timeStr = dateObj.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

                            const adminName = tx.employeeName || 'الإدارة';
                            const visibleNotes = cleanTxNotes(tx) || '-';

                            dtbody.innerHTML += `
                            <tr>
                                <td class="text-muted fw-bold">${i + 1}</td>
                                <td dir="ltr" class="fw-bold text-end">#${tx.customId || tx._id.toString().slice(-6)}</td>
                                <td class="fw-bold" style="color: ${tx.status === 'deposit' ? '#10b981' : '#ef4444'};">${tx.amount}</td>
                                <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${visibleNotes}">${visibleNotes}</td>
                                <td>
                                    <div dir="ltr" style="font-size:0.85em;" class="text-end">${dateStr}</div>
                                    <div dir="ltr" style="font-size:0.75rem; color: #94a3b8;" class="text-end">${timeStr}</div>
                                </td>
                                <td>
                                    <div>${stHtml}</div>
                                    <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 4px;">بواسطة: ${adminName}</div>
                                </td>
                            </tr>
                        `;
                        });
                    }

                } catch (e) {
                    Swal.fire({ icon: 'error', title: 'خطأ', text: e.message || 'فشل جلب التقرير' });
                } finally {
                    btn.innerHTML = '<i class="fa-solid fa-search"></i> عرض التقرير';
                    btn.disabled = false;
                }
            }

            function generatePDF() {
                if (!lastReportData) return;

                const data = lastReportData;
                const ei = data.entityInfo || {};
                const generatedAt = new Date();
                const currency = data.stats.isExecutor ? 'EGP' : 'LYD';
                const operationsTotal = data.stats.isExecutor ? data.stats.totalEGP : data.stats.totalLYD;

                const escapePdf = (value) => String(value ?? '---')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');

                const compactPdf = (value, max = 62) => {
                    const text = String(value || '---').trim() || '---';
                    return text.length > max ? `${text.slice(0, max - 3)}...` : text;
                };

                const formatNumber = (value, digits = 2) => {
                    const parsed = Number(value || 0);
                    return Number.isFinite(parsed)
                        ? parsed.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits })
                        : '0.00';
                };

                const formatDate = (value) => {
                    const date = value ? new Date(value) : null;
                    return date && !Number.isNaN(date.getTime()) ? date.toLocaleDateString('en-GB') : '---';
                };

                const formatTime = (value) => {
                    const date = value ? new Date(value) : null;
                    return date && !Number.isNaN(date.getTime())
                        ? date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true })
                        : '---';
                };

                const statusMeta = (status) => {
                    if (status === 'completed' || status === 'deposit') {
                        return { text: status === 'deposit' ? 'إيداع' : 'ناجحة', className: 'status-success' };
                    }
                    if (status === 'deduction') return { text: 'خصم', className: 'status-danger' };
                    if (status === 'rejected' || status === 'cancelled_by_admin') return { text: 'ملغية', className: 'status-danger' };
                    if (status === 'deposit_pending') return { text: 'قيد المراجعة', className: 'status-warning' };
                    return { text: status || 'قيد التنفيذ', className: 'status-neutral' };
                };

                const infoCell = (label, value, ltr = false) => `
                    <div class="info-cell">
                        <span>${escapePdf(label)}</span>
                        <strong ${ltr ? 'dir="ltr"' : ''}>${escapePdf(value || '---')}</strong>
                    </div>
                `;

                const metricCard = (label, value, tone, unit = currency) => `
                    <div class="metric-card ${tone}">
                        <span>${escapePdf(label)}</span>
                        <strong dir="ltr">${escapePdf(formatNumber(value))}</strong>
                        <small>${escapePdf(unit)}</small>
                    </div>
                `;

                const emptyRow = (colspan, label) => `
                    <tr>
                        <td colspan="${colspan}" class="empty-row">${escapePdf(label)}</td>
                    </tr>
                `;

                const operationRows = [...(data.operations || [])]
                    .sort((a, b) => {
                        const cancelledA = ['rejected', 'cancelled_by_admin'].includes(a.status) ? 1 : 0;
                        const cancelledB = ['rejected', 'cancelled_by_admin'].includes(b.status) ? 1 : 0;
                        if (cancelledA !== cancelledB) return cancelledA - cancelledB;
                        return new Date(b.createdAt) - new Date(a.createdAt);
                    })
                    .map((tx, index) => {
                        const status = statusMeta(tx.status);
                        let by = tx.operatorName || tx.executorName || tx.employeeName || 'الإدارة';
                        if (by === 'بوت تنفيذ' && tx.executorGroupName) by = `${by} - ${tx.executorGroupName}`;
                        return `
                            <tr>
                                <td>${index + 1}</td>
                                <td dir="ltr" class="mono">${escapePdf(tx.customId || tx._id?.toString?.().slice(-6) || '---')}</td>
                                <td dir="ltr" class="amount-cell">${escapePdf(formatNumber(tx.amount))} EGP</td>
                                <td dir="ltr">${escapePdf(tx.exchangeRate || '-')}</td>
                                <td dir="ltr" class="amount-cell">${escapePdf(formatNumber(tx.costLYD || 0))} LYD</td>
                                <td>${escapePdf(compactPdf(by, 34))}</td>
                                <td dir="ltr">
                                    <strong>${escapePdf(formatDate(tx.createdAt))}</strong>
                                    <small>${escapePdf(formatTime(tx.createdAt))}</small>
                                </td>
                                <td><span class="status-pill ${status.className}">${escapePdf(status.text)}</span></td>
                            </tr>
                        `;
                    }).join('') || emptyRow(8, 'لا توجد عمليات في الفترة المحددة');

                const depositRows = [...(data.deposits || [])].map((tx, index) => {
                    const status = statusMeta(tx.status);
                    const visibleNotes = cleanTxNotes(tx) || '-';
                    return `
                        <tr>
                            <td>${index + 1}</td>
                            <td dir="ltr" class="mono">${escapePdf(tx.customId || tx._id?.toString?.().slice(-6) || '---')}</td>
                            <td dir="ltr" class="amount-cell">${escapePdf(formatNumber(tx.amount))} LYD</td>
                            <td>${escapePdf(compactPdf(visibleNotes, 50))}</td>
                            <td>${escapePdf(compactPdf(tx.employeeName || 'الإدارة', 30))}</td>
                            <td dir="ltr">
                                <strong>${escapePdf(formatDate(tx.createdAt))}</strong>
                                <small>${escapePdf(formatTime(tx.createdAt))}</small>
                            </td>
                            <td><span class="status-pill ${status.className}">${escapePdf(status.text)}</span></td>
                        </tr>
                    `;
                }).join('') || emptyRow(7, 'لا توجد إيداعات أو تسويات في الفترة المحددة');

                const html = `
                    <div class="pdf-report" dir="rtl">
                        <style>
                            .pdf-report {
                                width: 780px;
                                min-height: 1100px;
                                box-sizing: border-box;
                                padding: 26px;
                                font-family: 'Cairo', Tahoma, Arial, sans-serif;
                                color: #101828;
                                background:
                                    radial-gradient(circle at 8% 4%, rgba(245, 184, 61, 0.16), transparent 26%),
                                    linear-gradient(145deg, #f8fcff 0%, #edf8fb 100%);
                            }
                            .pdf-cover {
                                position: relative;
                                overflow: hidden;
                                border-radius: 24px;
                                padding: 28px 30px;
                                color: #fff;
                                background: linear-gradient(135deg, #101828 0%, #14546a 58%, #00a6a6 100%);
                                box-shadow: 0 18px 34px rgba(16, 24, 40, 0.18);
                                page-break-inside: avoid;
                            }
                            .pdf-cover:before {
                                content: '';
                                position: absolute;
                                left: -70px;
                                bottom: -96px;
                                width: 240px;
                                height: 240px;
                                border-radius: 50%;
                                background: rgba(245, 184, 61, 0.18);
                            }
                            .brand-row {
                                position: relative;
                                display: flex;
                                align-items: center;
                                justify-content: space-between;
                                gap: 18px;
                                z-index: 1;
                            }
                            .brand-copy h1 {
                                margin: 0;
                                font-size: 30px;
                                line-height: 1.35;
                                font-weight: 900;
                            }
                            .brand-copy p {
                                margin: 8px 0 0;
                                color: #d8fffb;
                                font-size: 14px;
                                font-weight: 800;
                            }
                            .brand-mark {
                                width: 74px;
                                height: 74px;
                                border-radius: 24px;
                                background: rgba(255,255,255,0.13);
                                display: grid;
                                place-items: center;
                                box-shadow: inset 0 1px 0 rgba(255,255,255,0.2);
                            }
                            .brand-mark span {
                                width: 44px;
                                height: 44px;
                                border-radius: 50%;
                                display: grid;
                                place-items: center;
                                background: #f5b83d;
                                color: #101828;
                                font-size: 34px;
                                font-weight: 900;
                                line-height: 1;
                            }
                            .cover-meta {
                                position: relative;
                                z-index: 1;
                                display: flex;
                                justify-content: space-between;
                                margin-top: 22px;
                                padding-top: 18px;
                                border-top: 1px solid rgba(255,255,255,0.22);
                                font-size: 12px;
                                font-weight: 800;
                                color: #e8fffb;
                            }
                            .section-card {
                                margin-top: 18px;
                                padding: 20px;
                                border: 1px solid #d9e4ea;
                                border-radius: 22px;
                                background: rgba(255,255,255,0.94);
                                box-shadow: 0 12px 24px rgba(16,24,40,0.08);
                                page-break-inside: avoid;
                            }
                            .section-title {
                                display: flex;
                                align-items: center;
                                justify-content: space-between;
                                margin: 0 0 14px;
                                padding-bottom: 10px;
                                border-bottom: 1px solid #d9e4ea;
                                color: #101828;
                                font-size: 18px;
                                font-weight: 900;
                            }
                            .section-title span {
                                color: #00a6a6;
                                font-size: 12px;
                                font-weight: 900;
                            }
                            .info-grid {
                                display: grid;
                                grid-template-columns: repeat(2, 1fr);
                                gap: 12px;
                            }
                            .info-cell {
                                padding: 13px 15px;
                                border: 1px solid #e3edf2;
                                border-radius: 16px;
                                background: linear-gradient(145deg, #ffffff, #f5fbfd);
                            }
                            .info-cell span,
                            .metric-card span {
                                display: block;
                                color: #667085;
                                font-size: 11px;
                                font-weight: 800;
                                margin-bottom: 5px;
                            }
                            .info-cell strong {
                                display: block;
                                color: #101828;
                                font-size: 15px;
                                font-weight: 900;
                                overflow-wrap: anywhere;
                            }
                            .metric-grid {
                                display: grid;
                                grid-template-columns: repeat(4, 1fr);
                                gap: 12px;
                                margin-top: 18px;
                                page-break-inside: avoid;
                            }
                            .metric-card {
                                padding: 16px 12px;
                                border-radius: 18px;
                                border: 1px solid #d9e4ea;
                                background: #fff;
                                text-align: center;
                                box-shadow: 0 10px 18px rgba(16,24,40,0.07);
                            }
                            .metric-card strong {
                                display: block;
                                color: #101828;
                                font-size: 19px;
                                line-height: 1.25;
                                font-weight: 900;
                            }
                            .metric-card small {
                                display: block;
                                margin-top: 2px;
                                color: #667085;
                                font-size: 10px;
                                font-weight: 900;
                            }
                            .metric-card.teal { border-color: #bdebe4; background: linear-gradient(145deg, #ffffff, #ecfffb); }
                            .metric-card.gold { border-color: #f5d18b; background: linear-gradient(145deg, #ffffff, #fff8e6); }
                            .metric-card.red { border-color: #ffd0cc; background: linear-gradient(145deg, #ffffff, #fff4f2); }
                            .metric-card.navy { background: linear-gradient(135deg, #101828, #14546a); border-color: #101828; }
                            .metric-card.navy span,
                            .metric-card.navy strong,
                            .metric-card.navy small { color: #fff; }
                            .report-table-wrap {
                                margin-top: 18px;
                                border: 1px solid #d9e4ea;
                                border-radius: 18px;
                                overflow: hidden;
                                background: #fff;
                            }
                            .report-table {
                                width: 100%;
                                border-collapse: collapse;
                                font-size: 11px;
                                text-align: center;
                            }
                            .report-table th {
                                padding: 11px 8px;
                                background: #101828;
                                color: #ffffff;
                                font-weight: 900;
                                white-space: nowrap;
                            }
                            .report-table td {
                                padding: 10px 8px;
                                border-bottom: 1px solid #e6edf2;
                                color: #101828;
                                font-weight: 800;
                                vertical-align: middle;
                                page-break-inside: avoid;
                            }
                            .report-table tbody tr:nth-child(even) td { background: #f7fbfd; }
                            .report-table small {
                                display: block;
                                margin-top: 2px;
                                color: #667085;
                                font-size: 10px;
                            }
                            .mono {
                                font-family: Consolas, 'Courier New', monospace;
                                font-weight: 900;
                            }
                            .amount-cell {
                                color: #00a6a6;
                                font-weight: 900;
                                white-space: nowrap;
                            }
                            .status-pill {
                                display: inline-block;
                                min-width: 58px;
                                padding: 5px 9px;
                                border-radius: 999px;
                                font-size: 10px;
                                line-height: 1;
                                font-weight: 900;
                                white-space: nowrap;
                            }
                            .status-success { color: #067647; background: #d1fadf; }
                            .status-danger { color: #b42318; background: #fee4e2; }
                            .status-warning { color: #93370d; background: #fef0c7; }
                            .status-neutral { color: #344054; background: #eaecf0; }
                            .empty-row {
                                padding: 22px !important;
                                color: #667085 !important;
                                background: #fff !important;
                                font-size: 13px;
                            }
                            .pdf-footer {
                                margin-top: 18px;
                                padding-top: 14px;
                                border-top: 1px solid #d9e4ea;
                                display: flex;
                                justify-content: space-between;
                                color: #667085;
                                font-size: 11px;
                                font-weight: 800;
                            }
                        </style>

                        <section class="pdf-cover">
                            <div class="brand-row">
                                <div class="brand-copy">
                                    <h1>تقرير الحساب الشامل</h1>
                                    <p>Power Pay AL-Ahram - منظومة مالية موحدة لإدارة الحركات والتحويلات</p>
                                </div>
                                <div class="brand-mark"><span>+</span></div>
                            </div>
                            <div class="cover-meta">
                                <div>تاريخ الإصدار: <span dir="ltr">${escapePdf(formatDate(generatedAt))}</span></div>
                                <div>وقت الإصدار: <span dir="ltr">${escapePdf(formatTime(generatedAt))}</span></div>
                                <div>عملة التقرير: ${escapePdf(currency)}</div>
                            </div>
                        </section>

                        <section class="section-card">
                            <h2 class="section-title">بيانات الحساب <span>ACCOUNT PROFILE</span></h2>
                            <div class="info-grid">
                                ${infoCell('اسم الحساب', ei.name)}
                                ${infoCell('رقم الهاتف', ei.phone, true)}
                                ${infoCell('اسم المستخدم', ei.username)}
                                ${infoCell('تاريخ الانضمام', ei.joinDate ? formatDate(ei.joinDate) : '---', true)}
                                ${infoCell('التصنيف', ei.status)}
                                ${infoCell('عدد العمليات', data.stats.totalCount || 0, true)}
                            </div>
                        </section>

                        <section class="metric-grid">
                            ${metricCard('الرصيد السابق', data.stats.previousBalance, 'teal')}
                            ${metricCard('إجمالي العمليات', operationsTotal, 'red')}
                            ${metricCard('إجمالي الإيداعات', data.stats.totalDeposits, 'gold')}
                            ${metricCard('الرصيد الختامي', data.stats.endingBalance, 'navy')}
                        </section>

                        <section class="section-card">
                            <h2 class="section-title">كشف العمليات <span>TRANSFERS LEDGER</span></h2>
                            <div class="report-table-wrap">
                                <table class="report-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>رقم العملية</th>
                                            <th>المبلغ</th>
                                            <th>السعر</th>
                                            <th>القيمة</th>
                                            <th>بواسطة</th>
                                            <th>التاريخ</th>
                                            <th>الحالة</th>
                                        </tr>
                                    </thead>
                                    <tbody>${operationRows}</tbody>
                                </table>
                            </div>
                        </section>

                        <section class="section-card">
                            <h2 class="section-title">الإيداعات والتسويات <span>ACCOUNT MOVEMENTS</span></h2>
                            <div class="report-table-wrap">
                                <table class="report-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>رقم الحركة</th>
                                            <th>القيمة</th>
                                            <th>الملاحظة</th>
                                            <th>بواسطة</th>
                                            <th>التاريخ</th>
                                            <th>الحالة</th>
                                        </tr>
                                    </thead>
                                    <tbody>${depositRows}</tbody>
                                </table>
                            </div>
                        </section>

                        <footer class="pdf-footer">
                            <span>Power Pay AL-Ahram</span>
                            <span>تم إصدار هذا التقرير إلكترونيا من لوحة الإدارة</span>
                            <span dir="ltr">${escapePdf(formatDate(generatedAt))}</span>
                        </footer>
                    </div>
                `;

                const opt = {
                    margin: 6,
                    filename: 'تقرير_حساب_الاهرام_باي.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true, letterRendering: true, backgroundColor: '#f8fcff' },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                    pagebreak: { mode: ['avoid-all', 'css', 'legacy'], avoid: ['tr', '.section-card', '.metric-grid'] }
                };

                const container = document.createElement('div');
                container.innerHTML = html;
                html2pdf().set(opt).from(container).save();
            }
        </script>
</body>

</html>
