<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>التقارير المالية - Power Pay AL-Ahram</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg-body); color: var(--text-main); font-family: "Cairo", sans-serif; }
        button, input, select { font: inherit; }
        .main-content { margin-right: 260px; min-height: 100vh; padding: 24px; transition: margin .2s ease; }
        .report-page { width: min(100%, 1600px); margin: 0 auto; }
        .page-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
        .page-title { display: flex; align-items: center; gap: 11px; }
        .page-title-icon { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid var(--border-glass); border-radius: 8px; color: var(--brand-gold); background: var(--card-bg); }
        .page-title h1 { margin: 0; font-size: 1.3rem; font-weight: 800; }
        .page-title p { margin: 2px 0 0; color: var(--text-muted); font-size: .78rem; }
        .mobile-menu { display: none; width: 40px; height: 40px; border: 1px solid var(--border-glass); border-radius: 8px; color: var(--text-main); background: var(--card-bg); }
        .report-panel { margin-bottom: 16px; padding: 18px; border: 1px solid var(--border-glass); border-radius: 8px; background: var(--card-bg); box-shadow: var(--shadow-soft); }
        .filter-grid { display: grid; grid-template-columns: 1.2fr 1.4fr 1.2fr .8fr 1fr auto; gap: 12px; align-items: end; }
        .field { min-width: 0; }
        .field[hidden] { display: none; }
        .field label { display: block; margin-bottom: 6px; color: var(--text-muted); font-size: .74rem; font-weight: 700; }
        .form-control, .form-select { min-height: 43px; border: 1px solid var(--border-glass); border-radius: 6px; background: var(--input-bg); color: var(--text-main); font-size: .84rem; }
        .form-control:focus, .form-select:focus { border-color: var(--brand-gold); background: var(--input-bg); color: var(--text-main); box-shadow: 0 0 0 3px rgba(212,175,55,.13); }
        .filter-actions { display: flex; gap: 8px; }
        .command { min-height: 43px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 15px; border: 1px solid transparent; border-radius: 6px; font-size: .82rem; font-weight: 800; white-space: nowrap; }
        .command.primary { color: #17130a; background: var(--brand-gold); }
        .command.pdf { color: #fff; background: #b4232f; }
        .command:disabled { cursor: wait; opacity: .65; }
        .report-state { display: none; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; padding: 11px 13px; border: 1px solid #578d78; border-radius: 6px; background: rgba(16,185,129,.08); }
        .report-state.visible { display: flex; }
        .report-state.warning { border-color: #b48628; background: rgba(245,158,11,.1); }
        .report-state strong { display: block; font-size: .82rem; }
        .report-state span { color: var(--text-muted); font-size: .72rem; }
        .metrics { display: grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap: 10px; margin-bottom: 16px; }
        .metric { min-height: 110px; padding: 15px; border: 1px solid var(--border-glass); border-top: 3px solid #64748b; border-radius: 8px; background: var(--card-bg); }
        .metric i { color: #64748b; }
        .metric span { display: block; margin-top: 9px; color: var(--text-muted); font-size: .7rem; font-weight: 700; }
        .metric strong { display: block; margin-top: 3px; font: 800 1.15rem/1.3 Consolas, monospace; direction: ltr; text-align: right; }
        .metric small { display: block; margin-top: 4px; color: var(--text-muted); font-size: .64rem; }
        .metric.success { border-top-color: #16805d; } .metric.success i { color: #16805d; }
        .metric.danger { border-top-color: #bd3944; } .metric.danger i { color: #bd3944; }
        .metric.gold { border-top-color: #b48628; } .metric.gold i { color: #b48628; }
        .metric.closing { border-color: #24303c; background: #18212b; color: #fff; }
        .metric.closing span, .metric.closing small { color: #b9c1c9; }
        .report-section { margin-bottom: 16px; border: 1px solid var(--border-glass); border-radius: 8px; background: var(--card-bg); overflow: hidden; }
        .section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--border-glass); }
        .section-head h2 { margin: 0; font-size: .95rem; font-weight: 800; }
        .section-head p { margin: 3px 0 0; color: var(--text-muted); font-size: .68rem; }
        .section-count { padding: 4px 8px; border: 1px solid var(--border-glass); border-radius: 5px; color: var(--text-muted); font: 700 .68rem Consolas, monospace; white-space: nowrap; }
        .table-wrap { width: 100%; overflow-x: auto; }
        .report-table { width: 100%; min-width: 920px; border-collapse: collapse; }
        .report-table th { padding: 10px 9px; color: var(--text-muted); background: rgba(127,127,127,.045); border-bottom: 1px solid var(--border-glass); font-size: .68rem; font-weight: 800; text-align: center; white-space: nowrap; }
        .report-table td { padding: 10px 9px; border-bottom: 1px solid var(--border-glass); color: var(--text-main); font-size: .73rem; text-align: center; vertical-align: middle; }
        .report-table tbody tr:last-child td { border-bottom: 0; }
        .report-table tbody tr:hover td { background: rgba(127,127,127,.045); }
        .report-table td.note { max-width: 280px; text-align: right; white-space: normal; }
        .mono { font-family: Consolas, "Courier New", monospace; direction: ltr; unicode-bidi: embed; }
        .status { display: inline-flex; align-items: center; gap: 5px; min-width: 70px; justify-content: center; padding: 4px 7px; border: 1px solid var(--border-glass); border-radius: 5px; font-size: .65rem; font-weight: 800; }
        .status.success { color: #13a371; border-color: rgba(19,163,113,.35); background: rgba(19,163,113,.08); }
        .status.pending { color: #d39b29; border-color: rgba(211,155,41,.35); background: rgba(211,155,41,.08); }
        .status.cancelled { color: #dc4c58; border-color: rgba(220,76,88,.35); background: rgba(220,76,88,.08); }
        .empty { padding: 25px !important; color: var(--text-muted) !important; text-align: center !important; }
        .split-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .audit-note { display: grid; grid-template-columns: 120px 115px 150px 1fr; gap: 10px; padding: 11px 14px; border-bottom: 1px solid var(--border-glass); align-items: center; }
        .audit-note:last-child { border-bottom: 0; }
        .audit-note strong { font-size: .72rem; }
        .audit-note span { color: var(--text-muted); font-size: .68rem; }
        .cancelled-section { border-color: rgba(220,76,88,.35); }
        .cancelled-section .section-head { background: rgba(220,76,88,.055); }
        .excluded-notice { margin: 12px 14px 0; padding: 9px 11px; border-right: 3px solid #dc4c58; color: #dc4c58; background: rgba(220,76,88,.06); font-size: .7rem; font-weight: 700; }
        #reportResults[hidden] { display: none; }
        @media (max-width: 1250px) {
            .filter-grid { grid-template-columns: repeat(3, 1fr); }
            .filter-actions { grid-column: span 3; justify-content: flex-end; }
            .metrics { grid-template-columns: repeat(3, 1fr); }
        }
        @media (max-width: 991px) {
            .main-content { margin-right: 0; padding: 14px; }
            .mobile-menu { display: grid; place-items: center; }
            .split-sections { grid-template-columns: 1fr; }
        }
        @media (max-width: 680px) {
            .page-head { align-items: flex-start; }
            .page-title p { display: none; }
            .filter-grid { grid-template-columns: 1fr; }
            .filter-actions { grid-column: auto; display: grid; grid-template-columns: 1fr 1fr; }
            .metrics { grid-template-columns: repeat(2, minmax(0,1fr)); }
            .metric { min-height: 105px; padding: 12px; }
            .metric strong { font-size: .95rem; }
            .report-state { align-items: flex-start; flex-direction: column; }
            .audit-note { grid-template-columns: 1fr 1fr; }
            .audit-note span:last-child { grid-column: 1 / -1; }
        }
    </style>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
</head>
<body>
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>
    <%- include('partials/sidebar', { activePage: 'reports' }) %>

    <main class="main-content">
        <div class="report-page">
            <header class="page-head">
                <div class="page-title">
                    <div class="page-title-icon"><i class="fa-solid fa-chart-column"></i></div>
                    <div><h1>التقارير المالية الشاملة</h1><p>كشف حساب دقيق، إقفال يومي، وتتبع كامل للحركات والتعديلات</p></div>
                </div>
                <button type="button" class="mobile-menu" onclick="toggleSidebar()" aria-label="فتح القائمة"><i class="fa-solid fa-bars"></i></button>
            </header>

            <section class="report-panel" aria-label="مرشحات التقرير">
                <div class="filter-grid">
                    <div class="field">
                        <label for="mainCategory">نوع الحساب</label>
                        <select id="mainCategory" class="form-select" onchange="updateSubCategory()">
                            <option value="">اختر نوع الحساب</option>
                            <option value="direct_client">عميل مباشر</option>
                            <option value="company">شركة</option>
                            <option value="agent">وكيل</option>
                            <option value="executor">منفذ</option>
                            <option value="api_executor">منفذ API</option>
                        </select>
                    </div>
                    <div class="field" id="subEntityCol" hidden>
                        <label id="subEntityLabel" for="subEntity">الحساب</label>
                        <select id="subEntity" class="form-select" onchange="updateThirdCategory()"><option value="">اختر الحساب</option></select>
                    </div>
                    <div class="field" id="thirdCategoryCol" hidden>
                        <label for="thirdCategory">التقسيم الداخلي</label>
                        <select id="thirdCategory" class="form-select"><option value="all">الحساب بالكامل</option></select>
                    </div>
                    <div class="field">
                        <label for="dateType">الفترة</label>
                        <select id="dateType" class="form-select" onchange="toggleDateInput()"><option value="day">يوم</option><option value="month">شهر</option></select>
                    </div>
                    <div class="field">
                        <label for="dateValueDay">التاريخ</label>
                        <input type="date" id="dateValueDay" class="form-control">
                        <input type="month" id="dateValueMonth" class="form-control" hidden>
                    </div>
                    <div class="filter-actions">
                        <button id="btnViewReport" type="button" class="command primary" onclick="fetchReport()"><i class="fa-solid fa-magnifying-glass"></i><span>عرض التقرير</span></button>
                        <button id="btnDownloadPdf" type="button" class="command pdf" onclick="downloadReportPdf()" disabled><i class="fa-solid fa-file-pdf"></i><span>تحميل PDF</span></button>
                    </div>
                </div>
            </section>

            <div id="reportResults" hidden>
                <div id="closureState" class="report-state"><div><strong id="closureTitle"></strong><span id="closureText"></span></div><span id="reportAccount"></span></div>

                <section class="metrics" aria-label="الملخص المالي">
                    <article class="metric"><i class="fa-solid fa-arrow-rotate-left"></i><span>الرصيد السابق</span><strong id="statPrevious">0.00</strong><small>قبل بداية الفترة</small></article>
                    <article class="metric"><i class="fa-solid fa-money-bill-transfer"></i><span>التحويلات الناجحة</span><strong id="statTransfers">0.00</strong><small id="statTransfersEgp">0 EGP</small></article>
                    <article class="metric success"><i class="fa-solid fa-arrow-down"></i><span>الإيداعات</span><strong id="statDeposits">0.00</strong><small id="statDepositCount">0 حركة</small></article>
                    <article class="metric danger"><i class="fa-solid fa-arrow-up"></i><span>الخصومات</span><strong id="statDeductions">0.00</strong><small id="statDeductionCount">0 حركة</small></article>
                    <article class="metric gold"><i class="fa-solid fa-scale-balanced"></i><span>إجمالي اليوم - صافي الحركة</span><strong id="statDailyNet">0.00</strong><small>الإيداع - الخصم - التحويل</small></article>
                    <article class="metric closing"><i class="fa-solid fa-wallet"></i><span>الرصيد الختامي</span><strong id="statClosing">0.00</strong><small id="statClosingEgp">0 EGP تحويلات</small></article>
                </section>

                <section class="report-section">
                    <div class="section-head"><div><h2>التحويلات الناجحة</h2><p>هذه العمليات فقط تدخل في إجمالي التحويلات والحسابات</p></div><span id="completedCount" class="section-count">0</span></div>
                    <div class="table-wrap"><table class="report-table"><thead><tr><th>#</th><th>رقم العملية</th><th>الخدمة</th><th>رقم المستفيد</th><th>EGP</th><th>السعر</th><th>LYD</th><th>المنفذ</th><th>التاريخ</th><th>الملاحظة</th></tr></thead><tbody id="completedBody"></tbody></table></div>
                </section>

                <section id="pendingSection" class="report-section">
                    <div class="section-head"><div><h2>الحركات المعلقة</h2><p>معروضة للمتابعة وغير محسوبة ضمن الإجماليات النهائية</p></div><span id="pendingCount" class="section-count">0</span></div>
                    <div class="table-wrap"><table class="report-table"><thead><tr><th>#</th><th>رقم الحركة</th><th>النوع</th><th>القيمة</th><th>المسؤول</th><th>التاريخ</th><th>الحالة</th><th>الملاحظة</th></tr></thead><tbody id="pendingBody"></tbody></table></div>
                </section>

                <div class="split-sections">
                    <section class="report-section">
                        <div class="section-head"><div><h2>الإيداعات</h2><p>إضافات معتمدة إلى الرصيد</p></div><span id="depositCount" class="section-count">0</span></div>
                        <div class="table-wrap"><table class="report-table"><thead><tr><th>#</th><th>رقم الحركة</th><th>القيمة</th><th>الرصيد التالي</th><th>التاريخ</th><th>الملاحظة</th></tr></thead><tbody id="depositBody"></tbody></table></div>
                    </section>
                    <section class="report-section">
                        <div class="section-head"><div><h2>الخصومات</h2><p>خصومات معتمدة من الرصيد</p></div><span id="deductionCount" class="section-count">0</span></div>
                        <div class="table-wrap"><table class="report-table"><thead><tr><th>#</th><th>رقم الحركة</th><th>القيمة</th><th>الرصيد التالي</th><th>التاريخ</th><th>الملاحظة</th></tr></thead><tbody id="deductionBody"></tbody></table></div>
                    </section>
                </div>

                <section class="report-section">
                    <div class="section-head"><div><h2>سجل الحركات المالية</h2><p>تتبع الرصيد قبل وبعد كل قيد مالي مرتبط بالفترة</p></div><span id="movementCount" class="section-count">0</span></div>
                    <div class="table-wrap"><table class="report-table"><thead><tr><th>#</th><th>رقم العملية</th><th>القيد</th><th>القيمة</th><th>الرصيد السابق</th><th>الرصيد التالي</th><th>وقت التسجيل</th><th>البيان</th></tr></thead><tbody id="movementBody"></tbody></table></div>
                </section>

                <section id="auditSection" class="report-section">
                    <div class="section-head"><div><h2>ملاحظات ما بعد الإقفال</h2><p>أي تعديل تم على حركة تعود إلى يوم مقفل مالياً</p></div><span id="auditCount" class="section-count">0</span></div>
                    <div id="auditBody"></div>
                </section>

                <section class="report-section cancelled-section">
                    <div class="section-head"><div><h2>العمليات الملغية والمرفوضة</h2><p>قسم مستقل في نهاية التقرير</p></div><span id="cancelledCount" class="section-count">0</span></div>
                    <div class="excluded-notice">هذه العمليات مستبعدة من الرصيد السابق والتحويلات والإيداعات والخصومات وصافي اليوم والرصيد الختامي.</div>
                    <div class="table-wrap"><table class="report-table"><thead><tr><th>#</th><th>رقم العملية</th><th>رقم الإلغاء</th><th>النوع</th><th>رقم المستفيد</th><th>EGP</th><th>LYD</th><th>تاريخ العملية</th><th>تاريخ الإلغاء</th><th>السبب</th></tr></thead><tbody id="cancelledBody"></tbody></table></div>
                </section>
            </div>
        </div>
    </main>

    <script type="application/json" id="reportDataUsers"><%- JSON.stringify(users).replace(/</g, '\\u003c') %></script>
    <script type="application/json" id="reportDataCompanies"><%- JSON.stringify(companies).replace(/</g, '\\u003c') %></script>
    <script type="application/json" id="reportDataAgents"><%- JSON.stringify(agents).replace(/</g, '\\u003c') %></script>
    <script type="application/json" id="reportDataExecutors"><%- JSON.stringify(executors).replace(/</g, '\\u003c') %></script>
    <script type="application/json" id="reportDataApiExecutors"><%- JSON.stringify(apiExecutors).replace(/</g, '\\u003c') %></script>
    <script>
        const parseData = (id) => JSON.parse(document.getElementById(id).textContent || '[]');
        const dbUsers = parseData('reportDataUsers');
        const dbCompanies = parseData('reportDataCompanies');
        const dbAgents = parseData('reportDataAgents');
        const dbExecutors = parseData('reportDataExecutors');
        const dbApiExecutors = parseData('reportDataApiExecutors');
        const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
        let lastReportData = null;
        let lastReportPayload = null;

        const escapeHtml = (value) => String(value ?? '')
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        const compact = (value, max = 110) => {
            const text = String(value || '').replace(/\s+/g, ' ').trim();
            return text.length > max ? `${text.slice(0, max - 3)}...` : text || '---';
        };
        const money = (value, digits = 2) => Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
        const egp = (value) => Number(value || 0).toLocaleString('en-US', { maximumFractionDigits: 0 });
        const dateTime = (value) => {
            const date = value ? new Date(value) : null;
            return date && !Number.isNaN(date.getTime())
                ? `${date.toLocaleDateString('en-GB')} ${date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true })}`
                : '---';
        };
        const localDateValue = (date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
        const serviceName = (type) => ({ vodafone: 'محافظ كاش', cash: 'محافظ كاش', post_account: 'البريد - حساب', post_card: 'البريد - بطاقة', bank_account: 'تحويل بنكي', sefa_niger: 'السفا - النيجر', bankak_sudan: 'بنكك - السودان', balance_transfer: 'تحويل داخلي' }[type] || type || 'تحويل مالي');
        const movementName = (type) => ({ DEPOSIT: 'إيداع', DEDUCTION: 'خصم', TRANSFER: 'تحويل', COMMISSION: 'عمولة', REFUND: 'استرجاع', REVERSAL: 'قيد عكسي' }[type] || type || 'حركة');
        const targetNumber = (tx) => tx.vodafoneNumber || tx.accountNumber || tx.serviceDetails?.clientPhone || '---';
        const actorName = (tx) => tx.operatorName || tx.executorName || tx.employeeName || tx.subAccountName || 'الإدارة';
        const visibleNote = (tx) => compact(tx.customerNotes || tx.notes || tx.adminNotes || tx.cancellationReason || '---');
        const emptyRow = (columns, text) => `<tr><td colspan="${columns}" class="empty">${escapeHtml(text)}</td></tr>`;

        document.getElementById('dateValueDay').value = localDateValue(new Date());
        document.getElementById('dateValueMonth').value = localDateValue(new Date()).slice(0, 7);

        function toggleSidebar() {
            document.querySelector('.sidebar')?.classList.toggle('active');
            document.querySelector('.sidebar-overlay')?.classList.toggle('active');
        }

        function toggleDateInput() {
            const isDay = document.getElementById('dateType').value === 'day';
            document.getElementById('dateValueDay').hidden = !isDay;
            document.getElementById('dateValueMonth').hidden = isDay;
        }

        function addOption(select, value, label) {
            const option = document.createElement('option');
            option.value = value;
            option.textContent = label;
            select.appendChild(option);
        }

        function updateSubCategory() {
            const main = document.getElementById('mainCategory').value;
            const column = document.getElementById('subEntityCol');
            const select = document.getElementById('subEntity');
            const third = document.getElementById('thirdCategoryCol');
            select.replaceChildren();
            addOption(select, '', 'اختر الحساب');
            third.hidden = true;
            if (!main) { column.hidden = true; return; }
            column.hidden = false;
            let list = [];
            let label = 'الحساب';
            if (main === 'direct_client') { list = dbUsers; label = 'العميل المباشر'; }
            if (main === 'company') { list = dbCompanies; label = 'الشركة'; }
            if (main === 'agent') { list = dbAgents; label = 'الوكيل'; }
            if (main === 'executor') { list = dbExecutors; label = 'مجموعة التنفيذ'; }
            if (main === 'api_executor') { list = dbApiExecutors; label = 'منفذ API'; }
            document.getElementById('subEntityLabel').textContent = label;
            list.forEach((item) => addOption(select, item._id, `${item.name}${item.phone ? ` (${item.phone})` : ''}`));
        }

        function updateThirdCategory() {
            const main = document.getElementById('mainCategory').value;
            const subId = document.getElementById('subEntity').value;
            const column = document.getElementById('thirdCategoryCol');
            const select = document.getElementById('thirdCategory');
            select.replaceChildren();
            addOption(select, 'all', 'الحساب بالكامل');
            if (!subId) { column.hidden = true; return; }
            let items = [];
            if (main === 'company') items = (dbCompanies.find((item) => item._id === subId)?.employees || []).filter(Boolean).map((name) => ({ value: name, label: `موظف: ${name}` }));
            if (main === 'agent') items = (dbAgents.find((item) => item._id === subId)?.subAccounts || []).map((item) => ({ value: item._id, label: `عميل الوكيل: ${item.name}` }));
            if (main === 'executor') items = (dbExecutors.find((item) => item._id === subId)?.employees || []).filter(Boolean).map((name) => ({ value: name, label: `منفذ: ${name}` }));
            items.forEach((item) => addOption(select, item.value, item.label));
            column.hidden = items.length === 0;
        }

        function currentPayload() {
            const dateType = document.getElementById('dateType').value;
            return {
                mainCategory: document.getElementById('mainCategory').value,
                subId: document.getElementById('subEntity').value,
                subType: document.getElementById('thirdCategory').value || 'all',
                dateType,
                dateValue: document.getElementById(dateType === 'day' ? 'dateValueDay' : 'dateValueMonth').value
            };
        }

        function setButtonLoading(button, loading, label) {
            if (!button) return;
            if (!button.dataset.label) button.dataset.label = button.querySelector('span')?.textContent || '';
            button.disabled = loading;
            const icon = button.querySelector('i');
            const span = button.querySelector('span');
            if (icon) icon.className = loading ? 'fa-solid fa-spinner fa-spin' : button.id === 'btnDownloadPdf' ? 'fa-solid fa-file-pdf' : 'fa-solid fa-magnifying-glass';
            if (span) span.textContent = loading ? label : button.dataset.label;
        }

        function renderReport(data) {
            const stats = data.stats;
            const currency = stats.accountingCurrency;
            const unit = (value) => `${money(value)} ${currency}`;
            document.getElementById('statPrevious').textContent = unit(stats.previousBalance);
            document.getElementById('statTransfers').textContent = unit(stats.operationsCost);
            document.getElementById('statTransfersEgp').textContent = `${egp(stats.totalEGP)} EGP إجمالي مصري`;
            document.getElementById('statDeposits').textContent = unit(stats.totalDeposits);
            document.getElementById('statDepositCount').textContent = `${data.deposits.length} حركة معتمدة`;
            document.getElementById('statDeductions').textContent = unit(stats.totalDeductions);
            document.getElementById('statDeductionCount').textContent = `${data.deductions.length} حركة معتمدة`;
            document.getElementById('statDailyNet').textContent = unit(stats.dailyNet);
            document.getElementById('statClosing').textContent = unit(stats.endingBalance);
            document.getElementById('statClosingEgp').textContent = `${egp(stats.totalEGP)} EGP تحويلات ناجحة`;

            const closure = document.getElementById('closureState');
            closure.classList.add('visible');
            closure.classList.toggle('warning', data.closure.hasPostCloseChanges);
            document.getElementById('closureTitle').textContent = data.closure.closedDayCount ? `تم إقفال ${data.closure.closedDayCount} يوم مالي` : 'الفترة مفتوحة مالياً';
            document.getElementById('closureText').textContent = data.closure.hasPostCloseChanges ? `تم رصد ${data.closedDayChanges.length} تعديل بعد الإقفال وسيظهر في التقرير.` : 'لا توجد تعديلات مالية مرصودة بعد الإقفال.';
            document.getElementById('reportAccount').textContent = `${data.entityInfo.name} - ${data.entityInfo.status}`;

            document.getElementById('completedCount').textContent = data.completedOperations.length;
            document.getElementById('completedBody').innerHTML = data.completedOperations.map((tx, index) => `<tr><td>${index + 1}</td><td class="mono">${escapeHtml(tx.customId || tx._id)}</td><td>${escapeHtml(serviceName(tx.transferType))}</td><td class="mono">${escapeHtml(targetNumber(tx))}</td><td class="mono">${egp(tx.amount)}</td><td class="mono">${Number(tx.exchangeRate || 0).toFixed(3)}</td><td class="mono">${money(tx.costLYD, 3)}</td><td>${escapeHtml(compact(actorName(tx), 38))}</td><td class="mono">${escapeHtml(dateTime(tx.createdAt))}</td><td class="note" title="${escapeHtml(visibleNote(tx))}">${escapeHtml(visibleNote(tx))}</td></tr>`).join('') || emptyRow(10, 'لا توجد تحويلات ناجحة في الفترة المحددة.');

            const pending = [...data.pendingOperations, ...data.pendingDeposits];
            document.getElementById('pendingCount').textContent = pending.length;
            document.getElementById('pendingSection').hidden = pending.length === 0;
            document.getElementById('pendingBody').innerHTML = pending.map((tx, index) => `<tr><td>${index + 1}</td><td class="mono">${escapeHtml(tx.customId || tx._id)}</td><td>${escapeHtml(tx.status === 'deposit_pending' ? 'إيداع معلق' : serviceName(tx.transferType))}</td><td class="mono">${egp(tx.amount)} EGP</td><td>${escapeHtml(compact(actorName(tx), 45))}</td><td class="mono">${escapeHtml(dateTime(tx.createdAt))}</td><td><span class="status pending"><i class="fa-solid fa-clock"></i>معلقة</span></td><td class="note">${escapeHtml(visibleNote(tx))}</td></tr>`).join('');

            const ledgerFor = (tx, type) => data.movements.find((movement) => movement.transactionId === tx.customId && movement.type === type);
            document.getElementById('depositCount').textContent = data.deposits.length;
            document.getElementById('depositBody').innerHTML = data.deposits.map((tx, index) => { const ledger = ledgerFor(tx, 'DEPOSIT'); return `<tr><td>${index + 1}</td><td class="mono">${escapeHtml(tx.customId || tx._id)}</td><td class="mono">${money(tx.amount)}</td><td class="mono">${ledger ? money(ledger.balanceAfter) : '---'}</td><td class="mono">${escapeHtml(dateTime(tx.createdAt))}</td><td class="note">${escapeHtml(visibleNote(tx))}</td></tr>`; }).join('') || emptyRow(6, 'لا توجد إيداعات معتمدة.');
            document.getElementById('deductionCount').textContent = data.deductions.length;
            document.getElementById('deductionBody').innerHTML = data.deductions.map((tx, index) => { const ledger = ledgerFor(tx, 'DEDUCTION'); return `<tr><td>${index + 1}</td><td class="mono">${escapeHtml(tx.customId || tx._id)}</td><td class="mono">${money(tx.amount)}</td><td class="mono">${ledger ? money(ledger.balanceAfter) : '---'}</td><td class="mono">${escapeHtml(dateTime(tx.createdAt))}</td><td class="note">${escapeHtml(visibleNote(tx))}</td></tr>`; }).join('') || emptyRow(6, 'لا توجد خصومات معتمدة.');

            document.getElementById('movementCount').textContent = data.movements.length;
            document.getElementById('movementBody').innerHTML = data.movements.slice(0, 250).map((movement, index) => `<tr><td>${index + 1}</td><td class="mono">${escapeHtml(movement.transactionId || '---')}</td><td>${escapeHtml(movementName(movement.type))}</td><td class="mono">${money(movement.amount, 3)}</td><td class="mono">${money(movement.balanceBefore, 3)}</td><td class="mono">${money(movement.balanceAfter, 3)}</td><td class="mono">${escapeHtml(dateTime(movement.createdAt))}</td><td class="note">${escapeHtml(compact(movement.description, 100))}</td></tr>`).join('') || emptyRow(8, 'لا توجد قيود دفتر مرتبطة بالفترة.');

            document.getElementById('auditCount').textContent = data.closedDayChanges.length;
            document.getElementById('auditSection').hidden = data.closedDayChanges.length === 0;
            document.getElementById('auditBody').innerHTML = data.closedDayChanges.map((change) => `<div class="audit-note"><strong class="mono">${escapeHtml(change.transactionId)}</strong><span>${escapeHtml(change.action)}</span><span>${escapeHtml(change.actor)}<br><b class="mono">${escapeHtml(dateTime(change.changedAt))}</b></span><span><b>اليوم المقفل:</b> <span class="mono">${escapeHtml(change.affectedDay)}</span><br>${escapeHtml(change.details || 'تم تعديل الحركة بعد الإقفال.')}</span></div>`).join('');

            document.getElementById('cancelledCount').textContent = data.cancelledOperations.length;
            document.getElementById('cancelledBody').innerHTML = data.cancelledOperations.map((tx, index) => `<tr><td>${index + 1}</td><td class="mono">${escapeHtml(tx.customId || tx._id)}</td><td class="mono">${escapeHtml(tx.cancellationNumber || '---')}</td><td>${escapeHtml(tx.balanceAdjustment?.originalStatus === 'deposit' ? 'إيداع ملغي' : tx.balanceAdjustment?.originalStatus === 'deduction' ? 'خصم ملغي' : serviceName(tx.transferType))}</td><td class="mono">${escapeHtml(targetNumber(tx))}</td><td class="mono">${egp(tx.amount)}</td><td class="mono">${money(tx.costLYD, 3)}</td><td class="mono">${escapeHtml(dateTime(tx.createdAt))}</td><td class="mono">${escapeHtml(dateTime(tx.cancelledAt || tx.updatedAt))}</td><td class="note">${escapeHtml(compact(tx.cancellationReason || tx.adminNotes || tx.notes, 110))}</td></tr>`).join('') || emptyRow(10, 'لا توجد عمليات ملغية أو مرفوضة.');

            document.getElementById('reportResults').hidden = false;
            document.getElementById('btnDownloadPdf').disabled = false;
        }

        async function fetchReport() {
            const payload = currentPayload();
            if (!payload.mainCategory || !payload.subId || !payload.dateValue) return Swal.fire({ icon: 'warning', title: 'بيانات ناقصة', text: 'اختر نوع الحساب والحساب والفترة الزمنية.' });
            const button = document.getElementById('btnViewReport');
            setButtonLoading(button, true, 'جاري إعداد التقرير');
            document.getElementById('btnDownloadPdf').disabled = true;
            try {
                const response = await fetch('/api/reports/filter', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken }, body: JSON.stringify(payload) });
                const data = await response.json().catch(() => ({}));
                if (!response.ok || !data.success) throw new Error(data.error || 'تعذر جلب التقرير.');
                lastReportData = data;
                lastReportPayload = payload;
                renderReport(data);
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'تعذر عرض التقرير', text: error.message });
            } finally {
                setButtonLoading(button, false);
            }
        }

        function downloadReportPdf() {
            if (!lastReportData || !lastReportPayload) return;
            const button = document.getElementById('btnDownloadPdf');
            setButtonLoading(button, true, 'جاري إنشاء PDF');
            const query = new URLSearchParams(lastReportPayload);

            // A native attachment navigation preserves the browser download event.
            window.location.assign(`/reports/download.pdf?${query.toString()}`);

            window.setTimeout(() => {
                setButtonLoading(button, false);
                button.disabled = false;
            }, 5000);
        }
    </script>
</body>
</html>
