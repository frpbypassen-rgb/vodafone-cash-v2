<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>المركز المالي - Power Pay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
    body{font-family:Cairo,Arial,sans-serif;background:var(--bg-body);color:var(--text-main)}.main-content{margin-right:260px;padding:24px}@media(max-width:991px){.main-content{margin-right:0;padding:14px 12px 90px}}.metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:20px 0}@media(max-width:1000px){.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.metric-grid{grid-template-columns:1fr}}.metric,.panel{background:var(--card-bg);border:1px solid var(--border-glass);border-radius:8px;padding:18px}.metric{min-height:132px;display:flex;flex-direction:column;justify-content:space-between}.metric span{color:var(--text-muted);font-weight:800}.metric strong{font:900 1.8rem ui-monospace,monospace;direction:ltr}.danger{color:#ef4444}.success{color:#10b981}.warning{color:#f59e0b}.panel{margin-top:16px}.panel h2{font-size:1.05rem;font-weight:900;margin:0 0 14px}.table-wrap{overflow:auto}.table{min-width:650px;color:var(--text-main)}.table th{color:var(--text-muted);font-size:.78rem}.table td,.table th{border-color:var(--border-glass);vertical-align:middle}.mono{font-family:ui-monospace,monospace;direction:ltr}.muted{color:var(--text-muted);font-size:.8rem}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.toolbar a{font-weight:800}.merchant-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:12px}.merchant-card{width:100%;min-height:88px;display:flex;align-items:flex-start;gap:12px;text-align:right;color:var(--text-main);background:rgba(15,23,42,.62);border:1px solid var(--border-glass);border-radius:8px;padding:14px;transition:border-color .15s ease,transform .15s ease}.merchant-card:hover{border-color:var(--brand-gold,#f59e0b);transform:translateY(-1px)}.merchant-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:8px;background:rgba(245,158,11,.14);color:#f59e0b;flex:0 0 auto}.merchant-card-body{flex:1;min-width:0}.merchant-card-body strong{display:block;line-height:1.55;white-space:normal;overflow-wrap:anywhere}.merchant-card-body small{display:block;color:var(--text-muted);margin-top:3px}.merchant-balance{font:900 1rem ui-monospace,monospace;direction:ltr;white-space:normal;text-align:left;line-height:1.45;min-width:112px;overflow-wrap:anywhere}.modal-content{background:var(--card-bg);color:var(--text-main);border:1px solid var(--border-glass)}
    </style>
</head>
<body>
<%- include('partials/sidebar', { activePage }) %>
<main class="main-content">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div><h1 class="fw-black mb-1"><i class="fa-solid fa-scale-balanced text-warning ms-2"></i>المركز المالي</h1><div class="muted">أرصدة العملاء والشركات والتجار وربح فرق الصرف</div></div>
        <div class="toolbar"><a class="btn btn-outline-warning" href="/financial-movements"><i class="fa-solid fa-book ms-1"></i>السجل المالي</a><a class="btn btn-outline-light" href="/financial-center"><i class="fa-solid fa-rotate-right"></i></a></div>
    </div>
    <section class="metric-grid">
        <div class="metric"><span><i class="fa-solid fa-file-invoice-dollar ms-1"></i>إجمالي ديون العملاء والشركات والوكلاء</span><strong class="danger"><%= Number(overview.totalDebts || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %> LYD</strong></div>
        <div class="metric"><span><i class="fa-solid fa-wallet ms-1"></i>إجمالي الأرصدة الموجبة</span><strong class="success"><%= Number(overview.totalPositiveBalances || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %> LYD</strong></div>
        <div class="metric"><span><i class="fa-solid fa-chart-line ms-1"></i>ربح فرق الصرف المحقق</span><strong class="warning"><%= Number(overview.exchangeProfit?.totalProfitLYD || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %> LYD</strong><small class="muted"><%= overview.exchangeProfit?.count || 0 %> عملية مكتملة</small></div>
        <div class="metric"><span><i class="fa-solid fa-store ms-1"></i>إجمالي أرصدة التجار</span><strong class="success"><%= Number(overview.totalMerchantBalance || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %> LYD</strong><small class="muted">يشمل الأرصدة السالبة</small></div>
        <div class="metric"><span><i class="fa-solid fa-coins ms-1"></i>المصري المتاح عند المنفذين</span><strong class="success"><%= Number(overview.executorBalanceTotals?.availableEGP || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %> EGP</strong></div>
        <div class="metric"><span><i class="fa-solid fa-file-invoice ms-1"></i>مديونية المصري عند المنفذين</span><strong class="danger"><%= Number(overview.executorBalanceTotals?.debtEGP || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %> EGP</strong></div>
    </section>
    <section class="panel">
        <h2><i class="fa-solid fa-money-bill-transfer text-warning ms-1"></i>إيداع للمنفذ من مستفيد تاجر</h2>
        <p class="muted">أدخل قيمة الإيداع بالجنيه المصري. سيصل الطلب إلى المنفذ مع الملاحظة، وعند قبوله يُحسب الدينار الليبي من خلال قسمة المبلغ على سعر الصرف ثم يُخصم من التاجر.</p>
        <form id="merchantDepositForm" class="row g-3" onsubmit="submitMerchantDeposit(event)">
            <div class="col-12 col-md-3"><label class="form-label">التاجر</label><select name="merchantId" class="form-select" required><option value="">اختر التاجر</option><% overview.merchantAccounts.forEach((merchant) => { %><option value="<%= merchant._id %>"><%= merchant.name %></option><% }) %></select></div>
            <div class="col-12 col-md-3"><label class="form-label">المنفذ</label><select name="executorId" id="merchantDepositExecutor" class="form-select" required><option value="">اختر المنفذ</option><% executors.forEach((executor) => { const enabledServices = [...new Set([executor.serviceKey || 'vodafone', ...(Array.isArray(executor.serviceKeys) ? executor.serviceKeys : [])])]; %><option value="<%= executor._id %>" data-service-keys="<%= enabledServices.join(',') %>"><%= executor.name %></option><% }) %></select></div>
            <div class="col-12 col-md-3" id="merchantDepositServiceField" hidden><label class="form-label">نوع الإيداع</label><select name="serviceKey" id="merchantDepositService" class="form-select"><option value="vodafone">إيداع كاش / فودافون كاش</option><option value="bank_account">إيداع تحويل بنكي</option></select><small class="muted d-block mt-1">هذا الاختيار يحدد الرصيد الذي ستتم إضافته عند قبول الإيداع.</small></div>
            <div class="col-6 col-md-2"><label class="form-label">المبلغ EGP</label><input name="amountEGP" type="number" min="0.001" step="0.001" class="form-control mono" required></div>
            <div class="col-6 col-md-1"><label class="form-label">السعر</label><input name="exchangeRate" type="number" min="0.001" step="0.001" class="form-control mono" required></div>
            <div class="col-12"><input name="note" class="form-control" placeholder="الملاحظة التي ستصل إلى المنفذ"><button class="btn btn-warning fw-bold mt-3" type="submit"><i class="fa-solid fa-paper-plane ms-1"></i>إرسال طلب الإيداع</button><span id="merchantDepositResult" class="muted me-3"></span></div>
        </form>
    </section>
    <section class="panel">
        <h2><i class="fa-solid fa-building text-info ms-1"></i>إضافة مكتب أو تاجر</h2>
        <div class="row g-3">
            <form class="col-12 col-md-6 d-flex gap-2" onsubmit="createReference(event,'offices')"><input name="name" class="form-control" placeholder="اسم المكتب" required><input name="code" class="form-control mono" placeholder="الكود"><button class="btn btn-outline-info" type="submit">إضافة مكتب</button></form>
            <form class="col-12 col-md-6 d-flex gap-2" onsubmit="createReference(event,'merchants')"><input name="name" class="form-control" placeholder="اسم التاجر" required><input name="code" class="form-control mono" placeholder="الكود"><button class="btn btn-outline-success" type="submit">إضافة تاجر</button></form>
        </div>
    </section>
    <section class="panel">
        <h2><i class="fa-solid fa-right-left text-warning ms-1"></i>نقل رصيد بين التجار</h2>
        <p class="muted">ينقل هذا الإجراء الرصيد المتاح من تاجر إلى تاجر آخر، ويسجل خصمًا وإضافةً في السجل المالي.</p>
        <form id="merchantTransferForm" class="row g-3" onsubmit="submitMerchantTransfer(event)">
            <div class="col-12 col-md-3"><label class="form-label">من التاجر</label><select name="fromMerchantId" class="form-select" required><option value="">اختر التاجر المصدر</option><% overview.merchantAccounts.forEach((merchant) => { %><option value="<%= merchant._id %>"><%= merchant.name %> — <%= Number(merchant.balance || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %> LYD</option><% }) %></select></div>
            <div class="col-12 col-md-3"><label class="form-label">إلى التاجر</label><select name="toMerchantId" class="form-select" required><option value="">اختر التاجر المستلم</option><% overview.merchantAccounts.forEach((merchant) => { %><option value="<%= merchant._id %>"><%= merchant.name %></option><% }) %></select></div>
            <div class="col-6 col-md-2"><label class="form-label">المبلغ LYD</label><input name="amount" type="number" min="0.001" step="0.001" class="form-control mono" required></div>
            <div class="col-12 col-md-3"><label class="form-label">الملاحظة</label><input name="note" class="form-control" maxlength="500" placeholder="سبب نقل الرصيد (اختياري)"></div>
            <div class="col-12 col-md-1 d-flex align-items-end"><button class="btn btn-warning fw-bold w-100" type="submit"><i class="fa-solid fa-arrow-right-arrow-left"></i> نقل</button></div>
            <div class="col-12"><span id="merchantTransferResult" class="muted"></span></div>
        </form>
    </section>
    <section class="panel"><h2><i class="fa-solid fa-store text-warning ms-1"></i>أرصدة المستفيدين التجار</h2><div class="merchant-cards"><% if (!overview.merchantAccounts.length) { %><div class="muted py-4">لا توجد حسابات تجار مسجلة محليًا بعد</div><% } %><% overview.merchantAccounts.forEach((merchant) => { %><button type="button" class="merchant-card" onclick="openMerchantMovements('<%= merchant._id %>')"><span class="merchant-icon"><i class="fa-solid fa-store"></i></span><span class="merchant-card-body"><strong><%= merchant.name %></strong><small><%= merchant.code || 'مستفيد تاجر' %></small></span><span class="merchant-balance <%= merchant.balance < 0 ? 'danger' : 'success' %>"><%= Number(merchant.balance || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %> LYD</span><i class="fa-solid fa-chevron-left text-muted"></i></button><% }) %></div></section>
    <div class="modal fade" id="merchantMovementsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5 fw-bold" id="merchantModalTitle">سجل حركات التاجر</h2><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body"><div id="merchantModalBalance" class="fw-bold mb-3"></div><div class="table-wrap"><table class="table"><thead><tr><th>التاريخ</th><th>البيان</th><th>الحركة</th><th>الرصيد بعد</th></tr></thead><tbody id="merchantMovementsBody"></tbody></table></div></div></div></div></div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function postJson(url, body) { const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || ''; const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrfToken }, body: JSON.stringify(body) }); const data = await r.json().catch(() => ({})); if (!r.ok || !data.success) throw new Error(data.error || 'تعذر تنفيذ الطلب'); return data; }
async function submitMerchantDeposit(event) { event.preventDefault(); const form = event.currentTarget; const result = document.getElementById('merchantDepositResult'); try { const data = await postJson('/financial-center/merchant-deposits', Object.fromEntries(new FormData(form))); result.textContent = `تم إرسال طلب الإيداع للمنفذ: ${data.transactionId} | القيمة ${Number(data.amountEGP).toFixed(2)} EGP`; result.className = 'text-success fw-bold me-3'; form.reset(); } catch (error) { result.textContent = error.message; result.className = 'text-danger fw-bold me-3'; } }
async function submitMerchantTransfer(event) { event.preventDefault(); const form = event.currentTarget; const result = document.getElementById('merchantTransferResult'); try { const data = await postJson('/financial-center/merchant-transfers', Object.fromEntries(new FormData(form))); result.textContent = `تم نقل ${Number(data.amount).toFixed(3)} LYD من ${data.source.name} إلى ${data.target.name}`; result.className = 'text-success fw-bold'; form.reset(); setTimeout(() => location.reload(), 700); } catch (error) { result.textContent = error.message; result.className = 'text-danger fw-bold'; } }
const merchantDepositExecutor = document.getElementById('merchantDepositExecutor'); const merchantDepositServiceField = document.getElementById('merchantDepositServiceField'); const merchantDepositService = document.getElementById('merchantDepositService');
function updateMerchantDepositService() { const option = merchantDepositExecutor?.selectedOptions[0]; const keys = String(option?.dataset.serviceKeys || '').split(',').filter(Boolean); const supportsCash = keys.includes('vodafone'); const supportsBank = keys.includes('bank_account'); const supportsBoth = supportsCash && supportsBank; merchantDepositServiceField.hidden = !supportsBoth; merchantDepositService.required = supportsBoth; if (!supportsBoth) merchantDepositService.value = supportsBank ? 'bank_account' : 'vodafone'; }
merchantDepositExecutor?.addEventListener('change', updateMerchantDepositService); updateMerchantDepositService();
async function createReference(event, resource) { event.preventDefault(); const form = event.currentTarget; try { await postJson('/financial-center/' + resource, Object.fromEntries(new FormData(form))); location.reload(); } catch (error) { alert(error.message); } }
function escapeHtml(value) { return String(value ?? '').replace(/[&<>\"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', "'": '&#39;' })[character]); }
async function openMerchantMovements(merchantId) { const modalElement = document.getElementById('merchantMovementsModal'); const body = document.getElementById('merchantMovementsBody'); const balance = document.getElementById('merchantModalBalance'); body.innerHTML = '<tr><td colspan="4" class="text-center muted">جار تحميل سجل الحركات...</td></tr>'; balance.textContent = ''; bootstrap.Modal.getOrCreateInstance(modalElement).show(); try { const response = await fetch('/financial-center/merchants/' + encodeURIComponent(merchantId) + '/movements', { headers: { Accept: 'application/json' } }); const data = await response.json().catch(() => ({})); if (!response.ok || !data.success) throw new Error(data.error || 'تعذر تحميل سجل الحركات'); document.getElementById('merchantModalTitle').textContent = 'سجل حركات ' + data.merchant.name; balance.textContent = 'الرصيد الحالي: ' + Number(data.merchant.balance || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' LYD'; const typeLabels = { DEDUCTION: 'خصم من التاجر', REVERSAL: 'عكس قيد', DEPOSIT: 'إيداع' }; body.innerHTML = data.movements.length ? data.movements.map((movement) => { const amount = Number(movement.amount || 0); const amountClass = amount < 0 ? 'danger' : 'success'; return '<tr><td class="mono">' + escapeHtml(new Date(movement.createdAt).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli' })) + '</td><td>' + escapeHtml(movement.description || '-') + '</td><td>' + escapeHtml(typeLabels[movement.type] || movement.type || '-') + '</td><td class="mono ' + amountClass + '">' + escapeHtml(amount.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 })) + ' LYD</td></tr>'; }).join('') : '<tr><td colspan="4" class="text-center muted">لا توجد حركات مسجلة لهذا التاجر</td></tr>'; } catch (error) { body.innerHTML = '<tr><td colspan="4" class="text-center danger">' + escapeHtml(error.message) + '</td></tr>'; } }
</script>
</body>
</html>
