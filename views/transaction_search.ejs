<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>البحث الشامل | الأهرام</title>
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('ahram_theme') || 'light');</script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family:Tajawal,sans-serif; } .main-content { margin-right:var(--sidebar-width); padding:30px; } .surface { background:var(--card-bg); border:1px solid var(--border-glass); border-radius:18px; box-shadow:var(--shadow-soft); } .form-label { font-size:.8rem; font-weight:800; color:var(--text-muted); } .form-control,.form-select { background:var(--input-bg); color:var(--text-main); border-color:var(--border-glass); min-height:44px; } .mono { font-family:'JetBrains Mono',monospace; direction:ltr; unicode-bidi:plaintext; } .table-wrap { overflow:auto; } .result-table { min-width:1120px; } .result-table th { color:var(--text-muted); font-size:.77rem; white-space:nowrap; } .result-table td { vertical-align:middle; font-size:.86rem; } .status { border-radius:999px; padding:5px 9px; font-weight:800; font-size:.72rem; white-space:nowrap; background:rgba(59,130,246,.12); color:#3b82f6; } .status.completed,.status.deposit { color:#10b981; background:rgba(16,185,129,.12); } .status.deduction,.status.rejected,.status.cancelled_by_admin { color:#ef4444; background:rgba(239,68,68,.12); } .status.pending { color:#d97706; background:rgba(245,158,11,.12); } @media(max-width:991px){.main-content{margin-right:0;padding:86px 14px 86px;}}
    </style>
</head>
<body>
<%- include('partials/sidebar', { activePage }) %>
<%
const statusLabels = { pending:'معلقة', processing:'موجهة', accepted:'قيد العمل', completed:'مكتملة', rejected:'ملغية', cancelled_by_admin:'ملغية', deposit_pending:'إيداع معلق', deposit:'إيداع', deduction:'خصم' };
const queryParams = (extra = {}) => {
    const params = new URLSearchParams();
    const requestKeys = { search: 'q', selectedDate: 'date', selectedMonth: 'month', fromDate: 'fromDate', toDate: 'toDate', mode: 'mode' };
    Object.entries(filters || {}).forEach(([key, value]) => { if (value) params.set(requestKeys[key] || key, value); });
    Object.entries(extra).forEach(([key, value]) => { if (value) params.set(key, value); else params.delete(key); });
    return params.toString();
};
%>
<main class="main-content"><div class="container-fluid"><header class="mb-4"><h1 class="h3 fw-bold mb-1"><i class="fa-solid fa-magnifying-glass text-primary ms-2"></i>البحث الشامل</h1><p class="text-muted fw-bold small mb-0">ابحث برقم العملية أو الإلغاء أو الإيداع أو الهاتف المصري أو المبلغ، مع تحديد اليوم أو الشهر أو فترة مخصصة.</p></header>
<section class="surface p-3 p-lg-4 mb-4"><form method="GET" action="/transactions/search" class="row g-3 align-items-end"><div class="col-12 col-lg-4"><label class="form-label">عبارة البحث</label><input autofocus class="form-control mono" name="q" value="<%= filters.search %>" placeholder="ATT-...، رقم إلغاء، رقم إيداع، هاتف، مبلغ"></div><div class="col-12 col-md-4 col-lg-2"><label class="form-label">نطاق التاريخ</label><select class="form-select" name="mode" id="mode"><option value="day" <%= filters.mode === 'day' ? 'selected' : '' %>>يوم محدد</option><option value="month" <%= filters.mode === 'month' ? 'selected' : '' %>>شهر محدد</option><option value="range" <%= filters.mode === 'range' ? 'selected' : '' %>>فترة محددة</option></select></div><div class="col-6 col-md-4 col-lg-2 scope-day"><label class="form-label">اليوم</label><input type="date" class="form-control mono" name="date" value="<%= filters.selectedDate %>"></div><div class="col-6 col-md-4 col-lg-2 scope-month"><label class="form-label">الشهر</label><input type="month" class="form-control mono" name="month" value="<%= filters.selectedMonth %>"></div><div class="col-6 col-md-4 col-lg-2 scope-range"><label class="form-label">من تاريخ</label><input type="date" class="form-control mono" name="fromDate" value="<%= filters.fromDate %>"></div><div class="col-6 col-md-4 col-lg-2 scope-range"><label class="form-label">إلى تاريخ</label><input type="date" class="form-control mono" name="toDate" value="<%= filters.toDate %>"></div><div class="col-12 col-lg-2"><button class="btn btn-primary w-100 fw-bold" type="submit"><i class="fa-solid fa-magnifying-glass ms-1"></i> بحث</button></div></form></section>
<section class="surface overflow-hidden"><div class="d-flex justify-content-between align-items-center p-3 border-bottom"><strong>النتائج</strong><span class="text-muted small fw-bold"><%= filters.search ? `${pagination.total.toLocaleString('en-US')} نتيجة` : 'أدخل عبارة بحث للبدء' %></span></div><div class="table-wrap"><table class="table result-table text-center m-0"><thead><tr><th>رقم العملية</th><th>الحالة</th><th>سبب المطابقة</th><th>المبلغ</th><th>الهاتف/الحساب</th><th>العميل</th><th>رقم الإيداع</th><th>رقم الإلغاء</th><th>التاريخ</th></tr></thead><tbody><% if (!filters.search) { %><tr><td colspan="9" class="py-5 text-muted fw-bold">اختر الفترة ثم اكتب أي معرّف أو قيمة للبحث.</td></tr><% } else if (!results.length) { %><tr><td colspan="9" class="py-5 text-muted fw-bold">لا توجد عملية مطابقة ضمن النطاق المحدد.</td></tr><% } %><% results.forEach(tx => { %><tr><td class="mono fw-bold"><a href="/transactions/operations?search=<%= encodeURIComponent(tx.customId) %>" class="text-decoration-none" title="فتح العملية في صفحة التوجيه"><%= tx.customId %></a></td><td><span class="status <%= tx.status %>"><%= statusLabels[tx.status] || tx.status %></span></td><td><span class="text-muted small fw-bold"><%= tx.matchReason %></span></td><td class="mono fw-bold"><%= Number(tx.amount || 0).toLocaleString('en-US', {maximumFractionDigits:2}) %> EGP</td><td class="mono"><%= tx.vodafoneNumber || tx.accountNumber || tx.serviceDetails?.clientPhone || '—' %></td><td><%= tx.companyName || tx.employeeName || tx.accountName || '—' %></td><td class="mono"><%= tx.settlementDetails?.externalReference || '—' %></td><td class="mono"><%= tx.cancellationNumber || '—' %></td><td class="mono"><%= new Date(tx.createdAt).toLocaleString('en-GB', { timeZone:'Africa/Tripoli' }) %></td></tr><% }) %></tbody></table></div><% if (filters.search && pagination.pages > 1) { %><nav class="p-3 border-top"><ul class="pagination justify-content-center flex-wrap mb-0"><li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="/transactions/search?<%= queryParams({ page: pagination.page - 1 }) %>">السابق</a></li><% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.pages, pagination.page + 2); p++) { %><li class="page-item <%= p === pagination.page ? 'active' : '' %>"><a class="page-link mono" href="/transactions/search?<%= queryParams({ page: p }) %>"><%= p %></a></li><% } %><li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>"><a class="page-link" href="/transactions/search?<%= queryParams({ page: pagination.page + 1 }) %>">التالي</a></li></ul></nav><% } %></section></div></main>
<script>const mode=document.getElementById('mode');function refreshScope(){document.querySelectorAll('.scope-day').forEach(x=>x.hidden=mode.value!=='day');document.querySelectorAll('.scope-month').forEach(x=>x.hidden=mode.value!=='month');document.querySelectorAll('.scope-range').forEach(x=>x.hidden=mode.value!=='range');}mode.addEventListener('change',refreshScope);refreshScope();document.addEventListener('keydown',(event)=>{if(event.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)){event.preventDefault();document.querySelector('[name=q]').focus();}if(event.key.toLowerCase()==='r'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)){event.preventDefault();window.location.reload();}});</script>
</body></html>
