<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= partyLabels[party] %> | لوحة الإدارة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: Tajawal, sans-serif; background: var(--bg-body); color: var(--text-main); }
        .deposit-shell { display: flex; flex-direction: column; gap: 16px; }
        .deposit-card { background: var(--card-bg); border: 1px solid var(--border-glass); border-radius: 18px; box-shadow: var(--shadow-soft); }
        .party-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
        .party-tabs a { text-decoration: none; border-radius: 999px; padding: 8px 14px; font-weight: 800; border: 1px solid var(--border-glass); color: var(--text-main); background: var(--input-bg); }
        .party-tabs a.active { background: var(--brand-gold); color: #111827; border-color: transparent; }
        .deposit-table { min-width: 980px; }
        .deposit-table th { color: var(--text-muted); font-size: .78rem; white-space: nowrap; }
        .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; direction: ltr; unicode-bidi: plaintext; }
        .status-pill { border-radius: 999px; padding: 4px 10px; font-size: .75rem; font-weight: 800; white-space: nowrap; }
        .status-deposit_pending { background: rgba(245, 158, 11, .16); color: #d97706; }
        .status-deposit { background: rgba(16, 185, 129, .14); color: #059669; }
        .status-deduction { background: rgba(239, 68, 68, .14); color: #dc2626; }
    </style>
</head>
<body>
<%- include('partials/sidebar', { activePage }) %>
<main class="main-content">
    <div class="container-fluid deposit-shell">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <h1 class="h3 fw-bold mb-1"><i class="fa-solid fa-building-columns text-warning ms-2"></i><%= partyLabels[party] %></h1>
                <p class="text-muted mb-0 fw-bold">إيداعات الشركات وإيداعات شركات التنفيذ تظهر هنا حتى بعد إغلاق تذكرة الدعم.</p>
            </div>
            <% if (canReviewSupport) { %>
                <a class="btn btn-outline-secondary fw-bold" href="/support?category=deposit"><i class="fa-solid fa-headset ms-1"></i>مراجعة طلبات الإيداع</a>
            <% } %>
        </div>

        <nav class="party-tabs" aria-label="نوع الإيداع">
            <% parties.forEach((item) => { %>
                <a class="<%= party === item ? 'active' : '' %>" href="/transactions/deposits?party=<%= item %>"><%= partyLabels[item] %></a>
            <% }) %>
        </nav>

        <form class="deposit-card p-3" method="get" action="/transactions/deposits">
            <input type="hidden" name="party" value="<%= party %>">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">بحث</label>
                    <input class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="رقم العملية أو اسم الجهة">
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">الحالة</label>
                    <select class="form-select" name="status">
                        <option value="">كل حالات الإيداع</option>
                        <option value="deposit_pending" <%= filters.status === 'deposit_pending' ? 'selected' : '' %>>طلب معلّق</option>
                        <option value="deposit" <%= filters.status === 'deposit' ? 'selected' : '' %>>إيداع معتمد</option>
                        <option value="deduction" <%= filters.status === 'deduction' ? 'selected' : '' %>>خصم</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">من تاريخ</label>
                    <input class="form-control" type="date" name="fromDate" value="<%= filters.fromDate || '' %>">
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">إلى تاريخ</label>
                    <input class="form-control" type="date" name="toDate" value="<%= filters.toDate || '' %>">
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-primary fw-bold flex-fill" type="submit">عرض</button>
                    <a class="btn btn-light fw-bold" href="/transactions/deposits?party=<%= party %>">مسح</a>
                </div>
            </div>
        </form>

        <% if (query && query.settlementVoided) { %>
            <div class="alert alert-info fw-bold mb-0">تم إلغاء أثر التسوية مع الإبقاء على القيد في هذا السجل.</div>
        <% } %>

        <section class="deposit-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table deposit-table align-middle text-center mb-0">
                    <thead>
                        <tr>
                            <th>الرقم</th>
                            <th>الجهة</th>
                            <th>النوع</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th>ملاحظة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!deposits.length) { %>
                            <tr><td colspan="8" class="py-5 text-muted fw-bold">لا توجد إيداعات مطابقة في السجل.</td></tr>
                        <% } %>
                        <% const statusLabels = { deposit_pending: 'طلب معلّق', deposit: 'إيداع', deduction: 'خصم' }; %>
                        <% const partyRowLabels = { company: 'شركة عميل', executor: 'شركة تنفيذ', client: 'عميل مباشر' }; %>
                        <% deposits.forEach((tx) => { %>
                            <tr>
                                <td class="mono fw-bold"><%= tx.customId || '-' %></td>
                                <td class="fw-bold"><%= tx.companyName || tx.executorName || tx.employeeName || '-' %></td>
                                <td><%= partyRowLabels[tx.party] || '-' %></td>
                                <td class="mono fw-bold"><%= Number(tx.amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                <td><span class="status-pill status-<%= tx.status %>"><%= statusLabels[tx.status] || tx.status %></span></td>
                                <td class="small"><%= tx.createdAt ? new Date(tx.createdAt).toLocaleString('en-GB', { timeZone: 'Africa/Tripoli', hour12: false }) : '-' %></td>
                                <td class="small text-muted"><%= tx.notes || (tx.depositRequest && tx.depositRequest.note) || '-' %></td>
                                <td class="text-nowrap">
                                    <% if (tx.companyId) { %><a class="btn btn-sm btn-outline-primary" href="/company/<%= tx.companyId %>">ملف الشركة</a><% } %>
                                    <% if (!tx.companyId && tx.executorGroupId) { %><a class="btn btn-sm btn-outline-success" href="/executor/<%= tx.executorGroupId %>">ملف التنفيذ</a><% } %>
                                    <% if (canReviewSupport && tx.depositRequest && tx.depositRequest.supportTicketId) { %>
                                        <a class="btn btn-sm btn-outline-secondary" href="/support?category=deposit&ticket=<%= tx.depositRequest.supportTicketId %>">التذكرة</a>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <% if (party === 'company' || party === 'all') { %>
        <section class="deposit-card p-3">
            <h2 class="h5 fw-bold">طلبات إيداع الشركات عبر الدعم</h2>
            <p class="text-muted fw-bold small">طلبات بوابة الشركة التي سُجّلت كرسالة دعم ولم تُنشأ لها حركة رصيد بعد.</p>
            <% if (!supportDeposits.length) { %>
                <div class="text-muted fw-bold">لا توجد طلبات دعم مطابقة.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead><tr><th>التذكرة</th><th>الشركة</th><th>المبلغ</th><th>الحالة</th><th>الملاحظة</th><th></th></tr></thead>
                        <tbody>
                            <% supportDeposits.forEach((row) => { %>
                                <tr>
                                    <td class="mono fw-bold"><%= row.reference %></td>
                                    <td class="fw-bold"><%= row.companyName || '-' %></td>
                                    <td class="mono"><%= Number(row.amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> LYD</td>
                                    <td><span class="status-pill status-<%= row.status %>"><%= row.status === 'deposit_pending' ? 'بانتظار المراجعة' : 'مغلق' %></span></td>
                                    <td class="small text-muted"><%= row.note || '-' %></td>
                                    <td><% if (canReviewSupport && row.ticketId) { %><a class="btn btn-sm btn-outline-secondary" href="/support?ticket=<%= row.ticketId %>">فتح التذكرة</a><% } %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
        <% } %>
    </div>
</main>
</body>
</html>
