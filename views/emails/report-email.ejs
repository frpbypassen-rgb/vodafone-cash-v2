<% const enrollment = mode === 'enrollment'; const login = mode === 'login' || enrollment; const otpMessage = mode === 'code' || login; %><!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light only"><title><%= enrollment ? 'تفعيل التحقق بالبريد' : login ? 'رمز تسجيل الدخول' : mode === 'code' ? 'تأكيد البريد الإلكتروني' : 'كشف الحساب اليومي' %></title>
<style>@media(max-width:480px){.email-pad{padding:24px 18px!important}.email-shell{border-radius:16px!important}.email-title{font-size:24px!important}.email-code{font-size:34px!important;letter-spacing:7px!important}.email-logo{width:52px!important;height:52px!important}}</style></head>
<body style="margin:0;padding:0;background:#eef2f8;color:#172b49;font-family:Tahoma,Arial,sans-serif;direction:rtl;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;"><%= enrollment ? 'أكّد بريدك لتفعيل رمز عند كل تسجيل دخول.' : login ? 'رمزك لإكمال تسجيل الدخول بأمان.' : mode === 'code' ? 'أكمل تأكيد بريدك لاستلام كشوف الحساب اليومية.' : (test ? 'نسخة تجريبية من كشف حسابك مرفقة بهذه الرسالة.' : 'كشف حسابك ليوم '+day+' مرفق بصيغة PDF.') %></div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#eef2f8;"><tr><td align="center" style="padding:24px 10px;">
<table role="presentation" class="email-shell" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background:#fff;border:1px solid #dce4ef;border-radius:22px;overflow:hidden;">
<tr><td style="height:4px;background:#d5ad60;font-size:0;line-height:0;">&nbsp;</td></tr>
<tr><td class="email-pad" style="padding:24px 32px;background:#112644;color:#fff;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td width="80" valign="middle"><img class="email-logo" src="cid:ahram-report-logo" width="64" height="64" alt="شعار أهرام باي" style="display:block;width:64px;height:64px;border:0;border-radius:12px;background:#fff;"></td><td valign="middle" style="text-align:right;"><div dir="ltr" style="color:#fff;font-size:19px;font-weight:bold;text-align:right;">AL-AHRAM Pay</div><div style="margin-top:5px;color:#cfdaea;font-size:12px;line-height:20px;">حسابك المالي، بوضوح</div></td></tr></table>
</td></tr>
<tr><td class="email-pad" style="padding:32px;line-height:1.9;text-align:right;">
<div style="margin-bottom:10px;color:#42689a;font-size:12px;font-weight:bold;"><%= enrollment ? 'تفعيل التحقق بالبريد' : login ? 'رمز تسجيل الدخول' : mode === 'code' ? 'تأكيد البريد الإلكتروني' : (test ? 'رسالة تجريبية · PDF' : 'التقفيل اليومي · PDF') %></div>
<h1 class="email-title" style="margin:0 0 12px;color:#132d50;font-size:28px;line-height:1.5;"><%= enrollment ? 'فعّل حماية الدخول بالبريد' : login ? 'أكمل تسجيل الدخول بأمان' : mode === 'code' ? 'خطوة واحدة لتفعيل بريدك' : 'كشف حسابك جاهز' %></h1>
<p style="margin:0 0 20px;color:#52647d;font-size:14px;line-height:1.9;">مرحبًا<% if(accountName){ %>، <strong style="color:#172b49;"><%= accountName %></strong><% } %>.<br><%= enrollment ? 'أكّدت كلمة مرورك. أدخل الرمز في أمان الحساب لتفعيل كود البريد عند كل تسجيل دخول.' : login ? 'تلقّينا طلبًا لتسجيل الدخول إلى حسابك. استخدم الرمز التالي لإكمال الدخول.' : mode === 'code' ? 'استخدم الرمز التالي لتأكيد بريدك واستلام كشف الحساب اليومي.' : (test ? 'هذه نسخة تجريبية لمراجعة شكل الكشف والتأكد من وصوله إلى بريدك.' : 'نرفق لك كشف الحساب الكامل لليوم الموضح أدناه، من التقارير الشاملة للإدارة.') %></p>
<% if(otpMessage){ %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f0f5ff;border:1px solid #d9e5fa;border-radius:14px;"><tr><td align="center" style="padding:20px 10px;"><div style="font-size:12px;color:#526b90;margin-bottom:6px;"><%= enrollment ? 'رمز تفعيل حماية البريد' : login ? 'رمز التحقق لتسجيل الدخول' : 'رمز تأكيد البريد' %></div><div class="email-code" dir="ltr" style="font-family:Consolas,'Courier New',monospace;font-weight:bold;font-size:40px;letter-spacing:9px;line-height:1.4;color:#1457bb;white-space:nowrap;unicode-bidi:isolate;"><%= code %></div><div style="margin-top:8px;color:#526b90;font-size:12px;">صالح لمدة <%= login ? expiresPhrase : '10 دقائق' %></div></td></tr></table>
<p style="margin:20px 0;color:#52647d;font-size:13px;"><% if(enrollment){ %>أدخل الرمز في <strong>أمان الحساب ← التحقق عبر البريد الإلكتروني</strong> لإكمال التفعيل.<% }else if(login){ %>ارجع إلى <strong style="color:#172b49;">شاشة تسجيل الدخول المفتوحة</strong> وأدخل الرمز بالترتيب الظاهر أعلاه.<% }else{ %>أدخل الرمز في <strong style="color:#172b49;">الإعدادات ← الإشعارات</strong> لإكمال التفعيل.<% } %></p>
<% }else{ %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f0f5ff;border:1px solid #d9e5fa;border-radius:14px;"><tr><td style="padding:18px 20px;"><div style="color:#526b90;font-size:12px;">تاريخ كشف الحساب</div><div dir="ltr" style="margin:6px 0;font-size:27px;line-height:1.5;font-weight:bold;color:#1457bb;text-align:right;"><%= displayDay %></div><div style="font-size:12px;color:#526b90;">كامل اليوم بتوقيت ليبيا · حساب <%= accountLabel %></div></td></tr></table>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:16px;border:1px solid #dce4ef;border-radius:12px;"><tr><td style="padding:16px 20px;"><strong style="font-size:14px;color:#172b49;">كشف الحساب مرفق بهذه الرسالة</strong><div dir="ltr" style="margin:5px 0;color:#52647d;font-size:12px;word-break:break-all;text-align:right;"><%= filename %></div><div style="color:#52647d;font-size:12px;">افتح مرفق PDF من تطبيق البريد لعرض الحركات والأرصدة.</div></td></tr></table>
<% } %>
<% if(login){ if(attemptRows.length){ %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:20px;border:1px solid #dce4ef;border-radius:12px;"><tr><td style="padding:16px 18px;color:#52647d;font-size:12px;line-height:1.9;"><strong style="color:#172b49;font-size:13px;">تفاصيل محاولة الدخول</strong><% attemptRows.forEach(row=>{ %><div style="margin-top:5px;"><%= row.label %>: <span dir="<%= row.ltr ? 'ltr' : 'rtl' %>"><%= row.value %></span><%= row.label === 'وقت المحاولة' ? ' · توقيت ليبيا' : '' %></div><% }); %></td></tr></table>
<% }}else{ %><table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:22px;"><tr><td bgcolor="#185cc4" style="border-radius:10px;text-align:center;"><a href="<%= settingsUrl %>" style="display:inline-block;padding:13px 24px;border:1px solid #185cc4;border-radius:10px;color:#fff;text-decoration:none;font-size:14px;line-height:22px;font-weight:bold;"><%= mode === 'code' ? 'فتح إعدادات البريد' : 'إدارة الكشوف اليومية' %></a></td></tr></table><% } %>
<div style="margin-top:24px;padding-top:18px;border-top:1px solid #e5ebf3;color:#6a7890;font-size:12px;line-height:1.9;"><% if(otpMessage){ %><strong style="color:#172b49;">لا تشارك الرمز مع أي شخص.</strong><br><% if(enrollment){ %>هذا الرمز خاص بتفعيل حماية الدخول بالبريد، وليس لكشف الحساب. إذا لم تطلب التفعيل، غيّر كلمة مرورك وراجع الأجهزة والجلسات.<% }else if(login){ %>لن يطلب منك فريق الدعم هذا الرمز. إذا لم تبدأ محاولة الدخول، غيّر كلمة المرور من الموقع الرسمي وراجع الأجهزة والجلسات.<% }else{ %>هذا الرمز خاص بتأكيد بريد الكشوف، ولا يغيّر بيانات تسجيل الدخول. إذا لم تطلبه، يمكنك تجاهل الرسالة.<% }}else{ %>يمكنك تغيير البريد أو إيقاف الكشوف اليومية من إعدادات الإشعارات في حسابك.<% } %></div>
</td></tr>
<tr><td class="email-pad" style="padding:20px 32px;background:#f8fafc;border-top:1px solid #e5ebf3;text-align:center;color:#77869b;font-size:11px;line-height:1.9;"><strong style="color:#304761;"><%= brand.name %></strong><br>رسالة آلية لحسابك — للاستفسار: <span dir="ltr"><%= brand.supportEmail %></span></td></tr>
</table>
<div style="padding-top:16px;text-align:center;color:#8b98aa;font-size:11px;">خدمات مالية أقرب إليك</div>
</td></tr></table>
</body></html>
