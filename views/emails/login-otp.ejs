<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <title>رمز التحقق لتسجيل الدخول | أهرام باي</title>
</head>
<body style="margin:0;padding:0;background:#edf1f0;color:#17211f;font-family:Tahoma,Arial,sans-serif;direction:rtl;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;font-size:1px;line-height:1px;">
    رمز التحقق الخاص بك هو <span dir="ltr" style="direction:ltr;unicode-bidi:embed;"><%= otp %></span>. صالح لمدة <%= expiresPhrase %>.
  </div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#edf1f0;">
    <tr><td align="center" style="padding:30px 12px;">
      <table role="presentation" width="620" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:620px;background:#fff;border:1px solid #d9e0dd;border-collapse:separate;">
        <tr><td style="height:6px;background:#c6a04a;font-size:0;line-height:0;">&nbsp;</td></tr>
        <tr><td style="padding:24px 30px;background:#0c3433;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr>
            <td width="84" valign="middle"><%_ if (logoSrc) { _%>
              <img src="<%= logoSrc %>" width="72" height="72" alt="<%= logoAlt %>" style="display:block;width:72px;height:72px;border:1px solid #efd890;outline:none;text-decoration:none;">
              <%_ } else { _%>
              <table role="presentation" width="48" cellspacing="0" cellpadding="0" border="0" style="width:48px;height:48px;background:#c6a04a;border:1px solid #efd890;"><tr><td align="center" valign="middle" style="color:#0c3433;font-family:Georgia,'Times New Roman',serif;font-size:20px;font-weight:700;line-height:48px;direction:ltr;">AP</td></tr></table>
              <%_ } _%></td>
            <td valign="middle"><div style="color:#fff;font-size:21px;font-weight:700;line-height:29px;">أهرام باي</div><div style="margin-top:3px;color:#bfd0cc;font-size:12px;line-height:18px;">بوابتك الآمنة للعمليات المالية</div></td>
          </tr></table>
        </td></tr>
        <tr><td style="padding:36px 36px 12px;text-align:right;">
          <div style="margin-bottom:10px;color:#9b7628;font-size:12px;font-weight:700;line-height:18px;">التحقق بخطوتين</div>
          <h1 style="margin:0 0 12px;color:#102a29;font-size:27px;font-weight:700;line-height:39px;">أكمل تسجيل الدخول إلى حسابك</h1>
          <p style="margin:0;color:#55605d;font-size:15px;line-height:27px;">مرحبًا <strong style="color:#17211f;"><%= accountName || 'بك' %></strong>، تلقينا محاولة تسجيل دخول إلى حسابك. استخدم رمز التحقق التالي لإكمال العملية بأمان.</p>
        </td></tr>
        <tr><td style="padding:20px 36px 12px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f7f4ea;border:1px solid #dbc581;">
            <tr><td style="height:5px;background:#c6a04a;font-size:0;line-height:0;">&nbsp;</td></tr>
            <tr><td align="center" style="padding:23px 16px 7px;color:#806524;font-size:12px;font-weight:700;line-height:18px;">رمز التحقق لمرة واحدة</td></tr>
            <tr><td dir="ltr" align="center" style="padding:3px 12px 11px;color:#0c3433;font-family:'Courier New',Courier,monospace;font-size:43px;font-weight:700;line-height:54px;direction:ltr;unicode-bidi:embed;letter-spacing:8px;"><%= otp %></td></tr>
            <tr><td align="center" style="padding:0 16px 22px;color:#6b706d;font-size:12px;line-height:19px;">ينتهي خلال <strong style="color:#17211f;"><%= expiresPhrase %></strong></td></tr>
          </table>
        </td></tr>
        <%_ if (attemptRows.length) { _%>
        <tr><td style="padding:0 36px 18px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f8f6f1;border:1px solid #e6d7a8;">
            <tr><td style="padding:14px 16px 4px;color:#0c3433;font-size:13px;font-weight:700;line-height:20px;">تفاصيل المحاولة</td></tr>
            <%_ attemptRows.forEach(function (row) { _%>
            <tr><td style="padding:0 16px 10px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr>
                <td width="118" valign="top" style="width:118px;color:#806524;font-size:12px;font-weight:700;line-height:20px;"><%= row.label %></td>
                <td valign="top" style="color:#17211f;font-size:13px;line-height:20px;"><% if (row.ltr) { %><span dir="ltr" style="direction:ltr;unicode-bidi:embed;white-space:nowrap;"><%= row.value %></span><% } else { %><%= row.value %><% } %></td>
              </tr></table>
            </td></tr>
            <%_ }); _%>
            <tr><td style="height:4px;font-size:0;line-height:0;">&nbsp;</td></tr>
          </table>
        </td></tr>
        <%_ } _%>
        <tr><td style="padding:8px 36px 26px;">
          <h2 style="margin:0 0 13px;color:#102a29;font-size:17px;font-weight:700;line-height:26px;">طريقة استخدام الرمز</h2>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
            <tr><td width="34" valign="top" style="padding-bottom:12px;"><div style="width:26px;height:26px;background:#0c3433;color:#fff;text-align:center;font-size:13px;font-weight:700;line-height:26px;">1</div></td><td valign="top" style="padding:1px 10px 12px 0;color:#4e5956;font-size:14px;line-height:24px;">ارجع إلى شاشة تسجيل الدخول المفتوحة في موقع أو تطبيق أهرام باي.</td></tr>
            <tr><td width="34" valign="top" style="padding-bottom:12px;"><div style="width:26px;height:26px;background:#0c3433;color:#fff;text-align:center;font-size:13px;font-weight:700;line-height:26px;">2</div></td><td valign="top" style="padding:1px 10px 12px 0;color:#4e5956;font-size:14px;line-height:24px;">أدخل <%= otpDigitsPhrase %> في خانة «رمز التحقق» بنفس الترتيب الظاهر أعلاه.</td></tr>
            <tr><td width="34" valign="top"><div style="width:26px;height:26px;background:#0c3433;color:#fff;text-align:center;font-size:13px;font-weight:700;line-height:26px;">3</div></td><td valign="top" style="padding:1px 10px 0 0;color:#4e5956;font-size:14px;line-height:24px;">اضغط «تأكيد الدخول». لا يمكن استخدام الرمز مرة أخرى بعد نجاح التحقق.</td></tr>
          </table>
        </td></tr>
        <tr><td style="padding:0 36px 28px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f2f6f5;border-right:4px solid #18756f;"><tr><td style="padding:17px 18px;">
            <div style="margin-bottom:7px;color:#0c3433;font-size:14px;font-weight:700;line-height:22px;">نصائح لحماية حسابك</div>
            <div style="color:#53605d;font-size:13px;line-height:23px;">• لا تشارك الرمز مع أي شخص، حتى لو ادعى أنه من فريق الدعم.<br>• لن نطلب منك الرمز عبر الهاتف أو الرسائل أو روابط خارجية.<br>• تأكد أن عنوان الموقع يبدأ بـ <span dir="ltr" style="direction:ltr;unicode-bidi:embed;">ahrampay.com</span> قبل إدخال الرمز.<br>• إذا لم تبدأ محاولة الدخول، غيّر كلمة المرور وتواصل معنا فورًا.</div>
          </td></tr></table>
        </td></tr>
        <tr><td style="padding:25px 30px;background:#0c3433;text-align:right;">
          <div style="margin-bottom:16px;color:#fff;font-size:15px;font-weight:700;line-height:23px;">تواصل مع أهرام باي</div>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
            <tr><td width="50%" valign="top" style="padding:0 0 12px;color:#9fb7b2;font-size:11px;line-height:18px;">البريد الإلكتروني<br><a href="mailto:<%= contactEmail %>" dir="ltr" style="color:#f0d687;text-decoration:none;font-size:13px;direction:ltr;unicode-bidi:embed;white-space:nowrap;"><span dir="ltr" style="direction:ltr;unicode-bidi:embed;"><%= contactEmail %></span></a></td><td width="50%" valign="top" style="padding:0 18px 12px 0;color:#9fb7b2;font-size:11px;line-height:18px;">الهاتف<br><a href="<%= contactPhoneLink %>" dir="ltr" style="color:#f0d687;text-decoration:none;font-size:13px;direction:ltr;unicode-bidi:embed;white-space:nowrap;"><span dir="ltr" style="direction:ltr;unicode-bidi:embed;"><%= contactPhone %></span></a></td></tr>
            <tr><td width="50%" valign="top" style="color:#9fb7b2;font-size:11px;line-height:18px;">الموقع الإلكتروني<br><a href="<%= websiteUrl %>" dir="ltr" style="color:#f0d687;text-decoration:none;font-size:13px;direction:ltr;unicode-bidi:embed;white-space:nowrap;"><span dir="ltr" style="direction:ltr;unicode-bidi:embed;"><%= websiteLabel || websiteUrl %></span></a></td><td width="50%" valign="top" style="padding-right:18px;color:#9fb7b2;font-size:11px;line-height:18px;">العنوان<br><span style="color:#dce7e4;font-size:12px;"><%= contactAddress %></span></td></tr>
          </table>
        </td></tr>
        <tr><td style="padding:17px 26px;background:#082625;text-align:center;color:#8fa8a3;font-size:10px;line-height:18px;">هذه رسالة آلية مخصصة لأمان حسابك، يرجى عدم الرد عليها.<br><span dir="ltr" style="direction:ltr;unicode-bidi:embed;white-space:nowrap;">© <%= year %></span> أهرام باي. جميع الحقوق محفوظة.</td></tr>
        <tr><td style="height:5px;background:#c6a04a;font-size:0;line-height:0;">&nbsp;</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
