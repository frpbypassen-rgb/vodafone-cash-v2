<% const portalBasePath = locals.portalBasePath || '/client'; const portalHref = value => typeof value === 'string' && (value === '/client' || value.startsWith('/client/') || value.startsWith('/client?')) ? portalBasePath + value.slice(7) : value; %>
<section class="cp-page-hero">
    <div>
        <span class="bw-section-kicker">تمويل الحساب</span>
        <h2>إيداعات الشركة</h2>
        <p><%= workspace.permissions.manager ? 'يصل الطلب للإدارة عبر الدعم الفني. لا يُضاف الرصيد إلا بعد الاعتماد.' : 'هذه الصفحة للمتابعة المالية. إنشاء طلب جديد يبقى لدى مدير التشغيل.' %></p>
    </div>
    <div class="cp-page-hero-actions">
        <% if (workspace.permissions.canViewBalance) { %>
            <a href="<%= portalBasePath %>/finance" class="bw-button ghost"><i class="fa-solid fa-scale-balanced"></i>مكتب المحاسبة</a>
        <% } %>
    </div>
</section>
<% if (workspace.permissions.canViewBalance) { %><div class="cm-deposit-balance"><i class="fa-solid fa-wallet"></i><span>رصيد حساب الشركة بالدينار الليبي<strong dir="ltr"><%= Number(workspace.entity.balance || 0).toFixed(3) %> LYD</strong></span></div><% } %>
<section class="cp-deposit-layout">
    <% if (workspace.permissions.manager) { %>
    <details class="bw-section cm-deposit-request"><summary><span><i class="fa-solid fa-plus"></i> طلب إيداع جديد</span><small>أدخل المبلغ ومرجع التحويل</small></summary>
        <header class="bw-section-head">
            <div><span class="bw-section-kicker">تمويل الحساب</span><h2>طلب إيداع جديد</h2></div>
            <span class="bw-meta-chip"><%= pendingDepositCount || 0 %> قيد المراجعة</span>
        </header>
        <form id="companyDepositForm" class="bw-form bw-form-grid">
            <label class="bw-field"><span>القيمة بالدينار</span><input type="number" name="amount" id="companyDepositAmount" min="1" step="0.01" required></label>
            <label class="bw-field span-2"><span>مرجع التحويل أو البيان</span><textarea name="note" id="companyDepositNote" rows="3" minlength="3" maxlength="1000" required placeholder="رقم الحوالة أو اسم البنك أو أي مرجع يوضح الإيداع"></textarea></label>
            <div class="bw-form-actions span-2"><button type="submit" class="bw-button primary" id="companyDepositSubmit"><i class="fa-solid fa-building-columns"></i>إرسال طلب الإيداع</button></div>
        </form>
        <div class="bw-form-result" id="companyDepositResult" hidden></div>
    </details>
    <% } else { %>
    <article class="bw-section">
        <header class="bw-section-head">
            <div><span class="bw-section-kicker">تمويل الحساب</span><h2>متابعة بلا إنشاء</h2></div>
            <span class="bw-meta-chip"><%= pendingDepositCount || 0 %> قيد المراجعة</span>
        </header>
        <p class="bw-muted">هذه الشاشة للمتابعة المالية فقط. إنشاء طلب إيداع يبقى لدى مدير التشغيل، والسجل على اليسار يعرض الحالة بعد الاعتماد.</p>
    </article>
    <% } %>
    <aside class="bw-section cm-deposit-history">
        <header class="bw-section-head"><div><span class="bw-section-kicker">سجل التمويل</span><h2>متابعة طلبات الإيداع</h2></div></header>
        <nav class="cm-deposit-filters" aria-label="تصفية طلبات الإيداع"><button type="button" data-deposit-filter="all" aria-pressed="true">الكل (<%= (depositRequests || []).length %>)</button><button type="button" data-deposit-filter="deposit_pending" aria-pressed="false">قيد المراجعة (<%= (depositRequests || []).filter(item => item.status === 'deposit_pending').length %>)</button><button type="button" data-deposit-filter="deposit" aria-pressed="false">معتمد (<%= (depositRequests || []).filter(item => item.status === 'deposit').length %>)</button></nav><p class="cm-muted" data-deposit-empty hidden>لا توجد طلبات بهذه الحالة.</p>
<div class="cp-work-list">
            <% if (!(depositRequests || []).length) { %>
                <div class="bw-empty compact"><i class="fa-solid fa-building-columns"></i><strong>لا توجد طلبات بعد</strong></div>
            <% } %>
            <% (depositRequests || []).forEach(item => { const status = statusMeta[item.status] || { label: item.status, tone: 'neutral' }; %>
                <article class="cp-work-card cm-deposit-card" data-deposit-status="<%= item.status %>">
                    <div class="cp-work-main">
                        <span class="cp-work-icon"><i class="fa-solid <%= item.source === 'support' ? 'fa-headset' : 'fa-receipt' %>"></i></span>
                        <div>
                            <strong class="bw-mono"><%= item.customId %></strong>
                            <small><%= status.label %><%= item.note ? ` · ${item.note}` : '' %></small>
                        </div>
                        <b class="bw-mono"><%= Number(item.amount || 0).toFixed(2) %> <em>LYD</em></b>
                        <span class="bw-status <%= status.tone %>"><%= status.label %></span>
                    </div>
                    <% if (item.status === 'deposit' || item.status === 'deposit_pending') { %>
                    <ol class="cm-deposit-track" aria-label="حالة طلب الإيداع"><li class="done"><i class="fa-solid fa-check"></i>تم التسجيل</li><li class="<%= item.status === 'deposit' ? 'done' : 'current' %>"><i class="fa-solid fa-magnifying-glass"></i><%= item.status === 'deposit' ? 'تمت المراجعة' : 'بانتظار مراجعة الإدارة' %></li><li class="<%= item.status === 'deposit' ? 'done' : '' %>"><i class="fa-solid fa-wallet"></i><%= item.status === 'deposit' ? 'تم اعتماد الإيداع' : 'بانتظار اعتماد الرصيد' %></li></ol>
                    <% } %>
                </article>
            <% }) %>
        </div>
        <a href="<%= portalBasePath %>/finance" class="bw-text-link">فتح مكتب المحاسبة <i class="fa-solid fa-arrow-left"></i></a>
    </aside>
</section>
