<% const portalBasePath = locals.portalBasePath || '/client'; const portalHref = value => typeof value === 'string' && (value === '/client' || value.startsWith('/client/') || value.startsWith('/client?')) ? portalBasePath + value.slice(7) : value; %>
<% const accountCode = workspace.entity.accountCode || workspace.entity.agentCode || '---'; const canEdit = workspace.permissions.canEditSettings; %>

<% if (workspace.isCompany || workspace.isAgent) { %>
<section class="cp-page-hero">
    <div>
        <span class="bw-section-kicker">ملف <%= workspace.entityLabel %></span>
        <h2><%= workspace.isCompany ? 'الإعدادات' : 'بيانات ' + workspace.entityLabel %></h2>
        <p data-settings-context>التواصل والمدينة والسجل في هذه الصفحة. كلمة المرور والأجهزة في أمان الحساب.</p>
    </div>
    <% if (!workspace.isAgent && !workspace.isCompany) { %>
    <div class="cp-page-hero-actions">
        <a href="<%= portalBasePath %>/security" class="bw-button ghost"><i class="fa-solid fa-shield-halved"></i>أمان الحساب</a>
    </div>
    <% } %>
</section>
<% } else { %>
<section class="bw-settings-hero">
    <div><span class="bw-section-kicker"><i class="fa-solid fa-sliders"></i> مركز التحكم</span><h2>إعدادات <%= workspace.entityLabel %></h2><p>كل قسم مستقل في هذه الصفحة. لا تبويبات ولا اختصارات مكررة.</p></div>
    <div class="bw-settings-health">
        <span><i class="fa-solid fa-circle-check"></i> الحساب نشط</span>
        <span><i class="fa-solid fa-signal"></i> <%= systemOpen ? 'الخدمة متاحة' : 'الخدمة متوقفة' %></span>
    </div>
</section>
<% } %>

<section class="bw-settings-health-grid cm-settings-account-info" aria-label="ملخص الحساب">
    <article><span class="tone-blue"><i class="fa-solid fa-id-card"></i></span><div><small>رقم الحساب</small><strong class="bw-mono"><%= accountCode %></strong></div></article>
    <article><span class="tone-green"><i class="fa-solid fa-user-shield"></i></span><div><small>دورك الحالي</small><strong><%= workspace.roleLabel %></strong></div></article>
    <% if (workspace.permissions.canViewBalance) { %>
    <article><span class="tone-gold"><i class="fa-solid fa-wallet"></i></span><div><small>الحد الائتماني</small><strong class="bw-mono"><%= Number(workspace.entity.creditLimit || 0).toFixed(2) %> LYD</strong></div></article>
    <% } %>
    <article><span class="tone-violet"><i class="fa-solid fa-building-shield"></i></span><div><small>اسم الدخول</small><strong dir="ltr"><%= workspace.actor.webUsername || workspace.actor.phone %></strong></div></article>
</section>

<% if (workspace.isCompany || workspace.isAgent) { %>
<nav class="cm-settings-categories" aria-label="أقسام الإعدادات">
<a href="#identity"><i class="fa-solid fa-building"></i><strong>بيانات <%= workspace.entityLabel %></strong><span>التواصل والعنوان والسجل</span></a>
<a href="#preferences"><i class="fa-solid fa-palette"></i><strong>المظهر</strong><span>الوضع النهاري والليلي</span></a>
<a href="#notifications"><i class="fa-solid fa-bell"></i><strong>الإشعارات</strong><span>تفضيلات التنبيهات</span></a>
<a href="#integrations"><i class="fa-solid fa-plug"></i><strong>التكاملات</strong><span>الربط مع أنظمة منشأتك</span></a>
<% if (workspace.isAgent || workspace.isCompany) { %><a href="<%= portalBasePath %>/security"><i class="fa-solid fa-shield-halved"></i><strong>أمان الحساب</strong><span>كلمة المرور والتحقق الثنائي</span></a><a href="#services"><i class="fa-solid fa-tags"></i><strong>أسعار الخدمات</strong><span>الأسعار الفعالة لحساب <%= workspace.isCompany ? 'الشركة' : 'الوكيل' %></span></a><% } %>
</nav><button type="button" class="bw-button ghost cm-settings-back" data-settings-back hidden><i class="fa-solid fa-arrow-right"></i> جميع الإعدادات</button><% } %>
<div class="bw-settings-stack">
    <section class="bw-settings-panel active" id="identity">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-blue"><i class="fa-solid fa-address-card"></i></span><div><span>الحساب والملف الشخصي</span><h2>بيانات <%= workspace.entityLabel %></h2><p>معلومات التواصل المستخدمة داخل المنظومة.</p></div></header>
        <form method="POST" action="<%= portalBasePath %>/settings/profile" class="bw-form bw-form-grid">
            <input type="hidden" name="profileRevision" value="<%= workspace.entity.profileRevision || 0 %>">
            <label class="bw-field span-2"><span>اسم <%= workspace.entityLabel %></span><input type="text" value="<%= workspace.entity.name %>" disabled><small>يتم تعديل الاسم القانوني عن طريق الإدارة.</small></label>
            <label class="bw-field"><span>اسم مسؤول التواصل</span><input type="text" name="contactName" value="<%= settingsData.profile.contactName || '' %>" maxlength="120" <%= canEdit ? '' : 'disabled' %>></label><label class="bw-field"><span>رقم التواصل</span><input type="tel" name="phone" value="<%= workspace.entity.phone || '' %>" dir="ltr" maxlength="32" <%= canEdit ? '' : 'disabled' %>></label>
            <label class="bw-field"><span>البريد الإلكتروني</span><input type="text" inputmode="email" autocapitalize="none" spellcheck="false" name="email" value="<%= settingsData.profile.email || '' %>" dir="ltr" maxlength="254" data-account-email="profile" <%= canEdit ? '' : 'disabled' %>></label>
            <%- include('../../partials/required_owner_email_script') %><label class="bw-field"><span>المدينة</span><input type="text" name="city" value="<%= settingsData.profile.city || '' %>" maxlength="80" <%= canEdit ? '' : 'disabled' %>></label>
            <label class="bw-field span-2"><span>العنوان</span><input type="text" name="address" value="<%= settingsData.profile.address || '' %>" maxlength="240" <%= canEdit ? '' : 'disabled' %>></label><label class="bw-field span-2"><span>رقم السجل أو الترخيص</span><input type="text" name="registrationNumber" value="<%= settingsData.profile.registrationNumber || '' %>" maxlength="80" <%= canEdit ? '' : 'disabled' %>></label>
            <% if (canEdit) { %><div class="bw-form-actions span-2"><button type="submit" class="bw-button primary"><i class="fa-solid fa-floppy-disk"></i>حفظ بيانات الحساب</button></div><% } else { %><p class="bw-setting-note span-2"><i class="fa-solid fa-lock"></i>لا تملك صلاحية تعديل بيانات المنشأة.</p><% } %>
        </form>
    </section>

    <section class="bw-settings-panel" id="preferences">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-violet"><i class="fa-solid fa-palette"></i></span><div><span>المظهر والتجربة</span><h2>مظهر الحساب</h2><p><%= workspace.isCompany ? 'يُحفظ اختيارك على الحساب ويظهر عند الدخول من الهاتف أو الكمبيوتر.' : 'يُحفظ اختيارك على حساب الوكيل ويتبعك على الهاتف والكمبيوتر.' %></p></div></header>
        <div class="bw-settings-choice-grid">
            <% if (workspace.isCompany || workspace.isAgent) { %>
            <label class="bw-field"><span>مظهر البوابة</span><select id="workspaceThemeSelect" data-preference="company-theme"><option value="day">نهاري</option><option value="night">ليلي</option><option value="pharaonic">فرعوني</option></select></label>
            <% } else { %>
            <label class="bw-field"><span>مظهر بوابة العملاء</span><select id="workspaceThemeSelect" data-preference="client-theme"><option value="day">نهاري</option><option value="night">ليلي</option><option value="pharaonic">فرعوني</option></select></label>
            <% } %>
            <% if (!workspace.isCompany) { %>
            <label class="bw-field"><span>كثافة الجداول</span><select id="workspaceDensitySelect" <% if (workspace.isAgent) { %>data-server-density<% } else { %>data-preference="density"<% } %> data-base="<%= portalBasePath %>" data-revision="<%= workspace.actor.displayRevision || 0 %>"><option value="comfortable" <%= workspace.actor.preferences?.density !== 'compact' ? 'selected' : '' %>>مريحة</option><option value="compact" <%= workspace.actor.preferences?.density === 'compact' ? 'selected' : '' %>>مضغوطة</option></select></label>
            <% } %>
        </div>
        <div class="bw-setting-note"><i class="fa-solid fa-display"></i><span><strong>تفضيل الحساب</strong><small>يُطبّق مظهر حسابك عند تسجيل الدخول، ويمكنك تغييره في أي وقت.</small></span></div>
    </section>

    <section class="bw-settings-panel" id="notifications">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-gold"><i class="fa-solid fa-bell"></i></span><div><span>الإشعارات</span><h2>تنبيهات هذا الجهاز</h2><p>اختر القنوات التي تريد استخدامها للتنبيهات التشغيلية.</p></div></header>
        <div class="bw-notification-choices">
            <label><span><i class="fa-solid fa-mobile-screen"></i><b><%= 'إشعارات ويب' %></b><small>العمليات وتغير الأسعار</small></span><input type="checkbox" <% if (workspace.isAgent || workspace.isCompany) { %>data-server-notifications<% } else { %>data-notification-preference="push" checked<% } %> data-base="<%= portalBasePath %>"></label>
            <% if (workspace.isAgent || workspace.isCompany) { %><p data-notification-device-result role="status" aria-live="polite"></p><div class="agent-push-test" data-agent-push-test-controls hidden><button type="button" class="bw-button ghost compact" data-agent-push-test><i class="fa-solid fa-bell" aria-hidden="true"></i>اختبار الإشعارات</button><span data-agent-push-test-status role="status" aria-live="polite"></span></div><% } %>
            <% if (!workspace.isAgent && !workspace.isCompany) { %>
            <label><span><i class="fa-solid fa-envelope"></i><b>البريد الإلكتروني</b><small>التقارير والتنبيهات المهمة</small></span><input type="checkbox" data-notification-preference="email"></label>
            <% } %>
            <% if (!workspace.isAgent && !workspace.isCompany) { %>
            <label><span><i class="fa-solid fa-comment-sms"></i><b>SMS</b><small>تنبيهات الأمان فقط</small></span><input type="checkbox" data-notification-preference="sms"></label>
            <% } %>
        </div>
        <% if (workspace.isAgent) { %>
        <% if (workspace.permissions.canEditSettings) { %>
        <%- include('../../agent/partials/telegram_settings') %>
        <% } %>
        <% if (workspace.permissions.canViewReports && workspace.permissions.canViewBalance && workspace.permissions.canViewAllReports) { %>
        <%- include('../../agent/partials/report_email_settings') %>
        <% } else { %>
        <p class="bw-muted">كشف الإدارة الشامل بالبريد متاح للحسابات التي تملك صلاحية الاطلاع على حساب الوكالة بالكامل.</p>
        <% } %>
        <% } else if(workspace.isCompany) { %>
        <% if(workspace.permissions.canEditSettings) { %><%- include('../../company/partials/telegram_settings') %><% } %>
        <% if(workspace.permissions.canViewReports && workspace.permissions.canViewBalance && (!workspace.permissions.employee || workspace.permissions.canViewAllReports)) { %><%- include('../../company/partials/report_email_settings') %><% } %>
        <% } %>
    </section>

    <% if (workspace.isCompany || workspace.isAgent) { %>
    <section class="bw-settings-panel" id="integrations">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-violet"><i class="fa-solid fa-plug"></i></span><div><span>التكاملات</span><h2>ربط أنظمتك الخارجية</h2><p>حالة API وإشعارات Webhooks وفحص جاهزية الربط.</p></div></header>
        <%- include('../partials/merchant_integrations') %>
    </section>
    <% } %>

    <% if (!workspace.isCompany) { %>
    <section class="bw-settings-panel bw-settings-security" id="security">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-green"><i class="fa-solid fa-shield-halved"></i></span><div><span>الأمان والدخول</span><h2>حماية الحساب</h2><p>استخدم كلمة مرور قوية وراجع الأجهزة المسجلة بانتظام.</p></div></header>
        <div class="bw-settings-security-grid"><form method="POST" action="<%= portalBasePath %>/settings/password" class="bw-form bw-form-grid"><label class="bw-field span-2"><span>كلمة المرور الحالية</span><input type="password" name="currentPassword" autocomplete="current-password" required></label><label class="bw-field"><span>كلمة المرور الجديدة</span><input type="password" name="newPassword" minlength="8" autocomplete="new-password" required></label><label class="bw-field"><span>تأكيد كلمة المرور</span><input type="password" name="passwordConfirm" minlength="8" autocomplete="new-password" required></label><div class="bw-form-actions span-2"><button type="submit" class="bw-button secondary"><i class="fa-solid fa-key"></i>تحديث كلمة المرور</button><a class="bw-button ghost" href="/security/sessions"><i class="fa-solid fa-laptop-mobile"></i>الأجهزة والجلسات</a></div></form><%- include('../../partials/mfa_security_panel') %></div>
    </section>
    <% } %>

    <section class="bw-settings-panel" id="services">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-gold"><i class="fa-solid fa-tags"></i></span><div><span>الخدمات والأسعار</span><h2>الأسعار الفعالة لحسابك</h2><p>يتم تحديدها مركزياً بحسب باقة الحساب وصلاحياته.</p></div></header>
        <div class="bw-rate-list"><% serviceCatalog.forEach(service => { %><div class="bw-rate-row"><span class="bw-service-icon tone-<%= service.tone %>"><i class="fa-solid <%= service.icon %>"></i></span><div><strong><%= service.label %></strong><small><%= service.description %></small></div><strong class="bw-mono"><%= Number(service.rate).toFixed(2) %></strong></div><% }) %></div>
    </section>
</div>
