<% const portalBasePath = locals.portalBasePath || '/client'; const portalHref = value => typeof value === 'string' && (value === '/client' || value.startsWith('/client/') || value.startsWith('/client?')) ? portalBasePath + value.slice(7) : value; %>
<section class="cp-page-hero">
    <div>
        <span class="bw-section-kicker">أمان الحساب</span>
        <h2>أمان الحساب</h2>
        <p>كلمة المرور وAuthenticator والأجهزة في صفحة مستقلة. بيانات المنشأة تبقى في ملف المنشأة.</p>
    </div>
    <% if (!workspace.isAgent) { %>
    <div class="cp-page-hero-actions">
        <a href="<%= portalBasePath %>/settings" class="bw-button ghost"><i class="fa-solid fa-address-card"></i>بيانات المنشأة</a>
        <a href="/security/sessions" class="bw-button ghost"><i class="fa-solid fa-laptop-mobile"></i>الأجهزة والجلسات</a>
    </div>
    <% } %>
</section>

<% if (workspace.isAgent) { %>
<a href="<%= portalBasePath %>/settings#settings" class="bw-button ghost cm-settings-back"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i> جميع الإعدادات</a>
<% } %>

<% if (workspace.isCompany || workspace.isAgent) { %>
<% if (!workspace.isAgent) { %><div class="cm-security-banner"><i class="fa-solid fa-shield-halved"></i><div><h2>مركز أمان الحساب</h2><p>راجع كلمة المرور والتحقق الثنائي والجلسات لحماية حسابك.</p></div></div><% } %>
<nav class="cm-security-cards" aria-label="خيارات الأمان">
<a href="#companyPassword"><i class="fa-solid fa-key"></i><strong>كلمة المرور</strong><span>تحديث كلمة مرور الدخول</span></a>
<a href="#companyMfa"><i class="fa-solid fa-shield-halved"></i><strong>التحقق الثنائي</strong><span>مراجعة حماية Authenticator</span></a>
<a href="/security/sessions"><i class="fa-solid fa-laptop-mobile"></i><strong>الأجهزة والجلسات</strong><span>مراجعة جلساتك النشطة</span></a>
</nav><% } %>
<div class="bw-settings-stack">
    <section class="bw-settings-panel active bw-settings-security" id="security">
        <header class="bw-settings-panel-head"><span class="bw-settings-panel-icon tone-green"><i class="fa-solid fa-shield-halved"></i></span><div><span>الأمان والدخول</span><h2>حماية الحساب</h2><p>استخدم كلمة مرور قوية وراجع الأجهزة المسجلة بانتظام.</p></div></header>
        <div class="bw-settings-security-grid">
            <form method="POST" action="<%= portalBasePath %>/settings/password" id="companyPassword" class="bw-form bw-form-grid">
                <label class="bw-field span-2"><span>كلمة المرور الحالية</span><input type="password" name="currentPassword" autocomplete="current-password" required></label>
                <label class="bw-field"><span>كلمة المرور الجديدة</span><input type="password" name="newPassword" minlength="8" autocomplete="new-password" required></label>
                <label class="bw-field"><span>تأكيد كلمة المرور</span><input type="password" name="passwordConfirm" minlength="8" autocomplete="new-password" required></label>
                <div class="bw-form-actions span-2">
                    <button type="submit" class="bw-button primary"><i class="fa-solid fa-key"></i>تحديث كلمة المرور</button>
                    <a class="bw-button ghost" href="/security/sessions"><i class="fa-solid fa-laptop-mobile"></i>الأجهزة والجلسات</a>
                </div>
            </form>
            <div id="companyMfa"><%- include('../../partials/mfa_security_panel') %></div>
            <% if (workspace.isCompany) { %>
            <section class="cp-push-card" data-company-push>
                <header>
                    <span class="bw-section-kicker">إشعارات المتصفح</span>
                    <h3>تنبيهات حتى مع إغلاق الصفحة</h3>
                </header>
                <p data-push-status>جارٍ فحص حالة الاشتراك...</p>
                <p>على أجهزة آيفون قد يلزم «إضافة إلى الشاشة الرئيسية» ثم فتح البوابة كتطبيق قبل تفعيل Web Push.</p>
                <div class="cp-push-actions">
                    <button type="button" class="bw-button primary" data-push-enable><i class="fa-regular fa-bell"></i>تفعيل الإشعارات</button>
                    <button type="button" class="bw-button ghost" data-push-test>إرسال اختبار</button>
                    <button type="button" class="bw-button ghost" data-push-disable>إيقاف هذا المتصفح</button>
                </div>
            </section>
            <% } %>
        </div>
    </section>
</div>
