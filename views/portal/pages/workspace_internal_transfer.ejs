<% const portalBasePath = locals.portalBasePath || '/client'; const portalHref = value => typeof value === 'string' && (value === '/client' || value.startsWith('/client/') || value.startsWith('/client?')) ? portalBasePath + value.slice(7) : value; %>
<% if ((workspace.isCompany || workspace.isAgent)) { %>
<section class="cp-page-hero">
    <div>
        <span class="bw-section-kicker">بين الحسابات</span>
        <h2>تحويل رصيد داخلي</h2>
        <p>مستقل عن قنوات الكاش والبريد. يظهر للمدير فقط، ويُراجع في نافذة التأكيد قبل الختم.</p>
    </div>
    <div class="cp-page-hero-actions">
        <a href="<%= portalBasePath %>/finance" class="bw-button ghost"><i class="fa-solid fa-scale-balanced"></i>مكتب المحاسبة</a>
    </div>
</section>
<% } else { %>
<p class="cos-isolated-note">تحويل الرصيد بين حسابات الشركة مستقل عن قنوات الكاش والبريد. يظهر هنا للمدير فقط.</p>
<% } %>
<%- include('../partials/internal_transfer_panel') %>
