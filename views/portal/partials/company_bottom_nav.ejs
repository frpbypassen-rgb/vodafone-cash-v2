<% const portalBasePath = locals.portalBasePath || '/client'; const portalHref = value => typeof value === 'string' && (value === '/client' || value.startsWith('/client/') || value.startsWith('/client?')) ? portalBasePath + value.slice(7) : value; %>
<%
    const dockItems = typeof companyMobileNav !== 'undefined' ? companyMobileNav : [];
%>
<nav class="bw-mobile-dock" aria-label="التنقل السريع" data-company-dock>
    <% dockItems.forEach(item => { %>
        <a href="<%= portalHref(item.href) %>" class="<%= item.active ? 'active' : '' %>" data-dock-key="<%= item.key %>">
            <i class="fa-solid <%= item.icon || 'fa-circle' %>" aria-hidden="true"></i>
            <span><%= item.dockLabel || item.label %></span>
        </a>
    <% }) %>
    <% if (workspace.isAgent || workspace.isCompany) { %><button class="cm-agent-more" type="button" id="agentMoreButton" popovertarget="agentMoreMenu" aria-controls="agentMoreMenu" aria-expanded="false"><i class="fa-solid fa-bars" aria-hidden="true"></i><span>المزيد</span></button><% } %>
</nav>
<% if (workspace.isAgent || workspace.isCompany) {
    const moreItems = navigation.filter(item => !dockItems.some(dock => dock.key === item.key) && !(workspace.isCompany && item.key === 'smart_transfer'));
%>
<nav id="agentMoreMenu" class="agent-more-menu" popover="auto" aria-labelledby="agentMoreTitle">
    <header class="agent-more-heading">
        <strong id="agentMoreTitle">المزيد</strong>
        <button type="button" popovertarget="agentMoreMenu" popovertargetaction="hide" aria-label="إغلاق القائمة"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </header>
    <div class="agent-more-grid">
        <% moreItems.filter(item => !['settings', 'security'].includes(item.key)).forEach(item => { %>
        <a href="<%= portalHref(item.href) %>" class="<%= item.active ? 'active' : '' %>" <%- item.active ? 'aria-current="page"' : '' %>>
            <i class="fa-solid <%= item.icon %>" aria-hidden="true"></i><span><%= item.label %></span>
        </a>
        <% }) %>
    </div>
    <footer class="agent-more-footer">
        <% moreItems.filter(item => ['settings', 'security'].includes(item.key)).forEach(item => { %>
        <a href="<%= portalHref(item.href) %>" <%- item.active ? 'aria-current="page"' : '' %>><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i><span><%= item.label %></span><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
        <% }) %>
        <a class="agent-more-logout" href="<%= portalBasePath %>/logout"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i><span>تسجيل الخروج</span></a>
    </footer>
</nav>
<% } %>
