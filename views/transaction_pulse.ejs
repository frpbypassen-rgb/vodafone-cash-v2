<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نبض العمليات | الأهرام</title>
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('ahram_theme') || 'light');</script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: Tajawal, sans-serif; } .main-content { margin-right: var(--sidebar-width); padding: 30px; }
        .pulse-card { background: var(--card-bg); border: 1px solid var(--border-glass); border-radius: 18px; box-shadow: var(--shadow-soft); }
        .metric { padding: 17px; min-height: 126px; position: relative; overflow: hidden; }
        .metric .label { color: var(--text-muted); font-size: .78rem; font-weight: 800; } .metric .value { font-family: 'JetBrains Mono', monospace; font-size: 1.36rem; font-weight: 900; margin-top: 10px; }
        .metric .count { color: var(--text-muted); font-size: .76rem; font-weight: 700; margin-top: 7px; } .metric i { position: absolute; left: 14px; bottom: 12px; opacity: .13; font-size: 2.7rem; }
        .section-title { font-size: 1rem; font-weight: 900; margin: 0; } .section-note { color: var(--text-muted); font-size: .78rem; font-weight: 700; }
        .chart-box { padding: 18px; min-height: 350px; } .chart-holder { position: relative; height: 265px; margin-top: 12px; }
        .period-chip { background: var(--input-bg); border: 1px solid var(--border-glass); border-radius: 12px; padding: 11px 13px; font-size: .8rem; font-weight: 800; }
        .period-chip strong { display: block; font-family: 'JetBrains Mono', monospace; font-size: 1.05rem; margin-top: 5px; color: #10b981; }
        .donut-legend { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin-top: 12px; } .donut-legend div { font-size: .78rem; font-weight: 800; color: var(--text-muted); } .dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-left: 5px; }
        @media (max-width: 991px) { .main-content { margin-right: 0; padding: 86px 14px 86px; } .chart-box { min-height: 310px; } .chart-holder { height: 220px; } }
    </style>
</head>
<body>
<%- include('partials/sidebar', { activePage }) %>
<main class="main-content"><div class="container-fluid">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h1 class="h3 fw-bold mb-1"><i class="fa-solid fa-heart-pulse text-danger ms-2"></i>شاشة نبض العمليات</h1><p class="section-note mb-0">متابعة فورية لحركة اليوم مقارنةً بالشهر الحالي — توقيت ليبيا.</p></div>
        <a href="/transactions/operations" class="btn btn-primary fw-bold"><i class="fa-solid fa-list-check ms-1"></i> فتح العمليات</a>
    </header>

    <section class="mb-4"><div class="d-flex align-items-center justify-content-between mb-2"><h2 class="section-title">اليوم</h2><span class="section-note"><%= todayKey %></span></div><div class="row g-3">
        <div class="col-12 col-md-4"><article class="pulse-card metric"><span class="label">إجمالي الإيداعات اليوم</span><div class="value text-primary"><%= Number(today.deposits.amount || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> <small>EGP</small></div><div class="count"><%= today.deposits.count %> حركة إيداع</div><i class="fa-solid fa-hand-holding-dollar text-primary"></i></article></div>
        <div class="col-12 col-md-4"><article class="pulse-card metric"><span class="label">العمليات الناجحة اليوم</span><div class="value text-success"><%= Number(today.successful.amount || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> <small>EGP</small></div><div class="count"><%= today.successful.count %> عملية ناجحة · <%= Number(today.successful.costLYD || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> LYD</div><i class="fa-solid fa-circle-check text-success"></i></article></div>
        <div class="col-12 col-md-4"><article class="pulse-card metric"><span class="label">إجمالي الخصومات اليوم</span><div class="value text-danger"><%= Number(today.deductions.amount || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> <small>EGP</small></div><div class="count"><%= today.deductions.count %> حركة خصم</div><i class="fa-solid fa-arrow-trend-down text-danger"></i></article></div>
    </div></section>

    <section class="mb-4"><div class="d-flex align-items-center justify-content-between mb-2"><h2 class="section-title">الشهر الحالي</h2><span class="section-note">حتى الآن</span></div><div class="row g-3">
        <div class="col-12 col-md-4"><article class="pulse-card metric"><span class="label">إجمالي الإيداعات الشهرية</span><div class="value text-primary"><%= Number(month.deposits.amount || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> <small>EGP</small></div><div class="count"><%= month.deposits.count %> حركة إيداع</div><i class="fa-solid fa-building-columns text-primary"></i></article></div>
        <div class="col-12 col-md-4"><article class="pulse-card metric"><span class="label">العمليات الناجحة الشهرية</span><div class="value text-success"><%= Number(month.successful.amount || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> <small>EGP</small></div><div class="count"><%= month.successful.count %> عملية ناجحة · <%= Number(month.successful.costLYD || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> LYD</div><i class="fa-solid fa-chart-line text-success"></i></article></div>
        <div class="col-12 col-md-4"><article class="pulse-card metric"><span class="label">إجمالي الخصومات الشهرية</span><div class="value text-danger"><%= Number(month.deductions.amount || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %> <small>EGP</small></div><div class="count"><%= month.deductions.count %> حركة خصم</div><i class="fa-solid fa-wallet text-danger"></i></article></div>
    </div></section>

    <section class="row g-3"><div class="col-12 col-xl-8"><article class="pulse-card chart-box"><div class="d-flex justify-content-between gap-2 align-items-start"><div><h2 class="section-title">مسار النجاح — آخر 7 أيام</h2><p class="section-note mb-0">عدد وقيمة العمليات المكتملة لكل يوم.</p></div><span class="badge text-bg-success">مباشر</span></div><div class="chart-holder"><canvas id="trendChart"></canvas></div></article></div>
    <div class="col-12 col-xl-4"><article class="pulse-card chart-box"><h2 class="section-title">نسبة حجم العمليات</h2><p class="section-note mb-0">مقارنة عدد عمليات اليوم مع بقية الشهر.</p><div class="chart-holder"><canvas id="ratioChart"></canvas></div><div class="donut-legend"><div><span class="dot" style="background:#3b82f6"></span> اليوم: <%= today.operationsCount %></div><div><span class="dot" style="background:#94a3b8"></span> باقي الشهر: <%= Math.max(0, month.operationsCount - today.operationsCount) %></div></div></article></div></section>
</div></main>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
const trend = <%- JSON.stringify(trend) %>;
const textColor = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim() || '#64748b';
new Chart(document.getElementById('trendChart'), { type: 'bar', data: { labels: trend.map(item => item.label), datasets: [{ label: 'عدد الناجحة', data: trend.map(item => item.successfulCount), backgroundColor: '#10b981', borderRadius: 7, yAxisID: 'count' }, { type: 'line', label: 'القيمة EGP', data: trend.map(item => item.successfulAmount), borderColor: '#3b82f6', backgroundColor: '#3b82f6', tension: .35, yAxisID: 'amount' }] }, options: { maintainAspectRatio: false, plugins: { legend: { labels: { color: textColor, font: { family: 'Tajawal', weight: '700' } } } }, scales: { x: { ticks: { color: textColor }, grid: { display: false } }, count: { beginAtZero: true, position: 'right', ticks: { color: textColor, precision: 0 }, grid: { color: 'rgba(148,163,184,.12)' } }, amount: { beginAtZero: true, position: 'left', ticks: { color: textColor }, grid: { drawOnChartArea: false } } } } });
new Chart(document.getElementById('ratioChart'), { type: 'doughnut', data: { labels: ['عمليات اليوم', 'باقي الشهر'], datasets: [{ data: [<%= today.operationsCount %>, <%= Math.max(0, month.operationsCount - today.operationsCount) %>], backgroundColor: ['#3b82f6', '#94a3b8'], borderWidth: 0 }] }, options: { maintainAspectRatio: false, cutout: '70%', plugins: { legend: { display: false } } } });
</script>
</body></html>
