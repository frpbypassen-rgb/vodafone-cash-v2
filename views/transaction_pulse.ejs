<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>سجل العمليات المباشرة | الأهرام Pay</title>
    <script>document.documentElement.setAttribute('data-theme',localStorage.getItem('ahram_theme')||'dark');</script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root{--pulse-blue:#2563eb;--pulse-green:#10b981;--pulse-red:#ef4444;--pulse-amber:#f59e0b;--pulse-purple:#8b5cf6}
        body{background:var(--body-bg)}.pulse-shell{max-width:1900px;margin:auto}.mono{font-family:'JetBrains Mono',monospace;direction:ltr;display:inline-block}
        .page-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:18px 0}.page-head h1{font-size:1.45rem;font-weight:900;color:var(--text-main);margin:0}.page-head p{color:var(--text-muted);font-size:.8rem;margin:5px 0 0}.live-badge{display:inline-flex;align-items:center;gap:8px;padding:9px 13px;border-radius:12px;background:rgba(16,185,129,.1);color:var(--pulse-green);font-size:.78rem;font-weight:900;border:1px solid rgba(16,185,129,.2)}.live-dot{width:8px;height:8px;background:var(--pulse-green);border-radius:50%;box-shadow:0 0 0 5px rgba(16,185,129,.12)}
        .quick-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:12px}.quick-stat{background:var(--card-bg);border:1px solid var(--border-glass);border-radius:15px;padding:12px 14px;box-shadow:var(--shadow-soft)}.quick-stat span{display:block;color:var(--text-muted);font-size:.69rem;font-weight:800}.quick-stat strong{display:block;color:var(--text-main);font:800 1rem 'JetBrains Mono';margin-top:4px}.quick-stat.urgent strong{color:var(--pulse-red)}
        .balance-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}.balance-panel{background:var(--card-bg);border:1px solid var(--border-glass);border-radius:18px;box-shadow:var(--shadow-soft);overflow:hidden}.balance-title{display:flex;align-items:center;justify-content:space-between;padding:12px 15px;border-bottom:1px solid var(--border-glass)}.balance-title h2{font-size:.88rem;font-weight:900;color:var(--text-main);margin:0}.balance-title span{color:var(--text-muted);font-size:.67rem}.balance-list{display:flex;gap:8px;padding:10px;overflow-x:auto}.balance-item{flex:1 0 145px;max-width:210px;padding:10px 11px;background:var(--input-bg);border-radius:12px;min-width:0}.balance-name{font-size:.75rem;font-weight:900;color:var(--text-main);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.balance-value{font:800 .77rem 'JetBrains Mono';color:var(--pulse-green);margin-top:5px;direction:ltr;text-align:right}.balance-meta{font-size:.62rem;color:var(--text-muted);margin-top:3px}.api-state{display:inline-block;width:7px;height:7px;border-radius:50%;margin-left:4px}.api-state.online{background:var(--pulse-green)}.api-state.offline{background:var(--pulse-red)}.api-state.unknown{background:var(--pulse-amber)}
        .workspace{background:#0d1d2f;border:1px solid #294158;border-radius:10px;box-shadow:0 16px 45px rgba(2,8,23,.2);overflow:hidden}.workspace-head{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid #294158}.workspace-head h2{font-size:1rem;font-weight:900;color:#f8fafc;margin:0}.workspace-head small{color:#91a4b9}.tx-table-scroll{overflow-x:auto}
        .tx-head,.tx-row{display:grid;grid-template-columns:140px minmax(220px,1.35fr) 115px 145px 135px minmax(185px,1.1fr) 125px 90px 175px;gap:10px;align-items:center;min-width:1390px}.tx-head{padding:11px 16px;background:linear-gradient(180deg,#172536,#1d2830);color:#fbbf24;font-size:.72rem;font-weight:900;text-align:center}.tx-row{position:relative;padding:12px 16px;border-bottom:1px solid #273d53;transition:.18s;color:#dbeafe}.tx-row:last-child{border-bottom:0}.tx-row:hover{background:#122840}.tx-row.priority-critical{box-shadow:inset -4px 0 var(--pulse-red)}.tx-row.priority-warning{box-shadow:inset -4px 0 var(--pulse-amber)}
        .op-id{color:#fbbf24;font:800 .78rem 'JetBrains Mono';direction:ltr;border-bottom:1px dashed #64748b;width:max-content;margin:auto}.age{display:none;font-size:.61rem;color:#8fa3ba;margin-top:5px}.priority-critical .age{color:#fb7185;font-weight:900}.priority-warning .age{color:#fbbf24;font-weight:900}.identity-cell{text-align:right}.identity-name{font-weight:900;color:#f8fafc;font-size:.83rem}.identity-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:5px;color:#9fb1c6;font-size:.67rem}.entity-badge,.actor-badge{padding:2px 6px;border-radius:6px;font-size:.58rem;font-weight:900}.entity-badge{background:rgba(59,130,246,.13);color:#60a5fa}.actor-badge{background:rgba(148,163,184,.12);color:#a9b8ca}.actor-badge.customer{background:rgba(139,92,246,.18);color:#c4b5fd}.recipient{font:800 .76rem 'JetBrains Mono';color:#fff;cursor:pointer;direction:ltr}.recipient:hover{color:#60a5fa}.service-chip{display:inline-flex;margin-top:5px;padding:2px 7px;border-radius:9px;background:#0ea5e9;color:#fff;font-size:.59rem;font-weight:900;direction:rtl}
        .money-main{font:800 .9rem 'JetBrains Mono';color:#f8fafc;direction:ltr}.money-currency{font:700 .62rem 'Tajawal';color:#a5b5c7}.rate-line{font-size:.64rem;color:#9fb1c6;margin-top:5px}.cost-value{font:800 .76rem 'JetBrains Mono';color:#fb405a;direction:ltr}.rate-value{font:900 .74rem 'JetBrains Mono';color:#fbbf24;direction:ltr;margin-top:6px}.executor-name{color:#1688ff;font-size:.72rem;font-weight:900;line-height:1.45}.executor-actor{color:#a9b8ca;font-size:.64rem;margin-top:5px}.note-text{font-size:.68rem;color:#f8fafc;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.time-line{font:.65rem 'JetBrains Mono';color:#b8cae0;margin-top:4px;direction:ltr}.date-line{font:.58rem 'JetBrains Mono';color:#71849a;direction:ltr}.status{display:inline-flex;align-items:center;justify-content:center;padding:6px 9px;border-radius:7px;font-size:.64rem;font-weight:900;border:1px solid transparent}.status-pending{background:rgba(245,158,11,.12);color:#fbbf24;border-color:rgba(245,158,11,.3)}.status-processing,.status-accepted{background:rgba(59,130,246,.13);color:#60a5fa;border-color:rgba(59,130,246,.3)}.status-completed{background:rgba(16,185,129,.12);color:#34d399;border-color:rgba(16,185,129,.3)}.status-rejected,.status-cancelled_by_admin{background:rgba(239,68,68,.13);color:#fb405a;border-color:rgba(239,68,68,.3)}
        .control-cell{min-width:0}.action-line{display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap}.action-btn{width:36px;height:36px;border:1px solid #1d3650;border-radius:10px;padding:0;background:#172b40;color:#f8fafc;font-size:.76rem;font-weight:900;display:inline-flex;align-items:center;justify-content:center;gap:5px}.action-btn:hover{transform:translateY(-1px);background:#203d59}.action-btn .btn-text{display:none}.route-btn{width:auto;padding:0 10px;background:linear-gradient(180deg,#5da4f2,#2764a8);border-color:#61a9f8;color:#fff}.route-btn .btn-text{display:inline}.pull-btn{color:#fff}.cancel-btn{color:#fb7185}.route-panel{display:none;flex-basis:100%;gap:7px;margin-top:3px;padding:7px;border:1px solid #2d5e8f;background:#10263b;border-radius:9px}.route-panel.open{display:flex}.route-panel select{min-width:0;flex:1;background:#13283d;color:#f8fafc;border:1px solid #36546f;border-radius:8px;padding:7px;font-size:.68rem;font-weight:700}.route-confirm{border:0;border-radius:8px;background:var(--pulse-green);color:#fff;font-size:.67rem;font-weight:900;padding:0 9px}.empty{padding:65px 20px;text-align:center;color:#91a4b9}.empty i{font-size:2.6rem;opacity:.25;margin-bottom:12px}
        .modal-content{background:var(--card-bg);color:var(--text-main);border:1px solid var(--border-glass)}.modal-header,.modal-footer{border-color:var(--border-glass)}.form-control{background:var(--input-bg)!important;color:var(--text-main)!important;border-color:var(--border-glass)!important}.mobile-label{display:none}
        @media(max-width:1100px){.tx-table-scroll{overflow:visible}.tx-head{display:none}.tx-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:10px}.tx-row{display:grid;grid-template-columns:1fr 1fr;min-width:0;gap:13px;border:1px solid #294158;border-radius:14px;padding:14px}.tx-row:last-child{border-bottom:1px solid #294158}.identity-cell,.control-cell{grid-column:1/-1}.mobile-label{display:block;color:#7890a8;font-size:.59rem;font-weight:800;margin-bottom:4px}.age{display:block}.control-cell{border-top:1px dashed #35516c;padding-top:11px}.action-line{display:grid;grid-template-columns:repeat(4,1fr)}.action-btn{width:auto;padding:0 5px}.action-btn .btn-text{display:inline}.route-btn{grid-column:span 2}.route-panel{grid-column:1/-1}.balance-grid{grid-template-columns:1fr}}
        @media(max-width:680px){.main-content{padding:10px!important}.pulse-shell{padding:0!important}.page-head{align-items:flex-start;margin:9px 2px 12px}.page-head h1{font-size:1.13rem}.page-head p{font-size:.68rem}.live-badge{padding:7px 9px;font-size:.65rem}.quick-strip{grid-template-columns:repeat(2,1fr);gap:7px}.quick-stat{padding:10px;border-radius:12px}.balance-panel{border-radius:15px}.balance-title{padding:10px 12px}.balance-list{padding:8px}.balance-item{flex-basis:128px}.workspace{border-radius:12px}.workspace-head{padding:13px}.tx-list{grid-template-columns:1fr;padding:8px}.tx-row{grid-template-columns:1fr 1fr;padding:13px}.identity-name{font-size:.9rem}.money-main{font-size:.88rem}.action-line{grid-template-columns:repeat(2,1fr);gap:7px}.action-btn{height:43px;font-size:.68rem}.route-btn{grid-column:1/-1}.route-panel{flex-direction:column}.route-panel select,.route-confirm{min-height:43px;width:100%}.workspace-head small{display:none}}
    </style>
    <style>
        :root{--op-surface:#fff;--op-soft:#f6f8fc;--op-row:#fff;--op-line:#e7ecf3;--op-text:#172033;--op-muted:#718096;--op-hover:#f8fbff;--op-shadow:0 14px 40px rgba(30,64,175,.08)}
        [data-theme="dark"]{--op-surface:#101b2d;--op-soft:#142238;--op-row:#121f33;--op-line:#253650;--op-text:#eef4ff;--op-muted:#91a1b8;--op-hover:#172942;--op-shadow:0 18px 46px rgba(0,0,0,.22)}
        body{background:radial-gradient(circle at 88% 0,rgba(37,99,235,.06),transparent 26%),var(--body-bg)}
        .pulse-shell{max-width:1860px;padding-bottom:32px}.page-head{margin:18px 0 14px;padding:20px 22px;border:1px solid var(--op-line);border-radius:22px;background:linear-gradient(135deg,var(--op-surface),color-mix(in srgb,var(--op-surface) 90%,#2563eb));box-shadow:var(--op-shadow)}.page-head h1{font-size:1.32rem;color:var(--op-text)}.page-head h1 i{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:12px;background:rgba(37,99,235,.11);color:#2563eb!important}.page-head p{color:var(--op-muted);margin-right:45px}.live-badge{border-radius:999px;padding:9px 14px;background:rgba(16,185,129,.09);box-shadow:none}
        .quick-strip{gap:12px;margin-bottom:14px}.quick-stat{position:relative;min-height:77px;padding:14px 56px 13px 15px;border-color:var(--op-line);border-radius:17px;background:var(--op-surface);box-shadow:0 7px 24px rgba(15,23,42,.045);overflow:hidden}.quick-stat>i{position:absolute;right:14px;top:50%;transform:translateY(-50%);display:grid;place-items:center;width:32px;height:32px;border-radius:10px;background:rgba(37,99,235,.1);color:#2563eb}.quick-stat span{color:var(--op-muted);font-size:.7rem}.quick-stat strong{color:var(--op-text);font-size:1.08rem}.quick-stat.urgent>i{background:rgba(239,68,68,.1);color:#ef4444}
        .balance-grid{gap:14px;margin-bottom:16px}.balance-panel{border-color:var(--op-line);border-radius:18px;background:var(--op-surface);box-shadow:0 8px 28px rgba(15,23,42,.045)}.balance-title{padding:13px 16px;border-color:var(--op-line)}.balance-title h2{color:var(--op-text);font-size:.86rem}.balance-title span{color:var(--op-muted)}.balance-list{gap:9px;padding:11px}.balance-item{background:var(--op-soft);border:1px solid transparent;border-radius:12px;padding:10px 12px}.balance-item:hover{border-color:rgba(37,99,235,.2)}.balance-name{color:var(--op-text)}.balance-value{color:#059669}.balance-meta{color:var(--op-muted)}
        .workspace{border:1px solid var(--op-line);border-radius:22px;background:var(--op-surface);box-shadow:var(--op-shadow);overflow:hidden}.workspace-head{padding:17px 19px;border-color:var(--op-line);background:var(--op-surface)}.workspace-head h2{color:var(--op-text);font-size:1rem}.workspace-head small{color:var(--op-muted)}.workspace-head .badge{background:rgba(37,99,235,.1)!important;color:#2563eb!important;padding:8px 12px}
        .tx-table-scroll{overflow-x:auto;background:var(--op-soft);padding-bottom:7px}.tx-head,.tx-row{grid-template-columns:138px minmax(220px,1.35fr) 110px 142px 132px minmax(180px,1.05fr) 120px 92px 170px;min-width:1360px}.tx-head{position:sticky;top:0;z-index:3;padding:12px 17px;background:var(--op-soft);color:var(--op-muted);font-size:.66rem;border-bottom:1px solid var(--op-line)}.tx-list{padding:7px 8px 1px}.tx-row{min-height:78px;margin-bottom:7px;padding:12px 10px;border:1px solid var(--op-line);border-radius:14px;background:var(--op-row);color:var(--op-text);box-shadow:0 2px 8px rgba(15,23,42,.025)}.tx-row:last-child{border-bottom:1px solid var(--op-line)}.tx-row:hover{background:var(--op-hover);border-color:rgba(37,99,235,.24);transform:translateY(-1px)}.tx-row.priority-critical,.tx-row.priority-warning{box-shadow:none}.tx-row.priority-critical:before,.tx-row.priority-warning:before{content:"";position:absolute;right:-1px;top:13px;bottom:13px;width:3px;border-radius:4px}.tx-row.priority-critical:before{background:#ef4444}.tx-row.priority-warning:before{background:#f59e0b}
        .op-id{margin:auto;padding:5px 8px;border:0;border-radius:8px;background:rgba(37,99,235,.08);color:#2563eb;font-size:.72rem}.identity-name{color:var(--op-text);font-size:.82rem}.identity-meta{color:var(--op-muted)}.actor-badge{background:var(--op-soft);color:var(--op-muted)}.recipient{color:var(--op-text);font-size:.74rem}.service-chip{margin-top:6px;background:rgba(14,165,233,.1);color:#0284c7;padding:3px 8px}.money-main{color:var(--op-text);font-size:.86rem}.cost-value{color:#e11d48;font-size:.73rem}.rate-value{color:#c28700;font-size:.71rem}.executor-name{color:#2563eb;font-size:.7rem}.executor-actor,.time-line{color:var(--op-muted)}.note-text{color:var(--op-text);font-size:.66rem}.date-line{color:var(--op-muted)}
        .status{min-width:72px;padding:7px 8px;border:0;border-radius:999px}.status-pending{background:#fff7df;color:#a76700}.status-processing,.status-accepted{background:#e9f2ff;color:#1d64c8}.status-completed{background:#e5f8f0;color:#07835b}.status-rejected,.status-cancelled_by_admin{background:#feecee;color:#c9273c}[data-theme="dark"] .status-pending{background:rgba(245,158,11,.14);color:#fbbf24}[data-theme="dark"] .status-processing,[data-theme="dark"] .status-accepted{background:rgba(59,130,246,.15);color:#7db4ff}[data-theme="dark"] .status-completed{background:rgba(16,185,129,.14);color:#4adea7}[data-theme="dark"] .status-rejected,[data-theme="dark"] .status-cancelled_by_admin{background:rgba(239,68,68,.15);color:#fb7185}
        .action-line{gap:5px}.action-btn{width:34px;height:34px;border-color:var(--op-line);border-radius:9px;background:var(--op-soft);color:var(--op-text)}.action-btn:hover{background:rgba(37,99,235,.1);border-color:rgba(37,99,235,.24);color:#2563eb}.route-btn{width:auto;background:#2563eb;border-color:#2563eb;color:#fff;box-shadow:0 5px 12px rgba(37,99,235,.2)}.route-btn:hover{background:#1d4ed8;color:#fff}.cancel-btn{color:#e11d48}.route-panel{padding:8px;border-color:rgba(37,99,235,.2);background:var(--op-soft)}.route-panel select{background:var(--op-surface);color:var(--op-text);border-color:var(--op-line)}
        .tx-head,.tx-row{grid-template-columns:112px minmax(174px,1.35fr) 94px 112px 104px minmax(145px,1.05fr) 92px 74px 138px;min-width:1135px}.tx-head{padding:12px;font-size:.64rem}.tx-row{padding:12px 7px}
        @media(max-width:1100px){.tx-list{padding:10px}.tx-row{background:var(--op-row);border-color:var(--op-line);border-radius:17px}.mobile-label{color:var(--op-muted)}.control-cell{border-color:var(--op-line)}}
        @media(max-width:680px){.page-head{padding:16px 14px;border-radius:17px}.page-head h1 i{width:32px;height:32px}.page-head p{margin-right:38px}.quick-stat{min-height:70px;padding:12px 48px 11px 10px}.quick-stat>i{right:11px;width:29px;height:29px}.balance-grid{gap:10px}.workspace-head{padding:14px 13px}.tx-list{padding:8px}.tx-row{border-radius:15px;gap:14px}.note-cell{grid-column:1/-1}.status{min-width:68px}}
    </style>
</head>
<body>
<button class="mobile-nav-toggle no-print" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
<div class="sidebar-overlay no-print" onclick="toggleSidebar()"></div>
<%- include('partials/sidebar', { activePage: 'transactions_pulse' }) %>
<div class="main-content"><div class="container-fluid pulse-shell">
    <header class="page-head">
        <div><h1><i class="fa-solid fa-bolt text-warning ms-2"></i>سجل العمليات المباشرة</h1><p>التوجيه والتنفيذ السريع من شاشة واحدة، والأقدم يظهر أولًا.</p></div>
        <span class="live-badge"><span class="live-dot"></span> مباشر</span>
    </header>
    <% const money=(v,d=0)=>Number(v||0).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d}); %>
    <section class="quick-strip">
        <div class="quick-stat"><i class="fa-solid fa-inbox"></i><span>بانتظار التوجيه</span><strong><%= command.pendingCount %></strong></div>
        <div class="quick-stat urgent"><i class="fa-solid fa-triangle-exclamation"></i><span>تحتاج الانتباه</span><strong><%= command.urgentCount %></strong></div>
        <div class="quick-stat"><i class="fa-regular fa-clock"></i><span>أقدم انتظار</span><strong><%= command.oldestPendingMinutes %> د</strong></div>
        <div class="quick-stat"><i class="fa-solid fa-plug-circle-check"></i><span>API متصل</span><strong><%= command.apiOnline %>/<%= command.apiTotal %></strong></div>
    </section>
    <section class="balance-grid">
        <article class="balance-panel">
            <div class="balance-title"><h2><i class="fa-solid fa-building text-primary ms-1"></i> الشركات وأرصدتها</h2><span><%= companies.length %> شركة · <b class="mono"><%= money(command.companyBalanceTotal) %></b> ج.م</span></div>
            <div class="balance-list">
                <% if(!companies.length){ %><div class="text-muted small p-2">لا توجد شركات نشطة.</div><% } %>
                <% companies.forEach(company=>{ %><div class="balance-item"><div class="balance-name"><%= company.name %></div><div class="balance-value"><%= money(company.balance,2) %> EGP</div><div class="balance-meta"><%= company.accountCode || 'حساب شركة' %></div></div><% }); %>
            </div>
        </article>
        <article class="balance-panel">
            <div class="balance-title"><h2><i class="fa-solid fa-users-gear text-success ms-1"></i> المنفذون وAPI</h2><span><%= executors.length %> منفذ · <b class="mono"><%= money(command.executorBalanceTotal) %></b> ج.م</span></div>
            <div class="balance-list">
                <% if(!executors.length){ %><div class="text-muted small p-2">لا توجد مجموعات تنفيذ نشطة.</div><% } %>
                <% executors.forEach(executor=>{ %><div class="balance-item"><div class="balance-name"><% if(executor.isApiBot){ %><span class="api-state <%= executor.apiHealth %>"></span><% } %><%= executor.name %></div><div class="balance-value"><%= money(executor.availableBalance,2) %> EGP</div><div class="balance-meta"><%= executor.isApiBot ? 'API · ' : '' %><%= executor.serviceLabel %></div></div><% }); %>
            </div>
        </article>
    </section>
    <section class="workspace">
        <div class="workspace-head"><div><h2>العمليات الجاهزة للعمل</h2><small>اقتراح المنفذ يعتمد على الخدمة والرصيد وحالة API.</small></div><span class="badge rounded-pill text-bg-primary"><%= operations.length %> عملية</span></div>
        <div class="tx-table-scroll">
        <div class="tx-head"><span>رقم العملية</span><span>الجهة / العميل</span><span>المبلغ ج.م</span><span>الرقم / الحساب</span><span>التكلفة / سعر الصرف</span><span>منفذ التنفيذ</span><span>الملاحظة</span><span>الحالة</span><span>إجراء</span></div>
        <div class="tx-list">
        <% if(!operations.length){ %><div class="empty"><i class="fa-solid fa-circle-check d-block"></i><strong>لا توجد عمليات اليوم حتى الآن</strong><div class="small mt-2">ستظهر العمليات هنا فور وصولها.</div></div><% } %>
        <% operations.forEach(tx=>{ const rate=Number(tx.exchangeRate || (Number(tx.costLYD)>0 ? Number(tx.amount)/Number(tx.costLYD) : 0)); const statusLabel={pending:'معلق',processing:'قيد التنفيذ',accepted:'مقبول',completed:'مكتمل',rejected:'مرفوض',cancelled_by_admin:'ملغي'}[tx.status]||tx.status; const created=new Date(tx.createdAt); const txTime=created.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:true,timeZone:'Africa/Tripoli'}); const txDate=created.toLocaleDateString('en-GB',{day:'2-digit',month:'2-digit',year:'numeric',timeZone:'Africa/Tripoli'}); %>
            <article class="tx-row priority-<%= tx.priority %>" data-id="<%= tx._id %>">
                <div><span class="mobile-label">رقم العملية</span><div class="op-id"><%= tx.customId || String(tx._id).slice(-8) %></div><span class="age"><i class="fa-regular fa-clock ms-1"></i><% if(tx.ageMinutes < 60){ %><%= tx.ageMinutes %> دقيقة<% } else { %><%= Math.floor(tx.ageMinutes/60) %> س <%= tx.ageMinutes%60 %> د<% } %></span></div>
                <div class="identity-cell"><span class="mobile-label">الجهة / العميل</span><div class="identity-name"><i class="fa-solid <%= tx.entityType==='company'?'fa-building':tx.entityType==='agent'?'fa-store':'fa-user' %> ms-1" style="color:#a8bdd4"></i><%= tx.customerName %></div><div class="identity-meta"><span class="actor-badge <%= tx.actorIsCustomer?'customer':'' %>"><%= tx.actorLabel %></span><strong><%= tx.actorName %></strong></div></div>
                <div><span class="mobile-label">المبلغ ج.م</span><div class="money-main"><%= money(tx.amount,2) %></div></div>
                <div><span class="mobile-label">الرقم / الحساب</span><div class="recipient" onclick="copyText('<%= tx.recipient %>')" title="نسخ رقم المستلم"><%= tx.recipient %></div><span class="service-chip"><%= tx.serviceLabel %></span></div>
                <div><span class="mobile-label">التكلفة / سعر الصرف</span><div class="cost-value">LYD <%= money(tx.costLYD,2) %></div><div class="rate-value"><%= money(rate,2) %> <i class="fa-solid fa-percent"></i></div></div>
                <div><span class="mobile-label">منفذ التنفيذ</span><div class="executor-name"><i class="fa-solid fa-robot ms-1"></i><%= tx.executorName || (tx.status==='pending'?'تنفيذ مستقل':'غير محدد') %></div><div class="executor-actor"><i class="fa-solid fa-user-gear ms-1"></i><%= tx.status==='pending'?'---':tx.actorName %></div></div>
                <div class="note-cell"><span class="mobile-label">الملاحظة والتوقيت</span><div class="note-text" title="<%= tx.displayNote %>"><%= tx.displayNote %></div><div class="time-line"><%= txTime %> <i class="fa-regular fa-clock"></i></div><div class="date-line"><%= txDate %></div></div>
                <div><span class="mobile-label">الحالة</span><span class="status status-<%= tx.status %>"><%= statusLabel %></span></div>
                <div class="control-cell">
                    <span class="mobile-label">الإجراءات</span>
                    <div class="action-line">
                        <% if(tx.status==='pending'){ %><button class="action-btn route-btn" title="توجيه العملية" onclick="toggleRoute('<%= tx._id %>')"><i class="fa-solid fa-paper-plane"></i><span class="btn-text">توجيه</span></button><% } %>
                        <% if(['processing','accepted'].includes(tx.status)){ %><button class="action-btn pull-btn" title="سحب العملية" onclick="runAction('/transaction/<%= tx._id %>/pull-task','سحب العملية من المنفذ؟')"><i class="fa-solid fa-rotate-left"></i><span class="btn-text">سحب</span></button><% } %>
                        <button class="action-btn" title="تعديل القيمة" onclick="openEdit('<%= tx._id %>','amount','<%= tx.amount %>','<%= new Date(tx.createdAt).toISOString().slice(0,16) %>')"><i class="fa-solid fa-pen"></i><span class="btn-text">القيمة</span></button>
                        <button class="action-btn" title="تعديل سعر الصرف" onclick="openEdit('<%= tx._id %>','rate','<%= rate %>')"><i class="fa-solid fa-percent"></i><span class="btn-text">الصرف</span></button>
                        <% if(!['rejected','cancelled_by_admin'].includes(tx.status)){ %><button class="action-btn cancel-btn" title="إلغاء العملية" onclick="cancelTx('<%= tx._id %>')"><i class="fa-solid fa-ban"></i><span class="btn-text">إلغاء</span></button><% } %>
                        <% if(tx.status==='pending'){ %><div class="route-panel" id="route-<%= tx._id %>"><select aria-label="اختر المنفذ" id="executor-<%= tx._id %>"><option value="">اختر المنفذ المتاح...</option><% executors.filter(ex=>ex.supportedTypes.includes(tx.transferType)&&ex.apiHealth!=='offline').forEach(ex=>{ %><option value="<%= ex._id %>" <%= String(ex._id)===tx.recommendedExecutorId?'selected':'' %>><%= ex.name %> · <%= money(ex.availableBalance) %> ج.م<%= String(ex._id)===tx.recommendedExecutorId?' · مقترح':'' %></option><% }); %></select><button class="route-confirm" onclick="assignExecutor('<%= tx._id %>')"><i class="fa-solid fa-check ms-1"></i> تأكيد</button></div><% } %>
                    </div>
                </div>
            </article>
        <% }); %>
        </div>
        </div>
    </section>
</div></div>
<div class="modal fade" id="editModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" id="editForm"><div class="modal-header"><h2 class="modal-title fs-6 fw-bold" id="editTitle">تعديل العملية</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" id="editId"><input type="hidden" id="editKind"><label class="form-label fw-bold" id="editLabel"></label><input class="form-control" type="number" step="0.0001" min="0.0001" id="editValue" required><div id="dateWrap" class="mt-3"><label class="form-label fw-bold">تاريخ العملية</label><input class="form-control" type="datetime-local" id="editDate"></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">رجوع</button><button class="btn btn-primary" type="submit">حفظ التعديل</button></div></form></div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
const csrfToken=window.__csrfToken||document.querySelector('meta[name="csrf-token"]')?.content||'';
let lastInteraction=Date.now(),editModal;
function toggleSidebar(){document.querySelector('.sidebar')?.classList.toggle('active');document.querySelector('.sidebar-overlay')?.classList.toggle('active')}
function touch(){lastInteraction=Date.now()}
function toggleRoute(id){const panel=document.getElementById('route-'+id);document.querySelectorAll('.route-panel.open').forEach(item=>{if(item!==panel)item.classList.remove('open')});panel?.classList.toggle('open');touch()}
async function postForm(url,body){const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-CSRF-Token':csrfToken,'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body:new URLSearchParams(body)});let data={success:response.ok};try{if((response.headers.get('content-type')||'').includes('application/json'))data=await response.json()}catch(error){}if(!response.ok||data.success===false)throw new Error(data.message||data.error||'تعذر تنفيذ الإجراء');return data}
async function assignExecutor(id){const select=document.getElementById('executor-'+id);if(!select?.value){Swal.fire({icon:'warning',text:'اختر منفذًا أولًا'});return}try{Swal.showLoading();const result=await postForm('/transaction/'+id+'/assign-executor',{executorGroupId:select.value});await Swal.fire({icon:'success',text:result.message||'تم توجيه العملية',timer:1100,showConfirmButton:false});location.reload()}catch(error){Swal.fire({icon:'error',text:error.message})}}
async function runAction(url,question){const answer=await Swal.fire({icon:'question',text:question,showCancelButton:true,confirmButtonText:'تنفيذ',cancelButtonText:'رجوع'});if(!answer.isConfirmed)return;try{Swal.showLoading();const result=await postForm(url,{});await Swal.fire({icon:'success',text:result.message||'تم التنفيذ',timer:1100,showConfirmButton:false});location.reload()}catch(error){Swal.fire({icon:'error',text:error.message})}}
async function cancelTx(id){const answer=await Swal.fire({icon:'warning',title:'إلغاء العملية',input:'text',inputLabel:'سبب الإلغاء',inputValue:'إلغاء من الإدارة',showCancelButton:true,confirmButtonText:'إلغاء العملية',cancelButtonText:'رجوع',confirmButtonColor:'#ef4444',inputValidator:value=>!value&&'اكتب سبب الإلغاء'});if(!answer.isConfirmed)return;try{Swal.showLoading();await postForm('/transaction/'+id+'/global-cancel',{reason:answer.value});await Swal.fire({icon:'success',text:'تم إلغاء العملية',timer:1000,showConfirmButton:false});location.reload()}catch(error){Swal.fire({icon:'error',text:error.message})}}
function openEdit(id,kind,value,date){document.getElementById('editId').value=id;document.getElementById('editKind').value=kind;document.getElementById('editValue').value=value;document.getElementById('editTitle').textContent=kind==='amount'?'تعديل قيمة العملية':'تعديل سعر الصرف';document.getElementById('editLabel').textContent=kind==='amount'?'القيمة الجديدة بالجنيه المصري':'سعر الصرف الجديد';document.getElementById('dateWrap').style.display=kind==='amount'?'block':'none';document.getElementById('editDate').value=date||'';editModal.show();touch()}
async function copyText(value){try{await navigator.clipboard.writeText(value);Swal.fire({toast:true,position:'bottom',icon:'success',title:'تم نسخ الرقم',showConfirmButton:false,timer:900})}catch(error){}}
document.addEventListener('DOMContentLoaded',()=>{editModal=new bootstrap.Modal(document.getElementById('editModal'));document.getElementById('editForm').addEventListener('submit',async event=>{event.preventDefault();const id=document.getElementById('editId').value,kind=document.getElementById('editKind').value,value=document.getElementById('editValue').value;try{Swal.showLoading();if(kind==='amount')await postForm('/transaction/'+id+'/edit-data',{newAmount:value,newDate:document.getElementById('editDate').value});else await postForm('/transaction/'+id+'/edit-rate',{newRate:value});editModal.hide();await Swal.fire({icon:'success',text:'تم حفظ التعديل',timer:1000,showConfirmButton:false});location.reload()}catch(error){Swal.fire({icon:'error',text:error.message})}});document.addEventListener('click',touch);document.addEventListener('change',touch);setInterval(()=>{if(document.visibilityState==='visible'&&Date.now()-lastInteraction>30000&&!document.querySelector('.route-panel.open')&&!document.querySelector('.modal.show'))location.reload()},30000)});
</script>
</body>
</html>
