<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>مراقبة Telegram</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"><style>body{background:#0b1220;color:#e5e7eb}.wrap{max-width:1200px;margin:30px auto}.card{background:#111c2e;border:1px solid #263650;color:#e5e7eb}.badge{padding:8px 12px}.table{color:#e5e7eb;vertical-align:middle}.muted{color:#9ca3af}.status-sent{color:#22c55e}.status-failed{color:#ef4444}.status-sending{color:#f59e0b}</style></head><body><main class="wrap"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2><i class="fa-brands fa-telegram text-info"></i> مراقبة إيصالات Telegram</h2><p class="muted">تتبع إرسال صور الإيصالات حسب العملية والحساب.</p></div><div class="d-flex gap-2"><a href="/financial-movements" class="btn btn-outline-warning">المركز المالي</a><a href="/transactions" class="btn btn-outline-light">العمليات</a></div></div><div class="row g-3 mb-4"><% [['sending','جارٍ الإرسال'],['sent','تم الإرسال'],['failed','فشل'],['skipped','تم التجاوز']].forEach(([key,label])=>{ %><div class="col-6 col-lg-3"><div class="card p-3"><span class="muted"><%= label %></span><strong class="fs-3"><%= counts[key] || 0 %></strong></div></div><% }) %></div><form class="card p-3 mb-3 d-flex gap-2"><input class="form-control" name="search" value="<%= search %>" placeholder="رقم العملية أو Chat ID"><select class="form-select" name="status"><option value="">كل الحالات</option><% [['sending','جارٍ الإرسال'],['sent','تم الإرسال'],['failed','فشل'],['skipped','تم التجاوز']].forEach(([key,label])=>{ %><option value="<%= key %>" <%= status===key?'selected':'' %>><%= label %></option><% }) %></select><button class="btn btn-info">بحث</button></form><div class="card p-2"><div class="table-responsive"><table class="table"><thead><tr><th>العملية</th><th>Chat ID</th><th>الحالة</th><th>آخر تحديث</th><th>السبب</th><th></th></tr></thead><tbody><% deliveries.forEach((item)=>{ %><tr><td dir="ltr"><%= item.reference || item.transactionId %></td><td dir="ltr"><%= item.chatId %></td><td class="status-<%= item.status %>"><%= ({sending:'جارٍ الإرسال',sent:'تم الإرسال',failed:'فشل',skipped:'تم التجاوز'})[item.status] || item.status %></td><td><%= item.updatedAt ? new Date(item.updatedAt).toLocaleString('ar-EG',{timeZone:'Africa/Tripoli'}) : '---' %></td><td><%= item.failureReason || '---' %></td><td><% if(item.status==='failed'){ %><form method="POST" action="/telegram-monitor/<%= item._id %>/retry"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><button class="btn btn-sm btn-outline-warning">إعادة الإرسال</button></form><% } %></td></tr><% }) %><% if(!deliveries.length){ %><tr><td colspan="6" class="text-center muted p-5">لا توجد عمليات إرسال.</td></tr><% } %></tbody></table></div></div></main></body></html>
