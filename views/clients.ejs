            </div>
        </div>

        <% if (pagination.totalPages > 1) { %>
            <nav class="directory-pagination" aria-label="صفحات دليل الحسابات">
                <a class="directory-page-link <%= pagination.page === 1 ? 'disabled' : '' %>" href="<%= directoryUrl(activeSection, pagination.page - 1) %>" aria-label="الصفحة السابقة" data-directory-nav>
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
                <% if (firstVisiblePage > 1) { %>
                    <a class="directory-page-link" href="<%= directoryUrl(activeSection, 1) %>" data-directory-nav>1</a>
                    <% if (firstVisiblePage > 2) { %><span class="text-muted fw-bold">...</span><% } %>
                <% } %>
                <% for (let pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber += 1) { %>
                    <a class="directory-page-link <%= pageNumber === pagination.page ? 'active' : '' %>" href="<%= directoryUrl(activeSection, pageNumber) %>" <% if (pageNumber === pagination.page) { %>aria-current="page"<% } %> data-directory-nav><%= pageNumber %></a>
                <% } %>
                <% if (lastVisiblePage < pagination.totalPages) { %>
                    <% if (lastVisiblePage < pagination.totalPages - 1) { %><span class="text-muted fw-bold">...</span><% } %>
                    <a class="directory-page-link" href="<%= directoryUrl(activeSection, pagination.totalPages) %>" data-directory-nav><%= pagination.totalPages %></a>
                <% } %>
                <a class="directory-page-link <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>" href="<%= directoryUrl(activeSection, pagination.page + 1) %>" aria-label="الصفحة التالية" data-directory-nav>
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            </nav>
        <% } %>
    </div>
</div>

<script>
    function toggleSidebar() {
        document.querySelector('.sidebar').classList.toggle('active');
        document.querySelector('.sidebar-overlay').classList.toggle('active');
    }

    let directoryNavigationController = null;

    async function navigateAccountDirectory(targetUrl, pushState = true) {
        const currentPage = document.querySelector('.clients-page');
        if (!currentPage) {
            window.location.assign(targetUrl);
            return;
        }

        if (directoryNavigationController) directoryNavigationController.abort();
        const navigationController = new AbortController();
        directoryNavigationController = navigationController;
        currentPage.classList.add('directory-is-loading');
        currentPage.setAttribute('aria-busy', 'true');

        try {
            const response = await fetch(targetUrl, {
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                signal: navigationController.signal
            });
            if (!response.ok) throw new Error(`HTTP_${response.status}`);

            const html = await response.text();
            const nextDocument = new DOMParser().parseFromString(html, 'text/html');
            const nextPage = nextDocument.querySelector('.clients-page');
            if (!nextPage) {
                window.location.assign(response.url || targetUrl);
                return;
            }

            currentPage.replaceWith(nextPage);
            document.title = nextDocument.title;
            if (pushState) window.history.pushState({ accountDirectory: true }, '', targetUrl);
            window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        } catch (error) {
            if (error.name !== 'AbortError') window.location.assign(targetUrl);
        } finally {
            if (directoryNavigationController !== navigationController) return;
            directoryNavigationController = null;
            const activePage = document.querySelector('.clients-page');
            if (activePage) {
                activePage.classList.remove('directory-is-loading');
                activePage.removeAttribute('aria-busy');
            }
        }
    }

    document.addEventListener('click', (event) => {
        const link = event.target.closest('a[data-directory-nav]');
        if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const target = new URL(link.href, window.location.href);
        if (target.origin !== window.location.origin || target.pathname !== '/clients') return;
        event.preventDefault();
        navigateAccountDirectory(target.href);
    });

    document.addEventListener('submit', (event) => {
        const form = event.target.closest('form[data-directory-search]');
        if (!form) return;

        event.preventDefault();
        const target = new URL(form.action, window.location.href);
        target.search = new URLSearchParams(new FormData(form)).toString();
        navigateAccountDirectory(target.href);
    });

    window.addEventListener('popstate', () => {
        if (window.location.pathname === '/clients') navigateAccountDirectory(window.location.href, false);
    });

</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
