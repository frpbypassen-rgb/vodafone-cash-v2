<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>إيصال <%= detail.transaction.reference %></title><style>body{font-family:Arial,sans-serif;background:#eee;margin:0}.receipt{width:80mm;margin:20px auto;padding:7mm;background:#fff;color:#111}.center{text-align:center}.line{border-top:1px dashed #333;margin:10px 0}.row{display:flex;justify-content:space-between;gap:10px;margin:7px 0;font-size:12px}.big{font-size:20px;font-weight:bold}.muted{color:#555;font-size:10px}.actions{text-align:center;margin:15px}@media print{body{background:#fff}.receipt{margin:0;padding:4mm}.actions{display:none}@page{size:80mm auto;margin:0}}</style></head><body><div class="actions"><button onclick="window.print()">طباعة / حفظ PDF</button></div><main class="receipt"><div class="center"><strong>الأهرام Pay</strong><div class="muted">إيصال متابعة عملية</div></div><div class="line"></div><div class="row"><span>رقم العملية</span><strong dir="ltr"><%= detail.transaction.reference %></strong></div><div class="row"><span>الحالة</span><strong><%= detail.transaction.status %></strong></div><div class="row"><span>العميل</span><strong><%= detail.parties.sender %></strong></div><div class="row"><span>المستلم</span><strong dir="ltr"><%= detail.parties.recipient %></strong></div><div class="line"></div><div class="center big"><%= Number(detail.transaction.amount||0).toLocaleString('en-US',{minimumFractionDigits:2}) %> ج.م</div><div class="row"><span>التكلفة</span><strong dir="ltr"><%= Number(detail.transaction.costLYD||0).toLocaleString('en-US',{minimumFractionDigits:2}) %> LYD</strong></div><div class="row"><span>المنفذ</span><strong><%= detail.transaction.executor %></strong></div><div class="row"><span>التاريخ</span><strong><%= new Date(detail.transaction.createdAt).toLocaleString('ar-LY') %></strong></div><div class="line"></div><div class="center muted">طبع في <%= new Date(printedAt).toLocaleString('ar-LY') %></div></main></body></html>
