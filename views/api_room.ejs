<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>غرفة عمليات الـ API | شركة الأهرام</title>
    
    <script>
        const savedTheme = localStorage.getItem('ahram_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <script>
        const csrfToken = <%- JSON.stringify(typeof csrfToken !== 'undefined' ? csrfToken : '') %>;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: 'Tajawal', sans-serif; margin: 0; }
        .api-card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); margin-bottom: 20px;}
        .api-card-header { border-bottom: 1px solid #334155; padding: 15px 20px; font-weight: bold; }
        .stat-box { border: 1px solid #334155; border-radius: 10px; padding: 20px; text-align: center; background: #1e293b; height: 100%;}
        .form-control, .form-select, .input-group-text { background-color: #0f172a; border: 1px solid #334155; color: #e2e8f0; font-family: monospace; }
        .form-control:focus, .form-select:focus { background-color: #0f172a; color: #fff; border-color: #3b82f6; box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2); }
        .table-dark-custom { background-color: transparent; color: #e2e8f0; }
        .table-dark-custom th { border-bottom: 1px solid #334155; color: #94a3b8; font-weight: 500; }
        .table-dark-custom td { border-bottom: 1px solid #334155; vertical-align: middle; }
        .table-hover tbody tr:hover { background-color: rgba(255, 255, 255, 0.03); color: white;}
        .text-emerald { color: #10b981; }
        .text-rose { color: #f43f5e; }
        .text-sky { color: #0ea5e9; }
        .main-content { padding: 20px; }
        .recon-value { font-family: 'JetBrains Mono', monospace; direction: ltr; display: inline-block; }
        .recon-alert { border: 1px solid rgba(244, 63, 94, .45); background: rgba(244, 63, 94, .08); color: #fecdd3; }
        .recon-ok { border: 1px solid rgba(16, 185, 129, .35); background: rgba(16, 185, 129, .08); color: #a7f3d0; }
        .section-note { color: #94a3b8; font-size: .86rem; line-height: 1.7; }
        .table-actions { display: flex; justify-content: center; gap: 7px; flex-wrap: wrap; }
        .audit-alerts { max-width: 320px; white-space: normal; text-align: right; font-size: .8rem; line-height: 1.55; }
        .sync-state { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 8px; background: #0f172a; border: 1px solid #334155; color: #cbd5e1; font-size: .78rem; }
        @media (max-width: 767px) {
            .main-content { padding: 12px; }
            .api-card-header { align-items: flex-start !important; gap: 10px; flex-direction: column; }
            .api-card-header .btn { width: 100%; }
            .table-actions { min-width: 170px; }
        }
        
        /* 🟢 تنسيق زر الـ API */
        .btn-api-log { display: inline-flex; align-items: center; justify-content: center; padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: bold; transition: 0.2s; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); cursor: pointer; text-decoration: none; }
        .btn-api-log:hover { background: #10b981; color: white; transform: translateY(-2px); }
    </style>

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001a4d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Al-Ahram">
    <!-- End PWA Setup -->
</head>
<body>

<%- include('partials/sidebar', { activePage: 'executors' }) %>

<div class="main-content">
    <div class="container-fluid py-2" dir="rtl">
        
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="fa-solid fa-network-wired text-success me-2"></i> غرفة عمليات الـ API (الربط الآلي)</h3>
                <p class="text-muted mb-0">مراقبة اتصال السيرفر مع شركة: <span class="text-sky fw-bold"><%= bot.name %></span></p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <% if (typeof isMaster !== 'undefined' && isMaster) { %>
                    <a href="/admin/accounts/executor/<%= bot._id %>/edit" class="btn btn-primary rounded-pill px-4"><i class="fa-solid fa-pen-to-square me-2"></i> تعديل بيانات المنفذ</a>
                <% } %>
                <a href="/executors" class="btn btn-outline-light rounded-pill px-4"><i class="fa-solid fa-arrow-right me-2"></i> عودة لإدارة التنفيذ</a>
            </div>
        </div>

        <% if (typeof query !== 'undefined' && query.profileUpdated === '1') { %>
            <div class="alert alert-success fw-bold"><i class="fa-solid fa-circle-check me-2"></i> تم تحديث بيانات المنفذ بنجاح.</div>
        <% } %>

        <div class="row g-3 mb-4">
            <div class="col-6 col-xl">
                <div class="stat-box">
                    <p class="text-muted mb-2">عمليات مرفوضة (من الشركة)</p>
                    <h2 class="text-rose fw-bold mb-0"><%= stats.failedCount %></h2>
                </div>
            </div>
            <div class="col-6 col-xl">
                <div class="stat-box">
                    <p class="text-muted mb-2">عمليات ناجحة</p>
                    <h2 class="text-sky fw-bold mb-0"><%= stats.successCount %></h2>
                </div>
            </div>
            <div class="col-12 col-md-4 col-xl">
                <div class="stat-box">
                    <p class="text-muted mb-2">رصيد المزود المباشر</p>
                    <h2 class="text-emerald fw-bold mb-0"><%= bot.lastApiAvailableBalance !== null && bot.lastApiAvailableBalance !== undefined ? Number(bot.lastApiAvailableBalance).toFixed(2) : '---' %> <span class="fs-6">EGP</span></h2>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="stat-box <%= stats.balanceAlertCount ? 'recon-alert' : '' %>">
                    <p class="text-muted mb-2">فروقات تنتظر المراجعة</p>
                    <h2 class="<%= stats.balanceAlertCount ? 'text-rose' : 'text-emerald' %> fw-bold mb-0"><%= stats.balanceAlertCount %></h2>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="stat-box <%= stats.providerReturnCount ? 'recon-alert' : '' %>">
                    <p class="text-muted mb-2">مرتجعات المزود</p>
                    <h2 class="<%= stats.providerReturnCount ? 'text-rose' : 'text-emerald' %> fw-bold mb-0"><%= stats.providerReturnCount %></h2>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="api-card h-100">
                    <div class="api-card-header text-info d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-link me-2"></i> إعدادات نقطة الاتصال (Endpoint)</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small">مزود الخدمة</label>
                            <input type="text" class="form-control text-sky" value="<%= (typeof apiProviderPreset !== 'undefined' && apiProviderPreset.nameAr) ? apiProviderPreset.nameAr : (bot.apiProviderKey || 'Zayn External Aggregator') %>" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small">رابط الطلب (POST URL)</label>
                            <input type="text" class="form-control text-emerald" value="<%= bot.apiUrl || ((typeof apiProviderPreset !== 'undefined' && apiProviderPreset.apiUrl) ? apiProviderPreset.apiUrl : 'https://zaynpay.com') %>" readonly>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted small">مفتاح المصادقة (Secret Token)</label>
                            <input type="text" class="form-control text-rose" value="<%= bot.apiToken ? 'Bearer ********' : 'AutoLogin' %>" readonly>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-muted small">API Username</label>
                                <input type="text" class="form-control text-sky" value="<%= bot.apiUsername || 'ENV fallback' %>" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small">API Password</label>
                                <input type="text" class="form-control text-warning" value="<%= bot.apiPassword ? '********' : 'ENV fallback' %>" readonly>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Service ID</label>
                                <input type="text" class="form-control" value="<%= bot.apiServiceId || ((typeof apiProviderPreset !== 'undefined' && apiProviderPreset.serviceId) ? apiProviderPreset.serviceId : 85) %>" readonly>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Current Provider ID</label>
                                <input type="text" class="form-control" value="<%= bot.apiProviderId || ((typeof apiProviderPreset !== 'undefined' && apiProviderPreset.providerId) ? apiProviderPreset.providerId : 16) %>" readonly>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Field ID</label>
                                <input type="text" class="form-control" value="<%= bot.apiFieldId || ((typeof apiProviderPreset !== 'undefined' && apiProviderPreset.fieldId) ? apiProviderPreset.fieldId : 5488) %>" readonly>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Machine Serial</label>
                                <input type="text" class="form-control" value="<%= bot.apiMachineSerial || 'XP1' %>" readonly>
                            </div>
                        </div>

                        <div class="p-3 rounded-3 mb-3" style="background:#0f172a; border:1px solid #334155;">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div class="fw-bold text-light"><i class="fa-solid fa-signal text-info me-1"></i> اختبار اتصال المزود</div>
                                    <small class="<%= bot.lastApiTestStatus === 'success' ? 'text-success' : (bot.lastApiTestStatus === 'failed' ? 'text-danger' : 'text-muted') %>">
                                        <% if (bot.lastApiTestAt) { %>
                                            آخر اختبار: <%= new Date(bot.lastApiTestAt).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli' }) %>
                                            <% if (bot.lastApiAvailableBalance !== null && bot.lastApiAvailableBalance !== undefined) { %>
                                                | المتاح: <span dir="ltr"><%= Number(bot.lastApiAvailableBalance).toFixed(2) %></span>
                                            <% } %>
                                        <% } else { %>
                                            لم يتم اختبار هذا المنفذ بعد
                                        <% } %>
                                    </small>
                                </div>
                                <button type="button" class="btn btn-info fw-bold px-4" data-api-bot-id="<%= bot._id %>" onclick="testApiExecutor(this)">
                                    <i class="fa-solid fa-plug-circle-check me-1"></i> اختبار الرصيد
                                </button>
                            </div>
                        </div>
                        
                        <form action="/executor/<%= bot._id %>/toggle-status" method="POST">
                            <button type="submit" class="btn btn-<%= bot.status === 'active' ? 'danger' : 'success' %> w-100 fw-bold py-2 mb-4">
                                <i class="fa-solid fa-<%= bot.status === 'active' ? 'stop' : 'play' %> me-2"></i> 
                                <%= bot.status === 'active' ? 'إيقاف إرسال الطلبات للشركة' : 'تفعيل إرسال الطلبات للشركة' %>
                            </button>
                        </form>

                        <div class="border-top border-secondary pt-3 mt-2">
                            <label class="form-label text-warning small fw-bold"><i class="fa-solid fa-radar me-1"></i> ربط بسجل العمليات (Audit Trail Bot)</label>
                            <form action="/executor/<%= bot._id %>/link-manager" method="POST">
                                <div class="input-group">
                                    <select name="parentGroupId" class="form-select border-warning">
                                        <option value="none">-- غير مربوط بأي سجل --</option>
                                        <% managerBots.forEach(mBot => { %>
                                            <option value="<%= mBot._id %>" <%= ((bot.parentGroupId || bot.parentBotId) && (bot.parentGroupId || bot.parentBotId)._id && (bot.parentGroupId || bot.parentBotId)._id.toString() === mBot._id.toString()) ? 'selected' : '' %>>
                                                <%= mBot.name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <button type="submit" class="btn btn-warning fw-bold text-dark">ربط السجل</button>
                                </div>
                                <small class="text-muted mt-1 d-block" style="font-size: 0.8rem;">اختر البوت الذي سيستقبل إشعارات بدء ونجاح وفشل عمليات الـ API.</small>
                            </form>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="api-card h-100">
                    <div class="api-card-header text-warning d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-coins me-2"></i> إدارة العهدة الرقمية</span>
                    </div>
                    <div class="card-body p-4">
                        <form action="/executor/<%= bot._id %>/settle" method="POST">
                            <div class="mb-3">
                                <label class="form-label text-muted small">إيداع / خصم المبلغ (EGP)</label>
                                <input type="number" step="0.01" name="amount" class="form-control form-control-lg text-center fw-bold fs-3" placeholder="0.00" required>
                                <div class="form-text text-info mt-2"><i class="fa-solid fa-circle-info"></i> اكتب الرقم بالموجب لزيادة العهدة، وبالسالب (-) للخصم.</div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label text-muted small">المرجع (ملاحظة)</label>
                                <input type="text" name="notes" class="form-control" placeholder="مثال: تم إيداع عهدة جديدة لشركة كذا...">
                            </div>
                            <button type="submit" class="btn btn-warning w-100 fw-bold text-dark py-2 fs-5">
                                <i class="fa-solid fa-bolt me-2"></i> تنفيذ تسوية الرصيد
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="api-card" id="balance-reconciliation">
            <div class="api-card-header text-info d-flex justify-content-between align-items-center">
                <div>
                    <span><i class="fa-solid fa-scale-balanced me-2"></i> مطابقة رصيد المزود قبل وبعد كل عملية</span>
                </div>
                <span class="sync-state"><i class="fa-solid fa-rotate"></i> فحص تلقائي مع كل عملية</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-dark-custom text-center mb-0">
                        <thead>
                            <tr>
                                <th class="py-3">الوقت</th>
                                <th class="py-3">رقم العملية</th>
                                <th class="py-3">آخر رصيد بعد التنفيذ</th>
                                <th class="py-3">الرصيد قبل</th>
                                <th class="py-3">الرصيد بعد</th>
                                <th class="py-3">الخصم الفعلي / المتوقع</th>
                                <th class="py-3">نتيجة المطابقة</th>
                                <th class="py-3">الإجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!balanceAudits.length) { %>
                                <tr><td colspan="8" class="py-5 text-muted">سيظهر أول سجل مطابقة عند تنفيذ العملية التالية عبر هذا المنفذ.</td></tr>
                            <% } %>
                            <% balanceAudits.forEach(audit => {
                                const beforeBalance = audit.beforeCheck && audit.beforeCheck.availableBalance !== null ? audit.beforeCheck.availableBalance : null;
                                const afterBalance = audit.afterCheck && audit.afterCheck.availableBalance !== null ? audit.afterCheck.availableBalance : null;
                                const previousAfter = audit.previousPostAvailableBalance !== null && audit.previousPostAvailableBalance !== undefined ? audit.previousPostAvailableBalance : null;
                                const statusClass = audit.checkStatus === 'matched' ? 'success' : (audit.checkStatus === 'pending' ? 'warning' : 'danger');
                                const statusText = audit.checkStatus === 'matched' ? 'متطابق' : (audit.checkStatus === 'discrepancy' ? 'يوجد فرق' : (audit.checkStatus === 'check_failed' ? 'فشل الفحص' : 'جارٍ الفحص'));
                            %>
                                <tr>
                                    <td class="text-muted small"><%= new Date(audit.createdAt).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli' }) %></td>
                                    <td>
                                        <a class="text-light fw-bold text-decoration-none" href="/transactions?search=<%= encodeURIComponent(audit.transactionCustomId) %>"><%= audit.transactionCustomId %></a>
                                        <% if (audit.providerTransactionId) { %><small class="d-block text-muted" dir="ltr"><%= audit.providerTransactionId %></small><% } %>
                                    </td>
                                    <td><span class="recon-value"><%= previousAfter !== null ? Number(previousAfter).toFixed(2) : '---' %></span></td>
                                    <td><span class="recon-value"><%= beforeBalance !== null ? Number(beforeBalance).toFixed(2) : '---' %></span></td>
                                    <td><span class="recon-value"><%= afterBalance !== null ? Number(afterBalance).toFixed(2) : '---' %></span></td>
                                    <td>
                                        <span class="recon-value"><%= audit.observedDebit !== null && audit.observedDebit !== undefined ? Number(audit.observedDebit).toFixed(2) : '---' %></span>
                                        <small class="d-block text-muted">المتوقع: <span dir="ltr"><%= audit.expectedDebit !== null && audit.expectedDebit !== undefined ? Number(audit.expectedDebit).toFixed(2) : '---' %></span></small>
                                    </td>
                                    <td>
                                        <span class="badge border border-<%= statusClass %> text-<%= statusClass %> bg-transparent px-3 py-2"><%= statusText %></span>
                                        <% if (audit.alerts && audit.alerts.length) { %>
                                            <div class="audit-alerts text-danger mt-2"><%= audit.alerts.join(' | ') %></div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (audit.reviewStatus === 'pending') { %>
                                            <button type="button" class="btn btn-sm btn-outline-info" onclick="reviewBalanceAudit('<%= audit._id %>', this)"><i class="fa-solid fa-check me-1"></i> تمت المراجعة</button>
                                        <% } else if (audit.reviewStatus === 'reviewed') { %>
                                            <span class="text-success small"><i class="fa-solid fa-user-check me-1"></i> <%= audit.reviewedBy || 'تمت المراجعة' %></span>
                                        <% } else { %>
                                            <span class="text-muted small">لا يحتاج إجراء</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="api-card" id="provider-returns">
            <div class="api-card-header text-warning d-flex justify-content-between align-items-center">
                <div>
                    <span><i class="fa-solid fa-arrow-rotate-left me-2"></i> العمليات المسترجعة من مزود الـ API</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="sync-state">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <% if (bot.lastApiReturnSyncAt) { %>
                            آخر مراجعة: <%= new Date(bot.lastApiReturnSyncAt).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli' }) %>
                        <% } else { %>
                            لم تتم المراجعة بعد
                        <% } %>
                    </span>
                    <button type="button" class="btn btn-warning fw-bold" data-api-bot-id="<%= bot._id %>" onclick="syncProviderReturns(this)">
                        <i class="fa-solid fa-arrows-rotate me-1"></i> مراجعة الآن
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <% if (bot.lastApiReturnSyncMessage) { %>
                    <div class="px-3 py-2 border-bottom border-secondary section-note"><i class="fa-solid fa-circle-info me-1"></i> <%= bot.lastApiReturnSyncMessage %></div>
                <% } %>
                <div class="table-responsive">
                    <table class="table table-hover table-dark-custom text-center mb-0">
                        <thead>
                            <tr>
                                <th class="py-3">اكتشاف الاسترجاع</th>
                                <th class="py-3">رقم عملية المزود</th>
                                <th class="py-3">رقم عمليتنا</th>
                                <th class="py-3">المستفيد</th>
                                <th class="py-3">المبلغ</th>
                                <th class="py-3">حالة المزود</th>
                                <th class="py-3">حالة المراجعة</th>
                                <th class="py-3">الإجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!providerReturns.length) { %>
                                <tr><td colspan="8" class="py-5 text-muted"><i class="fa-solid fa-circle-check text-success d-block fs-3 mb-2"></i> لا توجد عمليات مسترجعة مسجلة لهذا المنفذ.</td></tr>
                            <% } %>
                            <% providerReturns.forEach(item => {
                                const reviewLabel = item.status === 'cancelled' ? 'تم الإلغاء ورد الرصيد' : (item.status === 'reviewed' ? 'تمت المراجعة' : 'تنتظر الإدارة');
                                const reviewTone = item.status === 'cancelled' ? 'success' : (item.status === 'reviewed' ? 'info' : 'warning');
                            %>
                                <tr>
                                    <td class="text-muted small"><%= new Date(item.firstDetectedAt).toLocaleString('ar-LY', { timeZone: 'Africa/Tripoli' }) %></td>
                                    <td>
                                        <strong class="text-warning" dir="ltr"><%= item.providerTransactionId %></strong>
                                        <% if (item.referenceNumber) { %><small class="d-block text-muted" dir="ltr">Ref: <%= item.referenceNumber %></small><% } %>
                                    </td>
                                    <td><a class="text-light fw-bold text-decoration-none" href="/transactions?search=<%= encodeURIComponent(item.transactionCustomId) %>"><%= item.transactionCustomId || '---' %></a></td>
                                    <td class="font-monospace" dir="ltr"><%= item.phone || '---' %></td>
                                    <td><strong class="recon-value"><%= item.amount !== null && item.amount !== undefined ? Number(item.amount).toFixed(2) : '---' %></strong> <small>EGP</small></td>
                                    <td><span class="badge border border-danger text-danger bg-transparent px-3 py-2"><%= item.providerStatus || 'مسترجعة' %></span></td>
                                    <td>
                                        <span class="badge bg-<%= reviewTone %> text-<%= reviewTone === 'warning' ? 'dark' : 'light' %>"><%= reviewLabel %></span>
                                        <% if (item.cancellationNumber) { %><small class="d-block text-success mt-1" dir="ltr"><%= item.cancellationNumber %></small><% } %>
                                    </td>
                                    <td>
                                        <div class="table-actions">
                                            <% if (item.status === 'pending_review') { %>
                                                <button type="button" class="btn btn-sm btn-outline-info" onclick="reviewProviderReturn('<%= item._id %>', this)"><i class="fa-solid fa-eye me-1"></i> مراجعة</button>
                                            <% } %>
                                            <% if (item.status !== 'cancelled') { %>
                                                <button type="button" class="btn btn-sm btn-danger" onclick="cancelProviderReturn('<%= item._id %>', '<%= String(item.providerTransactionId).replace(/'/g, '') %>', this)"><i class="fa-solid fa-ban me-1"></i> إلغاء ورد الرصيد</button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="api-card">
            <div class="api-card-header text-primary d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-terminal me-2"></i> سجل التخاطب مع السيرفر (API Logs)</span>
                <span class="badge bg-primary rounded-pill">أحدث 100 حركة</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-dark-custom text-center mb-0">
                        <thead>
                            <tr>
                                <th class="py-3">الوقت</th>
                                <th class="py-3">رقم عمليتنا</th>
                                <th class="py-3">رقم المستفيد</th>
                                <th class="py-3">المبلغ (EGP)</th>
                                <th class="py-3">السجل التفصيلي / الملاحظة</th>
                                <th class="py-3">الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(transactions.length === 0) { %>
                                <tr><td colspan="6" class="py-5 text-muted">لا يوجد سجل عمليات حتى الآن.</td></tr>
                            <% } %>
                            <% transactions.forEach(tx => {
                                const apiLogText = [tx.adminNotes, tx.notes].filter(Boolean).join('\n');
                                const hasApiLog = apiLogText.includes('--- سجل الـ API');
                            %>
                                <tr>
                                    <td class="text-muted small"><%= new Date(tx.updatedAt).toLocaleString('en-GB', { timeZone: 'Africa/Tripoli' }) %></td>
                                    <td class="fw-bold text-light"><%= tx.customId || tx._id.toString().slice(-6) %></td>
                                    <td class="font-monospace text-warning"><%= tx.vodafoneNumber || 'تسديد حساب' %></td>
                                    <td class="fw-bold fs-5"><%= tx.amount %></td>
                                    <td>
                                        <% if (hasApiLog) { %>
                                            <button onclick="showApiLog(this)" data-log="<%= encodeURIComponent(apiLogText) %>" class="btn-api-log">
                                                <i class="fa-solid fa-terminal me-2"></i> عرض السجل
                                            </button>
                                        <% } else { %>
                                            <span class="text-muted small text-wrap" style="max-width: 150px; display: inline-block;">
                                                <%= tx.notes || '---' %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if(tx.status === 'completed') { %> <span class="badge border border-success text-success bg-transparent px-3 py-2"><i class="fa-solid fa-check me-1"></i> نجاح (200 OK)</span>
                                        <% } else if(tx.status === 'deposit') { %> <span class="badge border border-info text-info bg-transparent px-3 py-2"><i class="fa-solid fa-arrow-down me-1"></i> إيداع عهدة</span>
                                        <% } else if(tx.status === 'deduction') { %> <span class="badge border border-danger text-danger bg-transparent px-3 py-2"><i class="fa-solid fa-arrow-up me-1"></i> سحب عهدة</span>
                                        <% } else { %> <span class="badge border border-warning text-warning bg-transparent px-3 py-2"><i class="fa-solid fa-triangle-exclamation me-1"></i> خطأ استجابة</span> <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function toggleSidebar() { 
        document.querySelector('.sidebar').classList.toggle('active');
        document.querySelector('.sidebar-overlay').classList.toggle('active'); 
    }

    // 🟢 دالة عرض نافذة السجل المنبثقة (Terminal View)
    function showApiLog(btn) {
        const rawNotes = decodeURIComponent(btn.getAttribute('data-log'));
        const logMarker = '--- سجل الـ API (Terminal Log) ---';
        let logContent = rawNotes;
        if(rawNotes.includes(logMarker)) {
            logContent = rawNotes.split(logMarker)[1].trim();
        } else if (rawNotes.includes('--- سجل الـ API ---')) {
            logContent = rawNotes.split('--- سجل الـ API ---')[1].trim();
        } else if (rawNotes.includes('--- سجل الـ API')) {
            logContent = rawNotes.split('--- سجل الـ API')[1].trim();
        }
        
        Swal.fire({
            title: '<div style="color:#10b981; font-family:monospace; font-size:1.2rem; display:flex; align-items:center; gap:10px; justify-content:center;"><i class="fa-solid fa-terminal"></i> سجل التخاطب مع السيرفر</div>',
            html: `<div style="background:#0f172a; color:#a5b4fc; padding:15px; border-radius:8px; text-align:left; direction:ltr; font-family:'JetBrains Mono', monospace; font-size:0.85rem; white-space:pre-wrap; max-height:400px; overflow-y:auto; border:1px solid #334155; box-shadow:inset 0 2px 4px rgba(0,0,0,0.5);">${logContent}</div>`,
            background: '#1e293b',
            color: '#fff',
            confirmButtonColor: '#3b82f6',
            confirmButtonText: 'إغلاق الشاشة',
            width: '600px',
            customClass: { popup: 'border border-secondary rounded-4' }
        });
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    async function testApiExecutor(button) {
        const botId = button?.dataset?.apiBotId;
        if (!botId) return;
        const originalHtml = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> جاري الاختبار...';

        try {
            const res = await fetch(`/executor/${encodeURIComponent(botId)}/test-api`, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'x-csrf-token': csrfToken
                },
                body: '{}'
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) {
                throw new Error(data.message || data.error || 'فشل اختبار منفذ API');
            }

            Swal.fire({
                icon: 'success',
                title: 'الاتصال يعمل',
                html: `
                    <div style="direction:rtl;text-align:right;line-height:1.9">
                        <div><b>رصيد الخدمة:</b> <span dir="ltr">${Number(data.serviceCredit || 0).toFixed(2)}</span></div>
                        <div><b>الرصيد النقدي:</b> <span dir="ltr">${Number(data.cashCredit || 0).toFixed(2)}</span></div>
                        <div><b>الرصيد المتاح:</b> <span dir="ltr">${Number(data.availableBalance || data.balance || 0).toFixed(2)}</span></div>
                    </div>
                `,
                background: '#1e293b',
                color: '#fff',
                confirmButtonColor: '#0ea5e9',
                confirmButtonText: 'تحديث الصفحة'
            }).then(() => window.location.reload());
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'فشل اختبار الاتصال',
                html: `<div style="direction:rtl;text-align:right">${escapeHtml(error.message)}</div>`,
                background: '#1e293b',
                color: '#fff',
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'إغلاق'
            });
        } finally {
            button.disabled = false;
            button.innerHTML = originalHtml;
        }
    }

    async function postApiAction(url, body = {}) {
        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'x-csrf-token': csrfToken
            },
            body: JSON.stringify(body)
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) {
            throw new Error(data.message || data.error || 'تعذر تنفيذ الطلب');
        }
        return data;
    }

    async function syncProviderReturns(button) {
        const botId = button?.dataset?.apiBotId;
        if (!botId) return;
        const originalHtml = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> جارٍ فحص العمليات...';
        try {
            const data = await postApiAction(`/executor/${encodeURIComponent(botId)}/sync-provider-returns`);
            await Swal.fire({
                icon: data.returnedCount ? 'warning' : 'success',
                title: 'اكتملت مراجعة المزود',
                html: `<div style="direction:rtl;text-align:right;line-height:1.9">${escapeHtml(data.message)}<br>عمليات مسترجعة جديدة: <b>${Number(data.newAlerts || 0)}</b></div>`,
                background: '#1e293b',
                color: '#fff',
                confirmButtonColor: '#f59e0b',
                confirmButtonText: 'عرض النتائج'
            });
            window.location.hash = 'provider-returns';
            window.location.reload();
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'تعذر فحص العمليات', text: error.message, background: '#1e293b', color: '#fff' });
        } finally {
            button.disabled = false;
            button.innerHTML = originalHtml;
        }
    }

    async function reviewBalanceAudit(auditId, button) {
        button.disabled = true;
        try {
            await postApiAction(`/executor/<%= bot._id %>/balance-audit/${encodeURIComponent(auditId)}/review`);
            window.location.hash = 'balance-reconciliation';
            window.location.reload();
        } catch (error) {
            button.disabled = false;
            Swal.fire({ icon: 'error', title: 'تعذر حفظ المراجعة', text: error.message, background: '#1e293b', color: '#fff' });
        }
    }

    async function reviewProviderReturn(returnId, button) {
        const result = await Swal.fire({
            icon: 'question',
            title: 'تسجيل المراجعة فقط؟',
            text: 'لن يتم إلغاء العملية ولن يتغير رصيد العميل.',
            showCancelButton: true,
            confirmButtonText: 'نعم، تمت المراجعة',
            cancelButtonText: 'رجوع',
            background: '#1e293b',
            color: '#fff',
            confirmButtonColor: '#0ea5e9'
        });
        if (!result.isConfirmed) return;
        button.disabled = true;
        try {
            await postApiAction(`/executor/<%= bot._id %>/provider-return/${encodeURIComponent(returnId)}/review`);
            window.location.hash = 'provider-returns';
            window.location.reload();
        } catch (error) {
            button.disabled = false;
            Swal.fire({ icon: 'error', title: 'تعذر حفظ المراجعة', text: error.message, background: '#1e293b', color: '#fff' });
        }
    }

    async function cancelProviderReturn(returnId, providerTransactionId, button) {
        const result = await Swal.fire({
            icon: 'warning',
            title: 'إلغاء العملية ورد رصيد العميل',
            html: `<div style="direction:rtl;text-align:right;line-height:1.8">سيتم إنشاء رقم إلغاء وقيد عكسي للعملية المرتبطة برقم المزود <b dir="ltr">${escapeHtml(providerTransactionId)}</b>.</div>`,
            input: 'text',
            inputLabel: 'سبب الإلغاء',
            inputValue: `استرجاع مؤكد من مزود API - ${providerTransactionId}`,
            inputValidator: value => value && value.trim() ? undefined : 'اكتب سبب الإلغاء',
            showCancelButton: true,
            confirmButtonText: 'تأكيد الإلغاء ورد الرصيد',
            cancelButtonText: 'رجوع',
            background: '#1e293b',
            color: '#fff',
            confirmButtonColor: '#dc2626'
        });
        if (!result.isConfirmed) return;
        button.disabled = true;
        try {
            const data = await postApiAction(
                `/executor/<%= bot._id %>/provider-return/${encodeURIComponent(returnId)}/cancel`,
                { reason: result.value }
            );
            await Swal.fire({
                icon: 'success',
                title: 'تم الإلغاء ورد الرصيد',
                html: `<div>رقم الإلغاء: <b dir="ltr">${escapeHtml(data.cancellationNumber || '---')}</b></div>`,
                background: '#1e293b',
                color: '#fff',
                confirmButtonColor: '#10b981'
            });
            window.location.hash = 'provider-returns';
            window.location.reload();
        } catch (error) {
            button.disabled = false;
            Swal.fire({ icon: 'error', title: 'لم يتم إلغاء العملية', text: error.message, background: '#1e293b', color: '#fff' });
        }
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
