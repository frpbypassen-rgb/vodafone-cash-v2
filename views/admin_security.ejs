<!DOCTYPE html><html lang="ar" dir="rtl"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>مركز الأمان الذكي | الأهرام</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
<style>
.security-shell{max-width:1500px;margin:auto;padding-bottom:45px}.security-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0 18px}.security-header h1{font-size:1.65rem;font-weight:900;margin:0}.security-header p,.muted{color:var(--text-muted)}.status-pill,.pill{display:inline-flex;align-items:center;gap:7px;padding:8px 12px;border:1px solid var(--border-glass);border-radius:999px;font-weight:800;background:var(--card-bg)}.pill{padding:5px 9px;font-size:.76rem}.mono{font-family:'JetBrains Mono',monospace;direction:ltr}.summary-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:18px}.metric{min-height:112px;border:1px solid var(--border-glass);border-radius:14px;background:var(--card-bg);padding:17px;display:flex;justify-content:space-between;gap:12px}.metric i{width:42px;height:42px;display:grid;place-items:center;border-radius:12px;color:#0d6efd;background:rgba(13,110,253,.1)}.metric strong{display:block;font:900 1.55rem 'JetBrains Mono',monospace}.metric span{color:var(--text-muted);font-size:.78rem;font-weight:800}.alert-strip{display:grid;grid-template-columns:1fr auto;align-items:center;gap:12px;border:1px solid var(--border-glass);border-right:5px solid #198754;border-radius:12px;background:var(--card-bg);padding:14px 16px;margin:9px 0}.alert-strip.danger{border-right-color:#dc3545}.alert-strip.warning{border-right-color:#f59e0b}.alert-strip strong,.alert-strip small{display:block}.alert-strip small{color:var(--text-muted);margin-top:3px}.quick-row{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.quick-link{display:inline-flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid var(--border-glass);border-radius:9px;background:var(--card-bg);color:var(--text-main);text-decoration:none;font-weight:800;font-size:.82rem}.quick-link:hover{border-color:#0d6efd;color:#0d6efd}.security-tabs{display:flex;gap:7px;overflow:auto;position:sticky;top:0;z-index:20;padding:10px;margin:18px 0;background:color-mix(in srgb,var(--body-bg) 92%,transparent);backdrop-filter:blur(12px);border:1px solid var(--border-glass);border-radius:13px}.security-tab{border:0;border-radius:9px;background:transparent;color:var(--text-muted);padding:11px 15px;white-space:nowrap;font-weight:900}.security-tab.active{background:#0d6efd;color:#fff}.tab-count{background:rgba(255,255,255,.2);padding:2px 7px;border-radius:999px;margin-right:5px}.tab-panel{display:none}.tab-panel.active{display:block}.section-card{border:1px solid var(--border-glass);border-radius:14px;background:var(--card-bg);padding:20px;margin-bottom:16px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:16px}.section-heading h2{font-size:1.12rem;font-weight:900;margin:0}.section-heading p{margin:5px 0 0;color:var(--text-muted);font-size:.84rem}.toolbar{display:flex;gap:9px;flex-wrap:wrap}.toolbar .form-control,.toolbar .form-select{max-width:260px}.table-wrap{overflow:auto;border:1px solid var(--border-glass);border-radius:11px}.table-wrap table{min-width:950px;margin:0}.table-wrap td,.table-wrap th{vertical-align:middle;padding:13px}.empty{padding:40px!important;text-align:center;color:var(--text-muted)}.online-dot{width:9px;height:9px;border-radius:50%;display:inline-block;background:#198754;box-shadow:0 0 0 4px rgba(25,135,84,.12);margin-left:8px}.event-icon{width:34px;height:34px;display:inline-grid;place-items:center;border-radius:9px;background:rgba(13,110,253,.1);color:#0d6efd;margin-left:8px}.event-icon.danger{background:rgba(220,53,69,.1);color:#dc3545}.event-icon.warning{background:rgba(245,158,11,.13);color:#b46c00}.event-icon.success{background:rgba(25,135,84,.1);color:#198754}.settings-block{border:1px solid var(--border-glass);border-radius:12px;margin-bottom:12px;background:var(--card-bg)}.settings-block>summary{cursor:pointer;list-style:none;padding:17px 19px;font-weight:900}.settings-body{padding:0 19px 19px}.policy-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.policy-item{display:flex;justify-content:space-between;align-items:center;gap:14px;border:1px solid var(--border-glass);border-radius:10px;padding:14px;background:var(--input-bg)}.policy-item strong,.policy-item small{display:block}.policy-item small{color:var(--text-muted)}.action-row{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}.admin-create{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.permission-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-height:280px;overflow:auto}.permission-item{border:1px solid var(--border-glass);border-radius:8px;padding:9px;font-size:.78rem;background:var(--input-bg)}.emergency-band{border:1px solid rgba(220,53,69,.35);border-right:5px solid #dc3545;padding:18px;border-radius:10px;background:rgba(220,53,69,.05)}.emergency-code{direction:ltr;font:800 1.05rem 'JetBrains Mono';border:1px dashed #dc3545;padding:11px;display:none;margin-top:12px;text-align:center}.dialog{width:min(720px,calc(100vw - 28px));max-height:88vh;overflow:auto;color:var(--text-main);background:var(--card-bg);border:1px solid var(--border-glass);border-radius:13px;padding:0}.dialog::backdrop{background:rgba(4,12,24,.72);backdrop-filter:blur(5px)}.dialog-head{display:flex;justify-content:space-between;gap:16px;padding:17px 19px;border-bottom:1px solid var(--border-glass)}.dialog-body{padding:19px}.details-json{direction:ltr;text-align:left;white-space:pre-wrap;overflow-wrap:anywhere;background:var(--input-bg);border:1px solid var(--border-glass);border-radius:9px;padding:14px;font:600 .76rem/1.7 'JetBrains Mono'}.toast-box{position:fixed;left:24px;bottom:24px;padding:14px 16px;border-radius:9px;color:#fff;background:#0f766e;z-index:2000;display:none}.lockdown{display:flex;justify-content:space-between;padding:16px 18px;border:1px solid #dc3545;border-right:5px solid #dc3545;border-radius:11px;background:rgba(220,53,69,.08);margin-bottom:12px}.lockdown-clock{direction:ltr;font:900 1.4rem 'JetBrains Mono';color:#dc3545}
@media(max-width:1200px){.summary-grid{grid-template-columns:repeat(3,1fr)}.admin-create{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.main-content{padding:16px!important}.security-header,.section-heading,.alert-strip{display:grid}.summary-grid{grid-template-columns:repeat(2,1fr)}.summary-grid .metric:last-child{grid-column:1/-1}.policy-grid,.admin-create,.permission-grid{grid-template-columns:1fr}.toolbar>*{max-width:none!important;width:100%}}
</style></head><body>
<button class="mobile-nav-toggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button><div class="sidebar-overlay" onclick="toggleSidebar()"></div><%- include('partials/sidebar',{activePage:'security'}) %>
<div class="main-content"><main class="security-shell">
<header class="security-header"><div><h1><i class="fa-solid fa-shield-halved text-primary ms-2"></i>مركز الأمان الذكي</h1><p>الأجهزة والحركة والحسابات والتنبيهات المهمة في مكان واحد.</p></div><span class="status-pill <%= securityState.lockdownActive?'text-danger':'text-success' %>"><i class="fa-solid <%= securityState.lockdownActive?'fa-lock':'fa-circle-check' %>"></i><%= securityState.lockdownActive?'إيقاف أمني نشط':'النظام يعمل بأمان' %></span></header>
<% if(securityState.lockdownActive&&securityState.lockdownEndsAt){ %><section class="lockdown" data-lockdown-end="<%= new Date(securityState.lockdownEndsAt).toISOString() %>"><div><strong>الإيقاف الأمني مفعل</strong><small class="d-block muted">المعاملات الحساسة متوقفة حتى نهاية المهلة.</small></div><time class="lockdown-clock" id="lockdownClock">60:00</time></section><% } %>
<% if(enrollmentRequired){ %><section class="lockdown" style="border-color:#0d6efd;background:rgba(13,110,253,.06)"><div><strong class="text-primary">تسجيل الجهاز الإداري مطلوب</strong><small class="d-block muted">سجّل Windows Hello أو بصمة الهاتف.</small></div><button class="btn btn-primary" onclick="openTab('settings')">الإعدادات</button></section><% } %>
<section class="summary-grid"><div class="metric"><div><strong><%= commandCenter.stats.onlineAccounts %></strong><span>حسابات متصلة الآن</span></div><i class="fa-solid fa-signal"></i></div><div class="metric"><div><strong><%= commandCenter.stats.onlineDevices %></strong><span>أجهزة نشطة خلال <%= commandCenter.onlineWindowMinutes %> دقائق</span></div><i class="fa-solid fa-laptop-mobile"></i></div><div class="metric"><div><strong><%= commandCenter.stats.transfersToday %></strong><span>تحويلات جديدة اليوم</span></div><i class="fa-solid fa-money-bill-transfer"></i></div><div class="metric"><div><strong><%= commandCenter.stats.failedToday %></strong><span>حركات فاشلة اليوم</span></div><i class="fa-solid fa-triangle-exclamation"></i></div><div class="metric"><div><strong><%= accessRequests.length %></strong><span>طلبات أجهزة معلقة</span></div><i class="fa-solid fa-user-clock"></i></div></section>
<section><% commandCenter.alerts.forEach(alert=>{ %><div class="alert-strip <%= alert.tone %>"><div><strong><i class="fa-solid <%= alert.tone==='success'?'fa-circle-check':'fa-bell' %> ms-2"></i><%= alert.title %></strong><small><%= alert.text %></small></div><button class="btn btn-sm btn-outline-secondary" onclick="openTab('<%= alert.tab %>')">مراجعة</button></div><% }) %></section>
<nav class="quick-row"><a class="quick-link" href="/transactions/pulse"><i class="fa-solid fa-wave-square"></i>نبض العمليات</a><a class="quick-link" href="/transactions?status=pending"><i class="fa-solid fa-hourglass-half"></i>المعلقة</a><a class="quick-link" href="/clients"><i class="fa-solid fa-users"></i>العملاء والشركات</a><a class="quick-link" href="/employees"><i class="fa-solid fa-user-gear"></i>المنفذون</a><a class="quick-link" href="/audit-log"><i class="fa-solid fa-file-shield"></i>سجل التدقيق الكامل</a></nav>
<nav class="security-tabs"><button class="security-tab active" data-tab="devices" onclick="openTab('devices')"><i class="fa-solid fa-laptop-mobile ms-2"></i>الأجهزة المتصلة <span class="tab-count"><%= commandCenter.connectedDevices.length %></span></button><button class="security-tab" data-tab="activity" onclick="openTab('activity')"><i class="fa-solid fa-clock-rotate-left ms-2"></i>سجل الحركة</button><button class="security-tab" data-tab="users" onclick="openTab('users')"><i class="fa-solid fa-users ms-2"></i>المستخدمون <span class="tab-count"><%= commandCenter.accounts.length %></span></button><button class="security-tab" data-tab="settings" onclick="openTab('settings')"><i class="fa-solid fa-shield-halved ms-2"></i>إعدادات الحماية</button></nav>

<section class="tab-panel active" data-panel="devices"><div class="section-card"><div class="section-heading"><div><h2>المتصلون الآن</h2><p>آخر نشاط خلال <%= commandCenter.onlineWindowMinutes %> دقائق. الموقع هو آخر موقع وافق الجهاز على إرساله.</p></div><div class="toolbar"><input class="form-control" type="search" placeholder="اسم الحساب أو الجهاز" oninput="filterRows('deviceRows',this.value)"></div></div><div class="table-wrap"><table class="table"><thead><tr><th>الحساب</th><th>الفئة</th><th>الجهاز</th><th>القناة</th><th>آخر ظهور</th><th>الشبكة والموقع</th><th></th></tr></thead><tbody id="deviceRows"><% if(!commandCenter.connectedDevices.length){ %><tr><td colspan="7" class="empty">لا توجد حسابات نشطة الآن.</td></tr><% } commandCenter.connectedDevices.forEach(device=>{ %><tr data-search="<%= `${device.accountName} ${device.principalLabel} ${device.platform} ${device.browser}`.toLowerCase() %>"><td><span class="online-dot"></span><strong><%= device.accountName %></strong><small class="d-block muted"><%= device.principalId %></small></td><td><%= device.principalLabel %></td><td><strong><%= device.deviceLabel %></strong><small class="d-block muted"><%= [device.platform,device.browser].filter(Boolean).join(' · ')||device.displayName %></small></td><td><span class="pill"><%= device.channelLabel %></span></td><td><%= device.lastSeenAt?new Date(device.lastSeenAt).toLocaleString('ar-EG'):'-' %></td><td><span class="mono"><%= device.lastIp||'-' %></span><% if(device.mapUrl){ %><a class="d-block" target="_blank" rel="noopener" href="<%= device.mapUrl %>"><i class="fa-solid fa-location-dot ms-1"></i>خرائط Google</a><small class="muted">دقة <%= Math.round(device.lastLocation?.accuracy||0) %> م</small><% }else{ %><small class="d-block muted">لم يرسل موقعًا</small><% } %></td><td><button class="btn btn-sm btn-outline-danger" onclick="revokeDevice('<%= device._id %>')">إلغاء</button></td></tr><% }) %></tbody></table></div></div>
<% if(accessRequests.length){ %><div class="section-card"><div class="section-heading"><div><h2>طلبات أجهزة تحتاج قرارًا</h2><p>راجع الحساب والجهاز والموقع قبل الموافقة.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>الحساب</th><th>الجهاز</th><th>الموقع</th><th>المخاطر</th><th></th></tr></thead><tbody><% accessRequests.forEach(request=>{ %><tr><td><strong><%= request.principalName||request.principalId %></strong><small class="d-block muted"><%= request.principalLabel %> · <%= request.requestCode %></small></td><td><%= request.displayName %><small class="d-block muted"><%= request.deviceType %> · <%= request.platform||'غير محدد' %></small></td><td class="mono"><%= request.ipAddress||'-' %><% if(request.location?.latitude!=null&&request.location?.longitude!=null){ %><a class="d-block" target="_blank" rel="noopener" href="https://www.google.com/maps?q=<%= request.location.latitude %>,<%= request.location.longitude %>">الخريطة</a><% } %></td><td><%= request.riskSignals?.length?request.riskSignals.join('، '):'لا توجد إشارة مرتفعة' %></td><td><div class="d-flex gap-2"><form method="post" action="/admin/security/access-requests/<%= request._id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-success">موافقة</button></form><form method="post" action="/admin/security/access-requests/<%= request._id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger">رفض</button></form></div></td></tr><% }) %></tbody></table></div></div><% } %></section>

<section class="tab-panel" data-panel="activity"><div class="section-card"><div class="section-heading"><div><h2>سجل حركة الحسابات</h2><p>الدخول والخروج والتحويلات وتغييرات الأمان، مع زر تفاصيل لكل حدث.</p></div><div class="toolbar"><select class="form-select" id="activityType" onchange="filterActivity()"><option value="">كل الحركات</option><option value="LOGIN">الدخول</option><option value="TRANSFER">التحويلات</option><option value="SECURITY">الأمان</option><option value="TRANSACTION">تعديلات العمليات</option></select><input class="form-control" id="activitySearch" type="search" placeholder="الحساب أو IP" oninput="filterActivity()"></div></div><div class="table-wrap"><table class="table"><thead><tr><th>الحركة</th><th>الحساب</th><th>القناة والجهاز</th><th>النتيجة</th><th>IP</th><th>الوقت</th><th></th></tr></thead><tbody id="activityRows"><% if(!commandCenter.activities.length){ %><tr><td colspan="7" class="empty">لا توجد حركات مسجلة.</td></tr><% } commandCenter.activities.forEach(item=>{ %><tr data-action="<%= item.action %>" data-search="<%= `${item.actor} ${item.ipAddress} ${item.label}`.toLowerCase() %>"><td><span class="event-icon <%= item.tone %>"><i class="fa-solid <%= item.action.includes('LOGIN')?'fa-right-to-bracket':item.action.includes('LOGOUT')?'fa-right-from-bracket':item.action.includes('TRANSFER')?'fa-money-bill-transfer':'fa-shield' %>"></i></span><strong><%= item.label %></strong></td><td><%= item.actor %><small class="d-block muted"><%= item.actorType %></small></td><td><%= item.initiator %> · <%= item.deviceType %><% if(item.mapUrl){ %><a class="d-block" target="_blank" rel="noopener" href="<%= item.mapUrl %>">الموقع</a><% } %></td><td><span class="badge <%= item.tone==='danger'?'bg-danger':item.tone==='warning'?'bg-warning text-dark':item.tone==='success'?'bg-success':'bg-secondary' %>"><%= item.result %></span></td><td class="mono"><%= item.ipAddress %></td><td><%= new Date(item.createdAt).toLocaleString('ar-EG') %></td><td><button class="btn btn-sm btn-outline-primary" onclick="showActivityDetails('<%= item.id %>')">التفاصيل</button></td></tr><% }) %></tbody></table></div></div></section>

<section class="tab-panel" data-panel="users"><div class="section-card"><div class="section-heading"><div><h2>المستخدمون وطريقة الوصول</h2><p>العملاء والشركات والمنفذون والوكلاء، والقنوات والأجهزة التي استخدموها.</p></div><div class="toolbar"><select class="form-select" id="userCategory" onchange="filterUsers()"><option value="">كل الأنواع</option><option>عميل</option><option>شركة</option><option>منفذ</option><option>وكيل</option></select><input class="form-control" id="userSearch" type="search" placeholder="اسم الحساب" oninput="filterUsers()"></div></div><div class="table-wrap"><table class="table"><thead><tr><th>الحساب</th><th>الفئة</th><th>الحالة</th><th>يستخدم</th><th>الجهاز</th><th>آخر ظهور</th><th></th></tr></thead><tbody id="userRows"><% if(!commandCenter.accounts.length){ %><tr><td colspan="7" class="empty">لا توجد حسابات.</td></tr><% } commandCenter.accounts.forEach(account=>{ %><tr data-category="<%= account.category %>" data-search="<%= account.name.toLowerCase() %>"><td><strong><%= account.name %></strong><small class="d-block muted"><%= account.id %></small></td><td><span class="pill"><%= account.category %></span></td><td><span class="badge <%= account.status==='active'?'bg-success':'bg-secondary' %>"><%= account.status==='active'?'نشط':account.status %></span></td><td><%= account.channel %></td><td><%= account.device %></td><td><%= account.lastSeenAt?new Date(account.lastSeenAt).toLocaleString('ar-EG'):'لا يوجد نشاط' %></td><td><button class="btn btn-sm btn-outline-primary" data-account-name="<%= account.name %>" onclick="showAccountActivity(this.dataset.accountName)">حركته</button></td></tr><% }) %></tbody></table></div></div></section>

<section class="tab-panel" data-panel="settings">
<details class="settings-block" <%= enrollmentRequired?'open':'' %>><summary><i class="fa-solid fa-fingerprint text-primary ms-2"></i>مفتاح مرور الإدارة</summary><div class="settings-body"><p class="muted">تحقق عبر Windows Hello أو بصمة الهاتف.</p><div class="action-row"><button class="btn btn-primary" onclick="registerPasskey()">تسجيل الجهاز</button><button class="btn btn-outline-primary" onclick="authenticatePasskey()">اختبار المفتاح</button></div></div></details>
<details class="settings-block"><summary><i class="fa-solid fa-sliders text-primary ms-2"></i>سياسة الدخول والجلسات</summary><div class="settings-body"><div class="policy-grid"><% [['adminDeviceEnforcementEnabled','قفل الإدارة على جهاز واحد','يتطلب مفتاح مرور.'],['accountDeviceEnforcementEnabled','اعتماد أجهزة الحسابات','الجهاز الجديد يمر بالمراجعة.'],['mandatoryAuthenticatorEnabled','Authenticator إلزامي','يتحقق قبل إصدار الجلسة.'],['adminApprovalRequired','موافقة الإدارة','للأجهزة الجديدة.'],['singleDeviceOnly','جهاز واحد للحساب','يلغي الجهاز السابق بعد الموافقة.'],['adminPermissionEnforcementEnabled','فرض صلاحيات الإدارة','ينفذ الممنوح فقط.'],['locationRequired','طلب الموقع','إشارة أمان مساندة.'],['highConfidenceVpnBlockEnabled','حظر الشبكات الخطرة','عند وجود إشارة موثوقة.']].forEach(([key,label,help])=>{ %><label class="policy-item"><span><strong><%= label %></strong><small><%= help %></small></span><input class="form-check-input" type="checkbox" data-policy="<%= key %>" <%= securityState[key]?'checked':'' %>></label><% }) %><label class="policy-item"><span><strong>جلسة الإدارة</strong><small>1 إلى 24 ساعة</small></span><input class="form-control text-center mono" style="width:86px" type="number" min="1" max="24" data-policy="adminSessionHours" value="<%= securityState.adminSessionHours %>"></label><label class="policy-item"><span><strong>جلسة الحسابات</strong><small>1 إلى 24 ساعة</small></span><input class="form-control text-center mono" style="width:86px" type="number" min="1" max="24" data-policy="accountSessionHours" value="<%= securityState.accountSessionHours %>"></label></div><div class="action-row"><button class="btn btn-success" onclick="savePolicy()">حفظ السياسة</button></div></div></details>
<details class="settings-block"><summary><i class="fa-solid fa-laptop-shield text-primary ms-2"></i>كل الأجهزة المسجلة</summary><div class="settings-body"><div class="table-wrap"><table class="table"><thead><tr><th>الحساب</th><th>الجهاز</th><th>الحالة</th><th>آخر IP</th><th>آخر ظهور</th><th></th></tr></thead><tbody><% devices.forEach(device=>{ %><tr><td><strong><%= device.principalId %></strong><small class="d-block muted"><%= device.principalType %></small></td><td><%= device.displayName %><small class="d-block muted"><%= device.channel==='app'?'تطبيق':'موقع' %></small></td><td><span class="badge <%= device.status==='active'?'bg-success':device.status==='pending'?'bg-warning text-dark':'bg-secondary' %>"><%= device.status %></span></td><td class="mono"><%= device.lastIp||'-' %></td><td><%= device.lastSeenAt?new Date(device.lastSeenAt).toLocaleString('ar-EG'):'-' %></td><td><div class="d-flex gap-2"><% if(device.status==='active'){ %><button class="btn btn-sm btn-outline-danger" onclick="revokeDevice('<%= device._id %>')"><i class="fa-solid fa-ban"></i></button><% } if(['executor','client_user','client_company','agent_staff','sub_client','admin'].includes(device.principalType)){ %><button class="btn btn-sm btn-outline-warning" onclick="resetOperationPin('<%= device.principalType %>','<%= device.principalId %>')"><i class="fa-solid fa-key"></i></button><% } %></div></td></tr><% }) %></tbody></table></div></div></details>
<details class="settings-block"><summary><i class="fa-solid fa-users-gear text-primary ms-2"></i>حسابات الإدارة والصلاحيات</summary><div class="settings-body"><form onsubmit="createAdmin(event)"><div class="admin-create"><input class="form-control" name="name" placeholder="اسم المدير" required><input class="form-control mono" name="webUsername" placeholder="admin@ahram.com" required><input class="form-control mono" name="password" type="password" placeholder="كلمة مرور قوية (12+)" required><select class="form-select" name="role"><option value="admin">مدير بصلاحيات</option><% if(currentAdminRole==='master'){ %><option value="master">مدير رئيسي</option><% } %></select></div><div class="permission-grid mt-3"><% permissions.forEach(([value,label])=>{ %><label class="permission-item"><input class="form-check-input ms-2" type="checkbox" name="permissions" value="<%= value %>"><%= label %></label><% }) %></div><div class="action-row"><button class="btn btn-primary">إنشاء حساب الإدارة</button></div></form><div class="table-wrap mt-4"><table class="table"><thead><tr><th>المدير</th><th>المستخدم</th><th>الدور</th><th>الحالة</th><th>الصلاحيات</th><th></th></tr></thead><tbody><% admins.forEach(admin=>{ %><tr><td><strong><%= admin.name %></strong></td><td class="mono"><%= admin.webUsername %></td><td><%= admin.role %></td><td><span class="badge <%= admin.status==='active'?'bg-success':'bg-danger' %>"><%= admin.status %></span></td><td><%= admin.permissions?.length||0 %></td><td><button class="btn btn-sm btn-outline-primary" onclick="openAdminEditor('<%= admin._id %>')"><i class="fa-solid fa-user-shield"></i></button></td></tr><% }) %></tbody></table></div></div></details>
<details class="settings-block"><summary class="text-danger"><i class="fa-solid fa-triangle-exclamation ms-2"></i>الطوارئ</summary><div class="settings-body"><div class="emergency-band"><p>رمز أحادي الاستخدام يوقف المعاملات الحساسة لمدة 60 دقيقة.</p><button class="btn btn-outline-danger" onclick="rotateEmergencyCode()">إنشاء رمز جديد</button><div class="emergency-code" id="emergencyCode"></div><hr><div class="row g-2"><div class="col-md-5"><input id="lockdownCode" class="form-control mono" placeholder="AHRAM-XXXXXXXX-XXXXXXXX"></div><div class="col-md-5"><input id="lockdownReason" class="form-control" placeholder="سبب الطوارئ"></div><div class="col-md-2"><button class="btn btn-danger w-100" onclick="activateLockdown()">إيقاف 60 دقيقة</button></div></div></div></div></details></section>
</main></div>
<dialog class="dialog" id="activityDialog"><div class="dialog-head"><div><h2 class="h5 fw-bold">تفاصيل الحركة</h2><small class="muted">تُخفى كلمات المرور والرموز تلقائيًا.</small></div><button class="btn btn-outline-secondary" onclick="activityDialog.close()"><i class="fa-solid fa-xmark"></i></button></div><div class="dialog-body"><pre class="details-json" id="activityDetails"></pre></div></dialog>
<dialog class="dialog" id="adminEditorDialog"><form method="dialog" onsubmit="saveAdmin(event)"><div class="dialog-head"><div><h2 class="h5 fw-bold">إدارة حساب المدير</h2><small class="muted" id="adminEditorIdentity"></small></div><button type="button" class="btn btn-outline-secondary" onclick="closeAdminEditor()"><i class="fa-solid fa-xmark"></i></button></div><div class="dialog-body"><label class="fw-bold">حالة الحساب</label><select class="form-select mb-3" id="adminEditorStatus"><option value="active">نشط</option><option value="suspended">معلق</option></select><div class="permission-grid"><% permissions.forEach(([value,label])=>{ %><label class="permission-item"><input class="form-check-input ms-2" type="checkbox" data-edit-permission value="<%= value %>"><%= label %></label><% }) %></div><label class="policy-item mt-3"><span><strong>إنهاء كل الجلسات</strong></span><input class="form-check-input" type="checkbox" id="adminEditorInvalidate"></label><div class="action-row"><button class="btn btn-primary">حفظ</button><button class="btn btn-outline-secondary" type="button" onclick="closeAdminEditor()">إلغاء</button></div></div></form></dialog><div class="toast-box" id="securityToast"></div>
<script>
const csrfToken=<%- JSON.stringify(csrfToken||'') %>,adminRecords=<%- adminRecordsJson||'[]' %>,activityDetailsData=<%- activityDetailsJson||'{}' %>;let editingAdminId='';function toggleSidebar(){document.querySelector('.sidebar')?.classList.toggle('active');document.querySelector('.sidebar-overlay')?.classList.toggle('active')}function openTab(name,push=true){document.querySelectorAll('.security-tab').forEach(x=>x.classList.toggle('active',x.dataset.tab===name));document.querySelectorAll('.tab-panel').forEach(x=>x.classList.toggle('active',x.dataset.panel===name));if(push)history.replaceState(null,'',`?tab=${name}`)}function filterRows(id,value){const term=value.trim().toLowerCase();document.querySelectorAll(`#${id} tr[data-search]`).forEach(row=>row.hidden=!row.dataset.search.includes(term))}function filterActivity(){const type=activityType.value,term=activitySearch.value.trim().toLowerCase();document.querySelectorAll('#activityRows tr[data-action]').forEach(row=>row.hidden=(type&&!row.dataset.action.includes(type))||(term&&!row.dataset.search.includes(term)))}function filterUsers(){const category=userCategory.value,term=userSearch.value.trim().toLowerCase();document.querySelectorAll('#userRows tr[data-category]').forEach(row=>row.hidden=(category&&row.dataset.category!==category)||(term&&!row.dataset.search.includes(term)))}function showAccountActivity(name){openTab('activity');activitySearch.value=name;filterActivity()}function showActivityDetails(id){document.getElementById('activityDetails').textContent=JSON.stringify(activityDetailsData[id]||{},null,2);activityDialog.showModal()}
const toast=(message,error=false)=>{securityToast.textContent=message;securityToast.style.background=error?'#b91c1c':'#0f766e';securityToast.style.display='block';setTimeout(()=>securityToast.style.display='none',4000)},b64urlToBytes=v=>Uint8Array.from(atob(v.replace(/-/g,'+').replace(/_/g,'/').padEnd(Math.ceil(v.length/4)*4,'=')),c=>c.charCodeAt(0)),bytesToB64url=b=>btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');const registrationPayload=c=>({id:c.id,rawId:bytesToB64url(c.rawId),type:c.type,authenticatorAttachment:c.authenticatorAttachment,response:{clientDataJSON:bytesToB64url(c.response.clientDataJSON),attestationObject:bytesToB64url(c.response.attestationObject),transports:c.response.getTransports?.()||[]},clientExtensionResults:c.getClientExtensionResults()}),authenticationPayload=c=>({id:c.id,rawId:bytesToB64url(c.rawId),type:c.type,authenticatorAttachment:c.authenticatorAttachment,response:{clientDataJSON:bytesToB64url(c.response.clientDataJSON),authenticatorData:bytesToB64url(c.response.authenticatorData),signature:bytesToB64url(c.response.signature),userHandle:c.response.userHandle?bytesToB64url(c.response.userHandle):null},clientExtensionResults:c.getClientExtensionResults()});async function jsonFetch(url,options={}){const r=await fetch(url,{credentials:'same-origin',...options,headers:{Accept:'application/json','Content-Type':'application/json','X-CSRF-Token':csrfToken,...(options.headers||{})}}),d=await r.json().catch(()=>({success:false,error:'استجابة غير صالحة'}));if(!r.ok||!d.success){const e=new Error(d.error||'تعذر التنفيذ');e.code=d.code||'';throw e}return d}async function registerPasskey(){try{const d=await jsonFetch('/admin/security/passkeys/register/options'),o=d.options;o.challenge=b64urlToBytes(o.challenge);o.user.id=b64urlToBytes(o.user.id);o.excludeCredentials=(o.excludeCredentials||[]).map(x=>({...x,id:b64urlToBytes(x.id)}));const c=await navigator.credentials.create({publicKey:o});await jsonFetch('/admin/security/passkeys/register/verify',{method:'POST',body:JSON.stringify({response:registrationPayload(c)})});location.reload()}catch(e){toast(e.message,true)}}async function authenticatePasskey(){const d=await jsonFetch('/admin/security/passkeys/authenticate/options'),o=d.options;o.challenge=b64urlToBytes(o.challenge);o.allowCredentials=(o.allowCredentials||[]).map(x=>({...x,id:b64urlToBytes(x.id)}));const c=await navigator.credentials.get({publicKey:o});return jsonFetch('/admin/security/passkeys/authenticate/verify',{method:'POST',body:JSON.stringify({response:authenticationPayload(c)})})}async function guarded(fn){try{return await fn()}catch(e){if(e.code==='PASSKEY_STEP_UP_REQUIRED'){await authenticatePasskey();return fn()}throw e}}async function savePolicy(){try{const p={};document.querySelectorAll('[data-policy]').forEach(x=>p[x.dataset.policy]=x.type==='checkbox'?x.checked:Number(x.value));await guarded(()=>jsonFetch('/admin/security/policy',{method:'POST',body:JSON.stringify(p)}));location.reload()}catch(e){toast(e.message,true)}}async function revokeDevice(id){if(confirm('إنهاء جلسات هذا الجهاز؟'))try{await guarded(()=>jsonFetch(`/admin/security/devices/${id}/revoke`,{method:'POST',body:'{}'}));location.reload()}catch(e){toast(e.message,true)}}async function resetOperationPin(type,id){const pin=prompt('رمز جديد من 4 إلى 6 أرقام:');if(pin&&!/^\d{4,6}$/.test(pin))return toast('الرمز غير صالح',true);if(pin)try{await guarded(()=>jsonFetch(`/admin/security/operation-pins/${type}/${id}/reset`,{method:'POST',body:JSON.stringify({pin})}));toast('تم تعيين الرمز')}catch(e){toast(e.message,true)}}async function rotateEmergencyCode(){if(confirm('إلغاء الرمز السابق وإنشاء جديد؟'))try{const d=await guarded(()=>jsonFetch('/admin/security/emergency-code/rotate',{method:'POST',body:'{}'}));emergencyCode.textContent=d.code;emergencyCode.style.display='block'}catch(e){toast(e.message,true)}}async function activateLockdown(){if(confirm('إيقاف المعاملات 60 دقيقة؟'))try{await jsonFetch('/admin/security/lockdown/activate',{method:'POST',body:JSON.stringify({code:lockdownCode.value,reason:lockdownReason.value})});location.reload()}catch(e){toast(e.message,true)}}async function createAdmin(e){e.preventDefault();const f=e.currentTarget;try{await guarded(()=>jsonFetch('/admin/security/admins',{method:'POST',body:JSON.stringify({name:f.name.value,webUsername:f.webUsername.value,password:f.password.value,role:f.role.value,permissions:[...f.querySelectorAll('[name=permissions]:checked')].map(x=>x.value)})}));location.reload()}catch(x){toast(x.message,true)}}function openAdminEditor(id){const a=adminRecords.find(x=>x.id===id);if(!a)return;editingAdminId=id;adminEditorIdentity.textContent=`${a.name} · ${a.username}`;adminEditorStatus.value=a.status;adminEditorInvalidate.checked=false;document.querySelectorAll('[data-edit-permission]').forEach(x=>x.checked=a.permissions.includes(x.value));adminEditorDialog.showModal()}function closeAdminEditor(){adminEditorDialog.close()}async function saveAdmin(e){e.preventDefault();try{await guarded(()=>jsonFetch(`/admin/security/admins/${editingAdminId}`,{method:'PATCH',body:JSON.stringify({status:adminEditorStatus.value,permissions:[...document.querySelectorAll('[data-edit-permission]:checked')].map(x=>x.value),invalidateSessions:adminEditorInvalidate.checked})}));location.reload()}catch(x){toast(x.message,true)}}const tab=new URLSearchParams(location.search).get('tab');if(['devices','activity','users','settings'].includes(tab))openTab(tab,false);const lp=document.querySelector('[data-lockdown-end]');if(lp){const render=()=>{const t=Math.ceil(Math.max(0,Date.parse(lp.dataset.lockdownEnd)-Date.now())/1000);lockdownClock.textContent=`${String(Math.floor(t/60)).padStart(2,'0')}:${String(t%60).padStart(2,'0')}`};render();setInterval(render,1000)}
</script></body></html>
