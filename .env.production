# =========================================================
# Al-Ahram Pay v2.0 - Production Environment Template
# Copy this to .env and customize for your production server
# =========================================================

# ── Database ──────────────────────────────────────
# Use MongoDB Atlas or managed MongoDB in production
MONGO_URI=mongodb://username:password@your-mongo-cluster.mongodb.net/al_ahram_pay?retryWrites=true&w=majority

# ── Telegram Bot Tokens ──────────────────────────────
CLIENT_BOT_TOKEN=<YOUR_CLIENT_BOT_TOKEN>
ADMIN_BOT_TOKEN=<YOUR_ADMIN_BOT_TOKEN>

# ── Admin Telegram ID ─────────────────────────────
ADMIN_TELEGRAM_ID=<YOUR_TELEGRAM_ID>
ADMIN_SECRET_CODE=<YOUR_SECRET_CODE>

# ── Security Keys (Generate new ones for production!) ──────────────────────────────────────
JWT_SECRET=<GENERATE_NEW_64_BYTE_HEX>
JWT_REFRESH_SECRET=<GENERATE_NEW_64_BYTE_HEX>
SESSION_SECRET=<GENERATE_NEW_64_BYTE_HEX>
OTP_SECRET=<GENERATE_NEW_32_BYTE_HEX>
BYPASS_OTP=false
BYPASS_CLIENT_OTP=false
MASTER_OTP=<CHANGE_THIS>
FORCE_CLIENT_OTP=true

# ── WhatsApp (Optional) ─────────────────────────
WHATCHIMP_ENABLED=false
WHATCHIMP_API_BASE_URL=https://app.whatchimp.com/api/v1/whatsapp
WHATCHIMP_API_TOKEN=<YOUR_WHATCHIMP_TOKEN>
WHATCHIMP_PHONE_NUMBER_ID=<YOUR_PHONE_NUMBER_ID>
WHATCHIMP_OTP_TEMPLATE=power_pay_otp
WHATCHIMP_OTP_TEMPLATE_LANGUAGE=ar
WHATCHIMP_OTP_VARIABLE_ORDER=otp,expiresMinutes
WHATCHIMP_RECEIPT_MEDIA_TEMPLATE_ID=<YOUR_TEMPLATE_ID>
WHATCHIMP_RECEIPT_TEMPLATE=<YOUR_TEMPLATE_NAME>
WHATCHIMP_RECEIPT_TEMPLATE_LANGUAGE=ar
WHATCHIMP_RECEIPT_VARIABLE_ORDER=accountName,reference,amount,currency,completedAt,receiptUrl
WHATCHIMP_RECEIPT_URL_TTL_HOURS=720
WHATCHIMP_REQUEST_TIMEOUT_MS=15000
WHATCHIMP_WEBHOOK_SECRET=<GENERATE_NEW_32_BYTE_HEX>
RECEIPT_SHARE_SECRET=<GENERATE_NEW_32_BYTE_HEX>

# ── Admin Panel Credentials ──────────────────
PANEL_USER=<CHANGE_THIS_ADMIN_USERNAME>
PANEL_PASS=<STRONG_PASSWORD_MIN_12_CHARS>

# ── External API (Optional) ─────────────────────────────────
ZAYN_USERNAME=<YOUR_ZAYN_USERNAME>
ZAYN_PASSWORD=<YOUR_ZAYN_PASSWORD>
ZAYN_AGGREGATOR_URL=https://zaynpay.com
ZAYN_AGGREGATOR_SERVICE_ID=85
ZAYN_AGGREGATOR_PROVIDER_ID=16
ZAYN_AGGREGATOR_FIELD_ID=5488
ZAYN_AGGREGATOR_MACHINE_SERIAL=XP1
API_BALANCE_TOLERANCE=0.01
API_RETURN_MONITOR_ENABLED=true
API_RETURN_MONITOR_INTERVAL_MS=300000

# Internal API Key
INTERNAL_API_KEY=<GENERATE_NEW_32_BYTE_HEX>

# ── Runtime Environment ────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SECURE_COOKIE=true
COOKIE_SAMESITE=strict
REDIS_ENABLED=true
REDIS_REQUIRED=true
REDIS_URL=redis://your-redis-cluster.amazonaws.com:6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
GLOBAL_RATE_LIMIT_MAX=5000
ALLOW_LEGACY_SAME_ORIGIN_CSRF=false
