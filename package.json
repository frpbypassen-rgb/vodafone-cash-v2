{
  "name": "vodafone-cash-system",
  "version": "2.0.0",
  "description": "Al-Ahram Enterprise Financial System",
  "main": "app.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "proxy-addr": "2.0.8",
    "@fastify/busboy": "3.2.2"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "audit:env": "node scripts/auditProductionEnv.js",
    "check:mongo-transactions": "node scripts/checkMongoTransactionSupport.js",
    "check:executor-readiness": "node scripts/checkExecutorReadiness.js",
    "repair:env": "node scripts/repairProductionEnv.js .env --apply",
    "rotate:admin": "node scripts/rotateAdminCredentials.js",
    "rotate:leaked-seed-account": "node scripts/rotateLeakedSeedAccount.js",
    "authorize:admin-device": "node scripts/authorizeAdminDevice.js",
    "migrate:tenant": "node scripts/migrateTenantIsolation.js",
    "backfill:financial-tenant": "node scripts/backfillFinancialTenantId.js",
    "scan:account-code-tenant-index": "node scripts/prepareAccountCodeTenantIndex.js",
    "backfill:reports": "node scripts/backfillUnifiedReports.js",
    "setup:web-push": "node scripts/ensureWebPushKeys.js",
    "seed:zayn-executor": "node scripts/seedZaynApiExecutor.js",
    "lint": "eslint . --quiet",
    "lint:executor": "eslint \"controllers/executor*.js\" \"controllers/executor/**/*.js\" \"routes/executor*.js\" \"services/executor*.js\" \"middlewares/*Executor*.js\" \"utils/executor*.js\" \"public/js/executor/**/*.js\" \"tests/executor*.test.js\" \"tests/helpers/executor*.js\" --max-warnings 0",
    "format:executor": "prettier --config config/executor-format.json --write \"controllers/executor/dashboard/*.js\" controllers/executorDashboardController.js \"public/js/executor/**/*.js\" \"public/css/executor/pages/*.css\" config/executor-browser-globals.js tests/helpers/executorPortalSources.js tests/executorPortalOrganization.test.js",
    "check:executor-format": "prettier --config config/executor-format.json --check \"controllers/executor/dashboard/*.js\" controllers/executorDashboardController.js \"public/js/executor/**/*.js\" \"public/css/executor/pages/*.css\" config/executor-browser-globals.js tests/helpers/executorPortalSources.js tests/executorPortalOrganization.test.js",
    "check:architecture": "node scripts/checkArchitecturePolicy.js",
    "typecheck": "tsc --noEmit --pretty false",
    "test:security": "jest tests/securityPolicy.test.js tests/otpSecurity.test.js tests/sessionSecurity.test.js tests/operationalAccess.test.js tests/tenantResolver.test.js tests/jwtExecutorStatus.test.js tests/walletService.test.js tests/reversalService.test.js tests/merchantAgentApi.test.js tests/controllers.test.js tests/financialRecordImmutability.test.js tests/logSanitizer.test.js --runInBand",
    "check:release": "node scripts/checkArchitecturePolicy.js && eslint . --quiet && tsc --noEmit --pretty false && jest tests/securityPolicy.test.js tests/otpSecurity.test.js tests/sessionSecurity.test.js tests/operationalAccess.test.js tests/tenantResolver.test.js tests/jwtExecutorStatus.test.js tests/walletService.test.js tests/reversalService.test.js tests/merchantAgentApi.test.js tests/controllers.test.js tests/financialRecordImmutability.test.js tests/logSanitizer.test.js tests/adminFinancialMutationService.test.js tests/mobileAuthContract.test.js tests/mobileSubAccountTransferFlow.test.js tests/mobileWebParity.test.js tests/securityControlService.test.js tests/transferFlow.test.js tests/merchantWebhookService.test.js tests/architecturePolicy.test.js --runInBand",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "fintech",
    "telegram",
    "ledger",
    "transactions"
  ],
  "author": "Eng. Mohamed",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.56.0",
    "@simplewebauthn/server": "^13.3.2",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "canvas": "^3.2.3",
    "compression": "1.8.2",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.2.0",
    "image-size": "2.0.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "multer": "^2.4.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.10",
    "puppeteer": "^25.8.0",
    "redlock": "^5.0.0-beta.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "telegraf-session-mongodb": "^2.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "validator": "^13.15.35",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "eslint": "^10.8.1",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^17.11.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "10.2.3",
    "prettier": "3.9.9",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.67.0"
  }
}
