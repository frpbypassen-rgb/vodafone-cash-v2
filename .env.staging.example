# Al-Ahram Pay API Sandbox - copy this file to .env.staging on the server.
# Never use production secrets, production MongoDB, or production API keys here.

NODE_ENV=staging
PORT=3100
TZ=Africa/Tripoli
PUBLIC_APP_URL=https://sandbox-api.ahrampay.com
ALLOWED_ORIGINS=https://sandbox-api.ahrampay.com
SECURE_COOKIE=true
COOKIE_SAMESITE=lax
TRUST_PROXY_HTTPS=true

# A distinct database. It must run as a replica set; do not point at production.
MONGO_URI=mongodb://127.0.0.1:27018/ahram_pay_sandbox?replicaSet=rs0
MONGO_TRANSACTIONS_REQUIRED=true
EMERGENCY_STANDALONE_FINANCIAL_WRITES=false
EMERGENCY_STANDALONE_FINANCIAL_WRITES_EXPIRES_AT=
EMERGENCY_STANDALONE_FINANCIAL_WRITES_REASON=

# Generate four different values with crypto.randomBytes(48).toString('hex').
JWT_SECRET=REPLACE_WITH_A_UNIQUE_STAGING_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_UNIQUE_STAGING_REFRESH_SECRET
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_STAGING_SESSION_SECRET
OTP_SECRET=REPLACE_WITH_A_UNIQUE_STAGING_OTP_SECRET
TENANT_ROUTING_SECRET=REPLACE_WITH_A_UNIQUE_STAGING_TENANT_SECRET

# Test users can log in without WhatsApp. This applies to Sandbox only.
PASSWORD_ONLY_LOGIN_MODE=true
SECURITY_VERIFICATION_ENFORCEMENT_ENABLED=false
SECURITY_VERIFICATION_MODE=optional
PASSKEY_REQUIRED=false
CLIENT_OTP_ENABLED=false
CLIENT_OTP_DISABLED_REASON=Sandbox API testing environment
FORCE_CLIENT_OTP=false
BYPASS_OTP=false
BYPASS_CLIENT_OTP=false
DISABLE_OTP=false

SESSION_STORE=mongo
TENANT_ISOLATION_REQUIRED=true
TENANT_MODE=single
DEFAULT_TENANT_SLUG=ahram-sandbox
ALLOW_LEGACY_TENANTLESS_RECORDS=false
ALLOW_LEGACY_TENANT_TOKENS=false

# Never send production messages or use production payment/executor providers.
WHATCHIMP_ENABLED=false
FCM_ENABLED=false
CLIENT_BOT_TOKEN=
ADMIN_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
API_RETURN_MONITOR_ENABLED=false
REDIS_ENABLED=false
REDIS_REQUIRED=false
GLOBAL_RATE_LIMIT_MAX=1000
